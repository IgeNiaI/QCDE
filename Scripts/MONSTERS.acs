// This is the first string in this library.
// In case something goes South and some numeric 0 gets interpreted as text,
// we'll see it appearing and immediately understand what's wrong.
// Don't use for anything.
str qcdeNULLstring = "qcdeNULLstring";

// MAX_THEMES is an (arbitrary) upper limit on possibly added dynamic themes.
// NUMBER_OF_THEMES is how many themes are present. By default, this equals
// number of built-in themes, but NUMBER_OF_THEMES increases with successfully
// loaded user themes.
int NUMBER_OF_THEMES = THEMES_BUILTIN;
str themes[MAX_THEMES] = { "Quake 1", "Quake 2", "Quake 4", "Doom", "Doom 4" };

bool active[MAX_THEMES]; // filled from cvars

// Monsters are sorted in the order of appearance at cast sequence.
// Except Spectre and SS. They're awkwardly appended to the end of list.
str mons[NUMBER_OF_MONSTERS] = { "Zombieman", "Shotgun Guy", "Chaingun Guy", "Imp",
		"Demon", "Lost Soul", "Cacodemon", "Hell Knight", "Baron of Hell",
		"Arachnotron", "Pain Elemental", "Revenant", "Mancubus", "Arch-vile",
		"Spider Mastermind", "Cyberdemon", "Spectre", "Wolfenstein SS"};

#define NUMBER_OF_REPLACEMENTS 16

// [Ms] Whoa whoa whoa. You know, I remember the day when 3d array in AEoD felt
//      like something big and sophisticated. In the end, arrays are but tools.
//      Yesterday you need 2d, today 3d. Nobody knows what happens tomorrow.
//      Maybe you can live with 1d. Or even 0d -- dot array, a simple variable.
//
// [Ms] That being said... today we need a four-dimensional array. ;D
//
// [Ms] Each possible replacement is represented by a pair: class and weight.
//      Weights decide how likely is this replacement to spawn, compared to
//      other replacements of same monster.
//      Weights only matter in comparison to each other.
//      Two classes with weights 1000 and 2000 spawn exactly like with 1 and 2.
//
// [Ms] Yes, numbers must be written as strings.
//
// [Ms] Maybe it's time I moved to GDCC and used structs... :thinking:
//      Nah, that'd be too :ez: :sweetie:

