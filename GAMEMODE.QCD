//-------------------------------------------------------------------------------------------
//
// Setting flag defaults and locking some of them
//
//-------------------------------------------------------------------------------------------

DefaultGameSettings
{
	sv_weaponstay = false
	sv_weapondrop = true
	sv_nocrouch = false
	sv_allowjump = true
	sv_allowcrouch = true
	sv_awarddamageinsteadkills = true
	sv_unblockallies = true
	sv_accuratecrosshair = true
	sv_disablewallfriction = true
	sv_enableprojectilehitboxfix = true
	sv_quakethrust = true
	sv_headbob = 0.0
}

DefaultLockedGameSettings
{
	compat_predictfunctions = true
}



// Coop gamemodes

Cooperative
{
	GameSettings
	{
		sv_sharekeys = true
		sv_coop_damagefactor = true
	}
}

Survival
{
	GameSettings
	{
		sv_sharekeys = true
		sv_coop_damagefactor = true
	}
}

Invasion
{
	GameSettings
	{
		sv_sharekeys = true
		sv_coop_damagefactor = true
	}
}



// PvP gamemodes

Deathmatch
{
	GameSettings
	{
		sv_sharekeys = false // to prevent the "No keys found yet" message from appearing
		sv_respawntime = 1
		sv_forcerespawn = true
		sv_forcerespawntime = 10
		sv_spawnfarthest = true
		sv_elevatedspecialfix = true
		sv_maprotation = true
		sv_randommaprotation = true
		sv_ringouttics = 105
	}
}

