// Activator: Player
script "QCDE_Hourglass" (int percentage, int nosandswirl)
{
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	if(!percentage) terminate;

	int plr = PlayerNumber();

    if(tics[plr] == 0) terminate;

	int take = GetCooldown() * percentage / 100;

	// Scale bonus according to percentage server cvar
	take = take * GetCvar("sv_cooldownPercentage") / 100;

	SetHudSize(1400,1050,1);

	if(percentage > 0)
	{
		int size = (percentage + 9) / 10 * 10 + 40;
		if(size <  30) size =  30;
		if(size > 100) size = 100;
		str font = strparam(s:"QCFNT", d:size/100, d:size%100/10, d:size%10);
		SetFont(font);
		HudMessage(s:"-", d:percentage, s:"%"; HUDMSG_FADEOUT, 3243, CR_GOLD, 760.1, 946.1, 0.2, 0.04 * percentage);
	}
	SetFont("BLINKGLD");
	//HudMessage(s:"A"; HUDMSG_FADEOUT, 3245, CR_UNTRANSLATED, 700.0, 911.0, 0.08, 0.005 * percentage);
	if(!nosandswirl) ACS("QCDE_BlinkSandwatch");
	tics[plr] -= take;
    if(tics[plr] < 0)
    	tics[plr] = 0;

	if (GetNetworkState() == NETSTATE_SERVER)
		ACS("QCDE_Hourglass_Replicate", tics[plr]);
}

script "QCDE_Hourglass_Replicate" (int tics)
{
	delay(1);
	//log(s:"QCDE_Hourglass: Sending ", d:tics[plr]);
	ACS("QCDE_AbilityCooldown_CLIENTSIDE", tics > 0 ? tics - 1 : 0, true);
}

script "QCDE_BlinkSandwatch" (void) clientside
{
	if(IsZandronum(true))
		if(ActivatorTid() != CheckPlayerCamera(ConsolePlayerNumber()))
			terminate;

	SetHudSize(1400,1050,1);

	SetFont("SWIRLIN1"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
	SetFont("SWIRLIN2"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
	SetFont("SWIRLIN3"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
	SetFont("SWIRLIN4"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
	SetFont("SWIRLIN5"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
	SetFont("SWIRLIN6"); HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3246, CR_UNTRANSLATED, 700.0, 911.0, 0.1, 0.1); delay(2);
}


