//-------------------------------------------------------------
// Animators for varying fade time
//-------------------------------------------------------------
colorchanger ToBlackFaster
{
	FadeStart	0.5
	FadeTime	0.5
}
colorchanger ToBlackFastest
{
	FadeStart	0.1
	FadeTime	0.4
}
colorchanger ToBlackSlower
{
	FadeStart	0.8
	FadeTime	1.0
}
colorchanger ToBlackSlowest
{
	FadeStart	0.5
	FadeTime	2.5
}

