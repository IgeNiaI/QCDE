#define BALLS_TIL_FREEZE 6
Script "QCDE_StartFreezeCounter" (void)
{
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	int t = 35*3;	//window to connect freezeballs to freeze solid
	int tokensnow, tokensbefore;

	tokensnow = checkinventory("ImFrozen");
	tokensbefore = tokensnow; //equalize them on initialization

	while(t>0)
	{
		tokensnow=checkinventory("ImFrozen");
		if(tokensnow>=BALLS_TIL_FREEZE)							//if it has X tokens, freeze for X seconds
		{
			//printbold(s:"Frozen solid");
			GiveInventory("IceCubePlayerProc",1);
			GiveInventory("ImFullyFrozen",1);
			GiveInventory("NoAbilitiesToken",1);
			SetPlayerProperty(0,1,PROP_TOTALLYFROZEN);

			//Freeze for ~2.5sec
			delay(88);

			SyncPlayerNetwork( PlayerNumber() );
			SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
			TakeInventory("PowerIceProtection",1);
			delay(35);			//tiny window in which player cant be frozen again
			TakeInventory("ImFrozen",999); 			//then take the tokens afterwards
			TakeInventory("ImFullyFrozen",1); 		//then take the tokens afterwards
			if(!CheckInventory("Freezetagged"))
				TakeInventory("NoAbilitiesToken",1);
			t=0;									//set time to zero to end loop
		}
		else
		{
			if(tokensnow>tokensbefore)	//if it has one more token than it did before
			{
				GiveInventory("IceDamageTintProc",1);
				t=35*3;					//reset timer
				tokensbefore=tokensnow; //and equalizes them again for next count
			}
		}
		t--;
		//printbold(d:t);
		delay(1);
	}
	TakeInventory("ImFrozen",999); //when the script ends, remove all tokens
}


Script "CheckTargetFrozen" (void)
{
	int radius;
	SetActivator(0,AAPTR_PLAYER_GETTARGET);

	if(checkinventory("ImFrozen")>=1)
		SetResultValue(1);
	else
		SetResultValue(0);
}


// Activator: exploding freeze shot
script "QCDE_FreezeShotHits" (void)
{
	Thing_ChangeTid(0, FREEZESHOT_TIDBASE + GetActorProperty(0, APROP_TargetTID) - 1000);
}

// Activator: frostbitten victim
script "QCDE_HitByFreezeShot" (void)
{
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	// This distance goes from center of freeze shot to center of player,
	// so should have quite some wiggle room
	int radius = 50;
	int tokencount = CheckInventory("ImFrozen");

	if (tokencount < BALLS_TIL_FREEZE &&
		HostileRadiusCheck(FREEZESHOT_TIDBASE, radius, true))
	{
		if (tokencount == 0) //if it doesnt have any tokens prior
		{	ACS_NamedExecuteAlways("QCDE_StartFreezeCounter",0,0,0);	} //start the counter

		GiveInventory("FreezeSlowerer", 1);
		GiveInventory("ImFrozen",       1);
		ACS_NamedExecuteAlways("QCDE_FreezeIndicator_CLIENT",0,CheckInventory("ImFrozen") * (100 / BALLS_TIL_FREEZE));
	}
}


