		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		RedMissile:
			RP02 E 12
			RP02 E 12 A_JumpIf(true, "Spawn")
			Loop
		BlueMissile:
			BP02 E 12
			BP02 E 12 A_JumpIf(true, "Spawn")
			Loop
		DefMissile:
			QP02 E 12
			QP02 E 12 A_JumpIf(true, "Spawn")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMelee")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP02 F 6 BRIGHT Light("PlayerFiringLight")
			RP02 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP02 F 6 BRIGHT Light("PlayerFiringLight")
			BP02 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP02 F 6 BRIGHT Light("PlayerFiringLight")
			QP02 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		RedPain:
			RP02 G 4
