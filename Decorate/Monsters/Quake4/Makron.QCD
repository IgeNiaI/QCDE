		TNT1 A 0 A_ScaleVelocity(0.7)
		X101 EFGH 3 Bright A_FadeOut(0.03)
		TNT1 A 0 A_ScaleVelocity(0.7)
		X101 IJKL 3 Bright A_FadeOut(0.03)
		TNT1 A 0 A_ScaleVelocity(0.7)
		X101 MNOP 3 Bright A_FadeOut(0.03)
		TNT1 A 0 A_ScaleVelocity(0.7)
