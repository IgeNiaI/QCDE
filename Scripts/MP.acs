	if(CheckInventory("QCMachinegun"		)) 	{ TakeInventory("QCMachinegun"		,1);	QCDE_Store("QCBulletAmmo");	GiveInventory("QCMachinegunDM"		,1); QCDE_Restore("QCBulletAmmo");	}
	if(CheckInventory("QCShotgun"			)) 	{ TakeInventory("QCShotgun"			,1);	QCDE_Store("QCShellAmmo");	GiveInventory("QCShotgunDM"			,1); QCDE_Restore("QCShellAmmo"	);	}
	if(CheckInventory("QCNailgun"			)) 	{ TakeInventory("QCNailgun"			,1);	QCDE_Store("QCNailAmmo"	);	GiveInventory("QCNailgunDM"			,1); QCDE_Restore("QCNailAmmo"	);	}
	if(CheckInventory("QCHeavyMachinegun"	)) 	{ TakeInventory("QCHeavyMachinegun"	,1);	QCDE_Store("QCBulletAmmo");	GiveInventory("QCHeavyMachinegunDM"	,1); QCDE_Restore("QCBulletAmmo");	}
	if(CheckInventory("QCSuperShotgun"		)) 	{ TakeInventory("QCSuperShotgun"	,1);	QCDE_Store("QCShellAmmo");	GiveInventory("QCSuperShotgunDM"	,1); QCDE_Restore("QCShellAmmo"	);	}
	if(CheckInventory("QCSuperNailgun"		)) 	{ TakeInventory("QCSuperNailgun"	,1);	QCDE_Store("QCNailAmmo"	);	GiveInventory("QCSuperNailgunDM"	,1); QCDE_Restore("QCNailAmmo"	);	}
	if(CheckInventory("QCTribolt"			))	{ TakeInventory("QCTribolt"			,1);	QCDE_Store("QCBoltAmmo"	);	GiveInventory("QCTriboltDM"			,1); QCDE_Restore("QCBoltAmmo"	);	}
	if(CheckInventory("QCRocketLauncher"	))	{ TakeInventory("QCRocketLauncher"	,1);	QCDE_Store("QCRocketAmmo");	GiveInventory("QCRocketLauncherDM"	,1); QCDE_Restore("QCRocketAmmo");	}
	if(CheckInventory("QCLightningGun"		)) 	{ TakeInventory("QCLightningGun"	,1);	QCDE_Store("QCCoilAmmo"	);	GiveInventory("QCLightningGunDM"	,1); QCDE_Restore("QCCoilAmmo"	);	}
	if(CheckInventory("QCRailgun"			)) 	{ TakeInventory("QCRailgun"			,1);	QCDE_Store("QCSlugAmmo"	);	GiveInventory("QCRailgunDM"			,1); QCDE_Restore("QCSlugAmmo"	);	}
	if(CheckInventory("QCBFG"				)) 	{ TakeInventory("QCBFG"				,1);	QCDE_Store("QCBFGAmmo"	);	GiveInventory("QCBFGDM"				,1); QCDE_Restore("QCBFGAmmo"	);	}
}
int store;
function void QCDE_Store(str what)
{
	store = CheckInventory(what);
}
function void QCDE_Restore(str what)
{
	SetInventory(what,store);
}


