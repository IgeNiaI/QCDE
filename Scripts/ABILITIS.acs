//		Terminator's Active

#define TERMINATOR_ROCKET_DELAY  3
Script "QCDE_Ability_Terminator" (void)
{
	int counterer;
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("TerminatorMainProc",1); //plays voice line and stop weapons
	GiveInventory("ActiveProgressToken",256);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
	Delay(25);	//waits a bit before using them, chance to escape
	int rocketCount = CheckInventory("TerminatorRockets");
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", rocketCount * TERMINATOR_ROCKET_DELAY);

	while(counterer++ < rocketCount && GetActorProperty(0, APROP_HEALTH) > 0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("TermRocketProc",1);
		TakeInventory("TerminatorRockets",1);
		SetNetworkReplicationFlags( 0 );
		delay(TERMINATOR_ROCKET_DELAY);
	}

	Delay(10);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("TerminatorCleanerProc",1);
	if (GameType() >= GAME_NET_DEATHMATCH)
		SetInventory("TerminatorRockets",10);
	else
		SetInventory("TerminatorRockets",20);
	SetNetworkReplicationFlags( 0 );
}


