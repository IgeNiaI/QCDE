		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		TNT1 A 0 A_GiveInventory("DeactivateShieldToken")	//failsafe to remove the shields
		QP09 I 5 A_SpawnItemEx("GibDropperMediumOlive",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP09 J 5 Bright //A_XScream
		QP09 K 5 Bright A_NoBlocking
		QP09 L 5 Bright
		QP09 M 5
		QP09 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}



//======================================================================================
//
//		10. Bitterman. AKA Quake2guy
//
//======================================================================================
Actor QCBitterman : QCPlayerHeavy
{
	Player.DisplayName "Bitterman"
	Player.SoundClass "Bitterman"
	Player.Palette "PL10"

	Scale 0.74

	Player.FootstepInterval 12
	Player.FootstepVolume 0.5625

	Player.MaxHealth 150
	Health 150
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 125

	Player.StartItem "Class_Bitterman"
	Player.StartItem "Body_Big"
	Player.StartItem "ActiveDefensive"
	Player.StartItem "NotSpectator"

	Player.StartItem "PowerShieldCharge", 25

	States
	{
	Spawn:
		QP10 G 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP10 G 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP10 G 0 A_JumpIf(true,                   "DefSpawn")
		QP10 G 100
		Loop

		ColoredSpawn:
			RP10 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP10 G 4
			Loop
		DefSpawn:
			QP10 A 0 A_JumpIf(momx||momy,"DefSee")
			QP10 G 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP10 ABCDEF 4
			RP10 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP10 ABCDEF 4
			QP10 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" G 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP10 G 12
			RP10 G 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP10 G 12
			QP10 G 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP10 H 6 BRIGHT Light("PlayerFiringLight")
			RP10 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP10 H 6 BRIGHT Light("PlayerFiringLight")
			QP10 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" I 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP10 I 4
			RP10 I 4 A_Pain
			RP10 I 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP10 I 4
			QP10 I 4 A_Pain
			QP10 I 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP10 J 5
		QP10 K 5 A_PlayerScream
		QP10 L 5 A_NoBlocking
		QP10 MNO 5
		QP10 P -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP10 O 0 A_XScream
		QP10 J 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP10 K 5
		QP10 L 5 A_NoBlocking
		QP10 MNO 5
		QP10 p -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}



