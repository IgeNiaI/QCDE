//-------------------------------------------------------------------------------------------
//
// The main menu. There's a lot of differences here between the games
//
//-------------------------------------------------------------------------------------------

LISTMENU "MainMenu"
{
	Selector "CURSOR1", -97, 0
	StaticPatch 0, -1, "MENUBACK"

	IfGame(Doom, Chex)
	{
		StaticPatch 94, 2, "M_DOOM"
		Position 97, 72	//already positioned for "read this" being always there
	}
	IfGame(Strife)
	{
		StaticPatch 84, 2, "M_STRIFE"
		Position 97, 45
	}
	IfGame(Heretic)
	{
		StaticPatch 88, 0, "M_HTIC"
		StaticPatch 40, 10, "M_SKL01"
		StaticPatch 232, 10, "M_SKL00"
		Position 110, 56
	}
	IfGame(Hexen)
	{
		StaticPatch 88, 0, "M_HTIC"
		StaticPatch 37, 80, "FBULB0"
		StaticPatch 278, 80, "FBULA0"
		Position 110, 56
	}

	IfGame(Doom, Strife, Chex)
	{
		PatchItem "Q_NEWGAM", "n", "PlayerclassMenu"
		PatchItem "Q_SKIRM",  "s", "ZA_SkirmishMenu"
		ifOption(SwapMenu)
		{
			PatchItem "Q_LOADG", "l", "LoadGameMenu"
			PatchItem "Q_SAVEG", "s", "SaveGameMenu"
			PatchItem "Q_CHAMP", "p", "QCDEPlayerMenu"
			PatchItem "Q_OPTION","c", "QCDEOptions"
			PatchItem "Q_OPTION","o", "OptionsMenu"
		}
		else
		{
			PatchItem "Q_CHAMP", "p", "QCDEPlayerMenu"
			PatchItem "Q_OPTION", "c", "QCDEOptions"
			PatchItem "Q_LOADG", "l", "LoadGameMenu"
			PatchItem "Q_SAVEG", "s", "SaveGameMenu"
		}
		PatchItem "Q_QUITG", "q", "QuitMenu"
	}

	IfGame(Heretic, Hexen)
	{
		TextItem "$MNU_NEWGAME", "n", "PlayerclassMenu"
		TextItem "$MNU_OPTIONS", "o", "OptionsMenu"
		TextItem "$MNU_GAMEFILES", "g", "GameFilesMenu"
		TextItem "$MNU_QUITGAME", "q", "QuitMenu"
	}
}

ListMenu "EpisodeMenu"
{
	IfGame(Doom, Heretic, Hexen, Strife)
	{
		NetgameMessage "$NEWGAME"
	}
	IfGame(Chex)
	{
		NetgameMessage "$CNEWGAME"
	}

	IfGame(Doom, Chex)
	{
		Position 48, 63
		StaticText 54, 38, "CHOOSE EPISODE"
	}
	IfGame(Strife)
	{
		Position 48, 63
		StaticText 54, 38, "$MNU_EPISODE"
	}
	IfGame(Heretic, Hexen)
	{
		Position 80, 50
	}
	// items will be filled in by MAPINFO
}

OptionMenu ZA_SkirmishMenu
{
	Indent 153
	Title		"SKIRMISH"

	StaticText ""

	Option		"Level",				"menu_skirmishlevel",			"ZA_Levels"
	Option		"Game Mode",			"menu_skirmishgamemode",		"ZA_Gamemode"
	//Option		"Modifier",				"menu_skirmishmodifier",		"ZA_Modifier"

	StaticText	" "

	NumberField	"Timelimit",			"menu_skirmishtimelimit"
	NumberField	"Fraglimit",			"menu_skirmishfraglimit"
	NumberField	"Pointlimit",			"menu_skirmishpointlimit"
	NumberField	"Duellimit",			"menu_skirmishduellimit"
	NumberField	"Winlimit",				"menu_skirmishwinlimit"
	NumberField	"Wavelimit",			"menu_skirmishwavelimit", 0, 10

	StaticText	" "

	Option		"Bot Skill",			"menu_skirmishbotskill",	ZA_Skill
	Option		"Bots can talk",		"bot_allowchat",			"YesNo"
	SubMenu		"Bot Setup",			"ZA_BotSetup"

	StaticText	" "

	Command		"Start Game!",			"menu_startskirmish"
}

OptionMenu "QCDEOptions"
{
	Indent 220
	Title 		"QCDE OPTIONS"

	StaticText	""

	Submenu		"Player Setup          ",		"QCDEPlayerMenu"
	Submenu 	"Keyboard/Mouse binds    ", 	"QCDEBinds"
	Submenu 	"Mouse Options         ",		"QCDEMouseOptions"
	Submenu 	"Zoom Options          ",		"QCDEZoom"

	StaticText	""

	Submenu 	"HUD & Display Options     ",	"QCDEHUDOptions"
	Submenu 	"Sound Options          ",		"QCDESoundOptions"
	Submenu 	"Video Options          ",		"VideoModeMenu"

	StaticText	""

	Submenu 	"Weapon Skins          ",		"QCDEWeaponSkins"
	Submenu 	"Misc QCDE Options       ",		"QCDEMisc"

	StaticText	""

	SubMenu		"Call a vote            ",		"ZA_CallVote"

	StaticText	""

	Submenu 	"All Engine options (old menu)",	"OptionsMenu"
}

ListMenu "QCDEPlayerMenu"
{
	StaticTextCentered 160, 0, "PLAYER SETUP"

	Linespacing 14
	Position 16, 56

	Linespacing 14
	Font "SmallFont"
	PlayerNameBox "Name", 0, "Playerbox"
	Selector "-", -16, -1
	MouseWindow 0, 220
	PlayerDisplay 220, 80, "#09016f", "#8901ab", 1, "PlayerDisplay"

	Linespacing 14
	Font "BigFont"
	ValueText "Champion : ", "Class"

	Font "SmallFont"
	StaticText 16, 90, "Champion changes apply after respawn"

	// Can't delete Skin option or else class preview won't update
	// Using a font with no letters instead
	Font "QCFNT100"
	ValueText "Skin (ignore)", "Skin"
	Class "PlayerMenu"
}

