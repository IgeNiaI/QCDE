Actor PostalSFXplayerHax
{
	Radius 1
	Height 1
	+NOINTERACTION
	+NONETID
	Projectile
	RenderStyle Add
	Scale 0.38
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Abilities/Postal/ActivateSFX",CHAN_5,1.0,0,0.4)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Warp(AAPTR_TARGET, 0,-7, 30, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Warp(AAPTR_TARGET, 0,-7, 30, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Warp(AAPTR_TARGET, 0,-7, 30, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		Stop
	}
}


