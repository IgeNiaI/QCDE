		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP19 E 12
			RP19 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP19 E 12
			QP19 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP19 F 6 BRIGHT Light("PlayerFiringLight")
			RP19 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP19 F 6 BRIGHT Light("PlayerFiringLight")
			QP19 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP19 G 4
			RP19 G 4 A_Pain
			RP19 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP19 G 4
			QP19 G 4 A_Pain
			QP19 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP19 H 5
		QP19 I 5 A_PlayerScream
		QP19 J 5 A_NoBlocking
		QP19 KLMNO 5
		QP19 P -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 a 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP19 Q 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP19 R 5
		QP19 S 5 A_NoBlocking
		QP19 TUVWXY 5
		QP19 Z -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}



//======================================================================================
//
//		20. Eradicator. AKA Dan + Ishi
//
//======================================================================================

Actor QCEradicator : QCPlayerHeavy
{
	Player.DisplayName "Eradicator"
	Player.SoundClass "Eradicator"
	Player.Palette "PL20"

	XScale 0.76
	YScale 0.75

	Player.FootstepInterval 13
	Player.FootstepVolume 0.75

	Player.MaxHealth 150
	Health 150
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 125

	Player.StartItem "Class_Eradicator"
	Player.StartItem "Body_Big"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"


	States
	{
	Spawn:
		QP20 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP20 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP20 A 0 A_JumpIf(true,                   "DefSpawn")
		QP20 A 100
		Loop

		ColoredSpawn:
			RP20 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP20 A 4
			Loop
		DefSpawn:
			QP20 A 0 A_JumpIf(momx||momy,"DefSee")
			QP20 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP20 BCDEFG 3
			RP20 B 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP20 BCDEFG 3
			QP20 B 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" H 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP20 H 12
			RP20 H 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP20 H 12
			QP20 H 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" I 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP20 I 6 BRIGHT Light("PlayerFiringLight")
			RP20 I 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP20 I 6 BRIGHT Light("PlayerFiringLight")
			QP20 I 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP20 M 4
			RP20 M 4 A_Pain
			RP20 M 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP20 M 4
			QP20 M 4 A_Pain
			QP20 M 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP20 N 5
		QP20 O 5 A_PlayerScream
		QP20 P 5 A_NoBlocking
		QP20 QR 5
		QP20 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sound
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP20 N 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		QP20 O 5 A_XScream
		QP20 P 5 A_NoBlocking
		QP20 QR 5
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sound
		QP20 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}



