#define MIN_TAUNT_DELAY 100
int last_taunt; // This affects all players. Bots don't talk one over another.
int muted[64], shmuted[64];
script "QCDE_VoiceLine" (int chance_percentage, int triggered_by_player, int which) clientside
{
	if(!triggered_by_player) // don't randomly fail manual calls
	{
		// Parametrized chance to utter a line
		if(((Timer() * 13) % 100) >= chance_percentage) terminate;

		// Client-decided option
		if(!CheckInventory("AutoTauntToken")) terminate;

		// Not too often
		if(last_taunt + MIN_TAUNT_DELAY > Timer()) terminate;
	}

	int plr = PlayerNumber();
	if(GetActorProperty(1000 + plr,APROP_HEALTH) <= 0) terminate;

	if(muted[plr]) terminate;
	if(shmuted[plr] && CPN() != plr) terminate;

	last_taunt = Timer();
	int classid = CheckInventory("ClassID");

	// Pick the right page, if there are any pages
	str page, pagename = "";
	if(taunt_count[classid][1])
	{
		for(int i = 1; i < 31; i++)
		if(taunt_count[classid][i])
		if(CheckInventory(taunt_txt[classid][i][T_TOKEN])) // this page eligible
		{
			page = i;
			pagename = strparam(s:"Page", d:page);
			break;
		}
	}

	int variety = taunt_count[classid][page];


	// Pick a random (or not) taunt and play it
	int index = (Timer() % variety) + 1;//random(1, variety);
	if(triggered_by_player && which > -1) index = ((which - 1) % variety) + 1;
	str sound = strparam(s:"QC", s:champion[classid].canon, s:pagename, s:"Taunt", d:index / 10, d:index % 10); // always two digits at least
	PlaySound(0,sound,CHAN_VOICE,1.0,false,1.0);
	//printbold(n:0, s:" is gloating with sample \c[white]", s:sound);
	ACS("QCDE_VoiceLineSubtitle", classid, page, index);
}

Script "QCDE_QCS_Mute" (int whomstdve)
{
	if(whomstdve < 0 || whomstdve > 63)
	{
		SetCvarString("qcs_status", strparam(s:"400: Index out of bounds: ", d:whomstdve));
	}
	else
	{
		ACS("QCDE_MuteControl", whomstdve, false, true);
		SetCvarString("qcs_status", strparam(s:"200: OK muted player ", d:whomstdve, s:" named ", n:whomstdve+1));
	}
}

Script "QCDE_QCS_Unmute" (int whomstdve)
{
	if(whomstdve < 0 || whomstdve > 63)
	{
		SetCvarString("qcs_status", strparam(s:"400: Index out of bounds: ", d:whomstdve));
	}
	else
	{
		ACS("QCDE_MuteControl", whomstdve, false, false);
		SetCvarString("qcs_status", strparam(s:"200: OK unmuted player ", d:whomstdve, s:" named ", n:whomstdve+1));
	}
}

Script "QCDE_QCS_ShMute" (int whomstdve)
{
	if(whomstdve < 0 || whomstdve > 63)
	{
		SetCvarString("qcs_status", strparam(s:"400: Index out of bounds: ", d:whomstdve));
	}
	else
	{
		ACS("QCDE_MuteControl", whomstdve, true, true);
		SetCvarString("qcs_status", strparam(s:"200: OK shadow-muted player ", d:whomstdve, s:" named ", n:whomstdve+1));
	}
}

Script "QCDE_QCS_ShUnmute" (int whomstdve)
{
	if(whomstdve < 0 || whomstdve > 63)
	{
		SetCvarString("qcs_status", strparam(s:"400: Index out of bounds: ", d:whomstdve));
	}
	else
	{
		ACS("QCDE_MuteControl", whomstdve, true, false);
		SetCvarString("qcs_status", strparam(s:"200: OK shadow-unmuted player ", d:whomstdve, s:" named ", n:whomstdve+1));
	}
}

Script "QCDE_MuteControl" (int whomstdve, int sh, int value) CLIENTSIDE
{
	if(!sh)
		muted[whomstdve] = value;
	else
		shmuted[whomstdve] = value;
}

#define GENERAL_LIKELINESS 3
script "QCDE_Target_Taunt" (int increase_likeliness)
{
	// Ever-shrinking chance to utter a line for living players.
	// Parameter = 0 does not prevent from taunting. Use -999 for this.
	//str victim = strparam(n:0);
	SetActivatorToTarget(0);
	if(GetActorProperty(0,APROP_HEALTH) <= 0) terminate; // no taunting when dead

	int taunt_now = GENERAL_LIKELINESS + increase_likeliness + CheckInventory("AutoTauntToken") - 5;
	//log(n:0, s:"... ", d:taunt_now, s:" / ", d:taunt_chance+1);
	if(random(0,taunt_chance++) > taunt_now) terminate;

	//printbold(n:0, s:" is gloating over defeated \c[white]", s:victim, s:"\nChance to speak was \c[brite]", d:taunt_now, s:" / ", d:taunt_chance+1);
	ACS_NamedExecuteAlways("QCDE_VoiceLine", 0, 100, 0, Timer()); // Delegate to bot script
}


