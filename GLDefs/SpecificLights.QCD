//=============================================================================
//=============================================================================
//
//		Ialdagorth related
//
// N.B.: QIaldagorth, unlike most others, has lights attached right here,
//       not in the actor definition.
//
//=============================================================================
//=============================================================================

//***************************************
//***************************************
pointlight IaldaBodyDarkness
{
	color 1.0 1.0  1.0
	size 120
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}
pointlight IaldaBodyDarkness1
{
	color 1.0 1.0  1.0
	size 100
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}
pointlight IaldaBodyDarkness2
{
	color 1.0 1.0  1.0
	size 80
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}
pointlight IaldaBodyDarkness3
{
	color 1.0 1.0  1.0
	size 60
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}
pointlight IaldaBodyDarkness4
{
	color 1.0 1.0  1.0
	size 40
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}
pointlight IaldaBodyDarkness5
{
	color 1.0 1.0  1.0
	size 20
	Subtractive 1
	offset 0 50 0
	dontlightself 1
}

object QIaldagorth
{
	frame Q37W  { light IaldaBodyDarkness  }
	frame Q37A  { light IaldaBodyDarkness  }
	frame Q37M  { light IaldaBodyDarkness  }
	frame Q37N  { light IaldaBodyDarkness  }

	frame Q37DA { light IaldaBodyDarkness1 }
	frame Q37DB { light IaldaBodyDarkness2 }
	frame Q37DC { light IaldaBodyDarkness3 }
	frame Q37DD { light IaldaBodyDarkness4 }
	frame Q37DE { light IaldaBodyDarkness5 }
}


