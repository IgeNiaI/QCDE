			}}}}}}}}}}}}}}}}}}}} // 20 braces
			else {                       drawImage "PWUPSC00",  242,780; }
		}

		// Invul
		inInventory PowerInvul {
			drawImage "PWUPFRAM", 302,780;
			drawImage "PWUPFIR1", 302,780;
			drawImage "PWUPPENT", 303,780;
			inInventory InvulTimer, 1 {
			inInventory InvulTimer,20 { drawImage "PWUPSC20",  302,780; } else {
