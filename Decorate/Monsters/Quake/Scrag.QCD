//================================================================
//================================================================
Actor QScrag : QCDE_MonsterMedium 	15113	// cacodemon
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 300
	Speed 12
	Radius 31
	Height 56
	PainChance 128
	Mass 400
	Scale 0.45
	REACTIONTIME 8
	Monster
	+NOGRAVITY
	+FLOAT
	Tag "$TAG_QScrag" // "Scrag"
	SeeSound "Quake1/Scrag/Sight"
	PainSound "Quake1/Scrag/Pain"
	DeathSound "Quake1/Scrag/Death"
	ActiveSound "Quake1/Scrag/Idle"
	Obituary "$OB_QScrag" // "%o was scragged by a scrag."
	States
	{
	Idle:
		Q36I A 10 A_Look
		Loop
	See:
		Q36W AABBCCDDEEFF 3 A_Chase
		Loop

	Missile:
		TNT1 A 0 A_PlaySound("Quake1/Scrag/Attack",6)
		Q36A B 8 A_FaceTarget
		TNT1 A 0 A_CustomMissile("ScragBall",28,-8,0)
		Q36A CC 6 A_FaceTarget
		TNT1 A 0 A_CustomMissile("ScragBall",28,8,0)
		Q36A C 8 A_FaceTarget
		Q36A DC 6 A_FaceTarget
		Goto See
	Pain:
		Q36P A 4
		Q36P A 4 A_Pain
		Goto See

	DeathChecksDone:
		Q36D A 0 A_Scream
		Q36D A 4
		Q36D B 4 A_Fall
		Q36D CDEF 4
	Death.Corpse:
		Q36D G -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q36D GFEDCBA 5
		Goto See
	}
}


Actor ScragBall
{
	Radius 12
	Height 8
	Speed 18
	Damage 3
	scale 0.15
	DeathSound "Quake1/Scrag/Impact"
	Translation "0:255=%[0,0,0]:[0.74,0.88,0.2]"
	RenderStyle Add
	PROJECTILE
	+MISSILE
	+FORCEXYBILLBOARD
	states
	{
	Spawn:
		DB58 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2 Bright Light("OliveGreenMediumPoint3") A_SpawnItemEx("KnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION,200)
		loop
	Death:
		DB59 A 0 A_SetScale(0.3)
		DB59 A 2 Bright Light("OliveGreenMediumPoint3")
		DB59 B 2 Bright Light("OliveGreenMediumPoint2")
		DB59 C 2 Bright Light("OliveGreenMediumPoint3")
		DB59 D 2 Bright Light("OliveGreenSmallPoint1")
		DB59 E 2 Bright Light("OliveGreenSmallPoint2")
		DB59 F 2 Bright Light("OliveGreenSmallPoint3")
		DB59 GHIJKLMNOPQRS 2 Bright
		stop
    }
}
