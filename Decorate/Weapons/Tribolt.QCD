	Idle.Modded:
		MDCE A 0 A_PlaySound("QC/Weapons/Tribolt/Idle_Modded",CHAN_WEAPON,1,1)
		Goto IdleCont

	Idle.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Idle.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Idle.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Idle.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Idle.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Idle.Upgraded.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Idle.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Idle.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Idle.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Idle.Upgraded.Quake1")
	Idle.Upgraded.Default:
		QCIE A 0
		Goto IdleCont
	Idle.Upgraded.Quake1:
		Q1IE A 0
		Goto IdleCont
	Idle.Upgraded.Quake2:
