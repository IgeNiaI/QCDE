	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Lucienne"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP25 A 0 NoDelay
		QP25 A 0 A_JumpIfInventory("TeamColor",2, "RedSpawn")
		QP25 A 0 A_JumpIfInventory("TeamColor",1,"BlueSpawn")
		QP25 A 0 A_JumpIf(true,                   "DefSpawn")
		QP25 C 100
		Loop

		RedSpawn:
			RP25 A 0 A_JumpIf(momx||momy,"RedSee")
			RP25 C 4
			Loop
		BlueSpawn:
			BP25 A 0 A_JumpIf(momx||momy,"BlueSee")
			BP25 C 4
			Loop
		DefSpawn:
			QP25 A 0 A_JumpIf(momx||momy,"DefSee")
			QP25 C 4
			Goto Spawn // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedSee") // so tempted to call it "Red Sea"
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		RedSee:
			RP25 ABCDCB 3
			RP25 B 0 A_JumpIf(true,"RedSpawn")
			Loop
		BlueSee:
			BP25 ABCDCB 3
			BP25 B 0 A_JumpIf(true,"BlueSpawn")
			Loop
		DefSee:
			QP25 ABCDCB 3
			QP25 B 0 A_JumpIf(true,"Spawn") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMissile")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		RedMissile:
			RP25 E 12
			RP25 E 12 A_JumpIf(true, "Spawn")
			Loop
		BlueMissile:
			BP25 E 12
			BP25 E 12 A_JumpIf(true, "Spawn")
			Loop
		DefMissile:
			QP25 E 12
			QP25 E 12 A_JumpIf(true, "Spawn")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMelee")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP25 F 6 BRIGHT Light("PlayerFiringLight")
			RP25 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP25 F 6 BRIGHT Light("PlayerFiringLight")
			BP25 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP25 F 6 BRIGHT Light("PlayerFiringLight")
			QP25 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		RedPain:
			RP25 G 4
			RP25 G 4 A_Pain
			RP25 G 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP25 G 4
			BP25 G 4 A_Pain
			BP25 G 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP25 G 4
			QP25 G 4 A_Pain
			QP25 G 4 A_JumpIf(true, "Spawn")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP25 H 5
		QP25 I 5 A_PlayerScream
		QP25 J 5 A_NoBlocking
		QP25 A 0 A_SpawnItemEx("LucienneWeapon", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP25 KLMN 5
		QP25 o -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP25 H 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		QP25 I 5 A_XScream
		QP25 J 5 A_NoBlocking
		QP25 A 0 A_SpawnItemEx("LucienneWeapon", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP25 KLMN 5
		QP25 O -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


Actor LucienneWeapon
{
	+CLIENTSIDEONLY
	+SERVERNETID
	-NOLIFTDROP
	-SOLID
	+DROPOFF
	+NOTELEPORT
	+CORPSE
	Scale 0.52
	Radius 6
	Height 5
	States
	{
	Spawn:
		QP25 P 6
		"####" "#" 175 //5sec
		"####" "#" 1 A_FadeOut
		Wait
	}
}




