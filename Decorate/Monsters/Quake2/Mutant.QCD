//================================================================
//================================================================

Actor Q2Mutant : QCDE_MonsterSmall	15214	// demon
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 150
	Radius 20
	Height 56
	Mass 400
	Speed 12
	MeleeDamage 5
	MeleeRange 75
	Damage 5
	PainChance 160
	Scale 0.6
	MONSTER
	Tag "$TAG_Q2Mutant" // "Mutant"
	SeeSound "q2mutant/sight"
	PainSound "q2mutant/pain"
	DeathSound "q2mutant/death"
	ActiveSound "q2mutant/seeking"
	MeleeSound "q2mutant/meleehit"
	AttackSound ""
	+FLOORCLIP
	Obituary "$OB_Q2Mutant" // "%o was disemboweled by a mutant."
	States
	{
	Idle:
		Q2MI A 5 A_Look
		Loop
	See:
		Q2MW A 2 A_Chase("Melee","")	Q2MW A 1 A_Chase("Melee","")
		Q2MW B 2 A_Chase("Melee","")	Q2MW B 1 A_Chase("Melee","")
		Q2MW C 2 A_Chase("Melee","")	Q2MW C 2 A_Chase("Melee","")
		Q2MW D 2 A_Chase				Q2MW D 1 A_Chase
		Q2MW E 2 A_Chase				Q2MW E 1 A_Chase
		Q2MW F 2 A_Chase				Q2MW F 1 A_Chase
		Loop
	SeeNoMissile: 	//cooldown of jumps after one was performed
		Q2MW A 2 A_Chase("Melee","")	Q2MW A 1 A_Chase("Melee","")
		Q2MW B 2 A_Chase("Melee","")	Q2MW B 1 A_Chase("Melee","")
		Q2MW C 2 A_Chase("Melee","")	Q2MW C 2 A_Chase("Melee","")
		Q2MW D 2 A_Chase("Melee","")	Q2MW D 1 A_Chase("Melee","")
		Q2MW E 2 A_Chase("Melee","")	Q2MW E 1 A_Chase("Melee","")
		Q2MW F 2 A_Chase("Melee","")	Q2MW F 1 A_Chase("Melee","")
		Q2MW A 2 A_Chase("Melee","")	Q2MW A 1 A_Chase("Melee","")
		Q2MW B 2 A_Chase("Melee","")	Q2MW B 1 A_Chase("Melee","")
		Q2MW C 2 A_Chase("Melee","")	Q2MW C 2 A_Chase("Melee","")
		Q2MW D 2 A_Chase("Melee","")	Q2MW D 1 A_Chase("Melee","")
		Q2MW E 2 A_Chase("Melee","")	Q2MW E 1 A_Chase("Melee","")
		Q2MW F 2 A_Chase("Melee","")	Q2MW F 1 A_Chase("Melee","")
		Goto See

	Melee:
		Q2MA ABCD 3 A_FaceTarget
		Q2MA Z 0 A_PlaySound("q2mutant/meleeswing")
		Q2MA E 4 A_MeleeAttack
		Q2MA FG 3 A_FaceTarget
		Q2MA Z 0 A_PlaySound("q2mutant/meleeswing")
		Q2MA H 3 A_MeleeAttack
		Q2MA I 3 A_FaceTarget
		Goto See
	Missile:
		TNT1 A 0 A_GiveInventory("JumpCheck",1)
		Q2MW A 0 A_PlaySound("q2mutant/sight")
		Q2MW AB 3 A_Facetarget
		TNT1 A 0 A_SkullAttack
		Q2MW C 1 ThrustThingZ(0,25,0,0)
		Q2MW C 1 A_CheckFloor("Landed")
		Wait

		Landed:
			Q2MW D 3
			TNT1 A 0 A_Stop
			Q2MW EF 3
			Goto SeeNoMissile

	Pain:
		Q2MP A 5
		Q2MP A 5 A_Pain
		Goto See
	DeathChecksDone:
		Q2MD A 0 A_Scream
		Q2MD AB 4
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Small",6)
		Q2MD C 4 A_NoBlocking
		Q2MD DEFGH 4
	Death.Corpse:
		Q2MD I -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q2MD IHGFEDCBA 4
		Goto See
	}
}





