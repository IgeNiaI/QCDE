		DKFX A 2 Bright A_SetScale(scalex+0.15)
		DKFX B 2 Bright A_SetScale(scalex+0.15)
		DKFX C 2 Bright A_SetScale(scalex+0.12)
		DKFX D 2 Bright A_SetScale(scalex+0.1)
	Looper:
		DKFX E 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX F 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX G 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX H 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX A 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX B 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX C 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		DKFX D 2 Bright A_SetScale(scalex+0.05)		TNT1 A 0 A_FadeOut(0.1)
		Loop
	}
}
Actor DarkMattGrenExplo2
{
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.25
	Alpha 0.9
	+NOINTERACTION +NOTONAUTOMAP
	States
