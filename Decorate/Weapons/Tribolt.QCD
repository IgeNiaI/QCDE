	FireCont:
		"####" A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		"####" A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 20, "NormalSound.Modded")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 8, "NormalSound.SeriousSam")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 7, "NormalSound.HalfLife")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 6, "NormalSound.Default")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 5, "NormalSound.Quake4") // Fallback to another skin
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 4, "NormalSound.Quake4")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 3, "NormalSound.Quake3")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 2, "NormalSound.Quake2")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 1, "NormalSound.Quake1")
		NormalSound.Default:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Default", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.Quake1:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.Quake2:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.Quake3:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.Quake4:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.HalfLife:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.SeriousSam:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		NormalSound.Modded:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Fire_Modded", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq

		QuadSound:
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 20, "QuadSound.Modded")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 8, "QuadSound.SeriousSam")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 7, "QuadSound.HalfLife")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 6, "QuadSound.Default")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 5, "QuadSound.Quake4") // Fallback to another skin
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 4, "QuadSound.Quake4")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 3, "QuadSound.Quake3")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 2, "QuadSound.Quake2")
			"####" A 0 A_JumpIfInventory("QCTriboltSkin", 1, "QuadSound.Quake1")
		QuadSound.Default:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Default", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.Quake1:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.Quake2:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.Quake3:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.Quake4:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.HalfLife:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.SeriousSam:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq
		QuadSound.Modded:
			"####" A 0 A_PlaySound("QC/Weapons/Tribolt/Quad/Fire_Modded", CHAN_WEAPON, 1.0, 0)
			Goto ContinueFiringSeq

	ContinueFiringSeq:
		"####" A 0 A_AlertMonsters
		"####" A 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED) //it fires 3 projectiles, but only uses 1 ammo

		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 0 A_GunFlash("PrimaryFlash")
		"####" B 1 Offset(2,35) Bright
		"####" C 1 Offset(4,37) Bright
		"####" D 1 Offset(6,39)
		"####" D 1 Offset(7,40)
		"####" D 1

		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 0 A_GunFlash("PrimaryFlash")
		"####" E 1 Offset(10,43) Bright
		"####" F 1 Offset(12,45) Bright
		"####" G 1 Offset(14,47)
		"####" H 1 Offset(15,48)
		"####" H 1

		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 0 A_GunFlash("PrimaryFlash")
		"####" I 1 Offset(18,51) Bright
		"####" J 1 Offset(20,53) Bright
		"####" K 1 Offset(22,55)
		"####" K 1 Offset(23,56)
		"####" L 1 //15

		"####" L 1

		"####" M 9	//25

		"####" N 1 Offset(22,55)
		"####" N 1 Offset(20,53)
		"####" N 1 Offset(18,51)
		"####" O 1 Offset(15,48)
		"####" O 1 Offset(12,45)
		"####" O 1 Offset(9,42)
		"####" P 1 Offset(7,40)
		"####" P 1 Offset(5,38)
		"####" P 1 Offset(4,36)
		"####" Q 2 Offset(3,35)
		"####" Q 2 Offset(2,34)
		"####" R 2 Offset(1,33)
		"####" S 4 Offset(0,32)
		"####" A 2 Offset(0,32) 	//46 tics, 1.314s instead of 1.3s as in QC. Close enough
		Goto Idle

	PrimaryFlash: //Attacks doer
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
		Goto PerformSP

		PerformSP:
			TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"GrenadeCheckIfZoomed")
			TNT1 A 0 A_JumpIfInventory("TB_UG_Long",1,"FireLongBolt")
			TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "PerformSP.Modded")
		PerformSP.Default:
			TNT1 A 0 A_FireCustomMissile("TriboltBolt", 0, false, 1, 5)
			Goto EndFlash
		PerformSP.Modded:
			TNT1 A 0 A_FireCustomMissile("TriboltBolt_Modded", 0, false, 1, 5)
			Goto EndFlash

			FireLongBolt:
				TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "FireLongBolt.Modded")
			FireLongBolt.Default:
				TNT1 A 0 A_FireCustomMissile("TriboltBoltLong", 0, false, 1, 5)
				Goto EndFlash
			FireLongBolt.Modded:
				TNT1 A 0 A_FireCustomMissile("TriboltBoltLong_Modded", 0, false, 1, 5)
				Goto EndFlash

			GrenadeCheckIfZoomed:
				TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FireGrenades")
				Goto PerformSP+1
			FireGrenades:
				TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "FireGrenades.Modded")
			FireGrenades.Default:
				TNT1 A 0 A_FireCustomMissile("TriboltBoltGrenade", 0, false, 1, 5)
				Goto EndFlash
			FireGrenades.Modded:
				TNT1 A 0 A_FireCustomMissile("TriboltBoltGrenade_Modded", 0, false, 1, 5)
				Goto EndFlash


		PerformDM:
			TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "PerformDM.Modded")
		PerformDM.Default:
			TNT1 A 0 A_FireCustomMissile("TriboltBoltDM", 0, false, 1, 5)
			Goto EndFlash
		PerformDM.Modded:
			TNT1 A 0 A_FireCustomMissile("TriboltBoltDM_Modded", 0, false, 1, 5)
			Goto EndFlash

	EndFlash:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlash.BlendCont")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "EndFlash.Blend.Modded")
		TNT1 A 0 A_SetBlend("Orange",0.055,10)
		Goto EndFlash.BlendCont
	EndFlash.Blend.Modded:
		TNT1 A 0 A_SetBlend("$WeaponSkin_Tribolt_ScreenBlend_Modded",0.055,10)
	EndFlash.BlendCont:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-1.2)
		TNT1 AAA 1 A_SetPitch(pitch+0.4)
		Stop
	EndFlashNoRecoil:
		TNT1 A 1
		Stop
	}
}

Actor AmmoSpender
{
	+NOINTERACTION
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 3
		Stop
	}
}

Actor TriboltBolt
{
	Projectile
	+EXTREMEDEATH
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	//-NOGRAVITY
	+MTHRUSPECIES
	+DONTSPLASH
	+DONTBLAST
	Gravity 0.2
	Radius 4
	Height 8
	Speed 37
	Damage (random(3,7)*8)
	Scale 0.35
	Obituary "$OB_QCTribolt"
	SeeSound ""
	BounceType "Hexen"
	+USEBOUNCESTATE
	Reactiontime 21
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("quake4/Weapons/RocketLauncher/FlyWhoosh",CHAN_7,1,1,5)
		GRNL A 1 Light(YellowSmallPoint2) Bright
		GRNL A 0 A_CountDown
		GRNL A 1 Light(YellowSmallPoint2) Bright
		GRNL A 0 A_ChangeFlag("NOGRAVITY",0)
		GRNL A 0 A_CountDown
	Looper:
		GRNL A 0 A_SpawnItemEx("TriboltTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		GRNL A 1 Light(YellowSmallPoint2) Bright
		GRNL A 0 A_CountDown
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		//Medals start
		TNT1 A 0 A_GiveToTarget("TBDirectDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
		TNT1 A 0 A_Jump(256,"DeathCont")
		Goto DeathInvis

	Bounce:	//for when it hits floor/planes, it doesnt get destroyed, but stays there for 0.8 sec
		GRNL A 0 A_PlaySound("QC/Weapons/Tribolt/Impact",CHAN_AUTO,1,0,1.2)
		GRNL A 0 A_ChangeFlag("NOGRAVITY",1)
		GRNL A 0 A_Stop
	BounceLoop:
		GRNL B 1 Light(YellowSmallFlicker2) A_CountDown
		Loop

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		TNT1 A 0 A_Jump(256,"DeathCont")
		Goto DeathInvis

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			//Medals start
			TNT1 A 0 A_GiveToTarget("TBSplashDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			TNT1 A 0 A_Jump(256,"DeathCont")
			Goto DeathInvis

    DeathInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DeathCont:
		TNT1 A 0 A_RadiusThrust(68,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(20,128,XF_HURTSOURCE)	//self damage, to do some jumps
 		TNT1 A 0 A_Explode(50,128,0,0,32)
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_Jump(256,"DeathEffects")
	DeathEffects:
		TNT1 A 0 A_CustomMissile("BoltDecalMaker",0,0,  180, CMF_NOUNLAGGED)	//to attempt to leave a scorch mark
		TNT1 A 0 A_SpawnItemEx("BoltExplosionSpawner",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

Actor TriboltBolt_Modded : TriboltBolt
{
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("QC/Weapons/Tribolt/Fly_Modded",CHAN_7,1,1,5)
		MDYE A 1 Light(YellowSmallPoint2) Bright
		MDYE A 0 A_CountDown
		MDYE A 1 Light(YellowSmallPoint2) Bright
		MDYE A 0 A_ChangeFlag("NOGRAVITY",0)
		MDYE A 0 A_CountDown

	Looper:
		MDYE A 0 A_SpawnItemEx("TriboltTrailFire_Modded",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MDYE A 1 Light(YellowSmallPoint2) Bright
		MDYE A 0 A_CountDown
		Loop

	Bounce:	//for when it hits floor/planes, it doesnt get destroyed, but stays there for 0.8 sec
		MDYE A 0 A_PlaySound("QC/Weapons/Tribolt/Impact_Modded",CHAN_AUTO,1,0,1.2)
		MDYE A 0 A_ChangeFlag("NOGRAVITY",1)
		MDYE A 0 A_Stop

	BounceLoop:
		MDYE B 1 Light(YellowSmallFlicker2) A_CountDown
		Loop

	DeathEffects:
		TNT1 A 0 A_CustomMissile("BoltDecalMaker_Modded",0,0,180,CMF_NOUNLAGGED)
		TNT1 A 0 A_SpawnItemEx("BoltExplosionSpawner_Modded",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Goto Super::DeathEffects+2
	}
}


