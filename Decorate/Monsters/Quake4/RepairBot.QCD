//=====================================================================================
//=====================================================================================
//
//=====================================================================================
//=====================================================================================

Actor Q4RepairBot : QCDE_MonsterSmall	15316	//lost soul
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 40
	Mass 250
	Health 100
	PainChance 64
	Speed 11
	Scale 0.4
	+NOGRAVITY
	+FLOAT
	+FLOATBOB
	+NOBLOOD
	+FLOORCLIP
	+BRIGHT
	Damage 3
	Obituary "$OB_Q4RepairBot" // "%o was given severe bruises by a repair bot."
	SeeSound "quake4/Repairbot/Sight"
	PainSound ""
	DeathSound "quake4/Repairbot/Death"
	ActiveSound ""
	Tag "$TAG_Q4RepairBot" // "Repair Bot"
	States
	{
	Spawn:
		TNT1 a 0 A_PlaySound("quake4/Repairbot/FlyLoop",5,0.5,1)
		Goto Super::Spawn
	Idle:
		Q15W A 5 A_Look
		Loop
	See:
		Q15D A 0 A_ChangeFlag("FLOATBOB",1)
		Q15W A 6 A_Chase
		Loop
	Missile:
		Q15D A 0 A_ChangeFlag("FLOATBOB",0)
		Q15W B 5 A_FaceTarget
		Q15W B 4 A_SkullAttack(25)
		Q15W B 4
		Wait
	Pain:
		Q15W A 3
		Goto See
	XDeathChecksDone:
	DeathChecksDone:
		Q15D A 0 A_StopSound(5)
		Q15D A 0 A_ChangeFlag("FLOATBOB",0)
		TNT1 A 0 A_PlaySound("quake4/Misc/GrenadeExplo",5,0.5)
		TNT1 A 0 A_Scream
		Q15D A 0 A_Fall
		TNT1 AAAAAAA 0 A_TossGib
		TNT1 A 0 A_SpawnItemEx("BoltExplosion",0,0,20,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 2 Light("YellowSmallFlicker1")
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowMediumFlicker2")
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowSmallFlicker1")
		TNT1 A 2 Light("YellowSmallFlicker2")
		TNT1 A 2 Light("YellowSmallFlicker3")
	Death.Corpse:
		TNT1 A 10
		Stop
	}
}



