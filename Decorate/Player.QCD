//======================================================================================
//
//		4. Kane. AKA Quake4guy
//
//======================================================================================

Actor QCKane : QCPlayerLight
{
	Player.DisplayName "Kane"
	Player.SoundClass "Kane"
	Player.Palette "PL04"

	Scale 0.5

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Kane"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveDefensive"
	Player.StartItem "NotSpectator"

	Damagefactor "Falling", 0.1 // passive relies on falling, so he's resistant

	States
	{
	Spawn:
		QP04 G 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP04 G 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP04 G 0 A_JumpIf(true,                   "DefSpawn")
		QP04 G 100
		Loop

		ColoredSpawn:
			RP04 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP04 G 4
			Loop
		DefSpawn:
			QP04 A 0 A_JumpIf(momx||momy,"DefSee")
			QP04 G 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP04 ABCDEF 4
			RP04 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP04 ABCDEF 4
			QP04 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" G 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP04 G 12
			RP04 G 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP04 G 12
			QP04 G 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP04 H 6 BRIGHT Light("PlayerFiringLight")
			RP04 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP04 H 6 BRIGHT Light("PlayerFiringLight")
			QP04 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" I 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP04 I 4
			RP04 I 4 A_Pain
			RP04 I 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP04 I 4
			QP04 I 4 A_Pain
			QP04 I 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP04 J 4
		QP04 K 4 A_PlayerScream
		QP04 L 4 A_NoBlocking
		QP04 MN 4
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sounds
		QP04 O -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP04 J 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP04 K 4 A_XScream
		QP04 L 4 A_NoBlocking
		QP04 MN 4
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sounds
		QP04 O -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


