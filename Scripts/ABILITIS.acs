//---------------------------------
//		Major's Active

#define MAJOR_ROCKETS   4

Script "QCDE_Ability_Major" (void)
{
	int rocketsfired=0;
	int duration;
	int imabot;
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("ActiveInProgress",1);
	GiveInventory("NoWeaponFireToken",1);

	GiveInventory("StrikesCounter",MAJOR_ROCKETS);

	//PlaySound(0, "QC/Abilities/Major/IncomingVO", CHAN_VOICE, 1.0, false, 1.0);
	PlaySound(0, "QC/Abilities/Major/Activate", 7, 0.8, false, 0.3);
	SetNetworkReplicationFlags( 0 );

	if(PlayerIsBot(PlayerNumber()))
		imabot=1;

	ACS("QCDE_MajorCharges", MAJOR_ROCKETS);

	while(rocketsfired < MAJOR_ROCKETS && duration<= GetDuration())
	{
		if (GetPlayerInput(-1, INPUT_BUTTONS) & BT_ATTACK || imabot>=1 )
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("MajorAirStrikeProc",1);
			AmbientSound("QC/Abilities/Major/Launch",64);	//everyone hears it low
			rocketsfired++;
			TakeInventory("StrikesCounter",1);
			SetNetworkReplicationFlags( 0 );
			ACS("QCDE_MajorCharges", CheckInventory("StrikesCounter"), true);
			delay(10);
			duration=duration+10;
		}
		duration++;
		delay(1);
		if(GetActorProperty(0,APROP_HEALTH) <= 0)
		{
			while(rocketsfired<MAJOR_ROCKETS)
			{
				SetNetworkReplicationFlags( NETREP_SKIPOWNER );
				GiveInventory("MajorAirStrikeShortProc",1);
				rocketsfired++;
				TakeInventory("StrikesCounter",1);
				SetNetworkReplicationFlags( 0 );
				ACS("QCDE_MajorCharges", CheckInventory("StrikesCounter"), true);
				delay(10);
			}
		}
	}

	while(CheckInventory("StrikesCounter"))
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		TakeInventory("StrikesCounter",1);
		SetNetworkReplicationFlags( 0 );
		ACS("QCDE_MajorCharges", CheckInventory("StrikesCounter"), true);
	}
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}


