//---------------------------------
//		Lo Wang's Passive

#define LOWANG_TAP_DELAY    25
#define LOWANG_TIC_PERIOD    5
#define LOWANG_MAX_DURATION 35
#define LOWANG_LOW_HEALTH   40
#define LOWANG_DMG_PERIOD   10
Script "QCDE_Passive_LoWang" (void)
{
	// Right-right-use healing and extra damage when low
	int buttons, oldbuttons, triggers;
	int lastTapTime, lastTapValue, tapSequence, angle;
	int ws_axis, ad_axis;
	int rageTime, healTime;

	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		// Player input information
		oldbuttons = buttons;
		buttons = GetPlayerInput(-1, INPUT_BUTTONS) & ~BT_SPEED;
		ws_axis = GetPlayerInput(-1, INPUT_FORWARDMOVE);
		ad_axis = GetPlayerInput(-1, INPUT_SIDEMOVE);
		if(ws_axis < 0) buttons |= BT_BACK;
		if(ws_axis > 0) buttons |= BT_FORWARD;
		if(ad_axis < 0) buttons |= BT_MOVELEFT;
		if(ad_axis > 0) buttons |= BT_MOVERIGHT;
		triggers = buttons & ~oldbuttons;

		// Extra damage when low
		if (!(Timer() % LOWANG_DMG_PERIOD))
			if (GetActorProperty(0, APROP_HEALTH) <= LOWANG_LOW_HEALTH)
			{
				if(!rageTime) GiveInventory("LoWangRageSoundProc", 1);
				rageTime++;

				GiveInventory("LoWangPassiveDamage", 1);
			}
			else
			{
				TakeInventory("PowerLoWangDamage", 1);
				rageTime=0;
			}


		// Hold detection
		// Player holds +use
		if (buttons & BT_USE)
		{
			if (lastTapTime + LOWANG_TAP_DELAY > Timer()) // if tapping time hasn't yet expired
			{
				if (!(Timer() % LOWANG_TIC_PERIOD))
				{
					if(!healTime) GiveInventory("LoWangHealSoundProc", 1);
					healTime++;

					GiveInventory("LoWangHealAreaProc", 1);
				}

				lastTapTime = Timer();

				// Duration cap. Measured in LOWANG_TIC_PERIODs.
				if (healTime > LOWANG_MAX_DURATION) lastTapTime = 0;
			}
		}
		// Tap detection
		// Player taps D, holds no other button
		else if (buttons == BT_MOVERIGHT && !oldbuttons)
		{
			healTime=0;
			if (lastTapTime + LOWANG_TAP_DELAY > Timer()){ // if tapping time hasn't yet expired
				tapSequence += 1;
			} else {
				tapSequence = 1;
			}
			//printbold(s:"\c[bludi] TAP! \nseq = ", d:tapSequence, s:"\ndelay = ", d:Timer() - lastTapTime);
			lastTapTime = Timer();
		}

		delay(1);
	}
}




//---------------------------------
//		Grayson's Passive

#define GRAYSON_NEWLIFE_DELAY 15
#define GRAYSON_INITIAL_DELAY 20
#define GRAYSON_HOLD_DELAY    28
#define GRAYSON_ARMOR_TAKE    25

Script "QCDE_Passive_Grayson" (void)
{
	// Hold +use to buy ammo packs for armor blocks
	int holdPulses, lastHoldPulses;
	int lastHoldStartTime = Timer();
	int CurrentAmmo;

	// Separate block to wait for respawn spacebar to release
	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		if(CurrentAmmo ++> GRAYSON_NEWLIFE_DELAY) break;
		delay(1);
	}

	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		delay(1);

		if (!(GetPlayerInput(-1, INPUT_BUTTONS) & BT_USE)) continue;

		// -- Now alive and holding +use --

		if (!(GetPlayerInput(-1, INPUT_OLDBUTTONS) & BT_USE))
			lastHoldStartTime = Timer();

		if		(qcContains("Mac"))	CurrentAmmo = 0;
		else if (qcContains("Sho"))	CurrentAmmo = 1;
		else if (qcContains("Nai"))	CurrentAmmo = 2;
		else if (qcContains("Tri"))	CurrentAmmo = 3;
		else if (qcContains("Roc"))	CurrentAmmo = 4;
		else if (qcContains("Lig"))	CurrentAmmo = 5;
		else if (qcContains("Rai"))	CurrentAmmo = 6;
		else if (qcContains("BFG"))	CurrentAmmo = 7;
		else continue;
		int amount = getGraysonAmmoPackSize(CurrentAmmo);

		lastHoldPulses = holdPulses;
		int duration = Timer() - lastHoldStartTime;
		holdPulses = (duration + GRAYSON_HOLD_DELAY - GRAYSON_INITIAL_DELAY) / GRAYSON_HOLD_DELAY; // [Ms] sorry for arcaneness, but this is still better than previous attempt

		if (lastHoldPulses == holdPulses) continue; // prevent from triggering every tic

		//log(s:"trig: ", d:lastHoldStartTime, s:" -> ", d:Timer(), s:". diff ", d:duration + GRAYSON_HOLD_DELAY - GRAYSON_INITIAL_DELAY, s:".  pulse = ", d:holdPulses);

		if (holdPulses < 1) continue; // prevent from triggering too early

		if (holdPulses == 1)
		{
			// Show initial prompt
			ACS("QCDE_GraysonText", amount, 0, CurrentAmmo);
			continue;
		}

		// -- holdPulses > 1: now buying stuff --

		if(CheckInventory("BasicArmor") >= GRAYSON_ARMOR_TAKE)
		{
			// To be used if we decide to drop player's excess ammo
			//int x = GetActorX(0);
			//int y = GetActorY(0);
			//int z = GetActorZ(0) + 30.0;
			if(GiveAndCheck(AmmoType[CurrentAmmo], amount))
			{
				// Bought successfully
				TakeInventory("BasicArmor", GRAYSON_ARMOR_TAKE);
				ACS("QCDE_GraysonText", amount, 1, CurrentAmmo);
				//log(d:Timer(), s:": pulses = ", d:holdPulses, s:", lastHoldStartTime = ", d:lastHoldStartTime, s:" (duration = ", d:duration, s:")");
			}
			else
			{
				// Full already
				ACS("QCDE_GraysonText", amount, -2, CurrentAmmo);
			}
		}
		else
		{
			// No money -- no honey
			ACS("QCDE_GraysonText", amount, -1, CurrentAmmo);
		}
	}
}

// Activator: dying monster
Script "QCDE_MonsterKill_QCGrayson" (void)
{
	int max = GetActorProperty(0,APROP_SPAWNHEALTH);
	int bounty = sqrt(max / 5);

	SetActivatorToTarget(0);
