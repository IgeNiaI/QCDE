//=====================================================================================
//=====================================================================================
Actor Q4LightGuard : QCDE_MonsterSmall	15310	//zombieman
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 56
	Mass 100
	Health 30
	PainChance 200
	Speed 11
	Scale 0.47
	+FLOORCLIP
	SeeSound "quake4/StroggMarine/Sight"
	PainSound "quake4/StroggMarine/Pain"
	DeathSound "quake4/StroggMarine/Death"
	ActiveSound "quake4/StroggMarine/Idle"
	Obituary "$OB_Q4LightGuard" // "A Strogg guard pelted %o to death with his mere blaster."
	Tag "$TAG_Q4LightGuard" // "Light Guard"
	States
	{
	Idle:
		Q21I A 4 A_Look
		Loop
	See:
		Q21W AABBCCDD 3 A_Chase
		Loop
	Missile:
		Q21A ABC 4 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/StroggMarine/BlasterShot",6)
		Q21A D 4 A_CustomMissile("Q4BlasterProjSmallWeak",25,7,0+random(2,-2))
		Q21A C 4 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/StroggMarine/BlasterShot",6)
		Q21A D 4 A_CustomMissile("Q4BlasterProjSmallWeak",25,7,0+random(2,-2))
		Q21A C 4 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/StroggMarine/BlasterShot",6)
		Q21A D 4 A_CustomMissile("Q4BlasterProjSmallWeak",25,7,0+random(2,-2))
		Q21A C 4 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/StroggMarine/BlasterShot",6)
		Q21A D 4 A_CustomMissile("Q4BlasterProjSmallWeak",25,7,0+random(2,-2))
		Q21A C 4 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/StroggMarine/BlasterShot",6)
		Q21A D 4 A_CustomMissile("Q4BlasterProjSmallWeak",25,7,0+random(2,-2))
		Q21A BA 4
		Goto See
	Pain:
		Q21P A 7 A_Pain
		Goto See

	DeathChecksDone:
		Q21D A 0 A_Scream
		Q21D ACD 3
		Q21D A 0 A_Fall
		Q2SD A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Q2SD A 0 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q21D F -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

    Ice:
		"####" "#" 0 A_GiveInventory("ImDead",1)
		"####" "#" 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q21D FEDCBA 3
		Goto See
	}
}

Actor Q4BlasterProjSmallWeak
{
	Projectile
	Radius 4
	Height 6
	Damage (random(1,3)*2) // 3 or 6
	Speed 15
	Scale 0.3
	RenderStyle Add
	SeeSound ""
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	Decal "Q4PlasmaMonster"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		ACID A 2 Light(OrangeMediumPoint3) Bright
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("HoverTankBlasterExplo1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 4 A_SpawnItemEx("HoverTankBlasterExplo2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}


