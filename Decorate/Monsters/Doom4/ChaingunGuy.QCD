Actor D4HellRazer : QCDE_MonsterSmall 15453
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	var int user_counter;
	Health 120
	Radius 20
	Height 56
	Mass 100
	Speed 8
	PainChance 70
	Monster
	+FLOORCLIP
	SeeSound 	"Doom4/Monsters/HellRazer/Sight"
	PainSound 	"Doom4/Monsters/Grunt/Pain"
	DeathSound 	"Doom4/Monsters/Grunt/Death"
	ActiveSound "Doom4/Monsters/HellRazer/Idle"
	Obituary "$OB_D4HellRazer" // "%o was disintegrated by a Hell Razer."
	DamageFactor "PlasmaExploder", 0.3
	+DOHARMSPECIES
	DropItem "Chaingun"
	Tag "$TAG_D4HellRazer" // "Hell Razer"
	States
	{
	Idle:
		HRZR A 0 A_StopSound(7) //in case the sound was still looping
		HRZR AB 10 A_Look
		Goto Idle+1
	See:
		HRZR AABBCCDD 3 A_Chase
		Loop

	Missile:
		Volley:
			TNT1 A 0 A_PlaySound("Doom4/Other/ZombieChargeAtt",CHAN_AUTO,1.0,false,1.25)
			TNT1 A 0 A_PlaySound("Doom4/Monsters/Grunt/Attack",CHAN_AUTO,1.0,false,1.15)
			HRZR E 5 A_SetUserVar(user_counter,0)
			HRZR EEEEEE 4 BRIGHT Light("RedMediumPoint2") A_FaceTarget
			HRZR E 0 A_PlaySound("Doom4/Monsters/RazerBeamOn",CHAN_AUTO,1.0,false,0.95)
			HRZR E 0 A_PlaySound("Doom4/Monsters/RazerBeamBigLoop",7,0.8,true,0.95)
			TNT1 A 0 A_JumpIfCloser(512,"MaybeLaser")

			VolleyLoop:
				HRZR E 4 Bright A_CustomMissile("HellRazerPlasmaBall",32,4)
				HRZR E 0 A_FaceTarget
				HRZR E 0 A_SetUserVar(user_counter,user_counter+1)
				HRZR E 0 A_JumpIf(user_counter>=16,"FinishLooper")
				Loop

			MaybeLaser:
				TNT1 A 0 A_Jump(64,"VolleyLoop") //even if close enough for laser, 25% it will still do volley*/
			DefinitelyLaser:
				HRZR E 4 Bright A_CustomRailgun(random(1,5),0,"None","Red",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT,1,1500,"FakePuff",0,0,768,3,28,0,"ElectricRailTrail",-2)
				HRZR E 0 A_FaceTarget
				HRZR E 0 A_SetUserVar(user_counter,user_counter+1)
				HRZR E 0 A_JumpIf(user_counter>=16,"FinishLooper")
				Loop

		FinishLooper:
			HRZR E 0 A_PlaySound("Doom4/Monsters/RazerBeamOff",7,1.0,false,0.95) //same as the looper
			HRZR E 5
			Goto See


	Pain:
		HRZR G 3 A_StopSound(7)
		HRZR G 3 A_Pain
		Goto See

	DeathChecksDone:
		HRZR I 0 A_Scream
		HRZR I 0 A_StopSound(7)
		HRZR I 5
		HRZR J 5
		HRZR K 5 A_NoBlocking
		HRZR L 5
	Death.Corpse:
		HRZR M -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		HRZR M 3
		HRZR LKJI 3
		Goto See

	//------------------------------------------------------------------------
	}
}


Actor HellRazerPlasmaBall : FastProjectile
{
	Projectile
	Radius 3
	Height 6
	Scale 0.4
	RenderStyle Add
	Alpha 0.99
	Damage (random(2,10))
	Speed 25
	FastSpeed 35
	SeeSound ""
	Translation "0:255=%[0,0,0]:[1.2,0,0]"
	DeathSound "Doom4/Weapon/PlasmaGun/PlasmaCrash"
	States
	{
	Spawn:
		X027 A 0 NODELAY A_Jump(220,2,3,4,5,6,7,8)
		X027 ABCDEFGHIJK 3 Bright Light("RedMediumPoint1")
		Goto Spawn+1
	Death:
		TNT1 A 0 A_SpawnItemEx("HellRazerPlasmaBallPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
		TNT1 A 3 Light("RedSmallPoint1")
		TNT1 A 3 Light("RedSmallPoint2")
		TNT1 A 3 Light("RedSmallPoint3")
		Stop
	}
}

Actor HellRazerPlasmaBallPuff
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+PUFFONACTORS
	Scale 0.18
	RenderStyle Add
	Alpha 0.99
	Translation "0:255=%[0,0,0]:[1.5,0.3,0.08]"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(128,2)
		TNT1 A 0 A_SetScale(-0.18,0.18)
		DB21 ABCDEFGHI 1 Bright
		Stop
	}
}


//----------------------------------------------------------
// Laser Attack
Actor ElectricRailTrail
{
	+NOINTERACTION
	Scale 0.22
	RenderStyle Add
	Alpha 1.0
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"S1","S2","S3","S4","S5","S6","S7","S8")
	S1:	HSPL A 0 A_Jump(255,"Perform")
		Goto Perform
	S2:	HSPL B 0 A_Jump(255,"Perform")
		Goto Perform
	S3:	HSPL C 0 A_Jump(255,"Perform")
		Goto Perform
	S4:	HSPL D 0 A_Jump(255,"Perform")
		Goto Perform
	S5:	HSPL E 0 A_Jump(255,"Perform")
		Goto Perform
	S6:	HSPL F 0 A_Jump(255,"Perform")
		Goto Perform
	S7:	HSPL G 0 A_Jump(255,"Perform")
		Goto Perform
	S8: HSPL H 0 A_Jump(255,"Perform")
		Goto Perform
	S8: HSPL J 0 A_Jump(255,"Perform")
		Goto Perform
		Perform:
			"####" "#" 5 Bright
			Stop
	}
}


Actor FakePuff
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		TNT1 A 10
		Stop
	}
}
