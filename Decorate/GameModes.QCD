Actor RLLootbox : RLNothing
{
	States
	{
	Death:
		TNT1 A 0 A_Jump(256, "LBBackpack", "LBChest")
		Stop

	LBBackpack:
		TNT1 A 0 Thing_SetSpecial(0, 84, 1827, 0, ACS_NamedExecuteWithResult("QCDE_GetLootboxCode"))
		TNT1 A 0 A_SpawnItemEx("LBBackpack",  0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL,0,tid)
		Stop
	LBChest:
		TNT1 A 0 Thing_SetSpecial(0, 84, 1827, 1, ACS_NamedExecuteWithResult("QCDE_GetLootboxCode"))
		TNT1 A 0 A_SpawnItemEx("LBChest",     0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERSPECIAL,0,tid)
		Stop

	}
}


Actor RLMultipleBackpacks
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 AAAAA 0 NoDelay A_SpawnItemEx("QCBackPack", random(-512,512),random(-512,512),-1024, 0,0,0,0, 0, 200)
		TNT1 A 100 A_CallSpecial(special, args[0], args[1], args[2], args[3], args[4])
		Stop
	}
}

Actor RLMuchAmmo
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 AA 0 NoDelay A_SpawnItemEx("Clip",  random(-32,32),random(-32,32),-1024, 0,0,0,0, 0, 240)
		TNT1 AA 0 A_SpawnItemEx("Shell",         random(-32,32),random(-32,32),-1024, 0,0,0,0, 0, 240)
		TNT1 AA 0 A_SpawnItemEx("RocketAmmo",    random(-32,32),random(-32,32),-1024, 0,0,0,0, 0, 240)
		TNT1 AA 0 A_SpawnItemEx("Cell",          random(-32,32),random(-32,32),-1024, 0,0,0,0, 0, 240)
		TNT1 A 100 A_CallSpecial(special, args[0], args[1], args[2], args[3], args[4])
		Stop
	}
}




//----------------------------------------------------------------------
// InstaGib
//----------------------------------------------------------------------

Actor EndlessInfiniteAmmo : PowerupGiver
{
	Inventory.PickupMessage ""
	Inventory.UseSound "Nothing"
	Inventory.MaxAmount 0 +INVENTORY.AUTOACTIVATE
	Powerup.Type "InfiniteAmmo"
	Powerup.Duration 0x7FFFFFFD
}


//----------------------------------------------------------------------
// FreezeTag
//----------------------------------------------------------------------

const int ThawDistance = 96;

Actor Freezetagged : Token {}

Actor PowerNoTelefrag : PowerProtection
{
	DamageFactor "Telefrag", 0.0001
	Powerup.Duration 0x7FFFFFFF
}

Actor PowerNoEehEehEehEehEeh : PowerInvulnerable { Powerup.Duration 0x7FFFFFFF }

Actor NoPickupProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("PICKUP", false)
		Stop
	}
}

Actor PickupProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("PICKUP", true)
		Stop
	}
}

Actor NoTeleportProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("NOTELEPORT", true)
		Stop
	}
}

Actor TeleportProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("NOTELEPORT", false)
		Stop
	}
}

Actor PowerFrozenBlue : PowerSpeed
{
	Inventory.Amount 1
	Speed 0.1
	Powerup.Duration 0x7FFFFFFF
	Powerup.Colormap 0,0,0, 0.8, 1.0,1.5
	+POWERSPEED.NOTRAIL
}

Actor BlueStBernard : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_RadiusGive("BlueAntiFreeze",ThawDistance,RGF_PLAYERS)
		Stop
	}
}

Actor BlueAntiFreeze : CustomInventory
{
	+INVENTORY.QUIET
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("TeamColor",1,1)
		Stop
		TNT1 A 0 A_JumpIfInventory("TeamColor",2,"Nope")
		TNT1 A 35 ACS_NamedExecuteAlways("QCDE_Freezetag_ThawProgress",0,1)
		Stop
	Nope:
		TNT1 A 35
		Stop
	}
}

Actor PowerFrozenRed : PowerFrozenBlue
{
	Powerup.Colormap 0,0,0, 1.5,1.0,0.8
}

Actor RedStBernard : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_RadiusGive("RedAntiFreeze",ThawDistance,RGF_PLAYERS)
		Stop
	}
}

Actor RedAntiFreeze : CustomInventory
{
	+INVENTORY.QUIET
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("TeamColor",2,"Yep")
		Stop
	Nope:
		TNT1 A 35
		Stop
	Yep:
		TNT1 A 35 ACS_NamedExecuteAlways("QCDE_Freezetag_ThawProgress",0,2)
		Stop
	}
}

Actor FreezetaggedFX : FX
{
	+BRIGHT
	RenderStyle Add
	Scale 1.1
	Translation "0:255=%[0,0,0]:[1,1,2]"
	VSpeed 1
	Alpha 0.6
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_PlaySound("QC/UI/FreezeTag_Frozen", CHAN_7, 0.75, false, 0.9)
		DB17 ABCDEF 1 A_SpawnItemEx("FreezeShotExplo", random(-24,24),random(-24,24),random(4,56))
		DB17 GHIJKLMNOPQRSTUVWXYZ 1
		Stop
	}
}

Actor ThawFX : FX
{
	+BRIGHT
	RenderStyle Add
	Scale 1.1
	Translation "0:255=%[0,0,0]:[2,2,2]"
	VSpeed 1
	Alpha 0.7
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_PlaySound("QC/UI/FreezeTag_ThawPartial", CHAN_7, 0.7, false, 0.9)
		DB17 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
		Stop
	}
}
