		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Fire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Fire.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Fire.Quake1")
	Fire.Default:
		QCEE A 0
		Goto FireCont
	Fire.Quake1:
		Q1EE A 0
		Goto FireCont
	Fire.Quake2:
		Q2EE A 0
		Goto FireCont
	Fire.Quake3:
