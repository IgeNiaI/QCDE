Actor LeashSpark
{
	Translation "0:255=%[0,0,0]:[0.75,0.75,2.0]"
	+NOINTERACTION
	Scale 0.15
	RenderStyle Add
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	Alpha 1.0
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"S1","S2","S3","S4","S5","S6","S7","S8")
	S1:	X079 A 0
	Goto Perform
	S2:	X079 B 0
	Goto Perform
	S3:	X079 C 0
	Goto Perform
	S4:	X079 D 0
	Goto Perform
	S5:	X079 E 0
	Goto Perform
	S6:	X079 F 0
	Goto Perform
	S7:	X079 G 0
	Goto Perform
	S8: X079 H 0
	Goto Perform
	Perform:
		"####" "#" 1 Bright A_SetScale(ScaleX+0.005)
		"####" "#" 0 A_FadeOut(0.05)
		Loop
	}
}



//-------------------------------------------------
//	Brown Dust Explosion
Actor ThumperDustSpawner
{
	+NOINTERACTION
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 AAAAAAA 0 A_SpawnItemEx("BrownSmokeBig",0,0,0,frandom(10,25),0,frandom(0,8),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 AAAAAA 0 A_SpawnItemEx("ThumperElectroDust",0,0,0,random(8,14),0,random(9,12),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop
	}
}

Actor BrownSmokeBig
{
	var int user_counter;
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	RenderStyle Translucent
	//Alpha 0.57
	Alpha 0.0
	Scale 0.4
	States
	{
	Spawn:
		TNT1 A 0
	Choose1of4:
		TNT1 A 0 A_Jump(256,"T1","T2")

	T1:	X201 C 0 A_Jump(256,"Behavior")
	T2:	X201 D 0 A_Jump(256,"Behavior")

	Behavior:
		"####" "#" 0 A_JumpIf(user_counter>=random(5,12),"SlowDown")
		"####" "#" 0 A_SetUserVar("user_counter",user_counter+1)
		"####" "#" 1 A_FadeTo(0.57,0.04,0)
		"####" "#" 0 A_ScaleVelocity(0.9)
		"####" "#" 0 A_SetScale(scalex+frandom(0.07,0.2))
		Loop
	SlowDown:
		"####" "#" 1 A_FadeOut(frandom(0.005,0.01))
		"####" "#" 0 A_ScaleVelocity(0.8)
		"####" "#" 0 A_SetScale(scalex+frandom(0.07,0.2))
		Loop

	}
}


