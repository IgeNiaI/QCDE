//====================================================================================
//====================================================================================
//
// Actual ammo definitions
// Normal, "Small" and "DM" versions
//
//====================================================================================
//====================================================================================


//======================================================================
//	Bullets ammo
//======================================================================
Actor QCBulletAmmo : Ammo
{
	//$NotAngled
	//$Category "QCDE Ammunition"
	//$Color 6
	//$Title "Bullet Ammo Big"
	Tag "$TAG_QCBulletAmmo" // "Bullet Ammo Big"
	+FLOORCLIP
	-TELESTOMP
	+SERVERNETID
	Radius 20
	Height 16
	Inventory.PickupMessage "$GOT_QCBulletAmmo" // "Picked up a pack of bullets."
	Inventory.PickupSound "QC/Items/AmmoPick"
	Inventory.Amount 50
	Inventory.MaxAmount 200
	Ammo.BackpackMaxAmount 300
	Ammo.BackpackAmount 20
	Scale 0.901
	States
	{
	Spawn:
		AMBU A 0  NODELAY A_SetAngle(random(0,359))
		Goto Common
	Common:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		"####" "#" 0 A_Jump(255,"Idle")
		Goto Idle
	DMSpawn:
		"####" "#" 0 ACS_NamedExecuteWithResult("QCDE_DespawnIfInstagib")
		"####" "#" 0 A_ChangeFlag("BRIGHT",1)
		"####" "#" 0 A_Jump(255,"Idle")
		Goto Idle
	Idle:
		"####" "#" -1 ACS_NamedExecuteWithResult("QCDE_PickupSpawned")
		Stop
	}
}

Actor QCBulletAmmoSmall : QCBulletAmmo
{
	//$NotAngled
	//$Category "QCDE Ammunition"
	//$Color 6
	//$Title "Bullet Ammo Small"
	Tag "$TAG_QCBulletAmmoSmall" // "Bullet Ammo Small"
	Inventory.Amount 10
	Inventory.PickupSound "QC/Items/AmmoPick"
	Inventory.PickupMessage "$GOT_QCBulletAmmoSmall" // "Picked up a few bullets."
	Scale 0.901
	States
	{
	Spawn:
		AMBU C 0  NODELAY A_SetAngle(random(0,359))
		Goto Common
	}
}

