// --------------------------------------------------------------------------
//
// Eradicator's abilities
//
// Active:  Radar
//          See objects on a temporary map.
//
// Passive: Murderface
//          Every X killed enemies increases damage by 10%.
//          Maximum possible damage is 1090%.
//
// --------------------------------------------------------------------------

//--------------------------------------------------------
// Active
//--------------------------------------------------------

// Implemented entirely in ACS.

//--------------------------------------------------------
// Passive
//--------------------------------------------------------

Actor MurderToken : Token { Inventory.MaxAmount 99999 Inventory.InterHubAmount 0 }
Actor MurderLevel : Token { Inventory.MaxAmount    99 Inventory.InterHubAmount 0 }
Actor TooFewMonst : Token {                           Inventory.InterHubAmount 0 }

