
//===========================================================================
//===========================================================================

Actor Q2IronMaiden : QCDE_MonsterMedium	15209	// hell knight
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 500
	Radius 20
	Height 56
	Scale 0.4
	Speed 12
	PainChance 150
	Mass 400
	MONSTER
	+FLOORCLIP
	+DONTMORPH
	MinMissileChance 256
	Tag "$TAG_Q2IronMaiden" // "Iron Maiden"
	SeeSound "q2bitch/sight"
	PainSound "q2bitch/pain"
	DeathSound "q2bitch/death"
	ActiveSound "q2bitch/search"
	MeleeSound "implord/macehit"
	Obituary "$OB_Q2IronMaiden" // "%o was exploded by an Iron Maiden."
	HitObituary "$OBH_Q2IronMaiden" // "%o shouldn't have come that close to an Iron Maiden."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		BITI AAAAAAAAAAAAAAAA 5 A_Look
		TNT1 A 0 A_Jump(230,2)
		TNT1 A 0 A_PlaySound("q2bitch/doingnothing",CHAN_BODY,1.0,false,3.0)
		BITI AAAAAAAAAAAAAAAAAAAAAAAAAAA 6 A_Look
		Loop
	See:
		BITW ABCDEF 4 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_PlaySound("q2bitch/attackscream")
		BITA ABCDDDDD 5 A_FaceTarget
		BITA D 5 A_CustomMissile("BitchRocket",29,-6,0)
		BITA E 5
		Goto See
	Pain:
		BITP A 2
		BITP A 5 A_Pain
		Goto See
	DeathChecksDone:
		BITD A 0 A_Scream
		BITD ABC 6
		BITD D 6 A_Fall
		BITD EFG 6
		BITD HIJKLMN 5
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		BITD O -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		BITD ONMLKJIHGFEDCBA 4
		Goto See
	}
}

Actor BitchRocket : OgreRocket
{
	Speed 18
	Damage (10)	//total damage with explo is 70
	SeeSound "q2weapon/rocketlauncherfire"
	DeathSound "q2weapon/rocketexplo"
}

