//================================================================================================================


Actor D4HellKnight : QCDE_MonsterMedium 15456
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	var int user_leapstrength;
	Health 540
	Radius 24
	Height 64
	Mass 1000
	Speed 14
	PainChance 84
	Monster
	+FLOORCLIP
	SeeSound 	"Doom4/Monsters/HellKnight/Sight"
	ActiveSound "Doom4/Monsters/HellKnight/Idle"
	PainSound 	"Doom4/Monsters/Baron/Pain"
	DeathSound 	"Doom4/Monsters/HellKnight/Death"
	HitObituary "$OB_KNIGHTHIT"
	Obituary "$OB_KNIGHT"
	Scale 1.05
	Gravity 0.83
	Damage 3
	Tag "$TAG_D4HellKnight" // "Hell Knight"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		VOS2 AB 10 A_Look
		Loop
	See:
		VOS2 AABBCCDD 3 A_Chase
		Loop

	SeeNoMissile:		//reached only when landing after a jump
		BOZ2 G 20 //waits a bit there, looking majestic
		VOS2 AABBCCDD 3 A_Chase("Melee","FireBall")	//then continues chasing, no jumping for a little while
		VOS2 AABBCCDD 3 A_Chase("Melee","FireBall")
		VOS2 AABBCCDD 3 A_Chase("Melee","FireBall")
		Goto See


	//--------------------------------------
	// Melee attack
	Melee:
		VOS2 E 6 A_FaceTarget
		VOS2 E 0 A_PlaySound("Doom4/Other/MeleeSwing",5,1.0,false,1.1)
		VOS2 E 6 A_FaceTarget
		VOS2 G 6 A_CustomMeleeAttack(random(10,30),"Doom4/Other/MeleeHit","",0,1)
		VOS2 F 2 A_Recoil(2)
		Goto See

	//--------------------------------------
	// Ranged attacks
	Missile:
		BOS4 M 0 A_JumpIfCloser(512,"DecideToCharge")
		BOS4 M 0 A_PlaySound("Doom4/Monsters/HellKnight/Melee",CHAN_AUTO,1.0,false,1.1)
		"####" "#" 0 A_Jump(170,"FireBall")
		Goto Leap

	DecideToCharge:
		BOS4 M 0 A_Jump(64,"ChargeAttack")
		Goto Missile+1

	FireBall:
		VOS2 E 6 A_FaceTarget
		VOS2 E 0 A_PlaySound("Doom4/Other/MeleeSwing",5,1.0,false,1.1)
		VOS2 E 6 A_FaceTarget
		VOS2 G 6
		VOS2 F 2 A_CustomMissile("D4KnightBall")
		Goto See

	//--------------------------------------
	// Leap attack
	Leap:
		TNT1 A 0 A_JumpIfCloser(256,"ChargeAttack") //if too close, charges towards target
		BOS3 XXXXX 4  A_FaceTarget
		TNT1 A 0 A_JumpIfCloser(320,"Prep320")
		TNT1 A 0 A_JumpIfCloser(384,"Prep384")
		TNT1 A 0 A_JumpIfCloser(448,"Prep448")
		TNT1 A 0 A_JumpIfCloser(512,"Prep512")
		TNT1 A 0 A_JumpIfCloser(576,"Prep576")
		TNT1 A 0 A_JumpIfCloser(640,"Prep640")
		TNT1 A 0 A_JumpIfCloser(704,"Prep704")
		TNT1 A 0 A_JumpIfCloser(768,"Prep768")
		Goto FireBall //if farther than 768, also just drops the whole thing

		Prep320:	TNT1 A 0 A_SetUserVar(user_leapstrength,28)	goto ContinueLeap
		Prep384:	TNT1 A 0 A_SetUserVar(user_leapstrength,30)	goto ContinueLeap
		Prep448:	TNT1 A 0 A_SetUserVar(user_leapstrength,33)	goto ContinueLeap
		Prep512:	TNT1 A 0 A_SetUserVar(user_leapstrength,35)	goto ContinueLeap
		Prep576:	TNT1 A 0 A_SetUserVar(user_leapstrength,37)	goto ContinueLeap
		Prep640:	TNT1 A 0 A_SetUserVar(user_leapstrength,39)	goto ContinueLeap
		Prep704:	TNT1 A 0 A_SetUserVar(user_leapstrength,41)	goto ContinueLeap
		Prep768:	TNT1 A 0 A_SetUserVar(user_leapstrength,43)	goto ContinueLeap

		ContinueLeap:
			BOZ3 ABC 5 A_FaceTarget
			BOZ2 F 0 A_Recoil(-(user_leapstrength/1.5))
			BOZ2 F 2 ThrustThingZ(0,user_leapstrength,0,0)

		LeapLoop:
			BOZ2 F 0 A_CheckFloor("LeapEnd")
			BOZ2 F 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			BOZ2 F 0 A_CheckFloor("LeapEnd")
			BOZ2 F 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			BOZ2 F 0 A_CheckFloor("LeapEnd")
			BOZ2 F 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			BOZ2 F 0 A_SpawnItemEx("KnightLeapTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			Loop

		DropFast:
			TNT1 A 0 A_ChangeVelocity(0,0,-12,CVF_REPLACE)
			TNT1 A 0 A_CheckFloor("LeapEnd")
			BOZ2 F 1 A_JumpIf(velx==0&&velZ==0,"LeapEnd")
			Goto DropFast+1

			LeapEnd:
				TNT1 A 0 A_PlaySound("Doom4/Monsters/BaronCrash",7,1.0,false,0.9)
				TNT1 A 0 A_Quake(4,20,0,512,"")
				TNT1 A 0 A_SpawnItemEx("KnightShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
				TNT1 A 0 A_JumpIfCloser(140,"DoDamage")
				Goto ResumeLeapEnd
			DoDamage:
				TNT1 A 0 A_BetaSkullAttack
				Goto ResumeLeapEnd
			ResumeLeapEnd:
				BOZ2 G 1 A_Stop
				BOZ2 G 2
				Goto SeeNoMissile

	//--------------------------------------
	// Dash and hit
	ChargeAttack:
	   TNT1 A 0 A_ChangeFlag(NOTARGETSWITCH, 1)
	   TNT1 A 0 A_PlaySound("Doom4/Monsters/HellKnight/Charge",5,1.0,false,0.9)
	   BOS3 YXZ 4 A_FaceTarget
	   TNT1 A 0 ThrustThingZ(0,1,0,1)
	   //charges at target
	   VOS2 A 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 0 A_JumpIfCloser(64,"ChargeAttackMelee")
	   VOS2 A 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 B 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 B 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 0 A_JumpIfCloser(64,"ChargeAttackMelee")
	   VOS2 B 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 C 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 0 A_JumpIfCloser(64,"ChargeAttackMelee")
	   VOS2 C 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 C 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 0 A_JumpIfCloser(64,"ChargeAttackMelee")
	   VOS2 D 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 D 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 A 0 A_JumpIfCloser(64,"ChargeAttackMelee")
	   VOS2 D 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
	   VOS2 D 1 A_Recoil(-4)	TNT1 A 0 A_CustomMissile("HKLunge3",18,0,0,CMF_AIMDIRECTION)
    ChargeAttackMelee:
	   TNT1 A 0 A_PlaySound("Doom4/Other/MeleeSwing",CHAN_AUTO,1.0,false,1.15)
	   TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	   TNT1 A 0 ThrustThingZ(0,20,0,1)
	   TNT1 A 0 A_Recoil(-1)
	   VOS2 F 2 A_FaceTarget
	   VOS2 F 3 A_CustomMissile("HKLunge2",18,0,0,CMF_AIMDIRECTION)
	   VOS2 G 6
	   VOS2 G 2 A_ScaleVelocity(0.2)
	   TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	   TNT1 A 0 A_ChangeFlag(NOTARGETSWITCH, 0)
	   VOS2 G 1 A_ScaleVelocity(0)
	   Goto See

	Pain:
		VOS2 H 2
		VOS2 H 2 A_Pain
		Goto See

	DeathChecksDone:
		E02D A 0 A_Scream
		E02D A 3
		E02D B 3
		E02D C 3
		E02D D 3 A_NoBlocking
		E02D EFGH 3
	Death.Corpse:
		E02D I -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		E02D I 3
		E02D HGFEDCBA  3
		Goto See



	//------------------------------------------------------------------------
	}
}


//*********************************************
Actor D4KnightBall
{
	Radius 6
	Height 8
	Speed 20
	FastSpeed 25
	Damage 9
	Projectile
	+RANDOMIZE
	+FORCEXYBILLBOARD
	Alpha 1
	RenderStyle Add
	SeeSound "Doom4/Monsters/Generic/ThrowFireballLow"
	DeathSound "Doom4/Other/FireballHit2"
	scale 0.75
	Translation "0:255=%[0,0,0]:[1.8,0.6,0]"
	Decal "KnightFireballScorch"
	States
	{
	Spawn:
		HIB1 AB 2 BRIGHT Light("DarkOrangeMediumFlicker2")
		Loop
	Death:
		HIB1 CC 1 BRIGHT Light("DarkOrangeFlicker1")	//had to separate
		HIB1 DD 1 BRIGHT Light("DarkOrangeFlicker2")
		HIB1 EE 1 BRIGHT Light("DarkOrangeFlicker3")
		HIB1 FF 1 BRIGHT Light("DarkOrangeSmallFlicker1")
		HIB1 GG 1 BRIGHT Light("DarkOrangeSmallFlicker1")
		Stop
	}
}
//***********************************
Actor KnightShockwave : BaronShockwave
{
	Translation "0:255=%[0,0,0]:[1.8,0.6,0]"
}

//*************************************
Actor KnightLeapTrail
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	Renderstyle Translucent
	Alpha 0.5
	States
	{
	Spawn:
		BOZ2 F 2 A_FadeOut(0.05)
		Wait
	}
}


Actor HKLunge
{
	Height 16
	Radius 16
	Speed 27
	Damage (5*Random(4,8))
	Species "Fiends"
	SeeSound ""
	DeathSound "Doom4/Other/MeleeHit"
	PROJECTILE
	States
	{
	Spawn:
		TNT1 A 4
		Stop
    }
}

Actor HKLunge2 : HKLunge
{
	Damage (3*Random(4,6))
}

Actor HKLunge3 : HKLunge
{
	Damage (1*Random(0,1))
}
