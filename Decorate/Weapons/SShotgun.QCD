			QuadSound.Modded:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Modded",CHAN_WEAPON)
				Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		TNT1 A 0 A_SetBlend("Orange",0.12,15)
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,2)
		TNT1 A 0 A_SetPitch(pitch-5)
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "FlashEnder.Modded")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "FlashEnder.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "FlashEnder.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "FlashEnder.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "FlashEnder.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "FlashEnder.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "FlashEnder.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "FlashEnder.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "FlashEnder.Quake1")
	FlashEnder.Default:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,5,1)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,6,1)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,7,2)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,7,3)
		Goto FlashEnderCont
	FlashEnder.Quake1:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,3,1)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,1)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,5,2)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,5,3)
		Goto FlashEnderCont
	FlashEnder.Quake2:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,3,3)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,3)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,5,4)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,5,5)
		Goto FlashEnderCont
	FlashEnder.Quake3:
