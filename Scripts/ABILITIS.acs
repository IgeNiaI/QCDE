//		Keel's Passive

Script "QCDE_Passive_Keel" (void)
{
	int amm0, amm1;

	// Remember initial state (not to get cooldown bonus on respawn)
	amm0 =  CheckInventory("QCBulletAmmo") +
			CheckInventory("QCShellAmmo" ) +
			CheckInventory("QCNailAmmo"  ) +
			CheckInventory("QCBoltAmmo"  ) +
			CheckInventory("QCRocketAmmo") +
			CheckInventory("QCCoilAmmo"  ) +
			CheckInventory("QCSlugAmmo"  ) +
			CheckInventory("QCBFGAmmo"   );


	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		// Reduce cooldown with ammo
		amm1 =
				CheckInventory("QCBulletAmmo") +
				CheckInventory("QCShellAmmo" ) +
				CheckInventory("QCNailAmmo"  ) +
				CheckInventory("QCBoltAmmo"  ) +
				CheckInventory("QCRocketAmmo") +
				CheckInventory("QCCoilAmmo"  ) +
				CheckInventory("QCSlugAmmo"  ) +
				CheckInventory("QCBFGAmmo"   );

		if(amm1 > amm0  &&  tics[PlayerNumber()])
		{
			if(GameType() >= GAME_NET_DEATHMATCH)
				ACS("QCDE_Hourglass", 5);
			else
				ACS("QCDE_Hourglass", 5);
		}

		amm0 = amm1;

		delay(1);
	}
}

