                                             drawImage "PWUPSC01",  182,780;
			}}}}}}}}}}}}}}}}}}}} // 20 braces
			else {                           drawImage "PWUPSC00",  182,780; }
		}

		// Protec
		inInventory PowerProtec {
			drawImage "PWUPFRAM", 242,780;
			drawImage "PWUPFIR1", 242,780;
			drawImage "PWUPPROT", 242,780;
			inInventory ProtecTimer, 1 {
			inInventory ProtecTimer,20 { drawImage "PWUPSC20",  242,780; } else {
