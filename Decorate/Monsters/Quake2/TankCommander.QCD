
//===========================================================================
//===========================================================================

// Not bigger, but meaner version of the tank

//===========================================================================
//===========================================================================
Actor Q2TankCommander : QCDE_MonsterBig	15221	// archvile
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 1200
	Radius 20
	Height 64	//2017 DBT note: size mismatch, let's hope it doesnt get stuck often
	Scale 0.52
	Speed 10
	PainChance 18
	Mass 9000
	MONSTER
	+FLOORCLIP
	+MISSILEMORE
	+MISSILEEVENMORE
	+NOBLOOD
	SeeSound "q2tank/sight"
	PainSound "q2tank/pain"
	DeathSound "q2tank/death"
	ActiveSound "q2tank/idle"
	Tag "$TAG_Q2TankCommander" // "Tank Commander"
	Obituary "$OB_Q2TankCommander" // "%o was put in %p place by a tank commander."
	Translation "0:255=%[0.0,0.0,0.0]:[1.66,1.66,1.66]", "176:191=176:191", "208:223=208:223", "32:47=32:47"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		TK1I A 5 A_Look
		Loop

	See:
		TNT1 A 0 A_PlaySound("q2tank/step")
		TK1W A 7
		TK1W BCD 6 A_Chase
		TNT1 A 0 A_PlaySound("q2tank/step")
		TK1W E 7
		TK1W FGH 6 A_Chase
		Loop


	Missile:
		TNT1 A 0 A_Jump(255,"Machinegun","Rocket","Blaster")

		Blaster:
			TK1B ABCD 6 A_FaceTarget
		BlasterLoop:
			TNT1 A 0 A_PlaySound("q2hover/blasterattack", 6, 1.0, 0)
			TK1B E 4 Bright A_CustomMissile("TankCommanderBlaster", 40, -15, 0, 1)
			TK1B D 5 A_FaceTarget
			TNT1 A 0 A_CPosRefire
			Goto BlasterLoop
		Machinegun:
			TK1C ABCDE 4 A_FaceTarget
		MachinegunLoop:
			TNT1 A 0 A_PlaySound("Quake1/Weapons/SuperNailgunFire",6,0.5)
			TNT1 A 0 A_PlaySound("q2weapon/machinegun",5,1)
			TNT1 A 0 A_CustomMissile("MonsterTracerMidVol",46,23,frandom(5,-5))
			TNT1 A 0 A_SpawnItemEx("MonMuzzleFlash",20,20,45,0,0,0,0,32)
			TK1C F 5 Bright A_CustomBulletAttack(12,1,1,5)
			TNT1 A 0 A_CPosRefire
			Goto MachinegunLoop
		Rocket:
			TK1R A 0 A_ChangeFlag("NOPAIN",1)	//cant be interrupted
			TK1R ABCDE 6 A_FaceTarget
			TK1R F 0 A_PlaySound("q2tank/mechsound1")
			TK1R FGHIJK 6 A_FaceTarget
			TK1R L 8 A_FaceTarget	TK1R M 6 Bright A_CustomMissile("TankCommanderRocket", 70, 25, 0)
			TK1R N 6 A_FaceTarget	TK1R O 6 Bright A_CustomMissile("TankCommanderRocket", 70, 20, 0)
			TK1R P 6 A_FaceTarget	TK1R Q 6 Bright A_CustomMissile("TankCommanderRocket", 70, 15, 0)
			TK1R A 0 A_ChangeFlag("NOPAIN",0)
			TK1R RSTUVWX 7
			Goto See

	Pain:
		TK1P A 3
		TK1P A 7 A_Pain
		TK1P B 8
		Goto See

	DeathChecksDone:
		TK1D A 0 A_Scream
		TNT1 AAA 0 A_TossGib
		TK1D ABCDEFGHIJKLMNOPQR 6
		TK1D S 6 A_PlaySound("quake4/Misc/Body/Metal")
		TNT1 AA 0 A_TossGib
		TNT1 A 0 A_Fall
	Death.Corpse:
		TK1D T -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 AAAAAAA 0 A_TossGib
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		TK1D TSRQPO 6
		Goto See
	}
}

Actor TankCommanderBlaster : MedicBlasterStrong
{
	Speed 20
	Damage 6
}

Actor TankCommanderRocket : OgreRocket
{
	Speed 20
	Damage (60)	//total damage with explo is 120
	SeeSound "q2weapon/rocketlauncherfire"
	DeathSound "q2weapon/rocketexplo"
}



