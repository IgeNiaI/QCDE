function int IsPVE(void) { return GameType() <  GAME_NET_DEATHMATCH && !InCampaign(); }
function int IsPVP(void) { return GameType() >= GAME_NET_DEATHMATCH || InCampaign(); }

function int clamp(int x, int min, int max)
{
	if(x < min) x = min;
	if(x > max) x = max;
	return x;
}



