
Actor CompatVer30_Ammo {} // for compatibility checks

//=======================================================================
//=======================================================================
// Special ammo spawners
//=======================================================================
//=======================================================================

//Base class for ammo spawners. I had to spawn them via an "ammo" inventory
//because otherwise it wouldnt respawn in deathmatch
Actor FakeAmmo : Ammo
{
	-TELESTOMP
	+SERVERNETID
	Radius 1
	Height 1
	Inventory.Amount 1
	Inventory.MaxAmount 1
	Ammo.BackpackAmount 1
	Ammo.BackpackMaxAmount 1
	+INVENTORY.ALWAYSPICKUP
	+INVENTORY.QUIET
	RenderStyle None
	Inventory.RespawnTics 1400 // 40sec
	States
	{
	Spawn:
		TNT1 A -1
		Stop
	}
}


//---------------------------------------
//	Bullets replacers
//---------------------------------------
Actor ClipReplacer : FakeAmmo replaces Clip
{
	//$NotAngled
	//$Category "QCDE Ammunition"
	//$Color 6
	//$Title "Bullets, likely nails"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)==2,"DMSpawn")
		Goto SPSpawn
	DMSpawn:
		TNT1 A 0 A_SpawnItemEx("QCBulletAmmoDM",random(16,-16),random(16,-16),0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A -1
		Stop
	SPSpawn:
		TNT1 A 0 A_SpawnItemEx("QCSmallArmorGiver",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,252)
		TNT1 A 0 A_SpawnItemEx("QCBulletAmmoSmall",random(16,-16),random(16,-16),0,0,0,0,0,SXF_NOCHECKPOSITION,32)
		TNT1 A 0 A_SpawnItemEx("QCNailAmmoSmall",random(16,-16),random(16,-16),0,0,0,0,0,SXF_NOCHECKPOSITION,40)
		TNT1 A -1
		Stop
	}
}
