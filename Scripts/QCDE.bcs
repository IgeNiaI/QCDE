function void CheckQcdeLib(void)
{
	PrintBold(d:Timer(), s:": CheckQcdeLib -- PrintBold");
	log(d:Timer(), s:": CheckQcdeLib -- log");
}

function int TimeNow(void)
{
	int tics    =  Timer()       % 35;
	int seconds = (Timer() / 35) % 60;
	int minutes = (Timer() / 35  / 60);
	return strparam(d:minutes, s:":", d:seconds/10, d:seconds%10, s:".", d:tics);
}

function int QCDE_ProximityCheck(int victimTID, int killerTID) {

	int xDiff = GetActorX(victimTID) - GetActorX(killerTID);
	int yDiff = GetActorY(victimTID) - GetActorY(killerTID);
	int zDiff = GetActorZ(victimTID) - GetActorZ(killerTID);

	int len = VectorLength(xDiff, yDiff);
		len = VectorLength(zDiff, len);

	return len >> 16;
}



///////////////////////////////////////////////////////////////////////////////
// Replace actor //////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

int _spec, _args0, _args1, _args2, _args3, _args4;
Function int QCDE_SpawnReplacement(int class, int dead, int noCheckPosition, int removeSelf)
{
	// Spawn replacement
	int x = GetActorX(0);
	int y = GetActorY(0);
	int z = GetActorZ(0);
	int angle = GetActorAngle(0) << 8; // just for logs
	int tid = UniqueTid();

	bool success;
	if(noCheckPosition)
		success = SpawnForced(class, x,y,z, tid, angle >> 16);
	else
		success = Spawn(class, x,y,z, tid, angle >> 16);

	if(!success) return false;

	// Transfer health (by percentage)
	TransferHealthTo(tid);

	// Transfer flags, store as spawner's tracer and finally transfer tid
	if(CheckFlag(0,"FRIENDLY")) GiveActorInventory(tid, "FriendlyProc", 1);
	if(CheckFlag(0,"AMBUSH"  )) GiveActorInventory(tid,   "AmbushProc", 1);
	if(CheckFlag(0,"DORMANT" )) GiveActorInventory(tid,  "DormantProc", 1);
	if(dead) GiveActorInventory(tid, "BecomeCorpseProc", 1);
	SetPointer(AAPTR_TRACER, tid);
	GiveInventory("TransferSpecialProc", 1); // <-- given to spawner, not spawnee!
	SetThingSpecial(tid, _spec, _args0, _args1, _args2, _args3, _args4);
	Thing_ChangeTid(tid, ActivatorTid());
	Thing_ChangeTid(0, 0); // release tid from spawner itself
	//printbold(s:"\c-Spawned ", s:sDead, s:"\c[brite]", s:class, s:"\c- at (", f:x, s:", ", f:y, s:", ", f:z, s:"; angle ", f:angle, s:").");

	if(removeSelf) Thing_Remove(0);

	return true;
}

// Special care for huge-ass health pools
Function void TransferHealthTo(int tid)
{
	// Special case for spawner actors.
	// All map-placed monsters are considered to be in 100% condition,
	// no need to assign the fractional health.
	int oldmax = GetActorProperty(0, APROP_SpawnHealth);
	if(oldmax == 0x7CDE9A64) return;

	int subdiv = 1.0;
	int newmax = GetActorProperty(tid, APROP_SpawnHealth);
	while((oldmax > fixeddiv(0.5,subdiv) ||
	       newmax > fixeddiv(0.5,subdiv)) &&
		   subdiv > 100)
			subdiv /= 2;

	int healthiness = GetActorProperty(0, APROP_Health) * subdiv / oldmax;
	//log(d:tid, s:"    Healthiness: ", d:GetActorProperty(0, APROP_Health), s:"  *  ", d:subdiv, s:" / ", d:oldmax, s:"  =  ", d:healthiness, s:" / ", d:subdiv);
	SetActorProperty(tid, APROP_Health, newmax * healthiness / subdiv);

	//log(d:tid, s:"  Health transfer: ", d:newmax, s:"  *  ", d:healthiness, s:" / ", d:subdiv, s:"  =  ", d:GetActorProperty(tid, APROP_Health));
}
Script "QCDE_StoreSpecial1" (int spec, int args0, int args1)
{
	_spec = spec;
	_args0 = args0;
	_args1 = args1;
}
Script "QCDE_StoreSpecial2" (int args2, int args3, int args4)
{
	_args2 = args2;
	_args3 = args3;
	_args4 = args4;
}
Script "selfreplace" (void)
{
	QCDE_SpawnReplacement(GetActorClass(0), false, true, true);
}



///////////////////////////////////////////////////////////////////////////////
// Game modes /////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

int _teamplay       = -1;
int _teamlms        = -1;
int _teampossession = -1;
int _ctf            = -1;
int _domination     = -1;
int _goddammitcarn  = -1;
int _teamgame       = -1;

function int isTeamGame(void)
{
	if(_teamgame == -1)
	{
		_teamplay       = getCvar("teamplay");
		_teamlms        = getCvar("teamlms");
		_teampossession = getCvar("teampossession");
		_ctf            = getCvar("ctf");
		_domination     = getCvar("domination");
		_goddammitcarn  = getCvar("skulltag");
		_teamgame       = getCvar("teamgame");
	}
	return _teamgame || _teamplay || _teamlms || _teampossession || _ctf || _domination || _goddammitcarn;
}

function int hasFlags(void)
{
	int Rf = CheckInventory("RedFlag")   << 0;
	int Wf = CheckInventory("WhiteFlag") << 3;
	int Bf = CheckInventory("BlueFlag")  << 1;
	int Yf = CheckInventory("GoldFlag")  << 4;
	int Gf = CheckInventory("GreenFlag") << 2;
	int flagItems = rf | bf | gf | wf | yf;
	return flagItems;
}

// todo after 2.2: use areEnemies here
function int isEnemy(int otherPlayerNumber)
{
	if (PlayerNumber() == otherPlayerNumber) return false;

	if (GameType() <= GAME_NET_COOPERATIVE && PlayerNumber() > -1) return false;

	if (isTeamGame())
		if (GetPlayerInfo(otherPlayerNumber,PLAYERINFO_TEAM) ==
			GetPlayerInfo(PlayerNumber(),   PLAYERINFO_TEAM))
			return false;

	if (ClassifyActor(0) & ACTOR_MONSTER)
	{
		if (CheckFlag(0, "FRIENDLY")) return false;

		if (GetActorProperty(0, APROP_MasterTID) == (otherPlayerNumber + 1000)) return false;
	}

	return true;
}

function int areEnemies(int plr, int otherPlayerNumber)
{
	if (plr == otherPlayerNumber) return false;

	if (GameType() <= GAME_NET_COOPERATIVE) return false;

	if (!isTeamGame()) return true;

	return GetPlayerInfo(plr, PLAYERINFO_TEAM) !=
		   GetPlayerInfo(otherPlayerNumber,PLAYERINFO_TEAM);
}

int skirmish = 0x1827;
function int isSkirmish(void)
{
	// cache cvar
	if(skirmish == 0x1827)
		skirmish = GetCvar("qc_skirmishRogue") &&
		           GameType() < GAME_NET_DEATHMATCH;

	return skirmish;
}



///////////////////////////////////////////////////////////////////////////////
// Give or take ///////////////////////////////////////////////////////////////
//////////////////////////////////////////////// by Korshun // from ACSUtils //

function void SetInventory(str item, int amount)
{
	int diff = amount - CheckInventory(item);
	if (diff > 0)
		GiveInventory(item, diff);
	else if (diff < 0)
		TakeInventory(item, -diff);
}


function void SetActorInventory(int tid, str item, int amount)
{
	int diff = amount - CheckActorInventory(tid, item);
	if (diff > 0)
		GiveActorInventory(tid, item, diff);
	else if (diff < 0)
		TakeActorInventory(tid, item, -diff);
}




///////////////////////////////////////////////////////////////////////////////
// Give and check /////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

function int GiveAndCheck(str inventory, int howmuch)
{
	int countBefore = CheckInventory(inventory);
	GiveInventory(inventory, howmuch);
	int countAfter = CheckInventory(inventory);
	return countAfter - countBefore;
}




