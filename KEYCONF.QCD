alias qcde_ffa  "qcde_dm"
alias qcde_fn   "qcde_lms"
alias qcde_br   "qcde_lms"
alias qcde_ca   "qcde_tlms"

alias qcde_common_sense "sv_spawnfarthest true;sv_weaponstay false;sv_weapondrop true;sv_itemrespawn true;sv_nocrouch false;sv_allowjump true;sv_allowcrouch true;sv_awarddamageinsteadkills true;sv_forcerespawn true;sv_forcerespawntime 10;sv_unblockallies true;sv_sharekeys true;compat_instantrespawn false"

alias qcde_dm   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckFree For All set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_duel "qcde_common_sense; deathmatch 1; duel 1; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckDuel set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_lms  "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 1; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckLast Man Standing set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_tdm  "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 1; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckTeam Deathmatch set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_tlms "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 1; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckTeam Last Man Standing (Clan Arena) set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_dom  "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 1; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckDomination set up. Use `\\cvmap <...>\\ck` with Domination-enabled mapset to apply."
alias qcde_st   "qcde_common_sense; deathmatch 0; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 1; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckSkulltag set up. Use `\\cvmap <...>\\ck` with Skulltag-enabled mapset to apply."
alias qcde_ctf  "qcde_common_sense; deathmatch 0; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 1; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckCapture the Flag set up. Use `\\cvmap <...>\\ck` with CTF-enabled mapset to apply."
alias qcde_ig   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 1; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Instagib set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_ra   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 1; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Rocket Arena set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_bs   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 2; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Buckshot set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_ut   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 3; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Unholy Trinity set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_rws  "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 4; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Random Weapon Set set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_rw   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 5; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Random Weapons set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_ls   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 6; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; sv_weapondrop false; echo \\ckFree For All Lightning Storm set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_es   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 1; qc_freezetag  0; echo \\ckElder's Soul set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_tes  "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 1; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 1; qc_freezetag  0; echo \\ckTeam Elder's Soul set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_ft   "qcde_common_sense; deathmatch 1; duel 0; lastmanstanding 0; teamplay 0; teamlms 1; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  1; sv_disallowspying 0; echo \\ckFreeze Tag set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_coop "qcde_common_sense; deathmatch 0; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 1; survival 0; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckCooperative set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_surv "qcde_common_sense; deathmatch 0; duel 0; lastmanstanding 0; teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 1; survival 1; invasion 0; qc_elderssoul 0; qc_freezetag  0; echo \\ckCooperative Survival set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_inv      "qcde_common_sense;deathmatch 0;duel 0;lastmanstanding 0;teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 1; qc_elderssoul 0; qc_freezetag  0; wavelimit 8; echo \\ckInvasion set up. Use `\\cvmap <...>\\ck` to apply."
alias qcde_inv_surv "qcde_common_sense;deathmatch 0;duel 0;lastmanstanding 0;teamplay 0; teamlms 0; domination 0; skulltag 0; ctf 0; instagib 0; rocketarena 0; buckshot 0; cooperative 0; survival 0; invasion 1; qc_elderssoul 0; qc_freezetag  0; wavelimit 8; sv_maxlives 3; echo \\ckSurvival Invasion set up. Use `\\cvmap <...>\\ck` to apply."

