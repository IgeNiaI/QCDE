// --------------------------------------------------------------------------
//
// BFG10K
// Weapon and Pickup sprite by FrancoTieppo
// Weapon code by DBT
//
// --------------------------------------------------------------------------

Actor CompatVer31_BFG {} // for compatibility checks

Actor BFGPickup : CustomInventory 15608
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "BFG 10k"
	Height 48
	Radius 20
	Scale 0.65
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCBFG" // "Picked up the BFG10k."
	Tag "$TAG_QCBFG" // "BFG 10k"
	Inventory.RespawnTics 2100	//60sec

	States
	{
	Spawn:
		QCG8 A 1
		QCG8 Y 0 ACS_NamedExecuteWithResult("QCDE_RemoveIfNoBfg")
		QCG8 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		QCG8 Z 0 A_ChangeFlag("DROPPED", false)
		QCG8 Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",22,args[4])
		QCG8 Z 70 Bright A_SetArg(4, 0)
		QCG8 Z 0 A_ChangeFlag("NOGRAVITY", false)
		QCG8 Z -1 Bright
		Stop
	Idle:
		QCG8 Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",21,args[4])
		QCG8 Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		QCG8 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		QCG8 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		QCG8 A 0 A_GiveInventory("QCBFG")
		QCG8 A 0
		Stop
	DMWeaponStay: // BFG doesn't stay even if it wants to in DM
	DMPickup:
		QCG8 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		QCG8 A 0 A_GiveInventory("QCBFGDM")
		QCG8 A 0
		QCG8 A 0 A_TakeInventory("QCBFG")
		QCG8 A 0
		Stop
	WeaponStay:
		QCG8 A 0 A_JumpIfInventory("QCBFG",1,"Stay")
		QCG8 A 0 A_SpawnItemEx("QCBFG", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		QCG8 A 0
		Fail
	}
}

Actor BFGPickupNoGravity : BFGPickup 15618
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "BFG 10k (No Gravity)"
	+NOGRAVITY
}

Actor QCBFG : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.6
	Weapon.SelectionOrder 6666 // lowest
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "QCBFGAmmo"
	Obituary "$OB_QCBFG"
	+WEAPON.WIMPY_WEAPON
	Inventory.PickupMessage "$GOT_QCBFG"
	Tag "$TAG_QCBFG" // "BFG 10k"
	Scale 0.65
	States
	{
	Spawn:
		QCG8 Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		QCG8 Z 0 ACS_NamedExecuteAlways("QCDE_RemoveIfNoBfg")
		QCG8 ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		QCG8 Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 2, "Select.Quake2")
	Select.Default:
		QCF8 A 0
		Goto SelectCont
	Select.Quake2:
		Q2G8 A 0
		Goto SelectCont
	Select.Quake3:
		Q3G8 A 0
		Goto SelectCont
	Select.Quake4:
		Q4G8 A 0
		Goto SelectCont
	Select.QCDE1:
		Q0G8 A 0
		Goto SelectCont
	Select.HalfLife:
		HLG8 A 0
		Goto SelectCont
	Select.SeriousSam:
		SSG8 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_PlaySound("QC/Weapons/BFG/Raise_Default",	CHAN_5,0.75,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
	SelectLooper:
		"####" A 1 A_Raise
		"####" A 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" A 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 1, "Ready.Prepared") // jump over prepare animations
	ReadyPrepare.Default:
		QCF8 ABCDEF 3 A_WeaponReady(WRF_NOSECONDARY)
		Goto Ready.Default

	Ready.Prepared:
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 8, "Ready.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 7, "Ready.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 6, "Ready.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 4, "Ready.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 3, "Ready.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 2, "Ready.Quake2")
	Ready.Default:
		QCG8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.Quake2:
		Q2G8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.Quake3:
		Q3G8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.Quake4:
		Q4G8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Quake4",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.QCDE1:
		Q0G8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.HalfLife:
		HLG8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont
	Ready.SeriousSam:
		SSG8 A 0 A_PlaySound("QC/Weapons/BFG/Idle_Default",	CHAN_WEAPON,0.7,1)
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" ABCD 3 A_WeaponReady(WRF_NOSECONDARY)
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" EFGH 3 A_WeaponReady(WRF_NOSECONDARY)
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, 2) // Serious sam skin has less frames
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, 2) // Jump over skin specific jumps
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "ReadyCont") // Q3 skin has less frames
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" IJKL 3 A_WeaponReady(WRF_NOSECONDARY)
		Loop

	PostFireReady:
		"####" FGHIJK 3 A_WeaponReady(WRF_NOSECONDARY)
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" LM 3 A_WeaponReady(WRF_NOSECONDARY)
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, 2) // Jump over skin specific jumps
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "Ready.Prepared") // QCDE 1.0 skin has less frames
		"####" NOPQ 3 A_WeaponReady(WRF_NOSECONDARY)
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		Goto Ready.Prepared

		ReadyCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
			"####" A 0 A_TakeInventory("BFG_Charges",32767)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready.Prepared

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"CheckIfUpgrade")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 4, "Fire.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 3, "Fire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 2, "Fire.Quake2")
	Fire.Default:
		QCH8 A 0
		Goto FireCont
	Fire.Quake2:
		Q2H8 A 0
		Goto FireCont
	Fire.Quake3:
		Q3H8 A 0
		Goto FireCont
	Fire.Quake4:
		Q4H8 A 0
		Goto FireCont
	Fire.QCDE1:
		Q0H8 A 0
		Goto FireCont
	Fire.HalfLife:
		HLH8 A 0
		Goto FireCont
	Fire.SeriousSam:
		SSH8 A 0
		Goto FireCont

		CheckIfUpgrade:
			"####" A 0 A_JumpIfInventory("BFG_UG_Charge",1,"StartCharge")
			"####" A 0 offset(0,32) A_Refire("FireCont")
			Goto FireCont

	//-----------
	//Regular fire
	FireCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_StopSound(CHAN_5) //stops raise sound
		"####" B 1 Bright offset(6,47) A_GunFlash("PrimaryFlash")
		"####" BC 1 Bright
		"####" D 1 offset(7,48)
		"####" D 1 offset(6,46)
		"####" E 1 offset(5,44)
		"####" E 1 offset(4,42)
		"####" A 1 offset(3,40) A_Refire("FireCont")
		"####" A 1 offset(2,38) A_Refire("FireCont")
		"####" A 1 offset(1,36) A_Refire("FireCont")
		"####" A 1 offset(0,32) A_Refire("FireCont")
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"CheckIfUpgrade")
		Goto PostFireReady


	PrimaryFlash: //Attacks doer
		"####" A 0 A_JumpIfInventory("DMToken",1,"DM_Flash")
		Goto SP_Flash

		SP_Flash:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "SP_Flash.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGShot",0, true,1,5)
			Goto FlashCheckSound
		SP_Flash.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGShot_Quake4",0, true,1,5)
			Goto FlashCheckSound

		DM_Flash:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "DM_Flash.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGShot_DM",0, true,1,5)
			Goto FlashCheckSound
		DM_Flash.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGShot_DM_Quake4",0, true,1,5)
			Goto FlashCheckSound

		FlashCheckSound:
			"####" A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
			"####" A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
			Goto NormalSound

			NormalSound:
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "NormalSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "NormalSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "NormalSound.Default")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "NormalSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "NormalSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "NormalSound.Quake2")
			NormalSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Default",	CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake2",	CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake3",	CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake4",	CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_HalfLife",	CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_SeriousSam",CHAN_WEAPON)
				Goto FlashEnder

			QuadSound:
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "QuadSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "QuadSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "QuadSound.Default")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "QuadSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "QuadSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "QuadSound.Quake2")
			QuadSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Default",	CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake2",	CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake3",	CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake4",	CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_HalfLife",	CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_SeriousSam",CHAN_WEAPON)
				Goto FlashEnder

	FlashEnder:
		"####" A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		"####" A 0 A_SetBlend("Green",0.14,20)
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FlashEnderZoomed")
		"####" A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		"####" A 0 A_SetPitch(pitch-2.5)
		"####" A 2
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		Stop

			FlashEnderNoRecoil:
				"####" A 1
				Stop

	FlashEnderZoomed:
		"####" A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		"####" A 0 A_SetPitch(pitch-1.25)
		"####" A 2
		"####" A 1 A_SetPitch(pitch+0.25)
		"####" A 1 A_SetPitch(pitch+0.25)
		"####" A 1 A_SetPitch(pitch+0.25)
		"####" A 1 A_SetPitch(pitch+0.25)
		"####" A 1 A_SetPitch(pitch+0.25)
		Stop


	//-----------
	//Charge fire
	StartCharge:
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 8, "StartCharge.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 7, "StartCharge.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 6, "StartCharge.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 4, "StartCharge.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 3, "StartCharge.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 2, "StartCharge.Quake2")
	StartCharge.Default:
		QCG8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.Quake2:
		Q2G8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.Quake3:
		Q3G8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.Quake4:
		Q4G8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Quake4",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.QCDE1:
		Q0G8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.HalfLife:
		HLG8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1
	StartCharge.SeriousSam:
		SSG8 A 0 A_PlaySound("QC/Weapons/BFG/Charge_Default",	CHAN_WEAPON,1)
		Goto Part1

	Part1:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" M 1 Bright Offset(1,34)
		"####" N 1 Bright Offset(2,33)
		"####" O 1 Bright Offset(1,33)
		"####" P 1 Bright Offset(1,34)
		"####" A 0 A_GiveInventory("BFG_Charges",1)
		"####" A 0 A_JumpIfInventory("BFG_Charges",30,"MaxCharge")
		"####" A 0 A_Refire("Part2")
		Goto Release
	Part2:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" Q 1 Bright Offset(2,33)
		"####" R 1 Bright Offset(1,33)
		"####" S 1 Bright Offset(1,34)
		"####" T 1 Bright Offset(2,34)
		"####" A 0 A_GiveInventory("BFG_Charges",1)
		"####" A 0 A_JumpIfInventory("BFG_Charges",30,"MaxCharge")
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, 4) // Jump over skin specific jumps
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "Part1Refire") // QCDE 1.0 skin has less frames
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, 2) // Jump over skin specific jumps
		"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "Part1Refire") // Q3 skin has less frames
		"####" A 0 A_Refire("Part3")
		Goto Release

	Part1Refire:
		"####" A 0 A_Refire("Part1")
		Goto Release

	Part3:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" U 1 Bright Offset(2,33)
		"####" V 1 Bright Offset(1,34)
		"####" W 1 Bright Offset(1,33)
		"####" A 1 Bright Offset(2,34) // We can't use frame Y because it's used by pickup sprites. Also, Y is same as A.
		"####" A 0 A_GiveInventory("BFG_Charges",1)
		"####" A 0 A_JumpIfInventory("BFG_Charges",30,"MaxCharge")
		"####" A 0 A_Refire("Part1")
		Goto Release
	MaxCharge:
		"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargeLoop_Default",	CHAN_WEAPON,0.5,1)
		Goto MaxCharge1

	MaxCharge1:
		"####" X 1 Bright Offset(1,33)
		"####" X 1 Bright Offset(2,34)
		"####" A 0 A_Refire("MaxCharge2")
		Goto Release
	MaxCharge2:
		"####" X 1 Bright Offset(1,34)
		"####" X 1 Bright Offset(2,33)
		"####" A 0 A_Refire("MaxCharge1")
		Goto Release

	Release:
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 8, "Release.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 7, "Release.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 6, "Release.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 4, "Release.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 3, "Release.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCBFGSkin", 2, "Release.Quake2")
	Release.Default:
		QCH8 A 0
		Goto ReleaseCont
	Release.Quake2:
		Q2H8 A 0
		Goto ReleaseCont
	Release.Quake3:
		Q3H8 A 0
		Goto ReleaseCont
	Release.Quake4:
		Q4H8 A 0
		Goto ReleaseCont
	Release.QCDE1:
		Q0H8 A 0
		Goto ReleaseCont
	Release.HalfLife:
		HLH8 A 0
		Goto ReleaseCont
	Release.SeriousSam:
		SSH8 A 0
		Goto ReleaseCont

	ReleaseCont:
		"####" B 1 Bright offset(6,47) A_GunFlash("ChargedFlash")
		"####" BC 1 Bright
		"####" D 1 offset(7,48)
		"####" D 1 offset(6,46)
		"####" E 1 offset(5,44)
		"####" E 1 offset(4,42)
		"####" A 1 offset(3,40)
		"####" A 1 offset(2,38)
		"####" A 1 offset(1,36)
		"####" A 1 offset(0,32)
		Goto PostFireReady


	ChargedFlash: //Attacks doer
		"####" A 0 A_JumpIfInventory("BFG_Charges",15,"FirePower6")
		"####" A 0 A_JumpIfInventory("BFG_Charges",12,"FirePower5")
		"####" A 0 A_JumpIfInventory("BFG_Charges",9,"FirePower4")
		"####" A 0 A_JumpIfInventory("BFG_Charges",6,"FirePower3")
		"####" A 0 A_JumpIfInventory("BFG_Charges",3,"FirePower2")
		Goto FirePower1

		FirePower1:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower1.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot",0, true,1,5)
			Goto GenericFlashChecks
		FirePower1.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot_Quake4",0, true,1,5)
			Goto GenericFlashChecks

		FirePower2:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower2.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot2",0, true,1,5)
			Goto FirePower2Cont
		FirePower2.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot2_Quake4",0, true,1,5)
			Goto FirePower2Cont

		FirePower2Cont:
			"####" A 0 A_JumpIfInventory("PowerInfin",1,"GenericFlashChecks")
			"####" A 0 A_TakeInventory("QCBFGAmmo",1,TIF_NOTAKEINFINITE)
			Goto GenericFlashChecks

		FirePower3:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower3.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot3",0, true,1,5)
			Goto FirePower3Cont
		FirePower3.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot3_Quake4",0, true,1,5)
			Goto FirePower3Cont

		FirePower3Cont:
			"####" A 0 A_JumpIfInventory("PowerInfin",1,"GenericFlashChecks")
			"####" A 0 A_TakeInventory("QCBFGAmmo",2,TIF_NOTAKEINFINITE)
			Goto GenericFlashChecks

		FirePower4:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower4.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot4",0, true,1,5)
			Goto FirePower4Cont
		FirePower4.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot4_Quake4",0, true,1,5)
			Goto FirePower4Cont

		FirePower4Cont:
			"####" A 0 A_JumpIfInventory("PowerInfin",1,"GenericFlashChecks")
			"####" A 0 A_TakeInventory("QCBFGAmmo",3,TIF_NOTAKEINFINITE)
			Goto GenericFlashChecks

		FirePower5:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower5.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot5",0, true,1,5)
			Goto FirePower5Cont
		FirePower5.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot5_Quake4",0, true,1,5)
			Goto FirePower5Cont

		FirePower5Cont:
			"####" A 0 A_JumpIfInventory("PowerInfin",1,"GenericFlashChecks")
			"####" A 0 A_TakeInventory("QCBFGAmmo",4,TIF_NOTAKEINFINITE)
			Goto GenericFlashChecks

		FirePower6:
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 5, 2)
			"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "FirePower6.Quake4")
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot6",0, true,1,5)
			Goto FirePower6Cont
		FirePower6.Quake4:
			"####" A 0 A_FireCustomMissile("QCBFGChargeShot6_Quake4",0, true,1,5)
			Goto FirePower6Cont

		FirePower6Cont:
			"####" A 0 A_JumpIfInventory("PowerInfin",1,"GenericFlashChecks")
			"####" A 0 A_TakeInventory("QCBFGAmmo",5,TIF_NOTAKEINFINITE)
			Goto GenericFlashChecks

		GenericFlashChecks:
			"####" A 0 A_JumpIfInventory("PowerQuad",1,"ChargeQuadSound")
			"####" A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"ChargeQuadSound")
			Goto ChargeNormalSound
			ChargeNormalSound:
				"####" A 0 A_JumpIfInventory("BFG_Charges",15,"PlayChargeMaxSound")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "ChargeNormalSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "ChargeNormalSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "ChargeNormalSound.Default")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "ChargeNormalSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "ChargeNormalSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "ChargeNormalSound.Quake2")
			ChargeNormalSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Default",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeNormalSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake2",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeNormalSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake3",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeNormalSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_Quake4",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeNormalSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_HalfLife",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeNormalSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Fire_SeriousSam",CHAN_WEAPON)
				Goto ChargeFlashEnder

			PlayChargeMaxSound:
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "PlayChargeMaxSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "PlayChargeMaxSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "PlayChargeMaxSound.Default")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "PlayChargeMaxSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "PlayChargeMaxSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "PlayChargeMaxSound.Quake2")
			PlayChargeMaxSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_Default",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			PlayChargeMaxSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_Quake2",		CHAN_WEAPON)
				Goto ChargeFlashEnder
			PlayChargeMaxSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_Quake3",		CHAN_WEAPON)
				Goto ChargeFlashEnder
			PlayChargeMaxSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_Quake4",		CHAN_WEAPON)
				Goto ChargeFlashEnder
			PlayChargeMaxSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_HalfLife",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			PlayChargeMaxSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/ChargedShot_SeriousSam",	CHAN_WEAPON)
				Goto ChargeFlashEnder

			ChargeQuadSound:
				"####" A 0 A_JumpIfInventory("BFG_Charges",15,"PlayChargeMaxQuadSound")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "ChargeQuadSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "ChargeQuadSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "ChargeQuadSound.Default")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "ChargeQuadSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "ChargeQuadSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "ChargeQuadSound.Quake2")
			ChargeQuadSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Default",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeQuadSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake2",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeQuadSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake3",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeQuadSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_Quake4",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeQuadSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_HalfLife",	CHAN_WEAPON)
				Goto ChargeFlashEnder
			ChargeQuadSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/Fire_SeriousSam",CHAN_WEAPON)
				Goto ChargeFlashEnder

				PlayChargeMaxQuadSound:
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 8, "PlayChargeMaxQuadSound.SeriousSam")
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 7, "PlayChargeMaxQuadSound.HalfLife")
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 6, "PlayChargeMaxQuadSound.Default")
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 4, "PlayChargeMaxQuadSound.Quake4")
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 3, "PlayChargeMaxQuadSound.Quake3")
					"####" A 0 A_JumpIfInventory("QCBFGSkin", 2, "PlayChargeMaxQuadSound.Quake2")
				PlayChargeMaxQuadSound.Default:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_Default",	CHAN_WEAPON)
					Goto ChargeFlashEnder
				PlayChargeMaxQuadSound.Quake2:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_Quake2",	CHAN_WEAPON)
					Goto ChargeFlashEnder
				PlayChargeMaxQuadSound.Quake3:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_Quake3",	CHAN_WEAPON)
					Goto ChargeFlashEnder
				PlayChargeMaxQuadSound.Quake4:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_Quake4",	CHAN_WEAPON)
					Goto ChargeFlashEnder
				PlayChargeMaxQuadSound.HalfLife:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_HalfLife",	CHAN_WEAPON)
					Goto ChargeFlashEnder
				PlayChargeMaxQuadSound.SeriousSam:
					"####" A 0 A_PlaySound("QC/Weapons/BFG/Quad/ChargedShot_SeriousSam",CHAN_WEAPON)
					Goto ChargeFlashEnder

	ChargeFlashEnder:
		"####" A 0 A_TakeInventory("BFG_Charges",32767)
		"####" A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		"####" A 0 A_SetBlend("Green",0.14,20)
		"####" A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		"####" A 0 A_SetPitch(pitch-2.5)
		"####" A 2
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		"####" A 1 A_SetPitch(pitch+0.5)
		Stop
	}
}


Actor QCBFGShot
{
	Projectile
	Speed 45
	RenderStyle Add
	Alpha 0.99
	Scale 0.27
	Radius 4
	Height 8
	Damage (random(80,120))
	+FORCERADIUSDMG
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+SEEKERMISSILE
	+EXTREMEDEATH
	+DONTBLAST
	Obituary "$OB_QCBFG"
	Decal "D4BFGScorchSmall"
	DamageType "BFGDamage"
	States
	{
	Spawn:
		DB73 A 0 NODELAY A_PlaySound("QC/Weapons/BFG/BallFlying",CHAN_7,0.6,true,2.5)
		"####" AB 1 Bright Light("GreenBigPoint3")
		"####" CD 1 Bright Light("GreenBigPoint3")
		"####" EF 1 Bright Light("GreenBigPoint3")
		"####" A 0 A_Explode(16,128,0)
		"####" GH 1 Bright Light("GreenBigPoint3")
		"####" IJ 1 Bright Light("GreenBigPoint3")
		"####" KL 1 Bright Light("GreenBigPoint3")
		"####" A 0 A_Explode(16,128,0)
		"####" MN 1 Bright Light("GreenBigPoint3")
		"####" OA 1 Bright Light("GreenBigPoint3")
		"####" BC 1 Bright Light("GreenBigPoint3")
		"####" A 0 A_Explode(16,128,0)
		Goto Spawn

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepMax",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,268)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto DeathCont

	DeathCont:
		TNT1 A 0 A_RadiusThrust(88,64,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,64,XF_HURTSOURCE)	//self damage. Beware
		TNT1 A 0 A_Explode(180,192,0,0,64)
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_JumpIfInTargetInventory("BFG_UG_Rays",1,"DoRays")
		Goto EndDeath
	DoRays:
		TNT1 A 0 A_BFGSpray("BFGfogLightning",5,40)
		Goto EndDeath

	EndDeath:
		TNT1 A 0 A_Quake(4,20,0,1500)
		TNT1 A 0 A_Jump(256,"DeathFX")
		Goto DeathInvis

    DeathInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DeathFX:
		TNT1 A 0 A_PlaySound("QC/Weapons/BFG/Explo",CHAN_7,1,0,0.75)
		TNT1 A 0 A_SpawnItemEx("BFGExploRingSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 0 A_SpawnItemEx("BFGClassicExploSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 2
		TNT1 AAA 1 A_SpawnItemEx("BFGExploLightningSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		Stop
	}
}

Actor QCBFGShot_Quake4 : QCBFGShot
{
	RenderStyle Normal
	Alpha 1.0
	Scale 1.0
	Decal "D4BFGScorchSmall"
	States
	{
	Spawn:
		BHOL A 0 NODELAY A_PlaySound("QC/Weapons/BFG/BallFlying",CHAN_7,0.6,true,2.5)
		"####" AB 1 Bright Light("BlackBigPoint3")
		"####" CD 1 Bright Light("BlackBigPoint3")
		"####" EF 1 Bright Light("BlackBigPoint3")
		"####" A 0 A_Explode(16,128,0)
		"####" GH 1 Bright Light("BlackBigPoint3")
		"####" IJ 1 Bright Light("BlackBigPoint3")
		"####" KL 1 Bright Light("BlackBigPoint3")
		"####" A 0 A_Explode(16,128,0)
		Goto Spawn

	DeathFX:
		TNT1 A 0 A_PlaySound("QC/Weapons/BFG/Explo",CHAN_7,1,0,0.75)
		TNT1 A 0 A_SpawnItemEx("BFGQ4ExploEffect1",0,0,0,0,0,0)
		TNT1 AAAAAAAA 0 A_SpawnItemEx("BFGQ4ExploSmokeParticle",0,0,0,frandom(3.4,-3.4),frandom(3.4,-3.4),frandom(3.4,-3.4),random(0,359))
		Stop
	}
}





Actor BFGExploRingSmall //shockwave
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 1.0
	Scale 0.5
	Translation "0:255=%[0,0,0]:[0.0,1.8,0.0]"
	States
	{
	Spawn:
		X060 C 1 Bright A_SetScale(0.075)
		X060 C 1 Bright A_SetScale(0.225)
	Looper:
		X060 C 1 Bright A_SetScale(scalex*1.2)
		TNT1 A 0 A_FadeOut(0.1)
		Loop
	}
}

