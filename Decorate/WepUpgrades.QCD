Actor CompatVer30_WepUpgrades{} // for compatibility checks

// Arg0: weapon number
// Arg1: upgrade number

Actor UpgradeDropper 15528
{
	//$NotAngled
	//$Category "QCDE Pickups"
	//$Title "Weapon Upgrade"
	//$Color 3
	//$IgnoreRenderstyle
	//$Sprite "UPG_21_3"

	//$Arg0 "Weapon"
	//$Arg0ToolTip "QCDE weapon to upgrade"
	//$Arg0Type 11
	//$Arg0Enum {0="Gauntlet";3="Shotgun";7="Heavy Machinegun";9="Super Shotgun";11="Super Nailgun";13="Tribolt";15="Rocket Launcher";17="Lightning Gun";19="Railgun";21="BFG10k";}

	//$Arg1 "Upgrade"
	//$Arg1ToolTip "Upgrade index. Most weapons have 2 as alt-fire modifier."
	//$Arg1Type 11
	//$Arg1Enum {1="1";2="2";}

	//$Arg2 "Random preset"
	//$Arg2ToolTip "Overrides args 0 and 1. Forces to drop a random upgrade (like a dead monster)."
	//$Arg2Type 11
	//$Arg2Enum {1="Small";2="Medium";3="Big";4="Boss";}
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_UpgradeDropper",args[0],args[1],args[2])
		TNT1 A 100
		Stop
	}
}

//$GZDB_SKIP

Actor UpgradeDropperSmall  : UpgradeDropper { Args 0,0,1 }
Actor UpgradeDropperMedium : UpgradeDropper { Args 0,0,2 }
Actor UpgradeDropperBig    : UpgradeDropper { Args 0,0,3 }
Actor UpgradeDropperBoss   : UpgradeDropper { Args 0,0,4 }

Actor Upgrade_0_0 : CustomInventory
{
	+BRIGHT
	+INVENTORY.QUIET
	+DONTGIB
	+FORCEXYBILLBOARD
	+DOOMBOUNCE
	+SERVERNETID
	Scale 0.17
	States
	{
	Nope:
		TNT1 A 0
		Fail
	Yep:
		TNT1 A 0 A_Turn(0)
		Stop
	}
}

Actor Upgrade_0_1 : Upgrade_0_0
{	States
	{Spawn: U001 A 45 NoDelay A_Turn(0) Loop
	Pickup: TNT1 A  0 A_JumpIf(!CallACS("QCDE_Upgrade",0,1), "Nope") Goto Yep }}
Actor Upgrade_0_2 : Upgrade_0_0
{	States
	{Spawn: U002 A 45 NoDelay A_Turn(0) Loop
	Pickup: TNT1 A  0 A_JumpIf(!CallACS("QCDE_Upgrade",0,2), "Nope") Goto Yep }}

