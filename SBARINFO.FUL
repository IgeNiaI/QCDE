	inInventory SamMinigun									{ 	isSelected SamMinigun									{ drawBar "1AMGUN",   "0AMGUN",   SeriousBullets, horizontal, 1480,840; } else { drawBar "SAMGUN",   "0AMGUN",   SeriousBullets	, horizontal, 1480,840; } }

