Actor InjectionProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_AlertMonsters(96)
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken",1,0,GIF_SKIPOWNER)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMHeal")
	SPHeal:
		TNT1 A 0 A_GiveInventory("QCMegaHealth",1,0,GIF_FORCESERVERSIDE)
		Goto CommonEnding
	DMHeal:
		TNT1 A 0 ACS_NamedExecuteWithResult("HealthGiver",CallACS("MaxHealth"), 75, 0)
		Goto CommonEnding
	CommonEnding:
		TNT1 A 0 A_GiveInventory("KaneSpeed",1,0,GIF_SKIPOWNER)	//speed boost, for a very short time
		TNT1 A 0 A_GiveInventory("ActiveInProgress",1,0,GIF_SKIPOWNER)
		TNT1 A 0 A_SetBlend("Purple", 1.0, 10)
		TNT1 A 0 A_SetBlend("SkyBlue", 0.7, 30)
		TNT1 A 35 A_FireCustomMissile("InjectionBubble",0, false, 0, 0, FPF_SKIPOWNER)
		Stop
	}
}


Actor InjectionCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("NoWeaponFireToken",1)
		TNT1 A 0 A_TakeInventory("ActiveInProgress")
		TNT1 A 35
		Stop
	}
}

Actor PowerInjectionSpeed : PowerSpeed
{
	Speed 1.3
}
Actor KaneSpeed : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "InjectionSpeed"
	powerup.duration -5
}

Actor InjectionBubble
{
	Radius 1
	Height 1
	+NOINTERACTION
	+SERVERNETID
	+INVISIBLE_TO_TARGET
	Projectile
	RenderStyle Add
	Scale 0.38
	Alpha 0.99
	Translation "0:255=%[0.0,0.0,0.0]:[1.8,1.8,2]"
	States
	{
	Spawn:
		X122 A 0 NODELAY A_PlaySound("QC/Abilities/Kane/Inject")
		X122 AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPP 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 AA 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 BB 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 CC 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 DD 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 EE 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 FF 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 GG 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 HH 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.1)
		X122 II 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X122 A 0 A_FadeOut(0.09)
		X122 JJ 1 Bright A_Warp(AAPTR_TARGET, -5,0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		Stop
	}
}



