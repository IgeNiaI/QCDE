Actor QCTerminator : QCPlayerHeavy
{
	Player.DisplayName "Terminator"
	Player.SoundClass "Terminator"
	Player.Palette "PL07"

	XScale 0.87
	YScale 0.9

	Player.FootstepInterval 13
	Player.FootstepVolume 0.75

	Player.MaxHealth 150
	Health 150
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 125

	Player.StartItem "Class_Terminator"
	Player.StartItem "Body_Big"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP07 E 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP07 E 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP07 E 0 A_JumpIf(true,                   "DefSpawn")
		QP07 E 100
		Loop

		ColoredSpawn:
			RP07 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP07 E 4
			Loop
		DefSpawn:
			QP07 A 0 A_JumpIf(momx||momy,"DefSee")
			QP07 E 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP07 ABCD 4
			RP07 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP07 ABCD 4
			QP07 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP07 E 12
			RP07 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP07 E 12
			QP07 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP07 F 6 BRIGHT Light("PlayerFiringLight")
			RP07 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP07 F 6 BRIGHT Light("PlayerFiringLight")
			QP07 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP07 G 4
			RP07 G 4 A_Pain
			RP07 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP07 G 4
			QP07 G 4 A_Pain
			QP07 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP07 H 3
		QP07 I 3 A_PlayerScream
		QP07 J 3 A_NoBlocking
		QP07 KL 3 Bright
		QP07 A 0 A_SpawnItemEx("TerminatorArm", 0,0,40, frandom(4,-4),frandom(4,-4),frandom(1,3), random(0,359),SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP07 MNOPQ 3 Bright
		QP07 RSTU 3
		QP07 V 1050 A_StopSound(CHAN_WEAPON)
		QP07 VVVVVVV 35 A_SetScale(scalex,scaley-0.05)
		QP07 V -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP07 H 3 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP07 I 3 //A_XScream
		QP07 J 3 A_NoBlocking
		QP07 KL 3 Bright
		QP07 A 0 A_SpawnItemEx("TerminatorArm", 0,0,40, frandom(4,-4),frandom(4,-4),frandom(1,3), random(0,359),SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP07 MNOPQ 3 Bright
		QP07 RSTU 3
		QP07 V 1050 A_StopSound(CHAN_WEAPON)
		QP07 VVVVVVV 35 A_SetScale(scalex,scaley-0.05)
		QP07 V -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}

Actor TerminatorArm
{
	+CLIENTSIDEONLY
	+SERVERNETID
	-NOLIFTDROP
	-SOLID
	+DROPOFF
	+NOTELEPORT
	+CORPSE
	Scale 1.025
	Radius 6
	Height 5
	States
	{
	Spawn:
		QP07 WXY 6
		Wait
	Crash:
		WP07 Z 3
		"####" "#" 175 //5sec
		"####" "#" 1 A_FadeOut
		Wait
	}
}


