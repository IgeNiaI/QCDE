Map TITLEMAP "$HUSTR_TITLE"
{
	NotCategory0 // Exclude from "All maps" list
}


clearskills
//----------------------------------------
// normal skills
Skill Normal_FewMonsters
{
	SpawnFilter = Easy
	Aggressiveness = 0.8
	Name = "$SKILL_NORMAL_MIN"
	TextColor = White
	ACSReturn = 1
}
Skill Normal_MoreMonsters
{
	SpawnFilter = Normal
	Aggressiveness = 0.8
	Name = "$SKILL_NORMAL_MED"
	TextColor = White
	ACSReturn = 2
}
Skill Normal_MaxMonsters
{
	SpawnFilter = Hard
	Aggressiveness = 0.8
	Name = "$SKILL_NORMAL_MAX"
	TextColor = White
	DefaultSkill
	ACSReturn = 3
}

//----------------------------------------
// Hard skills
Skill Hard_FewMonsters
{
	SpawnFilter = Easy
	Aggressiveness = 0.85
	Name = "$SKILL_HARD_MIN"
	TextColor = Orange
	DamageFactor = 1.201
	MonsterHealth = 1.25
	ACSReturn = 4
}

Skill Hard_MoreMonsters
{
	SpawnFilter = Normal
	Aggressiveness = 0.85
	Name = "$SKILL_HARD_MED"
	TextColor = Orange
	DamageFactor = 1.201
	MonsterHealth = 1.25
	ACSReturn = 5
}

Skill Hard_MaxMonsters
{
	SpawnFilter = Nightmare
	Aggressiveness = 0.85
	Name = "$SKILL_HARD_MAX"
	TextColor = Orange
	DamageFactor = 1.201
	MonsterHealth = 1.25
	Mustconfirm = "$NOT_ULTRAVIOLENCE"
	ACSReturn = 6
}

//----------------------------------------
// WTF skill
Skill Deathbound
{
	SpawnFilter = Nightmare
	Name = "$SKILL_NIGHTMARE"
	TextColor = Red
	DamageFactor = 2.01
	AmmoFactor = 2.0
	MonsterHealth = 1.5
	Aggressiveness = 1.0
	ReplaceActor = "Medikit", "Stimpack"
	ReplaceActor = "BlueArmor", "GreenArmor"
	FastMonsters
	Mustconfirm = "$NIGHTMARE"
	ACSReturn = 7
}

//----------------------------------------
// Easy skills
Skill CellphoneEasy_FewMonsters
{
	SpawnFilter = Easy
	DamageFactor = 0.501
	Aggressiveness = 0
	EasyBossBrain
	Name = "$SKILL_EASY_MIN"
	EasyKey
	TextColor = Green
	ACSReturn = -2
}
Skill CellphoneEasy_NormalMonsters
{
	SpawnFilter = Normal
	DamageFactor = 0.501
	Aggressiveness = 0
	EasyBossBrain
	Name = "$SKILL_EASY_MED"
	EasyKey
	TextColor = Green
	ACSReturn = -1
}
Skill CellphoneEasy_MaxMonsters
{
	SpawnFilter = Hard
	DamageFactor = 0.501
	Aggressiveness = 0
	EasyBossBrain
	Name = "$SKILL_EASY_MAX"
	EasyKey
	TextColor = Green
	ACSReturn = 0
}
