			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Modded",-5)
			Goto CoopHold2Cont
		CoopHold2Cont:
			"####" A 0 Offset(0,32)
			"####" C 1 Bright
			"####" A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_LgShouldGoPurple",0,0,0,0) == 1,"LGSet100Purp")
			"####" A 0 A_ReFire("CoopHold3")
			Goto FireEnd

		CoopHold3:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "CoopHold3.Modded")
