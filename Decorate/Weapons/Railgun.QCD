			Goto PerformSPCont
		PerformSP.Modded:
			TNT1 A 0 A_RailAttack(random(20,24)*10,1,1,"None","None",RGF_SILENT|RGF_FULLBRIGHT|RGF_EXTRATRAIL,0,"RailgunPuff_Modded",0,0,0,0,6,1,"RailgunTrail_Modded", 1)
			Goto PerformSPCont

		PerformSPCont:
			TNT1 A 0 A_JumpIfInventory("RG_UG_Pierce",1,"AddPierceBeam")
			Goto FlashCheckSound

			AddPierceBeam:
				TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "AddPierceBeam.Modded")
				TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "AddPierceBeam.SeriousSam")
				TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "AddPierceBeam.HalfLife")
