//================================================================
//================================================================

Actor QWrath : QCDE_MonsterMedium 	15118	// painelem
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 500
	Speed 12
	Radius 24
	Height 56
	PainChance 15
	Mass 400
	Scale 0.35
	Meleedamage 6
	REACTIONTIME 8
	Monster
	+NOGRAVITY
	+FLOAT
	+DONTFALL
	+DONTMORPH
	+NOFEAR
	RenderStyle Translucent
	aLPHA 0.9
	Tag "$TAG_QWrath" // "Wrath"
	SeeSound "deathshroud/active"
	PainSound "deathshroud/pain"
	DeathSound "deathshroud/death"
	ActiveSound "deathshroud/active"
	Obituary "$OB_QWrath" // "%o was terrified by a wrath."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		DSHR A 3 A_Look
		Loop
	See:
		DSHR A 0
		DSHR AABBCC 3 A_Chase
		Loop
	Missile:
		DSHR A 0 A_PlaySound("deathshroud/attack")
		DSHR A 0 A_Jump(64,"VoreAttack")

		ScragAttack:
			DSHR DEFFFG 3 A_FaceTarget
			TNT1 A 0 A_Jump(256,"RightToLeft","LeftToRight")

			RightToLeft:
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-18)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-12)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-6)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,0)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,6)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,12)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,18)
				Goto EndBarrage
			LeftToRight:
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,18)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,12)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,6)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,0)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-6)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-12)
				DSHR H 2 A_CustomMissile("WrathBallScrag",40,0,-18)
				Goto EndBarrage

		EndBarrage:
			DSHR H 10
			DSHR HHHHHH 3
			Goto See

		VoreAttack:
			TNT1 A 0 A_JumpIfInventory("VoreBallToken",2,"ScragAttack")
			DSHR IJKKK 3 A_FaceTarget
			DSHR L 5 A_FaceTarget
			DSHR M 5 A_CustomMissile("WrathBallVore",40,0,0)
			DSHR M 10 A_FaceTarget
			DSHR M 18
			Goto See

	Pain:
		DSHR S 4 A_Pain
		DSHR TUV 4
		Goto See

	XDeathChecksDone:
	DeathChecksDone:
		DSHR A 0 A_Scream
		DSHR A 0 A_GiveInventory("LOLImDead",1)	 //...this will kill the projectile
		DSH2 ABCDEFGHIJ 3
		DSH2 K 6
		DSH2 K 0 A_PlaySound("q2weapon/rocketexplo")
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		DSH2 K 0 A_Explode(40,64,XF_NOTMISSILE)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_KillMaster
		TNT1 A 1 A_Fall
	Death.Corpse:
		TNT1 A 10
		Stop

	}
}


Actor WrathBallScrag : ScragBall
{
	Speed 28
	Damage 2
	Translation "0:255=%[0,0,0]:[1.0,0.0,0.0]"
}

Actor WrathBallVore : VoreBall
{
	Speed 10
	Damage 0	//Damage will be 35 from explosion, and that's it
	Translation "0:255=%[0,0,0]:[1.5,0,0]"
}
Actor WrathVoreTrail : VoreTrail
{
	Scale 0.15
	RenderStyle Add
	Alpha 0.0
}

