Actor CompatVer31_Tribolt {} // for compatibility checks

Actor TriboltPickup : QCWeaponPickup 15604
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Tribolt"
	Height 48
	Radius 20
	Scale 0.6
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCTribolt" // "Picked up a Tribolt."
	Tag "$TAG_QCTribolt" // "Tribolt"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		WPNE Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		WPNE Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",14,args[4],args[3])
		WPNE Z 0 A_SetArg(3, 1)
		WPNE Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		WPNE Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",13,args[4],args[3])
		WPNE Y 0 A_SetArg(3, 1)
		WPNE Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCTribolt")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCTriboltDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCTribolt",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTribolt", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0 A_JumpIfInventory("QCTriboltDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTriboltDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor TriboltPickupNoGravity : TriboltPickup 15614
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Tribolt (No Gravity)"
	+NOGRAVITY
}


Actor QCTribolt : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.8
	Weapon.Kickback 0
	Weapon.SelectionOrder 1950
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "QCBoltAmmo"
	Inventory.PickupMessage "$GOT_QCTribolt"
	Obituary "$OB_QCTribolt"
	Tag "$TAG_QCTribolt"
	Scale 0.6
	States
	{
	Spawn:
		TNT1 A 1
		WPNE Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		WPNE ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		WPNE Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"Select.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Select.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Select.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Select.Quake1")
	Select.Default:
		QCAE A 0
		Goto SelectCont
	Select.Quake1:
		Q1AE A 0
		Goto SelectCont
	Select.Quake2:
		Q2AE A 0
		Goto SelectCont
	Select.Quake3:
		Q3AE A 0
		Goto SelectCont
	Select.Quake4:
		Q4AE A 0
		Goto SelectCont
	Select.QCDE1:
		Q0AE A 0
		Goto SelectCont
	Select.HalfLife:
		HLAE A 0
		Goto SelectCont
	Select.SeriousSam:
		SSAE A 0
		Goto SelectCont
	Select.Modded:
		MDAE A 0
		Goto SelectCont

	Select.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Select.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Select.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Select.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Select.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Select.Upgraded.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Select.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Select.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Select.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Select.Upgraded.Quake1")
	Select.Upgraded.Default:
		QCGE A 0
		Goto SelectCont
	Select.Upgraded.Quake1:
		Q1GE A 0
		Goto SelectCont
	Select.Upgraded.Quake2:
		Q2GE A 0
		Goto SelectCont
	Select.Upgraded.Quake3:
		Q3GE A 0
		Goto SelectCont
	Select.Upgraded.Quake4:
		Q4GE A 0
		Goto SelectCont
	Select.Upgraded.QCDE1:
		Q0GE A 0
		Goto SelectCont
	Select.Upgraded.HalfLife:
		HLGE A 0
		Goto SelectCont
	Select.Upgraded.SeriousSam:
		SSGE A 0
		Goto SelectCont
	Select.Upgraded.Modded:
		MDGE A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"Prepare.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Prepare.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Prepare.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Prepare.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Prepare.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Prepare.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Prepare.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Prepare.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Prepare.Quake1")
	Prepare.Default:
		QCAE A 0
		Goto PrepareCont
	Prepare.Quake1:
		Q1AE A 0
		Goto PrepareCont
	Prepare.Quake2:
		Q2AE A 0
		Goto PrepareCont
	Prepare.Quake3:
		Q3AE A 0
		Goto PrepareCont
	Prepare.Quake4:
		Q4AE A 0
		Goto PrepareCont
	Prepare.QCDE1:
		Q0AE A 0
		Goto PrepareCont
	Prepare.HalfLife:
		HLAE A 0
		Goto PrepareCont
	Prepare.SeriousSam:
		SSAE A 0
		Goto PrepareCont
	Prepare.Modded:
		MDAE A 0 A_PlaySound("QC/Weapons/Tribolt/Prepare_Modded",CHAN_WEAPON,1,1)
		Goto PrepareCont

	Prepare.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Prepare.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Prepare.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Prepare.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Prepare.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Prepare.Upgraded.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Prepare.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Prepare.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Prepare.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Prepare.Upgraded.Quake1")
	Prepare.Upgraded.Default:
		QCGE A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake1:
		Q1GE A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake2:
		Q2GE A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake3:
		Q3GE A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake4:
