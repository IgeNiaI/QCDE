		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,2)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,5,3)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,5,4)
		Goto FlashEnderCont
	FlashEnder.Quake4:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,2,4)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,3,4)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,4,5)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,6)
		Goto FlashEnderCont
	FlashEnder.ETQW:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,2,4)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,3,4)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,4,5)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,6)
		Goto FlashEnderCont
	FlashEnder.QCDE1:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,5,1)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,6,1)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,7,2)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,7,3)
		Goto FlashEnderCont
	FlashEnder.HalfLife:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,2,4)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,3,4)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,4,5)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,6)
		Goto FlashEnderCont
	FlashEnder.SeriousSam:
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,2,4)
		TNT1 A 0 A_FireCustomMissile("SSGSmokeSpawner2",0, false,3,4)
		TNT1 A 1 A_FireCustomMissile("SSGSmokeSpawner1",0, false,4,5)
		TNT1 A 2 A_FireCustomMissile("SSGSmokeSpawner2",0, false,4,6)
		Goto FlashEnderCont
	FlashEnder.Modded:
		TNT1 A 1
		TNT1 A 0 // Keeping frames same as above
		TNT1 A 1
		TNT1 A 2
		Goto FlashEnderCont

	FlashEnderCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 AAAAAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop

	FlashEnderNoRecoil:
		TNT1 A 0
		Stop
	}
}
Actor SSGSmokeSpawner1
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+NOCLIP
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("SSGSmoke1",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}
Actor SSGSmokeSpawner2
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+NOCLIP
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("SSGSmoke2",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor SSGSmoke1
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.9
	Scale 0.04
	States
	{
	Spawn:
		X201 E 0
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.04)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.045)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.05)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.005)
		"####" "#" 2 A_FadeOut(0.045)
		Loop
	}
}
