"Quad Machine",            "(Quake 2 cover)",
"Infuscomus",              "(Blood cover)",
"Xenomorph",               "",
"Shodan",                  "",
"Devil",                   "",
"Descent into Cerberon",   "(Quake 2 cover)",
"Deimos",                  "",
"Grabbag",                 "(Duke Nukem cover)",
"Durandal",                "(Marathon 2 cover)",
"G.M.G.",                  "(The Spud Hunter theme)",
"Wraith",                  "",
"Vyper",                   "",
"Get Psyched!",            "(Wolfenstein 3D cover)",
"Doomed",                  "",
"Crusade",                 "(Galena theme)",
"For The Makron",          "(Strogg & Peeker theme)",
