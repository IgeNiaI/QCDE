		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Fire.Upgraded.Quake1")
	Fire.Upgraded.Default:
		QCK7 A 0
		Goto RegularFireSequence
	Fire.Upgraded.Quake1:
		Q1K7 A 0
		Goto RegularFireSequence
	Fire.Upgraded.Quake2:
		Q2K7 A 0
		Goto RegularFireSequence
	Fire.Upgraded.Quake3:
		Q3K7 A 0
		Goto RegularFireSequence
	Fire.Upgraded.Quake4:
		Q4K7 A 0
		Goto RegularFireSequence
	Fire.Upgraded.ETQW:
