//================================================================
//================================================================
Actor QNgyrKorath : QCDE_MonsterBoss	15110	// mastermind
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Translation "0:255=%[0.0,0.0,0.0]:[0.5,0.9,1.2]", "32:47=32:47", "176:191=176:191"
	Health 3800
	Radius 64
	Height 90
	Speed 8
	PainChance 30
	Scale 0.75
	Mass 0x7FFFFFFF
	Monster
	REACTIONTIME 16
	+BOSSDEATH
	+FLOORCLIP
	+NORADIUSDMG
	+NOICEDEATH
	+MISSILEMORE
	+MISSILEEVENMORE
	Tag "$TAG_QNgyrKorath" // "Ngyr-Korath"
	Obituary "$OB_QNgyrKorath" // "%o was terrorized by Ngyr-Korath."
	SeeSound "Quake1/NgyrKorath/Sight"
	PainSound "Quake1/NgyrKorath/Pain"
	DeathSound "Quake1/NgyrKorath/Death"
	ActiveSound "Quake1/NgyrKorath/Idle"
	Species "Ngyr"
	BloodColor 6 106 97
	DropItem "BigHourglass"
	States
	{
	Spawn:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_AttachTrailer",0,1,5,180)
		Goto Super::Spawn
	Idle:
		Q39I A 10 A_Look
		Loop
	See:
		Q39W ABCDEF 5 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_PlaySound("Quake1/NgyrKorath/Attack")
		TNT1 A 0 A_JumpIfCloser(1024,"PickCloseAttack")
		Goto DarkSpheres

	PickCloseAttack:
		TNT1 A 0 A_Jump(256,"GroundSpike","RaiseZombies")
		Goto DarkSpheres


	DarkSpheres:
		Q39A ABCD 5 A_FaceTarget
		Q39A E 5 A_CustomMissile("NgyrBall1",40)
		Q39A FABCD 5 A_FaceTarget
		Q39A E 5 A_CustomMissile("NgyrBall1",40)
		Q39A FABCD 5 A_FaceTarget
		Q39A E 5 A_CustomMissile("NgyrBall1",40)
		Q39A F 5 A_FaceTarget
		Goto See
	GroundSpike:
		TNT1 A 0 A_Jump(128,"DarkSpheres") //even if close enough, it might still do sphere attack
		Q39A ABCD 5 A_FaceTarget
		Q39A E 5 A_Custommissile ("NgyrGroundSpike", 32, 0, 0)
		Q39A FABCD 5 A_FaceTarget
		Q39A E 5 A_Custommissile ("NgyrGroundSpike", 32, 0, 0)
		Q39A FABCD 5 A_FaceTarget
		Q39A E 5 A_Custommissile ("NgyrGroundSpike", 32, 0, 0)
		Q39A F 5 A_FaceTarget
		Goto See
	RaiseZombies:
		TNT1 A 0 A_Jump(128,"DarkSpheres") //even if close enough, it might still do sphere attack
		TNT1 A 0 A_PlaySound("Quake1/NgyrKorath/Resurrect",7,1,0,0.5)
		Q39I A 2 Light("NgyrSmallPoint3") A_FaceTarget
		Q39I A 2 Light("NgyrSmallPoint2") A_FaceTarget
		Q39I A 2 Light("NgyrSmallPoint1") A_FaceTarget
		Q39I A 2 Light("NgyrMediumPoint3") A_FaceTarget
		Q39I A 2 Light("NgyrMediumPoint2") A_FaceTarget
		Q39I A 2 Light("NgyrMediumPoint1") A_FaceTarget
		Q39I A 2 Light("NgyrBigPoint3") A_FaceTarget
		Q39I A 2 Light("NgyrBigPoint2") A_SpawnItemEx("NgyrZombie",0,0,40, 20,0,random(3,6),   90+random(20,-20), SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER )
		Q39I A 2 Light("NgyrBigPoint2") A_SpawnItemEx("NgyrZombie",0,0,40, 20,0,random(3,6), - 90+random(20,-20), SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER )
		Q39I A 2 Light("NgyrBigPoint2") A_SpawnItemEx("NgyrZombie",0,0,40, 20,0,random(3,6),  135+random(20,-20), SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER )
		Q39I A 2 Light("NgyrBigPoint2") A_SpawnItemEx("NgyrZombie",0,0,40, 20,0,random(3,6), -135+random(20,-20), SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER )
		Q39I AAAAAA 5 Light("NgyrBigPoint2")
		Q39I A 2 Light("NgyrBigPoint3")
		Q39I A 2 Light("NgyrMediumPoint1")
		Q39I A 2 Light("NgyrMediumPoint2")
		Q39I A 2 Light("NgyrMediumPoint3")
		Q39I A 2 Light("NgyrSmallPoint1")
		Q39I A 2 Light("NgyrSmallPoint2")
		Q39I A 2 Light("NgyrSmallPoint3")
		Goto See
	Pain:
		Q39P A 3
		Q39P A 3 A_Pain
		Goto See

	DeathChecksDone:
		Q39P A 5 A_Scream
		Q39D A 7
		Q39D B 7 A_KillChildren
		Q39D CD 7
		Q39D EF 7
		Q39D G 12
		Q39D G 1 A_Fall
		"####" "#" 0 A_QueueCorpse
	Death.Corpse:
		Q39D G -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperBig",0,0,50,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	}
}


Actor NgyrBodyTrail		//flames that are spawned constantly via ACS "trailer"
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.5
	Alpha 0.0
	Translation "0:255=%[0,0,0]:[0.165,0.6,0.51]"
	States
	{
	Spawn:
		X123 T 0 NODELAY A_SetScale(frandom(0.45,0.65))
		X123 TUVWX 2 Bright A_FadeIn(0.2)
	Looper:
		X123 ABCDEFGHIJKLMNO 2 Bright
		X123 PQRSTUVWXABCDEFGHIJKLMNOPQRSTUVWX 2 Bright A_FadeOut(0.05)
		Stop
	}
}


//----------------------------------------------------
// Zombie spawned
Actor NgyrZombie : QZombie
{
	Species "Ngyr"
	+THRUSPECIES
	-COUNTKILL
	+THRUACTORS
	+BRIGHT
	BloodColor Black
	Translation "0:255=%[0,0,0]:[0.165,0.6,0.51]"
	Health 30
	Alpha 0.0
	States
	{
	Spawn:
		TNT1 A 0 NODELAY ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Goto Super::Spawn
	StartAppearing:
		TNT1 A 5 A_CheckFloor("Appear")
		Wait
	Appear:
		Q40D A 0 A_Stop
		Q40D FFFFFFFFFF 1 A_FadeIn(0.1)
		Q40D GHIJKLM 3
		Q40I A 10 A_Look
		Wait
	Idle:
		Q40I A 0 A_JumpIf(alpha < 1.0, "StartAppearing")
		Q40I A 10 A_Look
		Wait
	Missile:
		Q40A ABCDE 5 A_FaceTarget
		Q40A F 5 A_CustomMissile("NgyrZombieGib",34,0,0)		//for balance issues, this wont be affected by gravity
		Goto See
	Death:
		TNT1 A 0 A_PlaySound("Quake1/Zombie/Gibbed")
		TNT1 A 10 A_SpawnItemEx("BloodCloud",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
		Stop
	Xdeath:
		TNT1 A 0 A_Jump(256,"Death")
		Goto Death
	}
}

Actor NgyrZombieGib
{
	Projectile
	Speed 20
	Radius 5
	Height 10
	Damage (7)
	Scale 0.3
	//Translation "0:255=%[0,0,0]:[0.33,1.2,1.02]"
	Translation "0:255=%[0,0,0]:[0.165,0.6,0.51]"
	RenderStyle Add
	States
	{
	Spawn:
		X008 ABCD 4 Bright
		Loop
	Death:
		TNT1 A 0 A_PlaySound("Quake1/Zombie/Missed")
		Goto CommonEnd
	XDeath:
		TNT1 A 0 A_PlaySound("Quake1/Zombie/Impact")
		Goto CommonEnd
	CommonEnd:
		X009 ACEGHIJKLMNO 1 Bright
		Stop
	}
}

//----------------------------------------------------
// Ngyr "Rocket", sliiiiiighly seeking
Actor NgyrBall1
{
	Projectile
	Radius 8
	Height 12
	Speed 20
	Damage 14
	+SEEKERMISSILE
	SeeSound "Quake1/NgyrKorath/ProjSee"
	DeathSound "Quake1/NgyrKorath/ProjHit"
	//Translation "0:255=%[0,0,0]:[0.495,1.8,1.53]"	//very bright
	Translation "0:255=%[0,0,0]:[0.33,1.2,1.02]" //medium bright
	//Translation "0:255=%[0,0,0]:[0.165,0.6,0.51]"	//dark
	RenderStyle Add
	Scale 0.4
	States
	{
	Spawn:
		DB58 ZYXWV 2 Bright Light("NgyrMediumPoint2") A_SpawnItemEx("NgyrBall1Trail",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		DB58 A 0 A_SeekerMissile(7,7,SMF_PRECISE)
		DB58 PONML 2 Bright Light("NgyrMediumPoint2") A_SpawnItemEx("NgyrBall1Trail",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		DB58 A 0 A_SeekerMissile(7,7,SMF_PRECISE)
		DB58 KJIHG 2 Bright Light("NgyrMediumPoint2") A_SpawnItemEx("NgyrBall1Trail",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		DB58 A 0 A_SeekerMissile(7,7,SMF_PRECISE)
		DB58 FEDCBA 2 Bright Light("NgyrMediumPoint2") A_SpawnItemEx("NgyrBall1Trail",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Loop
	Death:
		TNT1 A 0 A_SetScale(0.9)
		TNT1 A 0 A_Explode(144,128,0)
		DB59 A 2 Bright Light("NgyrMediumPoint3")
		DB59 B 2 Bright Light("NgyrMediumPoint2")
		DB59 C 2 Bright Light("NgyrMediumPoint1")
		DB59 DEFGHIJ 2 Bright Light("NgyrBigPoint3")
		DB59 K 2 Bright Light("NgyrMediumPoint1")
		DB59 L 2 Bright Light("NgyrMediumPoint2")
		DB59 M 2 Bright Light("NgyrMediumPoint3")
		DB59 N 2 Bright Light("NgyrSmallPoint1")
		DB59 O 2 Bright Light("NgyrSmallPoint1")
		DB59 P 2 Bright Light("NgyrSmallPoint2")
		DB59 QRS 2 Bright
		stop
	}
}

Actor NgyrBall1Trail
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.4
	Translation "0:255=%[0,0,0]:[0.165,0.6,0.51]"	//dark
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,4,8,12,16)
		DB58 ZYXWVUTSRQPONMLKJIHGFEDCBA 2 Bright A_FadeOut(0.1)
		Goto Spawn+1
	}
}

//----------------------------------------------------
// Ground spikes

Actor NgyrGroundSpike
{
    Projectile
    Speed 25
    Radius 8
    Height 8
    Damage 6
    +RIPPER
    +BLOODLESSIMPACT
    +FLOORHUGGER
	+DONTSPLASH
	Reactiontime 25
	DamageType "NgyrSpikes"
	Translation "0:255=%[0,0,0]:[0.33,1.2,1.02]"
    States
    {
    Spawn:
		TNT1 A 0
		TNT1 D 3 A_CustomMissile("NgyrGroundSpikeExt",0,0,0)
		TNT1 A 0 A_CountDown
		Loop
    Death:
		TNT1 A 1
		Stop
    }
}

Actor NgyrGroundSpikeExt
{
    Projectile
    Speed 0
    Scale 0.6
    Radius 8
    Height 8
    Damage 2
    +FLOORHUGGER
    +RIPPER
	+BLOODLESSIMPACT
	DamageType "NgyrSpikes"
	Translation "0:255=%[0,0,0]:[0.33,1.2,1.02]"
    States
    {
    Spawn:
		TNT1 A 0
		TNT1 A 0 A_RadiusThrust(20,15,0)
		RSPK D 3 Light("NgyrSmallPoint3")
		RSPK C 3 Light("NgyrSmallPoint2")
		RSPK B 3 Light("NgyrSmallPoint1")
		RSPK A 3 Light("NgyrMediumPoint3")
		RSPK A 5 Light("NgyrMediumPoint3")
		RSPK B 3 Light("NgyrSmallPoint1")
		RSPK C 3 Light("NgyrSmallPoint2")
		RSPK D 3 Light("NgyrSmallPoint3")
		Stop
    }
}
