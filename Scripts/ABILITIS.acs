Script "QCDE_Ability_Sorgaul" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0,"QC/Abilities/Sorgaul/RageStart",CHAN_7,1.0,false,0.8);
	//PlaySound(0,"QC/Abilities/Sorgaul/RageLoop",CHAN_5,1.0,true,1.0); //has to be played through weapon itself
	SetNetworkReplicationFlags( 0 );

	if(PlayerIsBot(PlayerNumber()))
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("PrimalRageBotProc",1);
		SetNetworkReplicationFlags( 0 );
		ACS("QCDE_SetWeapon", "SorgaulFistsBot", GetDuration());
	}
	else
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("PrimalRageProc",1);
		SetNetworkReplicationFlags( 0 );
		ACS("QCDE_SetWeapon", "SorgaulFists", GetDuration());
	}
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

