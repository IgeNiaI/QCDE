// --------------------------------------------------------------------------
//
// Railgun
// Weapon and Pickup sprite by FrancoTieppo
// Weapon code by DBT
//
// --------------------------------------------------------------------------

Actor CompatVer31_Railgun {} // for compatibility checks

Actor RailgunPickup : QCWeaponPickup 15607
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Railgun"
	Height 48
	Radius 20
	Scale 0.63
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCRailgun" // "Picked up a Railgun."
	Tag "$TAG_QCRailgun" // "Railgun"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		WPN7 Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		WPN7 Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",20,args[4],args[3])
		WPN7 Z 0 A_SetArg(3, 1)
		WPN7 Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		WPN7 Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",19,args[4],args[3])
		WPN7 Y 0 A_SetArg(3, 1)
		WPN7 Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgunDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCRailgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0 A_JumpIfInventory("QCRailgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor RailgunPickupNoGravity : RailgunPickup 15617
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Railgun (No Gravity)"
	+NOGRAVITY
}


Actor QCRailGun : QCWeapon
{
	Height 48
	+FLOORCLIP
	+INVENTORY.IGNORESKILL
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM	//rails never autoaim, but this needed for effects and sound spawners
	Weapon.SwaySpeed 2.7
	Weapon.AmmoType1 "QCSlugAmmo"
	Weapon.AmmoGive1 10
	Weapon.AmmoUse1 1
	Weapon.SelectionOrder 1400
	Inventory.PickupMessage "$GOT_QCRailGun"
	Tag "$TAG_QCRailGun"
	Obituary "$OB_QCRailGun"
	Decal "Q4RailgunGreenFull"
	Scale 0.63
	Weapon.KickBack 90
	States
	{
	Spawn:
		TNT1 A 1
		WPN7 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto SpawnIdle
	DMSpawn:
		WPN7 ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	SpawnIdle:
		WPN7 Y -1
		Wait
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken", 0, "Select.Zoomed")
		TNT1 A 0 A_JumpIfInventory("RG_UG_Explosive",1,"Select.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "Select.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "Select.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Select.Quake1")
	Select.Default:
		QCA7 A 0
		Goto SelectCont
	Select.Quake1:
		Q1A7 A 0
		Goto SelectCont
	Select.Quake2:
		Q2A7 A 0
		Goto SelectCont
	Select.Quake3:
		Q3A7 A 0
		Goto SelectCont
	Select.Quake4:
		Q4A7 A 0
		Goto SelectCont
	Select.ETQW:
		QWA7 A 0
		Goto SelectCont
	Select.QCDE1:
		Q0A7 A 0
		Goto SelectCont
	Select.HalfLife:
		HLA7 A 0
		Goto SelectCont
	Select.SeriousSam:
		SSA7 A 0
		Goto SelectCont
	Select.Modded:
		MDA7 A 0
		Goto SelectCont

	Select.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Select.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Select.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Select.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "Select.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "Select.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "Select.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "Select.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "Select.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Select.Upgraded.Quake1")
	Select.Upgraded.Default:
		QCG7 A 0
		Goto SelectCont
	Select.Upgraded.Quake1:
		Q1G7 A 0
		Goto SelectCont
	Select.Upgraded.Quake2:
		Q2G7 A 0
		Goto SelectCont
	Select.Upgraded.Quake3:
		Q3G7 A 0
		Goto SelectCont
	Select.Upgraded.Quake4:
		Q4G7 A 0
		Goto SelectCont
	Select.Upgraded.ETQW:
		QWG7 A 0
		Goto SelectCont
	Select.Upgraded.QCDE1:
		Q0G7 A 0
		Goto SelectCont
	Select.Upgraded.HalfLife:
		HLG7 A 0
		Goto SelectCont
	Select.Upgraded.SeriousSam:
		SSG7 A 0
		Goto SelectCont
	Select.Upgraded.Modded:
		MDG7 A 0
		Goto SelectCont

	Select.Zoomed:
		TNT1 A 0
		Goto SelectCont

	SelectCont:
		"####" "#" 0 A_JumpIfInventory("QCRailgunSkin", 20, "SelectSound.Modded")
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		Goto SelectSoundCont
	SelectSound.Modded:
		"####" A 0 A_PlaySound("QC/Weapons/Railgun/Select_Modded",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
	SelectSoundCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(CHAN_WEAPON) //idle sound
		"####" A 0 A_TakeInventory("RailgunCharges",32767)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_TakeInventory("RailgunCharges",52)
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
	Prepare:
		TNT1 A 0 A_JumpIfInventory("RG_UG_Explosive",1,"Prepare.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Prepare.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Prepare.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "Prepare.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "Prepare.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "Prepare.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "Prepare.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "Prepare.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Prepare.Quake1")
	Prepare.Default:
		QCA7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Quake1:
		Q1A7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Quake2:
		Q2A7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Quake2", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Quake3:
		Q3A7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Quake3", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Quake4:
		Q4A7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Quake4", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.ETQW:
		QWA7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_ETQW", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.QCDE1:
		Q0A7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.HalfLife:
		HLA7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_HalfLife", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.SeriousSam:
		SSA7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_SeriousSam", CHAN_WEAPON, 1.0, 1, 1.25)
		Goto PrepareCont
	Prepare.Modded:
		MDA7 A 0 A_PlaySound("QC/Weapons/Railgun/Prepare_Modded", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont

	Prepare.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Prepare.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Prepare.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Prepare.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "Prepare.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "Prepare.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "Prepare.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "Prepare.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "Prepare.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Prepare.Upgraded.Quake1")
	Prepare.Upgraded.Default:
		QCG7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Upgraded.Quake1:
		Q1G7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Upgraded.Quake2:
