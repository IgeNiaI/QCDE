			inInventory QCShotgunDM || QCSuperShotgunDM	 { inInventory QCShellAmmo	,  6 { drawNumber 3, QCFNT030, darkgrey, QCShellAmmo	, alignment(right), 1589,400; } else {drawNumber 3, QCFNT030, darkred, QCShellAmmo	, alignment(right), 1589,400; } }
		}}
		}
	}
	}
	}


