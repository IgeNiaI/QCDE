//------------------------------------------------------------------
// New ice chunks, ported from AEOD
Actor QCIceChunk replaces IceChunk
{
	Radius 3
	Height 4
	Mass 5
	Gravity 0.35
	+CORPSE
	+DROPOFF
	+CANNOTPUSH
	+FLOORCLIP
	+NOTELEPORT
	+NOBLOCKMAP
	+MOVEWITHSECTOR
	+CLIENTSIDEONLY
	+NONETID
	Scale 0.12
	RenderStyle Add
	Translation "0:255=%[0.57,0.6,0.84]:[0.9,0.9,0.9]"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetTranslucent(0.9,1)
		TNT1 A 35 A_Jump(256,"Type1","Type2","Type3")
		Goto Type1
	Type1:
		GIB7 ABCDEFG 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB7 HIJKLMNOP 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB7 QRSTUVWXYZ 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		Loop
	Type2:
		GIB8 ABCDEFG 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB8 HIJKLMNOP 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB8 QRSTUVWXYZ 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		Loop
	Type3:
		GIB9 ABCDEFG 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB9 HIJKLMNOP 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		GIB9 QRSTUVWXYZ 1
		"####" "#" 0 A_JumpIf(waterlevel==3,"Staph")
		Loop
	Crash:
		"####" "#" 3 A_FadeOut(0.02)
		Loop
	Staph:
		"####" "#" 0 A_Jump(200,3,4,5,6)
		"####" "########" 15
		Goto Crash
	}
}
