//================================================================
//================================================================

Actor QShambler : QCDE_MonsterBig	15114	//baron
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	var int user_count;
	Health 1100
	Radius 24
	Height 64
	Mass 1500
	Speed 14
	MeleeDamage 12
	Scale 0.58
	PainChance 20 //same as doom2's archvile
	Monster
	+MISSILEMORE
	+FLOORCLIP
	+DONTMORPH
	Tag "$TAG_QShambler" // "Shambler"
	SeeSound "Quake1/Shambler/Sight"
	PainSound "Quake1/Shambler/Pain"
	DeathSound "Quake1/Shambler/Death"
	ActiveSound "Quake1/Shambler/Idle"
	MeleeSound "Quake1/Shambler/SmackTear"
	HitObituary "$OBH_QShambler" // "%o was smashed by a shambler."
	Obituary "$OB_QShambler" // "%o couldn't avoid the shambler's lightning."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q37I A 10 A_Look
		Loop
	See:
		Q37R A 3 A_Chase		Q37R A 2 A_Chase
		Q37R B 3 A_Chase		Q37R B 2 A_Chase
		Q37R C 3 A_Chase		Q37R C 2 A_Chase
		Q37R D 3 A_Chase		Q37R D 2 A_Chase
		Q37R E 3 A_Chase		Q37R E 2 A_Chase
		Q37R F 3 A_Chase		Q37R F 2 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_PlaySound("Quake1/Shambler/ChargeElect",6)
		Q37A ABBBBC 4 Bright A_FaceTarget
		TNT1 A 0 A_PlaySound("Quake1/Shambler/ShootElect",5)
		TNT1 A 0 A_SetUserVar("user_count",0)
		TNT1 A 0 A_JumpIfCloser(768,"LightningLooper")
		Goto LightningMissile

		LightningMissile:
			Q37A D 5 A_CustomMissile("ShamblerProjectile",32,7,0)
			Goto See

		LightningLooper:
			TNT1 A 0 A_JumpIf(user_count>=7,"EndLoop")
			TNT1 A 0 A_FaceTarget
			Q37A D 6 A_CustomRailgun(random(6,13),0,"None","OliveDrab1",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT,1,50,None,0,0,768,3,28,0,"ShamblerLgTrail",6)
			TNT1 A 0 A_SetUserVar("user_count",user_count+1)
			Loop
		EndLoop:
			Q37A D 2
			Goto See

	Melee:
		TNT1 A 0 A_PlaySound("Quake1/Shambler/MeleeGrunt",7)
		TNT1 A 0 A_Jump(190,"RightArm")
	BothArms:
		Q37M ABC 5 A_FaceTarget
		Q37M D 5 A_CustomMeleeAttack(random(100,200),"Quake1/Shambler/SmackTear")
		Q37M EF 7
		Goto See
	RightArm:
		TNT1 A 0 A_JumpIfInventory("MeleeSideToken",1,"LeftArm")	//to switch arms betwen attacks
		TNT1 A 0 A_GiveInventory("MeleeSideToken",1)		TNT1 A 0 A_Recoil(-1.4)
		Q37N A 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N B 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N C 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N D 5 A_MeleeAttack			TNT1 A 0 A_Recoil(-1.4)
		Q37N E 5 A_FaceTarget
		Goto See
	LeftArm:
		TNT1 A 0 A_TakeInventory("MeleeSideToken",1)		TNT1 A 0 A_Recoil(-1.4)
		Q37N F 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N G 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N H 5 A_FaceTarget			TNT1 A 0 A_Recoil(-1.4)
		Q37N I 5 A_MeleeAttack			TNT1 A 0 A_Recoil(-1.4)
		Q37N J 5 A_FaceTarget
		Goto See
	Pain:
		Q37P A 2
		Q37P A 2 A_Pain
		Goto See

	DeathChecksDone:
		Q37D A 0 A_Scream
		Q37D A 4
		Q37D B 4 A_Fall
		Q37D CDEF 4
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
	Death.Corpse:
		Q37D G -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMediumBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q37D FEDCBA 5
		Goto See

	}
}

Actor MeleeSideToken : Inventory
{Inventory.MaxAmount 1}

Actor ShamblerLgTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	Scale 0.24
	RenderStyle Add
	Alpha 1.0
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.7]"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"S1","S2","S3","S4","S5","S6","S7","S8")
	S1:	HSPL A 0 A_Jump(256,"Perform")
		Goto Perform
	S2:	HSPL B 0 A_Jump(256,"Perform")
		Goto Perform
	S3:	HSPL C 0 A_Jump(256,"Perform")
		Goto Perform
	S4:	HSPL D 0 A_Jump(256,"Perform")
		Goto Perform
	S5:	HSPL E 0 A_Jump(256,"Perform")
		Goto Perform
	S6:	HSPL F 0 A_Jump(256,"Perform")
		Goto Perform
	S7:	HSPL G 0 A_Jump(256,"Perform")
		Goto Perform
	S8: HSPL H 0 A_Jump(256,"Perform")
		Goto Perform
	S8: HSPL J 0 A_Jump(256,"Perform")
		Goto Perform
	Perform:
		"####" "#" 5 Bright
		"####" "#" 1 Bright A_FadeOut(0.2)
		Wait
	}
}

Actor ShamblerProjectile
{
	Projectile
	Speed 25
	Radius 6
	Height 12
	Damage 12
	RenderStyle Add
	+FORCEXYBILLBOARD
	+BRIGHT
	Scale 0.65
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.7]"
	States
	{
	Spawn:
		X024 ABCDEFGHIJK 2 Bright A_SpawnItemEx("ShamblerLightningParticle",0,0,0,0,frandom(2,-2),frandom(1,-1),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION,64)
		Loop
	Death:
		TNT1 AA 0 A_SpawnItemEx("ShamblerLightningSparks",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
		TXP1 A 0 A_SetScale(0.3)
	DeathLooper:
		TXP1 A 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 A 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 B 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 C 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 C 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 D 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		TXP1 D 1 A_SetScale(scalex*1.1)	"####" "#" 0 A_FadeOut(0.065)
		Loop
	}
}

Actor ShamblerLightningSparks : WaterLightningSparks
{
	Translation "0:0=0:0"
	Scale 0.65
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(200,2,3,4,5,6,7,8)	//for sliiiigh randomization of when it spawns
		TNT1 AAAAAAAAAA 1
		Goto Decider
	}
}
Actor ShamblerLightningParticle : EnforcerBeamExtra
{
	Scale 0.7
}
