// ----------------------------------------------------------------------------
//
// Brock's abilities
//
// Active:	Translocator
//
// Passive: Huge ego
//          Receive more health from healing bubbles (except small ones)
//
// ----------------------------------------------------------------------------

Actor CompatVer31_Brock {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor BrockTranslocator : QCWeapon
{
	Weapon.Kickback 0
	Weapon.SelectionOrder 2000
	Obituary "$OB_BrockTranslocator" // "%o was given ''acute lead poisoning'' by %k."
	Tag "$TAG_BrockTranslocator" // "Translocator"
	+INVENTORY.UNDROPPABLE
	+WEAPON.CHEATNOTWEAPON
	+WEAPON.NOAUTOAIM
	Weapon.AmmoUse 0
	Weapon.AmmoGive 5
	Weapon.AmmoType "TrLocatorAmmo"
	States
	{
	Spawn:
		TNT1 A 0
		Stop
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_TranslocatorExists"), "ReadyNoModule")
		TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "ReadyNoAmmo")
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		QP33 R 3 A_WeaponReady(WRF_NOSECONDARY)
		QP33 S 3 A_WeaponReady(WRF_NOSECONDARY)
		QP33 T 3 A_WeaponReady(WRF_NOSECONDARY)
		QP33 U 3 A_WeaponReady(WRF_NOSECONDARY)
		Loop

		ReadyNoAmmo:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
		RCFLooperNoAmmo1:
			QP33 V 3 A_WeaponReady
			TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "RCFLooperNoAmmo2")
			TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Return",CHAN_WEAPON)
			Goto Ready
		RCFLooperNoAmmo2:
			QP33 W 3 A_WeaponReady
			TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "RCFLooperNoAmmo3")
			TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Return",CHAN_WEAPON)
			Goto Ready
		RCFLooperNoAmmo3:
			QP33 X 3 A_WeaponReady
			TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "RCFLooperNoAmmo4")
			TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Return",CHAN_WEAPON)
			Goto Ready
		RCFLooperNoAmmo4:
			QP33 Y 3 A_WeaponReady
			TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "RCFLooperNoAmmo1")
			TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Return",CHAN_WEAPON)
			Goto Ready

		ReadyCantFire:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			QP33 RSTU 3 A_WeaponReady(WRF_NOFIRE)
			TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	ReadyNoModule:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFireNoModule")
		QP33 V 3 A_WeaponReady
		QP33 W 3 A_WeaponReady
		QP33 X 3 A_WeaponReady
		QP33 Y 3 A_WeaponReady
		Loop

		ReadyCantFireNoModule:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
		RCFLooperNoModule:
			QP33 VWXY 3 A_WeaponReady(WRF_NOFIRE)
			TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooperNoModule")
			Goto Ready
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		TNT1 A 0 A_TakeInventory("WeaponZoomedToken")
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "SelectLooperNoAmmo") // Using this instead of A_JumpIfNoAmmo so that it works when ammo is infinite
	SelectLooper:
		QP33 R 1 A_Raise
		TNT1 AAA 0 A_Raise
		Loop
	SelectLooperNoAmmo:
		QP33 V 1 A_Raise
		TNT1 AAA 0 A_Raise
		Loop

	Deselect:
		TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "DeselectLooperNoAmmo") // Using this instead of A_JumpIfNoAmmo so that it works when ammo is infinite
	DeselectLooper:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		QP33 R 1 A_Lower
		TNT1 AAA 0 A_Lower
		Loop
	DeselectLooperNoAmmo:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		QP33 V 1 A_Lower
		TNT1 AAA 0 A_Lower
		Loop

	//-------------------------------------------------------
	// Launch translocator module or retrieve it if launched
	//-------------------------------------------------------
	Fire:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_TranslocatorExists"), "ReturnModule")

	LaunchModule:
		TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "Ready") // Using this instead of A_JumpIfNoAmmo so that it works when ammo is infinite
		TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Fire",CHAN_WEAPON)
		TNT1 A 0 A_FireCustomMissile ("TranslocatorModule",0, false, 0, 0, FPF_NOUNLAGGED|FPF_SKIPOWNER)
		QP33 V 1 Offset(2,34)
		QP33 V 1 Offset(9,41)
		QP33 V 1 Offset(9,41)
		QP33 W 1 Offset(9,41)
		QP33 W 1 Offset(9,41)
		QP33 W 1 Offset(9,41)
		QP33 X 1 Offset(7,39)
		QP33 X 1 Offset(5,37)
		QP33 X 1 Offset(3,35)
		QP33 Y 1 Offset(2,34)
		QP33 Y 1 Offset(1,33)
		QP33 Y 1 Offset(0,32)
		TNT1 A 0 A_Refire("LaunchHoldFire1")
		Goto ReadyNoModule

	LaunchHoldFire1:
		QP33 V 3
		TNT1 A 0 A_Refire("LaunchHoldFire2")
		Goto ReadyNoModule
	LaunchHoldFire2:
		QP33 W 3
		TNT1 A 0 A_Refire("LaunchHoldFire3")
		Goto ReadyNoModule
	LaunchHoldFire3:
		QP33 X 3
		TNT1 A 0 A_Refire("LaunchHoldFire4")
		Goto ReadyNoModule
	LaunchHoldFire4:
		QP33 Y 3
		TNT1 A 0 A_Refire("LaunchHoldFire1")
		Goto ReadyNoModule

	ReturnModule:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_RemoveTranslocator")
		TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Return",CHAN_WEAPON)
		QP33 R 1 Offset(2,34)
		QP33 R 1 Offset(9,41)
		QP33 R 1 Offset(9,41)
		QP33 S 1 Offset(9,41)
		QP33 S 1 Offset(9,41)
		QP33 S 1 Offset(9,41)
		QP33 T 1 Offset(7,39)
		QP33 T 1 Offset(5,37)
		QP33 T 1 Offset(3,35)
		QP33 U 1 Offset(2,34)
		QP33 U 1 Offset(1,33)
		QP33 U 1 Offset(0,32)
		TNT1 A 0 A_Refire("ReturnHoldFire1")
		Goto Ready

	ReturnHoldFire1:
		QP33 R 3
		TNT1 A 0 A_Refire("ReturnHoldFire2")
		Goto Ready
	ReturnHoldFire2:
		QP33 S 3
		TNT1 A 0 A_Refire("ReturnHoldFire3")
		Goto Ready
	ReturnHoldFire3:
		QP33 T 3
		TNT1 A 0 A_Refire("ReturnHoldFire4")
		Goto Ready
	ReturnHoldFire4:
		QP33 U 3
		TNT1 A 0 A_Refire("ReturnHoldFire1")
		Goto Ready

	//-------------------------------------------------------
	// Teleport to translocator module
	//-------------------------------------------------------
	AltFire:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_TranslocatorExists"), "TeleportToModule")
		Goto Ready

	TeleportToModule:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_TranslocatorUsed")
		TNT1 A 0 A_JumpIfInventory("TrLocatorAmmo", -1, "RCFLooperNoAmmo1")
		Goto Ready
	}
}

Actor TranslocatorModule : TeleportDest3
{
	Projectile
	-NOBLOCKMAP
	+DONTSPLASH
	-NOSECTOR
	-NOGRAVITY
	+USEBOUNCESTATE
	+BOUNCEONACTORS
	+SHOOTABLE +CANPASS
	+SKYEXPLODE
	+ISMONSTER +NOBLOCKMONST -COUNTKILL
	-CANBLAST +NOBLOOD
	+NOICEDEATH	//to prevent possibly weird behaviour of scripts
	+FRIENDLY
	+THRUSPECIES
	Radius 18
	Height 10
	Speed 25
	Scale 0.75
	Alpha 0.7
	Damage 0
	Gravity 0.5
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Health 10000
	WoundHealth 10000
	States
	{
	Spawn:
		TNT1 A 0 NODELAY ACS_NamedExecuteAlways("QCDE_TranslocatorThrown")
		TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Module_Loop", CHAN_BODY, 1.0, true, 2.0)
		Goto LoopFlying

	Bounce:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_TranslocatorFixIdIfNeeded")
		TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Bounce",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_JumpIfHealthLower(10000, "LoopFlyingBroken")
		Goto LoopFlying
	Death:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_TranslocatorFixIdIfNeeded")
		TNT1 A 0 A_JumpIfHealthLower(1, "Disappear") // Exploded by touching the owner while flying
		Goto TurnStationary // Bouncing complete
	Wound:
		TNT1 A 0
		Goto TurnBroken

	Disappear:
		TNT1 A 0
		Stop

	TurnStationary:
		TNT1 A 0 A_JumpIfHealthLower(10000, "LoopStationaryBroken")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1) // The engine resets it, but we need it ON
		Goto LoopStationary

	TurnBroken:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_PlaySound("QC/Abilities/Brock/Module_Broken_Loop", CHAN_BODY, 0.75, true, 2.0)
		TNT1 A 0 A_JumpIf(velx==0&&vely==0, "LoopStationaryBroken")
		Goto LoopFlyingBroken

	LoopFlying:
		TRMD AAAABBBBCCCCDDDD 1 Light("OrangeSmallPoint1")
		Loop

	LoopStationary:
		TRMD AAAA 2 Light("OrangeSmallPoint1")
		TNT1 A 0 A_SpawnItemEx("TranslocatorModuleLight",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Loop

	LoopFlyingBroken:
		TRMD AAAABBBB 1 Light("OrangeSmallPoint1")
		TNT1 A 0 A_SpawnItemEx("TranslocatorModuleSparks",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED,190)
		TRMD CCCCDDDD 1 Light("OrangeSmallPoint1")
		TNT1 A 0 A_SpawnItemEx("TranslocatorModuleSparks",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED,190)
		Loop

	LoopStationaryBroken:
		TRMD AAAAAAAA 1 Light("OrangeSmallPoint1")
		TNT1 A 0 A_SpawnItemEx("TranslocatorModuleSparks",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED,190)
		Loop
	}
}

Actor TranslocatorTeleProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("White", 1.0, 5)
		TNT1 A 0 A_SetBlend("Black", 0.7, 30)
		TNT1 A 0 A_SpawnItemEx("DireOrbTeleFog",0,0,30, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Stop
	}
}

Actor TranslocatorTeleFogOutProc : CustomInventory
{
	+NONETID
	States
	{
	Pickup:
		TNT1 A 0 A_SpawnItemEx("TranslocatorTeleFogOut",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		TNT1 A 0 A_AlertMonsters(512)
		Stop
	}
}

//Fog for destination, plays teleport sound
Actor TranslocatorTeleFogOut : DireOrbTeleFog
{
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Abilities/Brock/Teleport",CHAN_BODY)
		goto Super::Spawn
	}
}

Actor TranslocatorModuleLight
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEYBILLBOARD
	RenderStyle Add
	Alpha 0
	scale 0.25
	States
	{
	Spawn:
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)
		TRMD E 1 A_FadeIn(0.1)

		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)
		TRMD E 1 A_FadeOut(0.1)

		Stop
	}
}

Actor TranslocatorModuleSparks
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	-FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.99
	scale 0.2
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.3]"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"T1","T3","T4")
	T1:	DLI1 A 0
		Goto PlayOff
	T3:	DLI3 A 0
		Goto PlayOff
	T4:	DLI4 A 0
		Goto PlayOff

	PlayOff:
		"####" A 0 A_Jump(128,"FromL")
	FromA:
		"####" ABCDEFGHIJK 1 Bright
		Stop
	FromL:
		"####" LMNOPQRSTUV 1 Bright
		Stop
	}
}

//======================================================================
Actor TrLocatorAmmo : Ammo
{
	+FLOORCLIP
	-TELESTOMP
	+SERVERNETID
	Radius 20
	Height 16
	Inventory.PickupMessage "$GOT_TrLocatorAmmo" // "You shouldn't be reading this"
	Inventory.Amount 3
	Inventory.MaxAmount 3
	Ammo.BackpackMaxAmount 3
	Ammo.BackpackAmount 0
	Scale 0.1
	States
	{
	Spawn:
		QP33 A -1
		Stop
	}
}