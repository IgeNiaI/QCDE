
//===========================================================================
//===========================================================================

// Not bigger, but meaner version of the tank

//===========================================================================
//===========================================================================
Actor Q2TankCommander : QCDE_MonsterBig	15221	// archvile
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 1200
	Radius 20
	Height 64	//2017 DBT note: size mismatch, let's hope it doesnt get stuck often
	Scale 0.564
	Speed 10
	PainChance 18
	Mass 9000
	MONSTER
	+FLOORCLIP
	+MISSILEMORE
	+MISSILEEVENMORE
	+NOBLOOD
	SeeSound "q2tank/sight"
	PainSound "q2tank/pain"
	DeathSound "q2tank/death"
	ActiveSound "q2tank/idle"
	AttackSound "q2weapon/machinegun"
	Tag "$TAG_Q2TankCommander" // "Tank Commander"
	Obituary "$OB_Q2TankCommander" // "%o was put in %p place by a tank commander."
	DropItem "Hourglass", 48

	States
	{
	Idle:
		Q2T1 AA 5 A_Look
		Loop

	See:
		TNT1 A 0 A_PlaySound("q2tank/step")
		Q2T1 B 5
		Q2T1 CDEF 5 A_Chase
		TNT1 A 0 A_PlaySound("q2tank/step")
		Q2T1 G 5
		Q2T1 HIJ 5 A_Chase
		Loop


	Missile:
		TNT1 A 0 A_Jump(255,"Machinegun","Rocket","Blaster")

		Blaster:
			Q2T1 KKLL 5 A_FaceTarget
		BlasterLoop:
			TNT1 A 0 A_PlaySound("q2hover/blasterattack", 6, 1.0, 0)
			Q2T1 M 4 Bright A_CustomMissile("TankCommanderBlaster", 42, -15, 0, 1)
			Q2T1 L 5 A_FaceTarget
			TNT1 A 0 A_CPosRefire
			Goto BlasterLoop
		Rocket:
			Q2T1 A 0 A_ChangeFlag(NOPAIN,1)	//cant be interrupted
			Q2T1 NOPQRS 6 A_FaceTarget
			Q2T1 A 0 A_PlaySound("q2tank/mechsound1")
			Q2T1 TUV 6 A_FaceTarget
		RocketLoop:
			Q2T1 W 6 A_FaceTarget	Q2T1 X 6 Bright A_CustomMissile("TankCommanderRocket", 70, 25, 0)
			Q2T1 W 6 A_FaceTarget	Q2T1 X 6 Bright A_CustomMissile("TankCommanderRocket", 70, 20, 0)
			Q2T1 W 6 A_FaceTarget	Q2T1 X 6 Bright A_CustomMissile("TankCommanderRocket", 70, 15, 0)
			TNT1 A 0 A_Jump(67,"EndMissileLoop")
		    TNT1 A 0 A_JumpIfTargetInLOS("RocketLoop")
		EndMissileLoop:
			Q2T1 VUT 6
			Q2T1 A 0 A_PlaySound("q2tank/mechsound1")
			Q2T1 SRQPON 6
			Q2T1 A 0 A_ChangeFlag(NOPAIN,0)
			Goto See
		Machinegun:
			Q2T1 ZZ 4 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/SuperNailgunFire",6,0.5)
			TNT1 A 0 A_PlaySound("q2weapon/machinegun",5,1)
            Q2T2 A 3 A_CustomBulletAttack( 20+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
            Q2T2 A 4 A_CustomBulletAttack( 10+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 A 3 A_CustomBulletAttack(  0+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 B 4 A_CustomBulletAttack( -5+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 B 3 A_CustomBulletAttack(-10+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 4 A_CustomBulletAttack(-20+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 3 A_CustomBulletAttack(-30+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 D 4 A_CustomBulletAttack(-50+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 D 3 A_CustomBulletAttack(-60+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 E 4 A_CustomBulletAttack(-80+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 E 3 A_CustomBulletAttack(-70+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 D 4 A_CustomBulletAttack(-60+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
	        Q2T2 D 3 A_CustomBulletAttack(-50+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 4 A_CustomBulletAttack(-30+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 3 A_CustomBulletAttack(-20+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 B 4 A_CustomBulletAttack(-10+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
			Q2T2 B 3 A_CustomBulletAttack( -5+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 A 4 A_CustomBulletAttack(  0+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
	        Q2T2 A 3 A_CustomBulletAttack( 10+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 A 4 A_CustomBulletAttack( 20+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
			Q2T2 B 4 A_CustomBulletAttack( -5+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 B 3 A_CustomBulletAttack(-10+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 4 A_CustomBulletAttack(-20+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 C 3 A_CustomBulletAttack(-30+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 D 4 A_CustomBulletAttack(-50+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 D 3 A_CustomBulletAttack(-60+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 E 4 A_CustomBulletAttack(-80+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
		    Q2T2 E 3 A_CustomBulletAttack(-70+Random2(5),Random2(5),1,6,"BulletPuff",2048,CBAF_EXPLICITANGLE|CBAF_AIMFACING)
			Q2T2 FGH 4
			Goto See

	Pain:
		Q2T2 I 3
		Q2T2 J 7 A_Pain
		Q2T2 I 8
		Goto See

	DeathChecksDone:
		Q2T2 A 0 A_Scream
		TNT1 AAA 0 A_TossGib
		Q2T2 OPQRSTUVWX 6
		Q2T2 Y 6 A_PlaySound("quake4/Misc/Body/Metal")
		TNT1 AA 0 A_TossGib
		TNT1 A 0 A_Fall
	Death.Corpse:
		Q2T2 Z -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 AAAAAAA 0 A_TossGib
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q2T2 A 0 A_ChangeFlag(NOPAIN,0)
		Q2T2 XWVUTPO 6
		Goto See
	}
}

Actor TankCommanderBlaster : MedicBlasterStrong
{
	Speed 20
	Damage 6
}

Actor TankCommanderRocket : OgreRocket
{
	Speed 20
	Damage (60)	//total damage with explo is 120
	SeeSound "q2weapon/rocketlauncherfire"
	DeathSound "q2weapon/rocketexplo"
}