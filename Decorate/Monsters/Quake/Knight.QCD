
//================================================================
//================================================================

Actor QKnight : QCDE_MonsterSmall	15107	//demon
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 150
	Radius 20
	Height 56
	Speed 8
	PainChance 50
	Mass 200
	Monster
	+FLOORCLIP
	Scale 0.45
	Tag "$TAG_QKnight" // "Knight"
	SeeSound "Quake1/Knight/Sight"
	PainSound "Quake1/Knight/Pain"
	DeathSound "Quake1/Knight/Death"
	ActiveSound "Quake1/Knight/Idle"
	HitObituary "$OBH_QKnight" // "%o was slashed by a knight."
	MeleeDamage 2
	States
	{
	Idle:
		Q34I A 10 A_Look
		Loop
	See:
		Q34W AABBCCDDEEFF 2 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_Recoil(-1.8)
		Q34A A 4 A_FaceTarget		TNT1 A 0 A_Recoil(-1.8)
		Q34A B 4 A_FaceTarget		TNT1 A 0 A_Recoil(-1.8)
		Q34A C 4 A_FaceTarget		TNT1 A 0 A_PlaySound("Quake1/Knight/Swing")
		TNT1 A 0 A_Recoil(-1.8)		TNT1 A 0 A_FaceTarget
		Q34A D 4 A_MeleeAttack
		TNT1 A 0 A_Recoil(-1.8)		TNT1 A 0 A_FaceTarget
		Q34A E 4 A_MeleeAttack
		TNT1 A 0 A_Recoil(-1.8)		TNT1 A 0 A_FaceTarget
		Q34A F 4 A_MeleeAttack		TNT1 A 0 A_Recoil(-1.8)
		Q34A G 4 A_FaceTarget		TNT1 A 0 A_Recoil(-1.8)
		Q34A H 4 A_FaceTarget
		Goto See
	Pain:
		Q34P A 4
		Q34P A 4 A_Pain
		Goto See

	DeathChecksDone:
		TNT1 A 0 A_Scream
		Q34D A 4
		Q34D B 4 A_Fall
		Q34D CDEFG 3
		Q34D G 0 A_PlaySound("quake4/Misc/Body/Small")
		Q34D HI 3
	Death.Corpse:
		Q34D J -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q34D IHGFEDCBA 5
		Goto See
	}
}
