		Anchor	right, center		BackgroundValues	QCDE_CheckBG
		MouseArea	105, 14			UnknownBackground	CHKBOX
									SelectedForeground	CHKBOXS, 14, 14
	}


	SubMenu {
		Pos		-50, 100			Text				"Custom themes"	Background			BV21028
		Size	105, 14				Font				SmallFont		SelectedBackground	BV21028S
		Anchor	center, center		FontColor			Tan				Menu				QCDE_CustomThemes
		Padding	0, 0				SelectedFontColor	Tan
	}


	Label {
		Pos		0, 130				Font		QCSMFONT
		Anchor	center, center		FontColor	Gold
		Text	"Misc"
	}

	Label {
		Pos		60, 143				Font		SmallFont
		Anchor	left, top			FontColor	DarkGray
		Text	"Level change effect"
	}
	Option {
		Pos		60, 160				CVar				wipetype		UnknownBackground	OP21028
		Size	105, 14				Values				Wipes			SelectedBackground	OP21028S
		Anchor	left, center		Font				SmallFont		SelectedForeground	OP21028A, 119, 14
		Padding	3, 1				SelectedFontColor	Gray
	}


	InsertFreeformMenu MainMenuTopBar
	InsertFreeformMenu QCDE_OptionsTabs
}

OptionMenu VideoModeMenu	//had to overwrite, because redefine broke the list of resolutions
{
	Indent 153
	Title "CHOOSE RESOLUTION"

	Option		"Aspect ratio",					"menu_screenratios",	"Ratios"

	StaticText ""

	ScreenResolution "res_0", 250
	ScreenResolution "res_1", 250
	ScreenResolution "res_2", 250
	ScreenResolution "res_3", 250
	ScreenResolution "res_4", 250
	ScreenResolution "res_5", 250
	ScreenResolution "res_6", 250
	ScreenResolution "res_7", 250
	ScreenResolution "res_8", 250
	ScreenResolution "res_9", 250
	StaticTextSwitchable "Press ENTER to set mode", "", "VMEnterText"
	StaticText ""
	StaticTextSwitchable "T to test mode for 5 seconds", "Please wait 5 seconds...", "VMTestText"

	class VideoModeMenu
}

