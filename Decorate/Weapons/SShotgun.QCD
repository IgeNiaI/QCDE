			TNT1 A 0 A_FireBullets(sin(144)*5.5,cos(144)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(180)*2.1,cos(180)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*3.4,cos(180)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*5.5,cos(180)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(216)*2.1,cos(216)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*3.4,cos(216)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*5.5,cos(216)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(252)*2.1,cos(252)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*3.4,cos(252)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*5.5,cos(252)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(282)*2.1,cos(282)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(282)*3.4,cos(282)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(282)*5.5,cos(282)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(324)*2.1,cos(324)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*3.4,cos(324)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*5.5,cos(324)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracerSSG_Modded",frandom(5.5,-5.5),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5.5,-5.5))
			Goto FlashCheckSound

		FlashCheckSound:
			TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
			TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
			Goto NormalSound

			NormalSound:
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "NormalSound.Modded")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "NormalSound.SeriousSam")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "NormalSound.HalfLife")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "NormalSound.Default")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "NormalSound.ETQW")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "NormalSound.Quake4")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "NormalSound.Quake3")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "NormalSound.Quake2")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "NormalSound.Quake1")
			NormalSound.Default:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Default",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake1:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake1",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake2:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake2",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake3:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake3",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Quake4:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake4",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.ETQW:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_ETQW",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.HalfLife:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_HalfLife",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.SeriousSam:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_SeriousSam",CHAN_WEAPON)
				Goto FlashEnder
			NormalSound.Modded:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Modded",CHAN_WEAPON)
				Goto FlashEnder

			QuadSound:
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "QuadSound.Modded")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "QuadSound.SeriousSam")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "QuadSound.HalfLife")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "QuadSound.Default")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "QuadSound.ETQW")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "QuadSound.Quake4")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "QuadSound.Quake3")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "QuadSound.Quake2")
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "QuadSound.Quake1")
			QuadSound.Default:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Default",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake1:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Quake1",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake2:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Quake2",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake3:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Quake3",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.Quake4:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_Quake4",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.ETQW:
				TNT1 A 0 A_PlaySound("QC/Weapons/SuperShotgun/Quad/Fire_ETQW",CHAN_WEAPON)
				Goto FlashEnder
			QuadSound.HalfLife:
