//===========================================================================
//===========================================================================

Actor Q2ShotgunGuard : Q2LightGuard	15218	// shotgun guy
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 40
	Tag "$TAG_Q2ShotgunGuard" // "Shotgun Guard"
	Translation "16:47=152:159", "160:191=153:159", "208:223=154:159", "232:235=155:159", "248:248=159:159"
	Obituary "$OB_Q2ShotgunGuard" // "%o got too close to a shotgun guard."
	DropItem "Shotgun"
	States
	{
	Missile:
		Q2SA ABC 4 A_FaceTarget
		TNT1 A 0 A_SpawnItemEx("MonMuzzleFlashSmall",12,8,35,0,0,0,0,32)
		TNT1 AAA 0 A_CustomMissile("MonsterTracerLowVol",36,8,frandom(5,-5))
		Q2SA D 4 Bright A_CustomBulletAttack(12,6,6,3,"BulletPuff")
		Q2SA E 5 A_PlaySound("q2soldier/shotgunload")
		Q2SA BCE 4
		Goto See
	DeathChecksDone:	//duplicated to remove the spawning of zombie-custom ammo
		Q2SD A 0 A_Scream
		Q2SD A 4
		Q2SD BCDEF 3
		Q2SD G 4 A_Fall
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Small")
		Q2SD HI 4
	Death.Corpse:
		Q2SD J -1
		Stop
	XDeathChecksDone:	//duplicated to remove the spawning of zombie-custom ammo
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	}
}
