	Idle:
		TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"Idle.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Idle.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Idle.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Idle.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Idle.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Idle.Quake4") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 4, "Idle.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 3, "Idle.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 2, "Idle.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 1, "Idle.Quake1")
	Idle.Default:
		QCCE A 0
		Goto IdleCont
	Idle.Quake1:
		Q1CE A 0
		Goto IdleCont
	Idle.Quake2:
		Q2CE A 0
		Goto IdleCont
	Idle.Quake3:
		Q3CE A 0
		Goto IdleCont
	Idle.Quake4:
		Q4CE A 0
		Goto IdleCont
	Idle.QCDE1:
