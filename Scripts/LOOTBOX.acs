// Fully upgrade weapon
script "鳞~Loot🅱ox2_7" (void)
{
	SetResultValue("");

	int weapon = random(0,21) | 1;
	if(weapon == 1 || weapon == 5) weapon = 0;

	// Giving a fully loaded weapon that player didn't have is more beneficial,
	// so it happens more rarely. Also, BFG is never given, only upgraded.
	if (!CheckInventory(WeaponList[weapon])) weapon = random(7,19) | 1;

	if (!CheckInventory(WeaponUpgrades[weapon][0][WU_TOKEN]) &&
		!CheckInventory(WeaponUpgrades[weapon][1][WU_TOKEN]))
	{
		str gfx = WeaponUpgrades[weapon][0][WU_WEAPONFULL];
		str result = strparam(s:gfx, s:":Full Weapon Upgrade");
		GiveInventory(WeaponUpgrades[weapon][0][WU_TOKEN],1);
		GiveInventory(WeaponUpgrades[weapon][1][WU_TOKEN],1);
		GiveInventory(WeaponList[weapon],1);
		GiveInventory(strparam(s:"Refill", s:WeaponList[weapon]),1);
		SetWeapon(WeaponList[weapon]);
		SetResultValue(result);
	}
}

