//Rocket Rain random

Actor RocketRainUpwardsRandom	//just visual effect
{
	Projectile
	Speed 0
	Radius 3
	Height 8
	+THRUACTORS
	+SKYEXPLODE
	Scale 0.48
	RenderStyle None
	States
	{
	Spawn:
		MICR B 0 NODELAY A_PlaySound("Doom4/Monsters/CybDemShootSwarm",5,1.0,false,0.95)
		MICR B 50 Bright
		Goto Death
	Death:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
