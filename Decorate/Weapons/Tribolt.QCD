		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Fire.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Fire.Upgraded.HalfLife")
