	inInventory Class_Brock			{ drawImage "PORTRX33",		10,795; }
	// ^ insert more classes here

	// Number of lives
	inInventory LifeToken
	{
		IfProperty lives 2 {
			drawString QCFNT100, brite, "x", 127,935, 0, alignment(right);
			drawnumber 2, QCFNT100, brite, lives,   alignment( left), 127,925;
		}
		else
		{
			drawString BIGFONT, bludi, "LAST LIFE", 120,937, 0, alignment(center);
		}
	}
	}

	inInventory not NoVitals {
	// CSMA
	inInventory Resurrected
	{
		drawString BIGFONT, white, "resurrected", 240,825, 0, alignment(left);

		// Health
		drawImage "ICONHLTH", 206,879;
		drawImage "BARF0",                              245,890;
		drawBar   "BARF1", "BARS_", Health, horizontal, 245,890;
		drawnumber 5, QCFNT070, white, Health,   alignment(right), 325,846;

		// Armor
		drawImage "ICONSHLD", 182,958;
		drawImage "BARF0",                              221,969;
		drawbar   "BARF1", "BARS_", Armor,  horizontal, 221,969;
		drawnumber 5, QCFNT070, white, Armor,    alignment(right), 291,924;
	}
	else
	{
		// Health
		drawImage "ICONHLTH", 206,879;
		inInventory not FlatHealthToken || FlatHealthPref {
			drawBar "BARS0", "BARS_",     MaxHealthBar, horizontal, 245,890;
			drawBar "BARS2", "BARS_",   SuperHealthBar, horizontal, 245,890;
			drawBar "BARS1", "BARS_", CurrentHealthBar, horizontal, 245,890;
			inInventory NoHealthDegenerationToken {
			drawBar "BARS8", "BARS_",   SuperHealthBar, horizontal, 245,890;
			}
		} else {
			drawBar "BARF0", "BARS_",     MaxHealthBar, horizontal, 245,890;
			drawBar "BARF2", "BARS_",   SuperHealthBar, horizontal, 245,890;
			drawBar "BARF1", "BARS_", CurrentHealthBar, horizontal, 245,890;
			inInventory NoHealthDegenerationToken {
			drawBar "BARF8", "BARS_",   SuperHealthBar, horizontal, 245,890;
			}
		}
		inInventory not PowerEldersSoul {
			drawnumber 5, QCFNT070, white,   SuperHealthToken,alignment(right), 325,846;
			drawString    QCFNT060, white, "/",                                    328,856, 0, alignment(left);
			drawnumber 5, QCFNT040, white,     MaxHealthToken,   alignment(left),  342,863;
		} else {
			drawnumber 5, QCFNT070, bludi,   SuperHealthToken,alignment(right), 325,846;
			drawString    QCFNT060, bludi, "/",                                    328,856, 0, alignment(left);
			drawnumber 5, QCFNT040, bludi,     MaxHealthToken,   alignment(left),  342,863;
		}

		// Armor
		drawImage "ICONSHLD", 182,958;
		inInventory not FlatArmorToken || FlatArmorPref {
			drawBar "BARS0", "BARS_",     MaxArmorBar,  horizontal, 221,969;
			drawBar "BARS3", "BARS_",   SuperArmorBar,  horizontal, 221,969;
			drawBar "BARS1", "BARS_", CurrentArmorBar,  horizontal, 221,969;
			inInventory NoArmorDegenerationToken {
			drawBar "BARS8", "BARS_",   SuperArmorBar,  horizontal, 221,969;
			}
		} else {
			drawBar "BARF0", "BARS_",     MaxArmorBar,  horizontal, 221,969;
			drawBar "BARF3", "BARS_",   SuperArmorBar,  horizontal, 221,969;
			drawBar "BARF1", "BARS_", CurrentArmorBar,  horizontal, 221,969;
			inInventory NoArmorDegenerationToken {
			drawBar "BARF8", "BARS_",   SuperArmorBar,  horizontal, 221,969;
			}
		}
		inInventory not PowerEldersSoul {
			inInventory PowerInvul { drawString QCFNT070, bludi, "666", 291,924, 0, alignment(right); }
			else {
				drawnumber 5, QCFNT070, white, SuperArmorToken, alignment(right), 291,924;
			}
			drawString    QCFNT060, white, "/",                                    294,933, 0, alignment(left);
			drawnumber 5, QCFNT040, white,     MaxArmorToken,    alignment(left),  307,940;
		} else {
			drawnumber 5, QCFNT070, bludi, SuperArmorToken, alignment(right), 291,924;
			drawString    QCFNT060, bludi, "/",                               294,933, 0, alignment(left);
			drawnumber 5, QCFNT040, bludi,   MaxArmorToken, alignment(left),  307,940;
		}

		// Quad
		inInventory PowerQuad {
			drawImage "PWUPFRAM", 182,780;
			drawImage "PWUPFIR1", 182,780;
			drawImage "PWUPQUAD", 182,780;
