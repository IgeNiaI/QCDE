	PlaySound(0,"QC/Abilities/Durandal/FBTVCrandom",CHAN_VOICE,1.0,false,0.7);
	SetNetworkReplicationFlags( 0 );

	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	while(counter++ < How_Many_Bobs_PvX) //Spawn N bobs
	{
		GiveInventory(BobType,1);
		delay(3);
	}

	delay(GetDuration()); //duration of active ability

	// second check after time is up: have bobs spawned?
