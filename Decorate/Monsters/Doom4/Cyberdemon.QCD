		Stop
	}
}

Actor RRUrandomer
{
	Projectile
	Radius 3
	Height 3
	Speed 35
	Scale 0.4
	+SPAWNCEILING
	RenderStyle None
	States
	{
	Spawn:
		TROO A 0 NODELAY A_Jump(200,2,4,6,8,10,12,14)
		TROO AAAAAAAAAAAAAAAAA 1
		Goto Death
	Death:
		TROO A 0 A_Stop
		TROO A 0 A_ChangeFlag("NOINTERACTION",1)
		TROO A 10 A_SpawnItemEx("DummyRainRandomSpawner",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor DummyRainRandomSpawner	//why? because otherwise, it wouldnt spawn the rocket in the ceiling if i tried through the tracker
{
	+NOINTERACTION
	+SPAWNCEILING
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 30 A_CustomMissile("RocketTarget") //waits a bit
		TNT1 A 10 A_CustomMissile("RocketRainingDown") //then drops
		Stop
	}
}


//-------------------------------------------------
//laser attack
Actor CyberdemonChargeIndicator
{
	Renderstyle Add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[2.0,1.3,0.3]"
	Scale 0.0
	Alpha 0.6
	ReactionTime 60
	States
	{
	Spawn:
		X060 A 1 Bright A_SetScale(scalex+0.02)
		X060 A 0 A_Warp(AAPTR_TARGET,30,-20,50,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		X060 A 0 A_CountDown
		Loop
	Death:
		X060 AAAAA 1 Bright A_SetScale(scalex/2)
		Stop
	}
}


Actor CyberdemonLaserTrail
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.2
	States
	{
	Spawn:
		X025 B 8 BRIGHT
		X025 B 1 BRIGHT A_FadeOut(0.06)
		Wait
	}
}


//-----------------------------------------------
// Firewave attack
Actor FireWaveMain
{
	Projectile
	RenderStyle None
	Speed 20
	FastSpeed 28
	Radius 6
	Height 12
	Damage 1
	+RIPPER
	+BLOODLESSIMPACT
	+PAINLESS
	SeeSound "Doom4/Monsters/FireWaveShoot"
	DeathSound "Doom4/Monsters/FireWaveCrash"
	DamageType "CyberdemonFireWave"
	States
	{
	Spawn:
		BAL1 A 1 Bright
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",    random(0,-15),    random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx", -8+random(0,-15), 10+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx", -8+random(0,-15),-10+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-16+random(0,-15), 20+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-16+random(0,-15),-20+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-24+random(0,-15), 30+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-24+random(0,-15),-30+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-32+random(0,-15), 40+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		BAL1 A 0 A_SpawnItemEx("FireWaveFx",-32+random(0,-15),-40+random(8,-8),0,0,0,frandom(0.1,0.6),0,SXF_NOCHECKPOSITION,128)
		Loop
	Death:
		TNT1 A 10
		Stop
	}
}

Actor FireWaveMainSecondary : FireWaveMain
{
	SeeSound ""
	DeathSound ""
	States
	{
	Spawn:
		BAL1 A 1 Bright
		Loop
	}
}

Actor FireWaveFx
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.8
	Scale 0.28
	States
	{
	Spawn:
		PROJ D 0
		PROJ D 0 A_Jump(220,5,6,7,8,9,10,11,12,13)
		X056 ABCDEFGHIJKLMNOPR 1 Bright
		Stop
	}
}

//-----------------------------------------------
// Regular rockets
Actor CyberdemonRocket
{
	Projectile
	+EXTREMEDEATH
	+FORCERADIUSDMG
	Speed 23
	Radius 6
	Height 12
	Scale 0.7
	Damage 20
	ExplosionDamage 128 //deals good damage to player. But less than vanilla's doom
	ExplosionRadius 128
	FastSpeed 30
	SeeSound "Doom4/Weapon/RocketLauncher/Fire"
	DeathSound "Doom4/Weapon/RocketLauncher/Explosion"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		MICR A 3 Light("YellowMediumPoint3") Bright NoDelay A_PlaySound("Doom4/Monsters/Generic/RocketLauncher/Fly",7,0.7,true,1.5)
	Moving:
		MICR A 0 A_SpawnItemEx("CDRocketFlareBig",-5,0,0,0,0,0,0,SXF_NOCHECKPOSITION,64)
		MICR A 0 A_SpawnItemEx("RocketTrailSmoke",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MICR A 1 Light("YellowMediumPoint3") Bright
		Loop

	Death:
		TNT1 A 0 A_StopSound(7)
		TNT1 A 0 A_Explode(128,128,0)
		TNT1 A 0 A_Quake(2,2,0,768)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 50 A_ChangeFlag("NOINTERACTION",1)
		Stop
	}
}
//For Wall attack, total damage 60
Actor CyberdemonRocketWeak : CyberdemonRocket
{
	Damage (20)
	States
	{
	Death:
		TNT1 A 0 A_StopSound(7)
		TNT1 A 0 A_Explode(40,128,0)
		TNT1 A 0 A_Quake(2,2,0,768)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 50 A_ChangeFlag("NOINTERACTION",1)
		Stop
	}
}

//-----------------------------------------------
// Stream of rockets
Actor CyberDemonRocketStream
{
	Projectile
	+EXTREMEDEATH
	+FORCERADIUSDMG
	Speed 21
	FastSpeed 28
	Radius 6
	Height 12
	Scale 0.48
	Damage (20)
	SeeSound "Doom4/Monsters/CybDemShootRocket"
	DeathSound "Doom4/Monsters/CybDemSmallRocketExplo"
	Decal "D4ExploScorchSmall"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		MICR A 3 Light("YellowMediumPoint3") Bright NoDelay A_PlaySound("Doom4/Monsters/RocketFlyLoop",7,0.7,true,1.5)
	Moving:
		MICR A 1 Light("YellowMediumPoint3") Bright A_SpawnItemEx("CDRocketFlareSmall",-5,0,0,0,0,0,0,SXF_NOCHECKPOSITION,64)
		Loop
	Death:
		TNT1 A 0 A_Explode(64,64,0)
		TNT1 A 0 A_Quake(2,2,0,512)
		TNT1 A 0 A_SpawnItemEx("CyberdemonSmallRocketExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 50 A_ChangeFlag("NOINTERACTION",1)
		Stop
	}
}
//For Wall attack, total damage 30
Actor CyberDemonRocketStreamWeak : CyberDemonRocketStream
{
	Radius 4
	Height 8
	Scale 0.4
	Damage (10)
	States
	{
	Death:
		TNT1 A 0 A_Explode(20,64,0)
		TNT1 A 0 A_Quake(2,2,0,512)
		TNT1 A 0 A_SpawnItemEx("CyberdemonSmallRocketExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 50 A_ChangeFlag("NOINTERACTION",1)
		Stop
	}
}

Actor MGMiniMissileExplo
{
	+FORCEXYBILLBOARD
	+NOINTERACTION
	+CLIENTSIDEONLY
	Scale 0.5
	RenderStyle Add
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(0.4,0.7))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		X002 A 0
		Goto PlayOff
	Type2:
		X001 A 0
		Goto PlayOff
	PlayOff:
		"####" ABC 1 Bright Light("YellowSmallFlicker2")
		"####" EFG 1 Bright Light("YellowSmallFlicker1")
		"####" HIJ 1 Bright Light("YellowMediumFlicker3")
		"####" KLM 1 Bright Light("YellowMediumFlicker2")
		"####" NOP 1 Bright Light("YellowMediumFlicker3")
		"####" QRS 1 Bright Light("YellowSmallFlicker1")
		"####" TU 1 Bright Light("YellowSmallFlicker2")
		Stop
	}
}

Actor CyberdemonSmallRocketExplo : MGMiniMissileExplo
{
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(0.9,1.2))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	}
}

Actor CyberdemonBigRocketExplo : MGMiniMissileExplo
{
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(1.5,1.7))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	}
}

Actor CDRocketFlareSmall //centered flare behind the rocket
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.7
	Scale 0.14
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(255,"One","Two")
	One:
		X007 BDE 1 Bright
		X007 GIJ 1 Bright A_FadeOut
		Stop
	Two:
		X007 LNO 1 Bright
		X007 QST 1 Bright A_FadeOut
		Stop
	}
}

Actor CDRocketFlareBig : CDRocketFlareSmall
{
	Scale 0.22
}

