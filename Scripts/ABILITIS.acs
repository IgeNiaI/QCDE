//---------------------------------
//		Grayson's Active


#define TICS_BEFORE_THUMPER  27
#define TICS_FOR_THUMPER     30
#define TICS_BETWEEN_SPARKS   2

Script "QCDE_Ability_Grayson" (void)
{
	if(tics[PlayerNumber()]) terminate;
	if(CheckInventory("ThumperArmingToken")) terminate;

	int i;

	if(CheckInventory("ThumperReadyToken"))
	{
		// Second press on ability key signalling to fire
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		TakeInventory("ThumperReadyToken",1);
		SetNetworkReplicationFlags( 0 );
		terminate;
	}

	//Stop regular weapons and show ability used
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("DisableWeaponProc",1);
	GiveInventory("ThumpSoundAndHaloProc",1);
	GiveInventory("ThumperArmingToken",1);
	SetNetworkReplicationFlags( 0 );

	//Spawn player sparks
	while(i < TICS_BEFORE_THUMPER)
	{
		if(GetActorProperty(0, APROP_HEALTH) <= 0) break;

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("PlayerThumpSparkerProc",1);
		GiveInventory("ActiveProgressToken",256 * TICS_BETWEEN_SPARKS / TICS_BEFORE_THUMPER);
		SetNetworkReplicationFlags( 0 );
		Delay(TICS_BETWEEN_SPARKS);
		i += TICS_BETWEEN_SPARKS;
	}

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration() - TICS_BEFORE_THUMPER);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	TakeInventory("ThumperArmingToken",1);
	GiveInventory("ThumperReadyToken",1);
	SetNetworkReplicationFlags( 0 );

	//Continue spawning sparks, and fire when ready
	while(i < GetDuration())
	{
		if(GetPlayerInput(-1, MODINPUT_BUTTONS) & BT_ATTACK) break;
		if(GetActorProperty(0, APROP_HEALTH) <= 0) break;
		if(!CheckInventory("ThumperReadyToken")) break; // means other instance sends signal to fire

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("PlayerThumpSparkerProc",1);
		SetNetworkReplicationFlags( 0 );
		Delay(TICS_BETWEEN_SPARKS);
		i += TICS_BETWEEN_SPARKS;
	}

	//Fire projectile
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("ThumperShootProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	Delay(5);	//slight delay before he can shoot again

	//Clean the rest
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}


//When thumper hits -- should happen immediately before ThumperAffected
int thumperOwner;
Script "QCDE_ThumperHit" (void)
{
	SetActivatorToTarget(0);
	thumperOwner = PlayerNumber();
	//log(s:"\c[brite]Thumper hit. Owner: ", n:0, s:" -- #", d:thumperOwner);
}

//When a player gets hit by the thumper -- should happen immediately after ThumperHit
#define THUMPER_THRUSTZ 15
Script "QCDE_ThumperAffected" (void)
{
	int victim = PlayerNumber();
	if(!HostileCheck(thumperOwner, true)) {
		//log(s:"\c[black]Thumper thrown by ", n:-~thumperOwner, s:" -- #", d:thumperOwner, s:" harmlessly skips ", n:0, s:" -- #", d:victim);
		terminate;
	}

	//log(s:"\c[bludi]Thumper thrown by ", n:-~thumperOwner, s:" -- #", d:thumperOwner, s:" affects ", n:0, s:" -- #", d:victim);
	SetPlayerProperty(0,1,PROP_FROZEN);
	Thing_Stop(0);
	GiveInventory("GrayThumperFlight",1);
	GiveInventory("Twitchless3sec",1);
	ThrustThingZ(0,THUMPER_THRUSTZ * 4,0,0);

	int t = 35, velz, hit; //only lasts 1 sec
	while(t --> 0)
	{
		if(GetActorVelZ(0) == 0 && !hit)
		{
			if(GetActorProperty(0, APROP_HEALTH) >= 0)
			{
				GiveInventory("ThumperHitCeilingProc",1);

				SetActivator(1000 + thumperOwner);
				// Activator: thumper thrower

				int dmg = 40 + velz / 1.0 * 5;
				Thing_Damage(1000 + victim, dmg, MOD_SPLASH);
				GiveInventory("HitBeepMid",1);
				//log(s:"\c[bludi]", n:-~victim, s:" -- #", d:thumperOwner, s:" hits the ceiling! +", d:dmg, s:" damage!");

				SetActivator(1000 + victim);
				// Activator: thumper victim
			}
			hit = true;
		}
		velz = GetActorVelZ(0);
		if(velz < 0) velz = 0;
		SetActorVelocity(0, 0,0,0.05, true,false); // QZan only! Ensure some upward momentum for the ceiling check to work
		delay(1);
	}

	SetActivator(1000 + victim);
	SetPlayerProperty(0,0,PROP_FROZEN);

	if(!checkinventory("PowerCorvusFlight"))	//if corvus flying, skip removing flight, since he'll lose it automatically
		TakeInventory("PowerGrayThumpFlight",1);
}

// Activator: somebody already caught in radius
function int HostileCheck (int friendOrFoe, int blockable)
{
	// if not DM, skip
	if(GameType() < GAME_NET_DEATHMATCH) return false;

	if(blockable)
	{
		// if this player is invulnerable by ability, skip
		if(CheckInventory("PowerGhostTint")) return false;    //doesnt affect ghostwalking nyx
	}

	// if the projectile is your own, skip
	if(friendOrFoe == PlayerNumber()) return false;

	// if that player is on same team in TDM, skip
	if (CheckInventory("TeamDeathmatch") &&
		GetPlayerInfo(friendOrFoe,    PLAYERINFO_TEAM) ==
		GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM))
		return false;

	return true;
}


//---------------------------------
//		Eradicator's Active

Script "QCDE_Ability_Eradicator" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0, "QC/Abilities/Eradicator/Radar", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	for(int t = GetDuration(); t; t--)
	{
		// ensures radar persists regardless of possible death
		if(!CheckInventory("Radar") && CheckInventory("Class_Eradicator"))
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("Radar",1);
			SetNetworkReplicationFlags( 0 );
		}
		if(!CheckInventory("ActiveInProgress"))
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("ActiveInProgress",1);
			SetNetworkReplicationFlags( 0 );
			ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", t);
		}
		delay(1);
	}

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}

//---------------------------------
//		Blazkowicz's Active

Script "QCDE_Ability_Blazkowicz" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0,"QC/Abilities/Blazkowicz/AbilityVoice",CHAN_VOICE,0.75,false,1.0);
	SetPlayerProperty(0,1,PROP_INSTANTWEAPONSWITCH);
	SetNetworkReplicationFlags( 0 );

	if(PlayerIsBot(PlayerNumber()))
	{
		GiveInventory("AkimboBotProc",1);
		ACS("QCDE_SetWeapon", "BlazkoAkimboBot", GetDuration());
	}
	else
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("AkimboProc",1);
		SetNetworkReplicationFlags( 0 );
		ACS("QCDE_SetWeapon", "BlazkoAkimbo", GetDuration());
	}

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	int w;
	for(w = 0; w < NUMBER_OF_WEAPONS; w++)
		if(!stricmp(getWeapon(), weaponList[w]))
			break;


	int t = GetDuration();
	while(t --> 0)
	{
		if(GetActorProperty(0,APROP_HEALTH) <= 0) break;
		delay(1);
	}

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	//Unzoom if using toggle zoom
	if (!GetCVar("cl_holdZoom")) SetInventory("WeaponZoomedToken", 0);
	//Give and select fake weapon
	SetWeapon(weaponList[w]);
	//Remove ability weapon
	GiveInventory("AkimboCleanerProc",1);
	TakeInventory("BlazkoAkimbo",1);
	TakeInventory("BlazkoAkimboBot",1);
	SetNetworkReplicationFlags( 0 );
}

