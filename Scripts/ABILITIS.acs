		// ^ insert more ability weapons here
		};

script "CheckIfCorrectPlayer" (int who)
{
	if(CheckInventory(ClassxWeapon[who][0]) && CheckInventory("ActiveInProgress"))
	{
		//PrintBold(s:"we good");
	}
	else
	{
		if(!checkinventory("AbilityWeaponDebug")) //if you have this token, you can use the weap with any champ anytime
		{
			//PrintBold(s:"something's off, bye");
			TakeInventory(ClassxWeapon[who][1],1);
		}
	}
}

