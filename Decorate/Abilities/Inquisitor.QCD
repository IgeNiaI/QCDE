// --------------------------------------------------------------------------
//
// Inquisitor's abilities
//
// Active:	Damage Resistance
//			Absorbs 50% of incoming damage for a short period of time
//
// Passive:	Still Defense
//			When not moving, receive 20% less damage.
//
// --------------------------------------------------------------------------

//--------------------------------------------------------
// Active
// Stage 1: Full invul
//--------------------------------------------------------

Actor ReflectiveInProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("PLAYERPAWN.NOTHRUSTWHENINVUL",1)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PvPEffect")
	PvEEffect:
		TNT1 A 0 A_GiveInventory("ClutchInvulnerabilityPvE",1)
		TNT1 A 0 A_PlaySound("QC/Abilities/Inquisitor/ShieldStart",7,1)
		TNT1 A 35
		Stop
	PvPEffect:
		TNT1 A 0 A_GiveInventory("ClutchInvulnerability",1)
		TNT1 A 0 A_PlaySound("QC/Abilities/Inquisitor/ShieldStart",7,1)
		TNT1 A 35
		Stop
	}
}

Actor ReflectiveOutProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("PLAYERPAWN.NOTHRUSTWHENINVUL",0)
		TNT1 A 0 A_TakeInventory("PowerClutchInvul",1)
		TNT1 A 0 A_TakeInventory("PowerClutchInvulPvE",1)
		TNT1 A 0 A_PlaySound("QC/Abilities/Inquisitor/ShieldStop",7,1)
		TNT1 A 0 A_TakeInventory("ActiveInProgress")
		TNT1 A 0 A_TakeInventory("InquisitorStageToken",2)
		TNT1 A 35
		Stop
	}
}

Actor ReflectiveCleanerProc : CustomInventory //same as "ReflectiveOutProc" but without effects
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("PLAYERPAWN.NOTHRUSTWHENINVUL",0)
		TNT1 A 0 A_TakeInventory("PowerClutchInvul",1)
		TNT1 A 0 A_TakeInventory("PowerClutchInvulPvE",1)
		TNT1 A 0 A_TakeInventory("ActiveInProgress")
		TNT1 A 35
		Stop
	}
}


Actor PowerClutchInvul : PowerProtection
{
	DamageFactor "Normal", 0.5099
}
Actor ClutchInvulnerability : InvulnerabilitySphere
{
   +INVENTORY.AUTOACTIVATE
   +INVENTORY.ALWAYSPICKUP
	powerup.duration -100
	Powerup.Type "ClutchInvul"
	Powerup.Colormap 0.0,0.1,0.1, 0.0,1.0,0.85
}


Actor PowerClutchInvulPvE : PowerProtection
{
	DamageFactor "Normal", 0.1
}
Actor ClutchInvulnerabilityPvE : InvulnerabilitySphere
{
   +INVENTORY.AUTOACTIVATE
   +INVENTORY.ALWAYSPICKUP
	powerup.duration -100
	Powerup.Colormap 0.0,0.1,0.1, 0.0,1.0,0.85
	Powerup.Type "ClutchInvulPvE"
}




