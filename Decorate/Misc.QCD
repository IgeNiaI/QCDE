// HUGE SHOUTOUT!!! To Alphaent / Blorc.
// Using powerups as tokens that time themselves out is his idea.

Actor Timer : Powerup {	+SERVERNETID }
Actor Twitchless3sec : Timer { Powerup.Duration 111 } // given by Thumper

Actor Motionless3sec : PowerSpeed {
	+SERVERNETID
	Speed 0
	Powerup.Duration 111
} // given by cheat

Actor FX
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	States
	{
	Spawn:
		NULL A 0 NoDelay
		Stop
	}
}

