function int GetCooldown (void)
{
	SanityCheck();
	int column = AD_COOLDOWN;
	if(IsPVE()) column = AD_COOLDOWN_PVE;
	return AbilityData[CheckInventory("ClassID") * AD_COLUMNS + column] -XYZ;
}
function int GetDuration(void)
{
	SanityCheck();
	int column = AD_DURATION;
	if(IsPVE()) column = AD_DURATION_PVE;
	return AbilityData[CheckInventory("ClassID") * AD_COLUMNS + column] -XYZ;
}
function int  GetMultiuse            (void){ SanityCheck(); return AbilityData[CheckInventory("ClassID") * AD_COLUMNS + AD_MULTIUSE         ]    -XYZ; }
function int  GetMultiuseDelay       (void){ SanityCheck(); return AbilityData[CheckInventory("ClassID") * AD_COLUMNS + AD_MULTIUSEDELAY    ]    -XYZ; }
function int  GetMultiuseFailSound   (void){ SanityCheck(); return AbilityData[CheckInventory("ClassID") * AD_COLUMNS + AD_MULTIUSEFAILSOUND]        ; } // no -XYZ here because this is a string

int              LastUse      [64];
function int  GetLastUse    (void){ SanityCheck(); return LastUse[PlayerNumber()]    ; }
function void SetLastUse   (int x){ SanityCheck();        LastUse[PlayerNumber()] = x; }

int MultiusePeriod[64];

function void SanityCheck(void)
{
	//if(!CheckInventory("ClassID") && !CheckInventory("Class_Ranger"))
	//	printbold(d:timer(), s:": ", s:GetActorClass(0), s:" ", n:0, s:" checks its ability stats.");
}

// Once classes are rewritten as objects, these scripts won't be needed anymore
Script "PVP CD" (int class) clientside { SetResultValue(AbilityData[class * AD_COLUMNS + AD_COOLDOWN    ]   -XYZ); }
Script "PVE CD" (int class) clientside { SetResultValue(AbilityData[class * AD_COLUMNS + AD_COOLDOWN_PVE]   -XYZ); }


//=============================================================================
//=============================================================================
//
//		Script that upon entering a level, cleans up flag/token changes
//		made by active ability used in the previous level
//
//=============================================================================
//=============================================================================

Script "QCDE_CleanUpAbilities" (void)
{
	ACS("QCDE_DoCleanUpAbilities");
	if (GetNetworkState() == NETSTATE_SERVER)
		ACS("QCDE_CleanUpAbilities_CLIENTSIDE");
}

Script "QCDE_CleanUpAbilities_CLIENTSIDE" (void) clientside
{
	ACS("QCDE_DoCleanUpAbilities");
}

Script "QCDE_DoCleanUpAbilities" (void)
{
	SetLastUse(-GetMultiuseDelay());

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		 if(CheckInventory("Class_Doomslayer"	))	GiveInventory("SlayerBFGCleanerProc",1); // removes possible residual BFG
	else if(CheckInventory("Class_Kane"			))	GiveInventory("InjectionCleanerProc",1); // removes the NoFire token
	else if(CheckInventory("Class_Caleb"		))	GiveInventory("DollCleanerProc",1); //removes the doll
	else if(CheckInventory("Class_Terminator"	))	GiveInventory("TerminatorCleanerProc",1);
	else if(CheckInventory("Class_Inquisitor"	))	{GiveInventory("ReflectiveCleanerProc",1);GiveInventory("BecomeShieldCleanerProc",1);}
	else if(CheckInventory("Class_Galen"		))	GiveInventory("TotemCleanerProc",1);	// removes the NoFire token
	else if(CheckInventory("Class_Nyx"			))	GiveInventory("GhostWalkCleanerProc",1);
	else if(CheckInventory("Class_Sorgaul"		))	GiveInventory("PrimalRageCleanerProc",1);
	else if(CheckInventory("Class_DukeNukem"	))	GiveInventory("DukeFreezerCleanerProc",1);
	else if(CheckInventory("Class_Blazkowicz"	))	GiveInventory("AkimboCleanerProc",1);
	else if(CheckInventory("Class_Hunter"		))	GiveInventory("HunterCleanerProc",1); // remove the cubes
	else if(CheckInventory("Class_Painkiller"	))	GiveInventory("PainkillerCleanerProc",1); // restore HUD elements
	else if(CheckInventory("Class_Intruder"		))	GiveInventory("WendigoOutProc",1); // Back to normal
	// ^ insert more classes here

	SetInventory("StrikesCounter"   , false);
	SetInventory("PowerShieldCharge", false);
	SetInventory("MultiuseCharge"   , false);

	ACS_NamedExecuteWithResult("QCDE_UpdateMultiusePeriod", 0, 0);

	// It's generic, so it makes sense for everyone
	GiveInventory("GenericActiveCleanerProc",1);
	extraAbilityData[PlayerNumber()] = 0;
	SetNetworkReplicationFlags( 0 );
}

