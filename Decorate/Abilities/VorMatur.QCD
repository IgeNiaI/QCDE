Actor CompatVer30_VorMatur {} // for compatibility checks

const int DarkeningRadius	= 256;

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor DarkeningProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/VorMatur/DarkenShot",CHAN_AUTO,1.0,0,0.7)
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("Darkless3sec", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_FireCustomMissile("DarkeningShot", 0, false)
		Stop
	}
}

Actor DarkeningShot
{
	Projectile
	Radius 3
	Height 6
	Speed 60
	Scale 0.25
	Translation "0:255=%[0,0,0]:[0,0,0]"
	ReactionTime 25
	States
	{
	Spawn:
		X201 E 1 Light("BlackBigPoint3") A_ScaleVelocity(0.8)
		X201 E 0 A_Weave(4, 4, 1.0, 1.0)
		X201 E 0 A_SpawnItemEx("DarkeningShotTrail", 0,0,-13, 0,0,0,0, SXF_CLIENTSIDE|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		X201 E 0 A_CountDown
		Loop
	Death:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DarkeningShotHits")
		TNT1 A 0 A_SpawnItemEx("DarkeningFX", 0,0,0, 0,0,0,0, SXF_CLIENTSIDE|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 0 A_RadiusGive("GitSpookedProc",1024,RGF_MONSTERS)
		TNT1 A 0 A_RadiusGive("DarkenedProc", DarkeningRadius, RGF_PLAYERS)
		TNT1 A 0 A_PlaySound("QC/Abilities/VorMatur/Darkening",5,1.0,false,0.7) // cast sound
		TNT1 A 0 A_RadiusGive("DarkenedProc", DarkeningRadius, RGF_PLAYERS)
		TNT1 A 4 Light("BlackBigPoint2")
		TNT1 A 4 Light("BlackBigPoint3")
		TNT1 A 4 Light("BlackMediumPoint1")
		TNT1 A 4 Light("BlackMediumPoint2")
		TNT1 A 4 Light("BlackMediumPoint3")
		TNT1 A 4 Light("BlackSmallPoint1")
		TNT1 A 4 Light("BlackSmallPoint2")
		TNT1 A 4 Light("BlackSmallPoint3")
		Stop
	}
}

Actor DarkeningFX
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD +BRIGHT
	States
	{
	Spawn:
		// explo
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("DarkeningParticle", 0,0,0, random(random(-16,16),random(-16,16)),random(random(-16,16),random(-16,16)),random(-2,2),0)
		// center
		TNT1 AAA 0 A_SpawnItemEx("DarkeningParticle", random(random(-16,16),random(-16,16)),random(random(-16,16),random(-16,16)),random(-2,2))
	Circle:
		// show radius
		TNT1 A 1 A_SpawnItemEx("DarkeningParticle", DarkeningRadius * 0.9,0,0, 0,random(-2,2),0,0)
		TNT1 A 0 A_Turn(111)
		TNT1 A 0 A_FadeOut(0.05) // used as implicit iterator
		Loop
	}
}

Actor DarkeningParticle
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD +BRIGHT
	RenderStyle "Stencil"
	StencilColor "Black"
	Scale 0.4
	States
	{
	Spawn:
		X201 E 1 A_Fadeout
		X201 E 1 A_ScaleVelocity(0.8)
		X201 E 1 A_SetScale(scalex / 0.9)
		Loop
	}
}

Actor DarkeningShotTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD +BRIGHT
	RenderStyle "Stencil"
	StencilColor "Black"
	xScale 0.25
	yScale 0.22
	States
	{
	Spawn:
		// DB26 JKLMNOPQRSTUV
		DB26 J 1 A_Fadeout
		DB26 K 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 L 1 A_Fadeout
		DB26 M 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 N 1 A_Fadeout
		DB26 O 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 P 1 A_Fadeout
		DB26 Q 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 R 1 A_Fadeout
		DB26 S 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 T 1 A_Fadeout
		DB26 U 1 A_SetScale(scalex / 0.9, scaley / 0.9)
		DB26 V 1 A_Fadeout
		Stop
	}
}

Actor Darkless3sec : Timer { Powerup.Duration 111 }
Actor PowerDarkTint : PowerSpeed
{
	Speed 1.0
}
Actor DarkTintGiver : InvulnerabilitySphere
{
	+SERVERNETID
	Powerup.Color 0, 0, 0, 0.96
	powerup.duration -10
	Powerup.Type "DarkTint"
}


Actor DarkenedProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("Darkless3sec",1,"Nothing")
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"Continue")
	Nothing:
		TNT1 A 0
		Stop
	Continue:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DarkenedVictim")
		Stop
	}
}

Actor GitSpookedProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("FRIGHTENED", true)
		TNT1 A 0 A_ThrowGrenade("BlindVisualizerShort", 0, 0, 0, false, TGR_NOUNLAGGED)
		Stop
	}
}

Actor BlindVisualizer	// [DBT] See what i did there?
{						// [Ms] NO, CAN'T VISUALIZE ANYTHING
	var int user_counter;
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	+SERVERNETID
	RenderStyle Add
	Scale 0.75
	Alpha 0.99
	Translation "0:255=%[0,0,0]:[0.9,0,0.9]"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_JumpIf(user_counter>=8,"Ender")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"),"Ender")
		X105 OOOOOOOOOO 1 A_Warp(AAPTR_TARGET, -5 , 0, 70, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_SetUserVar(user_counter,user_counter+1)
		Loop
	Ender:
		TNT1 A 0 A_JumpIf(user_counter == 0, "JustDieAlready")
	EnderLoop:
		TNT1 A 0 A_FadeOut(0.1)
		X105 S 1 A_Warp(AAPTR_TARGET, -5 , 0, 70, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		Loop
	JustDieAlready:
		TNT1 A 0
		Stop
	}
}

Actor BlindVisualizerShort : BlindVisualizer
{
	+NONETID +CLIENTSIDEONLY
	Translation "0:255=%[0,0,0]:[0.9,0,0.9]"
	States
	{
	Spawn:
	Ender:
	Ender:
		TNT1 A 0 A_FadeOut(0.01)
		X105 S 1 A_Warp(AAPTR_TARGET, -5 , 0, 70, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Loop
	}
}


//--------------------------------------------------------
// Passive
//--------------------------------------------------------

Actor CorrosiveBlood
{
	var int user_explodamage;
	Projectile
	+RIPPER
	+BLOODLESSIMPACT
	+PAINLESS
	-NOGRAVITY
	+RANDOMIZE
	+BRIGHT
	+NODAMAGETHRUST
	+DONTSPLASH
	+SERVERNETID
	Damage 2
	Obituary "$OB_CorrosiveBlood" // "%o bathed in the blood of %k."
	Gravity 0.3
	Radius 32
	Height 1
	Scale 0.7
	DamageType "VormaturBlood"
	Translation "0:255=%[0,0,0]:[2,0.8,1.7]"
	States
	{
	Spawn:
		X057 A 0 NoDelay A_SetUserVar(user_explodamage,40)	//sets up damage for this actor
		X057 A 0 A_Jump(256,"Type07","Type08","TypeA7","TypeA8","TypeB7","TypeB8","TypeC7","TypeC8")

	Type07:		W057 A 0 A_Jump(256,"See") Goto See
	Type08:		W058 A 0 A_Jump(256,"See") Goto See
	TypeA7:		WA57 A 0 A_Jump(256,"See") Goto See
	TypeA8:		WA58 A 0 A_Jump(256,"See") Goto See
	TypeB7:		WB57 A 0 A_Jump(256,"See") Goto See
	TypeB8:		WB58 A 0 A_Jump(256,"See") Goto See
	TypeC7:		WC57 A 0 A_Jump(256,"See") Goto See
	TypeC8:		WC58 A 0 A_Jump(256,"See") Goto See

	See:
		"####" ABC 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" DEF 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" GHI 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" "#" 0 A_JumpIf(waterlevel==3,"Remove")
		"####" JKL 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" MNO 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" PQR 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.01,0.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		Stop
	Death:
		"####" "#" 0 A_JumpIf(waterlevel==3,"Remove")
		"####" "#" 0 A_Explode(user_explodamage, 64, 0, false, 64)
		"####" ABC 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" DEF 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" GHI 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" JKL 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" MNO 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" PQR 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" "#" 0 A_JumpIf(waterlevel==3,"Remove")
		"####" "#" 0 A_Explode(user_explodamage, 64, 0, false, 64)
		"####" ABC 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" DEF 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" GHI 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" JKL 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" MNO 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		"####" PQR 2 A_SpawnItemEx("CorrosiveBloodTrail", 0,0,0, 0,0,frandom(0.2,1.5),0, SXF_ABSOLUTEVELOCITY|SXF_CLIENTSIDE|SXF_NOUNLAGGED, 245)
		Stop
	Remove:
		"####" "#" 2 A_FadeOut(0.2)
		Stop
	}
}

Actor CorrosiveBloodDM : CorrosiveBlood
{
	Damage (random(0,random(0,1)) * 3)
	States
	{
	Spawn:
		X057 A 0 NoDelay A_SetUserVar(user_explodamage,2)	//sets up explosion damage<damage for this actor
		X057 A 0 A_Jump(256,"Type07","Type08","TypeA7","TypeA8","TypeB7","TypeB8","TypeC7","TypeC8")
		Goto Type07
	}
}

Actor CorrosiveBloodTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD +BRIGHT
	RenderStyle Translucent
	Gravity 0.3
	Scale 0.5
	Alpha 0.9
	Translation "0:255=%[0,0,0]:[2,0.8,1.7]"
	States
	{
	Spawn:
		X057 A 0 NoDelay A_Jump(256,"Type07","Type08","TypeA7","TypeA8","TypeB7","TypeB8","TypeC7","TypeC8")

	Type07:		X057 A 0 A_Jump(256,"See") Goto See
	Type08:		X058 A 0 A_Jump(256,"See") Goto See
	TypeA7:		XA57 A 0 A_Jump(256,"See") Goto See
	TypeA8:		XA58 A 0 A_Jump(256,"See") Goto See
	TypeB7:		XB57 A 0 A_Jump(256,"See") Goto See
	TypeB8:		XB58 A 0 A_Jump(256,"See") Goto See
	TypeC7:		XC57 A 0 A_Jump(256,"See") Goto See
	TypeC8:		XC58 A 0 A_Jump(256,"See") Goto See

	See:
