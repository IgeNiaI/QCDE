//==========================================================
//	Hit beeps, "Low", "Mid", "Big", "Max"
//==========================================================

Actor HitBeepLow : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	RenderStyle None
	States
	{
	Spawn:
		MEGA A 6
		Loop
	Pickup:
		TNT1 A 0 A_JumpIfInventory("PlayHitEffect",3,"Mark")
		TNT1 A 0 A_JumpIfInventory("PlayHitEffect",1,"Play")
		Stop
	Play:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"PlayStrong")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"PlayStrong")
		TNT1 A 0 A_PlaySound("QC/UI/HitBeepLow",CHAN_7|CHAN_UI,0.7,0,140)
		TNT1 A 0 A_JumpIfInventory("PlayHitEffect",2,"Mark")
		Stop
	PlayStrong:
		TNT1 A 0 A_PlaySound("QC/UI/HitBeepMid",CHAN_7|CHAN_UI,0.7,0,140)
		TNT1 A 0 A_JumpIfInventory("PlayHitEffect",2,"Mark")
		Stop
	Mark:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_HitMark",0)
		Stop
	}
}

