Actor CompatVer31_Corvus {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------
Actor CorvusFlightProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_AlertMonsters(96)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PickupDM")
		TNT1 A 0 A_GiveInventory("ActiveSpeeder", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("ActiveFlight", 1, 0, GIF_SKIPOWNER)
		Goto FinishCommon
	PickupDM:
		TNT1 A 0 A_GiveInventory("ActiveSpeederDM", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("ActiveFlightDM", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("VulnerabilityDM", 1, 0, GIF_SKIPOWNER)
		Goto FinishCommon
	FinishCommon:
		TNT1 A 0 A_PlaySound("QC/Abilities/Corvus/UseFlight",7,1)
		TNT1 A 35 A_GiveInventory("ActiveInProgress", 1, 0, GIF_SKIPOWNER)
		Stop
	}
}


Actor PowerCorvusSpeed : PowerSpeed
{
	Speed 1.16
}

Actor ActiveSpeeder : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "CorvusSpeed"
	powerup.duration -5
}

Actor ActiveSpeederDM : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "CorvusSpeed"
	powerup.duration -2
}


