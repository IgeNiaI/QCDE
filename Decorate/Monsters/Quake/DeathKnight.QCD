
//================================================================
//================================================================

Actor QDeathKnight : QCDE_MonsterBig	15101	// mancubus
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	//$Title "Death Knight"
	Health 650
	Radius 20
	Height 64
	Speed 10
	PainChance 20
	Mass 800
	Scale 0.465
	MeleeDamage 5
	MeleeRange 80
	Monster
	+BOSSDEATH
	+FLOORCLIP
	Tag "$TAG_QDeathKnight" // "Death Knight"
	SeeSound "Quake1/DeathKnight/Sight"
	PainSound "Quake1/DeathKnight/Pain"
	DeathSound "Quake1/DeathKnight/Death"
	ActiveSound "Quake1/DeathKnight/Idle"
	Obituary "$OB_QDeathKnight" // "%o was burned by a Death Knight."
	HitObituary "$OBH_QDeathKnight" // "%o was chopped in half by a Death Knight."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q33I A 0 A_Stop
		Q33I A 10 A_Look
		Wait
	See:
		Q33W AABBCCDDEEFF 2 A_Chase
		Loop
	Missile:
		Q33A ABC 4 A_FaceTarget
		Q33A C 4 A_CustomMissile("KnightBall",34,0,-35+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,-25+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,-10+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,0+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,10+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,25+random(4,-4))
		Q33A C 4 A_CustomMissile("KnightBall",34,0,35+random(4,-4))
		Q33A DE 4
		Goto See
	Melee:
		Q33C A 0 A_Jump(256,"Melee1","Melee2")
	Melee1:
		Q33C A 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
		Q33C B 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_PlaySound("Quake1/DeathKnight/Swing")
		Q33C C 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_FaceTarget
		Q33C D 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_FaceTarget
		Q33C E 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
		TNT1 A 0 A_FaceTarget	TNT1 A 0 A_PlaySound("Quake1/DeathKnight/Swing")
		Q33C F 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
		Q33C G 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
		Q33C H 5 A_Recoil(-1.8)
		Goto See
	Melee2:
		Q33B A 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
		Q33B B 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_FaceTarget	TNT1 A 0 A_PlaySound("Quake1/DeathKnight/Swing")
		Q33B C 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_FaceTarget
		Q33B D 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
		TNT1 A 0 A_FaceTarget
		Q33B E 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
		Q33B F 6 A_FaceTarget
		Goto See
	Pain:
		Q33P A 4
		Q33P A 4 A_Pain
		Goto See

	DeathChecksDone:
		Q33D A 0 A_Scream
		Q33D A 4 A_Fall
		Q33D B 4
		Q33D CDEFGH 4
		Q33D I 0 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q33D I -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q33D IHGFEDCBA 5
		Goto See
	}
}


Actor KnightBall
{
	Radius 5
	Height 10
	Speed 15
	Damage 7
	scale 0.8
	SeeSound "Quake1/DeathKnight/Fire"
	DeathSound "Quake1/DeathKnight/FireHit"
	Translation "0:255=%[0,0,0]:[1.5,0.7,0.0]"
	RenderStyle Add
	PROJECTILE
	+MISSILE
	states
	{
	Spawn:
		FSFX A 0 Bright NODELAY Light("OrangeMediumFlicker3")	A_SpawnItemEx("KnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,64)
		FSFX ABC 2 Bright
		loop
	Death:
		FSFX DEF 3 Bright Light("OrangeMediumFlicker3")
		FSFX G 3 Bright Light("OrangeSmallFlicker1")
		FSFX H 3 Bright Light("OrangeSmallFlicker2")
		FSFX I 3 Bright Light("OrangeSmallFlicker3")
		FSFX J 3 Bright
		FSFX KKKLLLMMM 1 Bright A_FadeOut
		stop
    }
}

Actor KnightBallTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.175
	States
	{
	Spawn:
		X105 H 2 Bright A_FadeOut(0.08)
		Loop
	}
}


