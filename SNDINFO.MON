//=============================================================================
//=============================================================================
//
//		Quake 1 Sounds
//
//=============================================================================
//=============================================================================
//
// Attenuation reference:
// Apply attenuation to Sight of monsters (possibly, other sounds).
//  1.4 -- nuisance enemies (like Dog)
//  1.0 -- normal enemies (like Enforcer)
//  0.6 -- big enemies (like Shambler)
//  0.3 -- mini-boss enemies (like Ngyr-Korath)
//  0.1 -- epic enemies (like Shub-Niggurath)
// Values in between are OK.
//
// To the loudest sounds, also apply $limit.
//  $limit name how_many distance
//
//=============================================================================
//=============================================================================

//Generic Xdeath sound
Quake1/Xdeath					"Sounds/Quake1/Xdeath.ogg"


//Death Knight
Quake1/DeathKnight/Fire			"Sounds/Quake1/DeathKnight/attack1.ogg"
Quake1/DeathKnight/FireHit		"Sounds/Quake1/DeathKnight/hit.ogg"
Quake1/DeathKnight/Death		"Sounds/Quake1/DeathKnight/death1.ogg"
Quake1/DeathKnight/Idle			"Sounds/Quake1/DeathKnight/idle.ogg"
Quake1/DeathKnight/Pain			"Sounds/Quake1/DeathKnight/pain1.ogg"
Quake1/DeathKnight/Sight		"Sounds/Quake1/DeathKnight/sight1.ogg"
Quake1/DeathKnight/Swing		"Sounds/Quake1/DeathKnight/slash1.ogg"
Quake1/DeathKnight/Grunt		"Sounds/Quake1/DeathKnight/grunt.ogg"
$attenuation Quake1/DeathKnight/Sight 0.7

//Dog
Quake1/Dog/Attack				"Sounds/Quake1/Dog/dattack1.ogg"
Quake1/Dog/Death				"Sounds/Quake1/Dog/ddeath.ogg"
Quake1/Dog/Pain					"Sounds/Quake1/Dog/dpain1.ogg"
