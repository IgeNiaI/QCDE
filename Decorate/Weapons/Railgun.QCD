		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+34
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+32
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+30
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+28
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+26
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+24
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+22
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+20
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+18
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+16
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+14
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+12
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE) 		Goto ZoomedFireSequenceDM+10
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+8
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+6
		TNT1 A 0 A_GunFlash("ClearToZoomed",GFF_NOEXTCHANGE)		Goto ZoomedFireSequenceDM+4

	ClearToZoomed:
		TNT1 A 0
		Stop


	AltFire:
		"####" "#" 0 A_JumpIfInventory("WeaponZoomedToken",1,"AltFireCont")
		TNT1 A 0 A_JumpIfInventory("RG_UG_Explosive",1,"AltFire.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "AltFire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "AltFire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "AltFire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "AltFire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "AltFire.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "AltFire.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "AltFire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "AltFire.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "AltFire.Quake1")
	AltFire.Default:
		QCE7 A 0
		Goto AltFireCont
	AltFire.Quake1:
		Q1E7 A 0
		Goto AltFireCont
	AltFire.Quake2:
		Q2E7 A 0
		Goto AltFireCont
	AltFire.Quake3:
		Q3E7 A 0
		Goto AltFireCont
	AltFire.Quake4:
		Q4E7 A 0
		Goto AltFireCont
	AltFire.ETQW:
		QWE7 A 0
		Goto AltFireCont
	AltFire.QCDE1:
		Q0E7 A 0
		Goto AltFireCont
	AltFire.HalfLife:
		HLE7 A 0
		Goto AltFireCont
	AltFire.SeriousSam:
		SSE7 A 0
		Goto AltFireCont
	AltFire.Modded:
		MDE7 A 0
		Goto AltFireCont

	AltFire.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "AltFire.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "AltFire.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "AltFire.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "AltFire.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "AltFire.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "AltFire.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "AltFire.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "AltFire.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "AltFire.Upgraded.Quake1")
	AltFire.Upgraded.Default:
		QCK7 A 0
		Goto AltFireCont
	AltFire.Upgraded.Quake1:
		Q1K7 A 0
		Goto AltFireCont
	AltFire.Upgraded.Quake2:
		Q2K7 A 0
		Goto AltFireCont
	AltFire.Upgraded.Quake3:
		Q3K7 A 0
		Goto AltFireCont
	AltFire.Upgraded.Quake4:
		Q4K7 A 0
		Goto AltFireCont
	AltFire.Upgraded.ETQW:
		QWK7 A 0
		Goto AltFireCont
	AltFire.Upgraded.QCDE1:
		Q0K7 A 0
		Goto AltFireCont
	AltFire.Upgraded.HalfLife:
		HLK7 A 0
		Goto AltFireCont
	AltFire.Upgraded.SeriousSam:
		SSK7 A 0
		Goto AltFireCont
	AltFire.Upgraded.Modded:
		MDK7 A 0
		Goto AltFireCont

	AltFireCont:
		"####" "#" 0 A_ChangeVelocity(15 * -cos(pitch), 0, 15 * sin(pitch), CVF_RELATIVE)
		"####" "#" 0 A_JumpIfInventory("QCRailgunSkin", 20, "AltFire.Effects.Modded")
		"####" "#" 0 A_PlaySound("QC/Abilities/Freeman/Exhaust", CHAN_5, 0.75)
		"####" "#" 0 A_FireCustomMissile("RailgunJumpReflector", 0, false, 1, 5, FPF_NOUNLAGGED|FPF_SKIPOWNER)
		Goto AltFire.EffectsCont
	AltFire.Effects.Modded:
		"####" "#" 0 A_PlaySound("QC/Weapons/Railgun/Railjump_Modded", CHAN_5, 0.75)
		"####" "#" 0 A_FireCustomMissile("RailgunJumpReflector_Modded", 0, false, 1, 5, FPF_NOUNLAGGED|FPF_SKIPOWNER)
	AltFire.EffectsCont:
		"####" A 1 Offset(9,37)
		"####" A 1 Offset(14,45)
		"####" D 1 Offset(17,48)
		"####" E 1 Offset(19,51)
		"####" E 1 Offset(19,51)
		"####" F 1 Offset(19,51)
		"####" F 1 Offset(19,51)
		"####" G 1 Offset(19,51)
		"####" G 1 Offset(19,51)
		"####" H 1 Offset(19,51)
		"####" H 1 Offset(19,51)
		"####" I 1 Offset(19,51)
		"####" I 1 Offset(19,51)
		"####" J 1 Offset(19,51)
		"####" J 1 Offset(19,51)
		"####" K 1 Offset(18,50)
		"####" K 1 Offset(17,49)
		"####" K 1 Offset(16,48)
		"####" L 1 Offset(14,46)
		"####" L 1 Offset(12,44)
		"####" L 1 Offset(10,42)
		"####" M 1 Offset(8,40)
		"####" M 1 Offset(7,39)
		"####" M 1 Offset(6,38)
		"####" N 1 Offset(5,37)
		"####" N 1 Offset(4,36)
		"####" N 1 Offset(3,35)
		"####" O 1 Offset(2,34)
		"####" O 1 Offset(1,33)
		"####" O 1 Offset(0,32)
		Goto ReadyAgain
	}
}

Actor RailgunCharges : Inventory
{
	+SERVERNETID
	Inventory.MaxAmount 52
	Inventory.InterHubAmount 0
}


Actor RailgunJumpReflector
{
	+NOGRAVITY
	Projectile
	Damage 1
	Speed 20
	radius 10
	height 20
	ProjectileKickback 10000
	RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Blast(BF_NOIMPACTDAMAGE, 255, 32)
		FX01 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor RailgunJumpReflector_Modded : RailgunJumpReflector
{
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Blast(BF_NOIMPACTDAMAGE, 255, 32)
		MDW7 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor RailgunTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
