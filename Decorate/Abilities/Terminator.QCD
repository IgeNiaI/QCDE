Actor CompatVer31_Terminator {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor TerminatorMainProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_AlertMonsters(512)
		TNT1 A 0 A_GiveInventory("ActiveInProgress", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("DangerIndicatorColorer", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/ActiveAbilityVoice",CHAN_VOICE,1,0,0.25)
		TNT1 A 35 A_FireCustomMissile("MissileBarrageIndicator",0, false, 0,0, FPF_NOUNLAGGED|FPF_FORCESERVERSIDE)
		Stop
	}
}

Actor TerminatorCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("ActiveInProgress", 32767, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("ActiveProgressToken", 32767, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("NoWeaponFireToken", 32767, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("PowerDangerIndicator", 32767, TIF_SKIPOWNER)
		//TNT1 A 0 SetPlayerProperty(0,0,PROP_TOTALLYFROZEN)
		TNT1 A 35
		Stop
	}
}

Actor TermRocketProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)>=2,"FireDM")
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/FireMissile",CHAN_WEAPON,0.7)
		TNT1 A 0 //A_PrintBold("SP/coop")
		TNT1 A 0 A_FireCustomMissile ("TerminatorRocket",frandom(5,-5),false,0,0,0,frandom(5,-5))
		Stop
	FireDM:
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/FireMissile",CHAN_WEAPON,0.7)
		TNT1 A 0 //A_PrintBold("DM")
		TNT1 A 0 A_FireCustomMissile ("TerminatorRocketDM",frandom(5,-5),false,0,0,0,1)
		Stop
	}
}


Actor TerminatorRocketMain
{
	Projectile
	Speed 33
	+SEEKERMISSILE
	+SCREENSEEKER
	+FORCERADIUSDMG
	+MTHRUSPECIES
	Damage 10
	Scale 0.37
	Radius 4
	Height 7
	SeeSound "QC/Abilities/Terminator/MissileWhoosh"
	ReactionTime 1
	States
	{
	Spawn:
		MICR A 0 NODELAY A_GiveInventory("DangerIndicatorColorer",1)
		MICR A 0 A_Jump(256,"Looper")
		Goto Looper
	Looper:
		MICR A 0 Bright A_SeekerMissile(5,5,SMF_LOOK|SMF_PRECISE)
		MICR A 1 Bright A_SpawnItemEx("TerminatorTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"DeathCont")
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_ChangeFlag("SCREENSEEKER",0)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		TNT1 A 0 A_Jump(256,"DeathCont")
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont")
			Goto DeathCont

	DeathCont:
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/MissileExplo",CHAN_AUTO,1,0,0.8)
		TNT1 A 0 A_Explode(5,64,XF_HURTSOURCE,1,16)		//self damage
 		TNT1 A 0 A_Explode(15,128,0,1,96)
		TNT1 A 0 A_SpawnItemEx("TerminatorMissileExplo",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 10
		Stop

	}
}

Actor TerminatorRocket : TerminatorRocketMain
{
	DamageType "RocketDamage"
	Damage 25
	+DONTBLAST
	States
	{
	DeathCont:
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/MissileExplo",CHAN_AUTO,1,0,0.8)
		TNT1 A 0 A_Explode(10,128,XF_HURTSOURCE,1,96)	//self damage
 		TNT1 A 0 A_Explode(54,128,0,1,72)
		TNT1 A 0 A_SpawnItemEx("TerminatorMissileExplo",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 10
		Stop
	}
}


Actor TerminatorRocketDM : TerminatorRocketMain
{
	Damage 0		//just the explo will deal damage
	-MTHRUSPECIES
	DamageType "TerminatorRocket"
	var int user_amp;
	ReactionTime 1
	States
	{
	Looper:
		MICR A 0 A_SeekerMissile(5,5,SMF_LOOK|SMF_PRECISE)
		MICR A 0 A_Weave(0,user_amp / 2000,0,user_amp / 1000)
		MICR A 0 A_SetUserVar(user_amp,(user_amp + 220) * 0.95) // tends to 4161
		MICR A 1 Bright A_SpawnItemEx("TerminatorTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MICR A 0 A_JumpIfTracerCloser(42,"TimeItOut")
		Loop

	TimeItOut:
		TNT1 AA 0 A_CountDown //with the reactiontime=1, the first call will detonate it as if it had crashed somewhere.
		TNT1 A 1 A_CountDown
		TNT1 A 10 A_PrintBold("I'm a terminator rocket and you shouldn't see this!")		//it will never reach this point
		Stop

	DeathCont:
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/MissileExplo",CHAN_AUTO,1,0,0.8)
		TNT1 A 0 A_Explode(6,128,XF_HURTSOURCE,1,96)	//self damage
 		TNT1 A 0 A_Explode(9,128,0,1,128)	//Then the rest to do 15dmg
		TNT1 A 0 A_SpawnItemEx("TerminatorMissileExplo",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 10
		Stop
	}
}

Actor TerminatorTrail
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Add
	Alpha 0.7
	Scale 1.0
	States
	{
	Spawn:
		TNT1 A 2
		X010 ABCDEFGHIJ 1 Bright
		Stop
	}
}


Actor TerminatorMissileExplo
{
	+FORCEXYBILLBOARD
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NONETID
	Scale 0.5
	RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SetScale(frandom(0.6,1.0))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		X012 A 0
		Goto PlayOff
	Type2:
		X011 A 0
		Goto PlayOff
	PlayOff:
		"####" ABC 1 Bright Light("RedSmallFlicker2")
		"####" EFG 1 Bright Light("RedSmallFlicker1")
		"####" HIJ 1 Bright Light("RedMediumFlicker3")
		"####" KLM 1 Bright Light("RedMediumFlicker2")
		"####" NOP 1 Bright Light("RedMediumFlicker3")
		"####" QRS 1 Bright Light("RedSmallFlicker1")
		"####" TU 1 Bright Light("RedSmallFlicker2")
		Stop
	}
}

Actor MissileBarrageIndicator
{
	Renderstyle Add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+SERVERNETID
	Scale 1.4
	Alpha 0.99
	ReactionTime 70
	States
	{
	Spawn:
		RP07 Z 0 Bright NODELAY A_Warp(AAPTR_TARGET, -5, 0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RP07 Z 1 Bright A_SetScale(scalex-0.0194)
		RP07 Z 0 A_Countdown
		//Repeat of three prev frames (1)
		RP07 Z 0 Bright  A_Warp(AAPTR_TARGET, -5, 0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RP07 Z 1 Bright A_SetScale(scalex-0.0194)
		RP07 Z 0 A_Countdown
		//Repeat of three prev frames (2)
		RP07 Z 0 Bright  A_Warp(AAPTR_TARGET, -5, 0, 30, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RP07 Z 1 Bright A_SetScale(scalex-0.0194)
		RP07 Z 0 A_Countdown
		//so that it would check for this token ever 3 tics rather than every single tic
		RP07 Z 0 A_JumpIfInTargetInventory("ImDead",1,"Death")
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}

// Rockets counter for Terminator's active
Actor TerminatorRockets : Inventory
{
	+SERVERNETID
	Inventory.MaxAmount 20
}


Actor PowerDangerIndicator : PowerDamage
{
	DamageFactor "Normal", 1
}
Actor DangerIndicatorColorer : InvulnerabilitySphere
{
	Powerup.Colormap 0,0,0, 1,0.5,0.5
	powerup.duration -100
	Powerup.Type "DangerIndicator"
}