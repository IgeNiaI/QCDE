FreeformMenu "MainMenuTopBar"
{
	Label {
		Static
		Background BackTop
		Size 1000, 35
	}

	Command {
		Static
		Pos		0, 0			Background			BT_HOME
		Size	15, 20			SelectedBackground	BT_HOMES
		Anchor	left, top
		Gravity left, top		Command	qcde_openmainmenu
	}

	Command {
		Static	NotOnTitlemap	NotInSingleplayer	NotInBotplay
		Pos		52, 10					Text				"Call Vote"			Background			BM14040
		Size	70, 20					Font				QCSMFONT			SelectedBackground	BM14040S
		Anchor	center, center			FontColor			Tan
		Gravity left, top				SelectedFontColor	Tan					Command	qcde_opencallvote
		Padding	0, 1
	}

	Command {
		Static	NotInMultiplayer
		Pos		52, 10					Text				"New Game"			Background			BM14040
		Size	70, 20					Font				QCSMFONT			SelectedBackground	BM14040S
		Anchor	center, center			FontColor			Tan
		Gravity left, top				SelectedFontColor	Tan					Command	qcde_opencampaign
		Padding	0, 1
	}

	Command {
		Static	NotInMultiplayer
		Pos		124, 10					Text				"Skirmish"			Background			BM14040
		Size	70, 20					Font				QCSMFONT			SelectedBackground	BM14040S
		Anchor	center, center			FontColor			Tan
		Gravity left, top				SelectedFontColor	Tan					Command	qcde_openskirmish
		Padding	0, 1
	}

	SubMenu {
		Static	NotInMultiplayer
		Pos		196, 10					Text				"Load Game"			Background			BM14040
		Size	70, 20					Font				QCSMFONT			SelectedBackground	BM14040S
		Anchor	center, center			FontColor			Tan
		Gravity left, top				SelectedFontColor	Tan					Menu	LoadGameMenu
		Padding	0, 1
	}

	SubMenu {
		Static	NotOnTitlemap	NotInMultiplayer	NotInBotplay
		Pos		268, 10					Text				"Save Game"			Background			BM14040
		Size	70, 20					Font				QCSMFONT			SelectedBackground	BM14040S
		Anchor	center, center			FontColor			Tan
		Gravity left, top				SelectedFontColor	Tan					Menu	SaveGameMenu
		Padding	0, 1
	}

	Command {
		Static
		Pos		-22, 0			Background			BM_4040
		Size	20, 20			SelectedBackground	BM_4040S
		Anchor	right, top
		Gravity right, top		Command	qcde_optionsgeneral
	}

	Label {
		Static
		Pos		-32, 10			Size 10, 10
		Anchor	center, center	Gravity right, top
		Background IC_STNGS
	}

	SubMenu {
		Static
		Pos		0, 0			Background			BM_4040
		Size	20, 20			SelectedBackground	BM_4040R
		Anchor	right, top
		Gravity right, top		Menu	QuitMenu
	}

	Label {
		Static
		Pos		-10, 10			Size 10, 10
		Anchor	center, center	Gravity right, top
		Background IC_QUIT
	}
}

FreeformMenu "MainMenu"
{
	NoBackButton
	DontDim
	OverrideHeight 1 // this menu should never scroll
	DefaultSelection -2

	Label {
		Static	NotOnTitlemap
		Background MenuDim
		Size 1000, 1000
	}

	InsertFreeformMenu MainMenuTopBar

	SubMenu {
		Static
		Pos		0, -15					Text				"CHAMPIONS"			Background			BTCHAMP
		Size	154, 30					Font				QCSMFONT			SelectedBackground	BTCHAMPS
		Anchor	center, center			FontColor			Tan
		Gravity center, bottom			SelectedFontColor	Tan					Menu	ZA_JoinMenu
		Padding	0, 1
	}
}

FreeformMenu "PlayerclassMenu"
{
	NoBackButton
	Centermenu
	TopPadding 20
	DefaultSelection -2

	Label {
		Background	"CPicker0"
		Size		1000, 250
	}

	InsertFreeformMenu	ChampionSelector
	InsertFreeformMenu	WeaponSelectorCoop

	SubMenu {
		Pos		40, 207					Text				"NEXT"				Background			BT20060
		Size	100, 30					Font				QCBGFONT			SelectedBackground	BT20060S
		Anchor	center, center			FontColor			Tan					Menu				Episodemenu
		Padding	0, 2					SelectedFontColor	Yellow				Param				-2
	}

	InsertFreeformMenu MainMenuTopBar
}

FreeformMenu "EpisodeMenu"
{
	Centermenu
	TopPadding 0
	DefaultSelection -2

	Label {
		Static
		Background	"BackMenu"
		Size		230, 500
	}

	Label {
		Pos 0, 20				Font QCBGFONT
		Text "SELECT EPISODE"	FontColor Gold
	}

	SubMenu {
		Pos 0, 60				Font QCBGFONT
		Size 200, 20			SelectedFontColor Red
		Menu EpisodesTop
		Text "TEST EPISODE"
	}
}

