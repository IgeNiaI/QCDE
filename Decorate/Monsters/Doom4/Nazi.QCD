//===========================================================================
//
// SS Nazi
//
//===========================================================================
Actor D4WolfensteinSS  : QCDE_MonsterSmall 15458
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	Health 80
	Radius 20
	Height 56
	Speed 8
	PainChance 170
	Monster
	+FLOORCLIP
	SeeSound "wolfss/sight"
	PainSound "wolfss/pain"
	DeathSound "wolfss/death"
	ActiveSound "wolfss/active"
	AttackSound "wolfss/attack"
	Obituary "$OB_WOLFSS"
	DamageFactor "PlasmaExploder", 0.3	//because otherwise, zombiemen would be killing everyone else easily
	Tag "$TAG_D4WolfensteinSS" // "Wolfenstein SS Soldier"
	States
	{
	Idle:
		SSWV AB 10 A_Look
		Loop
	See:
		SSWV AABBCCDD 3 A_Chase
		Loop
	Missile:
		SSWV E 10 A_FaceTarget
		SSWV F 10 A_FaceTarget
		SSWV G 4 BRIGHT A_CPosAttack
		SSWV F 6 A_FaceTarget
		SSWV G 4 BRIGHT A_CPosAttack
		SSWV F 1 A_CPosRefire
		Goto Missile+1

	//------------------------
	Missile:
		TNT1 A 0 A_PlaySound("Doom4/Monsters/Grunt/AttackOneInEight",CHAN_AUTO,1.0,false,1.15)
		TNT1 A 0 A_Jump(200,"PlasmaBurst")

		//------------------------
		PlasmaBomb:
			TNT1 A 0 A_JumpIfCloser(64,"PlasmaBurst")	//if too close, goes to plasmaburst anyway
			SSWV E 0 A_PlaySound("Doom4/Other/ZombieChargeAtt",CHAN_BODY,1.0,false,0.95)
			SSWV EFFFFFF 5 A_FaceTarget
			TNT1 A 0 A_JumpIfCloser(128,"PlasmaExplo128")
			TNT1 A 0 A_JumpIfCloser(192,"PlasmaExplo192")
			TNT1 A 0 A_JumpIfCloser(256,"PlasmaExplo256")
			TNT1 A 0 A_JumpIfCloser(320,"PlasmaExplo320")
			TNT1 A 0 A_JumpIfCloser(384,"PlasmaExplo384")
			TNT1 A 0 A_JumpIfCloser(448,"PlasmaExplo448")
			TNT1 A 0 A_JumpIfCloser(512,"PlasmaExplo512")
			TNT1 A 0 A_JumpIfCloser(576,"PlasmaExplo576")
			TNT1 A 0 A_JumpIfCloser(640,"PlasmaExplo640")
			TNT1 A 0 A_JumpIfCloser(704,"PlasmaExplo704")
			TNT1 A 0 A_JumpIfCloser(768,"PlasmaExplo768")
			TNT1 A 0 A_JumpIfCloser(832,"PlasmaExplo832")

			PlasmaExplo128:
				TNT1 A 0 A_CustomMissile("PlasmaExploder128",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo192:
				TNT1 A 0 A_CustomMissile("PlasmaExploder192",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo256:
				TNT1 A 0 A_CustomMissile("PlasmaExploder256",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo320:
				TNT1 A 0 A_CustomMissile("PlasmaExploder320",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo384:
				TNT1 A 0 A_CustomMissile("PlasmaExploder384",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo448:
				TNT1 A 0 A_CustomMissile("PlasmaExploder448",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo512:
				TNT1 A 0 A_CustomMissile("PlasmaExploder512",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo576:
				TNT1 A 0 A_CustomMissile("PlasmaExploder576",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo640:
				TNT1 A 0 A_CustomMissile("PlasmaExploder640",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo704:
				TNT1 A 0 A_CustomMissile("PlasmaExploder704",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo768:
				TNT1 A 0 A_CustomMissile("PlasmaExploder768",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo832:
				TNT1 A 0 A_CustomMissile("PlasmaExploder832",35,0,0)
				Goto FinishPlasmaExplo

				FinishPlasmaExplo:
					TNT1 A 0 A_PlaySound("Doom4/Monsters/PlasmaShotBig",CHAN_AUTO,1.0,false,0.95)
					SSWV G 5 Bright
					SSWV F 15
					Goto See
		//------------------------
		ShotgunPlasma:
			SSWV EF 5 A_FaceTarget
			TNT1 AAAAA 0 A_CustomMissile("ShotgunnerPlasmaBall",35,4,frandom(7,-7))
			SSWV G 5 Bright A_PlaySound("Doom4/Monsters/PlasmaShotgun",CHAN_AUTO,1.0,false,0.95)
			SSWV F 10
			Goto See
		//------------------------
		PlasmaBurst:
			SSWV A 0 A_Jump(128,"ShotgunPlasma") //half of the time goes to the other one
			SSWV EF 10 A_FaceTarget
			SSWV G 4 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
			SSWV F 4 A_FaceTarget
			SSWV G 4 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
			SSWV F 4 A_FaceTarget
			SSWV G 4 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
			SSWV F 4 A_FaceTarget
			SSWV G 4 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
			SSWV F 4 A_FaceTarget
			Goto See

	Pain:
		SSWV H 3
		SSWV H 3 A_Pain
		Goto See

	DeathChecksDone:
		SSWV I 0 A_Scream
		SSWV I 5
		SSWV J 5
		TNT1 A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		SSWV K 5 A_NoBlocking
		SSWV L 5
	Death.Corpse:
		SSWV M -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		SSWV M 3
		SSWV LKJI 3
		Goto See

	//------------------------------------------------------------------------
	}
}

