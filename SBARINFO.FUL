	}}
	// Orange pad behind selected weapon
	isSelected QCMachinegun 		, QCMachinegunDM		{ drawImage "SELECTOR", 1540,277; }
	isSelected QCShotgun			, QCShotgunDM			{ drawImage "SELECTOR", 1540,347; }
	isSelected QCNailgun			, QCNailgunDM			{ drawImage "SELECTOR", 1540,417; }

	isSelected QCHeavyMachinegun 	, QCHeavyMachinegunDM	{ drawImage "SELECTOR", 1540,277; }
	isSelected QCSuperShotgun		, QCSuperShotgunDM		{ drawImage "SELECTOR", 1540,347; }
	isSelected QCSuperNailgun		, QCSuperNailgunDM		{ drawImage "SELECTOR", 1540,417; }
