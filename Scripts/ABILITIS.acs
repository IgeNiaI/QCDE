int tics[64];
bool cooldownActive[64];

// Ranger - tells whether the orb was used on client to ignore timeout message from server
// Menelkir - tracks Dave duration
// Keel - tells how many grenades were thrown compared to ability cooldown messages from server. Needs to ignore messages that tell wrong cooldown
int extraAbilityData[64];

// Trigger script
Script "QCDE_ActiveAbility" (int predicting, int justPressed, int justReleased, int buttons)
{
	if (justPressed) {
		int plr = PlayerNumber();

		if(CheckInventory("NoAbilitiesToken"))			terminate; // Forbidden?
		if(GetActorProperty(0,APROP_HEALTH) <= 0)		terminate; // Dead players can't activate ability
		if(CheckInventory("PowerTerminatorArtifact"))	terminate; // qc_elderssoul special case

		// CTF special case
		if(hasFlags())
		{
			ACS("QCDE_Ability_Flag", hasFlags());
			terminate;
		}

		if(GetLastUse() + GetMultiuseDelay() > Timer()) terminate; // Prevent spam

		if (predicting) {
			//log(s:"Predicting ability!");
			if(CheckInventory("Class_Ranger")) {
				if (GetPredictableValue(0, 0))
					ACS_NamedExecuteWithResult("QCDE_DireOrbPredictedUse", 0, 0);
			} else if(CheckInventory("Class_Eleena")) {
				if (GetPredictableValue(0, 0))
					ACS_NamedExecuteWithResult("QCDE_EleenaSwapPredictedUse", 0, 0);
			}
		} else if (!tics[plr]) { // abilities that activate only once
			//log(s:"Activated single use ability");
			SetLastUse(Timer());
			ACS_NamedExecuteWithResult("QCDE_UpdateMultiusePeriod", 0, 0);

				 if(CheckInventory("Class_Ranger"	))	ACS("QCDE_Ability_Ranger"    );
			else if(CheckInventory("Class_Doomslayer"))	ACS("QCDE_Ability_Doomslayer");
			else if(CheckInventory("Class_Corvus"	))	ACS("QCDE_Ability_Corvus"    );
			else if(CheckInventory("Class_Kane"		))	ACS("QCDE_Ability_Kane"      );
			else if(CheckInventory("Class_Caleb"	))	ACS("QCDE_Ability_Caleb"     );
			else if(CheckInventory("Class_Menelkir"	))	ACS("QCDE_Ability_Menelkir"  );
			else if(CheckInventory("Class_Terminator"))	ACS("QCDE_Ability_Terminator");
			else if(CheckInventory("Class_Zedek"	))	ACS("QCDE_Ability_Zedek"     );
			else if(CheckInventory("Class_Inquisitor"))	ACS("QCDE_Ability_Inquisitor");
			else if(CheckInventory("Class_Bitterman"))	ACS("QCDE_Ability_Bitterman" );
			else if(CheckInventory("Class_Galen" 	))	ACS("QCDE_Ability_Galen"     );
			else if(CheckInventory("Class_Nyx"		))	ACS("QCDE_Ability_Nyx"       );
			else if(CheckInventory("Class_Sorgaul"	))	ACS("QCDE_Ability_Sorgaul"   );
			else if(CheckInventory("Class_DukeNukem"))	ACS("QCDE_Ability_DukeNukem" );
			else if(CheckInventory("Class_Durandal"	))	ACS("QCDE_Ability_Durandal"  );
			else if(CheckInventory("Class_Keel"		))	ACS("QCDE_Ability_Keel"      );
			else if(CheckInventory("Class_LoWang"	))	ACS("QCDE_Ability_LoWang"    );
			else if(CheckInventory("Class_Grayson"	))	ACS("QCDE_Ability_Grayson"   );
			else if(CheckInventory("Class_Eradicator"))	ACS("QCDE_Ability_Eradicator");
			else if(CheckInventory("Class_Blazkowicz"))	ACS("QCDE_Ability_Blazkowicz");
			else if(CheckInventory("Class_Freeman"	))	ACS("QCDE_Ability_Freeman"   );
			else if(CheckInventory("Class_VorMatur"	))	ACS("QCDE_Ability_VorMatur"  );
			else if(CheckInventory("Class_Eleena"	))	ACS("QCDE_Ability_Eleena"    );
			else if(CheckInventory("Class_Lucienne"	))	ACS("QCDE_Ability_Lucienne"  );
			else if(CheckInventory("Class_Major"	))	ACS("QCDE_Ability_Major"     );
			else if(CheckInventory("Class_Hunter"	))	ACS("QCDE_Ability_Hunter"    );
			else if(CheckInventory("Class_Sam"		))	ACS("QCDE_Ability_Sam"       );
			else if(CheckInventory("Class_Postal"	))	ACS("QCDE_Ability_Postal"    );
			else if(CheckInventory("Class_Painkiller"))	ACS("QCDE_Ability_Painkiller");
			else if(CheckInventory("Class_Intruder"	))	ACS("QCDE_Ability_Intruder"  );
			else if(CheckInventory("Class_Orbb"		))	ACS("QCDE_Ability_Orbb"      );
			// ^ insert more classes here
		} else {
			//log(s:"Activated multi use ability");
			ACS_NamedExecuteWithResult("QCDE_UpdateMultiusePeriod", 0, 0);

				 if(CheckInventory("Class_Corvus"	))	ACS("QCDE_Ability_Corvus"    );
			else if(CheckInventory("Class_Keel"		))	ACS("QCDE_Ability_Keel"      );
			else if(CheckInventory("Class_Freeman"	))	ACS("QCDE_Ability_Freeman"   );
			else if(CheckInventory("Class_Eleena"	))	ACS("QCDE_Ability_Eleena"    );
			else if(CheckInventory("Class_Lucienne"	))	ACS("QCDE_Ability_Lucienne"  );
			// ^ insert more classes here if needed
		}
	}
}

// Shared counters

Script "QCDE_UpdateMultiusePeriod" (void)
{
	int multiuse = GetMultiuse();
	if(multiuse)
	{
		MultiusePeriod[PlayerNumber()] = (GetCooldown() / GetMultiuse())
				* GetCvar("sv_cooldownPercentage") / 100
				* (100 - CheckInventory("CooldownRewardToken") - CheckInventory("CooldownRewardToken2")) / 100;
		int plr = PlayerNumber();
		int charges = multiuse - ((tics[plr] + (MultiusePeriod[plr] - 1)) / MultiusePeriod[plr]);
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("MultiuseCharge", charges);
		SetNetworkReplicationFlags( 0 );
	}
	else
	{
		MultiusePeriod[PlayerNumber()] = 1;
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("MultiuseCharge", no);
		SetNetworkReplicationFlags( 0 );
	}
}

#define AP_TOTAL 0
#define AP_NOW   1
int activeProgress[64][2];
Script "QCDE_ShowActiveInProgress" (int duration, int now)
{
	if(duration <= 0) terminate;
	if(!now) now = duration;
	int plr = PlayerNumber();
	//log(n:0, s:" showing progress: ", d:now, s:" / ", d:duration, s:"      concurrent? ", d:activeProgress[plr][AP_NOW]);

	int concurrent = activeProgress[plr][AP_NOW] > 0;

	activeProgress[plr][AP_TOTAL] = duration;
	activeProgress[plr][AP_NOW  ] = now;

	if(concurrent) terminate;

	ACS_NamedExecuteAlways("QCDE_DoActiveInProgressCooldown", 0);
}

Script "QCDE_ShowActiveInProgress_CLIENTSIDE" (int duration, int now) clientside
{
	ACS("QCDE_ShowActiveInProgress", duration, now);
}

Script "QCDE_DoActiveInProgressCooldown" ()
{
	int plr = PlayerNumber();
	if (activeProgress[plr][AP_TOTAL] <= 0) terminate;
	int amount = 256 * activeProgress[plr][AP_NOW] / activeProgress[plr][AP_TOTAL];
	while(activeProgress[plr][AP_NOW] --> 0 && GetActorProperty(0, APROP_HEALTH) > 0)
	{
		if(CheckInventory("ActiveProgressToken") > amount) terminate; // allows preempting previously launched ability

		amount = 256 * activeProgress[plr][AP_NOW] / activeProgress[plr][AP_TOTAL];
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("ActiveProgressToken",amount);
		SetNetworkReplicationFlags( 0 );
		delay(1);
	}
	activeProgress[plr][AP_NOW] = 0;
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetInventory("ActiveProgressToken",0);
	SetNetworkReplicationFlags( 0 );
	//log(n:0, s:" completes progress: ", d:activeProgress[plr][AP_NOW], s:" / ", d:activeProgress[plr][AP_TOTAL]);
}

Script "QCDE_AbilityCooldown" (int in_tics, int dontPlayAlert)
{
	//log(s:"QCDE_AbilityCooldown - ", d:in_tics);

	// reconciling just to know how many tics to offset the cooldown
	// we add 2 to also compensate for a 1 to 2 tics delay for executing the script on clientside
	if (in_tics > -1 && GetNetworkState() == NETSTATE_SERVER) {
		in_tics -= UnlaggedReconcile(0) + 2;
		UnlaggedRestore(0);
		if (in_tics < 0)
			in_tics = 0;
	}

	int multiuse = GetMultiuse();
	int plr = PlayerNumber();
	int cooldownId = timer() * 100 + plr;
	//log(s:"Cooldown ", d:cooldownId, s:" runs, ", d:in_tics, s:", ", d:dontPlayAlert);

	if(in_tics != -1) // if not resuming
	{
		// Not starting a cooldown if either:
		// - Already in cooldown
		// - Ability is multiuse
		if(tics[plr] && !multiuse)
		{
			if (GetNetworkState() == NETSTATE_SERVER)
				ACS("QCDE_AbilityCooldown_CLIENTSIDE", tics[plr], false);
			terminate;
		}

		// For abilities that have multiple charges
		if(multiuse)
		{
			if(tics[plr] <= 0) // First grenade
			{
				in_tics = MultiusePeriod[plr];
			}
			else if(tics[plr] <= MultiusePeriod[plr] * (multiuse - 1)) // Up to last grenade
			{
				tics[plr] += MultiusePeriod[plr];
				//log(s:"Added period ", d:MultiusePeriod[plr], s:", is now ", d:GetCooldown(plr)));
				if (GetNetworkState() == NETSTATE_SERVER)
					ACS("QCDE_AbilityCooldown_CLIENTSIDE", tics[plr], false);
				terminate;
			}
			else // Out of charges
			{
				if (GetNetworkState() != NETSTATE_SERVER)
					LocalAmbientSound(GetMultiUseFailSound(), 127);
				//log(s:"Out of charges: ", d:tics[plr]), s:" > ", d:MultiusePeriod[plr], s:" * ", d:(multiuse - 1));
				SetResultValue(false); // signal to ability code that this sort of spam ain't gonna fly
				if (GetNetworkState() == NETSTATE_SERVER)
					ACS("QCDE_AbilityCooldown_CLIENTSIDE", tics[plr], false);
				terminate;
			}
		}
	}

	// Scale input according to percentage server cvar
	if(in_tics > -1) in_tics = in_tics * GetCvar("sv_cooldownPercentage") / 100;

	// If not resuming, set duration and prepare to play DING! on replenishment
	bool playAlert = false;
	if(in_tics > 0)
	{
		tics[plr] = in_tics;
		playAlert = true;

		if(!multiuse)
		{
			// Apply completionist bonus of reduced cooldown, if applicable
			int bonus = CheckInventory("CooldownRewardToken") + CheckInventory("CooldownRewardToken2");
			ACS_NamedExecuteAlways("QCDE_Hourglass",0,bonus,true);
		}
	}

	CapCooldown();

	while(CheckInventory("ActiveInProgress"))
		delay(1);

	//log(s:"QCDE_AbilityCooldown - Sending ", d:tics[plr]);
	if (GetNetworkState() == NETSTATE_SERVER)
		ACS("QCDE_AbilityCooldown_CLIENTSIDE", tics[plr], playAlert && !dontPlayAlert);
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown_DoCooldown", playAlert && !dontPlayAlert);
}

Script "QCDE_AbilityCooldown_CLIENTSIDE" (int in_tics, int playAlert) clientside
{
	if (PlayerNumber() != ConsolePlayerNumber())
		terminate;

	//log(s:"QCDE_AbilityCooldown_CLIENTSIDE - new: ", d:in_tics, s:", old: ", d:tics[PlayerNumber()]);

	if (in_tics == 0)
		SetInventory("AbilityCooldownToken",0);

	if (CheckInventory("Class_Corvus") || CheckInventory("Class_Keel")
		|| CheckInventory("Class_Freeman") || CheckInventory("Class_Lucienne")) {
		if (extraAbilityData[PlayerNumber()] > 0)
			extraAbilityData[PlayerNumber()]--;
		if (extraAbilityData[PlayerNumber()] > 0) {
			//log(s:"QCDE_AbilityCooldown_CLIENTSIDE - ignored");
			terminate;
		}
	}

	tics[PlayerNumber()] = in_tics;
	SetInventory("AbilityCooldownSeconds", in_tics / 35);
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown_DoCooldown", playAlert);
}

Script "QCDE_AbilityCooldown_DoCooldown" (int playAlert)
{
	int plr = PlayerNumber();
	//log(s:"QCDE_AbilityCooldown_DoCooldown - ", d:tics[plr]);

	if (tics[plr] > 0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("AbilityCooldownToken", 1);
		SetNetworkReplicationFlags( 0 );
	}

	if (cooldownActive[plr])
		terminate;

	cooldownActive[plr] = tics[plr] > 0;

	if(playAlert && GetNetworkState() != NETSTATE_SERVER)
		ACS("QCDE_AbilityIconFlash", no);
	// Actual countdown
	while(tics[plr] > 0)
	{
		SetActivator(-1);

		delay(1);

		if(!PlayerInGame(plr)) {
			cooldownActive[plr] = false;
			terminate;
		}

		SetActivator(plr + 1000);

		if(CheckInventory("ActiveInProgress")) continue;

		tics[plr] -= 1;

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );

		// Update charges count if ability is multi-usable
		int multiuse = GetMultiuse();
		if(multiuse)
		{
			int charges = multiuse - ((tics[plr] + (MultiusePeriod[plr] - 1)) / MultiusePeriod[plr]);
			SetInventory("MultiuseCharge", charges);
		}

		// Update second count if it changed
		SetInventory("AbilityCooldownSeconds", tics[plr] / 35);

		// Update decisecond count if it's relevant
		if(tics[plr] < 5 *35)
			SetInventory("AbilityCooldownDeciseconds", (tics[plr] % 35) * 10 / 35);

		SetNetworkReplicationFlags( 0 );
	}

	//log(s:"Cooldown ", d:cooldownId, s:" is done by ", d:Timer());
	tics[plr] = 0;
	cooldownActive[plr] = false;
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetInventory("AbilityCooldownToken",		0);
	SetInventory("AbilityCooldownSeconds",		0);
	SetInventory("AbilityCooldownDeciseconds",	0);
	SetInventory("TeleporterThrownToken",		0); // Reset Ranger orb
	SetNetworkReplicationFlags( 0 );

	if(playAlert && !CheckInventory("Class_Sarge"))
	{
		if (GetNetworkState() != NETSTATE_SERVER)
		{
			ACS("QCDE_AbilityIconFlash", yes);
		}
		else
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			PlaySound(0, "QC/Abilities/General/AbilityCharged", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
			SetNetworkReplicationFlags( 0 );
		}
	}
}

script "QCDE_AbilityIconFlash" (int sound) clientside
{
	if(IsZandronum(true))
		if(ActivatorTid() != CheckPlayerCamera(ConsolePlayerNumber()))
			terminate;

	SetHudSize(1400,1050,1);

	if(sound) AmbientSound("QC/Abilities/General/AbilityCharged",127);
	SetHudSize(1400,1050,1);
	SetFont("BLINKGL2");
	HudMessageBold(s:"A"; HUDMSG_FADEOUT, 3244, CR_UNTRANSLATED, 700.0, 911.0, 0.18, 0.2);
}

// Useful when switching from high cooldown champion to lower cooldown champion after using ability
Function void CapCooldown(void)
{
	if(CheckInventory("Class_Sarge")) return; // MAP31: DBThanatos says no cheating

	int plr = PlayerNumber();
	int perc = GetCvar("sv_cooldownPercentage");
	int baseCooldown = GetCooldown();
	if (tics[plr] > baseCooldown * perc / 100)
		tics[plr] = baseCooldown * perc / 100;
}

Script "nocd" (void) // cheat for debugging
{
	tics[PlayerNumber()] = 0;
}


