Actor PowerPlayerSpeed130 : PowerSpeed	{ Speed 1.30	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed125 : PowerSpeed	{ Speed 1.25	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed120 : PowerSpeed	{ Speed 1.20	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed115 : PowerSpeed	{ Speed 1.15	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed110 : PowerSpeed	{ Speed 1.10	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed105 : PowerSpeed	{ Speed 1.05	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed100 : PowerSpeed	{ Speed 1.00	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed95  : PowerSpeed	{ Speed 0.95	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed90  : PowerSpeed	{ Speed 0.90	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed85  : PowerSpeed	{ Speed 0.85	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed80  : PowerSpeed	{ Speed 0.80	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed75  : PowerSpeed	{ Speed 0.75	Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor PowerPlayerSpeed70  : PowerSpeed	{ Speed 0.70	Inventory.Icon "" +POWERSPEED.NOTRAIL }

Actor PlayerSpeed100 : PowerupGiver
{
	powerup.duration 0x77777777
	powerup.type "PowerPlayerSpeed100"
	Inventory.MaxAmount 0
	Inventory.InterHubAmount 0
	-COUNTITEM
	+INVENTORY.AUTOACTIVATE
	+SERVERNETID
}

Actor PlayerSpeed130 : PlayerSpeed100 { Powerup.Type "PlayerSpeed130" }
Actor PlayerSpeed125 : PlayerSpeed100 { Powerup.Type "PlayerSpeed125" }
Actor PlayerSpeed120 : PlayerSpeed100 { Powerup.Type "PlayerSpeed120" }
Actor PlayerSpeed115 : PlayerSpeed100 { Powerup.Type "PlayerSpeed115" }
Actor PlayerSpeed110 : PlayerSpeed100 { Powerup.Type "PlayerSpeed110" }
Actor PlayerSpeed105 : PlayerSpeed100 { Powerup.Type "PlayerSpeed105" }

Actor PlayerSpeed95  : PlayerSpeed100 { Powerup.Type "PlayerSpeed95"  }
Actor PlayerSpeed90  : PlayerSpeed100 { Powerup.Type "PlayerSpeed90"  }
Actor PlayerSpeed85  : PlayerSpeed100 { Powerup.Type "PlayerSpeed85"  }
Actor PlayerSpeed80  : PlayerSpeed100 { Powerup.Type "PlayerSpeed80"  }
Actor PlayerSpeed75  : PlayerSpeed100 { Powerup.Type "PlayerSpeed75"  }
Actor PlayerSpeed70  : PlayerSpeed100 { Powerup.Type "PlayerSpeed70"  }


// CSMA
Actor QCEverything : Pistol { +WEAPON.CHEATNOTWEAPON +INVENTORY.UNDROPPABLE }

Actor DeliverDeath
{
	//Projectile
	Damage (1000001)
	Obituary "$OB_ClassDisabled"
	DamageType "Disable"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_RearrangePointers(AAPTR_TARGET,AAPTR_TARGET,AAPTR_TARGET)
		TNT1 A 1 A_DamageMaster(1000001,"Disable")
	Death:
		TNT1 A 1
		Stop
	}
}
Actor DisableColor : Powerup
{
	Powerup.Colormap 2,2,2
	Powerup.Duration 0xDEADBEEF
}

// Used at the end of active abilities and starting a new level,
// to clean "active ability" tokens

Actor GenericActiveCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("ActiveInProgress",32767)
		TNT1 A 0 A_TakeInventory("ActiveProgressToken",32767)
		TNT1 A 0 A_TakeInventory("NoWeaponFireToken",32767)
		TNT1 A 0 A_TakeInventory("Radar")
		//TNT1 A 0 SetPlayerProperty(0,0,PROP_TOTALLYFROZEN)
		TNT1 A 35
		Stop
	}
}


// Used at each respawn in DM to enable body and projectile collisions --
// disabled by default for solo and coop.

Actor EnablePlayerCollisionProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("THRUSPECIES", 0)
		Stop
	}
}

Actor DisablePlayerCollisionProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeFlag("THRUSPECIES", 1)
		Stop
	}
}


