//--------------------------------------------------------
// Passive
//--------------------------------------------------------
Actor PowerCorvusRegen : PowerRegeneration
{
	//Inventory.Icon "IcnRegen"
}

Actor CorvusRegenerationDM : PowerupGiver	// 2 hp per second
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	Inventory.MaxAmount 0
	powerup.Type "CorvusRegen"
	Powerup.Strength 2
	powerup.duration 0x7FFFFFFF
}
Actor CorvusRegenerationCoop : PowerupGiver	// 4 hp per second, separate from DM to balance further if needed
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	Inventory.MaxAmount 0
	powerup.Type "CorvusRegen"
	Powerup.Strength 4
	powerup.duration 0x7FFFFFFF
}