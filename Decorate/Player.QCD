		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP24 ABCDEF 3
			RP24 B 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP24 ABCDEF 3
			QP24 B 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" G 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP24 G 12
			RP24 G 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP24 G 12
			QP24 G 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP24 H 6 BRIGHT Light("PlayerFiringLight")
			RP24 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP24 H 6 BRIGHT Light("PlayerFiringLight")
			QP24 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" L 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP24 L 4
			RP24 L 4 A_Pain
			RP24 L 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP24 L 4
			QP24 L 4 A_Pain
			QP24 L 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP24 M 5
		QP24 N 5 A_PlayerScream
		QP24 O 5 A_NoBlocking
		QP24 PQ 5
		QP24 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP24 M 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		QP24 N 5 A_XScream
		QP24 O 5 A_NoBlocking
		QP24 PQ 5
		QP24 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


//======================================================================================
//
//		25. Lucienne
//
//======================================================================================

Actor QCLucienne : QCPlayerLight
{
	Player.DisplayName "Lucienne"
	Player.SoundClass "Lucienne"
	Player.Palette "PL25"

	Scale 0.551

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Lucienne"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP25 C 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP25 C 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP25 C 0 A_JumpIf(true,                   "DefSpawn")
		QP25 C 100
		Loop

		ColoredSpawn:
			RP25 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP25 C 4
			Loop
		DefSpawn:
			QP25 A 0 A_JumpIf(momx||momy,"DefSee")
			QP25 C 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP25 ABCDCB 3
			RP25 B 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP25 ABCDCB 3
			QP25 B 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP25 E 12
			RP25 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP25 E 12
			QP25 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP25 F 6 BRIGHT Light("PlayerFiringLight")
			RP25 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP25 F 6 BRIGHT Light("PlayerFiringLight")
			QP25 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP25 G 4
			RP25 G 4 A_Pain
			RP25 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP25 G 4
			QP25 G 4 A_Pain
			QP25 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP25 H 5
		QP25 I 5 A_PlayerScream
		QP25 J 5 A_NoBlocking
		QP25 A 0 A_SpawnItemEx("LucienneWeapon", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP25 KLMN 5
		QP25 o -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP25 H 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		QP25 I 5 A_XScream
		QP25 J 5 A_NoBlocking
		QP25 A 0 A_SpawnItemEx("LucienneWeapon", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP25 KLMN 5
		QP25 O -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


Actor LucienneWeapon
{
	+CLIENTSIDEONLY
	+SERVERNETID
	-NOLIFTDROP
	-SOLID
	+DROPOFF
	+NOTELEPORT
	+CORPSE
	Scale 0.52
	Radius 6
	Height 5
	States
	{
	Spawn:
		QP25 P 6
		"####" "#" 175 //5sec
		"####" "#" 1 A_FadeOut
		Wait
	}
}




