	// Railgun charge
	inInventory RailgunCharges {
		drawImage "RGCHAR00", 668, 493;

		inInventory QCRailgunSkin, 8 {
			drawBar "SSCHARG1", "RGCHAR01", RailgunCharges, vertical  ,          667,363;
			drawBar "SSCHARG2", "RGCHAR02", RailgunCharges, horizontal,          654,493;
			drawBar "SSCHARG4", "RGCHAR04", RailgunCharges, vertical  , reverse, 668,433;
			drawBar "SSCHARG6", "RGCHAR06", RailgunCharges, horizontal, reverse, 654,493;
			drawBar "SSCHARG8", "RGCHAR08", RailgunCharges, vertical  ,          667,527;

			inInventory RailgunCharges, 52 { drawImage "SSCHARG0", 668, 493; }
		} else {
		inInventory QCRailgunSkin, 6 {
			drawBar "RGCHARG1", "RGCHAR01", RailgunCharges, vertical  ,          667,363;
