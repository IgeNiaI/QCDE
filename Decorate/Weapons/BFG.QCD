		DB61 KK 1 Light("BlackBigPoint3") Bright
		DB61 LL 1 Light("BlackBigPoint3") Bright
		TNT1 A 0 A_Explode(16,128,0)
		DB61 MM 1 Light("BlackBigPoint3") Bright
		DB61 NN 1 Light("BlackBigPoint3") Bright
		DB61 OO 1 Light("BlackBigPoint3") Bright
		TNT1 A 0 A_Explode(16,128,0)
		DB61 PP 1 Light("BlackBigPoint3") Bright
		DB61 QQ 1 Light("BlackBigPoint3") Bright
		DB61 RR 1 Light("BlackBigPoint3") Bright
		TNT1 A 0 A_Explode(16,128,0)
		DB61 SS 1 Light("BlackBigPoint3") Bright
		DB61 TT 1 Light("BlackBigPoint3") Bright
		DB61 UU 1 Light("BlackBigPoint3") Bright
		TNT1 A 0 A_Explode(16,128,0)
		DB61 VV 1 Light("BlackBigPoint3") Bright
		DB61 WW 1 Light("BlackBigPoint3") Bright
		DB61 XX 1 Light("BlackBigPoint3") Bright
		TNT1 A 0 A_Explode(16,128,0)
		Goto Spawn+1

	DeathFX:
		TNT1 A 0 A_PlaySound("QC/Weapons/BFG/Explo",CHAN_7,1,0,0.75)
		TNT1 A 0 A_SpawnItemEx("BFGQ4ExploEffect1",0,0,0,0,0,0)
		TNT1 AAAAAAAA 0 A_SpawnItemEx("BFGQ4ExploSmokeParticle",0,0,0,frandom(3.4,-3.4),frandom(3.4,-3.4),frandom(3.4,-3.4),random(0,359))
		TNT1 A 2
		TNT1 AAAAAA 1 A_SpawnItemEx("BFGQ4ExploSmokeParticle",0,0,0,frandom(3.4,-3.4),frandom(3.4,-3.4),frandom(3.4,-3.4),random(0,359))
		TNT1 A 6 A_SpawnItemEx("BFGQ4ExploEffect1",0,0,0,0,0,0)
		TNT1 A 6 A_SpawnItemEx("BFGQ4ExploEffect1",0,0,0,0,0,0)
		Stop
	}
}




// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCBFGDM : QCBFG
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_QCBFG" // "BFG 10k (DM)"
	Weapon.SelectionOrder 666 // highest
	Weapon.AmmoGive 10
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 5
}


Actor QCBFGShot_DM	//No AOE while flying
{
	Projectile
	Speed 45
	RenderStyle Add
	Alpha 0.99
	Scale 0.27
	Radius 6
	Height 12
	+FORCERADIUSDMG
	+FORCEXYBILLBOARD
	+SEEKERMISSILE
	Obituary "$OB_QCBFG"
	Decal "D4BFGScorchSmall"
	DamageType "BFGDamage"
	States
	{
	Spawn:
		DB73 A 0 NODELAY A_PlaySound("QC/Weapons/BFG/BallFlying",CHAN_7,0.6,true,2.5)
		DB73 ABCDEFGHIJKLMNO 1 Bright Light("GreenBigPoint3")
		Goto Spawn+1

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepMax",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		//Medals start
		TNT1 A 0 A_GiveToTarget("BFGDirectDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			//Medals start
			TNT1 A 0 A_GiveToTarget("BFGSplashDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			Goto DeathCont

	DeathCont:
		TNT1 A 0 A_Quake(3,15,0,768)
		TNT1 A 0 A_RadiusThrust(128,64,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,64,XF_HURTSOURCE,0,20)	//self damage. Beware
		TNT1 A 0 A_Explode(70,128,0,0,32)
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_Jump(256,"DeathFX")
		Goto DeathInvis

    DeathInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DeathFX:
		TNT1 A 0 A_PlaySound("QC/Weapons/BFG/Explo",CHAN_7,0.85,0,0.75)
		TNT1 A 0 A_SpawnItemEx("BFGExploRingSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 0 A_SpawnItemEx("BFGClassicExploSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		TNT1 A 2
		TNT1 AAA 1 A_SpawnItemEx("BFGExploLightningSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		Stop
	}
}

Actor QCBFGShot_DM_Quake4 : QCBFGShot_DM
{
	RenderStyle Normal
	Alpha 1.0
	Scale 1.0
	Decal "D4BFGScorchSmall"
	States
	{
	Spawn:
		BHOL A 0 NODELAY A_PlaySound("QC/Weapons/BFG/BallFlying",CHAN_7,0.6,true,2.5)
		"####" ABCDEFGHIJKL 1 Bright Light("DMGDarkness")
		Goto Spawn+1

	DeathFX:
		TNT1 A 0 A_PlaySound("QC/Weapons/BFG/Explo",CHAN_7,0.85,0,0.75)
		TNT1 A 0 A_SpawnItemEx("BFGQ4ExploEffect1",0,0,0,0,0,0)
		TNT1 AAAAAAAA 0 A_SpawnItemEx("BFGQ4ExploSmokeParticle",0,0,0,frandom(3.4,-3.4),frandom(3.4,-3.4),frandom(3.4,-3.4),random(0,359))
		Stop
	}
}
