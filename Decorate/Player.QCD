//======================================================================================
Actor QCDukeNukem : QCPlayerMedium
{
	Player.DisplayName "Duke Nukem" //Needed to have that space
	Player.SoundClass "DukeNukem"
	Player.Palette "PL14"

	Scale 0.692

	Player.FootstepInterval 10
	Player.FootstepVolume 0.625

	Player.MaxHealth 150
	Health 150

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_DukeNukem"
	Player.StartItem "Body_Medium"
	// Player.StartItem "ActiveOffensive" // Duke should select the ability as a weapon
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP14 E 0 nodelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP14 E 0 a_jumpifinventory("TeamColor",1, "ColoredSpawn")
		QP14 E 0 a_jumpif(true,                   "DefSpawn")
		QP14 E 100
		loop

		ColoredSpawn:
			RP14 A 0 a_jumpif(momx||momy,"ColoredSee")
			RP14 E 4 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			loop
		DefSpawn:
			QP14 A 0 a_jumpif(momx||momy,"DefSee")
			QP14 E 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 a_jumpifinventory("TeamColor",1, "ColoredSee")
		"####" A 1 a_jumpif(true,                   "DefSee")
		goto DefSee // for preview screen and prediction

		ColoredSee:
			RP14 ABCD 4 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP14 A 0 a_jumpif(true,"ColoredSpawn")
			loop
		DefSee:
			QP14 ABCD 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP14 A 0 a_jumpif(true,"SpawnLoop") // to catch color
			loop

	Missile:
		"####" A 0 a_jumpifinventory("TeamColor",1, "ColoredMissile")
		"####" E 1 a_jumpif(true,                   "DefMissile")
		loop

		ColoredMissile:
			RP14 EEEE 3 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP14 E 12 a_jumpif(true, "SpawnLoop")
			loop
		DefMissile:
			QP14 EEEE 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP14 E 12 a_jumpif(true, "SpawnLoop")
			loop

		ColoredPuncheroo:
			RP14 GH 5
			RP14 H 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPuncheroo:
			QP14 GH 5
			QP14 H 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 a_jumpifinventory("TeamColor",1, "ColoredMelee")
		"####" F 1 a_jumpif(true,                   "DefMelee")
		loop

		ColoredMelee:
			RP14 F 6 bright light("playerfiringlight")
			RP14 F 6 bright light("playerfiringlight") a_jumpif(true, "SpawnLoop")
			loop
		DefMelee:
			QP14 F 6 bright light("playerfiringlight")
			QP14 F 6 bright light("playerfiringlight") a_jumpif(true, "SpawnLoop")
			loop

	Pain:
		"####" A 0 a_jumpifinventory("TeamColor",1, "ColoredPain")
		"####" G 1 a_jumpif(true,                   "DefPain")
		loop

		ColoredPain:
			RP14 B 4
			RP14 B 4 a_Pain
			RP14 B 4 a_jumpif(true, "SpawnLoop")
			loop
		DefPain:
			QP14 B 4
			QP14 B 4 a_Pain
			QP14 B 4 a_jumpif(true, "SpawnLoop")
			loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP14 I 5 A_PlayerScream
		QP14 J 5 A_NoBlocking
		QP14 KLM 5
		QP14 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP14 O 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP14 I 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP14 J 5 A_NoBlocking
		QP14 KLM 5
		QP14 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


//======================================================================================
//
//		15. Durandal, the AI in a Mjolnir battleroid
//
//======================================================================================
Actor QCDurandal : QCPlayerLight
{
	Player.DisplayName "Durandal"
	Player.SoundClass "Durandal"
	Player.Palette "PL15"

	XScale 0.7
	YScale 0.65

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Durandal"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveDefensive"
	Player.StartItem "NotSpectator"

	DamageFactor "BobExploSP", 0.2599 //takes 1/4 of SP bob explo damage

	States
	{
	Spawn:
		QP15 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP15 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP15 A 0 A_JumpIf(true,                   "DefSpawn")
		QP15 A 100
		Loop

		ColoredSpawn:
			RP15 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP15 A 4
			Loop
		DefSpawn:
			QP15 A 0 A_JumpIf(momx||momy,"DefSee")
			QP15 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP15 BCDE 4
			RP15 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP15 BCDE 4
			QP15 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP15 F 12
			RP15 F 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP15 F 12
			QP15 F 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" G 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP15 G 6 BRIGHT Light("PlayerFiringLight")
			RP15 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP15 G 6 BRIGHT Light("PlayerFiringLight")
			QP15 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" A 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP15 A 4
			RP15 A 4 A_Pain
			RP15 A 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP15 A 4
			QP15 A 4 A_Pain
			QP15 A 4 A_JumpIf(true, "SpawnLoop")
			Loop
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP15 H 5 A_PlayerScream
		QP15 I 5 A_NoBlocking
		QP15 JKLM 5
		QP15 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP15 O 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP15 P 4 A_NoBlocking
		QP15 QR 4
		QP15 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


