//-------------------------------------------------------------------------------------------
//
// The main menu. There's a lot of differences here between the games
//
//-------------------------------------------------------------------------------------------

LISTMENU "MainMenu"
{
	Selector "CURSOR1", -97, 0
	StaticPatch 0, -1, "MENUBACK"

	IfGame(Doom, Chex)
	{
		StaticPatch 94, 2, "M_DOOM"
		Position 97, 72	//already positioned for "read this" being always there
	}
	IfGame(Strife)
	{
		StaticPatch 84, 2, "M_STRIFE"
		Position 97, 45
	}
	IfGame(Heretic)
	{
		StaticPatch 88, 0, "M_HTIC"
		StaticPatch 40, 10, "M_SKL01"
		StaticPatch 232, 10, "M_SKL00"
		Position 110, 56
	}
	IfGame(Hexen)
	{
		StaticPatch 88, 0, "M_HTIC"
		StaticPatch 37, 80, "FBULB0"
		StaticPatch 278, 80, "FBULA0"
		Position 110, 56
	}

	IfGame(Doom, Strife, Chex)
	{
		PatchItem "Q_NEWGAM", "n", "PlayerclassMenu"
		ifOption(SwapMenu)
		{
			PatchItem "Q_LOADG", "l", "LoadGameMenu"
			PatchItem "Q_SAVEG", "s", "SaveGameMenu"
			PatchItem "Q_CHAMP", "p", "QCDEPlayerMenu"
			PatchItem "Q_QCDEOP","c", "QCDEOptions"
			PatchItem "Q_OPTION","o", "OptionsMenu"
			PatchItem "Q_RDTHIS","r", "ReadThisMenu"
		}
		else
		{
			PatchItem "Q_CHAMP", "p", "QCDEPlayerMenu"
			PatchItem "Q_QCDEOP", "c", "QCDEOptions"
			PatchItem "Q_OPTION","o", "OptionsMenu"
			PatchItem "Q_LOADG", "l", "LoadGameMenu"
			PatchItem "Q_SAVEG", "s", "SaveGameMenu"
			PatchItem "Q_RDTHIS","r", "ReadThisMenu"
		}
		PatchItem "Q_QUITG", "q", "QuitMenu"
	}

	IfGame(Heretic, Hexen)
	{
		TextItem "$MNU_NEWGAME", "n", "PlayerclassMenu"
		TextItem "$MNU_OPTIONS", "o", "OptionsMenu"
		TextItem "$MNU_GAMEFILES", "g", "GameFilesMenu"
		TextItem "$MNU_INFO", "i", "ReadThisMenu"
		TextItem "$MNU_QUITGAME", "q", "QuitMenu"
	}
}

ListMenu "EpisodeMenu"
{
	IfGame(Doom, Heretic, Hexen, Strife)
	{
		NetgameMessage "$NEWGAME"
	}
	IfGame(Chex)
	{
		NetgameMessage "$CNEWGAME"
	}

	IfGame(Doom, Chex)
	{
		Position 48, 63
		StaticText 54, 38, "CHOOSE EPISODE"
	}
	IfGame(Strife)
	{
		Position 48, 63
		StaticText 54, 38, "$MNU_EPISODE"
	}
	IfGame(Heretic, Hexen)
	{
		Position 80, 50
	}
	// items will be filled in by MAPINFO
}



OptionMenu "QCDEOptions"
{
	Title 			"QCDE OPTIONS"
	StaticText 	"QCDE Keybinds",1
	Control "Use active ability",     "+QCDE_ActiveAbility"
	Control "Champion information",   "+QCDE_ClassInfo"
	Control "Voice line",             "voice"
	Control "Drop weapon upgrade",    "drop_upgrade"
	Control "MP: change class menu",  "mpclassmenu"
	Control "Select starting weapon", "+QCDE_StartingWeapon"
	Submenu 	"Weapon Binding",     "QCDEWeaponBinds"
	StaticText 	""
	Option "Starting weapon",         "cl_startingWeapon", "StartingWeapon"
	StaticText 	""
	StaticText 	"Monster Set Selection",1
	Option    "Quake 1", "theme0", "YesNo"
	Option    "Quake 2", "theme1", "YesNo"
	Option    "Quake 4", "theme2", "YesNo"
	Option       "Doom", "theme3", "YesNo"
	Option  "Doom 2016", "theme4", "YesNo"
	StaticText 	""
	Option  "Shuffle mode"  , "qc_shuffleMode",   "ShuffleMode"
	Option  "Skirmish Rogue", "qc_skirmishRogue", "YesNo"
	Submenu "Custom themes (if loaded)", "QCDECustomThemes"
	StaticText 	""
	StaticText 	""
	StaticText 	"                  Advanced settings",1
	StaticText 	""
	Submenu 	"Engine (GZD, Zand) Shortcuts",		"GZDShortcuts"
	StaticText 	""
	StaticText 	"Gameplay Settings",1
	Option "Auto-open lootboxes",     "cl_autoOpenLootboxes",  "OnOff"
	Option "Damage numbers",          "sv_ShowDamageNumbers",  "OnOff"
	Slider "Player speed percentage", "sv_PlayerSpeed",        70, 130, 5
	Slider "PvP auto-join bots",      "sv_MinPlayers",         0, 4, 1
	StaticText 	""
	StaticText 	"HUD",1
	Option "Crosshair type",			"crosshair",           "Crosshairs"
	Option "Speedometer",				"cl_speedometer",      "OnOff"
	Option "Weapon bar (16:9)",			"cl_showWeaponBar",    "OnOff"
	Option "Health bar style",			"cl_barStyle",         "BarStyle"
	Option "Low ammo warning",			"cl_lowAmmoWarning",   "LowWarning"
	Option "Low health warning",		"cl_lowHealthWarning", "LowWarning"
	Option "Cooperative markers",		"cl_allyMarkers",      "OnOff"
	Slider "Spectator scoreboard size",	"cl_specScores",       0, 64, 1
	StaticText 	""
	StaticText 	"Visual",1
	Option "Weapon hit-markers",		"cl_hitmarker",			"OnOff"
	Option "Blood smears",         		"cl_ShowHUDBloodSmears", "OnOff"
	Option "LG beam transparency (DM)", "cl_lgtransparency",     "LGTransp"
	Option "Weapon firing recoil", 		"cl_weaponrecoil",       "OnOff"
	Option "Weapon firing flash",  		"cl_weaponfireflash",    "OnOff"
	StaticText 	""
	StaticText 	"Sound",1
	Option "Weapon hit-beeps",			"cl_hitbeep",				"OnOff"
	Slider "Taunt chance",				"cl_autoTaunt", 			0, 50, 1
	Option "Taunt subtitles",			"cl_tauntSubtitles",		"TauntSubtitles"
	Option "OST enabled (if loaded)",	"snd_qcdemus",				"OnOff"
	Option "OST playback order",		"snd_randommus",			"OSTorder"
	StaticText ""
	StaticText "Per-champion settings",1
	Slider "Inquisitor/Lo Wang tap time", "cl_clutchTapMax",  1, 35, 1
	Option "Eradicator Radar mode",       "cl_radarMode",    "RadarMode"
	StaticText ""
}


Optionmenu GZDShortcuts
{
	Title "Engine Option Shortcuts"
	StaticText "Visual Options",1
	StaticText ""
	StaticText "Sprite clipping: \"Never\" recommended"
	Option "Adjust sprite clipping",	gl_spriteclip,			"SpriteclipModes"
	Option  "Zandronum medals", "cl_medals", "OnOff"
	StaticText ""
	Slider "Move bobbing intensity",	"Movebob", 			  0,  0.75, 0.02, 2
	StaticText ""
	StaticText "Jump, Crouch and Freelook toggles",1
	Option "Allow jump",			"sv_jump"    , "JumpCrouchFreeLook"
	Option "Allow crouch",			"sv_crouch"  , "JumpCrouchFreeLook"
	Option "Allow freelook",		"sv_freelook", "JumpCrouchFreeLook"
	StaticText ""
	StaticText "Performance Options",1
	StaticText "The smaller the values, the better"
	StaticText "performance will be."
	StaticText ""
	Option "FPS counter",				"vid_fps",			"OnOff"
	StaticText ""
	Slider "Number of particles",		"r_maxparticles", 	100, 30000,  100, 0
	Slider "Number of decals",			"cl_maxdecals", 	  0, 10000,  100, 0
	StaticText ""
	StaticText "Giblets queue amount",1
	StaticText "Limits how many gibs will exist on the"
	StaticText "world at any time. Does NOT change "
	StaticText "the max gore spawned per x-death."
	Slider "Max Giblets (modify by 1)",				"sv_corpsequeuesize", 1, 256, 1.0, 0
	Slider "Max Giblets (modify by 10)",			"sv_corpsequeuesize", 1, 256, 10.0, 0
}


OptionMenu "QCDEWeaponBinds"
{
	Title "Customize Weapon Bindings"
	StaticText ""
	StaticText 	"By slot", 1
	Control "Slot 1: Gauntlet",						"Slot 1"
	Control "Slot 2: Machinegun, Heavy Machinegun",	"Slot 2"
	Control "Slot 3: Shotgun, Super Shotgun",		"Slot 3"
	Control "Slot 4: Nailgun, Super Nailgun",		"Slot 4"
	Control "Slot 5: Tribolt, Rocket Launcher",		"Slot 5"
	Control "Slot 6: Lightning Gun",				"Slot 6"
	Control "Slot 7: Railgun",						"Slot 7"
	Control "Slot 8: BFG",							"Slot 8"
	StaticText ""
	StaticText 	"By specific weapon, if you want to separate the", 1
	StaticText 	"Tribolt and Rocket Launcher or Shotgun and SSG", 1
	Control "Tribolt",			"use QCTriboltDM; wait; use QCTribolt"
	Control "Rocket Launcher",	"use QCRocketLauncherDM; wait; use QCRocketLauncher"
	Control "Shotgun",			"use QCShotgunDM; wait; use QCShotgun"
	Control "Super Shotgun",	"use QCSuperShotgunDM; wait; use QCSuperShotgun"
	StaticText ""
	StaticText 	"NOTE: There's no need to separate the Nailgun and SNG or"
	StaticText 	"the Machinegun and SMG, since the *super* version of the"
	StaticText 	"weapon replaces the weaker one. This is also true for"
	StaticText 	"Shotgun and SSG in deathmatch, but not in single player."
}

ListMenu "QCDEPlayerMenu"
{
	StaticTextCentered 160, 0, "PLAYER CLASS SETUP"
	Font "SmallFont"
	StaticTextCentered 160, 30, "Changes apply after respawn and clear inventory."

	Linespacing 14
	Position 32, 56

	Linespacing 28
	Font "BigFont"
	ValueText "Champion : ", "Class"

	Linespacing 14
	Font "SmallFont"
	PlayerNameBox "Name", 0, "Playerbox"
	Selector "-", -16, -1
	MouseWindow 0, 220
	PlayerDisplay 220, 100, "20 00 00", "80 00 40", 1, "PlayerDisplay"

	ValueText "Team", "Team"
	ValueText "Gender", "Gender", "Gender"
	ValueText "Autoaim", "Autoaim", "Autoaim"
	ValueText "Switch on pickup", "Switch", "OffOn"
	ValueText "Always Run", "AlwaysRun", "OnOff"
	ValueText "Skin (ignore)", "Skin"
	Class "PlayerMenu"
}

