//----------------------------------------------------------------------
// DBT's trick of the day:
// Bots aren't great at navigating a map, and definitely very dumb when
// it's about them getting to some point of relevance in a map: jump pad,
// for example. However, adding this little bait in a jumppad makes the
// bots try to pick it because "OH MY! A POWERUP! GIMME!" and therefore
// "effectively" (AKA hackishly) making them go for it
//----------------------------------------------------------------------

Actor PowerBotBaiter : PowerProtection	{	DamageFactor "Normal", 1.0	}

Actor QCDEBotBait : PowerupGiver 16499
{
	//$NotAngled
	//$Category "QCDE Misc"
	//$Color 19
	//$Title "Bot Bait"
	+INVENTORY.QUIET
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "PowerBotBaiter"
	powerup.duration 35
	Inventory.RespawnTics 210 // 6 seconds
	Scale 0.2
	RenderStyle Add
	Alpha 0.01
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_StopSound(1)	//stops respawn sound
		TNT1 A 0 A_StopSound(2)
		TNT1 A 0 A_StopSound(3)
		TNT1 A 0 A_StopSound(4)
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_StopSound(7)
		TNT1 A 0 A_StopSound(8)
		SARG A -1
		Loop
	}
}
//-----------------------------------------------------------------
// Blood pool healer thing for Quake Champions maps
//-----------------------------------------------------------------

Actor QCDEBloodPoolHealer160 16515
{
	//$NotAngled
	//$Category "QCDE Misc"
	//$Color 16
	//$Title "BldPool Healer 160"
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 35 A_RadiusGive("BloodPoolHealth",160,RGF_PLAYERS)
		Loop
	}
}

Actor BloodPoolHealth : CustomInventory
{
	+INVENTORY.QUIET
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("PowerGhostTint",1,"Nope")
		TNT1 A 0 A_GiveInventory("BloodPoolHealthGiven",1)
		TNT1 A 35 A_SetBlend("SkyBlue", 0.05, 10)
		Stop
	Nope:
		TNT1 A 35
		Stop
	}
}

Actor BloodPoolHealthGiven : Health
{
	Inventory.Amount 5
	+INVENTORY.QUIET
	+NONETID
	States
	{
		Spawn:
		STIM A -1
		Stop
	}
}

