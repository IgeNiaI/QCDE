		CheckInventory("Class_Brock"		);
	// ^ insert more classes here

	if(mustbe1 > 1)
		while(!NamedRequestScriptPuke("QCDE_KMP", GetCvar("playerclass"), secretkey));
}

Script "QCDE_KMP" (int to, int security) NET
{
	int plr = PlayerNumber();

	if(security == secretkey)
		if(!SetPlayerLivesLeft(plr, GetPlayerLivesLeft(plr) + 1))
			log(s:"\c[red]QCDE ERROR: Failed to reimburse life to player ", n:0, s:" \c[red]killed by class switch.");

	DamageThing(0,0);
	ACS_NamedExecuteAlways("QCDE_ChangeClass_Hint", 0, to);
}



// Activator: Player
script "QCDE_InitLMS" (void)
{
	if(!(GetCvar("lastmanstanding") || GetCvar("teamlms"))) terminate;

	int overheal = 75;
	int maxArmor = ACS("MaxArmor");

	if(CheckInventory("Class_Sarge"))	{	overheal += 25;	maxArmor += 25;	}
	if(CheckInventory("Class_Postal"))	{	overheal += 25;					}
	if(CheckInventory("Class_Lucienne")){	maxArmor += 25;					}
	if(CheckInventory("Class_Brock"))	{	overheal += 24;	maxArmor -= 25;	}

	ACS("HealthGiver", ACS("MaxHealth"), 200, overheal);
	ACS("ArmorGiver", maxArmor, 200, true);
}



// Activator: Player
script "QCDE_UpdateLives" (void)
{
	if(!(
		getcvar("lastmanstanding") ||
		getcvar("teamlms") ||
		getcvar("survival") ||
		(getcvar("invasion") && getcvar("sv_maxlives") > 0)
	)) terminate;

	SetInventory("LifeToken", GetPlayerLivesLeft(PlayerNumber()) + 1);
}

script "AddLives" (int how_many, int plr)
{
	int a = 0, b = 63;
	if(plr) { a = plr; b = plr; }
	if(!how_many) { how_many = 1; }
	for(int i = a; i <= b; i++)
	{
		SetActivatorToPlayer(i);
		SetPlayerLivesLeft(i, GetPlayerLivesLeft(i) + how_many);
		ACS("QCDE_UpdateLives");
	}
}

// Activator: Player
script "QCDE_ReduceLife" DEATH
{
	if(!(getcvar("lastmanstanding") || getcvar("teamlms") || getcvar("survival"))) terminate;

	TakeInventory("LifeToken", 1);
}



Script "QCDE_UndropDuringInit" (void)
{
	if(Timer()) terminate;

	GiveInventory("UndroppedProc", 1);
}



Script "QCDE_DM_PlayerCollision" (void)
{
	if (GameType() < GAME_NET_DEATHMATCH) terminate; // only if game is DM

	GiveInventory("EnablePlayerCollisionProc", 1);
}



