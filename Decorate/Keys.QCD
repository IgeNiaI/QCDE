
Actor CompatVer30_Keys {} // for compatibility checks

Actor QCRedCard : CustomInventory replaces RedCard
{
	Scale .55
	Inventory.PickupMessage "$GOT_QCRedCard" // "Picked up the Red keycard."
	Inventory.PickupSound "QC/Items/KeyCardPickup"
	Tag "$TAG_QCRedCard" // "Red Card"
	States
	{
	Spawn:
		TNT1 A 0 NodeLay ACS_NamedExecuteWithResult("QCDE_KeySpawned")
	Idle:
		KCRR ABCDEEEDCBAA 3 Bright
		Loop
	Pickup:
		TNT1 A 0 A_JumpIf(CallACS("MultiplayerCheck") > 0, "Infinite")
		TNT1 A 0 A_GiveInventory("RedCard",1)
		Stop
	Infinite:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_GiveKey",1)
		Stop
	}
}

