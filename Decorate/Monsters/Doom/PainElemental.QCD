Actor QCPainElemental : QCDE_MonsterMedium 15412
{
	//$Angled
	//$Category "QCDE Monsters: Doom"
	//$Color 12
	//$Title "Pain Elemental"
	Tag "$TAG_QCPainElemental" // "Pain elemental"
	DropItem "Hourglass", 48

	Health 400
	Radius 31
	Height 56
	Mass 400
	Speed 8
	PainChance 128
	Monster
	+FLOAT
	+NOGRAVITY
	SeeSound "pain/sight"
	PainSound "pain/pain"
	DeathSound "pain/death"
	ActiveSound "pain/active"
	States
	{
	Idle:
		PAIN A 10 A_Look
		Loop
	See:
		PAIN AABBCC 3 A_Chase
		Loop
	Missile:
		PAIN D 5 A_FaceTarget
		PAIN E 5 A_FaceTarget
		PAIN F 4 BRIGHT A_FaceTarget
		PAIN F 1 BRIGHT A_PainAttack("QCLostSoul")
		Goto See
	Pain:
		PAIN G 6
		PAIN G 6 A_Pain
		Goto See
	DeathChecksDone:
		PAIN H 8 BRIGHT
		PAIN I 8 BRIGHT A_Scream
		PAIN JK 8 BRIGHT
		PAIN L 8 BRIGHT A_PainDie("QCLostSoul")
	Death.Corpse: //just to not spew error of missing state
		PAIN M 8 BRIGHT
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		PAIN MLKJIH 8
		Goto See
	}
}