//---------------------------------
//		Nyx's Active

#define NYX_TRAIL_LENGTH 10
Script "QCDE_Ability_Nyx" (void)
{
	// Saving position to ghost-recall to if stuck
	int ox = GetActorX(0);
	int oy = GetActorY(0);
	int oz = GetActorZ(0);

	// Begin
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GhostWalkInProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration() + NYX_TRAIL_LENGTH);
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	// Disable remaining damage over time from possible Quietus hit or Postal's cow head
	quieting_for[PlayerNumber()] = 0;
	cowgassing_for[PlayerNumber()] = 0;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0, "QC/Abilities/Nyx/GhostWalkStart", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
	SetNetworkReplicationFlags( 0 );

	// First loop: leaving slight trail
	int counter;
	while(counter++ < NYX_TRAIL_LENGTH) //for first N tics, it will spawn a trail every tic
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("GhostWalkTrailProc",1);
		SetNetworkReplicationFlags( 0 );
		delay(1);
	}

	// Main loop
	counter=0;
	while(counter <= GetDuration())
	{
		delay(5);
		counter += 5;
	}

	// Exit at destination
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GhostWalkOutProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteAlways("QCDE_RestoreIndicator",0);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0, "QC/Abilities/Nyx/GhostWalkEnd", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
	SetNetworkReplicationFlags( 0 );

	// Stuck check (not in PVP)
	if(IsPVP()) terminate;

	int nx = GetActorX(0);
	int ny = GetActorY(0);
	int nz = GetActorZ(0);
	SetActorVelocity(0, 0.1,0.1,0.1, true,true);
	delay(1);
	if(GetActorX(0) != nx || GetActorY(0) != ny || GetActorZ(0) != nz) terminate;
	SetActorVelocity(0, -0.2,-0.2,-0.2, true,true);
	delay(1);
	if(GetActorX(0) != nx || GetActorY(0) != ny || GetActorZ(0) != nz) terminate;

	// Got stuck, activate Ghost Recall
	SetActorPosition(0, ox,oy,oz, 0);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GhostWalkOutProc",1);
	SetNetworkReplicationFlags( 0 );
}



