$pitchshiftrange 0

//*********************************************************************************
//*********************************************************************************
// 		Menu Sounds
//*********************************************************************************
//*********************************************************************************

menu/activate		"Sounds/UI/Menu/PlayNow.ogg"	// Activate a new menu
menu/backup			"Sounds/UI/Menu/ClickBack.ogg"	// Backup to previous menu
menu/prompt			dsswtchn	// Activate a prompt "menu"
menu/cursor			"Sounds/UI/Menu/KeyboardSelect.ogg"	// Move keyboard cursor
menu/hover			"Sounds/UI/Menu/MouseHover.ogg"		// Mouse hover
menu/change			"Sounds/UI/Menu/TickSmallIn.ogg"	// Select new value for option
menu/invalid		dsoof		// Menu not available
menu/dismiss		"Sounds/UI/Menu/TickSmallOut.ogg"	// Dismiss a prompt message
menu/choose			"Sounds/UI/Menu/ClickForward.ogg"	// Choose a menu item
menu/clear			"Sounds/UI/Menu/PlayNow.ogg"	// Close top menu


intermission/tick			"Sounds/UI/Menu/ScoreLoop.ogg"
intermission/cooptotal		"Sounds/UI/Menu/ConfirmChamp.ogg"
intermission/pastdmstats	"Sounds/UI/Menu/ConfirmChamp.ogg"
intermission/nextstage		"Sounds/UI/Menu/MatchFound.ogg"
intermission/paststats		"Sounds/UI/Menu/ConfirmChamp.ogg"
intermission/pastcoopstats	"Sounds/UI/Menu/ConfirmChamp.ogg"

menu/quit1	"Sounds/UI/Menu/ObeliskCaptured.ogg"
menu/quit2	"Sounds/UI/Menu/ObeliskCaptured.ogg"

Map/Completionist/Backpack		"Sounds/UI/Complet_Backpack.ogg"
Map/Completionist/Chest			"Sounds/UI/Complet_Chest.ogg"
Map/Completionist/Reliquary		"Sounds/UI/Complet_Reliquary.ogg"
Map/Completionist/Reveal		"Sounds/UI/Complet_Reveal.ogg"
Map/Completionist/Acquire		"Sounds/UI/Complet_Acquire.ogg"

Map/MonstersKilled	"Sounds/UI/Map_MonstersKilled.ogg"
Map/SecretsFound	"Sounds/UI/Map_AllSecrets.ogg"

Map/CTF/FlagCaptureFriendly		"Sounds/UI/Flag_capture_friendly.ogg"
Map/CTF/FlagCaptureHostile		"Sounds/UI/Flag_pickup_Hostile.ogg"
Map/CTF/FlagDeliverFriendly		"Sounds/UI/Flag_deliver_friendly.ogg"
Map/CTF/FlagDeliverHostile		"Sounds/UI/Flag_deliver_Hostile.ogg"
Map/CTF/FlagReset				"Sounds/UI/Flag_reset.ogg"
Map/CTF/FlagSpawn				"Sounds/UI/Flag_spawn.ogg"

