Actor RicochetProjectile
{
	Projectile
	+RIPPER
	Speed 0
	Damage 4
	Radius 1
	Height 1
	-NOGRAVITY
	+ROCKETTRAIL
	+BLOODLESSIMPACT
	+PAINLESS
	+DONTBLAST
	RenderStyle Add
	Gravity 0.4
	Scale 0.1
	DamageType "ZombieGibber"
	ProjectileKickBack 0
	States
	{
	Spawn:
		X029 A 1 Bright
		Loop
	Death:
		TNT1 A 3
		Stop
	}
}

Actor RicochetProjectile_Modded : RicochetProjectile
{
	States
	{
	Spawn:
		MDYB B 1 Bright
		Loop
	}
}
