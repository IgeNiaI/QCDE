//---------------------------------
//		Doomslayer's Active

Script "QCDE_Ability_Doomslayer" (void)
{
	int w;
	for(w = 0; w < NUMBER_OF_WEAPONS; w++)
		if(!stricmp(getWeapon(), weaponList[w]))
			break;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("SlayerBFGProc",1);
	PlaySound(0,"QC/Abilities/Doomslayer/BFGWeaponRaise",CHAN_7,0.75,false,0.5);
	SetNetworkReplicationFlags( 0 );
	ACS("QCDE_SetWeapon", "SlayerBFG", 80);

	while(CheckInventory("BFGstarted")<1)	//token is given by the weapon. This is to ensure the meter starts when the weapon is out
		delay(1);							//because if you fire a RG, RG animation has to end before the weapon is switched
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	//total duration is 83
	//firing delay is 34
	//remaining time is 83-34=49

	Delay(34);

	int t = 35;

	while(t --> 0)
	{
		if(GetActorProperty(0,APROP_HEALTH) <= 0) break;
		delay(1);
	}

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	//Unzoom if using toggle zoom
	if (!GetCVar("cl_holdZoom")) SetInventory("WeaponZoomedToken", 0);
	//Give and select fake weapon
	SetWeapon(weaponList[w]);
	//Remove ability weapon
	TakeInventory("SlayerBFG",1);
	TakeInventory("BFGstarted",1);
	GiveInventory("SlayerBFGCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}


