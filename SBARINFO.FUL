	inInventory QCMachinegun 	|| QCMachinegunDM	{ 	inInventory not QCHeavyMachinegun 	|| QCHeavyMachinegunDM	{ isSelected QCMachinegun 	, QCMachinegunDM	{ drawBar "1ACHINEG", "0ACHINEG", QCBulletAmmo	, horizontal, 1480,280; } else { drawBar "MACHINEG", "0ACHINEG", QCBulletAmmo	, horizontal, 1480,280; } } } else { inInventory not QCHeavyMachinegun 	|| QCHeavyMachinegunDM	{ drawImage "0ACHINEG", 1480,280; } }
