	{
	Spawn:
		QP29 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP29 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP29 A 0 A_JumpIf(true,                   "DefSpawn")
		QP29 A 100
		Loop

		ColoredSpawn:
			RP29 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP29 A 4
			Loop
		DefSpawn:
			QP29 A 0 A_JumpIf(momx||momy,"DefSee")
			QP29 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP29 ABCD 4
			RP29 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP29 ABCD 4
			QP29 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP29 E 12
			RP29 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP29 E 12
			QP29 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" L 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP29 L 6 BRIGHT Light("PlayerFiringLight")
			RP29 L 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP29 L 6 BRIGHT Light("PlayerFiringLight")
			QP29 L 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" F 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" F 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP29 F 4
			RP29 F 4 A_Pain
			RP29 F 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP29 F 4
			QP29 F 4 A_Pain
			QP29 F 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP29 G 5
		QP29 H 5 A_PlayerScream
		QP29 I 5 A_NoBlocking
		QP29 J 5
		QP29 K -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP29 G 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP29 H 5 //A_XScream
		QP29 I 5 A_NoBlocking
		QP29 J 5
		QP29 K -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}





//======================================================================================
//
//		30. Painkiller. AKA Daniel Garner
//
//======================================================================================
Actor QCPainkiller : QCPlayerMedium
{
	Player.DisplayName "Painkiller"
	Player.SoundClass "Painkiller"
	Player.Palette "PL30"

	Scale 0.75

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor50"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 125

	Player.StartItem "Class_Painkiller"
	Player.StartItem "Body_Medium"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP30 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP30 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP30 A 0 A_JumpIf(true,                   "DefSpawn")
		QP30 A 100
		Loop

		ColoredSpawn:
			RP30 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP30 A 4
			Loop
		DefSpawn:
			QP30 A 0 A_JumpIf(momx||momy,"DefSee")
			QP30 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" B 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" B 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP30 BCDE 4
			RP30 B 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP30 BCDE 4
			QP30 B 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" F 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP30 F 12
			RP30 F 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP30 F 12
			QP30 F 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" G 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP30 G 6 BRIGHT Light("PlayerFiringLight")
			RP30 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP30 G 6 BRIGHT Light("PlayerFiringLight")
			QP30 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" H 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP30 H 4
			RP30 H 4 A_Pain
			RP30 H 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP30 H 4
			QP30 H 4 A_Pain
			QP30 H 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		QP30 I 0 A_ChangeFlag("BRIGHT",0)
		QP30 I 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP30 I 0 A_StopSound(CHAN_6)
		QP30 I 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP30 I 0 A_SetScale(0.74)
		QP30 I 6
		QP30 I 0 A_SetScale(0.73)
		QP30 J 6 A_PlayerScream
		QP30 I 0 A_SetScale(0.72)
		QP30 K 6 A_NoBlocking
		QP30 I 0 A_SetScale(0.71)
		QP30 L 6
		QP30 I 0 A_SetScale(0.70)
		QP30 M 6
		QP30 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		QP30 I 0 A_ChangeFlag("BRIGHT",0)
		QP30 I 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP30 I 0 A_StopSound(CHAN_6)
		QP30 I 0 A_XScream
		QP30 I 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP30 I 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP30 I 0 A_SetScale(0.74)
		QP30 J 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP30 I 0 A_SetScale(0.73)
		QP30 K 5
		QP30 I 0 A_SetScale(0.72)
		QP30 L 5 A_NoBlocking
		QP30 I 0 A_SetScale(0.71)
		QP30 M 5
		QP30 I 0 A_SetScale(0.70)
		QP30 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


//======================================================================================
//
//		31. Intruder. AKA DuskDude
//
//======================================================================================

Actor QCIntruder : QCPlayerMedium
{
	Player.DisplayName "Intruder"
	Player.SoundClass "Intruder"
	Player.Palette "PL31"

	XScale 0.68
	YScale 0.75

	Player.FootstepInterval 10
	Player.FootstepVolume 0.65625

	Player.MaxHealth 150
	Health 150
	//Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Intruder"
	Player.StartItem "Body_Medium"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"


	States
	{
	Spawn:
		QP31 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP31 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP31 A 0 A_JumpIf(true,                   "DefSpawn")
		QP31 A 100
		Loop

		ColoredSpawn:
			RP31 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP31 A 4
			Loop
		DefSpawn:
			QP31 A 0 A_JumpIf(momx||momy,"DefSee")
			QP31 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP31 ABCD 4
			RP31 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP31 ABCD 4
			QP31 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_GiveInventory("IntruderFadeBreakToken",1)
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" A 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP31 E 12
			RP31 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP31 E 12
			QP31 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_GiveInventory("IntruderFadeBreakToken",1)
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP31 F 6 BRIGHT Light("PlayerFiringLight")
			RP31 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP31 F 6 BRIGHT Light("PlayerFiringLight")
			QP31 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_GiveInventory("IntruderFadeBreakToken",1)
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP31 G 4
			RP31 G 4 A_Pain
			RP31 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP31 G 4
			QP31 G 4 A_Pain
			QP31 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		QP31 H 0 A_GiveInventory("ImDead",1)
		QP31 H 0 A_ChangeFlag("BRIGHT",0)
		QP31 H 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP31 H 0 A_StopSound(CHAN_6)
		QP31 H 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP31 H 4
		QP31 I 4 A_PlayerScream
		QP31 J 4 A_NoBlocking
		QP31 KLMN 4
		QP31 O -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		QP31 O 0 A_GiveInventory("ImDead",1)
		QP31 O 0 A_ChangeFlag("BRIGHT",0)
		QP31 O 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP31 O 0 A_StopSound(CHAN_6)
		QP31 O 0 A_XScream
		QP31 O 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP31 H 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP31 O 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP31 P 4
		QP31 Q 4 A_NoBlocking
		QP31 RSTUVW 4
		QP31 X -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


