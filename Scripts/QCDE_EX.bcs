#library "QCDE_EX"
#include "zcommon.acs"
#import "QCDE.bcs"
#import "ABILITIS.acs"

#pragma raw define on

#define LIBBCS_FATAL_ALLOC_ERROR

#include "libbcs.bcs"

#include "paketlib.bcs"

#linklibrary "SETCLASS"

extern void SetQcdeStack (int health, int armor);

enum
{
    MAX_CUSTOM_CHAMPS = 128
};

enum
{
    QCDE_EX_VOX_COUNT,
    QCDE_EX_VOX_SUBTITLE
};

typedef struct EXClassInfo
{
    str class;
    str displayName;
    str portrait;
    int health;
    int armor;
    str tickScript; // void (int firstTime)
    int activeCooldown;
    int activeCooldownPVE;
    int activeDuration;
    int activeDurationPVE;
    str activeAbilityScript; // void (void)
    str activeIconOn;
    str activeIconOff;
    bool activeMultiuse;
    int multiuseCooldown;
    str multiuseFailSnd;
    str voiceCallback; // int (int type, int page, int lines)
} EXClassInfoT;

internal struct EXClassInfo EXClasses[MAX_CUSTOM_CHAMPS];
internal int EXClassCount;

internal struct EXClassInfo? QCDE_EX_GetStructForClass (str class)
{
    for(int i = 0; i < EXClassCount; i++)
    {
        if(StriCmp(class, EXClasses[i].class) == 0)
            return EXClasses[i];
    }

    Log(s:"\cgQCDE ERROR: EX champion not registered in ACS. Wrong and broken behavior will most likely follow.");
    return null;
}

void QCDE_EX_AddClass (str class, str displayName, str portrait = null, int health = 100, int armor = 100, str tickScript = null, str voiceCallback = null)
{
    struct EXClassInfo& c = EXClasses[EXClassCount++];

    c.class = class;
    c.displayName = displayName;
    c.portrait = portrait;
    c.health = health;
    c.armor = armor;
    c.tickScript = tickScript;
    c.voiceCallback = voiceCallback;
}

void QCDE_EX_AddClass_Active (str class, int activeCooldown = 35, int activeCooldownPVE = 35, int activeDuration = 35,
    int activeDurationPVE = 35, str activeAbilityScript = null, str activeIconOn = null, str activeIconOff = null,
    bool activeMultiuse = false, int multiuseCooldown = 0, str multiuseFailSnd = null)
{
    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;

    c.activeCooldown = activeCooldown;
    c.activeCooldownPVE = activeCooldownPVE;
    c.activeDuration = activeDuration;
    c.activeDurationPVE = activeDurationPVE;
    c.activeAbilityScript = activeAbilityScript;
    c.activeIconOn = activeIconOn;
    c.activeIconOff = activeIconOff;
    c.activeMultiuse = activeMultiuse;
    c.multiuseCooldown = multiuseCooldown;
    c.multiuseFailSnd = multiuseFailSnd;
}

void QCDE_EX_UpdateStacks (str class)
{
    if(!EXClassCount)
        return;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;

    SetQcdeStack(c.health, c.armor);
}

void QCDE_EX_CallActiveAbility (str class)
{
    if(!EXClassCount)
        return;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;

    if((str)c.activeAbilityScript == null)
        return;

    if(!CheckInventory("ActiveProgressToken") && ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown()))
	{
		SetLastUse(Timer());
		extraAbilityData[PlayerNumber()]++;
		ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());

		// is this netrep stuff needed in our case?
		// SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		ACS_NamedExecuteWithResult(c.activeAbilityScript);
		// SetNetworkReplicationFlags( 0 );

        ACS_NamedExecuteWithResult("_QCDE_EX_CallActiveAbility2");
	}
}

Script "_QCDE_EX_CallActiveAbility2"
{
    delay(GetDuration()); //duration of active ability

    SetNetworkReplicationFlags(NETREP_SKIPOWNER);
    GiveInventory("GenericActiveCleanerProc",1);
    SetNetworkReplicationFlags(0);
}

int QCDE_EX_GetActiveCooldown (str class)
{
    if(!EXClassCount)
        return 0;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.activeCooldown;
}

int QCDE_EX_GetActiveDuration (str class)
{
    if(!EXClassCount)
        return 0;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.activeDuration;
}

bool QCDE_EX_GetActiveMultiuse (str class)
{
    if(!EXClassCount)
        return false;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.activeMultiuse;
}

int QCDE_EX_GetMultiuseCooldown (str class)
{
    if(!EXClassCount)
        return 0;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.multiuseCooldown;
}

str QCDE_EX_GetMultiuseFailSnd (str class)
{
    if(!EXClassCount)
        return "";

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.multiuseFailSnd;
}

str QCDE_EX_GetVoiceCallback (str class)
{
    if(!EXClassCount)
        return "";

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(class)!!;
    return c.voiceCallback;
}

internal str NullcheckStr (str a)
{
    return (a) ? a : "";
}

Script "QCDE_EX_PlayerTick" (int firstTime)
{
    Delay(1);

    if( (!EXClasses) || (GameType() == GAME_TITLE_MAP) || !CheckUserFlag(0, "user_exclass") )
        return;

    struct EXClassInfo& c = QCDE_EX_GetStructForClass(GetActorClass(0))!!;

    int p = Packet_New();
    p = Packet_AppendStr(p, NullcheckStr(c.portrait));
    p = Packet_AppendStr(p, NullcheckStr(c.activeIconOn));
    p = Packet_AppendStr(p, NullcheckStr(c.activeIconOff));
    Packet_Send("QCDE_EX_DrawHUD", p, PlayerNumber());

    if(c.tickScript)
        ACS_NamedExecuteWithResult(c.tickScript, 1);

    while(PlayerNumber() != -1)
    {
        Delay(1);

        if(c.tickScript)
            ACS_NamedExecuteWithResult(c.tickScript, 0);
    }
}

Script "QCDE_EX_PlayerTick_Enter" enter
{
    ACS_NamedExecuteWithResult("QCDE_EX_PlayerTick");
}

Script "QCDE_EX_PlayerTick_Respawn" respawn
{
    ACS_NamedExecuteWithResult("QCDE_EX_PlayerTick");
}

Script "QCDE_EX_DrawHUD" (raw p) clientside
{
    enum : fixed
    {
        ACTIVE_ICON_X = 636.1,
        ACTIVE_ICON_Y = 850.1
    };

    str portrait, activeIconOn, activeIconOff;

    p = Packet_ReadStr(p);
    Log(s:Packet_Rval);
    portrait = Packet_Rval;

    p = Packet_ReadStr(p);
    Log(s:Packet_Rval);
    activeIconOn = Packet_Rval;

    p = Packet_ReadStr(p);
    Log(s:Packet_Rval);
    activeIconOff = Packet_Rval;

    str className = GetActorClass(0);
    while( (PlayerNumber() != -1) && (StrCmp(className, GetActorClass(0)) == 0) )
    {
        if(!CheckInventory("HideHUD"))
        {
            SetHudSize(1400, 1050, true);
            SetFont(portrait);
            HudMessage(s:"A"; HUDMSG_PLAIN|HUDMSG_LAYER_UNDERHUD, 0, CR_UNTRANSLATED, 10.1, 795.1, (fixed)1873);

            if(!CheckInventory("AbilityCooldownToken"))
            {
                if(StrLen(activeIconOn))
                {
                    SetFont(activeIconOn);
                    HudMessage(s:"A"; HUDMSG_PLAIN, 0, CR_UNTRANSLATED, ACTIVE_ICON_X, ACTIVE_ICON_Y, (fixed)1873);
                }
            }
            else if(StrLen(activeIconOff))
            {
                SetFont(activeIconOff);
                HudMessage(s:"A"; HUDMSG_PLAIN, 0, CR_UNTRANSLATED, ACTIVE_ICON_X, ACTIVE_ICON_Y, (fixed)1873);
            }
        }

        Delay(1);
    }
}
