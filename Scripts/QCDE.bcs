function void DrawWeapon(int image, int x, int y)
{
	if(IsZandronum(true))
		if(ActivatorTid() != CheckPlayerCamera(ConsolePlayerNumber()))
			return;

	SetHudSize(320,240,1);
	SetFont(image);
	HudMessageBold(s:"A"; HUDMSG_FADEOUT, HMID_ACS_WEAPON, CR_UNTRANSLATED, x, y, 0.1, 0.3);
}




///////////////////////////////////////////////////////////////////////////////
// Strings & Logs /////////////////////////////////////////////////////////////
////////////////////////////////////////// by Fused // from Zandronum forums //

#define STRINGRECEIVER_SIZE 8

bool stri[STRINGRECEIVER_SIZE];

function int string_send (str string)
{
	// accumulate a free slot
	int i;
	for (i = 0; i < STRINGRECEIVER_SIZE; ++i)
	{
		if (stri[i] == TRUE)
			continue;

		stri[i] = TRUE;
		SetCVarString(StrParam(s:"_temp", d:i), string);
		break;
	}

	ANEA("stringdeleter", 0, i);
	return i;
}

function str string_receive (int slot)
{
	return GetCVarString(StrParam(s:"_temp", d:slot));
}

script "stringdeleter" (int slot)
{
	delay(1);
	stri[slot] = FALSE;
	SetCVarString(StrParam(s:"_temp", d:slot), "");
}

function void LogBold (str string)
{
	LogTo(-1, string);
}

function void LogTo (int player, str string)
{
	if(player == -1 && GameType()) Log(s:string);

	int slot = string_send(string);
	ACS("QCDE_Log_CLIENTSIDE", player, slot);
}

Script "QCDE_Log_CLIENTSIDE" (int player, int slot) CLIENTSIDE
{
	if (player != -1 && CPN() != player) terminate;

	Log(s:string_receive(slot));
}



///////////////////////////////////////////////////////////////////////////////
// Classes that get bonuses per kill //////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////

// Look ma, no KILL scripts!

#define NUMBER_OF_KILL_BONUSES 9
str ListOfPeopleWhoEnjoyKilling[NUMBER_OF_KILL_BONUSES] = {
	"QCMenelkir",
	"QCCaleb",
	"QCGrayson",
	"QCEradicator",
	"QCHunter",
	"QCPainkiller",
	"QCIntruder",
	"QCFreeman"
};

function int IsKillerEligibleForKillBonus(void)
{
	// Check if the killer enjoyed it or just did it out of necessity
	int i, found,
		killertid = GetActorProperty(0, APROP_TargetTID),
		classname = GetActorClass(killertid);
	for(i = 0; i < NUMBER_OF_KILL_BONUSES; i++)
	{
		found = !stricmp(classname, ListOfPeopleWhoEnjoyKilling[i]);
		if(found) break;
	}
	return found;
}






