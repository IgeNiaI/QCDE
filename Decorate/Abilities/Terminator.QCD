Actor QCBulletAmmoTerminator : QCBulletAmmoSmall
{
	Scale 0.5
	Inventory.Amount 4
	Inventory.PickupMessage "$GOT_QCBulletAmmoTerminator" // "Picked up a few surplus bullets."
	+BRIGHT
	States
	{
	Spawn:
		AMBU B 0 NoDelay A_ChangeVelocity(random(-4,4),random(-4,4),random(3,7))
		AMBU BBBBBBBBBBBBBBBBBBBB 35 BRIGHT // 20 seconds
		AMBU B 3 A_FadeOut
		Wait
	}
}


