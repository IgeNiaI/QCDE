Actor QCArachnotron : QCDE_MonsterBig 15401
{
	//$Angled
	//$Category "QCDE Monsters: Doom"
	//$Color 12
	//$Title "Arachnotron"
	Health 500
	Radius 64
	Height 64
	Mass 600
	Speed 12
	PainChance 128
	Monster
	+FLOORCLIP
	+BOSSDEATH
	SeeSound "baby/sight"
	PainSound "baby/pain"
	DeathSound "baby/death"
	ActiveSound "baby/active"
	Obituary "$OB_BABY"
	Tag "$TAG_QCArachnotron" // "Arachnotron"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		BSPI AB 10 A_Look
		Loop
	See:
		BSPI A 20
		BSPI A 0 A_Chase
		BSPI A 3 A_PlaySound("baby/walk",CHAN_AUTO)
		BSPI ABBCC 3 A_Chase
		BSPI D 0 A_Chase
		BSPI D 3 A_PlaySound("baby/walk",CHAN_AUTO)
		BSPI DEEFF 3 A_Chase
		Goto See+1
	Missile:
		BSPI A 20 Bright A_FaceTarget
		BSPI G 4 Bright A_CustomMissile("ArachnotronPlasma")
		BSPI H 4 Bright
		BSPI H 1 Bright A_MonsterRefire(10,"See")
		Goto Missile+1
	Pain:
		BSPI I 3
		BSPI I 3 A_Pain
		Goto See+1
	DeathChecksDone:
		BSPI J 20 A_Scream
		BSPI K 7 A_NoBlocking
		BSPI LMNO 7
		BSPI P -1 A_BossDeath
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_SpawnItemEx("GibDropperMediumBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		BSPI P 5
		BSPI ONMLKJ 5
		Goto See+1
	Death.Corpse: BSPI P -1
	}
}


Actor QCArachnotronPlasma : ArachnotronPlasma replaces ArachnotronPlasma
{
	Damage 6
}