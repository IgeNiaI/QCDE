	States
	{

	Spawn:
		QP13 G 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP13 G 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP13 G 0 A_JumpIf(true,                   "DefSpawn")
		QP13 G 100
		Loop

		ColoredSpawn:
			RP13 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP13 G 3 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			Loop
		DefSpawn:
			QP13 A 0 A_JumpIf(momx||momy,"DefSee")
			QP13 G 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP13 ABCDEF 3 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP13 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP13 ABCDEF 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP13 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP13 GGGG 3 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP13 G 3 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP13 GGGG 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP13 G 3 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP13 H 6 BRIGHT Light("PlayerFiringLight")
			RP13 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP13 H 6 BRIGHT Light("PlayerFiringLight")
			QP13 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" L 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP13 L 4 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP13 L 4 A_Pain
			RP13 L 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP13 L 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
