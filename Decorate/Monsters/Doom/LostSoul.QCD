Actor QCLostSoul : QCDE_MonsterSmall 15411
{
	//$Angled
	//$Category "QCDE Monsters: Doom"
	//$Color 12
	//$Title "Lost Soul"
	Tag "$TAG_QCLostSoul" // "Lost soul"
	Damage (random(2,9)*3)

	Health 100
	Radius 16
	Height 56
	Mass 50
	Speed 8
	Damage 3
	PainChance 256
	Monster
	+FLOAT +NOGRAVITY +MISSILEMORE +DONTFALL +NOICEDEATH
	AttackSound "skull/melee"
	PainSound "skull/pain"
	DeathSound "skull/death"
	ActiveSound "skull/active"
	RenderStyle SoulTrans
	Obituary "$OB_SKULL"
	States
	{
	Idle:
		SKUL AB 10 BRIGHT A_Look
		Loop
	See:
		SKUL AB 6 BRIGHT A_Chase
		Loop
	Missile:
		SKUL C 10 BRIGHT A_FaceTarget
		SKUL D 4 BRIGHT A_SkullAttack
		SKUL CD 4 BRIGHT
		Goto Missile+2
	Pain:
		SKUL E 3 BRIGHT
		SKUL E 3 BRIGHT A_Pain
		Goto See
	Death.Ice:
		TNT1 A 0 A_Jump(255,"Death")
	DeathChecksDone:
		SKUL F 6 BRIGHT
		SKUL G 6 BRIGHT A_Scream
		SKUL H 6 BRIGHT
		SKUL I 6 BRIGHT A_NoBlocking
		SKUL J 6
	Death.Corpse: //just to not spew error of missing state
		SKUL K 6
		Stop

	XDeathChecksDone:	//even though no Xdeath, needs this state
		TNT1 A 0
		Goto DeathChecksDone
	}
}