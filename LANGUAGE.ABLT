ABILT423 = "Massive health pool, no armor. Less\n"
           "knockback, but smaller Rocket Jump height.\n"
           "\n"
           "20% less damage taken \c[orange]-PvE Only-";
ABILT523 = "Corrosive Blood";
ABILT623 = "Blood sprayed when taking damage hurts\n"
           "enemies.";


// Eleena
ABILT124 = "Doppelganger";
ABILT224 = "Deploys a copycat on the field as\n"
           "a distraction or to trade places with.";
ABILT324 = "Acrobatic";
ABILT424 = "Holding \c[gold]jump \c[green]jumps slightly higher.\n"
           "\c[gold]Crouch \c[green]in mid-air drops much faster.";
ABILT524 = "Training Weights";
ABILT624 = "When Eleena has 15 or less armor, she gains\n"
           "20% speed.";


// Lucienne
ABILT125 = "Cleansing Fire";
ABILT225 = "Cast a fireball that deals 10% damage of max\n"
           "HP and curse with +20% damage taken for\n"
           "2 seconds. Also can heal allies by 20% of\n"
           "max HP.";
ABILT325 = "Immolation";
ABILT425 = "When killed, drop a fireball that explodes\n"
           "after a bit of time, dealing damage in\n"
           "a huge radius.";
ABILT525 = "Blessing";
ABILT625 = "Lucienne's armor overstack does not\n"
           "degenerate over time. Heavy armors allows\n"
           "her to overstack up to \c[white]+100AP \c[green]instead of 75.";


// Major
ABILT126 = "Airstrike";
ABILT226 = "When using ability, pressing \c[gold]fire \c[green]will drop a\n"
           "bomb target on the floor.";
ABILT326 = "Tall, Lean and Mean";
ABILT426 = "Hitbox is slimmer than all the other heavy\n"
           "champs; She is able to climb higher stair\n"
           "steps.";
ABILT526 = "Wall Climb";
ABILT626 = "Holding \c[gold]jump\c[green] and \c[gold]forward\c[green] in front of a wall,\n"
           "starts a brief wall climb.";


// Hunter
ABILT127 = "Voodoo Guardian";
ABILT227 = "Summon a skull that will attack nearby\n"
           "enemies and track other champions.";
ABILT327 = "Sixth Sense";
ABILT427 = "Enemies under your crosshair, will leave\n"
           "a track of their position. \c[red](PvP only)";
ABILT527 = "Spoil of the Hunt";
ABILT627 = "Killing enemies will increase Hunter's health,\n"
           "armor or ammo capacity for current level\n"
           "and/or current life.";


// Sam
ABILT128 = "Serious Minigun";
ABILT228 = "Pulls out his minigun with \c[gold]80 ammo\c[green].\n"
           "\c[red]Hourglasses don't reduce cooldown\c[green], instead\n"
           "they increase minigun ammunition when\n"
           "picked. \c[gold]Alt fire \c[green]doubles fire rate\n"
           "at expense of accuracy.";
ABILT328 = "Seriously Loaded";
ABILT428 = "Carries all three starting weapons:\n"
           "Machinegun, Shotgun and Nailgun.";
ABILT528 = "Complementary Ammo";
ABILT628 = "Gets a serious amount of ammo for the\n"
           "current weapon when picking up Light\n"
           "and Heavy armors.";


// Postal
ABILT129 = "Diseased Cow Head";
ABILT229 = "Throws a severed cow head; anyone close \n"
           "to it will be contaminated and take damage\n"
           "over time. This damage ignores the\n"
           "victim's armor.";
ABILT329 = "Cracked Lungs";
ABILT429 = "Megahealth gives up to +100hp \c[cyan]overstack\c[green].\n"
           "After 40sec (90 in pve), any overstack will\n"
           "degenerate rapidly; if no \c[cyan]OS\c[green] is present, takes\n"
           "25dmg instead. This is cancelled by picking\n"
           "another megahealth.";
ABILT529 = "Crouch Jump";
ABILT629 = "Holding \c[gold]Crouch \c[green]then pressing \c[gold]Jump \c[green]allows\n"
           "a higher jump.";


// Painkiller
ABILT130 = "Black Tarot";
ABILT230 = "Allows to select with the \c[gold]directional keys\c[green] up\n"
           "to 3 tarot effects. Speed effect provides\n"
           "air control for the duration.";
ABILT330 = "Demon Morph";
ABILT430 = "Gathering 66 souls morphs Daniel into his\n"
           "Demon Form. Powerful, but slow. In PvP,\n"
           "player souls are worth 11.";
ABILT530 = "Painkiller Weapon";
ABILT630 = "Replaces the standard \"Gauntlet\" for the\n"
           "eponymous weapon, which is slightly\n"
           "stronger and has an \c[gold]Alt Fire\c[green].";


// Intruder
ABILT131 = "Wendigo Curse";
ABILT231 = "Turns invisible if not shooting nor taking\n"
           "damage, leaving trails behind you. \c[yellow]While\n"
           "fully invisible\c[green], take and deal less damage with\n"
           "weapons, along with a low-dmg AoE aura.\n"
           "Impedes air control while active.";
ABILT331 = "His Sparks";
ABILT431 = "Killing an enemy boosts your speed for\n"
           "a short period of time. Does not apply\n"
           "when using an active ability.";
ABILT531 = "Treasure Hunter \c[orange]-PvE-";
ABILT631 = "Finding a secret will reward with +50 armor.\n"
           "This bonus also applies when found by other\n"
           "players.";


// Orbb
ABILT132 = "Observer";
ABILT232 = "Deploys an Eye Drone to spectate the arena.\n"
           "Use the ability again to switch to drone's\n"
           "camera and back. Press \c[gold]fire\c[CR_UNTRANSLATED] to detonate.";
ABILT332 = "Bipedal Eyeball";
ABILT432 = "Small hitbox, only 75% height of a normal\n"
           "champion, but without an option to crouch.";
ABILT532 = "Overbounce";
ABILT632 = "Holding \c[gold]Crouch\c[CR_UNTRANSLATED] when falling allows to bounce\n"
           "back at almost the same vertical velocity.";

