}

Actor CleansingHealProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("00 88 FF", .1, 35)
		TNT1 A 0 A_SpawnItemEx("CleansingHealFX", 0,0,0, 0,0,2,0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Stop
	}
}

Actor CleansingHurtProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("FF 00 00", .05, 35) // less opaque because there's already pain flash and blood splatter
		TNT1 A 0 A_GiveInventory("CleansingWeakener",1)
		TNT1 A 0 A_ThrowGrenade("CleansingHurtFollowFX", 0, 0, 0, false, TGR_NOUNLAGGED)
		TNT1 A 0 A_SpawnItemEx("CleansingHurtFX", 0,0,0, 0,0,2,0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Stop
	}
}

Actor PowerCleanVulnerable : PowerProtection
{
	DamageFactor "Normal", 1.2099
	Powerup.Duration 99999 // I don't want to hear about oh Ex with seven and seven F's
	Powerup.Color "66 00 00", 0.15
}
Actor CleansingWeakener : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	Powerup.Type "CleanVulnerable"
}

Actor CleansingHurtFollowFX
{
	+SERVERNETID
	var int user_counter;
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	Projectile
	RenderStyle Add
	Scale 0.8
	Alpha 0.99
	Translation "0:255=%[0,0,0]:[2,1,0]"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_JumpIf(user_counter>=8,"Ender")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"),"Ender")
		DB52 ABDEGHJKMO 1 A_Warp(AAPTR_TARGET, -5, 0, 65, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_SetUserVar(user_counter,user_counter+1)
		Loop
	Ender:
		TNT1 A 0 A_JumpIf(user_counter == 0, "JustDieAlready")
	EnderLoop:
		TNT1 A 0 A_FadeOut(0.2)
		DB52 ABCDE 1 A_Warp(AAPTR_TARGET, -5, 0, 65, 0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		Loop
	JustDieAlready:
		TNT1 A 0
		Stop
	}
}

Actor CleansingHurtFX
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+BRIGHT
	+SERVERNETID
	RenderStyle Add
	xScale 0.45 yScale 0.55
	Translation "0:255=%[0,0,0]:[2,1,0]"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_PlaySound("QC/Abilities/Lucienne/Hurt", CHAN_7, 1.0, false, 2.0)
		X123 ABCDE 2
		X123 FGHIJKLMNOPQRSTUVWX 1 A_FadeOut(1/25)
		Stop
	}
}

Actor CleansingHealFX : CleansingHurtFX
{
	+SERVERNETID
	Translation "0:255=%[0,0,0]:[0,1,2]"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_PlaySound("QC/Abilities/Lucienne/Heal", CHAN_7, 1.0, false, 2.0)
		X123 XWVUT 2
		X123 SRQPONMLKJIHGFEDBCA 1 A_FadeOut(1/25)
		Stop
	}
}

//--------------------------------------------------------
// Passive
//--------------------------------------------------------

Actor LucienneImmolation
{
	Projectile
	Radius 2
	Height 2
	+THRUACTORS
	Damage 0
	+BLOODLESSIMPACT
	var int user_counter;
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+SEEKERMISSILE
	+EXTREMEDEATH
	+SERVERNETID
	Radius 2
	Height 2
	Scale 0.2
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2,1,0]"
	States
	{
	Spawn:
		DB57 A 0 NODELAY A_Warp(AAPTR_DEFAULT,0,0,35)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck") >= 2,"Proceed") //if PvP, keep it blastable
		TNT1 A 0 A_ChangeFlag("DONTBLAST",true) //if PvE then not blastable
	Proceed:
		DB57 A 0 A_PlaySound("QC/Abilities/Lucienne/FireLoop",CHAN_WEAPON,0.5,1,0.6)
		DB57 ABC 1 BRIGHT Light(OrangeSmallFlicker2) A_SetScale(scalex*1.12)
		DB57 DEF 1 BRIGHT Light(OrangeSmallFlicker1) A_SetScale(scalex*1.12)
		DB57 GHI 1 BRIGHT Light(OrangeMediumFlicker3) A_SetScale(scalex*1.12)
		DB57 JKL 1 BRIGHT Light(OrangeMediumFlicker2) A_SetScale(scalex*1.12)
		DB57 MNO 1 BRIGHT Light(OrangeMediumFlicker3) A_SetScale(scalex*1.12)
		DB57 PQR 1 BRIGHT Light(OrangeBigFlicker3) A_SetScale(scalex*1.12)
		DB57 STUVWXYZABCDEFGHIJKLMNOPQR 1 Bright Light(OrangeBigFlicker2)
		DB57 STUVWXYZABCDEFGHIJKLMNOPQR 1 Bright Light(OrangeBigFlicker2)
		DB57 STUVWXYZABCDEFGHIJKLMNOPQR 1 Bright Light(OrangeBigFlicker2) A_SetScale(scalex*0.88)

		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,627)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathCont
	DeathCont:
		TNT1 A 0 A_JumpIfInTargetInventory("DMToken",1,"DMExplo")
		TNT1 A 0 A_Explode(random(500,1250),448,0,0,192)
		Goto Finisher
	DMExplo:
		TNT1 A 0 A_Explode(75,448,0,0,64)
		TNT1 A 0 A_RadiusThrust(150,128,RTF_THRUSTZ)	//extra thrust because damage thrust alone is not enough
		Goto Finisher
	Finisher:
		DB57 A 0 A_PlaySound("QC/Abilities/Lucienne/BigExplo",CHAN_WEAPON,1.0,0,0.7)
		DB57 AAAAA 0 A_SpawnItemEx("LucienneImmolationExplo", random(15,-15),random(15,-15),random(0,25), frandom(-1,1),frandom(-1,1),frandom(-1,1), 0,SXF_NOCHECKPOSITION)
		TNT1 A 4 Light(OrangeBigFlicker1)
		TNT1 A 3 Light(OrangeBigFlicker2)
		TNT1 A 3 Light(OrangeBigFlicker3)
		TNT1 A 3 Light(OrangeMediumFlicker1)
		TNT1 A 3 Light(OrangeMediumFlicker2)
		TNT1 A 3 Light(OrangeMediumFlicker3)
		TNT1 A 3 Light(OrangeSmallFlicker1)
		TNT1 A 3 Light(OrangeSmallFlicker2)
		TNT1 A 3 Light(OrangeSmallFlicker3)
		Stop
	}
}

Actor LucienneImmolationExplo
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	RenderStyle Add
	Scale 2.0
	States
	{
	Spawn:
		DB54 ABCDEFGHIJKLMNOPQR 2 Bright
		Stop
	}
}