Actor Slash1Trail
{
	Scale 0.55
	RenderStyle Add
	Alpha 0.6
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NONETID
	States
	{
	Spawn:
		QP18 Y 1 Bright A_FadeOut(0.05)
		Loop
	}
}

Actor Slash2Trail : Slash1Trail
{
	States
	{
	Spawn:
		QP18 Z 1 Bright A_FadeOut(0.05)
		Loop
	}
}


//--------------------------------------------------------
// Passive
//--------------------------------------------------------


Actor LoWangHealSoundProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfHealthLower(60, "PlaySound")
		Stop
	PlaySound:
		TNT1 A 0 A_PlaySound("QC/Abilities/LoWang/Healing",CHAN_AUTO,1)
		Stop
	}
}

Actor LoWangHealAreaProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_RadiusGive("LoWangHealProc", 96, RGF_GIVESELF|RGF_PLAYERS)
		Stop
	}
}

Actor LoWangHealProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		// todo: Check if friendly to healer
		TNT1 A 0 A_JumpIfHealthLower(60, "Passive")
		Stop
	Passive:
		TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/Ability", CHAN_ITEM, 1.0, false, 2018.0210)
		TNT1 A 0 HealThing(1)
		TNT1 A 0 A_SetBlend("FF 88 88", .05, 35)
		TNT1 A 0 A_SpawnItemEx("LoWangHealFX", random(5,16),random(-12,12),32, 0,0,frandom(0.5,2), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Stop
	}
}

Actor LoWangHealFX
{
	+NOTONAUTOMAP
	+FORCEXYBILLBOARD +BRIGHT
	Renderstyle Add
	Scale 0.09
	+NOINTERACTION
	+SERVERNETID
	States
	{
	Spawn:
		LWAB A 0 NODELAY A_Jump(128,2)
		LWAB B 0
		LWAB "##########################################" 1 A_Weave(1,1,
				frandom(frandom(2,2),frandom(2,2)),frandom(frandom(2,2),frandom(2,2)))
		LWAB "##########" 1 A_FadeOut
		Stop
	}
}





Actor LoWangRageSoundProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/LoWang/Rage",CHAN_AUTO,1)
