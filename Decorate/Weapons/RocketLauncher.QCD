// --------------------------------------------------------------------------
//
// Rocket Launcher
// Weapon Sprite by Franco Tieppo
// Pickup sprite by FrancoTieppo
// Weapon code by DBT
//
// --------------------------------------------------------------------------

Actor CompatVer31_RocketLauncher {} // for compatibility checks

Actor RocketLauncherPickup : QCWeaponPickup 15605
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Rocket Launcher"
	Height 48
	Radius 20
	Scale 0.69
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCRocketLauncher" // "Picked up a Rocket Launcher."
	Tag "$TAG_QCRocketLauncher" // "RocketLauncher"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		WPN5 Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto SpawnIdle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		WPN5 Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",16,args[4],args[3])
		WPN5 Z 0 A_SetArg(3, 1)
		WPN5 Z -1 Bright A_SetArg(4, 0)
		Stop
	SpawnIdle:
		WPN5 Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",15,args[4],args[3])
		WPN5 Y 0 A_SetArg(3, 1)
		WPN5 Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCRocketLauncher")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCRocketLauncherDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCRocketLauncher")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncher",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRocketLauncher", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCRocketLauncher")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRocketLauncherDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor RocketLauncherPickupNoGravity : RocketLauncherPickup 15615
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Rocket Launcher (No Gravity)"
	+NOGRAVITY
}


Actor QCRocketLauncher : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.6
	Weapon.Kickback 0	//to allow rocket jumping that doesnt mess with your forward movement too much
	Weapon.SelectionOrder 1900
	Weapon.AmmoUse 1
	Weapon.AmmoGive 5
	Weapon.AmmoType "QCRocketAmmo"
	Inventory.PickupMessage "$GOT_QCRocketLauncher"
	Obituary "$OB_QCRocketLauncher"
	Tag "$TAG_QCRocketLauncher"
	Scale 0.69
	States
	{
	Spawn:
		TNT1 A 1
		WPN5 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto SpawnIdle
	DMSpawn:
		WPN5 ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	SpawnIdle:
		WPN5 Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("RL_UG_Control",1,"Select.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Select.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Select.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Select.Quake1")
	Select.Default:
		QCA5 A 0
		Goto SelectCont
	Select.Quake1:
		Q1A5 A 0
		Goto SelectCont
	Select.Quake2:
		Q2A5 A 0
		Goto SelectCont
	Select.Quake3:
		Q3A5 A 0
		Goto SelectCont
	Select.Quake4:
		Q4A5 A 0
		Goto SelectCont
	Select.ETQW:
		QWA5 A 0
		Goto SelectCont
	Select.QCDE1:
		Q0A5 A 0
		Goto SelectCont
	Select.HalfLife:
		HLA5 A 0
		Goto SelectCont
	Select.SeriousSam:
		SSA5 A 0
		Goto SelectCont
	Select.Modded:
		MDA5 A 0
		Goto SelectCont

	Select.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Select.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Select.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Select.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Select.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Select.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Select.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Select.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Select.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Select.Upgraded.Quake1")
	Select.Upgraded.Default:
		QCG5 A 0
		Goto SelectCont
	Select.Upgraded.Quake1:
		Q1G5 A 0
		Goto SelectCont
	Select.Upgraded.Quake2:
		Q2G5 A 0
		Goto SelectCont
	Select.Upgraded.Quake3:
		Q3G5 A 0
		Goto SelectCont
	Select.Upgraded.Quake4:
		Q4G5 A 0
		Goto SelectCont
	Select.Upgraded.ETQW:
		QWG5 A 0
		Goto SelectCont
	Select.Upgraded.QCDE1:
		Q0G5 A 0
		Goto SelectCont
	Select.Upgraded.HalfLife:
		HLG5 A 0
		Goto SelectCont
	Select.Upgraded.SeriousSam:
		SSG5 A 0
		Goto SelectCont
	Select.Upgraded.Modded:
		MDG5 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		//Medals start
		"####" A 0 A_GiveInventory("ComboSwitchRLGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("RL_UG_Control",1,"Prepare.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Prepare.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Prepare.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Prepare.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Prepare.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Prepare.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Prepare.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Prepare.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Prepare.Quake1")
	Prepare.Default:
		QCA5 A 0
		Goto PrepareCont
	Prepare.Quake1:
		Q1A5 A 0
		Goto PrepareCont
	Prepare.Quake2:
		Q2A5 A 0
		Goto PrepareCont
	Prepare.Quake3:
		Q3A5 A 0
		Goto PrepareCont
	Prepare.Quake4:
		Q4A5 A 0
		Goto PrepareCont
	Prepare.ETQW:
		QWA5 A 0
		Goto PrepareCont
	Prepare.QCDE1:
		Q0A5 A 0
		Goto PrepareCont
	Prepare.HalfLife:
		HLA5 A 0
		Goto PrepareCont
	Prepare.SeriousSam:
		SSA5 A 0
		Goto PrepareCont
	Prepare.Modded:
		MDA5 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Prepare_Modded",CHAN_WEAPON)
		Goto PrepareCont

	Prepare.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Prepare.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Prepare.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Prepare.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Prepare.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Prepare.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Prepare.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Prepare.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Prepare.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Prepare.Upgraded.Quake1")
	Prepare.Upgraded.Default:
		QCG5 A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake1:
		Q1G5 A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake2:
		Q2G5 A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake3:
		Q3G5 A 0
		Goto PrepareCont
	Prepare.Upgraded.Quake4:
		Q4G5 A 0
		Goto PrepareCont
	Prepare.Upgraded.ETQW:
		QWG5 A 0
		Goto PrepareCont
	Prepare.Upgraded.QCDE1:
		Q0G5 A 0
		Goto PrepareCont
	Prepare.Upgraded.HalfLife:
		HLG5 A 0
		Goto PrepareCont
	Prepare.Upgraded.SeriousSam:
		SSG5 A 0
		Goto PrepareCont
	Prepare.Upgraded.Modded:
		MDG5 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Prepare_Modded",CHAN_WEAPON)
		Goto PrepareCont

	PrepareCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle

	Idle:
		TNT1 A 0 A_JumpIfInventory("RL_UG_Control",1,"Idle.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Idle.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Idle.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Idle.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Idle.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Idle.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Idle.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Idle.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Idle.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Idle.Quake1")
	Idle.Default:
		QCC5 A 0
		Goto IdleCont
	Idle.Quake1:
		Q1C5 A 0
		Goto IdleCont
	Idle.Quake2:
		Q2C5 A 0
		Goto IdleCont
	Idle.Quake3:
		Q3C5 A 0
		Goto IdleCont
	Idle.Quake4:
		Q4C5 A 0
		Goto IdleCont
	Idle.ETQW:
		QWC5 A 0
		Goto IdleCont
	Idle.QCDE1:
		Q0C5 A 0
		Goto IdleCont
	Idle.HalfLife:
		HLC5 A 0
		Goto IdleCont
	Idle.SeriousSam:
		SSC5 A 0
		Goto IdleCont
	Idle.Modded:
		MDC5 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Idle_Modded",CHAN_WEAPON,1,1)
		Goto IdleCont

	Idle.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Idle.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Idle.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Idle.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Idle.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Idle.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Idle.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Idle.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Idle.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Idle.Upgraded.Quake1")
	Idle.Upgraded.Default:
		QCI5 A 0
		Goto IdleCont
	Idle.Upgraded.Quake1:
		Q1I5 A 0
		Goto IdleCont
	Idle.Upgraded.Quake2:
		Q2I5 A 0
		Goto IdleCont
	Idle.Upgraded.Quake3:
		Q3I5 A 0
		Goto IdleCont
	Idle.Upgraded.Quake4:
		Q4I5 A 0
		Goto IdleCont
	Idle.Upgraded.ETQW:
		QWI5 A 0
		Goto IdleCont
	Idle.Upgraded.QCDE1:
		Q0I5 A 0
		Goto IdleCont
	Idle.Upgraded.HalfLife:
		HLI5 A 0
		Goto IdleCont
	Idle.Upgraded.SeriousSam:
		SSI5 A 0
		Goto IdleCont
	Idle.Upgraded.Modded:
		MDI5 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Idle_Modded",CHAN_WEAPON,1,1)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 4 A_WeaponReady
		"####" B 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" B 4 A_WeaponReady
		"####" C 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" C 4 A_WeaponReady
		"####" D 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" D 4 A_WeaponReady
		"####" E 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" E 4 A_WeaponReady
		"####" F 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" F 4 A_WeaponReady
		Goto Idle

		IdleCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
		ICFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ICFLooper")
			Goto Idle

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("RL_UG_Control",1,"Fire.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Fire.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Fire.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Fire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Fire.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Fire.Quake1")
	Fire.Default:
		QCE5 A 0
		Goto FireCont
	Fire.Quake1:
		Q1E5 A 0
		Goto FireCont
	Fire.Quake2:
		Q2E5 A 0
		Goto FireCont
	Fire.Quake3:
		Q3E5 A 0
		Goto FireCont
	Fire.Quake4:
		Q4E5 A 0
		Goto FireCont
	Fire.ETQW:
		QWE5 A 0
		Goto FireCont
	Fire.QCDE1:
		Q0E5 A 0
		Goto FireCont
	Fire.HalfLife:
		HLE5 A 0
		Goto FireCont
	Fire.SeriousSam:
		SSE5 A 0
		Goto FireCont
	Fire.Modded:
		MDE5 A 0
		Goto FireCont

	Fire.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "Fire.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Fire.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Fire.Upgraded.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Fire.Upgraded.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Fire.Upgraded.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Fire.Upgraded.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Fire.Upgraded.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Fire.Upgraded.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Fire.Upgraded.Quake1")
	Fire.Upgraded.Default:
		QCK5 A 0
		Goto FireCont
	Fire.Upgraded.Quake1:
		Q1K5 A 0
		Goto FireCont
	Fire.Upgraded.Quake2:
		Q2K5 A 0
		Goto FireCont
	Fire.Upgraded.Quake3:
		Q3K5 A 0
		Goto FireCont
	Fire.Upgraded.Quake4:
		Q4K5 A 0
		Goto FireCont
	Fire.Upgraded.ETQW:
		QWK5 A 0
		Goto FireCont
	Fire.Upgraded.QCDE1:
		Q0K5 A 0
		Goto FireCont
	Fire.Upgraded.HalfLife:
		HLK5 A 0
		Goto FireCont
	Fire.Upgraded.SeriousSam:
		SSK5 A 0
		Goto FireCont
	Fire.Upgraded.Modded:
		MDK5 A 0
		Goto FireCont

	FireCont:	//28 tics, 0.8sec
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_GunFlash("PrimaryFlash")

		"####" B 1 Offset(19,28) Bright
		"####" C 1 Offset(29,22) Bright
		"####" C 1 Offset(32,16) Bright

		"####" DDEFG 1 Offset(36,15)
		"####" HIJKKLLMM 1 Offset(36,15)

		"####" N 1 Offset(36,15)
		"####" O 1 Offset(36,15)
		"####" O 1 Offset(30,17)
		"####" P 1 Offset(22,19)
		"####" Q 1 Offset(16,21)
		"####" A 1 Offset(11,23)
		"####" A 1 Offset(9,25)

		"####" A 1 Offset(6,27)
		"####" A 1 Offset(3,29)
		"####" A 1 Offset(1,31)
		"####" A 1 Offset(0,32)
		Goto Idle

	PrimaryFlash:
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
		Goto PerformSP

		PerformSP:
			TNT1 A 0 A_JumpIfInventory("RL_UG_Control",1,"CheckIfZoomed")
			TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin",20,"PerformSP.Modded")
			TNT1 A 0 A_FireCustomMissile("QCRocketPlayer", 0, true, 1, 5)
			Goto FlashCheckSound

		PerformSP.Modded:
			TNT1 A 0 A_FireCustomMissile("QCRocketPlayer_Modded",0,true,1,5)
			Goto FlashCheckSound

			CheckIfZoomed:
				TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FireControlledRocket")
				Goto PerformSP+1
			FireControlledRocket:
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin",20,"FireControlledRocket.Modded")
				TNT1 A 0 A_FireCustomMissile("RocketControlled", 0, true, 1, 5, FPF_NOUNLAGGED|FPF_SKIPOWNER)
			FireControlledRocket.Continue:
				TNT1 A 0 SetPlayerProperty(0,1,PROP_TOTALLYFROZEN) // to remove possibility of refire and such
				TNT1 A 0 A_GiveInventory("PowerControllerProtection") // because player is otherwise defenseless
				Goto FlashCheckSound

			FireControlledRocket.Modded:
				TNT1 A 0 A_FireCustomMissile("RocketControlled_Modded",0,true,1,5,FPF_NOUNLAGGED|FPF_SKIPOWNER)
				Goto FireControlledRocket.Continue

		PerformDM:
			//Medals start
			TNT1 A 0 A_GiveInventory("RLFiredGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin",20,"PerformDM.Modded")
			TNT1 A 0 A_FireCustomMissile("QCRocketPlayerDM", 0, true, 1, 5)
			Goto FlashCheckSound

		PerformDM.Modded:
			TNT1 A 0 A_FireCustomMissile("QCRocketPlayerDM_Modded",0,true,1,5)
			Goto FlashCheckSound

		FlashCheckSound:
			TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
			TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
			Goto NormalSound

			NormalSound:
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "NormalSound.Modded")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "NormalSound.SeriousSam")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "NormalSound.HalfLife")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "NormalSound.Default")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "NormalSound.ETQW")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "NormalSound.Quake4")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "NormalSound.Quake3")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "NormalSound.Quake2")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "NormalSound.Quake1")
			NormalSound.Default:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Default", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake1:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake2:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake3:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake4:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.ETQW:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.HalfLife:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.SeriousSam:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Modded:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Modded", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder

			QuadSound:
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 20, "QuadSound.Modded")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "QuadSound.SeriousSam")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "QuadSound.HalfLife")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "QuadSound.Default")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "QuadSound.ETQW")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "QuadSound.Quake4")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "QuadSound.Quake3")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "QuadSound.Quake2")
				TNT1 A 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "QuadSound.Quake1")
			QuadSound.Default:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Default", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake1:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake2:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake3:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake4:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.ETQW:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.HalfLife:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.SeriousSam:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Modded:
				TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Quad/Fire_Modded", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		TNT1 A 0 A_SetBlend("Orange",0.15,12)
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 7 A_SetPitch(pitch-3.6)
		TNT1 AAAAAA 1 Offset(29,62) A_SetPitch(pitch+0.6)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop
	}
}


Actor QCRocketPlayer
{
	Projectile
	+DEHEXPLOSION
	+EXTREMEDEATH
	-ROCKETTRAIL
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+MTHRUSPECIES
	+DONTBLAST
	Radius 3
	Height 6
	Speed 34
	Damage (random(7,11)*10)
	Scale 0.6
	Obituary "$OB_QCRocketLauncher"
	SeeSound ""
	DeathSound "QC/Weapons/RocketLauncher/RocketExplo"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteAlways("QCDE_AttachWhoosh")
		MICR A 2 Light("YellowMediumPoint2") Bright //no trails for a bit
	Looper:
		MICR A 1 Light("YellowMediumPoint2") Bright A_SpawnItemEx("PlayerRocketTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MICR A 0 A_SpawnItemEx("RocketTrailSmoke",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		//Medals start
		MICR A 0 A_GiveInventory("PreciseCounter",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
		Loop

	Xdeath:	//Direct hit
		//Medals start
		TNT1 A 0 A_JumpIfInventory("PreciseCounter",10,"XDeathPrecise")
		//Medals end
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		//Medals start
		TNT1 A 0 A_GiveToTarget("RLDirectDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 0 A_GiveToTarget("RLHitGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 0 A_GiveToTarget("CollateralToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathInvis

	//Medals start
	XDeathPrecise: //Direct hit long range
        TNT1 A 0 A_GiveToTarget("DirectRocketToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
        TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
        TNT1 A 0 A_GiveToTarget("RLDirectDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
        TNT1 A 0 A_GiveToTarget("RLHitGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 0 A_GiveToTarget("CollateralToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
        TNT1 A 0 A_Jump(256,"DeathCont")
		Goto DeathInvis
	//Medals end

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathInvis

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			//Medals start
			TNT1 A 0 A_GiveToTarget("RLSplashDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			TNT1 A 0 A_GiveToTarget("RLHitGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			TNT1 A 0 A_GiveToTarget("CollateralToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathInvis

    DeathInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DeathCont:
		TNT1 A 0 A_JumpIfInTargetInventory("RL_UG_Cluster",1,"PerformCluster")
		TNT1 A 0 A_StopSound(CHAN_7)
		TNT1 A 0 A_JumpIfInTargetInventory("RocketArena", 1,"DoRocketArena")
		TNT1 A 0 A_JumpIfInTargetInventory("Class_Ranger",1,"DoRanger")
		Goto DoElse

	DoRocketArena:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(128,128,0)	//The rest doesnt deal damage to player, adds to 128
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DoRanger:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,128,XF_HURTSOURCE)	//max damage taken by self rocket (rocket jump) to Ranger is 40
		TNT1 A 0 A_Explode(88,128,0)	//The rest doesnt deal damage to player, adds to 128
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DoElse:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE)	//max damage taken by self rocket (rocket jump) is 50
		TNT1 A 0 A_Explode(78,128,0)	//The rest doesnt deal damage to player, adds to 128
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DamageFX:
		TNT1 A 0 A_Jump(256,"DamageFX.Skin")
	DamageFX.Skin:
		TNT1 A 0 A_StopSound(CHAN_5) // Stop whoosh sound
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	PerformCluster:
		TNT1 A 0 A_CheckFloor("PerformPlane")
		TNT1 A 0 A_CheckCeiling("PerformPlane")
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, 150,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, 210,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, 110,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, 250,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Goto DeathCont+1
	PerformPlane:
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, -45,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0,  45,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0, 135,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket", 0,0,0, 10,0,0,-135,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Goto DeathCont+1
	}
}



Actor QCRocketPlayerDM : QCRocketPlayer
{
	Damage (16)
	+FORCERADIUSDMG
	-MTHRUSPECIES
	-DONTBLAST
	Obituary "$OB_QCRocketLauncher"
	States
	{
	DeathCont:
		TNT1 A 0 A_StopSound(CHAN_7)
		TNT1 A 0 A_JumpIfInTargetInventory("RocketArena", 1,"DoRocketArena")
		TNT1 A 0 A_JumpIfInTargetInventory("Class_Ranger",1,"DoRanger")
		Goto DoElse

	DoRocketArena:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(84,128,0,0,18)	//then another 84 extra damage for impacting a player + (16)dmg on the projectile =100dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DoRanger:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,128,XF_HURTSOURCE,0,18)	//max damage taken by self rocket (rocket jump) to Ranger is 40
		TNT1 A 0 A_Explode(44,128,0,0,18)	//then another 44 extra damage for impacting a player + (16)dmg on the projectile =100dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DoElse:
		TNT1 A 0 A_RadiusThrust(170,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE,0,18)	//max damage taken by self rocket (rocket jump) is 50
		TNT1 A 0 A_Explode(34,128,0,0,18)	//then another 34 extra damage for impacting a player + (16)dmg on the projectile =100dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DamageFX

	DamageFX:
		TNT1 A 0 A_Jump(256,"DamageFX.Skin")
	DamageFX.Skin:
		TNT1 A 0 A_StopSound(CHAN_5) // Stop whoosh sound
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebrisDM",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosionDM",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 10 // Need this delay for below medals
		//Medals start
		TNT1 A 0 A_TakeFromTarget("DirectRocketToken",1)
		TNT1 A 0 A_TakeFromTarget("CollateralToken",1)
		//Medals end
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

Actor QCRocketExplosion
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	+DONTBLAST
	Scale 0.15
	States
	{
	Spawn:
		X125 A 0
		X125 A 1 Light("YellowSmallFlicker2") 	Bright A_SetScale(scalex+0.1125)
		X125 A 1 Light("YellowMediumFlicker3") 	Bright A_SetScale(scalex+0.1125)
		X125 B 1 Light("YellowMediumFlicker1") 	Bright A_SetScale(scalex+0.075)
		X125 B 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.075)
		X125 C 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 C 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 D 1 Light("YellowBigFlicker3") 	Bright
		X125 D 1 Light("YellowBigFlicker3") 	Bright
		X125 E 1 Light("YellowBigFlicker3")		Bright A_SetScale(scalex*1.05)
		X125 E 1 Light("YellowMediumFlicker1")	Bright
		X125 F 1 Light("YellowMediumFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 F 1 Light("YellowMediumFlicker2")	Bright
		X125 G 1 Light("YellowMediumFlicker2")	Bright A_SetScale(scalex*1.05)
		X125 G 1 Light("YellowMediumFlicker3")	Bright
		X125 H 0 Light("YellowSmallFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 H 1 Light("YellowSmallFlicker1")	Bright A_FadeOut(0.075)
		X125 H 1 Light("YellowSmallFlicker2")	Bright A_FadeOut(0.075)
		X125 I 0 Light("YellowSmallFlicker3")	Bright A_SetScale(scalex*1.05)
		X125 I 1 Light("YellowSmallFlicker3")	Bright A_FadeOut(0.075)
		X125 I 1 Bright A_FadeOut(0.075)
		X125 J 0 Bright A_SetScale(scalex*1.05)
		X125 J 1 Bright A_FadeOut(0.075)
		X125 J 1 Bright A_FadeOut(0.075)
		X125 K 0 Bright A_SetScale(scalex*1.05)
		X125 K 1 Bright A_FadeOut(0.075)
		X125 K 1 Bright A_FadeOut(0.075)
		X125 L 0 Bright A_FadeOut(0.075)
		X125 L 1 Bright A_SetScale(scalex*1.05)
		X125 L 1 Bright A_FadeOut(0.075)
		X125 M 0 Bright A_FadeOut(0.075)
		X125 M 1 Bright A_SetScale(scalex*1.05)
		X125 M 1 Bright A_FadeOut(0.075)
		X125 N 0 Bright A_FadeOut(0.075)
		X125 N 1 Bright A_SetScale(scalex*1.05)
		X125 N 1 Bright A_FadeOut(0.075)
		X125 O 0 Bright A_FadeOut(0.075)
		X125 O 1 Bright A_SetScale(scalex*1.05)
		X125 O 1 Bright A_FadeOut(0.075)
		X125 P 0 Bright A_FadeOut(0.075)
		X125 P 1 Bright A_SetScale(scalex*1.05)
		X125 P 1 Bright A_FadeOut(0.075)
		X125 Q 0 Bright A_FadeOut(0.075)
		X125 Q 1 Bright A_SetScale(scalex*1.05)
		X125 Q 1 Bright A_FadeOut(0.075)
		X125 R 0 Bright A_FadeOut(0.075)
		X125 R 1 Bright A_SetScale(scalex*1.05)
		X125 R 1 Bright A_FadeOut(0.075)
		Stop
	}
}

Actor QCRocketExplosionDM : QCRocketExplosion	//fades out much faster
{
	States
	{
	Spawn:
		X125 A 0
		X125 A 1 Light("YellowSmallFlicker2") 	Bright A_SetScale(scalex+0.1125)
		TNT1 A 0 A_FadeOut(0.04)
		X125 A 1 Light("YellowMediumFlicker3") 	Bright A_SetScale(scalex+0.1125)
		TNT1 A 0 A_FadeOut(0.04)
		X125 B 1 Light("YellowMediumFlicker1") 	Bright A_SetScale(scalex+0.075)
		TNT1 A 0 A_FadeOut(0.04)
		X125 B 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.075)
		TNT1 A 0 A_FadeOut(0.04)
		X125 C 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		TNT1 A 0 A_FadeOut(0.04)
		X125 C 1 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		TNT1 A 0 A_FadeOut(0.04)
		X125 D 1 Light("YellowBigFlicker3") 	Bright
		TNT1 A 0 A_FadeOut(0.04)
		X125 D 1 Light("YellowBigFlicker3") 	Bright
		TNT1 A 0 A_FadeOut(0.04)
		X125 E 1 Light("YellowBigFlicker3")		Bright A_SetScale(scalex*1.05)
		TNT1 A 0 A_FadeOut(0.04)
		X125 E 1 Light("YellowMediumFlicker1")	Bright
		TNT1 A 0 A_FadeOut(0.04)
		X125 F 1 Light("YellowMediumFlicker1")	Bright A_SetScale(scalex*1.05)
		TNT1 A 0 A_FadeOut(0.04)
		X125 F 1 Light("YellowMediumFlicker2")	Bright
		TNT1 A 0 A_FadeOut(0.04)
		X125 G 1 Light("YellowMediumFlicker2")	Bright A_SetScale(scalex*1.05)
		TNT1 A 0 A_FadeOut(0.04)
