Actor QCArmorKane : BasicArmorBonus
{
	Radius 20
	Height 16
	Inventory.Pickupmessage "$GOT_QCArmorKane" // "Picked up an armor shard."
	Inventory.Icon "BON2A0"
	Armor.Savepercent 66.665
	Armor.Saveamount 3
	Armor.Maxsaveamount 200
	-COUNTITEM
	+INVENTORY.ALWAYSPICKUP
	+NOBLOCKMONST
	Scale 0.5
	Inventory.PickupSound "QC/Items/ArmorShardPick"
	States
	{
	Spawn:
		QCAR AAAAA 35 BRIGHT		//10 seconds
		Stop
	}
}


Actor KickPuff
{
	+NOINTERACTION
	+THRUGHOST
	+PUFFGETSOWNER
	+ALWAYSPUFF
	+PUFFONACTORS
	+NOTIMEFREEZE
	+EXTREMEDEATH
	+MTHRUSPECIES
	RenderStyle None
	SeeSound ""
	ActiveSound "nothing"
	AttackSound "nothing"
	DamageType "KickSlide"
	Obituary "$OB_KickPuff" // "%o was kicked too hard by %k."
	states
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("KickedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10
		Stop
	Xdeath:	//hit bleeding actor
		TNT1 A 0 A_GiveToTarget("KickedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10
		Stop
	Crash:	//Hit everything else
		TNT1 A 10
		Stop
	}
}


Actor KickedAlready : Token { Inventory.InterHubAmount 0 }	//for player to know if he hit someone and slide should stop
Actor SlideKicked 	: Token { Inventory.InterHubAmount 0 }	//for monsters to tag that they're into slidekick states instead of thumper's


Actor KaneShardDropProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_SpawnItemEx("QCArmorKane",0,0,24,random(-3,3),random(-3,3),random(3,7),0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor DebugBadTurn1 : FX
{
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1,0,0]"
	States
	{
	Spawn:
		DB10 C 350
		DB10 C 1 A_FadeOut(0.01)
		Wait
	}
}

Actor DebugBadTurn2 : FX
{
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[0,0,1]"
	States
	{
	Spawn:
		DB10 C 350
		DB10 C 1 A_FadeOut(0.01)
		Wait
	}
}

Actor DebugGoodTurn : FX
{
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[0,1,0]"
	States
	{
	Spawn:
		DB10 A 350 NoDelay A_SetScale(1.0, (z - floorz - 8) * 0.2 + 0.01)
		DB10 A 1 A_FadeOut(0.01)
		Wait
	}
}
