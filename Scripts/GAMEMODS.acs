Script "QCDE_Gamemode_TERMINATOR"      (void)
{
	// Basically, Elder's Soul and Terminator are the exact same thing.
	// So if a game is designated as Terminator but not as Elder's Soul, this
	// launches Elder's Soul scripts regardless.
	if(!GetCvar("qc_EldersSoul")) ACS("QCDE_Gamemode_qc_EldersSoul");
}

