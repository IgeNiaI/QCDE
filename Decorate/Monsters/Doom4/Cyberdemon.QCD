//================================================================================================================
//================================================================================================================
//
//
//================================================================================================================
//================================================================================================================
Actor D4Cyberdemon : QCDE_MonsterBoss 15454
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	var int user_rocketcount;
	var int user_aiming;
	Health 5000
	Radius 40
	Height 110
	Mass 9000
	Speed 16
	PainChance 2
	Monster
	MinMissileChance 500
	+BOSS
	+MISSILEMORE
	+FLOORCLIP
	+NORADIUSDMG
	+DONTMORPH
	+BOSSDEATH
	SeeSound 	"Doom4/Monsters/Cyberdemon/Sight"
	PainSound 	"Doom4/Monsters/Cyberdemon/Pain"
	DeathSound 	"Doom4/Monsters/Cyberdemon/Death"
	ActiveSound "Doom4/Monsters/Cyberdemon/Idle"
	Obituary "$OB_CYBORG"
	Tag "$TAG_D4Cyberdemon" // "Cyberdemon"
	DropItem "BigHourglass"
	States
	{
	Idle:
		CYBR A 0 A_ChangeFlag("NOPAIN",0)
		CYBR AA 10 A_Look
		Loop
	See:
		CYBR A 0 A_PlaySound("Doom4/Monsters/Cyberdemon/StepHoof",6,1.0,0,0.9)
		CYBR A 3 A_Chase
		CYBR ABBCC 3 A_Chase
		CYBR A 0 A_PlaySound("Doom4/Monsters/Cyberdemon/StepMech",7,1.0,0,0.7)
		CYBR D 3 A_Chase
		CYBR D 3 A_Chase
		Loop
	//----------------------------------------------------------
	//	Attacks
	//----------------------------------------------------------
	Missile:
		CYBR E 0 A_JumpIfCloser(384,"ChooseCloseAttacks")
		Goto ChooseAnyAttack
	ChooseCloseAttacks:
		CYBR E 0 A_Jump(16,"StoneWalls")
		Goto ChooseAnyAttack
	ChooseAnyAttack:
		CYBR E 1 A_Jump(256,"NormalRockets","StreamOfRockets","LaserShot","RocketRain")
		Wait


	//-------------------------
	// Stone walls
	StoneWalls:
		CYBR EEE 10 A_FaceTarget
		CYBR E 0 A_PlaySound("Doom4/Monsters/CybDemRaiseWall",CHAN_AUTO,1.0,false,0.9)
		CYBR E 0 A_CustomMissile("CybieWallSpawner",10, 100,0,CMF_AIMOFFSET)
		CYBR E 0 A_CustomMissile("CybieWallSpawner",10,-100,0,CMF_AIMOFFSET)
		CYBR E 20
		Goto DecideAfterWall
	DecideAfterWall:
		CYBR E 0 A_Jump(256,"StreamOfRocketsWeak","NormalRocketsWeak","FireWave")
		Goto StreamOfRockets


		//-------------------------
		// Rocket stream (weak, for wall attack)
		StreamOfRocketsWeak:
			CYBR E 0 A_FaceTarget
			CYBR E 10 A_SetUserVar(user_rocketcount,0)
			Goto StreamWeakLoop

		StreamWeakLoop:
			CYBR E 0 A_JumpIf(user_rocketcount >= 8, "See")
			CYBR E 0 A_SetUserVar(user_rocketcount, user_rocketcount + 1)
			CYBR F 5 A_CustomMissile("CyberDemonRocketStreamWeak",56,-22,0)
			CYBR E 6 A_FaceTarget
			CYBR E 0 A_MonsterRefire(0,"See")
			Loop
		//-------------------------
		// 3 strong rockets (weak, for wall attack)
		NormalRocketsWeak:
			CYBR E 6 A_FaceTarget
			CYBR F 12 A_CustomMissile("CyberdemonRocketWeak",56,-22,0)
			CYBR E 12 A_FaceTarget
			CYBR F 12 A_CustomMissile("CyberdemonRocketWeak",56,-22,0)
			CYBR E 12 A_FaceTarget
			CYBR F 12 A_CustomMissile("CyberdemonRocketWeak",56,-22,0)
			Goto See

	//-------------------------
	// Sky rockets tracker
	RocketRain:
		CYBR E 0 A_JumpIfCloser(384,"RocketRainRandom")
		CYBR E 0 A_FaceTarget
		CYBR E 0 A_SetUserVar("user_rocketcount",0)
		Goto RocketRainLoop
	RocketRainLoop:
		CYBR E 5 A_SpawnItemEx("RocketRainUpwards", 0,0,70, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_NOCHECKPOSITION)
		CYBR E 0 A_VileTarget("CyberdemonRainTracker")
		CYBR E 0 A_SetUserVar(user_rocketcount,user_rocketcount+1)
		CYBR E 0 A_JumpIf(user_rocketcount>=15,"EndRocketRain")
		Loop
	EndRocketRain:
		CYBR E 35
		Goto See

	//-------------------------
	// Sky rockets random
	RocketRainRandom:
		CYBR E 0 A_FaceTarget
		CYBR E 0 A_SetUserVar("user_rocketcount",0)
		Goto RocketRainRandomLoop
	RocketRainRandomLoop:
		CYBR E 4 A_SpawnItemEx("RocketRainUpwardsRandom", 0,0,70, frandom(5.0,-5.0),frandom(5.0,-5.0),20, 0,SXF_NOCHECKPOSITION)
		CYBR E 0 A_SetUserVar(user_rocketcount,user_rocketcount+1)
		CYBR E 0 A_JumpIf(user_rocketcount>=20,"EndRocketRain")
		Loop


	//-------------------------
	// Rocket stream
	StreamOfRockets:
		CYBR E 0 A_FaceTarget
		CYBR E 10 A_SetUserVar(user_rocketcount,0)
		Goto StreamLoop

	StreamLoop:
		CYBR E 0 A_JumpIf(user_rocketcount >= 12, "See")
		CYBR E 0 A_SetUserVar(user_rocketcount, user_rocketcount + 1)
		CYBR F 5 A_CustomMissile("CyberDemonRocketStream",56,-22,0)
		CYBR E 5 A_FaceTarget
		CYBR E 0 A_MonsterRefire(0,"See")
		Loop

	//-------------------------
	// 3 strong rockets
	NormalRockets:
		CYBR E 6 A_FaceTarget
		CYBR F 12 A_CustomMissile("CyberdemonRocket",56,-22,0)
		CYBR E 12 A_FaceTarget
		CYBR F 12 A_CustomMissile("CyberdemonRocket",56,-22,0)
		CYBR E 12 A_FaceTarget
		CYBR F 12 A_CustomMissile("CyberdemonRocket",56,-22,0)
		Goto See

	//-------------------------
	// Laser / railgun attack
	LaserShot:
		CYBR A 0 A_ThrowGrenade("CyberdemonChargeIndicator")
		CYBR A 0 A_ChangeFlag("NOPAIN",1)
		CYBR A 0 A_PlaySound("Doom4/Weapon/GaussGun/Charge2StartLoop",7,0.5,false,0.7) // heard farther than most sounds
		CYBR A 0 A_PlaySound("Doom4/Monsters/CybDemLaserCharge",6,1.0,false,0.5) // heard farther than most sounds
		Goto ST_65ticsofaiming

	ST_65ticsofaiming:
		CYBR E 0 A_FaceTarget
		CYBR E 0 A_CustomRailgun(0,-20,"None","Orange",RGF_FULLBRIGHT|RGF_SILENT|RGF_EXPLICITANGLE,1,0,"NoBloodPuff",-3,0,2048,1,0,0,None,0)
		CYBR E 1 A_SetUserVar(user_aiming, user_aiming+1)
		CYBR E 0 A_JumpIf(user_aiming <= 65, "ST_65ticsofaiming")

		CYBR E 5 A_SetUserVar(user_aiming, 0)
		CYBR E 0 A_RemoveChildren(true)
		//shoots the fx only first
		CYBR FFFF 0 A_CustomRailgun(0,-22,"Orange","None",RGF_FULLBRIGHT|RGF_SILENT|RGF_EXPLICITANGLE,1,0,"NoBloodPuff",-3,0,2048,35,0,frandom(1.5,3.0),none,0)
		//then the actual shot (different attenuation to create an interesting layering effect)
		CYBR F 0 A_PlaySound("Doom4/Weapon/GaussGun/Charge2Fire",7,1.0,false,0.6)
		CYBR F 0 A_PlaySound("Doom4/Monsters/CybDemLaserBigShot",6,1.0,false,1.0)
		CYBR F 12 A_CustomRailgun(100,-20,"None","Orange",RGF_FULLBRIGHT|RGF_SILENT|RGF_EXPLICITANGLE,1,0,"NoBloodPuff",-3,0,2048,1,14,0,"CyberdemonLaserTrail")
		CYBR E 12 A_ChangeFlag("NOPAIN",0)
		Goto See

	//-------------------------
	// Fire waves
	FireWave:
		CYBR E 10 A_FaceTarget
		CYBR F 1 Bright A_CustomMissile("FireWaveMain",10,0,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 10,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-10,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 20,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-20,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 30,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-30,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 40,0,CMF_AIMOFFSET)
		CYBR F 3 Bright A_CustomMissile("FireWaveMainSecondary",10,-40,0,CMF_AIMOFFSET)

		CYBR EEEE 5 A_FaceTarget
		CYBR F 1 Bright A_CustomMissile("FireWaveMain",80,0,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",80, 10,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",80,-10,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",80, 20,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",80,-20,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",80, 30,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",80,-30,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",80, 40,0,CMF_AIMOFFSET)
		CYBR F 3 Bright A_CustomMissile("FireWaveMainSecondary",80,-40,0,CMF_AIMOFFSET)

		CYBR EEEE 5 A_FaceTarget
		CYBR F 1 Bright A_CustomMissile("FireWaveMain",10,0,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 10,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-10,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 20,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-20,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 30,0,CMF_AIMOFFSET)
		CYBR F 1 Bright A_CustomMissile("FireWaveMainSecondary",10,-30,0,CMF_AIMOFFSET)
		CYBR F 0		A_CustomMissile("FireWaveMainSecondary",10, 40,0,CMF_AIMOFFSET)
		CYBR F 3 Bright A_CustomMissile("FireWaveMainSecondary",10,-40,0,CMF_AIMOFFSET)
		Goto See


	Pain:
		CYBR G 1 A_Pain
		CYBR G 9
		Goto See
	DeathChecksDone:
	XDeathChecksDone:
		CYBR H 0 A_Explode(50,32,XF_NOTMISSILE,0,32)
		CYBR H 5 A_ChangeFlag(THRUACTORS,true)
		CYBR I 5 A_Scream
		CYBR JKL 5 A_SpawnItemEx("BossDeathExplosion",random(40,-40),random(40,-40),random(30,80), 0,0,0, 0,SXF_NOCHECKPOSITION)
		CYBR M 0 A_NoBlocking
		TNT1 A 0 A_PlaySound("Doom4/Gore/Big")
		TNT1 A 0 A_SpawnItemEx("GibDropperBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		CYBR M 5 A_SpawnItemEx("BossDeathExplosion",random(40,-40),random(40,-40),random(30,80), 0,0,0, 0,SXF_NOCHECKPOSITION)
		CYBR NO 6
		CYBR P 30
	Death.Corpse:
		CYBR P -1
		Stop

	//------------------------------------------------------------------------
	}
}


//-------------------------------------------------
// Hellstone wall
Actor CybieWallSpawner
{
	Projectile
	Speed 80
	Radius 3
	Height 3
	+FloorHugger
	+THRUACTORS
	RenderStyle None
	States
	{
	Spawn:
		TNT1 AAAAAAAAAA 1 A_SpawnItemEx("WallPiece",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Stop
	Death:
		TNT1 A 1 A_SpawnItemEx("WallPiece",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor WallPiece
{
	Radius 25
	Height 90
	+Solid
	Xscale 1.3
	Yscale 1.4
	Alpha 0.0
	States
	{
	Spawn:
		RKBL A 0 NODELAY A_Jump(128,"T2")
		Goto PlayOff
	T2:
		RKBS A 0 A_SetScale(1.3,1.9)
		Goto PlayOff
	PlayOff:
		"####" "#####" 1 A_FadeIn(0.2)
		"####" "#" 100	//5+100=4.5secs
		"####" "#" 0 A_ChangeFlag("Solid",0)
		"####" "#" 1 A_FadeOut
		Wait

	}
}
//-------------------------------------------------
//Rocket Rain

Actor RocketRainUpwards	//just visual effect
{
	Projectile
	Speed 0
	Radius 3
	Height 2
	+THRUACTORS
	+SKYEXPLODE
	Scale 0.48
	States
	{
	Spawn:
		MICR B 0 NODELAY A_PlaySound("Doom4/Monsters/CybDemShootSwarm",5,1.0,false,0.95)
		MICR B 50 Bright
		Goto Death
	Death:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
		TNT1 A 50
		Stop
	}
}


Actor CyberdemonRainTracker
{
	+NOINTERACTION
	RenderStyle None
	Scale 0.3
	States
	{
	Spawn:
		TNT1 A 0 NODELAY
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 5 A_Fire
	SpawnStuff:
		TNT1 A 10 A_SpawnItemEx("DummyRainSpawner",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor DummyRainSpawner	//why? because otherwise, it wouldnt spawn the rocket in the ceiling if i tried through the tracker
{
	+NOINTERACTION
	+SPAWNCEILING
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 30 A_CustomMissile("RocketTarget") //waits a bit
		TNT1 A 10 A_CustomMissile("RocketRainingDown") //then drops
		Stop
	}
}

Actor RocketRainingDown
{
	Projectile
	Speed 0
	Radius 3
	Height 5
	+SPAWNCEILING
	-NOGRAVITY
	Gravity 2.5
	Scale 0.4
	DamageType "RocketDamage"
	DeathSound "Doom4/Monsters/CybDemSmallRocketExplo"
	States
	{
	Spawn:
		MICR C 1 Bright
		Loop
	Death:
		TNT1 A 0 A_Explode(20,64,0)
		TNT1 A 0 A_Quake(2,2,0,512)
		TNT1 A 0 A_SpawnItemEx("CyberdemonSmallRocketExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 50 A_ChangeFlag("NOINTERACTION",1)
		Stop
	}
}


Actor RocketTarget
{
	Radius 2
	Height 2
	+NOINTERACTION
	+BRIGHT
	+FORCEXYBILLBOARD
	+FLOORHUGGER
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2.0,0.0,0.2]"
	XScale 0.7
	YScale 0.15
	States
	{
	Spawn:
		X060 A 30 Bright
		X060 A 2 Bright A_FadeOut(0.05)
		Wait

	}
}

Actor RocketZoomer
{
	Radius 2
	Height 2
	+NOINTERACTION
	+BRIGHT
	+FORCEXYBILLBOARD
	+FLOORHUGGER
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2.0,0.0,0.2]"
	Scale 2.51
	Alpha 0.01
	States
	{
	Spawn:
		X060 A 30 Bright
		Goto Looper
	Looper:
		X060 A 1 Bright A_SetScale(scalex - 0.05)
		X060 A 0 Bright A_FadeTo(2.51, 0.05, true)
		Loop
	}
}


