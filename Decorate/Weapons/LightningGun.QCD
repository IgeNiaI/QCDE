			Goto FirePostSoundCheck
		FireNormalSound.Modded:
			TNT1 A 0 A_PlaySound("QC/Weapons/LightningGun/FireStartLoop_Modded", CHAN_WEAPON, 1.0, 1)
			Goto FirePostSoundCheck

		FireQuadSound:
			TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "FireQuadSound.Modded")
			TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "FireQuadSound.SeriousSam")
			TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "FireQuadSound.HalfLife")
