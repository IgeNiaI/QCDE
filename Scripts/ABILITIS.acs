//=============================================================================
//
//	Cooldowns for Active Abilities
//	expressed in tics (x *35)
//
//=============================================================================

#define AD_COOLDOWN      0
#define AD_COOLDOWN_PVE  1
#define AD_DURATION      2
#define AD_DURATION_PVE  3
#define AD_MULTIUSE      4
#define AD_MULTIUSEDELAY 5
#define AD_MULTIUSEFAILSOUND 6
#define AD_COLUMNS       7
#define XYZ              1000 // oh my fucking god

//
//		WHEN CHANGING COOLDOWN VALUES, MAKE SURE TO UPDATE COOLDOWNS IN MENUDEF
//
