//=====================================================================================
//=====================================================================================
Actor Q4RailgunTactical : QCDE_MonsterMedium	15315	//revenant
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 56
	Mass 150
	Health 300
	PainChance 128
	Speed 11
	Scale 0.49
	+FLOORCLIP
	MaxTargetRange 1800
	SeeSound "quake4/Tactical/Voice"
	PainSound "quake4/Tactical/Pain"
	DeathSound "quake4/Tactical/Death"
	ActiveSound "quake4/Tactical/Voice"
	Obituary "$OB_Q4RailgunTactical" // "%o was railed by a Strogg tactical transfer."
	Decal "Q4RailgunOrange"
	Tag "$TAG_Q4RailgunTactical" // "Tactical Transfer (Railgun)"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q25I A 4 A_Look
		Loop
	See:
		Q25W AABBCCDD 3 A_Chase
		Loop
	Missile:
		Q25A A 0 A_FaceTarget
		Q25A A 0 A_TakeInventory("RailgunInterrupted",32767)
		TNT1 A 0 A_PlaySound("quake4/Gladiator/RailgunCharge",4,1,0,0.6)
		Q25A A 0 A_CustomMissile("RailgunChargeIndicatorTactical")
		Q25A ABBBBBBBBBB 4 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Weapons/Railgun/Fire",4,1,0,0.7)
		Q25A C 5 Light(OrangeMediumFlicker2) A_CustomRailgun(30,3,"Orange","White",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT,1,0,None,0,0,2048,0,8.0,0,"Q4RailgunTrail",11)
		TNT1 A 0 A_PlaySound("quake4/Weapons/Railgun/Charge",6)
		Q25A DA 6
		Goto See

	Pain:
		Q25P A 0 A_GiveInventory("RailgunInterrupted",1)
		Q25P A 0 A_StopSound(4) //stops railgun charge sound
		Q25P A 8 A_Pain
		Goto See
	DeathChecksDone:		//I know is stupid they explode on death, but I couldnt rip a barely acceptable death sequence :(
		"####" "#" 0 A_UnsetSolid
		Q25D A 0 A_Scream
		Q25P A 0 A_GiveInventory("RailgunInterrupted",1)
		Q25P A 0 A_StopSound(4)
		Q25D ABCD 3
		Q25D E 70 A_PlaySound("quake4/Misc/Body/Small")
		TNT1 a 0 A_Jump(210,2,4,6,8,10,12)
		Q25D EEEEEEEEEEEEEE 5
		Q25D A 0 A_Fall
		TNT1 A 0 A_PlaySound("quake4/Misc/Explo",6)
		TNT1 A 0 A_Explode(25,96,XF_NOTMISSILE)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",0,0,25,0,0,0,0,SXF_NOCHECKPOSITION)
	Death.Corpse:
		TNT1 A 10
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		Q25P A 0 A_GiveInventory("RailgunInterrupted",1)
		Q25P A 0 A_StopSound(4) //stops railgun charge sound
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 10 A_Fall
		Stop
	}
}

Actor MonsterRailgunParticle
{
	+CLIENTSIDEONLY
	RenderStyle Add
	Alpha 0.95
	Scale 0.12
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Translation "80:111=208:223"
	states
	{
	Spawn:
		X099 B 10 Bright
		X099 B 2 bright A_FadeOut (0.075)
		Wait
	}
}
Actor Q4RailgunTrail : RailgunTrail
{
	Translation "0:255=%[0,0,0]:[1.5,0.75,0.375]"
}

Actor RailgunInterrupted : Inventory {}

Actor RailgunChargeIndicatorTactical
{
	Renderstyle Add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[2.0,1.0,0.5]"
	Scale 0.7
	Alpha 1
	ReactionTime 44
	States
	{
	Spawn:
		X060 A 0 Bright NODELAY A_Warp(AAPTR_TARGET,18,6,47)
		X060 A 1 Bright A_SetScale(scalex-0.016)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (1)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,18,6,47)
		X060 A 1 Bright A_SetScale(scalex-0.016)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (2)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,18,6,47)
		X060 A 1 Bright A_SetScale(scalex-0.016)
		X060 A 0 A_Countdown
		//so that it would check for this token ever 3 tics rather than every single tic
		X060 A 0 A_JumpIfInTargetInventory("RailgunInterrupted",1,"Death")
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}
