		// This is special due to how it's basic in DM but not in solo
		isSelected QCSuperShotgun	, QCSuperShotgunDM		{ inInventory QCShellAmmo	,  6 { drawNumber 3, QCFNT040, brite, QCShellAmmo	, alignment(right), 1489,400; } else { drawNumber 3, QCFNT040, red, QCShellAmmo	, alignment(right), 1489,400; }
		} else {
