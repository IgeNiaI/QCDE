#define VOODOO_ALTFIRE_DMG 30
// Activator: Voodoo Victim
Script "QCDE_VoodooVictim" (void)
{
	int tid = ActivatorTid();
	if(tid == last_voodoocaster) terminate; // no self damage
	if(last_voodoovictimtime[tid-999] == last_voodootime) terminate; // don't repeat
	last_voodoovictimtime[tid-999] = last_voodootime;

	// Activator: Casting Caleb
	SetActivator(last_voodoocaster);

	Thing_Damage(tid, VOODOO_ALTFIRE_DMG, MOD_DISINTEGRATE);
	GiveInventory("HitBeepMid",1);
	//PrintBold(n:0, s:"\ck damaging ", d:tid-1000, s:" ", n:tid-999);
}

