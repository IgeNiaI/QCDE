	Idle.DM:
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "Idle.DM.Modded")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "Idle.DM.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "Idle.DM.HalfLife")
