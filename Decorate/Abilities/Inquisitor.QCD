	States
	{
	Spawn:
		QP09 Y 0 NODELAY A_RearrangePointers(AAPTR_DEFAULT,AAPTR_TARGET,AAPTR_TARGET)
		"####" "#" 0 A_SetUserVar(user_angle,0)
		"####" "#" 0 A_SetUserVar(user_frontdist,35)
		"####" "#" 0 A_SetUserVar(user_sidedist,100)
		"####" "#" 0 A_Jump(256,"Looper")	//for safety
