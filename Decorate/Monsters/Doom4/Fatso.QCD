		XB57 GHIJK 1 Bright A_FadeOut(0.05)
		XB57 LMNOPQRS 1 Bright A_FadeOut(0.03)
		Wait
	B14:
		XC57 ABCDEF 2 Bright A_FadeOut(0.05)
		XC57 GHIJK 1 Bright A_FadeOut(0.05)
		XC57 LMNOPQRS 1 Bright A_FadeOut(0.03)
		Wait
	B21:
		X058 ABCDEF 2 Bright A_FadeOut(0.05)
		X058 GHIJK 1 Bright A_FadeOut(0.05)
		X058 LMNOPQR 1 Bright A_FadeOut(0.03)
		Wait
	B22:
		XA58 ABCDEF 2 Bright A_FadeOut(0.05)
		XA58 GHIJK 1 Bright A_FadeOut(0.05)
		XA58 LMNOPQR 1 Bright A_FadeOut(0.03)
		Wait
	B23:
		XB58 ABCDEF 2 Bright A_FadeOut(0.05)
		XB58 GHIJK 1 Bright A_FadeOut(0.05)
		XB58 LMNOPQR 1 Bright A_FadeOut(0.03)
		Wait
	B24:
		XC58 ABCDEF 2 Bright A_FadeOut(0.05)
		XC58 GHIJK 1 Bright A_FadeOut(0.05)
		XC58 LMNOPQR 1 Bright A_FadeOut(0.03)
		Wait
	B31:
		X059 ABCD 2 Bright A_FadeOut(0.03)
		X059 EFGHIJ 1 Bright A_FadeOut(0.04)
		X059 KLM 1 Bright A_FadeOut(0.05)
		Wait
	B32:
		XA59 ABCD 2 Bright A_FadeOut(0.03)
		XA59 EFGHIJ 1 Bright A_FadeOut(0.04)
		XA59 KLM 1 Bright A_FadeOut(0.05)
		Wait
	B33:
		XB59 ABCD 2 Bright A_FadeOut(0.03)
		XB59 EFGHIJ 1 Bright A_FadeOut(0.04)
		XB59 KLM 1 Bright A_FadeOut(0.05)
		Wait
	B34:
		XC59 ABCD 2 Bright A_FadeOut(0.03)
		XC59 EFGHIJ 1 Bright A_FadeOut(0.04)
		XC59 KLM 1 Bright A_FadeOut(0.05)
		Wait
	}
}
Actor PoisonPoolSplashSmall : PoisonPoolSplash
{
	Scale 1.0
}
Actor PoisonAcidFloor
{
	var int user_counter;
	Projectile
	-NOGRAVITY
	Gravity 3.0
	ReactionTime 7		//7 reaction * 10 tics per "looper" = 70 tics = 2sec
	+FLOORHUGGER
	+NOCLIP
	+NODAMAGETHRUST
	+DONTSPLASH
	DamageType "PlasmaPool"
	+FORCEXYBILLBOARD
	+FORCERADIUSDMG
	+PAINLESS
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SpawnItemEx("PoisonAcidGas",0,0,5,frandom(0.3,-0.3),frandom(0.3,-0.3),0,0,0)	//spawns the cloud
	Looper:
		TNT1 A 12 A_Explode(random(1,3),32,0,0,32)
		TNT1 A 0 A_CountDown
		Loop
	Death:
		TNT1 A 10
		STop
	}
}

Actor PoisonAcidGas
{
	+NOCLIP
	+FloorHugger
	-NOGRAVITY
	Height 20
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[0.8,1.4,0.0]"
	XScale 0.8
	YScale 0.5
	Alpha 0.0
	+DONTSPLASH
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		X110 A 0
		X110 ABCDEFGHIJKLMNOP 2 Bright A_Fadeto(0.8,0.05)
		X110 QRSTUVWXY 2 Bright 							//up to here, 50 tics
		X110 ABCDEFGHIJKLMNOPQR 2 Bright 							//+36
		X110 RSTUVWXYZABCDE 2 Bright A_FadeOut(0.076)			//26
		Stop
	}
}

//===========================================================================
//
// Mancubus
//
//===========================================================================
Actor D4FatsoHell : QCDE_MonsterBig 13501
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	Health 800
	Radius 48
	Height 64
	Mass 2000
	Speed 8
	PainChance 80
	Monster
	MeleeRange 256	//for the flamethrower attack
	+FLOORCLIP
	+BOSSDEATH
	SeeSound	"Doom4/Monsters/Mancubus/Sight"
	PainSound	"Doom4/Monsters/Mancubus/Pain"
	DeathSound	"Doom4/Monsters/Mancubus/Death"
	ActiveSound	"Doom4/Monsters/Mancubus/Idle"
	Obituary "$OB_FATSO"
	Scale 1.08
	Species "Fatty"
	Tag "$TAG_D4FatsoHell" // "Mancubus"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		FAT2 AB 15 A_Look
		Loop
	See:
		FAT2 AABBCCDDEEFF 4 A_Chase
		Loop

	Melee:
		TNT1 A 0 A_Jump(64,"Missile") // 1/2 of the times, it will still go to missile
		TNT1 A 0 A_JumpIfCloser(128,"Shockwave")
		Goto Flamethrower
	Shockwave:
		TNT1 A 0 A_Jump(128,"Missile") // 1/2 of the times, it will still go to missile
		FAT2 G 0 A_Playsound("Doom4/Monsters/MancubusPurge",6,1.0,false,1.0)
		FAT2 GGG 10 A_FaceTarget
		FAT2 G 0 A_SpawnItemEx("FatsoShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		FAT2 G 0 A_Explode(64,128,0)
		FAT2 G 0 A_RadiusThrust(4000,128,RTF_NOIMPACTDAMAGE|RTF_NOTMISSILE)
		FAT2 G 20
		Goto See

	//------------------
	// Flamethrower
	FlameThrower:
		FAT2 G 10 A_FaceTarget
		FAT2 G 0 A_PlaySound("Doom4/Other/FlamerStart",6,1.0,false,1.2)
		Goto FireLoop
	FireLoop:
		FAT2 H 0 Bright A_JumpIfCloser(290,"Fire")
		Goto EndFlameThrower
	Fire:
		FAT2 H 0 A_FaceTarget
		FAT2 H 2 A_CustomMissile("FatsoFlamethrower",20,24)
		FAT2 H 2 A_CustomMissile("FatsoFlamethrower",20,-24)
		FAT2 H 0 A_CPosRefire
		Goto FireLoop
	EndFlameThrower:
		FAT2 IG 6
		Goto See

	Missile:
		FAT2 G 0 A_JumpIfCloser(512,"FireShotgun")
		Goto FireShotgun
	Fireballs:
		FAT2 G 0 A_FaceTarget
		FAT2 G 6 A_PlaySound("Doom4/Monsters/MancubusMortar",CHAN_AUTO,1.0,false,1.1)
		FAT2 U 6 BRIGHT A_CustomMissile("D4FatsoFire",20,-28,0)
		FAT2 IG 4 A_FaceTarget
		FAT2 V 6 BRIGHT A_CustomMissile("D4FatsoFire",20,28,0)
		FAT2 IG 4 A_FaceTarget
		FAT2 U 6 BRIGHT A_CustomMissile("D4FatsoFire",20,-28,0)
		FAT2 IG 4 A_FaceTarget
		FAT2 V 6 BRIGHT A_CustomMissile("D4FatsoFire",20,28,0)
		FAT2 IG 4 A_FaceTarget
		FAT2 U 6 BRIGHT A_CustomMissile("D4FatsoFire",20,-28,0)
		FAT2 IG 4 A_FaceTarget
		FAT2 V 6 BRIGHT A_CustomMissile("D4FatsoFire",20,28,0)
		FAT2 IG 4 A_FaceTarget
		Goto See
	FireShotgun:
		FAT2 G 0 A_Jump(128,"Fireballs") //even if it was close for shotgun, still will do fireballs half of the time
		FAT2 G 0 A_PlaySound("Doom4/Monsters/Mancubus/Attack1",CHAN_AUTO,1.0,false,1.3)
		FAT2 G 6 A_PlaySound("Player/Demon/Fatso/Fire",CHAN_AUTO,1.0,false,1.1)
		TNT1 AAAA 0 A_CustomMissile("D4FatsoShotgunFire",20,-28,frandom(12,-12))
		FAT2 U 6 BRIGHT A_FaceTarget
		FAT2 IG 4 A_FaceTarget
		FAT2 G 0 A_PlaySound("Player/Demon/Fatso/Fire",CHAN_AUTO,1.0,false,1.1)
		TNT1 AAAA 0 A_CustomMissile("D4FatsoShotgunFire",20,28,frandom(12,-12))
		FAT2 V 6 A_FaceTarget
		FAT2 IG 4 A_FaceTarget
		FAT2 G 0 A_PlaySound("Player/Demon/Fatso/Fire",CHAN_AUTO,1.0,false,1.1)
		TNT1 AAAA 0 A_CustomMissile("D4FatsoShotgunFire",20,-28,frandom(12,-12))
		FAT2 U 6 BRIGHT A_FaceTarget
		FAT2 IG 4 A_FaceTarget
		FAT2 G 0 A_PlaySound("Player/Demon/Fatso/Fire",CHAN_AUTO,1.0,false,1.1)
		TNT1 AAAA 0 A_CustomMissile("D4FatsoShotgunFire",20,28,frandom(12,-12))
		FAT2 V 6 BRIGHT A_FaceTarget
		FAT2 IG 4 A_FaceTarget
		Goto See
	Pain:
		FAT2 J 3
		FAT2 J 3 A_Pain
		Goto See
	DeathChecksDone:
		FAT2 K 0 A_Scream
		FAT2 K 4
		FAT2 L 4
		FAT2 M 4 A_NoBlocking
		FAT2 NOPQR 4
		FAT2 S 4
	Death.Corpse:
		FAT2 T -1
	    Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Big")
		TNT1 A 0 A_SpawnItemEx("GibDropperMediumBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	 Raise:
		FAT2 R 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		FAT2 R 5
		FAT2 QPONMLK 5
		Goto See
	//------------------------------------------------------------------------
	// Start of Stagger / Glory Kill states
	//------------------------------------------------------------------------
	//------------------------------------------------------------------------
	}
}


//----------------------------------------
// flamethrower attack
Actor FatsoFlamethrower
{
	var int user_counter;
	Projectile
	Radius 5
	Height 10
	RenderStyle Add
	Scale 0.6
	Speed 20
	FastSpeed 25
	Damage (3)
	+BRIGHT
	+SLIDESONWALLS
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,1,2,3,4,5,6,7,8)
		DB55 ABCDEFGHIJ 1
		// If collided before this, highly visible sprites are forced
		DB55 J 0 A_SetUserVar(user_counter, 1)
		DB55 KLMNOPQRSTUVWXYZ 1 A_ScaleVelocity(0.95)
		TNT1 A 0 A_ChangeVelocity(frandom(-1,1),frandom(-1,1),frandom(-1,1))
		DB56 ABCDEFGHIJK 1 A_ChangeVelocity(-0.8,0,0.3,CVF_RELATIVE)
		Stop
	Death:
		"####" "#" 0 A_JumpIf(user_counter < 1, "Crash")
		"####" "#" 1 A_FadeOut(0.14)
		Wait
	Crash:
		DB55 KMOQSUWY 1
		DB56 EFGHIJK 1 A_FadeOut(0.14)
		Stop
	}
}


//----------------------------------------
// fireball attack
Actor D4FatsoFire
{
	+FORCEXYBILLBOARD
	Projectile
	Speed 22
	FastSpeed 28
	Radius 5
	Height 10
	Damage 6
	Scale 0.75
	RenderStyle Add
	Alpha 0.99
	SeeSound "Doom4/Monsters/MancubRocket"
	DeathSound "Doom4/Other/FireballHit1"
