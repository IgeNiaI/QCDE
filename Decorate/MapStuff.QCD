Actor "QCDE OST" : Inventory 23492
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 0 NoDelay Thing_ChangeTID(0,46290)
	Hibernate:
		TNT1 A -1
		Stop
	Play:
		PLAY A 0 A_Turn(CallACS("QCDE_Jukebox", args[0]))
		Goto Hibernate
	}
}

















