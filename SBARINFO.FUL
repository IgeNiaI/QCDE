// For QCDE.
// By Michaelis, the Official DBTeam Sbarinfo Guy.

height 0;
CompleteBorder True;

// Center is at 700,525
Resolution 1400,1050; // actually 1680x1050, reduce screenshot X by 140
InterpolateHealth false, 20;
InterpolateArmor false, 20;

//================================================================================================
//================================================================================================
// This HUD is designed for normal gameplay or spectating
// Unlike the other variants, it shows all HUD elements that the player is supposed to see
//================================================================================================
//================================================================================================

statusbar Fullscreen, forcescaled
{ inInventory HideHUD {}
else
{ inInventory NotSpectator {  // You only lack it when you don't exist.
	inInventory DemonMorpher || DemonMorpherDM { // Demon HUD for online
		drawImage "PCORN001",-234,   0;
		drawImage "PCORN002",1634,   0;
		drawImage "PCORN003",1634,1050;
		drawImage "PCORN004",-234,1050;
		drawImage "DEMNBAR0", 444,1015;
		drawBar "DEMNBAR1", "DEMNBAR0", health(600)        , horizontal, interpolate(9), 444,1015;
		drawBar "RUNEBAR1", "RUNEBAR0", ActiveProgressToken, horizontal, interpolate(9), 444, 943;
	} else { inInventory PowerDemonMorph { // Demon HUD for offline
		drawImage "PCORN001",-234,   0;
		drawImage "PCORN002",1634,   0;
		drawImage "PCORN003",1634,1050;
		drawImage "PCORN004",-234,1050;
		drawImage "DEMNBAR0", 444,1015;
		drawBar "DEMNBAR1", "DEMNBAR0", health(600)        , horizontal, interpolate(9), 444,1015;
		drawBar "RUNEBAR1", "RUNEBAR0", ActiveProgressToken, horizontal, interpolate(9), 444, 943;
	} else {
	inInventory not NoPortrait {
	// Team color
	inInventory TeamDeathmatch {
		inInventory TeamColor, 255 {	drawImage "TEAMBACA", 15,789; } else {
		inInventory TeamColor,   8 {	drawImage "TEAMBAC8", 15,789; } else {
		inInventory TeamColor,   7 {	drawImage "TEAMBAC7", 15,789; } else {
		inInventory TeamColor,   6 {	drawImage "TEAMBAC6", 15,789; } else {
		inInventory TeamColor,   5 {	drawImage "TEAMBAC5", 15,789; } else {
		inInventory TeamColor,   4 {	drawImage "TEAMBAC4", 15,789; } else {
		inInventory TeamColor,   3 {	drawImage "TEAMBAC3", 15,789; } else {
		inInventory TeamColor,   2 {	drawImage "TEAMBAC2", 15,789; } else {
		inInventory TeamColor,   1 {	drawImage "TEAMBAC1", 15,789;
		}}}}}}}}} // 9 braces
	}

	// Portrait
	inInventory Class_Ranger		{ drawImage "PORTRX01", 	10,795; }
	inInventory Class_Doomslayer	{ drawImage "PORTRX02", 	10,795; }
	inInventory Class_Corvus		{ drawImage "PORTRX03", 	10,795; }
