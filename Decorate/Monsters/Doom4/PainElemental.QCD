Actor D4PainElemental : QCDE_MonsterMedium 15459
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	Health 400
	Radius 31
	Height 56
	Mass 400
	Speed 8
	PainChance 128
	Monster
	+FLOAT
	+NOGRAVITY
	SeeSound	"Doom4/Monsters/PainElemental/Sight"
	PainSound	"Doom4/Monsters/PainElemental/Pain"
	DeathSound	"Doom4/Monsters/PainElemental/DeathExplo"
	ActiveSound	"Doom4/Monsters/PainElemental/Idle"
	Scale 1.15
	Tag "$TAG_D4PainElemental" // "Pain Elemental"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		PAIN A 4 A_Look
		Loop
	See:
		PAIN AABBCC 3 A_Chase
		Loop
	Missile:
		PAIN D 0 A_Jump(128,"See")
		PAIN D 5 A_FaceTarget
		PAIN E 5 A_FaceTarget
		PAIN F 1 BRIGHT A_FaceTarget
		PAIN F 4 BRIGHT A_PainAttack("D4LostSoul",0,0,21)
		Goto See
	Pain:
		PAIN G 6
		PAIN G 6 A_Pain
		Goto See
	DeathChecksDone:
	XDeathChecksDone:
		"####" "#" 0 A_ChangeFlag(THRUACTORS,true)
		PAIN H 0 A_Stop
		PAIN H 1 BRIGHT A_Scream
		PAIN HHH 1 BRIGHT A_SpawnItemEx("PainElementalExplosionSprite",0,0,28,frandom(-3,3),frandom(-3,3),frandom(-3,3),random(0,359),SXF_NOCHECKPOSITION)
		PAIN H 0 A_PainDie("D4LostSoul")
		PAIN III 1 BRIGHT Light("OrangeMediumFlicker1") A_FadeOut(0.05)
		PAIN JJJ 1 BRIGHT Light("OrangeMediumFlicker2") A_FadeOut(0.05)
		PAIN KKK 1 BRIGHT Light("OrangeMediumFlicker3") A_FadeOut(0.05)
		PAIN LLL 1 BRIGHT Light("OrangeSmallFlicker1")  A_FadeOut(0.05)
		PAIN MMM 1 BRIGHT Light("OrangeSmallFlicker2")  A_FadeOut(0.05)
	Death.Corpse:
		PAIN M 1 BRIGHT Light("OrangeSmallFlicker2") 	A_FadeOut(0.1)
		Wait


	//------------------------------------------------------------------------
	}
}

Actor PainElementalExplosionSprite
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	Alpha 0.5
	Scale 0.7
	RenderStyle Add
	Alpha 0.99
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SetScale(frandom(0.8,1.1))
		PROJ DEFGHI 3 Bright
		Stop
	}
}
