// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
//
// Machinegun
// Weapon sprite by Franco Tieppo
// Weapon code by DBT
//
// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// Single player can fire 2 times per one ammo point (thing is reaaally weak)
//
// --------------------------------------------------------------------------

Actor CompatVer31_Machinegun {} // for compatibility checks

// This pickup is only for consistency -- it never gives weapon.
Actor MachinegunPickup : CustomInventory
{
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCMachinegun" // "Picked up the Machinegun."
	Tag "$TAG_QCMachinegun" // "Machinegun"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCMachinegun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCMachinegun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}



Actor QCMachinegun : QCWeapon
{
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 20
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCBulletAmmo"
	Obituary "$OB_QCMachinegun"
	+INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOT_QCMachinegun"
	Tag "$TAG_QCMachinegun"
	States
	{
 	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "Select.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "Select.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "Select.Quake2") // Fallback to another skin
	Select.Default:
		QCA2 A 0
		Goto SelectCont
	Select.Quake2:
		Q2A2 A 0
		Goto SelectCont
	Select.Quake3:
		Q3A2 A 0
		Goto SelectCont
	Select.Quake4:
		Q4A2 A 0
		Goto SelectCont
	Select.ETQW:
		QWA2 A 0
		Goto SelectCont
	Select.QCDE1:
		Q0A2 A 0
		Goto SelectCont
	Select.HalfLife:
		HLA2 A 0
		Goto SelectCont
	Select.SeriousSam:
		SSA2 A 0
		Goto SelectCont
	Select.Modded:
		MDA2 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops the looping fire sound
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "Prepare.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "Prepare.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "Prepare.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "Prepare.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "Prepare.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "Prepare.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "Prepare.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "Prepare.Quake2") // Fallback to another skin
	Prepare.Default:
		QCA2 A 0
		Goto PrepareCont
	Prepare.Quake2:
		Q2A2 A 0
		Goto PrepareCont
	Prepare.Quake3:
		Q3A2 A 0
		Goto PrepareCont
	Prepare.Quake4:
		Q4A2 A 0
		Goto PrepareCont
	Prepare.ETQW:
		QWA2 A 0
		Goto PrepareCont
	Prepare.QCDE1:
		Q0A2 A 0
		Goto PrepareCont
	Prepare.HalfLife:
		HLA2 A 0
		Goto PrepareCont
	Prepare.SeriousSam:
		SSA2 A 0
		Goto PrepareCont
	Prepare.Modded:
		MDA2 A 0 A_PlaySound("QC/Weapons/Machinegun/Prepare_Modded",CHAN_WEAPON,1,0,3)
		Goto PrepareCont

	PrepareCont:
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady(WRF_NOSECONDARY)
		Goto Idle

	Idle:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "Idle.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "Idle.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "Idle.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "Idle.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "Idle.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "Idle.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "Idle.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "Idle.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "Idle.Quake2") // Fallback to another skin
	Idle.Default:
		QCC2 A 0
		Goto IdleCont
	Idle.Quake2:
		Q2C2 A 0
		Goto IdleCont
	Idle.Quake3:
		Q3C2 A 0
		Goto IdleCont
	Idle.Quake4:
		Q4C2 A 0
		Goto IdleCont
	Idle.ETQW:
		QWC2 A 0
		Goto IdleCont
	Idle.QCDE1:
		Q0C2 A 0
		Goto IdleCont
	Idle.HalfLife:
		HLC2 A 0
		Goto IdleCont
	Idle.SeriousSam:
		SSC2 A 0
		Goto IdleCont
	Idle.Modded:
		MDC2 A 0 A_PlaySound("QC/Weapons/Machinegun/Idle_Modded",CHAN_WEAPON,1,0,3)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" ABCDEF 1 A_WeaponReady
		Loop

		IdleCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
		ICFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ICFLooper")
			Goto Idle

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		"####" A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "FireNormalSound.Modded")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "FireNormalSound.SeriousSam")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "FireNormalSound.HalfLife")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "FireNormalSound.QCDE1")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "FireNormalSound.ETQW")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "FireNormalSound.Quake4")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "FireNormalSound.Quake3")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "FireNormalSound.Quake2")
		    "####" A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "FireNormalSound.Quake2") // Fallback to another skin
		FireNormalSound.Default:
			QCE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.Quake2:
			Q2E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Quake2",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.Quake3:
			Q3E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Quake3",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.Quake4:
			Q4E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Quake4",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.ETQW:
			QWE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_ETQW",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.QCDE1:
			Q0E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.HalfLife:
			HLE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_HalfLife",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.SeriousSam:
			SSE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_SeriousSam",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireNormalSound.Modded:
			MDE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireStartLoop_Modded",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck

		FireQuadSound:
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "FireQuadSound.Modded")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "FireQuadSound.SeriousSam")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "FireQuadSound.HalfLife")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "FireQuadSound.QCDE1")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "FireQuadSound.ETQW")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "FireQuadSound.Quake4")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "FireQuadSound.Quake3")
			"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "FireQuadSound.Quake2")
		    "####" A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "FireQuadSound.Quake2") // Fallback to another skin
		FireQuadSound.Default:
			QCE2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.Quake2:
			Q2E2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Quake2",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.Quake3:
			Q3E2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Quake3",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.Quake4:
			Q4E2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Quake4",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.ETQW:
			QWE2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_ETQW",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.QCDE1:
			Q0E2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.HalfLife:
			HLE2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_HalfLife",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.SeriousSam:
			SSE2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_SeriousSam",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck
		FireQuadSound.Modded:
			MDE2 A 0 A_PlaySound("QC/Weapons/Machinegun/Quad/FireStartLoop_Modded",CHAN_WEAPON,1,1)
			Goto FirePostSoundCheck

	FirePostSoundCheck:
		"####" A 0 A_AlertMonsters
		"####" A 0 A_JumpIfInventory("DMToken",1,"DM_FireLooper1")
		Goto FireLooper

		//SP fire
		FireLooper:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_GunFlash("SP_Flash")
			"####" B 1 Offset(2,34) Bright
			"####" C 1 Offset(4,36) Bright
			"####" H 1 Offset(2,34)
			"####" I 1 Offset(1,33)
			"####" J 1 Offset(0,32) A_ReFire("FireLooperNA")
			Goto EndFireLooper
		FireLooperNA: //this one is "No (use of) Ammo"
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_GunFlash("SP_FlashNA")
			"####" A 0 A_Jump(255,"NAT1","NAT2")
		NAT1:
			"####" D 1 Offset(2,34) Bright
			"####" E 1 Offset(4,36) Bright
			Goto EndLooperNa
		NAT2:
			"####" F 1 Offset(2,34) Bright
			"####" G 1 Offset(4,36) Bright
			Goto EndLooperNa
		EndLooperNa:
			"####" H 1 Offset(2,34)
			"####" I 1 Offset(1,33)
			"####" J 1 Offset(0,32) A_ReFire("FireLooper")
			Goto EndFireLooper


		//DM fire
		DM_FireLooper1:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_GunFlash("DM_Flash")
			"####" B 1 Offset(2,34) Bright
			"####" C 1 Offset(4,36) Bright
			"####" H 1 Offset(2,34)
			"####" I 1 Offset(1,33)
			"####" J 1 Offset(0,32) A_ReFire("DM_FireLooper2")
			Goto EndFireLooper
		DM_FireLooper2:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_GunFlash("DM_Flash")
			"####" D 1 Offset(2,34) Bright
			"####" E 1 Offset(4,36) Bright
			"####" H 1 Offset(2,34)
			"####" I 1 Offset(1,33)
			"####" J 1 Offset(0,32) A_ReFire("DM_FireLooper3")
			Goto EndFireLooper
		DM_FireLooper3:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_GunFlash("DM_Flash")
			"####" F 1 Offset(2,34) Bright
			"####" G 1 Offset(4,36) Bright
			"####" H 1 Offset(2,34)
			"####" I 1 Offset(1,33)
			"####" J 1 Offset(0,32) A_ReFire("DM_FireLooper1")
			Goto EndFireLooper

	EndFireLooper:
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "EndFireLooper.Modded")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "EndFireLooper.SeriousSam")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "EndFireLooper.HalfLife")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "EndFireLooper.QCDE1")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "EndFireLooper.ETQW")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "EndFireLooper.Quake4")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "EndFireLooper.Quake3")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "EndFireLooper.Quake2")
		"####" A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "EndFireLooper.Quake2") // Fallback to another skin
	EndFireLooper.Default:
		QCE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Default",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.Quake2:
		Q2E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Quake2",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.Quake3:
		Q3E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Quake3",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.Quake4:
		Q4E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Quake4",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.ETQW:
		QWE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_ETQW",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.QCDE1:
		Q0E2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Default",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.HalfLife:
		HLE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_HalfLife",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.SeriousSam:
		SSE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_SeriousSam",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont
	EndFireLooper.Modded:
		MDE2 A 0 A_PlaySound("QC/Weapons/Machinegun/FireEnd_Modded",CHAN_WEAPON,1,0)
		Goto EndFireLooperCont

	EndFireLooperCont:
		"####" KLMNOPQRSTU 1 A_WeaponReady
		Goto Idle

	//-----------------------
	// Attack doers
	//-----------------------
	SP_Flash:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "SP_Flash.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "SP_Flash.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "SP_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "SP_Flash.Default") // Fallback to another skin
	SP_Flash.Default:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	SP_Flash.Quake4:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuff_Quake4",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	SP_Flash.Modded:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuffMG_Modded",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	SP_FlashNA:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "SP_FlashNA.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "SP_FlashNA.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "SP_FlashNA.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "SP_FlashNA.Default") // Fallback to another skin
	SP_FlashNA.Default:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuff",FBF_NORANDOM)
		Goto EndFlash
	SP_FlashNA.Quake4:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuff_Quake4",FBF_NORANDOM)
		Goto EndFlash
	SP_FlashNA.Modded:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(3,5),"QCBulletPuffMG_Modded",FBF_NORANDOM)
		Goto EndFlash

	DM_Flash:
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "DM_Flash.Modded")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "DM_Flash.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "DM_Flash.Default")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "DM_Flash.Default") // Fallback to another skin
	DM_Flash.Default:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,9,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	DM_Flash.Quake4:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,9,"QCBulletPuff_DM_Quake4",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	DM_Flash.Modded:
		TNT1 A 0 A_FireBullets(1.75,1.75,1,9,"QCBulletPuffMG_DM_Modded",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 20, "EndFlash.Modded")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 8, "EndFlash.SeriousSam")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 7, "EndFlash.HalfLife")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 6, "EndFlash.QCDE1")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 5, "EndFlash.ETQW")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 4, "EndFlash.Quake4")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 3, "EndFlash.Quake3")
			TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 2, "EndFlash.Quake2")
		    TNT1 A 0 A_JumpIfInventory("QCMachinegunSkin", 1, "EndFlash.Quake2") // Fallback to another skin
		EndFlash.Default:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,6,2)
			Goto EndFlash.DefaultCont
		EndFlash.Quake2:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,4,2)
			Goto EndFlash.DefaultCont
		EndFlash.Quake3:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,7,2)
			Goto EndFlash.DefaultCont
		EndFlash.ETQW:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,8,2)
			Goto EndFlash.DefaultCont
		EndFlash.QCDE1:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,6,2)
			Goto EndFlash.DefaultCont
		EndFlash.HalfLife:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,4,2)
			Goto EndFlash.DefaultCont
		EndFlash.SeriousSam:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,5,2)
			Goto EndFlash.DefaultCont
		EndFlash.DefaultCont:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1.75,-1.75),false,7,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1.75,-1.75))
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Yellow",0.03,3)
			Goto EndFlashCont
		EndFlash.Quake4:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(1.75,-1.75),false,7,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1.75,-1.75))
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Cyan",0.03,3)
			Goto EndFlashCont
		EndFlash.Modded:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracerMG_Modded",frandom(1.75,-1.75),false,7,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1.75,-1.75))
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			Goto EndFlashCont

		EndFlashCont:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}

Actor MachinegunSmokeSpawner
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("MachinegunSmoke",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor MachinegunSmoke
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.6
	Scale 0.03
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"Type1","Type2")	//to define which graphic will use
	Type1:
		X201 E 0
		Goto "Continue"
	Type2:
		X201 F 0
		Goto "Continue"
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.03)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.033)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.036)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.003)
		"####" "#" 2 A_FadeOut(0.035)
		Loop
	}
}


// ==========================================================================
// ==========================================================================
//	Weapon tokens
// ==========================================================================
// ==========================================================================

Actor QCMachinegunSkin	: Token { Inventory.MaxAmount 20 }


// --------------------------------------------------------------------------
//	For competitive DM, weapons don't autoaim
// --------------------------------------------------------------------------

Actor QCMachinegunDM : QCMachinegun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_QCMachinegun" // "Machinegun (DM)"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10
}
