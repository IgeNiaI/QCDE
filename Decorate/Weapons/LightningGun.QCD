			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake2",-5)
			Goto DMHold4Cont
		DMHold4.Quake3:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake3",-5)
			Goto DMHold4Cont
		DMHold4.HalfLife:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake3",-5)
			Goto DMHold4Cont
		DMHold4.Modded:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Modded",-5)
			Goto DMHold4Cont
		DMHold4Cont:
			"####" A 0 Offset(0,32)
			"####" E 1 Bright
			//Medals start
			"####" A 0 A_GiveInventory("LGFiredGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			"####" A 0 A_ReFire("DMHold5")
			Goto FireEnd

		DMHold5:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "DMHold5.Modded")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "DMHold5.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "DMHold5.HalfLife")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "DMHold5.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 3, "DMHold5.Quake3")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 2, "DMHold5.Quake2")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 1, "DMHold5.Quake1")
		DMHold5.Default:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor",-5)
			Goto DMHold5Cont
		DMHold5.Quake1:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake1",-5)
			Goto DMHold5Cont
		DMHold5.Quake2:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake2",-5)
			Goto DMHold5Cont
		DMHold5.Quake3:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake3",-5)
			Goto DMHold5Cont
		DMHold5.HalfLife:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake3",-5)
			Goto DMHold5Cont
		DMHold5.Modded:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Modded",-5)
			Goto DMHold5Cont
		DMHold5Cont:
			"####" A 0 Offset(0,32)
			"####" A 0 A_GunFlash("DMFlash")
			"####" "#" 0 A_JumpIfInventory("QCLightningGunSkin", 20, "DMHold5Cont.Impact.Modded")
			"####" F 1 Bright A_FireBullets(0,0,1,LGDmgDM,"LGPuff_DM",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,768)
			Goto DMHold5Cont.ImpactCont
		DMHold5Cont.Impact.Modded:
			"####" F 1 Bright A_FireBullets(0,0,1,LGDmgDM,"LGPuff_DM_Modded",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,768)
		DMHold5Cont.ImpactCont:

		DMHold6:
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "DMHold6.Modded")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "DMHold6.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "DMHold6.HalfLife")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "DMHold6.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 3, "DMHold6.Quake3")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 2, "DMHold6.Quake2")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 1, "DMHold6.Quake1")
		DMHold6.Default:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2",-5)
			Goto DMHold6Cont
		DMHold6.Quake1:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake1",-5)
			Goto DMHold6Cont
		DMHold6.Quake2:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake2",-5)
			Goto DMHold6Cont
		DMHold6.Quake3:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake3",-5)
			Goto DMHold6Cont
		DMHold6.HalfLife:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake3",-5)
			Goto DMHold6Cont
		DMHold6.Modded:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Modded",-5)
			Goto DMHold6Cont
		DMHold6Cont:
			"####" A 0 Offset(0,32)
			"####" G 1 Bright
			//Medals start
			"####" A 0 A_GiveInventory("LGFiredGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			"####" A 0 A_ReFire("DMHold")
			Goto FireEnd


	FireEnd:
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "FireEnd.Modded")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "FireEnd.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "FireEnd.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 6, "FireEnd.Default")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 5, "FireEnd.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "FireEnd.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 3, "FireEnd.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 2, "FireEnd.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 1, "FireEnd.Quake1")
	FireEnd.Default:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Default", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.Quake1:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Quake1", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.Quake2:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Quake2", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.Quake3:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Quake3", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.Quake4:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Quake4", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.ETQW:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_ETQW", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.HalfLife:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_HalfLife", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.SeriousSam:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_SeriousSam", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont
	FireEnd.Modded:
		"####" A 0 A_PlaySound("QC/Weapons/LightningGun/FireEnd_Modded", CHAN_WEAPON, 1.0, 0)
		Goto FireEndCont

	FireEndCont:
		"####" A 0 A_JumpIfInventory("LG_UG_Residue",1,"CheckExitCharges")
		"####" A 0 A_TakeInventory("LGcharge",32767)	//resets any charge if the threshold wasnt reached (or no upgrade)
		Goto Idle

		CheckExitCharges:
			"####" A 0 A_JumpIfInventory("LGcharge",5,"DoExitLightning")
			Goto FireEndCont+1

		DoExitLightning:
			"####" "#" 0 A_JumpIfInventory("QCLightningGunSkin", 20, "DoExitLightning.Impact.Modded")
			"####" A 0 A_FireCustomMissile("LightningResidue")
			Goto DoExitLightning.ImpactCont
		DoExitLightning.Impact.Modded:
			"####" A 0 A_FireCustomMissile("LightningResidue_Modded")
		DoExitLightning.ImpactCont:
			"####" A 0 A_TakeInventory("LGcharge",32767)
			Goto FireEndCont+1


	Flash:
		"####" H 1 A_Light2
		"####" H 0 A_Light0
		Stop

	DMFlash:	//doesnt do any checks regarding upgrades
		"####" H 1 A_Light2
		"####" H 0 A_Light0
		Stop
	}
}


Actor LGPuff
{
	+NONETID
	Radius 10
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	Scale 0.35
	Renderstyle Add
	Obituary "$OB_QCLightningGun"
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	Decal "LGDecal"
	DamageType "Electric"
	States
	{
	Spawn:
	XDeath:
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		//Medals start
		TNT1 A 0 A_GiveToTarget("LGDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 0 A_GiveToTarget("LGHitGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//Medals end
		Goto Choose
	Crash:
		TNT1 A 0 A_JumpIf(waterlevel > 0, "Water")
	Choose:
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 8, "Choose.SeriousSam")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 7, "Choose.HalfLife")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 6, "Choose.QCDE1")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 5, "Choose.ETQW")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 4, "Choose.Quake4")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 3, "Choose.Quake3")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 2, "Choose.Quake2")
		"####" A 0 A_JumpIfInTargetInventory("QCLightningGunSkin", 1, "Choose.Quake1")
	Choose.Default:
	Choose.QCDE1:
	Choose.SeriousSam:
		TNT1 A 1 Bright Light("BlueSmallPoint2")
		Stop
	Choose.Quake1:
	Choose.Quake4:
	Choose.ETQW:
		TNT1 A 1 Bright Light("WhiteSmallPoint2")
		Stop
	Choose.Quake2:
		TNT1 A 2 Bright Light("YellowSmallPoint2")
		TNT1 A 2 Bright Light("YellowSmallPoint2")
		Stop
	Choose.Quake3:
	Choose.HalfLife:
		TNT1 A 2 Bright Light("BlueSmallPoint2")
		TNT1 A 2 Bright Light("BlueSmallPoint2")
		Stop
	Water:
		TNT1 A 0 A_SpawnItemEx("WaterLightningSparks", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION,160)
		TNT1 A 100 A_Explode(waterlevel * 2, waterlevel * 16)
		Stop
	}
}

Actor LGPuff_Modded : LGPuff
{
	Decal "MDLGDecal"
	States
	{
	Water:
		TNT1 A 0 A_SpawnItemEx("WaterLightningSparks_Modded", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION,160)
		Goto Super::Water+1
	}
}

Actor WaterLightningSparks
{
	Translation "0:255=%[0,0,0]:[0.8,1.2,1.6]"
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+DONTBLAST
	var int user_counter;
	RenderStyle Add
	Alpha 0.99
	Scale 0.35
	States
	{
	Spawn:
	Decider:
		TNT1 A 0 NODELAY A_Jump(256,"T1","T2","T3","T4","T5")

		T1:	DLI1 A 0
			Goto PlayOff
		T2:	DLI2 A 0
			Goto PlayOff
		T3:	DLI3 A 0
			Goto PlayOff
		T4:	DLI4 A 0
			Goto PlayOff
		T5:	DLI5 A 0
			Goto PlayOff

	PlayOff:
		"####" A 0 A_Jump(128,"FromL")

		FromA:
			"####" ABCDE 1 Bright
			"####" FGHIJK 1 Bright
			Goto Destroy
		FromL:
			"####" LMNOP 1 Bright
			"####" QRSTUV 1 Bright
			Goto Destroy


	Destroy:
		TNT1 A 5
		Stop

	}
}

Actor WaterLightningSparks_Modded : WaterLightningSparks
{
	States
	{
	T1:
		MDT6 A 0
		Goto PlayOff

	T2:
		MDU6 A 0
		Goto PlayOff

	T3:
		MDV6 A 0
		Goto PlayOff

	T4:
		MDW6 A 0
		Goto PlayOff

	T5:
		MDX6 A 0
		Goto PlayOff
	}
}

Actor LGPuff_DM : LGPuff { -MTHRUSPECIES }

Actor LGPuff_DM_Modded : LGPuff_DM
{
	Decal "MDLGDecal"
	States
	{
	Water:
		TNT1 A 0 A_SpawnItemEx("WaterLightningSparks_Modded", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION,160)
		Goto Super::Water+1
	}
}

