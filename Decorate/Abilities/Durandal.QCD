// ----------------------------------------------------------------------------
//
// Durandal's abilities
//
// Active:	Simulacrums
//			Summons several simulacrums that chase enemies and
//			self destruct when close enough
//
// Passive: Unified Vitality
//			Medium and big armor pickups will first replenish
//			health and then armor
//
// ----------------------------------------------------------------------------

Actor CompatVer31_Durandal {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor SingleBOBSPProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_FireCustomMissile("TeleportBeaconSP",random(0,359),false,0,0,FPF_FORCESERVERSIDE)
		Stop
	}
}
Actor SingleBOBDMProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_FireCustomMissile("TeleportBeaconDM",random(0,359),false,0,0,FPF_FORCESERVERSIDE)
		Stop
	}
}

Actor TeleportBeaconSP
{
	Speed 8
	Radius 20
	Height 4
	Damage 0
	Scale 0.4
	Projectile
	+DONTSPLASH
	-NOGRAVITY
	+FORCEXYBILLBOARD
	+SEEKERMISSILE
	+SERVERNETID
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SeekerMissile(1,1)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_BobPointers",0)
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		MI04 ABCD 4
		Goto Spawn+2
	Death:
		TNT1 A 0 A_SeekerMissile(180,180)
		TNT1 A 1 A_SpawnItemEx("BOBSim_SP",0,0,0, 0,0,0, 0,SXF_TRANSFERPOINTERS)
		Stop
	}
}
Actor TeleportBeaconDM : TeleportBeaconSP
{
	States
	{
	Death:
		TNT1 A 0 A_SeekerMissile(180,180)
		TNT1 A 1 A_SpawnItemEx("BOBSim_DM",0,0,0, 0,0,0, 0,SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor BobSimMain : UnlaggedActor
{
	var int user_counter;
	Health 50
	Radius 12
	Height 48
	Mass 100
	Speed 15
	PainChance 128
	Monster
	XScale 0.0
	YScale 0.65
	+FLOORCLIP
	+FRIENDLY
	+BRIGHT
	+NOBLOCKMONST
	-CANUSEWALLS
	-COUNTKILL
	+EXTREMEDEATH
	+SERVERNETID
	MaxDropOffHeight 128
	MaxStepHeight 80 //they climb :3
	SeeSound ""
	AttackSound ""
	PainSound "QC/Abilities/Durandal/BOBPain"
	DeathSound "QC/Abilities/Durandal/BOBDeath"
	ActiveSound "QC/Abilities/Durandal/BOBBeg"
	Obituary "$OB_BobSimMain" // "%o was BOBBQ'd."
	BloodColor "FF BB 00"
	Species "Durandal"
	+THRUSPECIES
	DamageFactor "Ice", 2.509
	States
	{
	Spawn:
		//Setup stage
		TNT1 A 0 NoDelay ACS_NamedExecuteAlways("QCDE_BobPointers",0)
		ABOB A 0 A_Jump(180,2)
		ABOB A 0 A_PlaySound("QC/Abilities/Durandal/BOBBeg",CHAN_VOICE)
		ABOB A 0 A_PlaySound("QC/Abilities/Durandal/BOBTeleport",CHAN_AUTO,0.6)
		ABOB A 0 A_ChangeFlag("Shootable",0)
		ABOB A 0 A_ChangeFlag("Nodamage",1)
		ABOB ZYZYZYZYZY 2 BRIGHT A_SetScale(scalex+0.065,0.65)
		ABOB Z 0 ACS_NamedExecuteAlways("QCDE_BobRecolor",0,tid)
		ABOB Z 1 BRIGHT A_SetScale(0.65,0.65)
		ABOB A 0 A_ChangeFlag("Shootable",1)
		ABOB A 0 A_ChangeFlag("Nodamage",0)
		Goto Idle
	Idle:
		ABOB A 0 A_PlaySound("QC/Abilities/Durandal/BOBRun",CHAN_BODY,0.3,1,2)
		ABOB A 0 A_Jump(1,"Protester")
		TNT1 A 0 A_Jump(255,"IdleLoop")
		Goto IdleLoop

		Protester:
			ABOB A 0 A_Jump(128,"IdleLoop") //basically, 1/512
			ABOB A 0 A_SpawnItemEx("ProtestSign",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_Jump(255,"IdleLoop")
			Goto IdleLoop

	IdleLoop:
		ABOB A 0 A_SetUserVar(user_counter,user_counter+1)
		ABOB A 0 A_JumpIf(user_counter>44,"Melee")
		ABOB BB 2 A_Wander
		ABOB A 0 A_Look
		ABOB CC 2 A_Wander
		ABOB A 0 A_Look
		ABOB DD 2 A_Wander
		ABOB A 0 A_Look
		ABOB EE 2 A_Wander
		ABOB A 0 A_Look
		Loop
	See:
		ABOB A 0 A_PlaySound("QC/Abilities/Durandal/BOBRun",CHAN_BODY,0.3,1,2)
	SeeLoop:
		ABOB A 0 A_SetUserVar(user_counter,user_counter+1)
		ABOB A 0 A_JumpIf(user_counter>44,"Melee")
		ABOB BBCCDDEE 2 A_Chase
		ABOB A 0 A_Look
		Loop
	Melee:
		ABOB X 4 A_StopSound(CHAN_BODY)
		ABOB A 0 A_Jump(255,"MeleeVirtual")		//ensures always jump to either DM or SP version, instead of base state in this one
		ABOB AA 35 A_Jump(255,"MeleeVirtual")
		ABOB A 0 A_Die
		Goto XDeath
	Pain:
		ABOB X 4 A_StopSound(CHAN_BODY)
		ABOB X 4 A_Pain
		Goto See
	Death:
		ABOB A 0 A_GiveInventory("LOLImDead",1)
		ABOB A 0 A_Scream
		ABOB A 0 A_StopSound(CHAN_BODY)
		ABOB A 0 A_ChangeFlag("Bright",0)
		ABOB HI 3
		ABOB J 3 A_Fall
		ABOB K 3
		ABOB L 3
		ABOB M 3
		ABOB N 100 A_PlaySound("quake4/Misc/Body/Small")
		ABOB N 5 A_FadeOut
		Wait
	XDeath:
		ABOB A 0 A_GiveInventory("LOLImDead",1)
		ABOB A 0 A_StopSound(CHAN_BODY)
		ABOB A 0 A_Jump(255,"XDeathVirtual")
		ABOB AA 35 A_Jump(255,"XDeathVirtual")

	//this is a common end state for the SP and DM versions, it doesnt deal any damage here.
	EndExplosion:
		ABOB A 0 A_GiveInventory("LOLImDead",1)
		ABOB O 0 A_PlaySound("QC/Abilities/Durandal/BOBAnyDeath",5,0.8)
		ABOB O 0 A_PlaySound("QC/Abilities/Durandal/BOBExplo",6,1)
		ABOB A 0 A_SpawnItemEx("GibDropperSmall",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		ABOB A 0 A_ChangeFlag("Bright",0)
		ABOB A 0 A_AlertMonsters
		ABOB OP 4
		ABOB Q 4 A_Fall
		ABOB R 4
		ABOB S 100 A_PlaySound("quake4/Misc/Body/Small")
		ABOB S 5 A_FadeOut
		Wait
	Ice:
		"####" "#" 0 A_GiveInventory("LOLImDead",1)
		"####" "#" 0 A_StopSound(CHAN_BODY)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait
	}
}

Actor ProtestSign
{
	var int user_counter;
	+NOINTERACTION
	+SERVERNETID
	Radius 2
	Height 2
	Scale 0.62
	States
	{
	Spawn:
		//setup stage, puts target (monster that spawned it) as master, and as tracer to keep resetting it
		SIGN A 0 NODELAY A_RearrangePointers(AAPTR_DEFAULT,AAPTR_TARGET,AAPTR_TARGET)
		SIGN A 0 A_Jump(255,"T1","T2","T3","T4","T5")

		T1: SIGN A 0
		    Goto Looper
		T2: SIGN B 0
		    Goto Looper
		T3: SIGN C 0
		    Goto Looper
		T4: SIGN D 0
		    Goto Looper
		T5: SIGN E 0
		    Goto Looper

	Looper:
		SIGN "#" 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		SIGN "#" 0 A_JumpIfInTargetInventory("LOLImDead",1,"Death.Removed") //failsafe to remove this shield
		SIGN "##" 1 BRIGHT A_Warp(AAPTR_TARGET,6,5,37,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		SIGN "#" 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		SIGN "#" 0 A_JumpIfInTargetInventory("LOLImDead",1,"Death.Removed") //failsafe to remove this shield
		SIGN "###" 1 BRIGHT A_Warp(AAPTR_TARGET,6,5,37,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		//in 10 seconds it will disappear no matter what
		SIGN "#" 0 A_SetUserVar(user_counter,user_counter+5)
		SIGN "#" 0 A_JumpIf(user_counter>=350,"Death") //350 tics, 10 seconds
		Loop
	Death:
	Death.Removed:
		TNT1 A 10
		Stop
	}
}






Actor BOBSim_SP : BobSimMain
{
	-SOLID 		//they dont get in your way
	+NOTAUTOAIMED	//otherwise you auto aim to your own bobs :facepalm:
	+DONTBLAST
	Species "Players" +THRUSPECIES
	DamageFactor "BobExploSP", 0.1	//almost no damage from other bobs
	Health 500
	Speed 18
	States
	{
	IdleLoop:
		ABOB A 0 A_SetUserVar(user_counter,user_counter+1)
		ABOB A 0 A_JumpIf(user_counter>88,"Melee")
		ABOB BB 2 A_Wander
		ABOB A 0 A_Look
		ABOB CC 2 A_Wander
		ABOB A 0 A_Look
		ABOB DD 2 A_Wander
		ABOB A 0 A_Look
		ABOB EE 2 A_Wander
		ABOB A 0 A_Look
		Loop

	MeleeVirtual:
		ABOB A 1 A_FaceTarget
		ABOB A 0 A_GiveInventory("LOLImDead",1)
		ABOB A 0 A_Die("BobExploSP")
		Goto XDeath
	XDeathVirtual:
		ABOB A 0
		Goto Death.BobExploSP
	Death.BobExploSP:
		//ABOB O 0 A_PrintBold("SP death",0.4)
		ABOB O 0 A_CustomMissile("BobExploHackSP",25)
		Goto EndExplosion
	}
}


Actor BOBSim_DM : BobSimMain
{
	Health 30
	Mass 40		//less mass than SP
	MaxDropOffHeight 256
	DamageFactor "BobExploDM", 0.1	//almost no damage from other bobs
	DamageFactor "ThumperDamage", 100 //They just die from thumper
	+THRUSPECIES
	-DONTBLAST
	States
	{
	MeleeVirtual:
		ABOB A 5 A_FaceTarget
		ABOB A 0 A_GiveInventory("LOLImDead",1)
		ABOB A 0 A_Die("BobExploDM")
		Goto XDeath
	XDeathVirtual:
		ABOB A 0
		Goto Death.BobExploDM
	Death.BobExploDM:
		//ABOB O 0 A_PrintBold("DM death",0.4)
		ABOB O 0 A_CustomMissile("BobExploHackDM",25)
		ABOB O 0
		Goto EndExplosion
	}
}



Actor BobExploHackSP
{
	Projectile
	Speed 0
	Radius 2
	Height 3
	DamageType "BobExploSP"
	+FORCERADIUSDMG
	+SERVERNETID
	States
	{
	Spawn:
		TNT1 A 0 NODELAY ACS_NamedExecuteWithResult("QCDE_BobExplosionAttribution")
		TNT1 A 10 A_Explode(random(20,30)*10,128,0,0,64)
		Stop
	Death:
		TNT1 A 10
		Stop
	}
}
Actor BobExploHackDM
{
	Projectile
	Speed 0
	Radius 2
	Height 3
	DamageType "BobExploDM"
	+FORCERADIUSDMG
	+SERVERNETID
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Explode(40,128,0,0,128)
		TNT1 A 10
		Stop
	Death:
		TNT1 A 10
		Stop
	}
}

//--------------------------------------------------------
// Passive
// Unified Vitality: Medium and big armor pickups will
// first replenish health and then armor
//--------------------------------------------------------

// Nothing to see here. It's all handled in the armor items
