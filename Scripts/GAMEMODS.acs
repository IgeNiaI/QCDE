#define NUMBER_OF_GAMEMODES 32

str gamemode[NUMBER_OF_GAMEMODES] = {
	// built-ins
	"COOPERATIVE",      //  0
	"SURVIVAL",         //  1
	"INVASION",         //  2
	"DEATHMATCH",       //  3
	"TEAMPLAY",         //  4
	"DUEL",             //  5
	"TERMINATOR",       //  6
	"LASTMANSTANDING",  //  7
	"TEAMLMS",          //  8
	"POSSESSION",       //  9
	"TEAMPOSSESSION",   // 10
	"TEAMGAME",         // 11
	"CTF",              // 12
	"ONEFLAGCTF",       // 13
	"SKULLTAG",         // 14
	"DOMINATION",       // 15
	"INSTAGIB",			// 16
	"BUCKSHOT",			// 17
	"ROCKETARENA",		// 18

	// QCDE
	"qc_EldersSoul",    // 19
	"qc_FreezeTag",     // 20
	"qc_SkirmishRogue", // 21
};

Script "QCDE_Gamemode" (void)
{
	for(int i = 0; i < NUMBER_OF_GAMEMODES; i++)
		if(GetCvar(gamemode[i]))
			ACS(strparam(s:"QCDE_Gamemode_", s:gamemode[i]));
}

Script "QCDE_Gamemode_COOPERATIVE"     (void) {}
Script "QCDE_Gamemode_SURVIVAL"        (void) {}

int wave_was = -1;
Script "QCDE_Gamemode_INVASION"        (void)
{
	ConsoleCommand("sv_itemrespawn true");

	ACS("QCDE_Gamemode_INVASION_loop");
}

Script "QCDE_Gamemode_INVASION_loop"        (void)
{
	int wave = GetInvasionWave() - 1;

	if(wave != wave_was)
	{
		if(wave == 0) ACS("QCDE_Music");

		int grade;
		switch(wave % 4)
		{
		case 0: grade = 1; break;
		case 1: grade = 2; break;
		case 2: grade = 1; break;
		case 3: grade = 3; break;
		}

		for(int i = 0; i < 64; i++)
			if(PlayerInGame(i))
				ACS("QCDE~GiveLoot뮻🅾️x", false, grade, i+1);
	}

	delay(21);
	wave_was = wave;
	restart;
}

Script "QCDE_Gamemode_DEATHMATCH"      (void)
{
	ConsoleCommand("sv_itemrespawn true");
}
Script "QCDE_Gamemode_TEAMPLAY"        (void) {}
