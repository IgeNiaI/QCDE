
Actor "FriendlyProc" : CustomInventory { States { Pickup: TNT1 A 0 A_ChangeFlag("FRIENDLY", true) Stop } }
Actor   "AmbushProc" : CustomInventory { States { Pickup: TNT1 A 0 A_ChangeFlag("AMBUSH"  , true) Stop } }
Actor  "DormantProc" : CustomInventory { States { Pickup: TNT1 A 0 A_ChangeFlag("DORMANT" , true) Stop } }

Actor BaseSpawner { +ISMONSTER +NOINTERACTION +NOTONAUTOMAP -RANDOMIZE }

Actor TrackingSpawner : BaseSpawner
{
	Health 0x7CDE9A64
	States
	{
	Track:
		TNT1 A 100 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_SpawnerTracking") == true, "Death")
		Loop
	Death:
		TNT1 A 0 A_BossDeath
		Stop
	}
}

// For E2M8 and E3M8 bosses, who call it immediately on death before animation,
// to die gorgeously without being interrupted by text screen.
Actor TrackingSlowner : TrackingSpawner
{
	States
	{
	Death:
		TNT1 A 80
		TNT1 A 0 A_BossDeath
		Stop
	}
}

// 2-tic pause before spawning is necessary for dynamic themes to register

Actor        ZombiemanSpawner :     BaseSpawner replaces        Zombieman { States { Spawn: TNT1 A 0 NoDelay A_Jump(0,1) TNT1 A 2 A_Jump(0,1) TNT1 A 100 ACS_NamedExecuteAlways("QCDE_MonsterSpawner",0, 0) Stop       } }
