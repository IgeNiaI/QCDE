			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracer",frandom(5.5,-5.5),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5.5,-5.5))
			Goto FlashCheckSound

		DM_Flash.Modded:
			TNT1 A 0 A_FireBullets(sin(0)*2.1,cos(0)*2.1,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(0)*3.4,cos(0)*3.4,-1,4,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(0)*5.5,cos(0)*5.5,-1,3,"QCShotgunPuffSSG_DM_Modded",FBF_NORANDOM|FBF_EXPLICITANGLE)

