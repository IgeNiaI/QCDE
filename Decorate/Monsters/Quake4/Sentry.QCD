//=====================================================================================
Actor Q4Sentry : QCDE_MonsterMedium	15319	//caco
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 56
	Mass 400
	Health 300
	+NOBLOOD
	+NOGRAVITY
	+FLOAT
	+FLOORCLIP
	PainChance 64
	Speed 11
	Scale 0.315
	SeeSound "quake4/Sentry/Voice"
	PainSound "quake4/Sentry/Pain"
	DeathSound "quake4/Sentry/Death"
	ActiveSound "quake4/Sentry/Voice"
	Obituary "$OB_Q4Sentry" // "%o was denied access to life by a sentry."
	Tag "$TAG_Q4Sentry" // "Sentry"
	States
	{
	Idle:
		Q17I A 5 A_Look
		Loop
	See:
		Q17I A 3 A_Chase
		Loop
	Missile:
		Q17A A 0 A_FaceTarget(0,0)
		TNT1 a 0 A_PlaySound("quake4/Weapons/HyperBlast/Fire",5)
		TNT1 A 0 A_CustomMissile("Q4SentryBlasterWeak",34,-5,random(2,-2))
		Q17A B 4
		TNT1 a 0 A_PlaySound("quake4/Weapons/HyperBlast/Fire",5)
		TNT1 A 0 A_CustomMissile("Q4SentryBlasterWeak",34,5,random(2,-2))
		Q17A D 4
		TNT1 a 0 A_Jump(32,"See")
		TNT1 a 0 A_CposRefire
		Loop
	Pain:
		Q17I A 6 A_Pain
		Goto See

	DeathChecksDone:
		TNT1 A 0 A_Scream
		TNT1 A 0 A_ChangeFlag("THRUACTORS",1)
		Q17D AB 4
		"####" "#" 1 A_CheckFloor("Crashed")
		Wait
	Crashed:
		TNT1 A 0 A_Fall
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Metal")
		Q17D CDE 4
	Death.Corpse:
		Q17D F -1
		Stop
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q17D EDCBA 3
		Goto See

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",0,0,30,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("Junk",0,0,0,random(-7,7),random(-7,7),random(1,14),random(1,359),SXF_TRANSFERTRANSLATION)
		TNT1 A 10 A_Fall
		Stop
	}
}

Actor Q4SentryBlasterWeak : HoverTankBlaster
{
	Damage (random(2,8))
	Scale 0.3
	Decal "Q4PlasmaMonster"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		ACID A 7 Light(OrangeMediumPoint3)
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("HoverTankBlasterExplo1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 4 A_SpawnItemEx("HoverTankBlasterExplo2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}


