Actor QCCoilAmmo : Ammo
{
	//$NotAngled
	//$Category "QCDE Ammunition"
	//$Color 6
	//$Title "Coils Ammo Big"
	Tag "$TAG_QCCoilAmmo" // "Coils Ammo Big"
	+FLOORCLIP
	-TELESTOMP
	+SERVERNETID
	Radius 20
	Height 16
	Inventory.PickupMessage "$GOT_QCCoilAmmo" // "Picked up a pack of coils."
	Inventory.PickupSound "QC/Items/AmmoPick"
	Inventory.Amount 50
	Inventory.MaxAmount 150
	Ammo.BackpackMaxAmount 300
	Ammo.BackpackAmount 20
	Scale 0.906
	States
	{
	Spawn:
		AMCL A 0  NODELAY A_SetAngle(random(0,359))
		Goto Common
	Common:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		"####" "#" 0 A_Jump(255,"Idle")
		Goto Idle
	DMSpawn:
		"####" "#" 0 ACS_NamedExecuteWithResult("QCDE_DespawnIfInstagib")
		"####" "#" 0 A_ChangeFlag("BRIGHT",1)
		"####" "#" 0 A_Jump(255,"Idle")
		Goto Idle
	Idle:
		"####" "#" -1 ACS_NamedExecuteWithResult("QCDE_PickupSpawned")
		Stop
	}
}

