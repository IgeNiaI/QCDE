// ----------------------------------------------------------------------------
//
// Menelkir's abilities
//
// Active:	Summon Maulotaur
//			Summons a friendly maulotaur that fights for you
//
// Passive: Hex
//			Monsters killed by Menelkir or his minion, can spawn hourglasses
//
// ----------------------------------------------------------------------------

Actor SummonProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 Thing_Destroy(tid-1000+1960)
		TNT1 A 0 A_SpawnItemEx("TeleportFog", 60+abs(momx)+abs(momy),0,32, 0,0,0,0, SXF_NOUNLAGGED|SXF_SKIPOWNER)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"SpawnDM")
		TNT1 A 0 A_SpawnItemEx("QCDEMaulotaurPvE", 60+abs(momx)+abs(momy),0,32, 0,0,0,0, SXF_SETMASTER|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE,0,tid-1000+1960)
		Stop
	SpawnDM:
		TNT1 A 0 A_SpawnItemEx("QCDEMaulotaur", 60+abs(momx)+abs(momy),0,32, 0,0,0,0, SXF_SETMASTER|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE,0,tid-1000+1960)
		Stop
	}
}

Actor DaveRoomTest
{
	Radius 32
	Height 64
}

Actor MaulotaurAliveToken : Inventory {
	+SERVERNETID
	Inventory.InterHubAmount 0
}

Actor "ThruSpeciesProc" : CustomInventory { States { Pickup: TNT1 A 0 A_ChangeFlag("THRUSPECIES", true) Stop } }

//The actual monster
Actor QCDEMaulotaur : MinotaurFriend replaces Minotaurfriend
{
	Species "Players"
	var int user_HammerCount;
	Scale 0.66
	Radius 20
	Height 63
	Mass 200
	Speed 8
	+SOLID +SHOOTABLE
	+BRIGHT
	+NOBLOCKMONST
	+MISSILEMORE
	+MISSILEEVENMORE
	+LOOKALLAROUND
	+QUICKTORETALIATE
	+FRIENDLY
	-NORADIUSDMG
	+NOICEDEATH	//to prevent possibly weird behaviour of scripts
	+CANBLAST
	+SERVERNETID
	MinMissileChance 1
	PainChance 0
	Health 700
	MeleeThreshold 48
	MeleeRange 96
	Damage (80)
	SeeSound ""
	PainChance "Ice", 40
	PainChance "ThumperDamage", 255
	DamageFactor "ThumperDamage", 150 //Takes a fair bit of damage from thumper
	Alpha 0.3
	+INVULNERABLE
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_MaulotaurSpawned")
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_BobRecolor_CLIENTSIDE",0,tid)
		TNT1 A 0 A_PlaySound("minotaur/sight",CHAN_BODY,1.0,0,0.8)
		MNTR AAAAAAA 4 A_FadeIn(0.1)
		TNT1 A 0 A_ChangeFlag("INVULNERABLE",0)
		TNT1 A 0 A_Jump(255,"Idle")
	Idle:
		MNTR AB 10 A_Look
		MNTR A 0 A_JumpIf(!tidtohate, "Roam")
		Loop
	Roam:
		MNTR AA 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR BB 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR CC 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR DD 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR A 0 A_LookEx(0, 0, 4096)
		Loop
	See:
		TNT1 A 0 A_SetTranslucent(1.0)
		MNTR AA 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR BB 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR CC 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR DD 2 A_Chase TNT1 A 0 A_SetTranslucent(1.0)
		MNTR A 0 A_JumpIfTargetInLos("Missile")
		MNTR A 0 A_ClearTarget
		TNT1 A 0 A_Jump(255,"Roam")
		Goto Roam


	// Improved attack states
	Melee:
		//TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		MNTR V 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR V 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR V 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		//TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		MNTR X 15 A_CustomMeleeAttack(10*random(3,5),None,"minotaur/melee","Normal",1)
		Goto See
	Melee:
		MNTR V 10 A_FaceTarget
		MNTR W 7 A_FaceTarget
		MNTR X 12 A_MinotaurAtk1
		Goto See

	Missile:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		TNT1 A 0 A_Jump(192,"SwingMissiles")
		TNT1 A 0 A_Jump(255,"Hammer")
		Goto Hammer

	SwingMissiles:
		MNTR V 0 A_SetUserVar(user_HammerCount,0)
	SwingMissilesLoop:
		MNTR V 5 A_FaceTarget
		MNTR Y 4 A_FaceTarget
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		TNT1 A 0 A_PlaySound("minotaur/attack2",CHAN_WEAPON)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1",32,0, 12	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1",32,0, 6	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1",32,0,-6	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1",32,0,-12	)
		MNTR Z 9 A_CustomMissile("QCDEMinotaurFX1",32,0, 0		)
		TNT1 A 0 A_SetUserVar(user_HammerCount,user_HammerCount+1)
		TNT1 A 0 A_JumpIf(user_HammerCount>=2,"SwingEnder") //if it happened 3 times, then end it
		Loop
	SwingEnder:
		MNTR Z 3
		TNT1 A 0 A_Jump(255,"See")
		Goto See

	Hammer:
		MNTR V 0 A_SetUserVar(user_HammerCount,0)
	HammerSkipReset:
		MNTR V 5 A_FaceTarget
		MNTR W 7 A_FaceTarget
		TNT1 A 0 A_PlaySound("minotaur/attack3",CHAN_VOICE)
		TNT1 A 0 A_PlaySound("minotaur/attack1",CHAN_WEAPON)
		MNTR X 0 A_CustomMissile("QCDEMinotaurFX2",32,0, 0	)
		MNTR X 0 A_SetUserVar(user_HammerCount,user_HammerCount+1)
		TNT1 A 0 A_JumpIf(user_HammerCount>=2,"EndHammerSeq") //if hammer happened 3 times, then end it
		MNTR X 9
		Loop

	EndHammerSeq:
		MNTR X 20
		Goto See

	Charge:
		TNT1 A 0 A_Jump(255,"Hammer")
		Goto Hammer

	Pain:
		TNT1 A 0 A_JumpIf(alpha < 1.0, "Spawn")
		MNTR E 3
		MNTR E 6 A_Pain
		TNT1 A 0 A_Jump(255,"See")
		Goto See

	Death:
		MNTR E 3 A_GiveInventory("DaveisDedProc",1,AAPTR_MASTER) //notifies master that dave died
		MNTR E 1 A_Scream
		MNTR E 1 A_SpawnItemEx("MinotaurFog2")
		MNTR E 1
		MNTR E 1 A_NoBlocking
		MNTR E 1
		MNTR E 1 A_FadeOut
		Wait

	Pain.Ice:
		"####" "#" 0 A_GiveInventory("ImFrozen",1)
		"####" "#" 0 A_JumpIfInventory("ImFrozen",4,"SemiFrozen") //given by the projectile itself
		"####" "#" 0 A_CustomMissile("FrozenBlockShort")	//frozen effect
		"####" "#" 35 A_Pain
		"####" "#" 0 A_TakeInventory("ImFrozen",255)
		"####" "#" 0 A_Jump(256,"See") //virtual jump
		"####" "#" 35
		Goto See
	SemiFrozen:
		"####" "#" 0 A_CustomMissile("FrozenBlockLong")	//frozen effect
		"####" "#" 0 A_ChangeFlag("NOPAIN",1)
		"####" "#" 105
		"####" "#" 0 A_ChangeFlag("NOPAIN",0)
		"####" "#" 0 A_TakeInventory("ImFrozen",255)
		"####" "#" 0 A_Jump(256,"See") //virtual jump
		"####" "#" 35
		Goto See

	Pain.ThumperDamage:
		"####" "#" 0 A_ChangeFlag("NoPain",1)
		"####" "#" 0 A_Pain	//3sec
		"####" "#######" 5 A_SpawnItemEx("ShockSparkSpawner",random(6,-6),random(6,-6),random(30,60),0,0,0,0,32)
		"####" "#######" 5 A_SpawnItemEx("ShockSparkSpawner",random(6,-6),random(6,-6),random(30,60),0,0,0,0,32)
		"####" "#######" 5 A_SpawnItemEx("ShockSparkSpawner",random(6,-6),random(6,-6),random(30,60),0,0,0,0,32)
		"####" "#" 0 A_ChangeFlag("NoPain",0)
		Goto See

	}
}



Actor QCDEMaulotaurPvE : QCDEMaulotaur
{
	+DONTBLAST
	Health 1800
	States
	{
	// Improved attack state
	Melee:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		TNT1 A 0 A_Jump(96,"Missile")
		MNTR V 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR V 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR V 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 3 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		MNTR W 2 A_Recoil(-3)		TNT1 A 0 A_FaceTarget
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		MNTR X 15 A_CustomMeleeAttack(20*random(4,8),None,"minotaur/melee","Normal",1)
		Goto See

	SwingMissiles:
		MNTR V 0 A_SetUserVar(user_HammerCount,0)
	SwingMissilesLoop:
		MNTR V 5 A_FaceTarget
		MNTR Y 4 A_FaceTarget
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_DavieDontHurtMeDontHurtMeNoMore")
		TNT1 A 0 A_PlaySound("minotaur/attack2",CHAN_WEAPON)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1PvE",32,0, 12	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1PvE",32,0, 6	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1PvE",32,0,-6	)
		TNT1 A 0 A_CustomMissile("QCDEMinotaurFX1PvE",32,0,-12	)
		MNTR Z 9 A_CustomMissile("QCDEMinotaurFX1PvE",32,0, 0		)
		TNT1 A 0 A_SetUserVar(user_HammerCount,user_HammerCount+1)
		TNT1 A 0 A_JumpIf(user_HammerCount>=2,"SwingEnder") //if it happened 3 times, then end it
		Loop

		DoSimpleSwingMissile:
			MNTR Z 9 A_CustomMeleeAttack(20*random(4,8),None,None,"Normal",1)
			Goto See

	Hammer:
		MNTR V 0 A_SetUserVar(user_HammerCount,0)
	HammerSkipReset:
		MNTR V 5 A_FaceTarget
		MNTR W 7 A_FaceTarget
		TNT1 A 0 A_PlaySound("minotaur/attack3",CHAN_VOICE)
		TNT1 A 0 A_PlaySound("minotaur/attack1",CHAN_WEAPON)
		MNTR X 0 A_CustomMissile("QCDEMinotaurFX2PvE",32,0, 0	)
		MNTR X 0 A_SetUserVar(user_HammerCount,user_HammerCount+1)
		TNT1 A 0 A_JumpIf(user_HammerCount>=2,"EndHammerSeq") //if hammer happened 3 times, then end it
		MNTR X 9
		Loop


		DoSimpleSwingHammer:
			MNTR X 12 A_CustomMeleeAttack(20*random(4,8),None,None,"Normal",1)
			Goto See

	}
}



//teleport fx
Actor MinotaurFog1 : QCFog replaces MinotaurSmoke {
	+NONETID
}
Actor MinotaurFog2 : QCFog replaces MinotaurSmokeExit {
	+NONETID
}

// Projectiles
Actor QCDEMinotaurFX1 : MinotaurFX1 replaces MinotaurFX1
{
	+SERVERNETID
	Speed 26
	Damage (10)
	Species "Players"
	States
	{
	Spawn:
		// Move out of Maulotaur, because with missile owner changed, Maulotaur will get hit immediately
		TNT1 A 0 NoDelay A_Warp(AAPTR_DEFAULT, 40)
		// From target's master to own target
		// Meaning "instead of Menelkir's Maulotaur's missile, become Menelkir's missile"
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_MaulotaurAttacks")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) < 2,"MThruSpecies")
		Goto Super::Spawn
	MThruSpecies:
		TNT1 A 0 A_ChangeFlag("MTHRUSPECIES", true)
		Goto Super::Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Death
	}
}
Actor QCDEMinotaurFX1PvE : QCDEMinotaurFX1	//Only stronger
{
	Damage 8
	+DONTBLAST
}



Actor QCDEMinotaurFX2 : MinotaurFX2 replaces MinotaurFX2
{
	+SERVERNETID
	Damage (20)
	Speed 20
	States
	{
	Spawn:
		// Move out of Maulotaur, because with missile owner changed, Maulotaur will get hit immediately
		TNT1 A 0 NoDelay A_Warp(AAPTR_DEFAULT, 40)
		// From target's master to own target
		// Meaning "instead of Menelkir's Maulotaur's missile, become Menelkir's missile"
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_MaulotaurAttacks")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) < 2,"MThruSpecies")
		Goto Super::Spawn
	MThruSpecies:
		TNT1 A 0 A_ChangeFlag("MTHRUSPECIES", true)
		Goto Super::Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(255,"Death")
		Goto Death
	Death:
		FX13 I 4 Bright A_Explode(40,128,0)
		FX13 JKLM 4 Bright
		Stop
	}
}

Actor QCDEMinotaurFX2PvE : QCDEMinotaurFX2
{
	Damage 10
	+DONTBLAST
	States
	{
	Death:
		FX13 I 4 Bright A_Explode(128,128,0)
		FX13 JKLM 4 Bright
		Stop
	}
}



Actor QCDEMinotaurFX3 : MinotaurFX3 replaces MinotaurFX3
{
	+SERVERNETID
	States
	{
	Death:
		FX13 I 4 Bright A_Explode(18,128,0)
		FX13 JKLM 4 Bright
		Stop
	}
}

Actor DaveisDedProc : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	RenderStyle None
	States
	{
	Spawn:
		MEGA A 6
		Loop
	Pickup:
		TNT1 A 0 ACS_NamedExecuteAlways("MyBoyIsDed",0,0,0,0)	//plays minotaur death sound in master's head
		Stop
	}
}


//--------------------------------------------------------
//		Passive ability
//--------------------------------------------------------


Actor MenelkirHourglass : Hourglass
{
	Inventory.PickupMessage "$GOT_MenelkirHourglass" // "Picked up a necromantic hourglass."
	Alpha 0.0
	Scale 0.7
	RenderStyle Add
	+NOBLOCKMAP
	States
	{
	Spawn:
		TNT1 A 10
		SAND AAAAAAAAAA 1 Bright A_FadeIn(0.1)
		SAND A 0 Bright A_ChangeFlag("NOBLOCKMAP", false)
		SAND AAAAAAAA 35 Bright						//8 sec
		SAND AAAAAAAAAA 7 Bright A_FadeOut(0.1)		//2 sec
		Stop
	OK:
		TNT1 A 0 A_JumpIfInventory("ImprovedHourglasses",1,"VeryOK")
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_Hourglass",0,15)
		Stop
	VeryOK:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_Hourglass",0,25)
		Stop
	}
}

Actor MenelkirMonsterHourglass : MenelkirHourglass
{
	Scale 0.6
	States
	{
	OK:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_Hourglass",0,10)
		Stop
	}
}
