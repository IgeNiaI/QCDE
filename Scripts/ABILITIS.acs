int last_quieter;
Script "QCDE_QuietusHit" (void)
{
	last_quieter = GetActorProperty(0, APROP_TargetTID);
	//log(s:"Last quieter is set to ", d:last_quieter, s:" -- ", n:last_quieter -999);
}

int quieting_for[64], quieter_of[64];
#define QUIETING_AMOUNT  6
#define QUIETING_DAMAGE 10
#define QUIETING_PERIOD 35
Script "QCDE_QuietusVictim" (void)
{
	int plr = PlayerNumber();
	if(!isEnemy(last_quieter - 1000)) terminate; // No self nor team quietance
	quieter_of[plr] = last_quieter;

	// Already quieted by somebody? Update the other script
	if(quieting_for[plr])
	{
		quieting_for[plr] = QUIETING_AMOUNT;
		//log(n:plr+1, s:" updates quieter ", d:quieter_of[plr], s:" -- ", n:quieter_of[plr] -999, s:" and duration to ", d:quieting_for[plr]);
		terminate;
	}

	// New quietance
	//log(n:plr+1, s:" gets quieted by ", d:quieter_of[plr], s:" -- ", n:quieter_of[plr] -999, s:" for ", d:quieting_for[plr]);
	quieting_for[plr] = QUIETING_AMOUNT;
	ACS("QCDE_ZedekFireLevel", quieting_for[plr], plr+1000);
	while(quieting_for[plr] --> 0)
	{
		int t = QUIETING_PERIOD;
		while(t --> 0)
			if(GetActorProperty(plr+1000,APROP_HEALTH) > 0)
				delay(1);

		SetActivator(quieter_of[plr]);
		Thing_Damage(plr+1000, QUIETING_DAMAGE, MOD_LAVA);
		GiveInventory("HitBeepLow",1);
		ACS("QCDE_ZedekFireLevel", quieting_for[plr], plr+1000);
		if(GetActorProperty(plr+1000,APROP_HEALTH) <= 0) break;
		//log(n:plr+1, s:" gets quieted by ", d:quieter_of[plr], s:" -- ", n:quieter_of[plr] -999, s:" for ", d:quieting_for[plr]);
	}
	quieting_for[plr] = 0;
}



//---------------------------------
//		Inqusitor's Active


// This define must be float
#define SHIELD_PROLONGATION 1.5
Script "QCDE_Ability_Inquisitor" (void)
{
	int plr = PlayerNumber();
	if(tics[plr]) terminate;
	int stage = CheckInventory("InquisitorStageToken");

	// bots only activate second stage 5% of the clicks, about every 3rd ability use, at random
	if(stage == 1 && PlayerIsBot(PlayerNumber()) && random(0,20)) terminate;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("InquisitorStageToken",1); // post-incrementing token count
	SetNetworkReplicationFlags( 0 );

	if(stage) terminate;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("ReflectiveInProc",1);
	SetNetworkReplicationFlags( 0 );
	int baseDuration = GetDuration();
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", baseDuration);
	int t = baseDuration;
	while(t --> 0)
	{
		// stage 1: be stronk
		delay(1);
		stage = CheckInventory("InquisitorStageToken");
		if(stage > 1)
		{
			// stage 2: literally become shield and protec
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("ReflectiveCleanerProc",1);
			GiveInventory("BecomeShieldProc",1);
			SetNetworkReplicationFlags( 0 );
			ACS_NamedExecuteAlways("QCDE_Display_Shield_Message", 0, 0);

			int maxTics = baseDuration * SHIELD_PROLONGATION / 1.0;
			int moreTics = t * SHIELD_PROLONGATION / 1.0;
			ACS("QCDE_SetWeapon", "Shieldquisitor", moreTics);
			ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", maxTics, moreTics);

			int w;
			for(w = 0; w < NUMBER_OF_WEAPONS; w++)
				if(!stricmp(getWeapon(), weaponList[w]))
					break;

			t = moreTics; // prolonged duration
			while(t --> 0)
				if(GetActorProperty(0, APROP_Health) > 0) delay(1);
				else break;

			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("BecomeShieldCleanerProc",1);
			SetNetworkReplicationFlags( 0 );
			ACS_NamedExecuteAlways("QCDE_Clean_Shield_Message", 0, 0);

			delay(3); // add short delay before bringing up proper weapon, or else player can shoot his own shield with rocket

			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			//Unzoom if using toggle zoom
			if (!GetCVar("cl_holdZoom")) SetInventory("WeaponZoomedToken", 0);
			//Give and select fake weapon
			SetWeapon(weaponList[w]);
			//Remove ability weapon
			TakeInventory("Shieldquisitor",1);
			SetNetworkReplicationFlags( 0 );
			tics[plr] = 1;

			break; // exit outer loop
		}

		if(GetActorProperty(0, APROP_Health) <= 0) break;
	}
	tics[plr] = 0;
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("ReflectiveOutProc",1);
	SetNetworkReplicationFlags( 0 );
}

script "QCDE_Display_Shield_Message" (void)
{
	SetHUDsize(800,600,1);
	if(gametype()<=1)
		HUDmessage(s:"SP/Coop: Block only enemy attacks";HUDMSG_PLAIN,53,CR_GOLD,400.0,570.0,100.0);
	else if(gametype()>=2)
		HUDmessage(s:"Deathmatch: Block enemy and friendly attacks";HUDMSG_PLAIN,53,CR_GOLD,400.0,570.0,100.0);
}

script "QCDE_Clean_Shield_Message" (void)
{
		HUDmessage(s:" ";HUDMSG_PLAIN,53,CR_GOLD,400.0,570.0,0.3);
}


//---------------------------------
//		Bitterman's Active

Script "QCDE_Ability_Bitterman" (void)
{
	int howmuch = CheckInventory("PowerShieldCharge");
	int gameidentifierhere;
	// not more than max allowed, starting from
	int max = CheckInventory("MaxArmorToken") + 25 - CheckInventory("BasicArmor");
	if(howmuch > max) howmuch = max;

	if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
		GiveInventory("QCArmorPoint", howmuch);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	TakeInventory("PowerShieldCharge", howmuch);
	PlaySound(0,"QC/Abilities/Bitterman/ShieldRestore",CHAN_7,1.0,false,0.9);
	SetNetworkReplicationFlags( 0 );

	//The "Michaelis' Magic Code" that figures if it's coop, FFA or TDM!
	if(GameType() < GAME_NET_DEATHMATCH || CheckInventory("TeamDeathmatch"))
	{
		gameidentifierhere=2; // coop or TDM
	}
	else
	{
		gameidentifierhere=3; //FFA
	}

	// GetActorPitch is -0.25 at highest and +0.25 at lowest
	// Extra height goes from +26.0 at highest to -26.0 at lowest
	int extraheight = GetActorPitch(0) * 26 * -4;

	int x = GetActorX(0);
	int y = GetActorY(0);
	int z = GetActorZ(0) + 30.0 + extraheight;
	int count = CheckInventory("PowerShieldCharge");
	SetInventory("PowerShieldCharge", 0);
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
	if(GetNetworkState() != NETSTATE_CLIENT && !InDemoMode() && gameidentifierhere != 3) //Not FFA
	{
		if(IsPVE()) count = count * FixedSqrt(PlayerCount() * 2.0) / 5.0;
		while(count --> 0)
		{
			SpawnForced("QCArmorBitterman", x,y,z);

			if(count % 40 == 0)
			{
				z += 4.0;
				delay(1);
			}
		}
	}

	delay(GetDuration());
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}


