Actor DamageNumberInf : DamageNumber1
{
	ReactionTime 7
	Scale .45
	States
	{
	Spawn:
		DNIN A 0 Nodelay A_ChangeVelocity(-1,0,-.5,CVF_RELATIVE) // stays in place
		Goto Super::Idle
	}
}


