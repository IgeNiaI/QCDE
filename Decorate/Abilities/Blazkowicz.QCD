// ----------------------------------------------------------------------------
//
// Blazkowicz's abilities
//
// Active:	Diesel+laserkrafkek
//
// Passive: Healing to next 25hp multiple
//
// ----------------------------------------------------------------------------


//--------------------------------------------------------
// Active
//--------------------------------------------------------
Actor AkimboProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("BlazkoAkimbo", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("ActiveInProgress", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_SelectWeapon("BlazkoAkimbo")
		TNT1 A 0 A_FireCustomMissile("AkimboSounder",0, false)
		Stop
	}
}
Actor AkimboCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("BlazkoAkimbo", 0, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("BlazkoAkimboBot", 0, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("ActiveInProgress", 0, TIF_SKIPOWNER)
		TNT1 A 0 SetPlayerProperty(0,0,PROP_INSTANTWEAPONSWITCH)
		Stop
	}
}


Actor AkimboSounder	//literally just to play the alarm sound
{
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	+SERVERNETID
	Projectile
	RenderStyle None
	Scale 0.5
	Alpha 0.99
	States
	{
	Spawn:
		BLZK Y 0 NODELAY A_PlaySound("QC/Abilities/Blazkowicz/Alarm",5,1.0,0,0.5)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Warp(AAPTR_TARGET, 0,-7, 45, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Warp(AAPTR_TARGET, 0,-7, 45, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION)
		Stop
	}
}


Actor BlazkoAkimbo : QCWeapon
{
	Height 40
	Weapon.SelectionOrder 5000
	+INVENTORY.UNDROPPABLE
	+WEAPON.MELEEWEAPON
	+WEAPON.CHEATNOTWEAPON
	Inventory.PickupMessage "$GOT_BlazkoAkimbo" // "Diesel and Laserkraftwerk!"
	Obituary "$OB_BlazkoAkimbo" // "%o was put into spotlight by %k."
	Tag "$TAG_BlazkoAkimbo" // "Diesel and Laserkraftwerk"
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 1
		Stop

	Ready:
		TNT1 A 0 ACS_NamedExecuteAlways("CheckIfCorrectPlayer",0,1) // 1 = blazko
	Readyest:
		BLZK X 0 A_JumpIfInventory("BJLeft",1,"NoLeft")
		BLZK X 0 A_JumpIfInventory("BJRight",1,"NoRight")
		BLZK X 1 A_WeaponReady(WRF_DISABLESWITCH)
		Loop

	NoLeft:
		BLZK X 0 A_JumpIfInventory("BJRight",1,"NoneAtAll")
		BLZK X 1 A_WeaponReady(WRF_NOPRIMARY|WRF_DISABLESWITCH)
		Goto Readyest
	NoRight:
		BLZK X 0 A_JumpIfInventory("BJLeft",1,"NoneAtAll")
		BLZK X 1 A_WeaponReady(WRF_NOSECONDARY|WRF_DISABLESWITCH)
		Goto Readyest
	NoneAtAll:
		BLZK X 1 A_WeaponReady(WRF_NOFIRE|WRF_DISABLESWITCH)
		Goto Readyest

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		BLZK X 1 A_Raise
		"####" "#######" 0 A_Raise
		Loop

	Deselect:
		BLZK X 1 A_Lower
		"####" "#######" 0 A_Lower
		Loop

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_GiveInventory("BJLeft", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GunFlash("FireLeftKeepRight")
		TNT1 A 0 A_PlaySound("QC/Abilities/Blazkowicz/Napalm",CHAN_WEAPON)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
		TNT1 A 0 A_FireCustomMissile("DieselBall",0,0,-5)
		Goto FinishFire

	PerformDM:
		TNT1 A 0 A_FireCustomMissile("DieselBallDM",0,0,-5)
		Goto FinishFire

	FinishFire:
		TNT1 A 0 ACS_NamedExecuteAlways("BJTimerLeft",0,0,0,0)
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		TNT1 A 0 A_SetBlend("Orange",0.2,7)
		TNT1 A 0 //empty just for safe landing between jumps
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FinishFireNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-1.8)
		BLZK HI 1 Bright
		BLZK JKL 1 A_SetPitch(pitch+0.6)
		BLZK G 1
		Goto Readyest

		FinishFireNoRecoil:
			BLZK HI 1 Bright
			BLZK JKL 1
			BLZK G 1
			Goto Readyest

	FireLeftKeepRight:
		BLZK A 6
		Stop

	//-----------------------
	// Fire Seq / Zoom
	//-----------------------
	AltFire:
		TNT1 A 0 A_GiveInventory("BJRight", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GunFlash("FireRightKeepLeft")
		TNT1 A 0 A_PlaySound("QC/Abilities/Blazkowicz/Laser",CHAN_5)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformAltDM")
		TNT1 A 0 A_RailAttack(random(20,35)*10,5,0,"Green","Green",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"LaserPuff",0,0,0,0,15.0,1.0,"LaserKraftTrail")
		Goto FinishAltFire

	PerformAltDM:
		TNT1 A 0 A_RailAttack(60,5,0,"Green","Green",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"LaserPuffDM",0,0,0,0,15.0,1.0,"LaserKraftTrail")
		Goto FinishAltFire

	FinishAltFire:
		TNT1 A 0 ACS_NamedExecuteAlways("BJTimerRight",0,0,0,0)
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
		TNT1 A 0 A_SetBlend("96c7ff",0.2,7)
		TNT1 A 0 //empty just for safe landing between jumps
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FinishAltFireNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-1.8)
		BLZK BC 1 Bright
		BLZK DEF 1 A_SetPitch(pitch+0.6)
		BLZK A 1
		Goto Readyest

		FinishAltFireNoRecoil:
			BLZK BC 1 Bright
			BLZK DEF 1
			BLZK A 1
			Goto Readyest

	FireRightKeepLeft:
		BLZK G 6
		Stop
	}
}

Actor BJRight : Token {}
Actor BJLeft  : Token {}

//----------------------------------
// Diesel part
Actor DieselBall
{
	+FORCEXYBILLBOARD
	Projectile
	-NOGRAVITY
	+SEEKERMISSILE
	+MTHRUSPECIES
	+DONTBLAST
	Gravity 0.4
	Speed 25
	Radius 3
	Height 6
	Damage 40
	Scale 0.85
	RenderStyle Add
	Alpha 0.99
	SeeSound "Doom4/Monsters/MancubRocket"
	DeathSound "Doom4/Other/FireballHit1"
	Decal "FireballScorchBig"
	Obituary "$OB_DieselBall" // "%o had some of %k's diesel."
	States
	{
	Spawn:
		X029 A 0 NODELAY A_Jump(210,2,4,6,8)
		X029 ABCDEFGHIJK 1 Bright Light("YellowMediumFlicker2") A_SpawnItemEx("DieselFlamelet", random(6,-6),random(6,-6),random(6,-6), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED,128)
		Goto Spawn+1

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathCont

	DeathCont:
		TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE)
		TNT1 A 0 A_RadiusThrust(120,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//extra thrust because damage thrust alone is not enough
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(random(100,200),128,0)
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_SpawnItemEx("DieselExplo",0,0,0,0,0,0,random(0,359),SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION|SXF_NOUNLAGGED)
		TNT1 A 2 Light("YellowMediumFlicker1")
		TNT1 A 2 Light("YellowMediumFlicker2")
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowSmallFlicker1")
		TNT1 A 2 Light("YellowSmallFlicker2")
		TNT1 A 2 Light("YellowSmallFlicker3")
		Stop
	}
}

Actor DieselBallDM : DieselBall
{
	-MTHRUSPECIES
	-DONTBLAST
	Damage 0
	States
	{
	DeathCont:
		TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE)
		TNT1 A 0 A_RadiusThrust(120,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//extra thrust because damage thrust alone is not enough
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(30,160,0,1,64)	//30 damage he doesnt take, but other do at bigger radius
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_SpawnItemEx("DieselExplo",0,0,0,0,0,0,random(0,359),SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION|SXF_NOUNLAGGED)
		TNT1 A 2 Light("YellowMediumFlicker1")
		TNT1 A 2 Light("YellowMediumFlicker2")
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowSmallFlicker1")
		TNT1 A 2 Light("YellowSmallFlicker2")
		TNT1 A 2 Light("YellowSmallFlicker3")
		Stop
	}
}

Actor DieselBallBot : DieselBallDM
{
	States
	{
	Spawn:
		X029 A 0 NODELAY ThrustThingZ(0,(random(10,20)),0,0)
		X029 A 0 A_Jump(210,2,4,6,8)
		X029 ABCDEFGHIJK 1 Bright Light("YellowMediumFlicker2") A_SpawnItemEx("DieselFlamelet", random(6,-6),random(6,-6),random(6,-6), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION,128)
		Goto Spawn+2
	DeathCont:
		TNT1 A 0 A_Explode(80,128,0,1,20)	//no self damage for bots
		Goto Super::DeathCont+1
	}
}

Actor DieselExplo
{
	+NOINTERACTION
	+BRIGHT
	Scale 0.65
	RenderStyle Add
	Alpha 0.99
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	States
	{
	Spawn:
		DB53 AABBCCDDEEFFGGHHIIJJ 1 A_SetScale(scaleX+frandom(0.0,0.07))
		DB53 JJKKKLLLMMM 1 A_FadeOut
		Stop
	}
}
Actor DieselFlamelet
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	RenderStyle Add
	Scale 0.22
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(255,"T1","T2")
		Goto T1
	T1:
		X052 ABCDEFGHIJKLMNOPQRS 1 Bright
		Stop
	T2:
		X056 ABCDEFGHIJKLMNOPQRS 1 Bright
		Stop
	}

}

//----------------------------------
// Laser part
Actor LaserKraftTrail
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	Scale 0.14
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.5]"
	States
	{
	Spawn:
		HSPL A 0 NODELAY A_Jump(256,1,2,3,4,5,6,7,8)
		HSPL ABCDEFGH 0 A_Jump(256,"Play")
	Play:
	Looper:
		"####" "#" 1 BRIGHT A_FadeOut(0.03)
		"####" "#" 0 BRIGHT A_SetScale(scalex-0.003)
		Loop
	}
}

Actor LaserPuff
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+EXTREMEDEATH
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Impact")
		TNT1 A 0 A_SpawnItemEx("LaserPuffFx", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop
	}
}

Actor LaserPuffDM : LaserPuff
{
	-MTHRUSPECIES
}

Actor LaserPuffFx
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.5]"
	Scale 0.35
	Alpha 0.99
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"Type1","Type2","Type3")
	Type1:
		DB63 A 0
		Goto EndAnimation
	Type2:
		DB64 A 0
		Goto EndAnimation
	Type3:
		DB65 A 0
		Goto EndAnimation

	EndAnimation:
		"####" AA 0 A_SpawnItemEx("LaserLightning",7,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		"####" A 0 A_Jump(128,2)
		"####" A 0 A_SetScale(-0.9,0.9)
		"####" A 0 //nuthn
		"####" ABCDE 1 Bright
		"####" FGHIJK 1 Bright
		"####" LMNOPQRSTUVWXYZ 1 Bright
		Stop
	}
}

Actor LaserLightning
{
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.5]"
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.99
	scale 0.3
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"T1","T2","T3","T4","T5")

		T1:	DLI1 A 0
			Goto PlayOff
		T2:	DLI2 A 0
			Goto PlayOff
		T3:	DLI3 A 0
			Goto PlayOff
		T4:	DLI4 A 0
			Goto PlayOff
		T5:	DLI5 A 0
			Goto PlayOff

	PlayOff:
		"####" A 0 A_Jump(128,"FromL")

		FromA:
			"####" ABCDE 1 Bright
			"####" FGHIJK 1 Bright
			Stop
		FromL:
			"####" LMNOP 1 Bright
			"####" QRSTUV 1 Bright
			Stop
	}
}


// Version of the weapon for bots: half the time will do alt fire
// and diesel shot is pushed upwards a tad
Actor BlazkoAkimboBot : BlazkoAkimbo
{
	States
	{
	//-----------------------
	// Fire Seq
	//-----------------------
	NoLeft:
		BLZK X 0 A_JumpIfInventory("BJRight",1,"NoneAtAll")
		BLZK X 0 A_Jump(50,"AltFire")
		BLZK X 1 A_WeaponReady(WRF_NOPRIMARY)
		Goto Ready
	Fire:
		TNT1 A 0 A_JumpIfInventory("BJRight",1,"DoNormalFire")
		TNT1 A 0 A_Jump(128,"AltFire")
	DoNormalFire:
		TNT1 A 0 A_GiveInventory("BJLeft",1)
		TNT1 A 0 A_GunFlash("FireLeftKeepRight")
		TNT1 A 0 A_PlaySound("QC/Abilities/Blazkowicz/Napalm",CHAN_WEAPON)
		TNT1 A 0 A_FireCustomMissile("DieselBallBot",0,0,-5)
		TNT1 A 0 ACS_NamedExecuteAlways("BJTimerLeft",0,0,0,0)
		TNT1 A 0 A_SetPitch(pitch-1.8)
		TNT1 A 0 A_SetBlend("Orange",0.1,7)
		BLZK HI 1 Bright
		BLZK JKL 1 A_SetPitch(pitch+0.6)
		BLZK G 1
		Goto Ready
	}
}



Actor AkimboBotProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("BlazkoAkimboBot")
		TNT1 A 0 A_GiveInventory("ActiveInProgress")
		TNT1 A 0 A_SelectWeapon("BlazkoAkimboBot")
		TNT1 A 0 A_FireCustomMissile("AkimboSounder",0, false)
		Stop
	}
}
