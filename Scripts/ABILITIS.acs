#define LUCIENNE_MIN_DAMAGE    25
#define LUCIENNE_MAX_DAMAGE  2000
#define LUCIENNE_HURT_PERCENT  10
#define LUCIENNE_HEAL_PERCENT  20

Script "QCDE_Ability_Lucienne" (void)
{
	if(ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown()))
	{
		extraAbilityData[PlayerNumber()]++;
		SetLastUse(Timer());
