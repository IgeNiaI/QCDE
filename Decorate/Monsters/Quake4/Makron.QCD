//=====================================================================================
//=====================================================================================
Actor Q4Makron : QCDE_MonsterBoss	15313	//Makron (stage1)
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	var int user_attmainangle;
	var int user_attsweepangle;
	Monster
	Radius 35
	Height 90
	Health 2000
	+NORADIUSDMG
	+NOBLOOD
	+BOSS
	+NOICEDEATH
	+FLOORCLIP
	Mass 5000
	PainChance 20
	Speed 11
	Scale 0.65
	Obituary "$OB_Q4Makron" // "%o was purely intimidated by the dreaded Makron."
	SeeSound "quake4/Makron/Voice"
	PainSound "quake4/Makron/Pain"
	DeathSound "quake4/Makron/Death"
	ActiveSound "quake4/Makron/Voice"
	Tag "$TAG_Q4Makron" // "Makron"

	States
	{
	Idle:
		Q12I A 4 A_Look
		Loop
	See:
		Q12W A 4 A_Chase
		TNT1 a 0 A_PlaySound("quake4/Makron/Step",5)
		Q12W BC 4 A_Chase
		TNT1 a 0 A_PlaySound("quake4/Makron/Step",6)
		Q12W D 4 A_Chase
		TNT1 a 0 A_PlaySound("quake4/Makron/Step",5)
		Q12W EF 4 A_Chase
		TNT1 a 0 A_PlaySound("quake4/Makron/Step",6)
		Loop


	Missile:
		TNT1 A 0 A_Jump(110,"DarkMatterBeam")	//will do this att most of the time
		TNT1 A 0 A_Jump(256,"DarkMattGun","Blaster","SummonAllies","GrenadeAttack")


	DarkMattGun:
		Q12A AABB 4 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Weapons/DMG/Fire")
		TNT1 A 0 A_CustomMissile("DMGShotMonster",42,8,0)
		Q12A CDE 4
		Goto See

	Blaster:
		Q12A AB 5 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Gladiator/BlasterShot")
		Q12A C 0 A_CustomMissile("Q4MakronBlasterShot",52,10,20+random(10,-10))
		Q12A C 0 A_CustomMissile("Q4MakronBlasterShot",52,10,-20+random(10,-10))
		Q12A C 4 A_CustomMissile("Q4MakronBlasterShot",52,10,0)
		TNT1 A 0 A_Jump(5,"See")
		TNT1 A 0 A_MonsterRefire(0,"See")
		Goto Blaster+1

	DarkMatterBeam:
		TNT1 A 0 A_SetUserVar("user_attsweepangle",80)
		TNT1 A 0 A_PlaySound("quake4/Weapons/DMG/EnergyAttack")
		TNT1 A 0 A_Jump(128,"MainLeftToRight")

		MainRightToLeft:			//viewed from the front, otherwise is backwards
			TNT1 A 0 A_SetUserVar("user_attmainangle",40)
			Q12B ABC 3 A_FaceTarget
			Goto DMBeamLoop1
		MainLeftToRight:
			TNT1 A 0 A_SetUserVar("user_attmainangle",-40)
			Q12B ABC 3 A_FaceTarget
			Goto DMBeamLoop2

		DMBeamLoop1:		//main shot from left to right
			TNT1 A 0 A_JumpIf(user_attsweepangle<=-80,"DMBeamEnd")
			TNT1 A 0 A_PlaySound("quake4/Weapons/DMG/ProjectileLoop",6,1,1)
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex1",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle-2)
			Q12B D 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex2",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle-3)
			Q12B E 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex1",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle-2)
			Q12B F 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex2",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle-3)
			Q12B G 2 A_FaceTarget
			Loop

		DMBeamLoop2:		//main shot from right to left
			TNT1 A 0 A_JumpIf(user_attsweepangle<=-80,"DMBeamEnd")
			TNT1 A 0 A_PlaySound("quake4/Weapons/DMG/ProjectileLoop",6,1,1)
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex1",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle+2)
			Q12B D 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex2",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle+3)
			Q12B E 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex1",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeam",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle+2)
			Q12B F 2 A_FaceTarget
			TNT1 a 0 A_SpawnItemEx("DMGHeldVortex2",45,-15,50,0,0,0,0,SXF_NOCHECKPOSITION)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attmainangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle)
			TNT1 A 0 A_CustomMissile("DarkMatterBeamLongTrail",55,-15,user_attsweepangle*(-1))
			TNT1 A 0 A_SetUserVar("user_attsweepangle",user_attsweepangle-5)
			TNT1 A 0 A_SetUserVar("user_attmainangle",user_attmainangle+3)
			Q12B G 2 A_FaceTarget
			Loop
		DMBeamEnd:
			TNT1 A 0 A_StopSound(6)
			Q12B DEFGBA 3
			Goto See

	SummonAllies:
		Q12C ABBBB 5 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Weapons/GrenLaunch/Fire")
		TNT1 AAA 0 A_CustomMissile("Q4MakronAllySpawner",80,15,random(90,-90))
		Q12C ABCCCBA 5
		Goto See

	GrenadeAttack:
		Q12C ABBBB 5 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Weapons/GrenLaunch/Fire")
		TNT1 A 0 A_CustomMissile("Q4GrenadeBig",80,15,0)
		Q12C ABCCCBA 5
		Goto See

	Pain:
		TNT1 A 0 A_StopSound(6)
		Q12P A 7 A_Pain
		Goto See

//	No special deaths since he has to spawn the other version of itself
	XDeathChecksDone:
	DeathChecksDone:
		TNT1 A 0 A_UnsetSolid
		TNT1 A 0 A_Scream
		TNT1 A 0 A_StopSound(6)
		Q12D A 4 A_Fall
		Q12D BCDE 4
		Q12D FFFFF 16 A_SpawnItemEx("BossDeathExplosion",random(30,-30),random(30,-30),random(20,80),0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AA 0 A_SpawnItemEx("BossDeathExplosion",random(30,-30),random(30,-30),random(20,80),0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("Q4Makron2",0,0,20,0,0,3,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
	Death.Corpse:
		Q12D G -1 A_GiveInventory("LOLImDead")
		Stop
	Crush:
		TNT1 A 0 A_JumpIfInventory("LOLImDead",1,"Death.Corpse")
		TNT1 AAA 0 A_SpawnItemEx("BossDeathExplosion",random(30,-30),random(30,-30),random(20,80),0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("Q4Makron2",0,0,20,0,0,3,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Goto Death.Corpse
	}
}


//**********************************************
Actor Q4MakronBlasterShot
{
	Projectile
	Radius 8
	Height 12
	Damage 6
	Speed 23
	Scale 0.75
	RenderStyle Add
	SeeSound ""
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	Decal "Q4PlasmaMonsterBig"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		LBA2 A 8 Light("OrangeMediumFlicker2") Bright A_SpawnItemEx("BigBlasterTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("BigBlasterExplo1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 4 A_SpawnItemEx("BigBlasterExplo2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}


//*********************************************************************
Actor Q4MakronAllySpawner
{
	Speed 18
	Radius 20
	Height 10
	Damage 0
	Scale 0.5
	Projectile
	+DONTSPLASH
	-NOGRAVITY
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_RearrangePointers(AAPTR_DEFAULT,AAPTR_TARGET,AAPTR_DEFAULT)
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		MI04 ABCD 4 A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,frandom(0,0.5),0,SXF_NOCHECKPOSITION)
		Goto Spawn+2
	Death:
		TNT1 A 0 A_SpawnItem("TeleportFog",0,0)
		TNT1 A 1 A_SpawnItemEx("Q4MkrnMinionsSpawner",0,0,0, 0,0,0, 0,SXF_TRANSFERPOINTERS)
		Stop
	}
}


Actor Q4MkrnAllySpwnrTrail
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Scale 0.2
	RenderStyle Add
	Alpha 0.7
	Translation "0:255=%[0,0,0]:[1,0,0]"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(230,2,6,10)
		X101 ABCDEFGHIJKLMNOP 2 Bright A_FadeOut(0.06)
		Goto Spawn+2
	}
}

Actor Q4MkrnMinionsSpawner : RandomSpawner
{
	DropItem "Q4LightGuard", 255, 10
	DropItem "Q4MachinegunGuard", 255, 10
	DropItem "Q4ShotgunGuard", 255, 10
	DropItem "Q4Grunt", 255, 9
	DropItem "Q4Gunner", 255, 5
	DropItem "Q4Berserker", 255, 5
	DropItem "Q4IronMaiden", 255, 2
	DropItem "Q4LightTank", 255, 1
}


//*********************************************************************
Actor Q4GrenadeBig
{
	PROJECTILE
	BounceType "Doom"
	+CANBOUNCEWATER
	-NOGRAVITY
	+EXTREMEDEATH
	+FORCERADIUSDMG
	Radius 8
	Height 8
	Speed 16
	Gravity 0.35
	Damage 24
	BounceFactor 0.4
	BounceSound "quake4/Weapons/GrenLaunch/Bounce"
	Scale 0.3
	ReactionTime 6
	Translation "176:191=212:223"
	Decal "Q4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 ThrustThingZ(0,20,0,1)
		TNT1 A 0 A_CountDown
		Q99E A 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E B 2 Bright
		TNT1 A 0 A_CountDown
		Q99E C 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E D 2 Bright
		TNT1 A 0 A_CountDown
		Q99E E 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E F 2 Bright
		TNT1 A 0 A_CountDown
		Q99E G 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E H 2 Bright
		TNT1 A 0 A_CountDown
		Q99E I 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E J 2 Bright
		TNT1 A 0 A_CountDown
		Q99E K 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E L 2 Bright
		TNT1 A 0 A_CountDown
		Q99E M 2 Bright A_SpawnItemEx("Q4MkrnAllySpwnrTrail",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Q99E N 2 Bright
		Goto Spawn+3
	Death:
		TNT1 A 0 A_PlaySound("quake4/Misc/GrenadeExplo")
		TNT1 AAAAAA 0 A_SpawnItemEx("Q4GBSwarm",0,0,8,random(-8,8),random(-8,8),random(5,10),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Explode(128,128,0)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor Q4GBSwarm
{
	PROJECTILE
	BounceType "Doom"
	+CANBOUNCEWATER
	-NOGRAVITY
	+EXTREMEDEATH
	+FORCERADIUSDMG
	Radius 8
	Height 8
	Speed 18
	Gravity 0.6
	Damage (20)
	BounceFactor 0.35
	BounceSound "quake4/Weapons/GrenLaunch/Bounce"
	Scale 0.18
	Translation "176:191=212:223"
	Decal "Scorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_StopSound
		Q99E A 3 Bright A_SpawnItemEx("GrenSmokeParticle",0,0,0,0,0,0.3,0,SXF_NOCHECKPOSITION)
		Q99E B 3 Bright
		Q99E C 3 Bright
		Q99E D 3 Bright A_SpawnItemEx("GrenSmokeParticle",0,0,0,0,0,0.3,0,SXF_NOCHECKPOSITION)
		Q99E E 3 Bright
		Q99E F 3 Bright
		Q99E G 3 Bright A_SpawnItemEx("GrenSmokeParticle",0,0,0,0,0,0.3,0,SXF_NOCHECKPOSITION)
		Q99E H 3 Bright
		Q99E I 3 Bright
		Q99E J 3 Bright A_SpawnItemEx("GrenSmokeParticle",0,0,0,0,0,0.3,0,SXF_NOCHECKPOSITION)
		Q99E K 3 Bright
		Q99E L 3 Bright
		Q99E M 3 Bright A_SpawnItemEx("GrenSmokeParticle",0,0,0,0,0,0.3,0,SXF_NOCHECKPOSITION)
		Goto Spawn+2
	Death:
		TNT1 A 0 A_PlaySound("quake4/Misc/GrenadeExplo")
		TNT1 A 0 A_Explode(24,90,1)
		TNT1 A 0 A_SpawnItemEx("Q4GBSwarmExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor GrenSmokeParticle
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Translucent
	Scale 0.12
	Alpha 0.35
	States
	{
	Spawn:
		TNT1 A 0
		X102 V 2 A_SetScale(scalex+0.015)
		TNT1 V 0 A_FadeOut(0.022)
		Loop
	}
}

Actor Q4GBSwarmExplo
{
	+FORCEXYBILLBOARD
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	Scale 0.75
	RenderStyle Add
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(0.6,1.0))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		X002 A 0
		Goto PlayOff
	Type2:
		X001 A 0
		Goto PlayOff
	PlayOff:
		"####" ABC 1 Bright Light("YellowSmallFlicker2")
		"####" EFG 1 Bright Light("YellowSmallFlicker1")
		"####" HIJ 1 Bright Light("YellowMediumFlicker3")
		"####" KLM 1 Bright Light("YellowMediumFlicker2")
		"####" NOP 1 Bright Light("YellowMediumFlicker3")
		"####" QRS 1 Bright Light("YellowSmallFlicker1")
		"####" TU 1 Bright Light("YellowSmallFlicker2")
		Stop
	}
}


Actor Quake4GrenSmallSmokeTrail
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Scale 0.175
	RenderStyle Translucent
	Alpha 0.67
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(210,3,5,7,9)
		PUF2 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_FadeOut(0.045)
		Stop
	}
}



