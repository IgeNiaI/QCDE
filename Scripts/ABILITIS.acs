//---------------------------------
//		Terminator's Passive

str AmmoType[8] = {
		"QCBulletAmmo",		//0  bullet
		"QCShellAmmo",		//1  shell
		"QCNailAmmo",		//2  nail
		"QCBoltAmmo",		//3  bolt
		"QCRocketAmmo",		//4  rocket
		"QCCoilAmmo",		//5  coil
		"QCSlugAmmo",		//6  slug
		"QCBFGAmmo"			//7  bfg
		};

Script "QCDE_Passive_Terminator" (void)
{
	//if(GetActorProperty(0,APROP_HEALTH) > 0) terminate;
	int TenTics, CurrentAmmo, PreviousAmmo;
	if (GameType() >= GAME_NET_DEATHMATCH)
		SetInventory("TerminatorRockets",10);
	else
		SetInventory("TerminatorRockets",20);

	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		if(CheckInventory("Freezetagged")) // FT fix
		{
			delay(50);
			continue;
		}

		if		(qcContains("Mac"))	CurrentAmmo=0;
		else if (qcContains("Sho"))	CurrentAmmo=1;
		else if (qcContains("Nai"))	CurrentAmmo=2;
		else if (qcContains("Tri"))	CurrentAmmo=3;
		else if (qcContains("Roc"))	CurrentAmmo=4;
		else if (qcContains("Lig"))	CurrentAmmo=5;
		else if (qcContains("Rai"))	CurrentAmmo=6;
		else if (qcContains("BFG"))	CurrentAmmo=7;
		else	//if any other weapon
			CurrentAmmo=-1;	//nothing at all

		TenTics++;			//Increase counter of tics

		if(CurrentAmmo != -1 && TenTics >= getTerminatorAmmoRegenInterval(CurrentAmmo))
		{
			if(CheckInventory(AmmoType[CurrentAmmo]) < GetAmmoCapacity(AmmoType[CurrentAmmo]))
				GiveInventory(AmmoType[CurrentAmmo] , getTerminatorAmmoRegenAmount(CurrentAmmo));
			else if(GameType() == GAME_NET_COOPERATIVE || // in cooperative
					CheckInventory("TeamDeathmatch"))  // or team deathmatch
			{
				// Drop small pickup and stop regen for time equal to normal regen period
				int x = GetActorX(0);
				int y = GetActorY(0);
				int z = GetActorZ(0) + 64.0;
				SpawnForced(strparam(s:AmmoType[CurrentAmmo], s:"Terminator"), x,y,z);
				//Log(s:strparam(s:AmmoType[CurrentAmmo], s:"Terminator"), s:" shared");
				Delay(getTerminatorAmmoRegenInterval(CurrentAmmo));
			}
			TenTics=0;
		}

		Delay(10);
	}
}

Script "QCDE_Terminator_Rockets_Full"
{
	if (CheckInventory("TerminatorRockets") >= 20)
		SetResultValue(1);
	else
		SetResultValue(0);
}

function int qcContains(str subst)
{
	// If 3-letter substring starting at second ("qcBFGdm") or at seventh ("qcheavyMAChinegun")
	// character equals weapon name input, that's the weapon we're looking for.
	// Partially inspired by AcsUtils StrFind.
	str weapon = GetWeapon();
	return  !stricmp(strmid(weapon, 2, 3), subst) ||
			!stricmp(strmid(weapon, 7, 3), subst);
}

//---------------------------------
//		Zedek's Passive

#define ZEDEK_MIN_FALL_SPEED  10
#define ZEDEK_POST_FALL_DELAY 10
Script "QCDE_Passive_Zedek" (void)
{
	// Give the ironfeet powerup
	if (GameType() >= GAME_NET_DEATHMATCH)
		GiveInventory("PowerZedekFeet_DM",1);
	else
		GiveInventory("PowerZedekFeet",1);

	// Stomping on landing for Zedek
	int zs0, zs1, landSpeed;

	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		// Speed history -- you're grounded if were flying but aren't anymore.
		zs0 = zs1;
		zs1 = GetActorVelZ(0) >> 16;
		if(zs0 < -ZEDEK_MIN_FALL_SPEED && !zs1)
		{
			landSpeed = -zs0;
			SetNetworkReplicationFlags( NETREP_SKIPOWNER | NETREP_NOUNLAGGED );
			SpawnProjectile(0, "ZedekCannonball", 0, 0,landSpeed*8, 0,0);
			SetNetworkReplicationFlags( 0 );
			delay(ZEDEK_POST_FALL_DELAY);
		}

		delay(1);
	}
}


