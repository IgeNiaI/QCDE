Script "QCDE_VoiceLineSubtitle" (int classid, int page, int index) clientside
{
	int cvar = GetUserCvar(CPN(),"cl_tauntSubtitles");
	if(!cvar) terminate;
	if(cvar == 1 && GameType() > GAME_SINGLE_PLAYER) terminate;
	if(cvar == 2 && GameType() > GAME_NET_COOPERATIVE) terminate;

	SetFont("SMALLFONT");
	SetHudSize(640,480,1);
	int subtitle = taunt_txt[classid][page][index];
	int duration_scalar = 100;
	int duration = fixedSqrt(strlen(subtitle) * 0.5) / 2 * duration_scalar / 100;
	HudMessage(s:"\n\c[brite]", s:subtitle; HUDMSG_TYPEON,HMID_SUBTITLES,-1, 320.4,478.2, duration,1.0/35,duration/2);
}
