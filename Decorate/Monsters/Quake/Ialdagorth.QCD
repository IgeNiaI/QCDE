//=============================================================================
//=============================================================================

// N.B.: This actor, unlike most others, has lights attached via GLDEFS.
// You can edit them in GLDefs/SpecificLights.QCD.


Actor QIaldagorth : QCDE_MonsterBoss	15106	// cyberdemon
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	var int user_attack;
	Translation "0:255=%[0.0,0.0,0.0]:[0.6,0.5,0.5]", "32:47=32:47", "176:191=176:191"
	Health 4000
	Radius 40
	Height 100
	Mass 10000
	Speed 8
	MeleeDamage 110
	Scale 0.85
	PainChance 15
	Monster
	+MISSILEMORE
	+MISSILEEVENMORE
	+BOSSDEATH
	+FLOORCLIP
	+DONTMORPH
	Tag "$TAG_QIaldagorth" // "Ialdagorth"
	SeeSound "Quake1/Ialdagorth/Sight"
	PainSound "Quake1/Ialdagorth/Pain"
	DeathSound "Quake1/Ialdagorth/Death"
	ActiveSound "Quake1/Ialdagorth/Idle"
	MeleeSound "Quake1/Shambler/SmackTear"
	HitObituary "$OBH_QIaldagorth" // "%o crumbled before Ialdagorth."
	Obituary "$OB_QIaldagorth" // "%o rode the lightning of Ialdagorth."
	DamageFactor "NgyrSpikes", 0.3 //to avoid getting raped by ngyrkorath's floor spikes
	MeleeRange 110
	BloodColor "DarkGreen"
	DropItem "BigHourglass"
	States
	{
	Idle:
		Q37I A 0 A_StopSound(7)
		Q37I A 10 A_Look
		Wait
	See:
		TNT1 A 0 A_PlaySound("Quake1/Ialdagorth/Step")
		Q37W AA 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowA",0,0)
		Q37W BB 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowB",0,0)
		Q37W CC 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowC",0,0)
		TNT1 A 0 A_PlaySound("Quake1/Ialdagorth/Step")
		Q37W DD 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowD",0,0)
		Q37W EE 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowE",0,0)
		Q37W FF 3 A_Chase		TNT1 A 0 A_SpawnItem("DSWShadowF",0,0)
		Loop

	Missile:
	CommonStage:
		Q37A A 0 A_SetUserVar(user_attack,0)
		Q37A A 0 A_PlaySound("Quake1/Shambler/ChargeElect")	TNT1 A 0 A_SpawnItemEx("LighningChargeParticles",30,15,120,random(15,-15),random(15,-15),random(10,-10),random(0,359),32)
		Q37A A 4 A_FaceTarget	TNT1 A   0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AA  0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AAA 0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AAA 0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AAA 0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A B 4 A_FaceTarget	TNT1 AAA 0 A_SpawnItemEx("LighningChargeParticles", 30,15,120, random(15,-15),random(15,-15),random(10,-10), 0,32)
		Q37A BBBBBBBB 4 A_FaceTarget
		TNT1 A 0 A_Jump(200,"LightningSpheres")	//select the attack
		Goto StaticRailAttack

		StaticRailAttack:
			TNT1 A 0 A_PlaySound("Quake1/Weapons/ThunderBoltStart",6,1,0,0.25)	//very audible
			TNT1 A 0 A_PlaySound("Quake1/Weapons/BeamLoop",7,1,1,0.7)	//quite audible
			TNT1 A 0 A_JumpIf(user_attack>=10,"QuitAtt")
			TNT1 A 0 A_CustomMissile("ShamTargeter",80,0,0)	//to make the target chase this guy if friendly
			TNT1 A 0 A_SpawnItemEx("LightningBallLooker",30,10,118,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
			TNT1 A 0 A_SpawnItemEx("Sham2LightningBallFakeA",30,10,125,0,0,0,0,32)
			TNT1 A 0 A_Explode(10,192,XF_NOTMISSILE,0,128)
			Q37A B 5 Bright A_FaceTarget
			TNT1 A 0 A_SpawnItemEx("LightningBallLooker",30,10,118,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
			TNT1 A 0 A_SpawnItemEx("Sham2LightningBallFakeB",30,10,125,0,0,0,0,32)
			Q37A B 5 Bright A_FaceTarget
			Q37A A 0 A_SetUserVar(user_attack,user_attack+1)
			Goto StaticRailAttack+1

		LightningSpheres:
			Q37A A 0 A_PlaySound("Quake1/Shambler/ShootElect",6,1,0,0.25) 	//very audible
			Q37A A 0 A_PlaySound("Quake1/Ialdagorth/LightningLoop",7,1,1,0.7) 	//quite audible
			TNT1 A 0 A_JumpIf(user_attack>=8,"QuitAtt")
			TNT1 A 0 A_FaceTarget
			Q37A D 6 Bright A_CustomMissile("IaldagorthProjectile",56,0,random(7,-7))
			Q37A D 6 Bright A_CustomMissile("IaldagorthProjectile",56,0,random(7,-7))
			Q37A D 6 Bright A_CustomMissile("IaldagorthProjectile",56,0,random(7,-7))
			Q37A A 0 A_SetUserVar(user_attack,user_attack+1)
			Goto LightningSpheres+1

		QuitAtt:
			Q37A D 5 A_StopSound(7)
			Goto See

	Melee:
		TNT1 A 0 A_Jump(40,"Missile")
		TNT1 A 0 A_PlaySound("Quake1/Ialdagorth/Melee",7)
		TNT1 A 0 A_Jump(190,"RightArm")
		Goto BothArms

		BothArms:
			Q37M ABC 5 A_FaceTarget
			Q37M D 5 A_CustomMeleeAttack(random(300,400),"Quake1/Shambler/SmackTear")
			Q37M EF 7
			Goto See
		RightArm:
			TNT1 A 0 A_JumpIfInventory("MeleeSideToken",1,"LeftArm")	//to switch arms betwen attacks
			TNT1 A 0 A_GiveInventory("MeleeSideToken",1)	TNT1 A 0 A_Recoil(-1.4)
			Q37N A 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N B 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N C 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N D 5 A_MeleeAttack							TNT1 A 0 A_Recoil(-1.4)
			Q37N E 5 A_FaceTarget
			Goto See
		LeftArm:
			TNT1 A 0 A_TakeInventory("MeleeSideToken",1)	TNT1 A 0 A_Recoil(-1.4)
			Q37N F 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N G 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N H 5 A_FaceTarget							TNT1 A 0 A_Recoil(-1.4)
			Q37N I 5 A_MeleeAttack							TNT1 A 0 A_Recoil(-1.4)
			Q37N J 5 A_FaceTarget
			Goto See

	Pain:
		Q37P A 2 A_StopSound(7)
		Q37P A 2 A_Pain
		Goto See

	DeathChecksDone:
		Q37D A 7 A_Scream
		Q37D A 0 A_StopSound(7) //attack looping sound
		Q37D B 7 A_Fall
		Q37D CDEF 6
		TNT1 A 0 A_PlaySound("quake4/NetworkGuard/BodyFall",6)
		"####" "#" 0 A_QueueCorpse
	Death.Corpse:
		Q37D G -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperBig",0,0,50,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	}
}

Actor DSWShadowA
{
	Translation "0:255=%[0.0,0.0,0.0]:[0.6,0.5,0.5]", "32:47=32:47", "176:191=176:191"
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	Scale 0.85
	RenderStyle Translucent
	Alpha 0.7
	States
	{
	Spawn:
		Q37W A 3 NoDelay A_FadeOut(0.05)
		Wait
	}
}

Actor DSWShadowB : DSWShadowA { States { Spawn: Q37W B 3 NoDelay A_FadeOut(0.05) Wait } }
Actor DSWShadowC : DSWShadowA { States { Spawn: Q37W C 3 NoDelay A_FadeOut(0.05) Wait } }
Actor DSWShadowD : DSWShadowA { States { Spawn: Q37W D 3 NoDelay A_FadeOut(0.05) Wait } }
Actor DSWShadowE : DSWShadowA { States { Spawn: Q37W E 3 NoDelay A_FadeOut(0.05) Wait } }
Actor DSWShadowF : DSWShadowA { States { Spawn: Q37W F 3 NoDelay A_FadeOut(0.05) Wait } }


Actor LighningChargeParticles
{
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.7]"
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	Scale 0.65
	RenderStyle Add
	+BRIGHT
	States
	{
	Spawn:
		TNT1 AAAAA 3 A_ScaleVelocity(0.5)
		EBLT A 2 A_ScaleVelocity(-1.0)
		EBLT BCDEF 3 A_ScaleVelocity(1.5)
		Stop
	}
}


//******************************************************
Actor LightningBallLooker
{
	Monster
	Speed 0
	Radius 5
	Height 10
	-COUNTKILL
	+LOOKALLAROUND
	-SOLID
	-SHOOTABLE
	+NOGRAVITY
	+NOCLIP
	RendersTyle None
	Scale 0.4
	Obituary "$OB_LightningBallLooker" // "%o turned into a conductor of Ialdagorth's power."
	AttackSound "Quake1/Weapons/ThunderBoltSingle"
	States
	{
	Spawn:
		ZAP7 a 0
		ZAP7 A 1 A_Look
	See:
		ZAP7 A 0 A_Chase
	Missile:
		ZAP7 A 5 A_FaceTarget
		ZAP7 A 1 A_CustomRailgun(6,0,"None","OliveDrab1",RGF_FULLBRIGHT,1,50,None,0,0,1536,3,28,0,"ShamblerLgTrail",0)
		Stop
	}
}


Actor Sham2LightningBallFakeA
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.7]"
	Scale 0.8
	States
	{
	Spawn:
		R058 ABC 2 Bright
		Stop
	}
}

Actor Sham2LightningBallFakeB : Sham2LightningBallFakeA
{	States
	{
	Spawn:
		R058 CDE 2 Bright
		Stop
	}
}

Actor ShamTargeter : FastProjectile
{
	Projectile
	Speed 300
	+RIPPER
	+BLOODLESSIMPACT
	Damage (1)
	RenderStyle None
	DamageType "NoDamageToPlayers" //this is so that other monsters target the shambler, rather than the attacker actor
	States
	{
	Spawn:
		TNT1 A 3
		Loop
	Death:
		TNT1 A 2
		Stop
	}
}

//******************************************************

Actor IaldagorthProjectile : ShamblerProjectile
{
	Speed 22
	Damage 8
	Scale 0.65
	States
	{
	Spawn:
		X024 ABCDEFGHIJK 2 Bright A_SpawnItemEx("ShamblerLightningParticle",0,0,0,0,frandom(2,-2),frandom(1,-1),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION,192)
		Loop
	Death:
		TNT1 A 0 A_Explode(10,128,0,0,64)
		TNT1 A 0 A_SpawnItemEx("ShamblerLightningSparks",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
		TXP1 A 0 A_SetScale(0.3)
		Goto DeathLooper
	}
}
