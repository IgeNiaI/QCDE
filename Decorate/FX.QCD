//$GZDB_SKIP

//----------------------------------------------------------------------
// Teleport fogs
//----------------------------------------------------------------------

Actor QCFog replaces TeleportFog
{
	+CLIENTSIDEONLY
	+SERVERNETID
	+FORCEXYBILLBOARD
	+BRIGHT
	Radius 3
	Height 5
	Renderstyle Add
	Scale 0.5
	Alpha 0.99
	+NOINTERACTION
	SeeSound ""
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Playsound("QCDE/Other/QCTeleport",CHAN_AUTO,1.0,false)
		TNT1 A 0 A_Warp(AAPTR_DEFAULT,0,0,30)
		DB17 AB        1 Bright Light("PurpleSmallPoint2")	A_SetScale(scalex+0.035)
		DB17 CD        1 Bright Light("PurpleSmallPoint1")	A_SetScale(scalex+0.035)
		DB17 EF        1 Bright Light("PurpleMediumPoint3")	A_SetScale(scalex+0.035)
		DB17 GHIJKLMNO 1 Bright Light("PurpleMediumPoint2")	A_SetScale(scalex+0.035)
		DB17 PQ        1 Bright Light("PurpleMediumPoint3")	A_SetScale(scalex+0.035)
		DB17 RS        1 Bright Light("PurpleMediumPoint3")	A_SetScale(scalex+0.035)
		DB17 TU        1 Bright Light("PurpleSmallPoint1")	A_SetScale(scalex+0.035)
		DB17 VW        1 Bright Light("PurpleSmallPoint2")	A_SetScale(scalex+0.035)
		DB17 XYZ       1 Bright Light("PurpleSmallPoint3")	A_SetScale(scalex+0.035)
		//DB17 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright A_SetScale(scalex+0.035)
		Stop
	}
}

Actor NewItemFog : QCFog replaces ItemFog
{
	Scale 0.4
	RenderStyle None
	Translation "0:255=%[0,0,0]:[0,1,2]"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 10
		Stop
	}
}



//----------------------------------------------------------------------
//	Tracers
//----------------------------------------------------------------------

Actor BulletSmallTracer : FastProjectile
{
	Projectile
	+RANDOMIZE
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+NOEXTREMEDEATH
	+DONTBLAST
	+NONETID
	damage 0
	radius 2
	height 2
	speed 125
	renderstyle ADD
	alpha 0.9
	scale 0.13
	states
	{
	Spawn:
		TRAC A 1
		TRAC A 70 BRIGHT A_PlaySound("QCDE/Other/BulletWhoosh", 5, 1.0, false, 3.0, AAPTR_TARGET)
		Stop
	Death:
		TNT1 A 1
		Stop
	XDeath:
		TNT1 A 1
		Stop
	}
}


//==================================================================================
//==================================================================================
//	This is used for powerup blurry background, like megahealth, invul, protecc,
//	quad, and galen's totems.
//==================================================================================
//==================================================================================
Actor GenericPowerupFXBackground
{
	var int user_t;
	var int user_x;
	var int user_y;
	var int user_z;
	var int user_minalpha;
	var int user_maxalpha;
	var int user_rendermode;
	+NOINTERACTION
	Radius 1
	Height 2
	Gravity 1.0
	Scale 0.8
	Alpha 0.01
	States
	{
	Spawn:
		PLAY B 0 NoDelay A_SetUserVar(user_maxalpha,100)
		"####" "#" 0 A_SetUserVar(user_x,0)
		"####" "#" 0 A_SetUserVar(user_y,0)
		"####" "#" 0 A_SetUserVar(user_z,0)
		Goto LooperIn
	PreLooperIn:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_EffectMustDie"), "EndOfLife")
		Goto LooperIn
	LooperIn:
		"####" "#" 1 BRIGHT A_SetTranslucent(user_t / 100.0, 1-user_rendermode)
		"####" "#" 0 A_SetUserVar(user_t, user_t + 5)
		"####" "#" 0 A_JumpIf(user_t >= user_maxalpha, "PreLooperOut")
		"####" "#" 10 BRIGHT A_Warp(AAPTR_TARGET, user_x,user_y,user_z,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP,"LooperIn")
		Goto EndOfLife
	PreLooperOut:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_EffectMustDie"), "EndOfLife")
		Goto LooperOut
	LooperOut:
		"####" "#" 1 BRIGHT A_SetTranslucent(user_t / 100.0, 1-user_rendermode)
		"####" "#" 0 A_SetUserVar(user_t, user_t - 2)
		"####" "#" 0 A_JumpIf(user_t <= user_minalpha, "PreLooperIn")
		"####" "#" 10 BRIGHT A_Warp(AAPTR_TARGET, user_x,user_y,user_z,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP,"LooperOut")
		Goto EndOfLife
	EndOfLife:
	Death:
		// This Long trail of invisible existence is required for lagged net games.
		// During the network downtime, the target is considered inexistent, so this
		// state will often be hit wrongly. If the FX actor actually hits Stop, item
		// stops shining after lag is over. This allows for up to 2 seconds of lag at
		// a time during which FX actor can find out that item wasn't actually taken.
		"####" "############################################################################" 1 BRIGHT A_FadeOut(0.25, false)
		Stop
	Remove:
		// This is immediate, for scripted removal.
		TNT1 A 0 Thing_ChangeTID(0,0)
		Stop
	}
}

const int TRANSLATION_REDTEAM   = 9200;
const int TRANSLATION_BLUETEAM  = 9201;
const int TRANSLATION_GCOLOR    = 9202;
const int TRANSLATION_MGCOLOR   = 9203;
const int TRANSLATION_SGCOLOR   = 9204;
const int TRANSLATION_NGCOLOR   = 9205;
const int TRANSLATION_HMGCOLOR  = 9206;
const int TRANSLATION_SSGCOLOR  = 9207;
const int TRANSLATION_SNGCOLOR  = 9208;
const int TRANSLATION_TBCOLOR   = 9209;
const int TRANSLATION_RLCOLOR   = 9210;
const int TRANSLATION_LGCOLOR   = 9211;
const int TRANSLATION_RGCOLOR   = 9212;
const int TRANSLATION_BFGCOLOR  = 9213;


//-----------------------------------------------------------------------------
//	Ally Marker
//-----------------------------------------------------------------------------

Actor AllyMarker : GenericPowerupFXBackground
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	+INVISIBLE_TO_TARGET
	Renderstyle Stencil
	Scale .02
	Alpha 1
	States
	{
	Spawn:
		ALLY B 0 NoDelay
		ALLY B 0 ACS_NamedExecuteWithResult("QCDE_AllyMarkerSpawned", args[0])
		Goto Looper
	Looper:
		"####" "#" 1 BRIGHT
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"), "Death")
		"####" "#" 10 BRIGHT A_Warp(AAPTR_TARGET, user_x,user_y,user_z,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP,"Looper")
		Goto Death
	}
}

//-----------------------------------------------------------------------------
//	Foe Marker
//-----------------------------------------------------------------------------

Actor CrownProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_ThrowGrenade("BestMarker")
		Stop
	}
}

Actor BestMarker : GenericPowerupFXBackground
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NONETID
	+BRIGHT
	+INVISIBLE_TO_TARGET
	Radius 1
	Height 2
	Gravity 0.0
	Scale 0.15
	States
	{
	Spawn:
		TNT1 A 1 NoDelay A_Warp(AAPTR_TARGET, 0,0,77,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_JumpIfInTargetInventory("PowerGhostTint",1,"Disappear")
		TNT1 A 0 A_JumpIfInTargetInventory("PowerWendigoTint",1,"Disappear") // This is a bad way of doing this, needs a refactor before 3.0
		BEST BBBBBBBBBB 1 A_Warp(AAPTR_TARGET, 0,0,77,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_JumpIfInTargetInventory("PowerGhostTint",1,"Disappear")
		TNT1 A 0 A_JumpIfInTargetInventory("PowerWendigoTint",1,"Disappear")
		BEST BBBBBBBBBB 1 A_Warp(AAPTR_TARGET, 0,0,77,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_JumpIfInTargetInventory("PowerGhostTint",1,"Disappear")
		TNT1 A 0 A_JumpIfInTargetInventory("PowerWendigoTint",1,"Disappear")
		BEST BBBBBBBBBB 1 A_Warp(AAPTR_TARGET, 0,0,77,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		TNT1 A 0 A_JumpIfInTargetInventory("PowerGhostTint",1,"Disappear")
		TNT1 A 0 A_JumpIfInTargetInventory("PowerWendigoTint",1,"Disappear")
		BEST BBBBBBBBBB 1 A_Warp(AAPTR_TARGET, 0,0,77,0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_STOP)
		Stop
	Disappear:
		TNT1 A 10
		Stop
	}
}




