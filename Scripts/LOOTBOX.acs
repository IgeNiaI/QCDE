Script "QCDE_UpdateBackpackStack" (void)
{
	ACS_NamedExecuteAlways("QCDE_SetBackpackStack",0,CheckInventory("BackpackRewardToken"));
}

Script "QCDE_SetBackpackStack" (int level)
{
	SetAmmoCapacity("QCBulletAmmo", BASE_BulletAmmo + LEVEL_BulletAmmo * level + CheckInventory("HunterQCBulletAmmo"));
	SetAmmoCapacity("QCShellAmmo" , BASE_ShellAmmo  + LEVEL_ShellAmmo  * level + CheckInventory("HunterQCShellAmmo" ));
	SetAmmoCapacity("QCNailAmmo"  , BASE_NailAmmo   + LEVEL_NailAmmo   * level + CheckInventory("HunterQCNailAmmo"  ));
	SetAmmoCapacity("QCBoltAmmo"  , BASE_BoltAmmo   + LEVEL_BoltAmmo   * level + CheckInventory("HunterQCBoltAmmo"  ));
	SetAmmoCapacity("QCRocketAmmo", BASE_RocketAmmo + LEVEL_RocketAmmo * level + CheckInventory("HunterQCRocketAmmo"));
	SetAmmoCapacity("QCCoilAmmo"  , BASE_CoilAmmo   + LEVEL_CoilAmmo   * level + CheckInventory("HunterQCCoilAmmo"  ));
	SetAmmoCapacity("QCSlugAmmo"  , BASE_SlugAmmo   + LEVEL_SlugAmmo   * level + CheckInventory("HunterQCSlugAmmo"  ));
	SetAmmoCapacity("QCBFGAmmo"   , BASE_BFGAmmo    + LEVEL_BFGAmmo    * level + CheckInventory("HunterQCBFGAmmo"   ));

	SetAmmoCapacity("SeriousBullets", BASE_SamBullets + LEVEL_SamBullets * level);
	SetAmmoCapacity("DukeAmmo", BASE_DukeAmmo + LEVEL_DukeAmmo * level);
}

str loadoutWeapons[8] = {
	"QCHeavyMachinegun",
	"QCSuperShotgun",
	"QCSuperNailgun",
	"QCTribolt",
	"QCRocketLauncher",
	"QCLightningGun",
	"QCRailgun",
	"QCBFG"
};
Script "loadout" (int howmany, int player) // A cheat!
{
	if(howmany < 1) howmany = 2;
	if(howmany > 8) howmany = 8;

	int step = random(0,3)*2 + 1;
	int x = lcg(8,4) - 1;

	int given;
	int tid = ActivatorTid();
	if(player >  0) tid = 999 + player; // for multiplayer cheats

	while(given++ < howmany)
	{
		SetActivator(tid);
		GiveInventory(loadoutWeapons[x], 2);
		ACS_NamedExecuteAlways("QCDE_ShowWeapon", 0, x, given, howmany);
		x = (x + step) % 8;
	}
}

Script "weakloadout" (int howmany, int player) // Also a cheat!
{
	if(howmany < 1) howmany = 2;
	if(howmany > 4) howmany = 4;

	int step = random(0,3)*2 + 1;
	int x = lcg(4,4) - 1;

	int given;
	int tid = ActivatorTid();
	if(player >  0) tid = 999 + player; // for multiplayer cheats

	while(given++ < howmany)
	{
		SetActivator(tid);
		GiveInventory(loadoutWeapons[x], 2);
		//ACS_NamedExecuteAlways("QCDE_ShowWeapon", 0, x, given + 4, howmany + 4);
		x = (x + step) % 4;
	}
}

int weapons_with_upgrades[10] = {0, 3, 7, 9, 11, 13, 15, 17, 19, 21};
Script "uppgradera" (int howmany, int player) // Also a cheat!
{
	if(howmany <  1) howmany =  3;
	if(howmany > 16) howmany = 16;

	int step = random(0,3)*2 + 1;
	int x = lcg(10,4) - 1;

	int given;
	int tid = ActivatorTid();
	if(player >  0) tid = 999 + player; // for multiplayer cheats

	while(given++ < howmany)
	{
		SetActivator(tid);
		GiveInventory(WeaponUpgrades[weapons_with_upgrades[x]][random(0,1)][WU_TOKEN], 2);
		x = (x + step) % 10;
	}
}

Script "lcgtest" (int number, int index, int iter)
{
	if(!iter) iter = 50;

	str s = "", value, sum, total;
	while(iter --> 0)
	{
		value = lcg(number,index);
		sum += value;
		total++;
		s = strparam(s:s, s:"  ", d:value);
	}

	printbold(s:"Testing up to ", d:number, s:" from LCG ", d:index, s:":\n", s:s, s:"\nAverage: ", f:sum * 1.0 / total);
}

#define DELAYED_ITEMS 4
str delayedItems[DELAYED_ITEMS] = {
	"Quad",
	"Protec",
	"Invul",
	"Infin"
};

#define PRE_DELAY 50
Script "QCDE_GiveDelayed" (void)
{
	// Doesn't happen on maps with no monsters
	if(GetLevelInfo(LEVELINFO_TOTAL_MONSTERS) == NO) terminate;

	// Waits for a second on new map -- otherwise indicators don't spawn
	while(Timer() < PRE_DELAY) delay(PRE_DELAY);

	int i;
	for(i = 0; i < DELAYED_ITEMS; i++)
	{
		str delayToken = strparam(s:"Delayed", s:delayedItems[i]);
		if(!CheckInventory(delayToken)) continue;

		str inventory = strparam(s:"QC", s:delayedItems[i]);
		GiveInventory(inventory,1);
		TakeInventory(delayToken,1);
		LocalAmbientSound("QC/Items/PowerupPick", 127);
	}
}

