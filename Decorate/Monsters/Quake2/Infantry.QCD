//===========================================================================
//===========================================================================

Actor Q2Infantry : QCDE_MonsterSmall 	15208	// chaingun guy
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	var int user_counter;
	Health 100
	Radius 20
	Height 56
	Mass 150
	Speed 8
	Monster
	+FLOORCLIP
	PainChance 32
	Tag "$TAG_Q2Infantry" // "Infantry"
	Obituary "$OB_Q2Infantry" // "%o was shot down by infantry."
	SeeSound "q2infantry/sight"
	PainSound "q2infantry/pain"
	DeathSound "q2infantry/death"
	ActiveSound "q2infantry/seeking"
	MeleeDamage 3
	Scale 0.53
	DropItem "Chaingun"
	States
	{
	Idle:
		INFI A 10 A_Look
		Loop
	See:
		INFW AA 2 A_Chase("Melee","")
		INFW BB 2 A_Chase("Melee","")
		INFW CC 2 A_Chase
		INFW EE 2 A_Chase("Melee","")
		INFW FF 2 A_Chase
		INFW HH 2 A_Chase
		Loop
	Melee:
		INFM ABCD 3 A_FaceTarget
		INFM E 3 A_PlaySound("q2infantry/slapswing")
		INFM F 3 A_MeleeAttack
		INFM GH 3 A_FaceTarget
		Goto See
	Missile:
		INFA ABC 4 A_FaceTarget
		INFA D 4 A_PlaySound("q2infantry/chaingunreload")
		INFA E 4 A_FaceTarget
		TNT1 A 0 A_SetUserVar("user_counter",0)

		MisLoop:
			TNT1 A 0 A_JumpIf(user_counter>=16,"MisEnd")
			TNT1 A 0 A_CustomMissile("MonsterTracerMidVol",40,5,frandom(5,-5))
			TNT1 A 0 A_SpawnItemEx("MonMuzzleFlashSmall",20,5,40,0,0,0,0,32)
			TNT1 A 0 A_PlaySound("q2infantry/chaingunattack")
			INFA F 4 Bright A_CustomBulletAttack(18,3,1,4)
			TNT1 A 0 A_SetUserVar("user_counter",user_counter+1)
			Loop
		MisEnd:
			INFA GHI 4 A_FaceTarget
			Goto See

	Pain:
		INFP A 4
		INFP A 4 A_Pain
		Goto See

	DeathChecksDone:
		INFD A 0 A_Scream
		INFD ABCDEFGHIIJKLMNOPQ 3
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Small")
		INFD R 3
		INFD S 3 A_Fall
	Death.Corpse:
		INFD T -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		INFD TSRQPONMLKJIHGFEDCBA 3
		Goto See
	}
}




