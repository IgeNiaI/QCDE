	}

	// Ammo number near weapons
	inInventory not NoAmmoCount {
	inInventory not RocketArena || Instagib {
		inInventory QCHeavyMachinegun 	|| QCHeavyMachinegunDM {
			inInventory QCBulletAmmo { inInventory QCBulletAmmo	, 51 { isSelected QCHeavyMachinegun	, QCHeavyMachinegunDM	{ drawNumber 3, QCFNT040, brite, QCBulletAmmo	, alignment(right), 1589,330; } else { drawNumber 3, QCFNT030, darkgrey, QCBulletAmmo	, alignment(right), 1589,330; } } else { isSelected QCHeavyMachinegun	, QCHeavyMachinegunDM		{ drawNumber 3, QCFNT040, red, QCBulletAmmo	, alignment(right), 1589,330; } else { drawNumber 3, QCFNT030, darkred, QCBulletAmmo, alignment(right), 1589,330; } } }
		} else {
		inInventory QCMachinegun 	|| QCMachinegunDM {
			inInventory QCBulletAmmo { inInventory QCBulletAmmo	, 51 { isSelected QCMachinegun		, QCMachinegunDM		{ drawNumber 3, QCFNT040, brite, QCBulletAmmo	, alignment(right), 1589,330; } else { drawNumber 3, QCFNT030, darkgrey, QCBulletAmmo	, alignment(right), 1589,330; } } else { isSelected QCMachinegun		, QCMachinegunDM			{ drawNumber 3, QCFNT040, red, QCBulletAmmo	, alignment(right), 1589,330; } else { drawNumber 3, QCFNT030, darkred, QCBulletAmmo, alignment(right), 1589,330; } } }
