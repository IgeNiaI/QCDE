	// Ability status and (de)buffs
	inInventory PowerClutchProtec     { drawImage "PWUPFRAM", 122,780; drawImage "PWUPFIR1", 122,780; drawImage "PWUPSHLD", 122,780; }
	inInventory TeleporterThrownToken { drawImage "PWUPFRAM", 122,780; drawImage "PWUPFIR1", 122,780; drawImage "PWUPDORB", 122,780; }
	inInventory MaulotaurAliveToken   { drawImage "PWUPFRAM", 122,780; drawImage "PWUPFIR1", 122,780; drawImage "PWUPMAUL", 122,780; }
