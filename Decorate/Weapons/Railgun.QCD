		Goto PrepareCont
	Prepare.Upgraded.QCDE1:
		Q0G7 A 0 A_PlaySound("QC/Weapons/Railgun/Idle_Default", CHAN_WEAPON, 0.4, 1, 1.25)
		Goto PrepareCont
	Prepare.Upgraded.HalfLife:
