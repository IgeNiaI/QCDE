 // ----------------------------------------------------------------------------
//
// Intruder's abilities
//
// Active:	Wendigo Curse
//          For the duration of the ability, if not attacking nor taking damage
//          you become invisible. When fully invisible, you take 25% less damage
//          and deal a bit of damage at random quick intervals to things near you.
//
// Passive: "His sparks"
//          Killing enemies grants speed boost and better visibility
//
// Passive: Treasure Hunter (PvE)
//          Finding a secret grants +50ap which can overstack
//
// ----------------------------------------------------------------------------

Actor CompatVer30_Intruder {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

// At the very start of the ability
Actor WendigoInProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("WendigoHUDTint",1,0,GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("GhostTerror",1,0,GIF_SKIPOWNER)
		//removes effects of thumper
		TNT1 A 0 SetPlayerProperty(0,0,PROP_FROZEN)
		TNT1 A 0 A_TakeInventory("PowerGrayThumpFlight",1,TIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("ActiveInProgress",1,0,GIF_SKIPOWNER)
		TNT1 A 0 A_FireCustomMissile("WendigoBreathingSounder",0, false,0,0, FPF_NOUNLAGGED|FPF_SKIPOWNER) //that which plays the breathing sound
		TNT1 A 35
		Stop
	}
}


//At the very end of the ability
Actor WendigoOutProc : CustomInventory
{
	States
	{
	Pickup:

		TNT1 A 0 A_SetTranslucent(1.0)
		TNT1 A 0 A_TakeInventory("PowerWendigoTint",1,TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("PowerGhostTerror",1,TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("PowerWendigoDMGNerf",1,TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("PowerWendigoProtect",1,TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("ActiveInProgress",0,TIF_SKIPOWNER)
		TNT1 A 35
		Stop
	}
}


//given when you fully fade out
Actor WendiInvisPowerUpProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("WendigoDamageProtect",1)
		TNT1 A 0 A_GiveInventory("WendigoDamageNerf",1)
		Stop
	}
}

//given when your invis gets interrupted
Actor WendiInvisPowerDownProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("PowerWendigoProtect",1)
		TNT1 A 0 A_TakeInventory("PowerWendigoDMGNerf",1)
		Stop
	}
}

//When fully invis, you constantly deal damage to things near you
Actor WendigoAuraDmgProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PvP")
		TNT1 A 0 A_Explode(random(5,20),128,XF_NOTMISSILE,0,128)
		Stop
	PvP:
		TNT1 A 0 A_Explode(5,128,XF_NOTMISSILE,0,128)
		Stop
	}
}



// To stain the screen for the entire duration of the ability
Actor PowerWendigoTint : PowerSpeed
{
	Speed 1.0
	+POWERSPEED.NOTRAIL
}

Actor WendigoHUDTint : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Powerup.Colormap 0,0,0, 1.3,0.3,0.3
	Powerup.Duration -100
	Powerup.Type "WendigoTint"
}

//when fully invis, you take a 33% less damage
Actor PowerWendigoProtect : PowerProtection
{
	DamageFactor "Normal", 0.67
}

Actor WendigoDamageProtect : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Powerup.Duration -100
	Powerup.Type "WendigoProtect"
}

//when fully invis, you also do a 3rd of damage
Actor PowerWendigoDMGNerf : PowerDamage
{
	DamageFactor "Normal", 0.67
}

Actor WendigoDamageNerf : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Powerup.Duration -100
	Powerup.Type "WendigoDMGNerf"
}



// Token given by Shooting and pain states of the player, to interrupt invis
Actor IntruderFadeBreakToken   : Token { Inventory.MaxAmount 1 Inventory.InterhubAmount 0 }
Actor RevealSoundToken   : Token { Inventory.MaxAmount 1 Inventory.InterhubAmount 0 }


Actor WendigoBreathingSounder
{
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	+SERVERNETID
	Projectile
	RenderStyle None
	Scale 0.5
	var int user_checker;
	States
	{
	Spawn:
		X123 A 0 NODELAY A_PlaySound("QC/Abilities/Intruder/WendigoStart",CHAN_BODY,1.0,0,1.5)
		X123 A 0  A_PlaySound("QC/Abilities/Intruder/WendigoIdle",CHAN_5,0.8,1,1.2)
	KeepGoing:
		X123 AAA 1 A_Warp(AAPTR_TARGET, 0,0,40, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		TNT1 A 0 A_JumpIfInTargetInventory("PowerWendigoReveal",1,"RevealSound")
		TNT1 A 0 A_JumpIfInTargetInventory("ImDead",1,"FullStop")
		TNT1 A 0 A_SetUserVar(user_checker,user_checker+1)
		TNT1 A 0 A_JumpIfInTargetInventory("ActiveInProgress",1,"KeepGoing")
		Goto Staph

	Staph:
		TNT1 A 0 A_PlaySound("QC/Abilities/Intruder/WendigoIdleOut",CHAN_5,0.8,0,1.2)
		X123 AAAAA 1 A_Warp(AAPTR_TARGET, 0,0,40, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		X123 AAAAA 1 A_Warp(AAPTR_TARGET, 0,0,40, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		Stop

	RevealSound:
		TNT1 A 0 A_JumpIf(user_checker==0,"SkipFirstScream")
		TNT1 A 0 A_PlaySound("QC/Abilities/Intruder/WendigoReveal",CHAN_6,1.0,0,1.0)
	SkipFirstScream:
		//3 tics here plus 3 tics on "keep going" to give time for the powerup to timeout before next check
		X123 AAA 1 A_Warp(AAPTR_TARGET, 0,0,40, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		TNT1 A 0 A_JumpIfInTargetInventory("ImDead",1,"FullStop")
		TNT1 A 0 A_JumpIfInTargetInventory("ActiveInProgress",1,"KeepGoing")
		Goto Staph

	FullStop:
		X123 A 5 A_StopSound(5)
		Stop
	}
}

Actor WendigoFootprint : FX
{
	+NONETID
	Radius 2
	Height 2
	+BRIGHT
	States
	{
	Spawn:
		X057 A 35
		X057 A 10 A_FadeOut
		Wait
	}
}

//auto timeout token to play the reveal sound
Actor PowerWendigoReveal : Powerup
{
	Powerup.Duration 5
}


// For instagib players to not be unfairly exterminated
Actor IntruderBodyTrailInstagib
{
	+NOINTERACTION +NOTONAUTOMAP
	+SERVERNETID
	RenderStyle Add
	XScale 0.68
	YScale 0.75
	Alpha 0.0
	Translation "0:255=%[0.2,0,0]:[1.5,0,0]"
	States
	{
	Spawn:
		QP31 A 0 NODELAY A_Jump(255,1,2,3,4)
		QP31 ABCD 0 A_Jump(255,"Doer")
	Doer:
		QP31 "#" 3 Bright
		QP31 "#####" 1 Bright A_FadeIn(0.199)
		QP31 "#" 1 Bright A_FadeOut(0.05)
		Wait
	}
}

//--------------------------------------------------------
// Passive
//--------------------------------------------------------


Actor PowerIntruderSpeed : PowerSpeed
{
	Speed 1.2
	powerup.duration -10
}


Actor IntruderSpeeder : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "IntruderSpeed"
	powerup.duration -10
}
