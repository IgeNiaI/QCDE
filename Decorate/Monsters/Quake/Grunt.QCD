//================================================================
//================================================================

Actor QGrunt : QCDE_MonsterSmall 	15105	// zombie
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 40
	Radius 20
	Height 56
	Mass 100
	Speed 13
	PainChance 200
	Monster
	Scale 0.475
	+FLOORCLIP
	Tag "$TAG_QGrunt" // "Shotgun Grunt"
	SeeSound "Quake1/Grunt/Sight"
	AttackSound "Quake1/Grunt/Shotgun"
	PainSound "Quake1/Grunt/Pain"
	DeathSound "Quake1/Grunt/Death"
	ActiveSound "Quake1/Grunt/Idle"
	Obituary "$OB_QGrunt" // "%o was shot by a Grunt."
	States
	{
	Idle:
		Q32I A 10 A_Look
		Loop
	See:
		Q32W ABCDEF 4 A_Chase
		Loop
	Missile:
		Q32A AB 5 A_FaceTarget
		TNT1 AAA 0 A_CustomMissile("MonsterTracerLowVol",32,2,random(3,-3))
		Q32A C 4 BRIGHT Light("PlayerFiringLight") A_CustomBulletAttack(10,5,4,1,"BulletPuff")
		Q32A DB 4
		Goto See
	Pain:
		Q32P A 4
		Q32P A 4 A_Pain
		Goto See

	DeathChecksDone:
		Q32D A 0 A_Scream
		Q32D A 4
		Q32D A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Q32D B 4 A_Fall
		Q32D C 4
		Q32D D 4 A_PlaySound("quake4/Misc/Body/Small")
		Q32D E 4
	Death.Corpse:
		Q32D F -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

    Ice:
		"####" "#" 0 A_GiveInventory("ImDead",1)
		"####" "#" 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q32D FEDCBA 5
		Goto See
	}
}

