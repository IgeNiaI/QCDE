		TNT1 A 0 A_SetScale(scalex+0.05)
		Loop
	}
}

//*****************************************
//	This is a copy of the DMG shot fired by the actual weapon
//	All the FX regarding this one can be found in the DMG.AED file
//	The only differences are: Much faster, less "suck in", less
//	radius damage while traveling, and also when explodes
//	and increased projectile damage, if it hits player directly,
//	player is fucked.
Actor DMGShotMonster
{
	var int user_count;
	Projectile
	Speed 16
	Radius 10
	Height 16
	+RIPPER
	+FORCERADIUSDMG
	+DONTREFLECT
	+SKYEXPLODE
	+NODAMAGETHRUST
	+FORCEXYBILLBOARD
	Damage 24
	Scale 0.7
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_count",0)
		TNT1 A 0 A_PlaySound("quake4/Weapons/DMG/ProjectileLoop",6,1,1)
	Travel:
		DB61 AA 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 BB 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 CC 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 DD 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 EE 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 FF 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 GG 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 HH 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 II 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 JJ 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 KK 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 LL 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 MM 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 NN 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
		DB61 OO 1 Light("DMGDarkness") Bright A_Explode(8,128,0) 		TNT1 A 0 A_RadiusThrust(-300,128,RTF_NOIMPACTDAMAGE,64)
