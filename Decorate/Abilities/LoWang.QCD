Actor CompatVer30_LoWang {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor NobitsuraProc1 : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/LoWang/Slash1",CHAN_AUTO,1.0,0,0.75)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
		TNT1 A 0 A_FireCustomMissile("NobitsuraSlash1SP",0,false,-3)
		Stop
	PerformDM:
		TNT1 A 0 A_FireCustomMissile("NobitsuraSlash1DM",0,false,-3)
		Stop
	}
}
Actor NobitsuraProc2 : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/LoWang/Slash2",CHAN_AUTO,1.0,0,0.75)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
		TNT1 A 0 A_FireCustomMissile("NobitsuraSlash2SP",0,false,-3)
		Stop
	PerformDM:
		TNT1 A 0 A_FireCustomMissile("NobitsuraSlash2DM",0,false,-3)
		Stop
	}
}

Actor NobitsuraSlash1SP
{
	var int user_counter;
	Projectile
	Speed 20
	Radius 8
	Height 9
	Damage 2
	Scale 0.5
	RenderStyle Add
	+RIPPER
	+NODAMAGETHRUST
	+EXTREMEDEATH
	+MTHRUSPECIES
	+FORCERADIUSDMG
	+DONTBLAST
	Obituary "$OB_NobitsuraSlash1SP" // "%o was cut in half by %k."
	ReactionTime 20	//for how long it travels
	States
	{
	Spawn:
		QP18 A 0
		TNT1 A 0 A_Jump(255,"Looper")
	Looper:
		QP18 Y 0 A_Explode(40,96,0,0,96)
		QP18 YY 1 Bright Light(RedMediumPoint3) A_SpawnItemEx("Slash1Trail",0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		QP18 Y 0 A_SetUserVar(user_counter,1)
		QP18 YY 0 A_CountDown
		Loop
	Death:
		TNT1 A 0 A_JumpIf(user_counter<1,"DethExplo")
		TNT1 A 2
		Stop
	DethExplo: //exploded as soon as it spawned
		TNT1 A 0 A_Explode(120,96,0,0,96)
		TNT1 A 2
		Stop
	}
}

Actor NobitsuraSlash2SP : NobitsuraSlash1SP
{
	States
	{
	Spawn:
		QP18 A 0
		TNT1 A 0 A_Jump(255,"Looper")
	Looper:
		QP18 Z 0 A_Explode(40,96,0,0,96)
		QP18 ZZ 1 Bright Light(RedMediumPoint3) A_SpawnItemEx("Slash2Trail",0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		QP18 Z 0 A_SetUserVar(user_counter,1)
		QP18 ZZ 0 A_CountDown
		Loop
	Death:
		TNT1 A 0 A_JumpIf(user_counter<1,"DethExplo")
		TNT1 A 2
		Stop
	DethExplo:	//exploded as soon as it spawned
		TNT1 A 0 A_Explode(120,96,0,0,96)
		TNT1 A 2
		Stop
	}
}



Actor NobitsuraSlash1DM : NobitsuraSlash1SP
{
	-MTHRUSPECIES
	-DONTBLAST
	Damage 0
	States
	{
	Looper:
		QP18 Y 0 A_Explode(9,96,0,0,96)
		QP18 YY 1 Bright Light(RedMediumPoint3) A_SpawnItemEx("Slash1Trail",0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		QP18 Z 0 A_SetUserVar(user_counter,1)
		QP18 YY 0 A_CountDown
		Loop
	DethExplo: //exploded as soon as it spawned
		TNT1 A 0 A_Explode(30,96,0,0,96)
		TNT1 A 2
		Stop
	}
}

