			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake3",-5)
			Goto CoopHold2Cont
