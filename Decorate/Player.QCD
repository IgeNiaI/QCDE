			RP12 G 4 A_Pain
			RP12 G 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP12 G 4
			BP12 G 4 A_Pain
			BP12 G 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP12 G 4
			QP12 G 4 A_Pain
			QP12 G 4 A_JumpIf(true, "Spawn")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP12 H 4
		QP12 I 4 A_PlayerScream
		QP12 J 4 A_NoBlocking
		QP12 KLMNOP 4
		QP12 Q -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP12 H 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP12 I 4 //A_XScream
		QP12 J 4 A_NoBlocking
		QP12 KLMNOP 4
		QP12 Q -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}




//======================================================================================
//
//		13. Sorgaul. AKA Sorkek
//
//======================================================================================

Actor QCSorgaul : QCPlayerHeavy
{
	Player.DisplayName "Sorgaul"
	Player.SoundClass "Sorgaul"

	XScale 0.54
	YScale 0.74

	Player.FootstepInterval 11
	Player.FootstepVolume 0.75

	Player.MaxHealth 125
	Health 125
	Player.StartItem "QCStartingArmor50"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 125
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 150

	Player.StartItem "Class_Sorgaul"
	Player.StartItem "Body_Big"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{

	Spawn:
		QP13 G 0 NoDelay
		QP13 G 0 A_JumpIfInventory("TeamColor",2, "RedSpawn")
		QP13 G 0 A_JumpIfInventory("TeamColor",1,"BlueSpawn")
		QP13 G 0 A_JumpIf(true,                   "DefSpawn")
		QP13 G 100
		Loop

		RedSpawn:
			RP13 A 0 A_JumpIf(momx||momy,"RedSee")
			RP13 G 3 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			Loop
		BlueSpawn:
			BP13 A 0 A_JumpIf(momx||momy,"BlueSee")
			BP13 G 3 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			Loop
		DefSpawn:
			QP13 A 0 A_JumpIf(momx||momy,"DefSee")
			QP13 G 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			Goto Spawn // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedSee") // so tempted to call it "Red Sea"
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		RedSee:
			RP13 ABCDEF 3 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			RP13 A 0 A_JumpIf(true,"RedSpawn")
			Loop
		BlueSee:
			BP13 ABCDEF 3 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			BP13 A 0 A_JumpIf(true,"BlueSpawn")
			Loop
		DefSee:
			QP13 ABCDEF 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP13 A 0 A_JumpIf(true,"Spawn") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMissile")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		RedMissile:
			RP13 GGGG 3 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			RP13 G 3 A_JumpIf(true, "Spawn")
			Loop
		BlueMissile:
			BP13 GGGG 3 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			BP13 G 3 A_JumpIf(true, "Spawn")
			Loop
		DefMissile:
			QP13 GGGG 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP13 G 3 A_JumpIf(true, "Spawn")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMelee")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP13 H 6 BRIGHT Light("PlayerFiringLight")
			RP13 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP13 H 6 BRIGHT Light("PlayerFiringLight")
			BP13 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP13 H 6 BRIGHT Light("PlayerFiringLight")
			QP13 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" L 1 A_JumpIf(true,                   "DefPain")
		Loop

		RedPain:
			RP13 L 4 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			RP13 L 4 A_Pain
			RP13 L 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP13 L 4 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			BP13 L 4 A_Pain
			BP13 L 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP13 L 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP13 L 4 A_Pain
			QP13 L 4 A_JumpIf(true, "Spawn")
			Loop

		RedPuncheroo:
			RP13 IJK 4
			RP13 K 4 A_JumpIf(true, "Spawn")
			Loop
		BluePuncheroo:
			BP13 IJK 4
			BP13 K 4 A_JumpIf(true, "Spawn")
			Loop
		DefPuncheroo:
			QP13 IJK 4
			QP13 K 4 A_JumpIf(true, "Spawn")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP13 M 4
		QP13 N 4 A_PlayerScream
		QP13 O 4 A_NoBlocking
		QP13 PQ 4
		QP13 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP13 M 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP13 N 4 //A_XScream
		QP13 O 4 A_NoBlocking
		QP13 PQ 4
		QP13 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


//======================================================================================
//
//		14. Duke Nukem
//
//======================================================================================
Actor QCDukeNukem : QCPlayerMedium
{
	Player.DisplayName "Duke Nukem" //Needed to have that space
	Player.SoundClass "DukeNukem"

	Scale 0.692

	Player.FootstepInterval 10
	Player.FootstepVolume 0.625

	Player.MaxHealth 150
	Health 150

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_DukeNukem"
	Player.StartItem "Body_Medium"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP14 e 0 nodelay
		QP14 e 0 a_jumpifinventory("teamcolor",2, "RedSpawn")
		QP14 e 0 a_jumpifinventory("teamcolor",1,"BlueSpawn")
		QP14 e 0 a_jumpif(true,                   "DefSpawn")
		QP14 e 100
		loop

		RedSpawn:
			RP14 a 0 a_jumpif(momx||momy,"RedSee")
			RP14 e 4 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			loop
		BlueSpawn:
			BP14 a 0 a_jumpif(momx||momy,"BlueSee")
			BP14 e 4 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			loop
		DefSpawn:
			QP14 a 0 a_jumpif(momx||momy,"DefSee")
			QP14 e 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			goto Spawn // to catch color

	See:
		"####" a 0 a_jumpifinventory("teamcolor",2, "RedSee") // so tempted to call it "red sea"
		"####" a 0 a_jumpifinventory("teamcolor",1,"BlueSee")
		"####" a 1 a_jumpif(true,                   "DefSee")
		goto DefSee // for preview screen and prediction

		RedSee:
			RP14 abcd 4 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			RP14 a 0 a_jumpif(true,"RedSpawn")
			loop
		BlueSee:
			BP14 abcd 4 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			BP14 a 0 a_jumpif(true,"BlueSpawn")
			loop
		DefSee:
			QP14 abcd 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP14 a 0 a_jumpif(true,"Spawn") // to catch color
			loop

	Missile:
		"####" a 0 a_jumpifinventory("teamcolor",2, "RedMissile")
		"####" a 0 a_jumpifinventory("teamcolor",1,"BlueMissile")
		"####" e 1 a_jumpif(true,                   "DefMissile")
		loop

		RedMissile:
			RP14 eeee 3 A_JumpIfInventory("ThirdPersonPunch",1,"RedPuncheroo")
			RP14 e 12 a_jumpif(true, "Spawn")
			loop
		BlueMissile:
			BP14 eeee 3 A_JumpIfInventory("ThirdPersonPunch",1,"BluePuncheroo")
			BP14 e 12 a_jumpif(true, "Spawn")
			loop
		DefMissile:
			QP14 eeee 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP14 e 12 a_jumpif(true, "Spawn")
			loop

		RedPuncheroo:
			RP14 GH 5
			RP14 H 4 A_JumpIf(true, "Spawn")
			Loop
		BluePuncheroo:
			BP14 GH 5
			BP14 H 4 A_JumpIf(true, "Spawn")
			Loop
		DefPuncheroo:
			QP14 GH 5
			QP14 H 4 A_JumpIf(true, "Spawn")
			Loop

	Melee:
		"####" a 0 a_jumpifinventory("teamcolor",2, "RedMelee")
		"####" a 0 a_jumpifinventory("teamcolor",1,"BlueMelee")
		"####" f 1 a_jumpif(true,                   "DefMelee")
		loop

		RedMelee:
			RP14 f 6 bright light("playerfiringlight")
			RP14 f 6 bright light("playerfiringlight") a_jumpif(true, "Spawn")
			loop
		BlueMelee:
			BP14 f 6 bright light("playerfiringlight")
			BP14 f 6 bright light("playerfiringlight") a_jumpif(true, "Spawn")
			loop
		DefMelee:
			QP14 f 6 bright light("playerfiringlight")
			QP14 f 6 bright light("playerfiringlight") a_jumpif(true, "Spawn")
			loop

	Pain:
		"####" a 0 a_jumpifinventory("teamcolor",2, "RedPain")
		"####" a 0 a_jumpifinventory("teamcolor",1,"BluePain")
		"####" g 1 a_jumpif(true,                   "DefPain")
		loop

		RedPain:
			RP14 b 4
			RP14 b 4 a_Pain
			RP14 b 4 a_jumpif(true, "Spawn")
			loop
		BluePain:
			BP14 b 4
			BP14 b 4 a_Pain
			BP14 b 4 a_jumpif(true, "Spawn")
			loop
		DefPain:
			QP14 b 4
			QP14 b 4 a_Pain
			QP14 b 4 a_jumpif(true, "Spawn")
			loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP14 I 5 A_PlayerScream
		QP14 J 5 A_NoBlocking
		QP14 KLM 5
		QP14 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP14 O 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP14 I 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP14 J 5 A_NoBlocking
		QP14 KLM 5
		QP14 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


//======================================================================================
//
//		15. Durandal, the AI in a Mjolnir battleroid
//
//======================================================================================
Actor QCDurandal : QCPlayerLight
{
	Player.DisplayName "Durandal"
	Player.SoundClass "Durandal"

	XScale 0.7
	YScale 0.65

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Durandal"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveDefensive"
	Player.StartItem "NotSpectator"

	DamageFactor "BobExploSP", 0.2599 //takes 1/4 of SP bob explo damage

	States
	{
	Spawn:
		QP15 A 0 NoDelay
		QP15 A 0 A_JumpIfInventory("TeamColor",2, "RedSpawn")
		QP15 A 0 A_JumpIfInventory("TeamColor",1,"BlueSpawn")
		QP15 A 0 A_JumpIf(true,                   "DefSpawn")
		QP15 A 100
		Loop

		RedSpawn:
			RP15 A 0 A_JumpIf(momx||momy,"RedSee")
			RP15 A 4
			Loop
		BlueSpawn:
			BP15 A 0 A_JumpIf(momx||momy,"BlueSee")
			BP15 A 4
			Loop
		DefSpawn:
			QP15 A 0 A_JumpIf(momx||momy,"DefSee")
			QP15 A 4
			Goto Spawn // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedSee")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		RedSee:
			RP15 BCDE 4
			RP15 A 0 A_JumpIf(true,"RedSpawn")
			Loop
		BlueSee:
			BP15 BCDE 4
			BP15 A 0 A_JumpIf(true,"BlueSpawn")
			Loop
		DefSee:
			QP15 BCDE 4
			QP15 A 0 A_JumpIf(true,"Spawn") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMissile")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		RedMissile:
			RP15 F 12
			RP15 F 12 A_JumpIf(true, "Spawn")
			Loop
		BlueMissile:
			BP15 F 12
			BP15 F 12 A_JumpIf(true, "Spawn")
			Loop
		DefMissile:
			QP15 F 12
			QP15 F 12 A_JumpIf(true, "Spawn")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedMelee")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" G 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP15 G 6 BRIGHT Light("PlayerFiringLight")
			RP15 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP15 G 6 BRIGHT Light("PlayerFiringLight")
			BP15 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP15 G 6 BRIGHT Light("PlayerFiringLight")
			QP15 G 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" A 1 A_JumpIf(true,                   "DefPain")
		Loop

		RedPain:
			RP15 A 4
			RP15 A 4 A_Pain
			RP15 A 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP15 A 4
			BP15 A 4 A_Pain
			BP15 A 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP15 A 4
			QP15 A 4 A_Pain
			QP15 A 4 A_JumpIf(true, "Spawn")
			Loop
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP15 H 5 A_PlayerScream
		QP15 I 5 A_NoBlocking
		QP15 JKLM 5
		QP15 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP15 O 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP15 P 4 A_NoBlocking
		QP15 QR 4
		QP15 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}


