#define MAX_TAUNT_RATE 35
int last_taunt_plr[64], taunts_spammed[64];
script "QCDE_Taunt" (int which) NET
{
	int plr = PlayerNumber();
	if(!PlayerInGame(plr)) terminate;
	if(GetActorProperty(1000 + plr,APROP_HEALTH) <= 0) terminate;
	if(last_taunt_plr[plr] + MAX_TAUNT_RATE + taunts_spammed[plr] > Timer())
	{
		print(s:"Chill out! You're taunting too often");
		last_taunt_plr[plr] = Timer();
		taunts_spammed[plr]++;
		terminate;
	}

	last_taunt_plr[plr] = Timer();
	if(taunts_spammed[plr] > 0) taunts_spammed[plr]--;

	if(!which) which = Timer();

	ACS("QCDE_VoiceLine", true, true, which);
}

