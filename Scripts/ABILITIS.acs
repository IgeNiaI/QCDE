int darkener_now;
Script "QCDE_DarkeningShotHits" (void)
{
	darkener_now = GetActorProperty(0, APROP_TargetTID) - 1000;
}

#define DARKEN_DURATION 1.5
#define DARKEN_FADEIN   0.1
#define DARKEN_FADEOUT  1.0
Script "QCDE_DarkenedVictim" (void)
{
	if(GameType() < GAME_NET_DEATHMATCH) terminate; // DM-only

	if(!isEnemy(darkener_now)) terminate; // don't darken allies

	ACS("QCDE_Darkening_Start", DARKEN_DURATION, DARKEN_FADEIN, DARKEN_FADEOUT);

	if(PlayerIsBot(PlayerNumber())) GiveInventory("NoWeaponFireToken",1);

	SetNetworkReplicationFlags( NETREP_NOUNLAGGED );
	SpawnProjectile(0, "BlindVisualizer", 0,0,0,0,0);
	SetNetworkReplicationFlags( 0 );

	int t = (DARKEN_DURATION + DARKEN_FADEIN + DARKEN_FADEOUT) * 35 / 1.0;
	while(t --> 0)
		if(GetActorProperty(0, APROP_HEALTH) > 0)
			delay(1);
		else
		{
			// Remove darkness if died
			ACS("QCDE_Darkening_Stop");
			TakeInventory("NoWeaponFireToken",1);
			terminate;
		}

	if(PlayerIsBot(PlayerNumber())) TakeInventory("NoWeaponFireToken",1);
}

//---------------------------------
//		Eleena's Active

Script "QCDE_Ability_Eleena" (void)
{
	if(tics[PlayerNumber()] && !CheckInventory("ActiveProgressToken")) terminate;

	int plrtid = ActivatorTid();
	int doptid = plrtid - 1000 + DOPPELGANG_TIDBASE;

	int px = GetActorX(0); int pxs = GetActorVelX(0);
	int py = GetActorY(0); int pys = GetActorVelY(0);
	int pz = GetActorZ(0); int pzs = GetActorVelZ(0);
	int pan = GetActorAngle(0);
	int ppi = GetActorPitch(0);

	// Spawn Doppelganger
	if(!tics[PlayerNumber()])
	{
		SetActorState(doptid, "Vanish"); // Vanish other possible doppelgangers

		if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
		{
			SpawnForced("Doppelganger", px,py,pz, doptid, pan >> 8);
			SetActorVelocity(doptid, pxs,pys,pzs, false, true);
			GiveActorInventory(doptid, "TeamColor", CheckInventory("TeamColor"));
			giveEleenaCloneWeaponSkins(doptid);

			int translation = GetActorProperty(plrtid, APROP_Translation);
			SetActorProperty(doptid, APROP_Translation, translation);

			ACS("QCDE_ColorDoppelganger_CLIENTSIDE");
		}

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("PowerShieldCharge", 3);
		SetNetworkReplicationFlags( 0 );

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("ActiveInProgress",1);
		SetNetworkReplicationFlags( 0 );
		ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
		ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		PlaySound(0,"QC/Abilities/Eleena/Activate",CHAN_AUTO,1.0,0,1.5);
		SetNetworkReplicationFlags( 0 );

		if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
		{
			SetActivator(doptid);
			SetPointer(AAPTR_MASTER,plrtid);
			SetActivator(plrtid);
		}

		int t = GetDuration();
		while(t --> 0) delay(1);

		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("PowerShieldCharge", 0);
		GiveInventory("GenericActiveCleanerProc", 1);
		SetNetworkReplicationFlags( 0 );
		terminate;
	}

	if(!CheckInventory("ActiveProgressToken")) terminate;

	if(!CheckInventory("PowerShieldCharge")) terminate;
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	TakeInventory("PowerShieldCharge", 1);
	SetNetworkReplicationFlags( 0 );

	// dx, dy, dz, pxs, pys, pzs, dxs, dys, dzs
	int dx = GetActorX(doptid); int dxs = GetActorVelX(doptid);
	int dy = GetActorY(doptid); int dys = GetActorVelY(doptid);
	int dz = GetActorZ(doptid); int dzs = GetActorVelZ(doptid);
	//int dan = GetActorAngle(doptid);
	//int dpi = GetActorPitch(doptid);

	SetPredictableValue(0, 0, 1);
	SetPredictableValue(0, 1, dx);
	SetPredictableValue(0, 2, dy);
	SetPredictableValue(0, 3, dz);
	SetPredictableValue(0, 4, dxs);
	SetPredictableValue(0, 5, dys);
	SetPredictableValue(0, 6, dzs);
	//SetPredictableValue(0, 7, dan);
	//SetPredictableValue(0, 8, dpi);

	// warp p to d; thrust p like d; turn p like d
	int recalltid = UniqueTid();
	if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
	{
		SpawnForced("MapSpot", px,py,pz, recalltid);
	}

	Warp(0, dx, dy, dz, 0, WARPF_ABSOLUTEPOSITION|WARPF_NOCHECKPOSITION);
	SetActorVelocity(plrtid, dxs,dys,dzs, false, true);
	//SetActorAngle(plrtid, dan);
	//SetActorPitch(plrtid, dpi);

	// warp d to p; thrust d like p; turn d like p
	if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
	{
		GiveActorInventory(doptid, "DrawAttentionProc", 1);
		Thing_Move(doptid, recalltid, true);
		GiveActorInventory(doptid, "DrawAttentionProc", 1);
		SetActorVelocity(doptid, pxs,pys,pzs, false, true);
		SetActorAngle(doptid, pan);
		SetActorPitch(doptid, ppi);

		Thing_Remove(recalltid);
	}

	// FX
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(doptid,"QC/Abilities/Eleena/SwapFake",CHAN_AUTO,1.0,false,1.5); // fake Eleena sound
	GiveInventory("EleenaSwapProc",1);
	SetNetworkReplicationFlags( 0 );
}

Script "QCDE_ColorDoppelganger_CLIENTSIDE" (void) CLIENTSIDE
{
	int plrtid = ActivatorTid();
	int plr = plrtid - 1000;
	int conplr = ConsolePlayerNumber();

	int doptid = plr + DOPPELGANG_TIDBASE;

	bool teamplay       = getCvar("teamplay");
	bool teamlms        = getCvar("teamlms");
	bool teampossession = getCvar("teampossession");
	bool teamgame       = getCvar("teamgame");

	// Your own is always cyan
	if (plr == conplr || PlayerIsSpectator(conplr))
		Thing_SetTranslation(doptid, TRANSLATION_LGCOLOR);
	// Teammates also see the clone
	else if((teamplay || teamlms || teampossession || teamgame) && (GetPlayerInfo(plr, PLAYERINFO_TEAM) == GetPlayerInfo(conplr, PLAYERINFO_TEAM)))
		Thing_SetTranslation(doptid, TRANSLATION_LGCOLOR);
}

#define DURATION_DOPPELGANGER 15
Script "QCDE_DoppelgangerSpawned" (void)
{
	if(CheckInventory("NotSpectator")) terminate;
	GiveInventory("NotSpectator",true);

	if(GetCvar("rocketarena")) GiveInventory(getRocketArenaWeaponName(), 1); // needs rework
	if(GetCvar("instagib"   )) GiveInventory(getInstagibWeaponName(), 1);

	delay(DURATION_DOPPELGANGER * 35);
	SetActorState(0, "Vanish");
}

