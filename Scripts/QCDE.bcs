int tiditer[256];
function int SetTidIfHadNone(int firsttid, int lasttid)
{
	if(ActivatorTid()) return ActivatorTid();

	int tidgrp = (firsttid - 1000) / 64 - 1;

	if(!tiditer[tidgrp]) tiditer[tidgrp] = firsttid;

	int tid =~- tiditer[tidgrp];
	while(IsTidUsed(++tid))
		if(tid >= lasttid) break;

	tiditer[tidgrp] = tid;

	// Worst case: we're running out of tids
	if(tid == lasttid)
	{
		if(!fails[tidgrp])
		{
			fails[tidgrp] = true;
			log(s:"\c[bludi]QCDE Error: exceeded maximum for ", s:failnames[tidgrp], s:" collection (failid = ", d:tidgrp, s:"). Expect things in this category to break.");
		}
	}

	Thing_ChangeTID(0, tid);
	return tid;
}



