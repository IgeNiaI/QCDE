			RP16 I 4
			RP16 I 4 A_Pain
			RP16 I 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP16 I 4
			BP16 I 4 A_Pain
			BP16 I 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP16 I 4
			QP16 I 4 A_Pain
			QP16 I 4 A_JumpIf(true, "Spawn")
			Loop
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP16 J 5 A_PlayerScream
		QP16 K 5 A_NoBlocking
		QP16 LMNOP 5
		QP16 Q -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
