		"####" "#" 0 A_SetUserVar(user_angle,0)
		"####" "#" 0 A_SetUserVar(user_frontdist,40)
		"####" "#" 0 A_SetUserVar(user_sidedist,50)
		"####" "#" 0 A_Jump(256,"Looper")	//for safety
