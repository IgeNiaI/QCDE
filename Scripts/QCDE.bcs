	"", // zero-length string serves as line break
	"Kane"      ,"Caleb"     ,"Menelkir"  ,"Nyx"    ,"Durandal"  ,"Lo Wang","Eleena"    ,"Lucienne"  ,"Hunter" ,"Postal", "Orbb",         "",
	"Ranger"    ,"Doomslayer","Corvus"    ,"Galen"  ,"Duke Nukem","Sarge"  ,"Grayson"   ,"Blazkowicz","Freeman","Painkiller", "Intruder", "",
	"Terminator","Zedek"     ,"Inquisitor","Sorgaul","Bitterman" ,"Keel"   ,"Eradicator","VorMatur"  ,"Major"  ,"Sam", "Brock",          "",
	"",
	// ^ insert more classes here
	// array should end with a zero-length string
};
str cpfaces[100] = {
	"", // zero-length string serves as line break
	"PortrC04","PortrC05","PortrC06","PortrC12","PortrC15","PortrC18","PortrC24","PortrC25","PortrC27","PortrC29","PortrC32", "",
	"PortrC01","PortrC02","PortrC03","PortrC11","PortrC14","PortrC17","PortrC19","PortrC21","PortrC22","PortrC30","PortrC31", "",
	"PortrC07","PortrC08","PortrC09","PortrC13","PortrC10","PortrC16","PortrC20","PortrC23","PortrC26","PortrC28","PortrC33", "",
	"",
	// ^ insert more classes here
	// array should end with a zero-length string
};

function void printcpnames(void)
{
	str s = "List of cpnames:";
	for(int y = 1; y <= 3; y++)
	{
		s = strparam(s:s, s:"\n\c", c:'m'+y);
		for(int x = 0; x < 10; x++)
		{
			s = strparam(s:s, s:getcpdata(0,y,x), s:", ");

		}
	}
	printbold(s:s);
	return;

	int row;
	for(int i = 0; i < 100; i++)
	{
		str name = cpnames[i];
		if(!strlen(name))
		{
			row++;
			s = strparam(s:s, s:"\n\c", c:'m'+row);
			if(row > 4) break;
		}
		else
		{
			s = strparam(s:s, s:cpnames[i], /*s:" ", s:cpfaces[i],*/ s:", ");
		}
	}

	printbold(s:s);
}

function void addcpname(int newname, int newface, int rowtarget)
{
	if(rowtarget < 0) rowtarget = 0;
	if(rowtarget > 4) rowtarget = 4;

	int row = 5;
	int i;
	for(i = CLASS_COUNT + 5; i > 0; i--)
	{
		str name = cpnames[i-1];
		str face = cpfaces[i-1];
		cpnames[i] = name;
		cpfaces[i] = face;
		if(!strlen(name))
		{
			row--;
			if(row < 0) return;
			if(row == rowtarget)
			{
				cpnames[i-1] = strparam(s:newname);
				cpfaces[i-1] = strparam(s:newface);
				break;
			}
		}
	}
	printbold(s:"Added ", s:newname, s:" at index ", d:i);
	CLASS_COUNT++;
}

function int getcpdata(int datum, int targetrow, int targetcol)
{
	int row, col;
	for(int i = 0; i < 100; i++)
	{
		if(row == targetrow && col == targetcol)
			switch(datum)
			{
			case no  : return cpnames[i];
			case yes : return cpfaces[i];
			}

		if(!strlen(cpnames[i]))
		{
			row++;
			col = 0;
			if(row > 4) break;
		}
		else
		{
			col++;
		}

	}

	return false;
}

function bool IsClassDisabled(void)
{
	str cvar = strparam(s:"_bc_", d:CheckInventory("ClassID"));
	return GetCvar(cvar);
}

