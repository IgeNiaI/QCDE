		DMHold4:
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "DMHold4.Modded")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "DMHold4.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "DMHold4.HalfLife")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "DMHold4.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 3, "DMHold4.Quake3")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 2, "DMHold4.Quake2")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 1, "DMHold4.Quake1")
		DMHold4.Default:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor2",-5)
			Goto DMHold4Cont
		DMHold4.Quake1:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,768,1,20,1.0,"LGworldactor2_Quake1",-5)
			Goto DMHold4Cont
