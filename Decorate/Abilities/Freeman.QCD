// ----------------------------------------------------------------------------
//
// Freeman's abilities
//
// Active:    Antigrav blast
//
// Passive:   Extraction
//
// Passive2:  HEV Suit
//
// ----------------------------------------------------------------------------

Actor CompatVer30_Freeman {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------
// PvP pt1: starting blast that spawns FX and deflects projectiles away, and deals 15dmg to nearby enemies
Actor PvPBlastInitialProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_RadiusThrust (25,160,RTF_NOIMPACTDAMAGE)
		TNT1 A 0 A_Blast(BF_NOIMPACTDAMAGE|BF_AFFECTBOSSES,255,192)
		//FX spawning
		TNT1 A 0 A_PlaySound("QC/Abilities/Freeman/Exhaust", 7, 1.0)
		TNT1 A 0 A_SpawnItemEx("FreemanElectroDustSpawner2",0,0,0, 0,0,0,  0, SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		Stop
	}
}
// PvP pt2: then more blasts that only deflects projectiles away for "extended" blast
Actor PvPBlastExtraProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 1 A_Blast(BF_NOIMPACTDAMAGE|BF_AFFECTBOSSES,255,192)
		Goto Stop
	}
}

//-------------------------------------------
// PvE: Blasts once, bigger radius, and deals damage to monsters when they hit a wall
Actor PvEBlastProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken", 1, 0, GIF_SKIPOWNER)
		TNT1 A 1 A_Blast(0,255,384)
		TNT1 A 0 A_PlaySound("QC/Abilities/Freeman/Exhaust", 7, 1.0)
		TNT1 A 0 A_SpawnItemEx("FreemanElectroDustSpawner2",0,0,0, 0,0,0,  0, SXF_NOCHECKPOSITION|SXF_SKIPOWNER|SXF_NOUNLAGGED)
		Stop
	}
}



