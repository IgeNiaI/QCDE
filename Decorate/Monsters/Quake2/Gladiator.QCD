//===========================================================================
//===========================================================================

Actor Q2Gladiator : QCDE_MonsterBig	15204	// mancubus
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 700
	Radius 25
	Height 60
	Mass 800
	Speed 13
	PainChance 90
	Scale 0.42
	MONSTER
	+FLOORCLIP
	Tag "$TAG_Q2Gladiator" // "Gladiator"
	SeeSound "q2gladiator/sight"
	PainSound "q2gladiator/pain"
	DeathSound "q2gladiator/death1"
	ActiveSound "q2gladiator/idle"
	MeleeRange 60
	Obituary "$OB_Q2Gladiator" // "%o was bested by a gladiator."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		GLAI A 10 A_Look
		Loop
	See:
		GLAW ABC 4 A_Chase("Melee","")
		GLAW DEF 4 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_PlaySound("q2weapon/railgunreload",4,1,0,0.6)
		TNT1 A 0 A_TakeInventory("RailgunInterrupted",32767)
		TNT1 A 0 A_CustomMissile("RailgunChargeIndicatorQ2Gladiator")
		GLAA FFFFFFFFF 4 A_FaceTarget
		TNT1 A 0 A_PlaySound("q2weapon/railgunfire",4,1,0,0.7)
		TNT1 A 0 A_CustomRailgun(0,15,"Orange","White",RGF_SILENT|RGF_FULLBRIGHT,1,0,None,0,0,2048,0,70.0,0,"Q2RailgunSmoke",11)
		GLAA G 8 A_CustomRailgun(random(20,40),15,"Orange","White",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT,1,0,None,0,0,2048,0,8.0,0,"Q2RailgunTrail",11)
		Goto See
	Melee:
		GLAA A 5 A_FaceTarget
		GLAA BC 4 A_FaceTarget
		GLAA D 3 A_CustomMeleeAttack(random(20,40),"quake4/Berserker/MeleeHit","quake4/Berserker/MeleeSwing","Normal",1)
		GLAA EF 3 A_FaceTarget
		Goto See
	Pain:
		GLAP A 0 A_GiveInventory("RailgunInterrupted",1)
		GLAP A 0 A_StopSound(4) //stops railgun charge sound
		GLAP A 1
		GLAP A 3 A_Pain
		Goto See

	DeathChecksDone:
		GLAD A 0 A_Scream
		GLAP A 0 A_GiveInventory("RailgunInterrupted",1)
		GLAP A 0 A_StopSound(4) //stops railgun charge sound
		GLAD ABC 4
		GLAD D 0 A_PlaySound("quake4/Misc/Body/Metal")
		GLAD D 3 A_Fall
		GLAD EFGHIJK 3
	Death.Corpse:
		GLAD L -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		GLAD LKJIHGFEDCBA 3
		Goto See
	}
}


Actor RailgunChargeIndicatorQ2Gladiator
{
	Renderstyle Add
	+NOINTERACTION
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[1.5,1.5,2]"
	Scale 0.7
	Alpha 1
	ReactionTime 36
	States
	{
	Spawn:
		X060 A 0 Bright NODELAY A_Warp(AAPTR_TARGET,20,20,50)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (1)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,20,20,50)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (2)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,20,20,50)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//so that it would check for this token ever 3 tics rather than every single tic
		X060 A 0 A_JumpIfInTargetInventory("RailgunInterrupted",1,"Death")
		Loop
	Death:
		TNT1 A 1
		Stop
	}
}
