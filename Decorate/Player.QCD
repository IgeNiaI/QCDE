		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" I 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP20 I 6 BRIGHT Light("PlayerFiringLight")
			RP20 I 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP20 I 6 BRIGHT Light("PlayerFiringLight")
			BP20 I 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP20 I 6 BRIGHT Light("PlayerFiringLight")
			QP20 I 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		RedPain:
			RP20 M 4
			RP20 M 4 A_Pain
			RP20 M 4 A_JumpIf(true, "Spawn")
			Loop
		BluePain:
			BP20 M 4
			BP20 M 4 A_Pain
			BP20 M 4 A_JumpIf(true, "Spawn")
			Loop
		DefPain:
			QP20 M 4
			QP20 M 4 A_Pain
			QP20 M 4 A_JumpIf(true, "Spawn")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP20 N 5
		QP20 O 5 A_PlayerScream
		QP20 P 5 A_NoBlocking
		QP20 QR 5
		QP20 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sound
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP20 N 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.6,false,1.2)
		QP20 O 5 A_XScream
		QP20 P 5 A_NoBlocking
		QP20 QR 5
		TNT1 A 0 A_StopSound(CHAN_BODY) //stops sliding sound
		QP20 S -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
