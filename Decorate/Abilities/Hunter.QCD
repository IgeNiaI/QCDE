Actor CompatVer30_Hunter {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor HunterSkullProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("ActiveInProgress",1,0,GIF_SKIPOWNER)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DM")
	SP:
		TNT1 A 0 A_SpawnItemEx("HunterSkull", 30,-30,52, 0,0,0,0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER,0,tid-1000+7528)
		Stop
	DM:
		TNT1 A 0 A_SpawnItemEx("HunterSkullDM", 30,-30,52, 0,0,0,0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER,0,tid-1000+7528)
		Stop
	}
}

Actor HunterCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("ActiveInProgress",1,TIF_SKIPOWNER)
		TNT1 A 0 Thing_Remove(tid-1000+7528)
		Stop
	}
}

Actor HunterSkull
{
	var int user_shot;
	Radius 3
	Height 3
	-SOLID
	-SHOOTABLE
	+NOINTERACTION
	+BRIGHT
	+ISMONSTER
	Radius 4 Height 4
	Scale 0.4
	Speed 0
	Gravity 0
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_SkullSpawned")
		TNT1 A 0 A_PlaySound("QC/Abilities/Hunter/Activate",CHAN_BODY,1.0,0,0.75,AAPTR_MASTER)
	Idle:
		AP27 A 1
		TNT1 A 0 A_Warp(AAPTR_MASTER, 30,-30,52, 0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_DONTCHASEGOAL|LOF_NOSEESOUND|LOF_NOJUMP, 0,1536, 0, 360)
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_HasLivingTarget"), "Shoot")
		Goto Idle
	Shoot:
		TNT1 A 0 A_JumpIf(user_shot>=1,"Waitering")
		TNT1 A 0 A_JumpIfTargetInLos("Fire", 0, JLOSF_SKIPOWNER)
		Goto Forget
	Fire:
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_SetUserVar(user_shot,1)
		TNT1 A 0 A_CustomMissile("PlHunterBall",4)
		Goto Idle
	Forget:
		TNT1 A 0 A_ClearTarget
		Goto Idle
	Waitering:
		TNT1 A 0 A_SetUserVar(user_shot,0)
		AP27 A 1 A_FaceTarget	TNT1 A 0 A_Warp(AAPTR_MASTER, 30,-30,52, 0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		AP27 A 1 A_FaceTarget	TNT1 A 0 A_Warp(AAPTR_MASTER, 30,-30,52, 0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		AP27 A 1 A_FaceTarget	TNT1 A 0 A_Warp(AAPTR_MASTER, 30,-30,52, 0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		AP27 A 1 A_FaceTarget	TNT1 A 0 A_Warp(AAPTR_MASTER, 30,-30,52, 0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_SKIPOWNER)
		Goto Idle
	}
}

Actor HunterSkullDM : HunterSkull
{
	States
	{
	Fire:
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_SetUserVar(user_shot,1)
		TNT1 A 0 A_CustomMissile("PlHunterBallDM",4)
		Goto Idle
	}
}

Actor PlHunterBall
{
	Projectile
	Radius 2
	Height 4
	Speed 50
	Damage 8
	RenderStyle Add
	Scale 0.75
	Translation "0:255=%[0,0,0]:[1.5,0.9,0]"
	+MTHRUSPECIES
	+FORCEPAIN
	+SEEKERMISSILE
	+DONTBLAST
	+SERVERNETID
	DamageType "ZombieGibber"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_ReattributeToMaster")
		TNT1 A 0 A_PlaySound("QC/Abilities/Hunter/Fire",CHAN_AUTO,0.7)
	Looper:
		ACID A 2 BRIGHT A_SeekerMissile(3,3)
		Loop
	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"Death") //for virtual jump to inherited versions
		Goto Death
	Death:
		HIB1 CDEFG 3 Bright
		Stop
	}
}
Actor PlHunterBallDM : PlHunterBall
{
	-MTHRUSPECIES
	-DONTBLAST
	-FORCEPAIN
	Damage (5)
	States
	{
	Death:
		TNT1 A 0 A_RadiusGive("HunterProjectionProc", 40, RGF_PLAYERS|RGF_FORCESERVERSIDE)
		Goto Super::Death
	}
}


//--------------------------------------------------------
// Passive
//--------------------------------------------------------

Actor HunterProjectionProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_Traced")
		TNT1 A 0 A_GiveInventory("OverTraced")
		Stop
	}
}

Actor PowerTraced : Powerup
{
	Powerup.Duration 2
}

Actor GetTraced : PowerupGiver
{
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	Powerup.Type "Traced"
	Powerup.Duration 210
}

Actor OverTraced : GetTraced
{
	+INVENTORY.ADDITIVETIME
	Powerup.Duration 2
}

Actor HunterTrace : FX
{
	RenderStyle Add
	Alpha 0.5
	+DONTBLAST
	+SERVERNETID
	VisibleToPlayerClass QCHunter
	States
	{
	Spawn:
		TNT1 A 100 NoDelay
		Stop

		// --------------------------------------------------------------------

	Ranger:		RP01 "#" 0 A_Turn(0) Goto Frame
	DoomSlayer:	RP02 "#" 0 A_Turn(0) Goto Frame
	Corvus:		RP03 "#" 0 A_Turn(0) Goto Frame
	Kane:		RP04 "#" 0 A_Turn(0) Goto Frame
	Caleb:		RP05 "#" 0 A_Turn(0) Goto Frame
	Menelkir:	RP06 "#" 0 A_Turn(0) Goto Frame
	Terminator:	RP07 "#" 0 A_Turn(0) Goto Frame
	Zedek:		RP08 "#" 0 A_Turn(0) Goto Frame
	Inquisitor:	RP09 "#" 0 A_Turn(0) Goto Frame
	Bitterman:	RP10 "#" 0 A_Turn(0) Goto Frame
	Galen:		RP11 "#" 0 A_Turn(0) Goto Frame
	Nyx:		RP12 "#" 0 A_Turn(0) Goto Frame
	Sorgaul:	RP13 "#" 0 A_Turn(0) Goto Frame
	DukeNukem:	RP14 "#" 0 A_Turn(0) Goto Frame
	Durandal:	RP15 "#" 0 A_Turn(0) Goto Frame
	Keel:		RP16 "#" 0 A_Turn(0) Goto Frame
	Sarge:		RP17 "#" 0 A_Turn(0) Goto Frame
	LoWang:		RP18 "#" 0 A_Turn(0) Goto Frame
	Grayson:	RP19 "#" 0 A_Turn(0) Goto Frame
	Eradicator:	RP20 "#" 0 A_Turn(0) Goto Frame
	Blazkowicz:	RP21 "#" 0 A_Turn(0) Goto Frame
	Freeman:	RP22 "#" 0 A_Turn(0) Goto Frame
	VorMatur:	RP23 "#" 0 A_Turn(0) Goto Frame
	Eleena:		RP24 "#" 0 A_Turn(0) Goto Frame
	Lucienne:	RP25 "#" 0 A_Turn(0) Goto Frame
	Major:		RP26 "#" 0 A_Turn(0) Goto Frame
	Hunter:		RP27 "#" 0 A_Turn(0) Goto Frame
	Sam:		RP28 "#" 0 A_Turn(0) Goto Frame
	Postal:		RP29 "#" 0 A_Turn(0) Goto Frame
	Painkiller:	RP30 "#" 0 A_Turn(0) Goto Frame
	Intruder:	RP31 "#" 0 A_Turn(0) Goto Frame
	Orbb:		RP32 "#" 0 A_Turn(0) Goto Frame
	// ^ insert more classes here

	Frame:
		"####" "#" 0 A_Jump(256,1,2,3,4)
		"####" A 0 A_Turn(0) Goto Fade
		"####" B 0 A_Turn(0) Goto Fade
		"####" C 0 A_Turn(0) Goto Fade
		"####" D 0 A_Turn(0) Goto Fade

	Fade:
		"####" "##" 1 A_FadeOut(0.01)
		Loop
	}
}

