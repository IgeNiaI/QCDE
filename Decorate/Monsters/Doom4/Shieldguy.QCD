Actor D4PossessedSecurity : QCDE_MonsterSmall 13506
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	var int user_shieldup;
	var int user_ballsfired;
	Health 80
	Radius 20
	Height 56
	Mass 100
	Speed 9
	PainChance 128
	Monster
	+FLOORCLIP
	+NOTARGET
	Translation "112:127=176:191"
	SeeSound 	"Doom4/Monsters/Grunt/Sight"
	PainSound 	"Doom4/Monsters/Grunt/Pain"
	DeathSound 	"Doom4/Monsters/Grunt/Death"
	ActiveSound "Doom4/Monsters/Grunt/Idle"
	Obituary "$OB_SHOTGUY"
	DamageFactor "PlasmaExploder", 0.3	//because otherwise, zombiemen would be killing everyone else easily
	Scale 0.93
	Tag "$TAG_D4PossessedSecurity" // "Possessed Security"
	MeleeThreshold 300
	MeleeRange 160
	MaxTargetRange 500
	DropItem "Shotgun"
	States
	{
	Idle:
		RPZM A 10 A_Look
		Loop
	See:
		TNT1 A 0 A_JumpIfInventory("CounterToShieldAgain",10,"PrepareToReshield")
		TNT1 A 0 A_JumpIf(user_shieldup==0,"SummonShield")
		RPZM AABBCCDD 3 A_Chase
		Loop

	PrepareToReshield:
		RPZM A 0 A_TakeInventory("CounterToShieldAgain",32767)
		RPZM A 0 A_SetUserVar(user_shieldup,0)
		Goto See

	SummonShield:
		RPZM E 20
		RPZM E 0 A_SetUserVar(user_shieldup,1)
		RPZM A 0 A_SpawnItemEx("ShieldguyShield",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Goto See

	//-------------------------------------------------
	// Attacks
	Melee:
		TNT1 A 0 A_Jump(64,"PlasmaBomb")
		RPZM AABBC 3 A_Chase("","") //melee? yeah, he still walks towards you >:D
		RPZM E 0 A_FaceTarget
		RPZM E 0 A_PlaySound("Doom4/Monsters/HellShotgun",CHAN_WEAPON,1.0,false,0.9)
		RPZM FFFFFFFF 0 A_CustomMissile("ShieldGuyTracer",28,5,random(20,-20),0)
		RPZM G 5 Bright
		RPZM E 8 A_FaceTarget
		RPZM E 0 A_FaceTarget
		RPZM E 0 A_PlaySound("Doom4/Monsters/HellShotgun",CHAN_WEAPON,1.0,false,0.9)
		RPZM FFFFFFFF 0 A_CustomMissile("ShieldGuyTracer",28,5,random(20,-20),0)
		RPZM G 5 Bright
		RPZM E 8 A_FaceTarget
		RPZM E 0 A_FaceTarget
		RPZM E 0 A_PlaySound("Doom4/Monsters/HellShotgun",CHAN_WEAPON,1.0,false,0.9)
		RPZM FFFFFFFF 0 A_CustomMissile("ShieldGuyTracer",28,5,random(10,-20),0)
		RPZM G 5 Bright
		RPZM E 50	//a fair chance to hit him in the back
		Goto See

		//------------------------
		Missile:
		PlasmaBomb:
			TNT1 A 0 A_SetUserVar(user_ballsfired,0)
			RPZM E 0 A_PlaySound("Doom4/Other/ZombieChargeAtt",CHAN_BODY,1.0,false,1.0)
			RPZM EEEEEEE 5 A_FaceTarget
			TNT1 A 0 A_JumpIfCloser(128,"PlasmaExplo128")
			TNT1 A 0 A_JumpIfCloser(192,"PlasmaExplo192")
			TNT1 A 0 A_JumpIfCloser(256,"PlasmaExplo256")
			TNT1 A 0 A_JumpIfCloser(320,"PlasmaExplo320")
			TNT1 A 0 A_JumpIfCloser(384,"PlasmaExplo384")
			TNT1 A 0 A_JumpIfCloser(448,"PlasmaExplo448")
			TNT1 A 0 A_JumpIfCloser(512,"PlasmaExplo512")
			TNT1 A 0 A_JumpIfCloser(576,"PlasmaExplo576")
			TNT1 A 0 A_JumpIfCloser(640,"PlasmaExplo640")
			TNT1 A 0 A_JumpIfCloser(704,"PlasmaExplo704")
			TNT1 A 0 A_JumpIfCloser(768,"PlasmaExplo768")
			TNT1 A 0 A_JumpIfCloser(832,"PlasmaExplo832")

			PlasmaExplo128:
				TNT1 A 0 A_CustomMissile("PlasmaExploder128",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo192:
				TNT1 A 0 A_CustomMissile("PlasmaExploder192",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo256:
				TNT1 A 0 A_CustomMissile("PlasmaExploder256",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo320:
				TNT1 A 0 A_CustomMissile("PlasmaExploder320",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo384:
				TNT1 A 0 A_CustomMissile("PlasmaExploder384",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo448:
				TNT1 A 0 A_CustomMissile("PlasmaExploder448",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo512:
				TNT1 A 0 A_CustomMissile("PlasmaExploder512",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo576:
				TNT1 A 0 A_CustomMissile("PlasmaExploder576",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo640:
				TNT1 A 0 A_CustomMissile("PlasmaExploder640",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo704:
				TNT1 A 0 A_CustomMissile("PlasmaExploder704",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo768:
				TNT1 A 0 A_CustomMissile("PlasmaExploder768",35,0,0)
				Goto FinishPlasmaExplo
			PlasmaExplo832:
				TNT1 A 0 A_CustomMissile("PlasmaExploder832",35,0,0)
				Goto FinishPlasmaExplo

				FinishPlasmaExplo:
					TNT1 A 0 A_SetUserVar(user_ballsfired,user_ballsfired+1)
					TNT1 A 0 A_PlaySound("Doom4/Monsters/ZombieBigPlasmaShoot",CHAN_AUTO,1.0,false,0.9)
					RPZM G 5 Bright
					TNT1 A 0 A_Jump(180,"EndFiringBigBalls")
					TNT1 A 0 A_JumpIf(user_ballsfired>=4,"EndFiringBigBalls")
					Goto PlasmaBomb+1
				EndFiringBigBalls:
					TNT1 A 0 A_SetUserVar(user_ballsfired,0)
					RPZM E 15
					Goto See

	Pain:
		RPZM I 3
		RPZM I 3 A_Pain
		Goto See

	DeathChecksDone:
		TNT1 A 0 A_KillChildren("Removed")		//removes shield
		RPZM J 3
		RPZM K 3 A_Scream
		RPZM L 3 A_NoBlocking
		RPZM M 3
	Death.Corpse:
		RPZM N -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_KillChildren("Removed")		//removes shield
		RFTR N 4
		RFTR O 4 A_NoBlocking
		RFTR PQRST 4
		RFTR U -1
		Stop

	Raise:
		TNT1 A 0 A_TakeInventory("ImDead",32767)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		RPZM ML 3
		RPZM KJ 3
		Goto See

	//------------------------------------------------------------------------
	}
}

Actor ShieldguyShield
{
	var int user_damage;
	+NOGRAVITY
	+NEVERTARGET
	+SHOOTABLE
	+NOTONAUTOMAP
	-SOLID
	+QUICKTORETALIATE
	+GHOST
	-COUNTKILL
	+NOTARGETSWITCH
	Health 500
	Radius 18
	Height 56
	RenderStyle Add
	Scale 0.9
	Mass 0x7FFFFFFF
	BloodType "ShieldPuff"
	PainChance 255
	States
	{
	Spawn:
		//setup stage, puts target (monster that spawned it) as master, and as tracer to keep resetting it
		RPZM O 0 NODELAY A_RearrangePointers(AAPTR_DEFAULT,AAPTR_TARGET,AAPTR_TARGET)
	Looper:
		RPZM O 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		RPZM O 1 BRIGHT A_Warp(AAPTR_TARGET,10,-5,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RPZM O 0 A_JumpIfInTargetInventory("ImDead",1,"Death.Removed") //failsafe to remove this shield
		Loop
	Pain:
		RPZM O 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		RPZM O 0 A_PlaySound("Doom4/Monsters/ZomShieldImpact",7,0.5,false,1.2)
		RPZM O 1 BRIGHT A_Warp(AAPTR_TARGET,10,-5,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RPZM O 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		RPZM O 1 BRIGHT A_Warp(AAPTR_TARGET,10,-5,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RPZM O 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		RPZM O 1 BRIGHT A_Warp(AAPTR_TARGET,10,-5,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		RPZM O 0 A_RearrangePointers(AAPTR_TRACER,AAPTR_TARGET,AAPTR_DEFAULT)
		RPZM O 1 BRIGHT A_Warp(AAPTR_TARGET,10,-5,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		Goto Looper

	Death:	//when the shield was destroyed due to damage
		TNT1 A 3
		//Every half second it will give one counter, after 10 counters, the monster will try to resummon shield again
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 17
		TNT1 A 0 A_GiveInventory("CounterToShieldAgain",1,AAPTR_MASTER)
		TNT1 A 5
		Stop
	Death.Removed:	//when it was deactivated by stun, stagger, or whatever else
		TNT1 A 10 A_PlaySound("Doom4/Monsters/ZombieShieldFail",CHAN_AUTO,1.0,false,1.2)
		Stop
	}
}

Actor ShieldPuff
{
	+NOINTERACTION
	RenderStyle Add
	Scale 0.4
	States
	{
	Spawn:
		RPZM P 1 Bright A_Stop
		RPZM Q 1 Bright A_Stop
		RPZM R 1 Bright
		RPZM S 1 Bright
		RPZM T 1 Bright A_FadeOut(0.2)
		Wait
	}
}

Actor CounterToShieldAgain : Inventory { Inventory.MaxAmount 10 }



Actor ShieldGuyTracer
{
	Projectile
	+RANDOMIZE
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+NOEXTREMEDEATH
	+THRUGHOST
	+BLOODSPLATTER
	damage (random(1,2))
	radius 2
	height 2
	speed 18
	renderstyle ADD
	alpha 0.9
	scale 0.06
	Translation "0:255=%[0,0,0]:[1.5,0.3,0.08]"
	states
	{
	Spawn:
		TRAC A 1 NODELAY ThrustThingZ(0,random(12,-12),0,1)
		TRAC A 10 BRIGHT A_PlaySound("Doom4/Other/BulletWhoosh",5,1.0,false,1.3)
		Stop
	Death:
		TNT1 A 1
		Stop
	XDeath:
		TNT1 A 1
		Stop
	}
}
