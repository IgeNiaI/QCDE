		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP03 F 6 BRIGHT Light("PlayerFiringLight")
			RP03 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP03 F 6 BRIGHT Light("PlayerFiringLight")
			QP03 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP03 G 4
			RP03 G 4 A_Pain
			RP03 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP03 G 4
			QP03 G 4 A_Pain
			QP03 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
