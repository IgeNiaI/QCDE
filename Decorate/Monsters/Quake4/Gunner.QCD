//=====================================================================================
//=====================================================================================
//	Explanation: Ok, this guy... runs and shoots. That's it.
//=====================================================================================
//=====================================================================================

Actor Q4Gunner : QCDE_MonsterMedium 15305 //hellknight
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 20
	Height 64
	Mass 250
	Health 500
	PainChance 64
	Speed 11
	Scale 0.465
	MeleeDamage 1
	+FLOORCLIP
	SeeSound "quake4/Gunner/Sight"
	PainSound "quake4/Gunner/Pain"
	DeathSound "quake4/Gunner/Death"
	ActiveSound "quake4/Gunner/Idle"
	Obituary "$OB_Q4Gunner" // "%o was taken down by a Strogg gunner."
	Tag "$TAG_Q4Gunner" // "Gunner"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q07I A 4 A_Look
		Loop
	See:
		Q07W AABBCCDDEEFF 3 A_Chase
		Loop
	Melee:
		TNT1 a 0 A_Jump(64,"Missile")
		Q07M ABC 4 A_FaceTarget
		Q07M D 4 A_CustomMeleeAttack(random(20,40),"quake4/Misc/MeleeHit","quake4/Misc/Swing","Normal",1)
		Q07M EF 4
		Goto See
	Missile:
		TNT1 A 0 A_Jump(256,"Nailgun","Grenade")

	Nailgun:
		Q07I AA 3 A_FaceTarget
		Q07A AB 3 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Gunner/NailgunShot")
		TNT1 A 0 A_SpawnItemEx("MonMuzzleFlashSmall",19,9,39,0,0,0,0,SXF_NOCHECKPOSITION)
		Q07A C 3 A_CustomMissile("Q4NailGunner",38,9,0)
		TNT1 A 0 A_Jump(8,"NailgunEnd")
		TNT1 A 0 A_MonsterRefire(0,"NailgunEnd")
		Goto Nailgun+2
	NailgunEnd:
		Q07A BA 4
		Goto See

	Grenade:
		Q07B A 4 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Gunner/GrenadeCharge")
		Q07B BCDDDDDDD 4 A_FaceTarget
		TNT1 A 0 A_CustomMissile("Q4GunnerGrenade",40,8,0)
		Q07B E 4 Light(OrangeMediumFlicker2)
		Goto See

	Pain:
		Q07P A 7 A_Pain
		Goto See

	DeathChecksDone:
		Q07D A 0 A_Scream
		Q07D A 0 A_Fall
		Q07D ABCDEF 3
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
	Death.Corpse:
		Q07D F -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q07D EDCBA 3
		Goto See
	}
}

Actor Q4NailGunner : EnforcerNail
{
	Speed 20
	Damage 3
	Damage (random(2,9)*3)
	Scale 0.42
	States
	{
	Crash:
		DB09 A 0 A_PlaySound("QC/Weapons/Nailgun/Impact",CHAN_AUTO,0.6,0,1.7)
		DB09 A 0 A_SetScale(0.5)	//only changes the size of this
		DB09 A 0 A_Jump(256,"T1","T2","T3","T4")
		Goto T1
	}
}


//************************************************
Actor Q4GunnerGrenade
{
	Radius 8
	Height 8
	Speed 17
	Scale 0.33
	Gravity 0.7
	Damage 1
	PROJECTILE
	-NOGRAVITY
	+CANBOUNCEWATER
	BounceType "Doom"
	SeeSound "quake4/Gunner/GrenadeShot"
	BounceSound "quake4/Weapons/GrenLaunch/Bounce"
	DeathSound "quake4/Misc/GrenadeExplo"
	DamageType "RocketDamage"
	Scale 0.2
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 ThrustThingZ(0,13,0,0)
		R090 ABCDEFGH 4 Light("RedSmallPoint2") Bright A_SpawnItemEx("Q4GrenadeSmokeParticle",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Goto Spawn+2
    Death:
		TNT1 A 0 A_SpawnItemEx("BoltExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 2 Light("YellowSmallFlicker1") A_Explode(56,64,1)
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowMediumFlicker2")
		TNT1 A 2 Light("YellowMediumFlicker3")
		TNT1 A 2 Light("YellowSmallFlicker1")
		TNT1 A 2 Light("YellowSmallFlicker2")
		TNT1 A 2 Light("YellowSmallFlicker3")
		Stop
	}
}
Actor Q4GrenadeSmokeParticle
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Translucent
	Scale 0.12
	Alpha 0.35
	States
	{
	Spawn:
		TNT1 A 0
		X102 V 2 A_SetScale(scalex+0.015)
		TNT1 V 0 A_FadeOut(0.022)
		Loop
	}
}



