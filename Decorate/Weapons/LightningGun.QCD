		//*******************************
		// Coop: with 3rd person beam
	Fire.Purple.Modded:
		MDM6 A 0
		Goto CoopHoldPurple
		CoopHold:
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "CoopHold.Modded")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "CoopHold.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "CoopHold.HalfLife")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "CoopHold.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 3, "CoopHold.Quake3")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 2, "CoopHold.Quake2")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 1, "CoopHold.Quake1")
		CoopHold.Default:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor",-5)
			Goto CoopHoldCont
		CoopHold.Quake1:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake1",-5)
			Goto CoopHoldCont
		CoopHold.Quake2:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake2",-5)
			Goto CoopHoldCont
		CoopHold.Quake3:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake3",-5)
			Goto CoopHoldCont
		CoopHold.HalfLife:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Quake3",-5)
			Goto CoopHoldCont
		CoopHold.Modded:
			"####" A 0 A_RailAttack(0,5,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING|RGF_EXTRATRAIL,0,"None",0,0,768,1,20,1.0,"LGworldactor_Modded",-5)
			Goto CoopHoldCont
		CoopHoldCont:
			"####" A 0 Offset(0,32)
			"####" A 0 A_GunFlash
			"####" "#" 0 A_JumpIfInventory("QCLightningGunSkin", 20, "CoopHoldCont.Impact.Modded")
			"####" B 1 Bright A_FireBullets(0,0,1,random(LGDmgSPMin,LGDmgSPMax),"LGPuff",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,768)
			Goto CoopHoldCont.ImpactCont
		CoopHoldCont.Impact.Modded:
			"####" B 1 Bright A_FireBullets(0,0,1,random(LGDmgSPMin,LGDmgSPMax),"LGPuff_Modded",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,768)
		CoopHoldCont.ImpactCont:

		CoopHold2:
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "CoopHold2.Modded")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "CoopHold2.Default")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "CoopHold2.HalfLife")
			"####" A 0 A_JumpIfInventory("QCLightningGunSkin", 4, "CoopHold2.Default")
