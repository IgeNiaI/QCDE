#define BFG_ARMOR_MELT 8

// Activator: irradiated victim
script "QCDE_BFGRadiation" (void)
{
	// Only change "radius" here if changed A_RadiusGive in BFG9000Shot_DM
	int radius = 384;

	if(HostileRadiusCheck(BFGBALL_TIDBASE, radius, true))
	{
		int ac = CheckInventory("BasicArmor");

		if(ac) // if this player has armor, melt it
		{
			TakeInventory("BasicArmor", BFG_ARMOR_MELT);
			GiveInventory("BfgSlow2", 1); // this doesn't actually slow, but gives color and HUD icon
		}
		else // if this player is naked, apply debuff
		{
			str debuff = "BfgSlow";
			debuff = strparam(s:debuff, x:random(3,15));
			GiveInventory("BfgSlow1", 1); // always here for HUD indication
			GiveInventory(debuff, 1);
		}
	}
}

function int HostileRadiusCheck (int projectileTidBase, int radius, int blockable)
{
	// if not DM, skip
	if(GameType() < GAME_NET_DEATHMATCH) return false;

	if(blockable)
	{
		// if this player is invulnerable by ability, skip
		if(CheckInventory("PowerGhostTint")) return false;    //doesnt affect ghostwalking nyx
	}

	int i;

	int x = GetActorX(0) >> 16;
	int y = GetActorY(0) >> 16;

	for(i = 0; i < 64; i++)
	{
		// if the projectile is your own, skip
		if(i == PlayerNumber()) continue;

		// if that owner player doesn't have a projectile, skip
		if(!ClassifyActor(projectileTidBase + i)) continue;

		// this projectile should be the only one in existence
		// if that player's projectile is too far, skip
		int bx = GetActorX(projectileTidBase + i) >> 16;
		if(bx - x > radius || x - bx > radius) continue;
		int by = GetActorY(projectileTidBase + i) >> 16;
		if(by - y > radius || y - by > radius) continue;

		// if that player is on same team in TDM, skip
		if (CheckInventory("TeamDeathmatch") &&
			GetPlayerInfo(i,              PLAYERINFO_TEAM) ==
			GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM))
			continue;

		return true;
	}
	return false;
}

#define MAX_TOTEMS_PVE     5
#define MAX_TOTEMS_PVP     3
int totemsUp[64][MAX_TOTEMS_PVE];

function int getMaxTotems()
{
	if(GameType() < GAME_NET_DEATHMATCH)
		return MAX_TOTEMS_PVE;
	else
		return MAX_TOTEMS_PVP;
}

// Activator: Totem
script "QCDE_TotemSpawned" (void)
{
	int plr = GetActorProperty(0, APROP_TargetTID) - 1000;
	int lastTotem = getLastTotem(plr);

	removeTotem(plr,lastTotem);

	int tid = TOTEM_TIDBASE + plr + lastTotem * 128;

	Thing_ChangeTID(0,tid);
	totemsUp[plr][lastTotem] = Timer();
	Warp(0, GetActorX(0), GetActorY(0), GetActorZ(0), 0, WARPF_ABSOLUTEPOSITION|WARPF_NOCHECKPOSITION);
	ACS_NamedExecuteAlways("QCDE_TotemSpawned_Client",0,plr);
	//log(s:"Totem[", d:plr, s:"][", d:lastTotem, s:"] spawned at ", d:totemsUp[plr][lastTotem], s:", tidded ", d:tid);
}

// Activator: Totem
script "QCDE_TotemSpawned_Client" (int plr) clientside
{
	bool cooperative    = getCvar("cooperative");
	bool teamplay       = getCvar("teamplay");
	bool teamlms        = getCvar("teamlms");
	bool teampossession = getCvar("teampossession");
	bool teamgame       = getCvar("teamgame");

	int tid = UniqueTid();
	int translation = GetActorProperty(plr + 1000, APROP_Translation);

	if(cooperative)
	{
		SpawnProjectile(0, "TotemFX", 0, 0, 0, 0, 0);
	}
	else if(teamplay || teamlms || teampossession || teamgame)
	{
		SpawnProjectile(0, "TotemColoredFX", 0, 0, 0, 0, tid);
		SetActorProperty(tid, APROP_Translation, translation);
	}
	else // ffa or duel
	{
		if(ConsolePlayerNumber() == plr)
		{
			SpawnProjectile(0, "TotemFX", 0, 0, 0, 0, 0);
			// Own totems aren't color translated in ffa
		}
		else
		{
			SpawnProjectile(0, "TotemColoredFX", 0, 0, 0, 0, tid);
			SetActorProperty(tid, APROP_Translation, translation);
		}
	}
}

// Activator: Totem's hitbox
script "QCDE_HitboxSpawned" (void)
{
	int plr = GetActorProperty(0, APROP_TargetTID) - 1000;
	int tid = HITBOX_TIDBASE + plr + getRecentTotem(plr) * 128;

	Thing_ChangeTID(0,tid);

	SetActivator(1000 + plr);
	// Activator: Galen
	ACS_NamedExecuteAlways("QCDE_UpdateTotemCount",0);

	// Cooperative has indestructible totems
	if(GameType() < GAME_NET_DEATHMATCH)
		Thing_Remove(tid);

	delay(20);

	// Totem never settled, nothing to check for hits?
	int totemtid = tid - HITBOX_TIDBASE + TOTEM_TIDBASE;
	if(!IsTidUsed(totemtid))
		Thing_Remove(tid);

	// Or wrong tid altogether?
	if(tid && tid < 1000)
		Thing_Remove(tid);

	// Once more! With feeling!
	delay(20);

	if(!IsTidUsed(totemtid))
		Thing_Remove(tid);

	if(tid && tid < 1000)
		Thing_Remove(tid);

	// Update count if anything changed
	ACS_NamedExecuteAlways("QCDE_UpdateTotemCount",0);

	// Hitbox follows the totem in case it's moved
	while(GetActorProperty(tid, APROP_Health) > 0)
	{
		int x = GetActorX(tid); int xt = GetActorX(totemtid);
		int y = GetActorY(tid); int yt = GetActorY(totemtid);
		int z = GetActorZ(tid); int zt = GetActorZ(totemtid);
		if(x != xt || y != yt || z != zt)
			Thing_Move(tid, totemtid, true);
		delay(1);
	}
}

function int getLastTotem(int plr)
{
	int i, min = totemsUp[plr][0], res = 0;
	for(i = 1; i < getMaxTotems(); i++)
	{
		if(totemsUp[plr][i] < min)
		{
			min = totemsUp[plr][i];
			res = i;
		}
	}
	return res;
}

function int getRecentTotem(int plr)
{
	int i, max = totemsUp[plr][0], res = 0;
	for(i = 1; i < getMaxTotems(); i++)
	{
		if(totemsUp[plr][i] > max)
		{
			max = totemsUp[plr][i];
			res = i;
		}
	}
	return res;
}

function void removeTotem(int plr, int totem)
{
	Thing_Remove( TOTEM_TIDBASE + plr + totem * 128);
	Thing_Remove(HITBOX_TIDBASE + plr + totem * 128);
}

// Activator: Totem
script "QCDE_TotemAttacks" (void)
{
	int plr = (ActivatorTid() - 1000) % 64;
	int plrtid = plr + 1000;
	int target = GetActorProperty(0, APROP_TargetTID);
	int targetplr = target - 1000;

	bool friendly = false;

	bool teamplay       = getCvar("teamplay");
	bool teamlms        = getCvar("teamlms");
	bool teampossession = getCvar("teampossession");
	bool teamgame       = getCvar("teamgame");

	if(teamplay || teamlms || teampossession || teamgame)
		friendly = GetPlayerInfo(plr,       PLAYERINFO_TEAM) ==
		           GetPlayerInfo(targetplr, PLAYERINFO_TEAM);
	else
		friendly = plrtid == target;

	bool targetOutsideRange = GetActorZ(target) > GetActorZ(0) + 40.0 || GetActorZ(target) < GetActorZ(0) - 20.0;
	if (targetOutsideRange)
	{
		//log(s:"Totem avoids attack");
		SetActorState(0,"NoAttack");
	}
	else if(friendly)
	{
		bool friendHealed = false;
		if (CheckActorInventory(plrtid, "TotemTokenPvP") >= 3)
		{
			if (GetActorProperty(target,APROP_HEALTH) < CheckActorInventory(target,"MaxHealthToken") + 50)
			{
				//log(s:"Totem super heals friend");
				SetActorState(0,"SuperDMSingleHeal");
				friendHealed = true;
			}
		}
		else
		{
			if (GetActorProperty(target,APROP_HEALTH) < CheckActorInventory(target,"MaxHealthToken"))
			{
				//log(s:"Totem heals friend");
				SetActorState(0,"DMSingleHeal");
				friendHealed = true;
			}
		}

		if (!friendHealed)
		{
			//log(s:"Totem doesn't heal friend");
			SetActorState(0,"NoAttack");
		}
	}
	else
	{
		//log(s:"Avoid attacks enemy");
		SetActorState(0,"Explode");
	}

	delay(20);

	SetActivator(1000 + plr);
	// Activator: Galen
	ACS_NamedExecuteAlways("QCDE_UpdateTotemCount",0);
}

// Activator: Totem
script "QCDE_TotemDestroyed" (void)
{
	// Totem never spawned, only projectile blew up?
	if(!ActivatorTid()) terminate;

	Thing_Destroy(ActivatorTid() + 64);
	int plr = (ActivatorTid() - 1000) % 64;
	int totem = (ActivatorTid() - 1064) / 128;
	totemsUp[plr][totem] = 0;
	//log(s:"Totem ", d:ActivatorTid(), s:" exploding, removing hitbox ", d:ActivatorTid() + 64, s:", evicting record ", s:"[", d:plr, s:"][", d:totem, s:"]");

	SetActivator(1000 + plr);
	// Activator: Galen
	ACS_NamedExecuteAlways("QCDE_UpdateTotemCount",0);
}

// Activator: Totem's hitbox
script "QCDE_HitboxDestroyed" (void)
{
	Thing_Remove(ActivatorTid() - 64);
	int plr = (ActivatorTid() - 1000) % 64;
	int totem = (ActivatorTid() - 1128) / 128;
	totemsUp[plr][totem] = 0;
	//log(s:"Hitbox ", d:ActivatorTid(), s:" dying, destroying totem ", d:ActivatorTid() - 64, s:", evicting record ", s:"[", d:plr, s:"][", d:totem, s:"]");

	SetActivator(1000 + plr);
	// Activator: Galen
	ACS_NamedExecuteAlways("QCDE_UpdateTotemCount",0);
}

// Activator: Galen, or ex-Galen
script "QCDE_UpdateTotemCount" (void)
{
	int plr = PlayerNumber();

	// Remove totems from ex-Galen
	if(!CheckInventory("Class_Galen"))
	{
		Thing_Remove(TOTEM_TIDBASE + plr      ); Thing_Remove(HITBOX_TIDBASE + plr      );
		Thing_Remove(TOTEM_TIDBASE + plr + 128); Thing_Remove(HITBOX_TIDBASE + plr + 128);
		Thing_Remove(TOTEM_TIDBASE + plr + 256); Thing_Remove(HITBOX_TIDBASE + plr + 256);
		Thing_Remove(TOTEM_TIDBASE + plr + 384); Thing_Remove(HITBOX_TIDBASE + plr + 384);
		Thing_Remove(TOTEM_TIDBASE + plr + 512); Thing_Remove(HITBOX_TIDBASE + plr + 512);
	}

	int count;
	count += IsTidUsed(TOTEM_TIDBASE + plr      );
	count += IsTidUsed(TOTEM_TIDBASE + plr + 128);
	count += IsTidUsed(TOTEM_TIDBASE + plr + 256);
	count += IsTidUsed(TOTEM_TIDBASE + plr + 384);
	count += IsTidUsed(TOTEM_TIDBASE + plr + 512);

	SetInventory("TotemTokenPvE", count);
	SetInventory("TotemTokenPvP", count);
}


#define MAULOTAUR_DURATION 25
// Activator: Dave
script "QCDE_MaulotaurSpawned" (void)
{
	// In coop, don't block players
	if (GameType() <= GAME_NET_COOPERATIVE) GiveInventory("ThruSpeciesProc", 1);

	int tid = ActivatorTid();
	int plr = tid - MAULOTAUR_TIDBASE;
	int plrtid = plr + 1000;

	SetPointer(AAPTR_TARGET, UniqueTid());
	SetPointer(AAPTR_MASTER, plrtid);

	//ACS("iamamiwhoami");

	// Seppuku if ronin.
	if (!plrtid)
	{
		Thing_Destroy(tid);
		//log(s:"Orphaned Maulotaur without master dying");
		terminate;
	}

	// If DM, apply reduced health
	if (GameType() >= GAME_NET_DEATHMATCH)
		SetActorProperty(0,APROP_HEALTH,200);


	//log(s:"Maulotaur spawned for ", n:plr+1, s:" with tid ", d:tid);
	ACS("QCDE_ObjectAllyMarker_Client", plr);

	// Set target to an arbitrary enemy
	int i;
	for(i = 0; i < 64; i++)
	{
		if(!PlayerInGame(i)) continue;
		if(!areEnemies(plr, i)) continue;

		SetPointer(AAPTR_TARGET, i+1000);
		//PrintBold(n:plr+1, s:"'s ", n:0, s:" now hates ", n:i+1);
		break;
	}

	// Activator: Player
	SetActivator(plrtid);
	delay(1);
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;


	if (extraAbilityData[plr])
	{
		// previous maulotaur's clock is still ticking
		// just update the timer and leave
		extraAbilityData[plr] = MAULOTAUR_DURATION;
		terminate;
	}

	GiveInventory("MaulotaurAliveToken", 1);

	// Keep track of current Maulotaur, and kill it in 25 seconds.
	extraAbilityData[plr] = MAULOTAUR_DURATION;
	while(extraAbilityData[plr] --> 0)
	{
		if(GetActorProperty(tid, APROP_HEALTH) <= 0) break;
		SetInventory("MaulotaurAliveToken", true);
		delay(35);
	}

	extraAbilityData[plr] = 0;
	SetInventory("MaulotaurAliveToken", false);

	Thing_Destroy(tid);
}

