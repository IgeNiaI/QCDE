// ----------------------------------------------------------------------------
//
// DukeNukem's abilities
//
// Active:	Freeze Gun
//			Slow or freeze players
//			Alt fire "mighty boot"
//			Boot on frozen player = Heavy damage
//			Boot on non-frozen players = Pushback + a bit of damage
//
// Passive: Huge ego
//          Receive more health from healing bubbles (except small ones)
//
// ----------------------------------------------------------------------------

Actor CompatVer30_DukeNukem {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor DukeFreezeThrower : QCWeapon
{
	Weapon.Kickback 0
	Weapon.SelectionOrder 2000
	Obituary "$OB_DukeFreezeThrower" // "%o was frozen solid by %k."
	Tag "$TAG_DukeFreezeThrower" // "Freeze Thrower"
	+INVENTORY.UNDROPPABLE
	+WEAPON.CHEATNOTWEAPON
	+WEAPON.NOAUTOAIM
	Weapon.Kickback 8000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 0
	Weapon.AmmoType "DukeAmmo"
	+WEAPON.AMMO_OPTIONAL
	States
	{
	Spawn:
		TNT1 A 0
		Stop
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		QW14 A 10 A_WeaponReady
		Loop

		ReadyCantFire:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			QW14 A 4 A_WeaponReady(WRF_NOFIRE)
			TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		TNT1 A 0 A_TakeInventory("WeaponZoomedToken")
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		QW14 A 1 A_Raise
		TNT1 AAA 0 A_Raise
		Loop

	Deselect:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		QW14 A 1 A_Lower
		TNT1 AAA 0 A_Lower
		Loop

	//-------------------------------------------------------
	// Primary fire: Freeze Thrower
	//-------------------------------------------------------
	Fire:
		TNT1 A 0 A_JumpIfNoAmmo("Ready")
		TNT1 A 0 A_PlaySound("",CHAN_WEAPON,1.0,false,0.8)
		QW14 D 2 Bright A_GunFlash("PrimaryFlash")
		QW14 E 2 Bright
		TNT1 A 0 A_JumpIfNoAmmo("Ready")
		QW14 F 2 Bright A_GunFlash("PrimaryFlash")
		QW14 D 2 Bright
		TNT1 A 0 A_JumpIfNoAmmo("Ready")
		QW14 E 2 Bright A_GunFlash("PrimaryFlash")
		QW14 F 2 Bright
		Goto Ready
	PrimaryFlash:
		TNT1 A 0 A_PlaySound("QC/Abilities/DukeNukem/FreezeShot",CHAN_WEAPON)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PerformDM")
	PerformSP:
		TNT1 A 2 A_FireCustomMissile("DukeFreezeShot",0,true,3)
		Stop
	PerformDM:
		TNT1 A 2 A_FireCustomMissile("DukeFreezeShot_DM",0,true,3)
		Stop


	//-------------------------------------------------------
	// Secondary Fire: Kick
	//-------------------------------------------------------
	AltFire:
		QW14 B 0 A_GunFlash("AltFlash",GFF_NOEXTCHANGE)
		QW14 A 0 A_GiveInventory("ThirdPersonPunch", 1, 0, GIF_SKIPOWNER)
		QW14 B 2 A_GiveInventory("DukeBootProc", 1, 0, GIF_SKIPOWNER) //every 2 tics, not every 1 tic.
		QW14 C 2 A_GiveInventory("DukeBootProc", 1, 0, GIF_SKIPOWNER)
		QW14 C 2 A_GiveInventory("DukeBootProc", 1, 0, GIF_SKIPOWNER)
		QW14 C 2 A_GiveInventory("DukeBootProc", 1, 0, GIF_SKIPOWNER)
		QW14 B 2 A_GiveInventory("DukeBootProc", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("ThirdPersonPunch", 0, TIF_SKIPOWNER)
		QW14 A 5
		TNT1 A 0 A_TakeInventory("PunchedAlready", 0, TIF_SKIPOWNER)
		Goto Ready
	AltFlash:
			TNT1 A 0 A_GiveInventory("ThirdPersonPunch", 0, TIF_SKIPOWNER)
			TNT1 A 0 A_PlaySound("QC/Abilities/Sorgaul/Whoosh",CHAN_WEAPON)
			TNT1 A 0 A_SetAngle(angle-0.6)	TNT1 A 1 A_SetPitch(pitch-0.3)
			TNT1 A 0 A_SetAngle(angle-0.6) 	TNT1 A 1 A_SetPitch(pitch-0.3)
			TNT1 A 1
			TNT1 A 1
			TNT1 A 0 A_SetAngle(angle+0.4)	TNT1 A 1 A_SetPitch(pitch+0.3)
			TNT1 A 0 A_SetAngle(angle+0.4)	TNT1 A 1 A_SetPitch(pitch+0.3)
			TNT1 A 1 A_SetAngle(angle+0.4)
			Stop
	}
}

Actor DukeBootProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 1 A_JumpIfInventory("PunchedAlready",1,"Death") //if a previous melee already connected, end.
		"####" "#" 0 A_JumpIfCloser(129,"ContinueChecks") //close enough?
		Goto Death //otherwise, abort immediately

	ContinueChecks:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)<2,"Coop") //if coop, do coop damage
		Goto DM
	DM:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTargetFrozen",0,0,0,0)>0,"DMPerformStrong")
		TNT1 A 0 A_CustomPunch(40,1,0,"DukeBootPuff",128) //if the token wasnt there, just do normal damage
		Goto Death

		DMPerformStrong:
			TNT1 A 0 A_CustomPunch(80,1,0,"DukeBootPuff_NoKickback",128)
			Goto Death

	Coop:
		"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTargetFrozen",0,0,0,0)>0,"CoopPerformStrong")
		TNT1 A 0 A_CustomPunch(50,1,0,"DukeBootPuff",80) //if the token wasnt there, just do normal damage
		Goto Death

		CoopPerformStrong:
			TNT1 A 0 A_CustomPunch(random(150,300),1,0,"DukeBootPuff_NoKickback",128)
			Goto Death

	Death:
		TNT1 A 35
		Stop
}	}


Actor DukeBootPuff
{
	+NOINTERACTION
	+THRUGHOST
	+PUFFGETSOWNER
	+ALWAYSPUFF
	+PUFFONACTORS
	+NOTIMEFREEZE
	RenderStyle None
	SeeSound ""
	ActiveSound "nothing"
	AttackSound "nothing"
	Obituary "$OB_DukeBootPuff" // "%o ate %k's boot."
	states
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10
		Stop
	Xdeath:	//hit bleeding actor
		TNT1 A 0 A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10
		Stop
	Crash:	//Hit everything else
		TNT1 A 10
		Stop
	}
}

Actor DukeBootPuff_NoKickback : DukeBootPuff
{
	//it must not push enemies back because it's the damage boot at this point
	+NODAMAGETHRUST
	+EXTREMEDEATH
	states
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE) //gives "big" beep because it deals more damage than regular kick
		TNT1 A 10
		Stop
	Xdeath:	//hit bleeding actor
		TNT1 A 0 A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE) //gives "big" beep because it deals more damage than regular kick
		TNT1 A 10
		Stop
	}
}

//------------------------------------------
// Sp version
Actor DukeFreezeShot
{
	Projectile
	Speed 25
	BounceType Doom
	BounceCount 2
	BounceFactor 0.9
	WallBounceFactor 0.9
	Radius 8
	Height 16
	Scale 0.14
	Damage 8
	+NODAMAGETHRUST
	+MTHRUSPECIES
	+DONTBLAST
	+DONTSPLASH
	DamageType Ice
	DeathSound "QC/Abilities/DukeNukem/FreezeShotExplo"
	ReactionTime 200 // 200 * 3/35 = 17 seconds in air before they melt by themselves
	States
	{
	Spawn:
		QW14 GHI 3 Bright A_CountDown
		Loop
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(255,"Death")
		Goto DeathEnd
	Crash:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(255,"Death")
		Goto DeathEnd
	Death:
		TNT1 A 0 A_Explode(random(2,4)*10,40,0)
		TNT1 A 10 A_SpawnItemEx("FreezeShotExplo", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
	DeathEnd:
		TNT1 A 1
		Stop
	}
}
Actor FreezeShotExplo
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NONETID
	Radius 2
	Height 2
	Scale 0.4
	Translation "0:255=%[0,0,0]:[1,1,1.4]"
	RenderStyle Add
	States
	{
	Spawn:
		DB59 ABCDEFGHIJKLMNOPQRS 1 Bright
		Stop
	}
}

//------------------------------------------
// DM version
Actor DukeFreezeShot_DM : DukeFreezeShot
{
	Damage 0
	+NODAMAGETHRUST
	-MTHRUSPECIES
	-DONTBLAST
	DamageType Ice
	States
	{
	Spawn:
		QW14 GHI 3 Bright A_CountDown
		Loop
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(255,"Death")
		Goto DeathEnd
	Crash:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(255,"Death")
		Goto DeathEnd
	Death:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_FreezeShotHits")
		TNT1 A 0 A_RadiusGive("FreezeCounterProc",64,RGF_PLAYERS|RGF_NOTARGET,1)
		TNT1 A 0 A_Explode(15,64,0,9,32)
		TNT1 A 3 A_SpawnItemEx("FreezeShotExplo", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Stop
	}
}

//The part that makes player slow
Actor PowerFreezeSlow : PowerSpeed	{ Speed 0.7 Inventory.Icon "" +POWERSPEED.NOTRAIL }
Actor FreezeSlowerer : PowerupGiver
{
	powerup.duration 35
	powerup.type "PowerFreezeSlow"
	-COUNTITEM
	+SERVERNETID
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ADDITIVETIME
}

//Where the magic happens, starts the script for freezing the player
Actor FreezeCounterProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_HitByFreezeShot")
		Stop
	}
}

//Tints the screen when players take damage from the ice balls
Actor IceDamageTintProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("AA AA FF",0.35,10)
		Stop
	}
}

//Spawns the ice cube thingy on players
Actor IceCubeProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		//TNT1 A 0 A_SetBlend("AA AA FF",0.7,180)					//sets screen as frozen
		TNT1 A 0 A_GiveInventory("IceProtectioner",1)			//makes player resist ice damage
		TNT1 A 0 A_FireCustomMissile("FrozenBlockLong",0,false, 0, 0, FPF_NOUNLAGGED)	//displays 3rd person iceblock
		Stop
	}
}
Actor IceCubePlayerProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		//TNT1 A 0 A_SetBlend("AA AA FF",0.7,180)						//sets screen as frozen
		TNT1 A 0 A_GiveInventory("IceProtectioner",1)				//makes player resist ice damage
		TNT1 A 0 A_FireCustomMissile("FrozenBlockPlayer",0,false, 0, 0, FPF_NOUNLAGGED)	//3rd person iceblock, for player, lasts less time
		Stop
	}
}


Actor PowerIceProtection : PowerProtection
{
	DamageFactor "Ice", 0.334
}
Actor IceProtectioner : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	powerup.duration -100
	Powerup.Type "PowerIceProtection"
	Powerup.Color "AA AA FF" 0.5
}



Actor FrozenBlockShort
{
	var int user_counter;
	Radius 3
	Height 4
	Mass 5
	Gravity 0.35
	+CORPSE
	+DROPOFF
	+CANNOTPUSH
	+FLOORCLIP
	+NOTELEPORT
	+NOBLOCKMAP
	+MOVEWITHSECTOR
	+NOINTERACTION
	-CLIENTSIDEONLY
	-NONETID
	+BRIGHT
	+DONTBLAST
	+SERVERNETID
	Scale 0.3
	States
	{
	Spawn:
		ICED A 0 NODELAY A_Jump(256,"PlayOff")
		"####" "#" 35
		Goto PlayOff
	PlayOff:
		"####" "#" 0 A_JumpIfInventory("ImFrozen",4,"FadeAway")	//if frozen longer (monsters only) disappear to make space for big ice cube
		"####" "#" 0 A_JumpIfInTargetInventory("ImDead",1,"FadeAway")	//if it died in while this ice thing was still around
		"####" "#####" 1 A_Warp(AAPTR_TARGET,0,0,0)
		"####" "#" 0 A_SetUserVar(user_counter,user_counter+1)
		"####" "#" 0 A_JumpIf(user_counter>=6,"FadeAway") //6*5 tics
		Loop
	FadeAway:
		"####" "#" 1 A_FadeOut(0.1)
		Loop
	}
}

Actor FrozenBlockLong : FrozenBlockShort
{
	Scale 0.5
	States
	{
	Spawn:
		ICED B 0 NODELAY A_PlaySound("misc/freeze")
		ICED B 0 A_Jump(255,"PlayOff")
		"####" "#" 35
		Goto PlayOff
	PlayOff:
		"####" "#" 0 A_JumpIfInTargetInventory("ImDead",1,"FadeAway")
		"####" "#####" 1 A_Warp(AAPTR_TARGET,0,0,20)
		"####" "#" 0 A_SetUserVar(user_counter,user_counter+1)
		"####" "#" 0 A_JumpIf(user_counter>=20,"FadeAway") //20*5 tics =100, almost 3 seconds
		Loop
	}
}

Actor FrozenBlockPlayer : FrozenBlockShort
{
	Scale 0.35
	States
	{
	Spawn:
		ICED B 0 NODELAY A_PlaySound("misc/freeze")
		ICED B 0 A_Jump(255,"PlayOff")
		"####" "#" 35
		Goto PlayOff
	PlayOff:
		"####" "#" 0 A_JumpIfInTargetInventory("ImDead",1,"FadeAway")
		"####" "#####" 1 A_Warp(AAPTR_TARGET,0,0,20)
		"####" "#" 0 A_SetUserVar(user_counter,user_counter+1)
		"####" "#" 0 A_JumpIf(user_counter>=16,"FadeAway") //16*5 tics = 80 + 10 tics of fadeout
		Loop
	}
}

Actor ImFrozen : Inventory
{
	+SERVERNETID
	Inventory.MaxAmount 10
	Inventory.InterhubAmount 0
}
Actor ImFullyFrozen : Inventory
{
	+SERVERNETID
	Inventory.MaxAmount 1
}

//======================================================================
Actor DukeAmmo : Ammo
{
	+FLOORCLIP
	-TELESTOMP
	+SERVERNETID
	Radius 20
	Height 16
	Inventory.PickupMessage "$GOT_DukeAmmo" // "You shouldn't be reading this"
	Inventory.Amount 30
	Inventory.MaxAmount 60
	Ammo.BackpackMaxAmount 60
	Ammo.BackpackAmount 30
	Scale 0.1
	States
	{
	Spawn:
		QP14 A -1
		Stop
	}
}
//--------------------------------------------------------
// Passive
// Huge ego: get extra health from all health bubbles
// (except small ones)
//--------------------------------------------------------

// Nothing to see here. It's all handled in the healing
// items themselves