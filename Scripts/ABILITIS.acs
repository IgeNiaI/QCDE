//Passive 2 "Armor Efficient", where armor degenerates MUCH slower,
//the effect takes place in the script "QCDE_Degeneration" in "HLTHARMR.acs"



//---------------------------------
//		Durandal's Passive

//This is derived of the script "ArmorGiver" from HLTHARMR.acs
//Edited to work for Durandal's rules
Script "DurandalArmor" (int ClassArmorMax, int ClassHealthMax, int ArmorToGive)
{
	if( ArmorToGive >= 100 ) 				//if it's a heavy armor
		ClassArmorMax = ClassArmorMax+75;	//allow overcharge of +75

	int ArmorCount;
	int CurrentHealth = GetActorProperty(0,APROP_HEALTH);
	int HealthMissing = 0;

	if(CurrentHealth < ClassHealthMax)
	{
		HealthMissing = ClassHealthMax - CurrentHealth;	//determines how much health was missing

		if(HealthMissing<=ArmorToGive)
			SetActorProperty(0, APROP_Health, CurrentHealth+HealthMissing);	//and heals it
		else
		{
			SetActorProperty(0, APROP_Health, CurrentHealth+ArmorToGive);
			HealthMissing=0;
		}
	}

	if(GetActorProperty(0,APROP_HEALTH)>= ClassHealthMax) //if current health max or above
	{
		ArmorToGive= ArmorToGive - HealthMissing;
		if(ArmorToGive>0)
			while(CheckInventory("BasicArmor") < ClassArmorMax  &&  ArmorCount < ArmorToGive)
			{
				GiveInventory("QCArmorPoint", 1);
				ArmorCount++;
			}
	}
}


