//--------------------------------------------------------------------------------
//--------------------------------------------------------------------------------
//	Weapon tokens
//--------------------------------------------------------------------------------
//--------------------------------------------------------------------------------
Actor SSG_UG_Speed 		: Token {}
Actor SSG_UG_Flame		: Token {}
Actor QCSShotgunSkin	: Token { Inventory.MaxAmount 20 }

Actor SSGFlame1
{
	Projectile
	Radius 3
	Height 3
	Speed 25
	+RIPPER
	+BLOODLESSIMPACT
	+SEEKERMISSILE
	+FORCERADIUSDMG
	+DONTBLAST
	ReactionTime 4
	RenderStyle None
	DamageType "FireDamage"
	ProjectileKickBack 0
	States
	{
	Spawn:
		PLAY A 0 NODELAY A_Explode(random(3,6)*10,128,0,0,32)
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,100)
	AfterBeepCheck:
		PLAY A 2 A_Explode(random(3,6)*10,64,0,0,40)
		TNT1 A 0 A_Jump(255, "SpawnFlamelets")
		Goto SpawnFlamelets

	SpawnFlamelets:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto AfterBeepCheckCont

	AfterBeepCheckCont:
		TNT1 A 0 A_CountDown
		Goto Spawn+1

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto AfterBeepCheck

	Death:
		PLAY BCDE 5
		Stop
	}
}

Actor SSGFlame1_Modded : SSGFlame1
{
	States
	{
	SpawnFlamelets:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto AfterBeepCheckCont
	}
}

Actor SSGFlame2 : SSGFlame1
{
	States
	{
	Spawn:
	Spawn2:
		PLAY A 0 NODELAY A_Explode(random(3,6)*10,128,0,0,32)
		PLAY A 2
		TNT1 A 0 A_Jump(255, "SpawnFlamelet")
		Goto SpawnFlamelet

	SpawnFlamelet:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto SpawnCont

	SpawnCont:
		PLAY A 1
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit2",360,JLOSF_PROJECTILE,100)

	AfterBeepCheck2:
		PLAY A 1  A_Explode(random(3,5)*10,64,0,0,40)
		TNT1 A 0 A_Jump(255, "SpawnFlamelets")
		Goto SpawnFlamelets

	SpawnFlamelets:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto AfterBeepCheckCont

	AfterBeepCheckCont:
		TNT1 A 0 A_CountDown
		Goto Spawn2+1

		RadiusHit2:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto AfterBeepCheck2
	}
}

Actor SSGFlame2_Modded : SSGFlame2
{
	States
	{
	SpawnFlamelet:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto SpawnCont

	SpawnFlamelets:
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		PLAY A 2
		TNT1 A 0 A_SpawnItemEx("FlameFlamelet_Modded", random(12,-12),random(12,-12),random(12,-12), 0,0,frandom(0,1.5), 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto AfterBeepCheckCont
	}
}

