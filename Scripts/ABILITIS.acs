	int leave = true;

	int plrtid;
	for(plrtid = 1000; plrtid < 1064; plrtid++)
		if(CheckActorInventory(plrtid,"Class_Freeman"))
			leave = false;

	SetResultValue(leave);
}


//---------------------------------
//		VorMatur's Passive

Script "QCDE_Passive_VorMatur" (void)
{
	// PVE buff: don't take extra damage
	TakeInventory("PowerPve3BodyProtection",1);

	int hp = GetActorProperty(0,APROP_HEALTH);
	int wasntDamagedFor;
	while(hp > 0)
	{
		delay(1);

		int hpWas = hp;
		hp = GetActorProperty(0,APROP_HEALTH);

		if(hp < hpWas)
		{
			if(hp < -50) hp = -50; // no excess
			int diff = hpWas - hp;

			if(diff < 2) continue; // don't care for degeneration

			if((diff < 11) && (Timer() % 7 < 3)) continue; // rapid-fires don't do this too often

			// How far to spit blood
			int speed = sqrt(diff * 3);
			SetActorProperty(0, APROP_Accuracy, speed/2);

			while(speed --> 0)
				GiveInventory("CorrosiveBloodProc",1);
		}
	}
}

