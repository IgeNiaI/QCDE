
Actor CompatVer30_Debug {} // for compatibility checks

// None of these are map placeable
//$GZDB_SKIP


Actor Tester : QCDoomImp
{
	Painchance 255
	Health 70000
	Mass 90000
	Speed 0
	DamageFactor "NailgunWeak", 0.43 //hack for weak nailgun-jump, explained in nailgun.qcd
	States
	{
	See:
		TROO A 10 A_Chase
		Loop
	Missile:
		TROO A 70
		Loop
	Melee:
		TROO A 30
		Goto See
	Pain:
		TROO A 5 A_PrintBold("$PAIN_Tester",0.2)
		Goto See
	Pain.Electric:
		TROO A 5 A_PrintBold("Electric pain",0.2)
		Goto See
	Pain.Railed:
		TROO A 5 A_PrintBold("Rail pain",0.2)
		Goto See
	Pain.RocketDamage:
		TROO A 5 A_PrintBold("Rocket/explosive pain",0.2)
		Goto See
	}
}

Actor DpsTester : Tester
{
	States
	{
	Spawn:
		TNT1 A 0 NodeLay ACS_NamedExecuteWithResult("QCDE_AttachDPSTest")
		Goto Super::Spawn
	Pain:
		TROO A 5
		Goto See
	}
}

Actor Testball : DoomImpBall
{
	Speed 0
	Damage (0)
	+NOINTERACTION
	Obituary "$OB_Testball" // "%o \c[bludi]has been pwned by %k."
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Explode(1000,16)
		Stop
	}
}
Actor Tester2 : QCDoomImp
{
	Painchance 255
	Health 70000
	Mass 90000
	Speed 0
	DamageFactor "NailgunWeak", 0.43 //hack for weak nailgun-jump, explained in nailgun.qcd
	States
	{
	See:
		TROO A 10 A_Chase
		Loop
	Missile:
		TROO A 105 A_CustomMissile("QCRocketPlayerDM")
		Loop
	Melee:
		TROO A 30
		Goto See
	Pain:
		TROO A 5 A_PrintBold("$PAIN_Tester",0.2)
		Goto See
	}
}

Actor UGCSMA : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("GNT_UG_Burn")
		TNT1 A 0 A_GiveInventory("GNT_UG_Omni")
		TNT1 A 0 A_GiveInventory("SG_UG_Spread")
		TNT1 A 0 A_GiveInventory("SG_UG_Explosive")
		TNT1 A 0 A_GiveInventory("HMG_UG_Ricochet")
		TNT1 A 0 A_GiveInventory("HMG_UG_Pierce")
		TNT1 A 0 A_GiveInventory("SSG_UG_Speed")
		TNT1 A 0 A_GiveInventory("SSG_UG_Flame")
		TNT1 A 0 A_GiveInventory("SNG_UG_Lava")
		TNT1 A 0 A_GiveInventory("SNG_UG_Seeker")
		TNT1 A 0 A_GiveInventory("TB_UG_Long")
		TNT1 A 0 A_GiveInventory("TB_UG_Grenade")
		TNT1 A 0 A_GiveInventory("RL_UG_Cluster")
		TNT1 A 0 A_GiveInventory("RL_UG_Control")
		TNT1 A 0 A_GiveInventory("LG_UG_Residue")
		TNT1 A 0 A_GiveInventory("LG_UG_Static")
		TNT1 A 0 A_GiveInventory("RG_UG_Pierce")
		TNT1 A 0 A_GiveInventory("RG_UG_Explosive")
		TNT1 A 0 A_GiveInventory("BFG_UG_Rays")
		TNT1 A 0 A_GiveInventory("BFG_UG_Charge")
		Stop
	}
}










