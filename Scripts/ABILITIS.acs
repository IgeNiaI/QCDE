//---------------------------------
//		Caleb's Active
//---------------------------------

Script "QCDE_Ability_Caleb" (void)
{
	int w;
	for(w = 0; w < NUMBER_OF_WEAPONS; w++)
		if(!stricmp(getWeapon(), weaponList[w]))
			break;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	//PlaySound(0,"QC/Abilities/Caleb/ActivateDrain",CHAN_5,0.75,false,1.0,false,true);
	SetPlayerProperty(0,1,PROP_INSTANTWEAPONSWITCH);
	SetNetworkReplicationFlags( 0 );

	if(PlayerIsBot(PlayerNumber()))
	{
		GiveInventory("DollBotProc",1);
		ACS("QCDE_SetWeapon", "CalebDollBot", GetDuration());
	}
	else
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("DollProc",1);
		SetNetworkReplicationFlags( 0 );
		ACS("QCDE_SetWeapon", "CalebDoll", GetDuration());
	}

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	int t = GetDuration();
	while(t --> 0)
	{
		if(checkinventory("DollSpent")) t=0;
		if(GetActorProperty(0,APROP_HEALTH) <= 0) break;
		delay(1);
	}

	// Break progress meter: 1 total duration, 1 remaining tic
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", 1, 1);

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetWeapon(weaponList[w]);
	TakeInventory("CalebDoll",1);
	TakeInventory("CalebDollBot",1);
	GiveInventory("DollCleanerProc",1); //Remove ability weapon
	TakeInventory("DollSpent",1);
	SetNetworkReplicationFlags( 0 );
}

Script "VoodooHealer" (int deathmatcher)
{
	int maxhealth = CheckInventory("MaxHealthToken");
	int healnormal, healover;

	if(deathmatcher==1)
	{
		healnormal=25;
		healover=5;
	}
	else
	{
		healnormal=35;
		healover=10;
	}


	if( GetActorProperty(0,APROP_HEALTH) < maxhealth)
		ACS_NamedExecuteWithResult("HealthGiver",maxhealth,healnormal, 0);
	else
		ACS_NamedExecuteWithResult("HealthGiver",maxhealth,healover, 75);

}



int last_voodoocaster = -2;
