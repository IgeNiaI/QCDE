// --------------------------------------------------------------------------
//
// Grayson's abilities
//
// Active:	Thumper
//			Static projectile that crashes on floor to make enemies enter
//			stasis mode and/or take damage from ceiling smashing
//
// Passive: Personal Dropkit
//			By holding "+use" you can buy ammo for your current weapon
//
// --------------------------------------------------------------------------

//--------------------------------------------------------
// Active
//--------------------------------------------------------
Actor DisableWeaponProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("ActiveInProgress",1)
		TNT1 A 0 A_GiveInventory("NoWeaponFireToken",1)
		TNT1 A 35
		Stop
	}
}

Actor ThumpSoundAndHaloProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_AlertMonsters(96)
		TNT1 A 0 A_FireCustomMissile("ThumperIndicator",0, false)
		TNT1 A 35
		Stop
	}
}

Actor ThumperArmingToken : Token {}
Actor ThumperReadyToken : Token {}

Actor ThumperIndicator
{
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	Projectile
	RenderStyle Add
	Scale 0.9
	Alpha 0.99
	Translation "0:255=%[0,0,0]:[0.7,0.7,1.3]"
	States
	{
	Spawn:
		DB66 A 0 NODELAY A_PlaySound("QC/Abilities/Grayson/LeashCast",5,1,0,0.7)
		DB66 AABBCCDDEEFF 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"),"Death3")
		DB66 GGHHIIJJKKLL 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"),"Death4")
		DB66 MMNNOOPPQQRR 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_AbilityFXMustDie"),"Death1")
		//DB66 SSTTUUVVWWXX 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 SS 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 TT 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 UU 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 VV 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 WW 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 XX 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 YY 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		DB66 A 0 A_FadeOut(0.1)
		DB66 ZZ 1  A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
		TNT1 AAAAAAA 1 A_Warp(AAPTR_TARGET, -5, 0, 30, 0,  WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	Death:
		X123 SSTTUUVVWWXX 1 A_FadeOut(0.07)
		Stop
	}
}


Actor ThumperShootProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/Grayson/LeashPhase",CHAN_AUTO,1)
		TNT1 A 0 A_TakeInventory("ThumperArmingToken")
		TNT1 A 0 A_TakeInventory("ThumperReadyToken")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)==2,"DMshoot")
		TNT1 A 0 A_FireCustomMissile("ThumperProjectile", 0     , false)
		TNT1 A 35
		Stop
	DMshoot:
		TNT1 A 0 A_FireCustomMissile("ThumperProjectileDM", 0     , false)
		TNT1 A 35
		Stop
	}
}




Actor PowerGrayThumpFlight : PowerFlight
{
	//Inventory.Icon "IcnHaste"
}

Actor GrayThumperFlight : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	powerup.Type "GrayThumpFlight"
	powerup.duration -15
}

Actor ThumperProjectile
{
	Projectile
	var int user_counter1;
	var int user_counter2;
	Speed 32
	Height 6
	Radius 5
	Projectile
	+STRIFEDAMAGE
	+FORCEXYBILLBOARD
	+DONTBLAST
	Damage (1)
	Scale 0.4
	Translation "0:255=%[0,0,0]:[1,1,1.5]"
	+SEEINVISIBLE
	+BLOODLESSIMPACT
	+SKYEXPLODE
	+THRUGHOST
	RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SetUserVar("user_counter1",0)
	Looper:
		TNT1 A 0 A_JumpIf(user_counter1>=20,"Outlived")
		TNT1 A 0 A_SetUserVar("user_counter1",user_counter1+1)
		TNT1 A 0 A_SpawnItemEx("LeashSpark",0,0,0,frandom(2.0,-2.0),frandom(2.0,-2.0),frandom(2.0,-2.0),0,SXF_NOCHECKPOSITION)
		DB52 A 1 BRIGHT //A_CustomRailgun(0,0,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_CENTERZ,1,0,"CustomPuffLeash",0,0,0,2,10.0,1.0,"LeashTrail")
		Loop
	Outlived:	//no target or surface was reached, will still perform but first it no longer interacts with world
		TNT1 A 0 A_Stop
		TNT1 A 0 A_ChangeFlag("THRUACTORS",1)
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_ChangeFlag("NOCLIP",1)
		Goto Looper2

	Death: 	//it reached a target or surface, and starts the effect
		TNT1 A 0 A_SetUserVar("user_counter2",0)
	Looper2:
		TNT1 A 0 A_JumpIf(user_counter2>=10,"ThumpAction")
		TNT1 A 0 A_SetUserVar("user_counter2",user_counter2+1)
		TNT1 AA 0 A_SpawnItemEx("LeashSpark",0,0,0,frandom(2.0,-2.0),frandom(2.0,-2.0),frandom(2.0,0.1),0,SXF_NOCHECKPOSITION)
		DB52 A 1 BRIGHT //A_CustomRailgun(0,0,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT,1,0,"CustomPuffLeash",0,0,0,2,4.0,1.0,"LeashTrail")
		Loop
	ThumpAction:
		TNT1 A 0 A_PlaySound("DoomStorm/Player/LeashThumper",6,1,0,ATTN_NONE)
		TNT1 A 0 A_SpawnItemEx("ThumperBall",0,0,0,0.01,0,24,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_TakeFromTarget("NoWeaponFireToken")
		TNT1 A 5 A_TakeFromTarget("ActiveInProgress")
		Stop
	}
}
Actor ThumperProjectileDM : ThumperProjectile
{
	-DONTBLAST
	States
	{
	ThumpAction:
		TNT1 A 0 A_PlaySound("DoomStorm/Player/LeashThumper",6,1,0,ATTN_NONE)
		TNT1 A 0 A_SpawnItemEx("ThumperBallDM",0,0,0,0.01,0,24,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_TakeFromTarget("NoWeaponFireToken")
		TNT1 A 5 A_TakeFromTarget("ActiveInProgress")
		Stop
	}
}

//--------------------------------------------------------------
//	The leash ball that goes up, and falls down
Actor ThumperBall
{
	Projectile
	Speed 0
	Radius 2
	Height 3
	RenderStyle Add
	+BOUNCEONCEILINGS
	+FORCEXYBILLBOARD
	+SKYEXPLODE
	Gravity 2.0
	-NOGRAVITY
	Scale 0.5
	+THRUGHOST
	+THRUACTORS
	+DONTBLAST
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.2]"
	DamageType "ThumperDamage"
	ReactionTime 3
	States
	{
	Spawn:
		TNT1 A 0
		DB66 AABBCCDDEEFFGGHHIIJJKKLLMM 1 Bright A_SpawnItemEx("ThumperBallTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CountDown
		DB66 NNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_SpawnItemEx("ThumperBallTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CountDown
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("ThumperDustSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_PlaySound("QC/Abilities/Grayson/ThumperExplode",5,1,0,0.85)
		TNT1 A 0 A_Warp(AAPTR_DEFAULT,0,0,64)	//raise it a bit to avoid "stair-step blocking"
		TNT1 A 0 A_Explode(1,384,0,1,384)
		TNT1 A 10
		Stop
	}
}

Actor ThumperBallDM : ThumperBall
{
	-DONTBLAST
	States
	{
		Death:
		TNT1 A 0 A_SpawnItemEx("ThumperDustSpawner",0,0,0,0,0,0,0,32)
		TNT1 A 0 A_Warp(AAPTR_DEFAULT,0,0,64)	//raise it a bit to avoid "stair-step blocking"
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_ThumperHit")
		TNT1 A 0 A_PlaySound("QC/Abilities/Grayson/ThumperExplode",5,1,0,0.7)
		TNT1 A 0 A_Explode(1,384,0,1,384)
		TNT1 A 10 A_RadiusGive("ThumperOnPlayerProc",384,RGF_PLAYERS)
		Stop
	}
}



