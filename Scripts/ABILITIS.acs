//---------------------------------
//		Serious Sam's Passive
// Same script for start of life and picking up armor
// Because it was more fun to code it that way
// I'll commit SMH now [Ms]

Script "QCDE_Passive_Sam" (int ammo)
{
	if(!ammo) // Start of life
	{
		SetInventory("SeriousBullets",80);
        int startingWeapon = GetCvar("cl_startingWeapon");
		if(GameType() <= GAME_NET_COOPERATIVE)
		{
			if(!CheckInventory("QCHeavyMachinegun")) GiveInventory("QCMachineGun", 1);
			SetInventory("QCShotgun"   ,1);
         	if(!CheckInventory("QCSuperNailgun")) GiveInventory("QCNailgun", 1);
			SetInventory("SamMinigun"  ,0);
			SetInventory("SeriousBullets",GetAmmoCapacity("SeriousBullets"));
			
            switch(startingWeapon)
            {
            default: // go to case 1
            case 1: SetWeapon("QCMachineGun");	break;
            case 2: SetWeapon("QCShotgun");		break;
            case 3: SetWeapon("QCNailgun");		break;
            }
		}
		else if(!GetCvar("instagib") && !GetCvar("rocketarena"))
		{
			SetInventory("QCMachineGunDM",1);
			SetInventory("QCShotgunDM"   ,1);
			SetInventory("QCNailgunDM"   ,1);
			
			if		(CheckInventory("Starter_Machinegun"))	SetWeapon("QCMachineGunDM");
            else if	(CheckInventory("Starter_Shotgun"   ))	SetWeapon("QCShotgunDM");
            else if	(CheckInventory("Starter_Nailgun"   ))	SetWeapon("QCNailgunDM");
            else
            {
            	switch(startingWeapon)
            	{
            	default: // go to case 1
            	case 1: SetWeapon("QCMachineGunDM");	break;
            	case 2: SetWeapon("QCShotgunDM");		break;
            	case 3: SetWeapon("QCNailgunDM");		break;
            	}
            }
		}
	}
	else // Giving ammo
	{
		int type, amount;
		if      (qcContains("Mac"))	{ type = AmmoType[0]; amount = getSamAmmoBonus(0) * ammo; }
		else if (qcContains("Sho"))	{ type = AmmoType[1]; amount = getSamAmmoBonus(1) * ammo; }
		else if (qcContains("Nai"))	{ type = AmmoType[2]; amount = getSamAmmoBonus(2) * ammo; }
		else if (qcContains("Tri"))	{ type = AmmoType[3]; amount = getSamAmmoBonus(3) * ammo; }
		else if (qcContains("Roc"))	{ type = AmmoType[4]; amount = getSamAmmoBonus(4) * ammo; }
		else if (qcContains("Lig"))	{ type = AmmoType[5]; amount = getSamAmmoBonus(5) * ammo; }
		else if (qcContains("Rai"))	{ type = AmmoType[6]; amount = getSamAmmoBonus(6) * ammo; }
		else if (qcContains("BFG"))	{ type = AmmoType[7]; amount = getSamAmmoBonus(7) * ammo; }
		else if (qcContains("mMi"))	{ type = "SeriousBullets"; amount = 10 * ammo; }
		else terminate;

		GiveInventory(type, amount);
	}
}

Script "QCDE_Sam_Bullets_Full"
{
	if (CheckInventory("SeriousBullets") >= GetAmmoCapacity("SeriousBullets"))
		SetResultValue(1);
	else
		SetResultValue(0);
}



//---------------------------------
//		Postal's Passive

#define POSTAL_UPWARD_PUSH 3
Script "QCDE_Passive_Postal" (void)
{
	// Check crackpipe stuck in throat from last map
	if(!CheckInventory("NoArmorDegenerationToken") && // Having no armor degen means there was a reliq
	    CheckInventory("NoHealthDegenerationToken"))
		TakeInventory("NoHealthDegenerationToken",1);
}

// Pressing jump automatically unpresses crouch.
// Luckily, jump script is always executed before crouch script, so we can add more velocity on crouch script release
bool postalJustJumped[64];

Script "QCDE_Postal_Jump" (int predicting, int justPressed, int justReleased, int buttons)
{
	if (justPressed && (CheckSolidFooting(0, 0) != CSF_INAIR))
		postalJustJumped[PlayerNumber()] = true;
}

Script "QCDE_Postal_Crouch" (int predicting, int justPressed, int justReleased, int buttons)
{
	if (justReleased && postalJustJumped[PlayerNumber()])
	{
		ThrustThingZ(0, POSTAL_UPWARD_PUSH * 4, 0, 1);
		postalJustJumped[PlayerNumber()] = false;
	}
}

#define POSTAL_CRACKPIPE_SECONDS_COOP 90
#define POSTAL_CRACKPIPE_SECONDS_DM   40
#define POSTAL_CRACKPIPE_WARNING      15
#define POSTAL_EXTRA_DEGEN_MAX        50
#define POSTAL_EXTRA_DEGEN_PERIOD     20
#define POSTAL_INSTANT_WITHDRAWAL     25
#define POSTAL_LOGGING             false
Script "QCDE_Passive_Postal_Mega" (void)
{
	if(CheckInventory("NoArmorDegenerationToken")) terminate; // has "no degen" reliq

	int t = POSTAL_CRACKPIPE_SECONDS_DM;
	if(GameType() < GAME_NET_DEATHMATCH) t = POSTAL_CRACKPIPE_SECONDS_COOP;
	if(CheckInventory("HighOnCrack")) // hooked
	{
		if(POSTAL_LOGGING) print(s:"\c[RG]Updated seconds before withdrawal, not starting another counter");
		SetInventory("HighOnCrack", t);
		terminate;
	}

	// High
	GiveInventory("HighOnCrack", t);
	delay(1);
	GiveInventory("NoHealthDegenerationToken",1);

	delay(16);
	if(!random(0,3))
		PlaySound(0, "QC/Abilities/Postal/Postal_Smoke", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);

	while(CheckInventory("HighOnCrack"))
	{
		if(GetActorProperty(0, APROP_Health) <= 0) terminate; // keep an eye on staying alive
		if(CheckInventory("HighOnCrack") == POSTAL_CRACKPIPE_WARNING) PlaySound(0, "QC/Abilities/Postal/Postal_Warning", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
		if(POSTAL_LOGGING) print(s:"\c[brite]Seconds before withdrawal: ", d:CheckInventory("HighOnCrack"));
		TakeInventory("HighOnCrack", 1);
		delay(35);
	}

	if(CheckInventory("NoArmorDegenerationToken")) terminate; // got "no degen" reliq
	TakeInventory("NoHealthDegenerationToken",1);

	// Withdrawal
	PlaySound(0, "QC/Abilities/Postal/Postal_Withdraw", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
	t = POSTAL_EXTRA_DEGEN_MAX;
	int hp = GetActorProperty(0, APROP_Health);
	if(hp <= CheckInventory("MaxHealthToken")) // has no overstack, so instant pain of withdrawal
	{
		hp -= POSTAL_INSTANT_WITHDRAWAL;
		if(hp > 0)
			SetActorProperty(0, APROP_Health, hp);
		else
			SetActorProperty(0, APROP_Health, 1);
		if(POSTAL_LOGGING) print(s:"No overstack: instant punishment to \c[bludi]", d:hp);
		terminate;
	}
	else while(t --> 0)
	{
		delay(POSTAL_EXTRA_DEGEN_PERIOD);
		if(POSTAL_LOGGING) print(s:"Extra degen after withdrawal: \c[bludi]", d:t);
		if(CheckInventory("NoHealthDegenerationToken")) terminate; // got "no degen" reliq or another mega

		hp = GetActorProperty(0, APROP_Health);
		if(hp <= 0) break; // died. New body shouldn't suffer for old one's sins (but it might due to rompy-stompy bug)
		if(hp <= CheckInventory("MaxHealthToken")) break; // has no overstack, no more withdrawal

		SetActorProperty(0, APROP_Health, hp - 1);
	}
	if(POSTAL_LOGGING) print(s:"\c[SNG]I'm fine today.");
}



//---------------------------------
//		Painkiller's Passive

#define SOUL_THRESHOLD_COOP 66
#define SOUL_THRESHOLD_DM    6


Script "QCDE_Passive_Painkiller" (int activate)
{
	if(!activate) terminate;
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	int hp = GetActorProperty(0, APROP_Health);
	int ap = CheckInventory("BasicArmor");

	delay(1); // Necessary not to crash GZDoom on morph

	ACS_NamedExecuteWithResult("QCDE_PainkillerAbilityMovement", 0);
	int translation = GetActorProperty(0, APROP_Translation);
	GiveInventory("DemonMorphProc",1);
	SetActorProperty(0, APROP_Translation, translation);
	// Break tarot if active
	GiveInventory("NoAbilitiesToken",1);
	for(int i = 1; i <= 3; i++)
		for(int j = 1; j <= 3; j++)
			SetInventory(strparam(s:"PainkillerCard", d:i, s:"Level", d:j), 0);

	// ES fix: consume soul, let it respawn
	TakeInventory("PowerTermToken",1);
	TakeInventory("PowerTerminatorArtifact",1);
	TakeInventory("PowerEldersSoul",1);

	ACS("QCDE_DM_DropPowerups");

	int t = GetActorPowerupTics(0, "PowerDemonMorph");
	ACS("QCDE_ShowActiveInProgress", t);
	if (GetNetworkState() == NETSTATE_SERVER)
		ACS("QCDE_ShowActiveInProgress_CLIENTSIDE", t);

	GiveInventory("NoReticle", 1);
	GiveInventory("NoAmmoCount", 1);
	GiveInventory("NoAbilityIcon", 1);

	// Progress
	while(CheckInventory("PowerDemonMorph"))
		if(t --> 0)
			delay(1);
		else
			break;
	UnmorphActor(0,true); // necessary extra layer

	// Morph ended
	GiveInventory("PainkillerCleanerProc",1);
	ACS_NamedExecuteAlways("QCDE_ConfigureMovement", 0);
	if(GetActorProperty(0, APROP_Health) < 0) terminate;

	// Morph ended successfully
	SetActorProperty(0, APROP_Health, hp);
	TakeInventory("QCArmorPoint", ap);
	GiveInventory("QCArmorPoint", ap);
}

// Activator: dying monster
Script "QCDE_MonsterKill_QCPainkiller" (int xdeath)
{
	str class = "PainkillerSoul";
	if(CheckInventory("MonsterBig") || CheckInventory("MonsterBoss"))
		class = "PainkillerSoulBig";
	SpawnSpotForced(class,0,0,0);
}

// Activator: dying victim
Script "QCDE_PlayerKill_QCPainkiller" (void)
{
	str class = "PainkillerSoulDM";
	SpawnSpotForced(class,0,0,0);

	// Activator: Pain killer
	SetActivatorToTarget(0);
	if(PlayerIsBot(PlayerNumber()) && random(0,3))
		GiveInventory("PainkillerSoulDM", 1);
}


Script "QCDE_Passive_Intruder" (void)
{
	int secrets;
	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		if(secrets < GetLevelInfo(LEVELINFO_FOUND_SECRETS))
		{
			ACS("ArmorGiver", ACS("MaxArmor"), 50, true);
			ACS("QCDE_IntruderMoraleBoost");
		}

		secrets = GetLevelInfo(LEVELINFO_FOUND_SECRETS);
		delay(1);
	}
}





Script "QCDE_MonsterKill_QCIntruder" (void)
{
	SetActivatorToTarget(0);
	// Activator: Player

	if(!CheckInventory("Class_Intruder")) terminate;

	if(!CheckInventory("PowerWendigoTint"))
	{
		PlaySound(0, "QC/Abilities/Intruder/BonusPick", CHAN_7|CHAN_UI, 0.86, false, ATTN_NONE, true);
		GiveInventory("IntruderSpeeder",1);
	}
}

Script "QCDE_PlayerKill_QCIntruder" (void)
{
	SetActivatorToTarget(0);
	// Activator: Player

	if(!CheckInventory("Class_Intruder")) terminate;

	if(!CheckInventory("PowerWendigoTint"))
	{
		PlaySound(0, "QC/Abilities/Intruder/BonusPick", CHAN_7|CHAN_UI, 0.86, false, ATTN_NONE, true);
		GiveInventory("IntruderSpeeder",1);
	}
}


//---------------------------------
//		Orbb's Passive

#define ORBB_BOUNCE_THRESHOLD	-11.0

bool orbbVelocityZ[64];

Script "QCDE_Orbb_Bounce" (int predicting, int justPressed, int justReleased, int buttons)
{
	if (predicting)
	{
		if (GetPredictableValue(0, 0))
		{
			SetActorVelocity(0, GetActorVelX(0), GetActorVelY(0), GetPredictableValue(0, 1), 0, 0);
		}
	}
	else
	{
		if ( ( CheckSolidFooting(0, 0) != CSF_INAIR ) && ( orbbVelocityZ[PlayerNumber()] < ORBB_BOUNCE_THRESHOLD ) )
		{
			SetActorVelocity(0, GetActorVelX(0), GetActorVelY(0), -orbbVelocityZ[PlayerNumber()], 0, 0);
			SetPredictableValue(0, 0, 1);
			SetPredictableValue(0, 1, -orbbVelocityZ[PlayerNumber()]);
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			PlaySound(0, "OrbbJump", CHAN_BODY);
			SetNetworkReplicationFlags( 0 );
		}

		orbbVelocityZ[PlayerNumber()] = GetActorVelZ(0) * 82 / 100;
	}
}
