	inInventory QCHeavyMachinegun 	{ inInventory HMG_UG_Ricochet  { drawImage "HPG_07_1",1493,335; }   inInventory HMG_UG_Pierce    { drawImage "HPG_07_2",1523,335; } } else { inInventory HMG_UG_Ricochet  { drawImage "GPG_07_1",1493,335; }   inInventory HMG_UG_Pierce    { drawImage "GPG_07_2",1523,335; } }
	inInventory QCSuperNailgun		{ inInventory SNG_UG_Lava      { drawImage "HPG_11_1",1493,475; }   inInventory SNG_UG_Seeker    { drawImage "HPG_11_2",1523,475; } } else { inInventory SNG_UG_Lava      { drawImage "GPG_11_1",1493,475; }   inInventory SNG_UG_Seeker    { drawImage "GPG_11_2",1523,475; } }
	inInventory QCTribolt	 		{ inInventory  TB_UG_Long      { drawImage "HPG_13_1",1493,545; }   inInventory  TB_UG_Grenade   { drawImage "HPG_13_2",1523,545; } } else { inInventory  TB_UG_Long      { drawImage "GPG_13_1",1493,545; }   inInventory  TB_UG_Grenade   { drawImage "GPG_13_2",1523,545; } }
	inInventory QCRocketLauncher	{ inInventory  RL_UG_Cluster   { drawImage "HPG_15_1",1493,615; }   inInventory  RL_UG_Control   { drawImage "HPG_15_2",1523,615; } } else { inInventory  RL_UG_Cluster   { drawImage "GPG_15_1",1493,615; }   inInventory  RL_UG_Control   { drawImage "GPG_15_2",1523,615; } }
	inInventory QCLightningGun		{ inInventory  LG_UG_Residue   { drawImage "HPG_17_1",1493,685; }   inInventory  LG_UG_Static    { drawImage "HPG_17_2",1523,685; } } else { inInventory  LG_UG_Residue   { drawImage "GPG_17_1",1493,685; }   inInventory  LG_UG_Static    { drawImage "GPG_17_2",1523,685; } }
	inInventory QCRailgun 			{ inInventory  RG_UG_Pierce    { drawImage "HPG_19_1",1493,755; }   inInventory  RG_UG_Explosive { drawImage "HPG_19_2",1523,755; } } else { inInventory  RG_UG_Pierce    { drawImage "GPG_19_1",1493,755; }   inInventory  RG_UG_Explosive { drawImage "GPG_19_2",1523,755; } }
	inInventory QCBFG 				{ inInventory BFG_UG_Rays      { drawImage "HPG_21_1",1493,825; }   inInventory BFG_UG_Charge    { drawImage "HPG_21_2",1523,825; } } else { inInventory BFG_UG_Rays      { drawImage "GPG_21_1",1493,825; }   inInventory BFG_UG_Charge    { drawImage "GPG_21_2",1523,825; } }

	// shotguns are special
	inInventory QCSuperShotgun {
