		"####" A 0 A_JumpIfInventory("TeamColor",1,"BlueMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		RedMelee:
			RP16 F 6 BRIGHT Light("PlayerFiringLight")
			RP16 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		BlueMelee:
			BP16 F 6 BRIGHT Light("PlayerFiringLight")
			BP16 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop
		DefMelee:
			QP16 F 6 BRIGHT Light("PlayerFiringLight")
			QP16 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "Spawn")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",2, "RedPain")
		"####" A 0 A_JumpIfInventory("TeamColor",1,"BluePain")
		"####" I 1 A_JumpIf(true,                   "DefPain")
		Loop

