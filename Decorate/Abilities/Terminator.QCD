Actor PowerDangerIndicator : PowerDamage
{
	DamageFactor "Normal", 1
}
Actor DangerIndicatorColorer : InvulnerabilitySphere
{
	Powerup.Colormap 0,0,0, 1,0.5,0.5
	powerup.duration -100
	Powerup.Type "DangerIndicator"
}