	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"B11","B12","B13","B14","B21","B22","B23","B24","B31","B32","B33","B34")
	B11:
		X057 ABCDEF 2 Bright A_FadeOut(0.05)
		X057 GHIJK 1 Bright A_FadeOut(0.05)
		X057 LMNOPQRS 1 Bright A_FadeOut(0.03)
