// --------------------------------------------------------------------------
//
// Super Shotgun
// Weapon and Pickup sprite by FrancoTieppo
// Weapon code by DBT
//
// --------------------------------------------------------------------------

Actor CompatVer31_SShotgun {} // for compatibility checks

Actor SuperShotgunPickup : QCWeaponPickup 15602
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Super Shotgun"
	Height 48
	Radius 20
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCSuperShotgun" // "Picked up a Super Shotgun."
	Tag "$TAG_QCSuperShotgun" // "Super Shotgun"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		QCGC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		QCGC Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4],args[3])
		QCGC Z 0 A_SetArg(3, 1)
		QCGC Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		QCGC Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4],args[3])
		QCGC Y 0 A_SetArg(3, 1)
		QCGC Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor SuperShotgunPickupNoGravity : SuperShotgunPickup 15612
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Super Shotgun (No Gravity)"
	+NOGRAVITY
}

Actor SuperShotgunPickupDMvar: CustomInventory 	//this one is for SSGs spawned in DM maps that have 200
{												//SSG spawns in the map. Most of the time, it'll be something else
	//$NotAngled
	//$Color 14
	//$Title "SSG-in-vanilla Replacer"
	var int user_type;
	Height 48
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_QCSuperShotgun" // "Picked up a Super Shotgun."
	Tag "$TAG_QCSuperShotgun" // "Super Shotgun"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		TNT1 A 1
		QCGC Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle

	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Goto ChooseWeapon

		ChooseWeapon:
			TNT1 A 0 A_Jump(200,"BeTribolt","BeHMG","BeSNG")
			Goto BeSSG //about 1/5th of the time, it'll be ssg
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeHMG:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeSNG:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeSSG:
			QCGC Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4])
			QCGC Z -1 Bright A_SetArg(4, 0)
			Wait

	Idle:
		QCGC Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4])
		QCGC Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}


Actor QCSuperShotgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.0
	Weapon.Kickback 35
	Weapon.SelectionOrder 1100
	Weapon.AmmoUse 2
	Weapon.AmmoGive 16
	Weapon.AmmoType "QCShellAmmo"
	Obituary "$OB_QCSuperShotgun"
	Inventory.PickupMessage "$GOT_QCSuperShotgun"
	Tag "$TAG_QCSuperShotgun"
	Scale 0.66
	States
	{
	Spawn:
		QCGC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		QCGC ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		QCGC Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "Select.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "Select.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "Select.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "Select.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "Select.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "Select.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "Select.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "Select.Quake1")
	Select.Default:
		QCAC A 0
		Goto SelectCont
	Select.Quake1:
		Q1AC A 0
		Goto SelectCont
	Select.Quake2:
		Q2AC A 0
		Goto SelectCont
	Select.Quake3:
		Q3AC A 0
		Goto SelectCont
	Select.Quake4:
		Q4AC A 0
		Goto SelectCont
	Select.ETQW:
		QWAC A 0
		Goto SelectCont
	Select.QCDE1:
		Q0AC A 0
		Goto SelectCont
	Select.HalfLife:
		HLAC A 0
		Goto SelectCont
	Select.SeriousSam:
		SSAC A 0
		Goto SelectCont
	Select.Modded:
		MDAC A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_TakeInventory("QCShotgunDM")
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 ACS_NamedExecuteWithResult("QCDE_ZoomCheckSelect")
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
	DeselecLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "Prepare.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "Prepare.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "Prepare.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "Prepare.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "Prepare.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "Prepare.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "Prepare.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "Prepare.Quake1")
	Prepare.Default:
		QCAC A 0
		Goto PrepareCont
	Prepare.Quake1:
		Q1AC A 0
		Goto PrepareCont
	Prepare.Quake2:
		Q2AC A 0
		Goto PrepareCont
	Prepare.Quake3:
		Q3AC A 0
		Goto PrepareCont
	Prepare.Quake4:
		Q4AC A 0
		Goto PrepareCont
	Prepare.ETQW:
		QWAC A 0
		Goto PrepareCont
	Prepare.QCDE1:
		Q0AC A 0
		Goto PrepareCont
	Prepare.HalfLife:
		HLAC A 0
		Goto PrepareCont
	Prepare.SeriousSam:
		SSAC A 0
		Goto PrepareCont
	Prepare.Modded:
		MDAC A 0 A_PlaySound("QC/Weapons/SuperShotgun/Prepare_Modded",CHAN_WEAPON)
		Goto PrepareCont

	PrepareCont:
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle

	Idle:
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "Idle.Modded")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "Idle.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "Idle.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "Idle.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "Idle.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "Idle.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "Idle.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "Idle.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "Idle.Quake1")
	Idle.Default:
		QCCC A 0
		Goto IdleCont
	Idle.Quake1:
		Q1CC A 0
		Goto IdleCont
	Idle.Quake2:
		Q2CC A 0
		Goto IdleCont
	Idle.Quake3:
		Q3CC A 0
		Goto IdleCont
	Idle.Quake4:
		Q4CC A 0
		Goto IdleCont
	Idle.ETQW:
		QWCC A 0
		Goto IdleCont
	Idle.QCDE1:
		Q0CC A 0
		Goto IdleCont
	Idle.HalfLife:
		HLCC A 0
		Goto IdleCont
	Idle.SeriousSam:
		SSCC A 0
		Goto IdleCont
	Idle.Modded:
		MDCC A 0 A_PlaySound("QC/Weapons/SuperShotgun/Idle_Modded",CHAN_WEAPON)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 3 A_WeaponReady
		Loop

		IdleCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Idle

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: //35 tics, 1.0 sec
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 5, "Fire.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 4, "Fire.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 3, "Fire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 2, "Fire.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 1, "Fire.Quake1")
	Fire.Default:
		QCEC A 0
		Goto FireCont
	Fire.Quake1:
		Q1EC A 0
		Goto FireCont
	Fire.Quake2:
		Q2EC A 0
		Goto FireCont
	Fire.Quake3:
		Q3EC A 0
		Goto FireCont
	Fire.Quake4:
		Q4EC A 0
		Goto FireCont
	Fire.ETQW:
		QWEC A 0
		Goto FireCont
	Fire.QCDE1:
		Q0EC A 0
		Goto FireCont
	Fire.HalfLife:
		HLEC A 0
		Goto FireCont
	Fire.SeriousSam:
		SSEC A 0
		Goto FireCont
	Fire.Modded:
		MDEC A 0
		Goto FireCont

	FireCont:
		"####" A 0 A_AlertMonsters
		"####" A 0 Bright A_GunFlash("PrimaryFlash")
		"####" B 1 Bright
		"####" B 1 Bright Offset(4,27)
		"####" B 0 A_JumpIfInventory("SSG_UG_Speed",1,"FasterSpeed")
	RegularSpeed:
		"####" C 1 Offset(11,19)
		"####" D 1 Offset(23,11)
		"####" E 1 Offset(32,9)
		"####" F 1 Offset(38,7)
		"####" G 1 Offset(44,7)
		"####" G 1
		"####" H 1
		"####" I 1
		"####" J 2
		"####" K 2
		"####" L 1
		"####" L 1 Offset(42,7)
		"####" M 1 Offset(39,8)
		"####" M 1 Offset(36,9)
		"####" N 1 Offset(33,11)
		"####" O 1 Offset(30,14)
		"####" P 1 Offset(26,17)

		"####" Q 1 Offset(23,20)
		"####" Q 1 Offset(20,23)
		"####" R 1 Offset(18,27)
		"####" R 1 Offset(16,28)
		"####" S 1 Offset(14,29)
		"####" S 1 Offset(12,31)
		"####" T 1 Offset(10,32)
		"####" T 1 Offset(8,33)
		"####" U 1 Offset(6,34)
		"####" U 1 Offset(4,35)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto Idle


	FasterSpeed: //including 2 tics of firing, total 28 tics (0.8sec)
		"####" C 1 Offset(11,19)
		"####" D 1 Offset(23,11)
		"####" E 1 Offset(32,9)
		"####" F 1 Offset(38,7)
		"####" G 1 Offset(44,7)
		"####" H 1
		"####" I 1
		"####" J 1
		"####" K 1
		"####" L 1 Offset(42,7)
		"####" M 1 Offset(37,9)
		"####" N 1 Offset(33,11)
		"####" O 1 Offset(30,14)
		"####" P 1 Offset(26,17)
		"####" Q 1 Offset(23,20)
		"####" Q 1 Offset(20,23)
		"####" R 1 Offset(17,27)
		"####" S 1 Offset(14,29)
		"####" S 1 Offset(12,31)
		"####" T 1 Offset(10,32)
		"####" T 1 Offset(7,33)
		"####" U 1 Offset(4,35)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto Idle

	PrimaryFlash: //Attacks doer
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DM_Flash")
		Goto SP_Flash

		SP_Flash:
			TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken", 1, "CheckIfAltMod")
			TNT1 A 0 A_JumpIfInventory("SSG_UG_Speed",1,"DoMoreDamage")
			TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "SP_Flash.Modded")
		SP_Flash.Default:
			TNT1 A 0 A_FireBullets(9.2,7.2,15,random(10,14),"QCShotgunPuff",FBF_NORANDOM|FBF_USEAMMO)
			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracer",frandom(9.2,-9.2),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(7.2,-7.2))
			Goto FlashCheckSound
		SP_Flash.Modded:
			TNT1 A 0 A_FireBullets(9.2,7.2,15,random(10,14),"QCShotgunPuffSSG_Modded",FBF_NORANDOM|FBF_USEAMMO)
			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracerSSG_Modded",frandom(9.2,-9.2),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(7.2,-7.2))
			Goto FlashCheckSound

		DoMoreDamage:
			TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "DoMoreDamage.Modded")
		DoMoreDamage.Default:
			TNT1 A 0 A_FireBullets(9.2,7.2,15,random(14,20),"QCShotgunPuff",FBF_NORANDOM|FBF_USEAMMO)
			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracer",frandom(9.2,-9.2),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(7.2,-7.2))
			Goto FlashCheckSound
		DoMoreDamage.Modded:
			TNT1 A 0 A_FireBullets(9.2,7.2,15,random(14,20),"QCShotgunPuffSSG_Modded",FBF_NORANDOM|FBF_USEAMMO)
			TNT1 AAAAAAA 0 A_FireCustomMissile("BulletSmallTracerSSG_Modded",frandom(9.2,-9.2),false,3,0,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(7.2,-7.2))
			Goto FlashCheckSound

			CheckIfAltMod:
				TNT1 A 0 A_JumpIfInventory("SSG_UG_Flame",1,"DoFlame")
				Goto SP_Flash+1
			DoFlame:
				TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "DoFlame.Modded")
			DoFlame.Default:
				TNT1 A 0 A_FireCustomMissile("SSGFlame1",             0, true,3)
				TNT1 A 0 A_FireCustomMissile("SSGFlame2",arandom( 13, 7),false,3)
				TNT1 A 0 A_FireCustomMissile("SSGFlame2",arandom(-13,-7),false,3)
				Goto FlashCheckSound
			DoFlame.Modded:
				TNT1 A 0 A_FireCustomMissile("SSGFlame1_Modded",             0, true,3)
				TNT1 A 0 A_FireCustomMissile("SSGFlame2_Modded",arandom( 13, 7),false,3)
				TNT1 A 0 A_FireCustomMissile("SSGFlame2_Modded",arandom(-13,-7),false,3)
				Goto FlashCheckSound


		DM_Flash:
			TNT1 A 0 A_JumpIfInventory("QCSShotgunSkin", 20, "DM_Flash.Modded")
		DM_Flash.Default:
			TNT1 A 0 A_FireBullets(sin(0)*2.1,cos(0)*2.1,-1,4,"QCShotgunPuff_DM",FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(0)*3.4,cos(0)*3.4,-1,4,"QCShotgunPuff_DM",FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(0)*5.5,cos(0)*5.5,-1,3,"QCShotgunPuff_DM",FBF_NORANDOM|FBF_EXPLICITANGLE)

			TNT1 A 0 A_FireBullets(sin(36)*2.1,cos(36)*2.1,-1,4,"QCShotgunPuff_DM",FBF_NORANDOM|FBF_EXPLICITANGLE)
