		TNT1 A 0 A_JumpIfTargetInLOS("ShooterInWay",5,0)
		TNT1 A 0 A_CustomRailgun(random(3,20),0,none,"SkyBlue",RGF_SILENT|RGF_FULLBRIGHT,0,6,"LGResiduePuff", 0,0,256, 6,1.0,1,"none",-5)
		Goto DecideFX

	T1:
