alias qcde_InvasionSurv   "qcde_inv_surv"
alias qcde_LoadoutLife    "qcde_rw"
alias qcde_LoadoutMap     "qcde_rws"
alias qcde_RocketArena    "qcde_ra"
alias qcde_ShaftParty     "qcde_ls"
alias qcde_SkullTag       "qcde_st"
alias qcde_Survival       "qcde_surv"
alias qcde_TeamDeathmatch "qcde_tdm"
