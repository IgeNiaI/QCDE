//================================================================
//================================================================
Actor QNailEnforcer : QCDE_MonsterSmall	15109	
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 90
	Health 60
	Radius 20
	Height 56
	Mass 100
	Speed 6
	PainChance 200
	Monster
	Scale 0.37
	+FLOORCLIP
	MinMissileChance 255
	Tag "$TAG_QNailEnforcer" // "Nailgun Enforcer"
	SeeSound "Quake1/Enforcer/Sight"
	PainSound "Quake1/Enforcer/Pain"
	DeathSound "Quake1/Enforcer/Death"
	ActiveSound "Quake1/Enforcer/Idle"
	Obituary "$OB_QNailEnforcer" // "%o got nailed to a wall by an Enforcer."
	DropItem "Chaingun"
	States
	{
	Idle:
		Q41I A 10 A_Look
		Loop
	See:
		Q41W AABBCCDDEEFF 2 A_Chase
		Loop
	Missile:
		Q41A ABB 5 A_FaceTarget
		Q41A A 0 A_Jump(256,"NailLooper")
	NailLooper:
		Q41A B 2 A_FaceTarget
		Q41A A 0 A_PlaySound("Quake1/Weapons/NailFire",7)
		Q41A C 2 Bright Light("PlayerFiringLight") A_CustomMissile("EnforcerNail",32,7,random(3,-3))
		Q41A D 2
		Q41A B 0 A_CPosRefire
		Loop
	Pain:
		Q41P A 8 A_Pain
		Goto See

	DeathChecksDone:
		Q41D A 0 A_Scream
		Q41D A 4
		Q41D B 4 A_Fall
		Q41D CDEFG 4
		Q41D H 4 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q41D I -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q41D HGFEDCBA 4
		Goto See
	}
}

Actor EnforcerNail : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	Speed 40
	Radius 4
	Height 8
	Damage 2
	Scale 0.40
	States
	{
	Spawn:
		NAIL A 1 Bright
		Loop
	Xdeath:	//hit flesh
		TNT1 A 5 A_PlaySound("QCDE/Other/BulletHitFlesh",CHAN_AUTO,0.75,0,4)
		Stop
	Death:
		TNT1 A 0 A_Jump(256,"Crash")
	Crash:
		DB09 A 0 A_PlaySound("Doom4/Monsters/Generic/Nailgun/Impact",CHAN_AUTO,0.6,0,1.7)
		DB09 A 0 A_SetScale(0.45)
		DB09 A 0 A_Jump(256,"T1","T2","T3","T4")

		T1:		DB09 A 0
			Goto EndDeath
		T2:		DB10 A 0
			Goto EndDeath
		T3:		DB11 A 0
			Goto EndDeath
		T4:		DB12 A 0
			Goto EndDeath

	EndDeath:
		"####" ABCDEF 1 Light("YellowSmallFlicker3") Bright
		"####" GH 1 Bright
		"####" IJKLMNOPQRST 2 Bright
		Stop
	}
}
