//================================================================
//================================================================
Actor QRocketOgre : QCDE_MonsterBig 	15112	//Archvile
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Translation "0:255=%[0.0,0.0,0.0]:[0.7,0.7,0.7]", "32:47=32:47", "176:191=176:191"
	Health 1000
	Radius 20
	Height 56
	Speed 14
	PainChance 30
	Mass 1000
	Scale 0.51
	MeleeDamage 4
	Monster
	Tag "$TAG_QRocketOgre" // "Rocket Ogre"
	SeeSound "Quake1/RocketOgre/Sight"
	PainSound "Quake1/RocketOgre/Pain"
	DeathSound "Quake1/RocketOgre/Death"
	ActiveSound "Quake1/RocketOgre/Idle"
	MeleeSound ""
	+FLOORCLIP
	+MissileMore
	+MissileEvenMore
	Obituary "$OB_QRocketOgre" // "%o was blasted by a rocket ogre."
	HitObituary "$OBH_QRocketOgre" // "%o was sawed in half by a rocket ogre."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q35I A 10 A_Look
		Loop
	See:
		Q35W ABCDEF 4 A_Chase
		Loop
	PostMelee:
		TNT1 A 0 A_ChangeFlag("NODROPOFF",0)
		Q35W AB 4 A_Chase("","")
		Goto See+2

	Melee:
		TNT1 A 0 A_ChangeFlag("NODROPOFF",1)
		Q33C A 0 A_Jump(256,"Melee1","Melee2")

		Melee1:
			TNT1 A 0 A_Recoil(-1.4)
			Q35A A 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)		TNT1 A 0 A_PlaySound("Quake1/Ogre/ChainSwing")
			Q35A B 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)		TNT1 A 0 A_FaceTarget
			Q35A CCCCC 1 A_CustomMeleeAttack(random(2,9))			TNT1 A 0 A_Recoil(-1.4)
			Q35A D 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)
			Q35A E 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)		TNT1 A 0 A_FaceTarget
			Q35A FFFFF 1 A_CustomMeleeAttack(random(2,9))			TNT1 A 0 A_Recoil(-1.4)
			Q35A G 5 A_FaceTarget
			Goto PostMelee
		Melee2:
			Q35B A 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)		TNT1 A 0 A_PlaySound("Quake1/Ogre/ChainSwing")
			Q35B B 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)
			Q35B C 5 A_FaceTarget		TNT1 A 0 A_Recoil(-1.4)
			Q35B DDDDD 1 A_CustomMeleeAttack(random(2,9))			TNT1 A 0 A_Recoil(-1.4)
			Q35B EEEEE 1 A_CustomMeleeAttack(random(2,9))
			Goto PostMelee


	Missile:
		TNT1 A 0 A_JumpIfCloser(256,"Grenade")

		Rockets:
			Q35C AAAA 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/RocketFire", 7, 0.8, 0)
			Q35C B 5 A_CustomMissile("OgreRocket",35,-5,0)
			Q35C C 5
			Q35C AA 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/RocketFire", 7, 0.8, 0)
			Q35C B 5 A_CustomMissile("OgreRocket",35,-5,0)
			Q35C C 5
			Q35C AA 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/RocketFire", 7, 0.8, 0)
			Q35C B 5 A_CustomMissile("OgreRocket",35,-5,0)
			Q35C C 5
			Goto See
		Grenade:
			TNT1 A 0 A_Jump(128,"Rockets")
			Q35C AAA 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/GrenadeFire", CHAN_WEAPON, 1.0, 0)
			Q35C B 5 A_CustomMissile("OgreGrenade",35,-5,0)
			Q35C C 5
			Q35C A 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/GrenadeFire", CHAN_WEAPON, 1.0, 0)
			Q35C B 5 A_CustomMissile("OgreGrenade",35,-5,0)
			Q35C C 5
			Q35C A 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Quake1/Weapons/GrenadeFire", CHAN_WEAPON, 1.0, 0)
			Q35C B 5 A_CustomMissile("OgreGrenade",35,-5,0)
			Q35C C 5
			Goto See

	Pain:
		Q35P A 3 A_ChangeFlag("NODROPOFF",0)
		Q35P A 3 A_Pain
		Goto See

	DeathChecksDone:
		Q35D A 0 A_Scream
		Q35D A 4
		Q35D B 4 A_Fall
		Q35D CDEF 4
		Q35D G 4 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q35D H -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q35D HGFEDCBA 5
		Goto See
	}
}
Actor OgreRocket
{
	Projectile
	+RANDOMIZE
	+DEHEXPLOSION
	+EXTREMEDEATH
	-ROCKETTRAIL
	Radius 8
	Height 8
	Speed 25
	Damage (30)	//total damage with explo is 90
	Scale 0.6
	DeathSound "QC/Weapons/RocketLauncher/RocketExplo"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Weapons/RocketLauncher/Fly",7,1,1,3)
		MICR A 2 Light("YellowMediumPoint2") Bright A_SpawnItemEx("PlayerRocketTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MICR A 0 A_SpawnItemEx("RocketTrailSmoke",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Goto Spawn+1

	Death:
		TNT1 A 0 A_Explode(60,96,1)
		TNT1 A 0 A_StopSound(7)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}
