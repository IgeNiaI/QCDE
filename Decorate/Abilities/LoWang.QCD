}
Actor PowerLoWangDamage : PowerDamage	{ DamageFactor "Normal", 1.334 }

Actor LoWangPassiveDamage : PowerupGiver
{
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	+SERVERNETID
	Inventory.MaxAmount 0
	powerup.Type "LoWangDamage"
	powerup.color "Red", 0.1
	powerup.duration 9999 // actually 50, removed by ACS
}
