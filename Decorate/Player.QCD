Actor QCBrock : QCPlayerHeavy
{
	Player.DisplayName "Brock"
	Player.SoundClass "Brock"
	Player.Palette "PL33"

	Scale 0.56

	Player.FootstepInterval 13
	Player.FootstepVolume 0.75

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor50"

