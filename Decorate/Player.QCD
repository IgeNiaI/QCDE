			Loop
		DefSpawn:
			QP05 A 0 A_JumpIf(momx||momy,"DefSee")
			QP05 G 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP05 ABCDEF 3
			RP05 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP05 ABCDEF 3
			QP05 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" G 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP05 G 12
			RP05 G 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP05 G 12
			QP05 G 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" H 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP05 H 6 BRIGHT Light("PlayerFiringLight")
			RP05 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP05 H 6 BRIGHT Light("PlayerFiringLight")
			QP05 H 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" I 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP05 I 4
			RP05 I 4 A_Pain
			RP05 I 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP05 I 4
			QP05 I 4 A_Pain
			QP05 I 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP05 J 6
		QP05 K 6 A_PlayerScream
		QP05 L 6 A_NoBlocking
		QP05 MNO 6
		QP05 P -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP05 J 6 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,1.0,false,1.2)
		QP05 K 6 //A_XScream
		QP05 L 6 A_NoBlocking
		QP05 MNO 6
		QP05 P -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}




