//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor DireOrb : TeleportDest3
{
	var int user_x;
	var int user_ceilingz;
	var int user_z;
	var int user_limit;
	var int user_timer;
	+NOBLOCKMAP
	+DONTSPLASH
	-NOSECTOR
	+NOGRAVITY
	+FORCEXYBILLBOARD
	+SKYEXPLODE
	+RIPPER
	+BLOODLESSIMPACT
	+DONTBLAST
	Radius 16
	Height 10
	Speed 25
	Projectile
	Scale 0.32
	Alpha 0.7
	Damage (random(4,8)*10)
	DamageType "DireOrb"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY ACS_NamedExecuteAlways("QCDE_DireOrbThrown")
		TNT1 A 0 A_AlertMonsters(128)
		TNT1 A 0 A_SetUserVar(user_timer,7)
		Goto LoopFlying
	LoopFlying:
		DIRE ABCDEFGH 2 Bright Light("BlueMediumFlicker3") A_SpawnItemEx("DireOrbTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop
	Death:
		TNT1 A 0 A_GiveToTarget("DireOrbWallSoundProc",1)
		TNT1 A 0 A_PlaySound("QC/Abilities/Ranger/BallExplode",CHAN_AUTO,1,0,0.6)
		DIRE ABCDEFGHABCDEFG 2 Bright Light("BlueMediumFlicker3")
	RemoveMe:
		TNT1 A 0 A_SpawnItemEx("DireOrbTeleFog",0,0,8, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CustomMissile("DireOrbExploder",0,0,0,CMF_TRACKOWNER)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DireOrbTimedOut")
		TNT1 A 2 Light("BlueMediumPoint2")
		TNT1 A 2 Light("BlueMediumPoint1")
		TNT1 A 2 Light("BlueMediumPoint2")
		TNT1 A 2 Light("BlueMediumPoint3")
		TNT1 A 2 Light("BlueSmallPoint1")
		TNT1 A 2 Light("BlueSmallPoint2")
		TNT1 A 2 Light("BlueSmallPoint3")
		TNT1 A 21
		Stop
	}
}

Actor DireOrbDM : DireOrb
{
	Damage (30)
	-DONTBLAST
}

Actor DireOrbTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[0.5,0.5,1.5]"
	Scale 0.35
	Alpha 0.45
	States
	{
	Spawn:
		DIRE A 0 NODELAY A_SetScale(frandom(0.2,0.5))
		DIRE ABCDEFGH 2 A_FadeOut(0.05)
		Stop
	}
}


Actor DireOrbFireProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/Ranger/BallThrow",CHAN_BODY)
		TNT1 A 0 A_GiveInventory("TeleporterThrownToken")
		TNT1 A 0 A_GiveInventory("ActiveInProgress")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)==2,"FireDMOrb")
		TNT1 A 0 A_FireCustomMissile ("DireOrb",0, false)
		Stop
	FireDMOrb:
		TNT1 A 0 A_FireCustomMissile ("DireOrbDM",0, false)
		Stop
	}
}


//Plays click sound on player UI when hits a wall
Actor DireOrbWallSoundProc : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	RenderStyle None
	States
	{
	Spawn:
		MEGA A 6
		Loop
	Pickup:
		TNT1 A 0 A_PlaySound("QC/Abilities/Ranger/BallAttach",CHAN_BODY|CHAN_UI,0.85,0,140)
		Stop
	}
}


Actor TeleporterThrownToken : Token {}


Actor DireOrbTeleProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("White", 1.0, 5)
		TNT1 A 0 A_SetBlend("Black", 0.7, 30)
		TNT1 A 0 A_GiveInventory("ActiveInProgress")
		TNT1 A 0 A_SpawnItemEx("DireOrbTeleFog",0,0,30, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DireOrbUsed")
		TNT1 A 35 A_TakeInventory("TeleporterThrownToken")
		Stop
	}
}

Actor TeleporterSounder
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Abilities/Ranger/BallTeleport",1,1.0,false,0.6)
		TNT1 A 25 A_AlertMonsters(512)
		Stop
	}
}


//-------------------------------------------
// Fog spawner for destination, also explodes
Actor DireOrbTeleFogOutProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_SpawnItemEx("DireOrbTeleFogOut",0,0,28,0,0,0,0,32)
		TNT1 A 0 A_AlertMonsters(512)
		Stop
	}
}

//	Explosion after player teleports, doesnt hurt self.
Actor DireOrbExploder
{
	Projectile
	RenderStyle NONE
	+THRUACTORS
	Speed 0
	scale 0.2
	Obituary "$OB_DireOrbExploder" // "%o was too close to %k's dire orb."
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0)==2,"DMdmg")
		TNT1 A 10 A_Explode(300,256,0,0,192)
		Stop
	DMdmg:
		TNT1 A 10 A_Explode(100,80,0,0,40)
		Stop
	}
}

//Fog that stays behind when teleporting
Actor DireOrbTeleFog
{
	RenderStyle NONE
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 AAAAAAAA 0 A_SpawnItemEx("DireOrbTeleParticle",0,0,0, frandom(0.4,2),frandom(0.4,2),frandom(-2,2), random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop
	}
}

//fog smoke particle
Actor DireOrbTeleParticle
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[0.5,0.5,1.5]"
	Scale 0.2
	States
	{
	Spawn:
		X110 A 2 Bright A_FadeOut(0.05)
		X110 A 0 A_SetScale(scalex+0.1)
		Loop
	}
}

//Fog for destination, plays teleport sound
Actor DireOrbTeleFogOut : DireOrbTeleFog
{
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Abilities/Ranger/BallTeleport",CHAN_BODY)
		goto Super::Spawn
	}
}


