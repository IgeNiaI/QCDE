Actor TitlemapFlaresSpawner 31002
{
	//$NotAngled
	//$Category "QCDE Map Decoration"
	//$Color 15
	//$Title "Titlemap flare spawner"
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(CallACS("QCDE_GetDate") == 1402, "Hearts")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_GetDate") == 2512, "Flakes")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_GetDate") ==  101, "Flakes")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_GetDate") == 1301, "Flakes")
		TNT1 A 8 A_SpawnItemEx("TitlemapFlares",0,random(300,-300),0,  0,random(3,15),random(4,15), 0,0,96)
		Wait
	Hearts:		TNT1 A 7 A_SpawnItemEx("TitlemapHearts",0,random(300,-300),   0, 0,random(3,15),random( 4, 15), 0,0, 96)	Wait
	Flakes:		TNT1 A 7 A_SpawnItemEx("TitlemapFlakes",0,random(300,-300),1500, 0,random(3,15),random(-4,-15), 0,0, 96)	Wait
	}
}
Actor TitlemapFlares
{
	+NOINTERACTION
	RenderStyle Add
	Scale 0.35
	States
	{
	Spawn:
		TNT1 A 0 NODELAY
	Looper:
		X029 A 0 A_JumpIf(random(1,10)==1,"DoVel")
		X029 A 3 Bright A_FadeOut(0.01)
		Loop

		DoVel:
			X029 A 0 Bright A_ChangeVelocity(0,random(3,-3),0)
			Goto Looper+1
	}
}
Actor TitlemapHearts : TitlemapFlares
{
	Scale 0.2
	States
	{
	Spawn:
		TNT1 A 0 NODELAY
	Looper:
		X029 L 0 A_JumpIf(random(1,10)==1,"DoVel")
		X029 L 3 Bright A_FadeOut(0.01)
		Loop

		DoVel:
			X029 L 0 Bright A_ChangeVelocity(0,random(3,-3),0)
			Goto Looper+1
	}
}
Actor TitlemapFlakes : TitlemapHearts
{
	Scale 0.24
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SetScale(frandom(0.2,0.6))
	Looper:
		X029 M 0 A_Weave(1,1, 3.0,2.0)
		X029 M 1 Bright A_FadeOut(0.003)
		Loop
	}
}

Actor TitlemapGlow 31003
{
	//$NotAngled
	//$Category "QCDE Map Decoration"
	//$Color 15
	//$Title "Titlemap glow"
	+NOINTERACTION
	Scale 8.0
	RenderStyle Add
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(CallACS("QCDE_GetDate") == 2512, "Flakes")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_GetDate") ==  101, "Flakes")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_GetDate") == 1301, "Flakes")
		FX01 F -1 BRIGHT
		Loop
	Flakes:
		FX01 G -1 BRIGHT
		Stop
	}
}


Actor TestThing
{
	+NOINTERACTION
	Scale 10.0
	States
	{
	Spawn:
		PLAY A 10 Bright
		Loop
	}
}


//-----------------------------------------------------------------
// For QCDE base maps, colored smoke marking weapon spawn points
//-----------------------------------------------------------------
Actor WeaponSpawnPointBase
{
	//+NOINTERACTION
	RenderStyle Add
	Alpha 0.8
	Scale 0.52
	Radius 8
	States
	{
	Spawn:
		TNT1 A 0 NODELAY
		Goto Idle
	Idle:
		X108 ABCDEFGHIJKLMNOPQRSTUVWX 2 Bright
		Loop
	}
}


