//=====================================================================================
Actor Q4Roller : QCDE_MonsterBig	15317	//Fatso
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	var int user_counter;
	Health 600
	Monster
	Radius 48
	Height 64
	Mass 1000
	+NOBLOOD
	PainChance 0
	Speed 10
	Scale 1.2
	+FLOORCLIP
	SeeSound "quake4/Roller/Sight"
	Damage 1
	MinMissileChance 200
	Obituary "$OB_Q4Roller" // "%o was gunned down recklessly by a Strogg roller."
	Tag "$TAG_Q4Roller" // "Roller"
	States
	{
	Idle:
		TNT1 A 0 A_StopSound(5) //to stop sound after target is killed and this actor go back to this state
		Q03A B 4 A_Look
		Wait
	See:
		Q03A A 3 A_PlaySound("quake4/Roller/Close",4)
		TNT1 A 0 A_PlaySound("quake4/Roller/WalkLoop",5,0.8,1,2.5)
		Goto SeeLoop
	SeeLoop:
		Q03W AABBCCDDEEFF 2 A_Chase
		Loop

	Missile:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SetUserVar(user_counter,0)
		TNT1 A 0 A_FaceTarget
		TNT1 a 0 A_PlaySound("quake4/Roller/Open",5)
		Q03A ABCDDD 4
	MissileLooper:
		TNT1 A 0 A_JumpIf(user_counter>=10,"EndMissile")
		Q03A D 0 A_FaceTarget
		Q03A D 0 A_Playsound("QC/Abilities/Terminator/FireMissile",CHAN_AUTO,0.7)
		Q03A D 4 A_CustomMissile("RollerMicroMissile",58,-40,0)
		Q03A D 0 A_Playsound("QC/Abilities/Terminator/FireMissile",CHAN_AUTO,0.7)
		Q03A D 4 A_CustomMissile("RollerMicroMissile",58,40,0)
		TNT1 A 0 A_SetUserVar(user_counter,user_counter+1)
		Loop
	EndMissile:
		TNT1 a 0 A_PlaySound("quake4/Roller/Close",5)
		Q03A CBA 3
		TNT1 A 0 A_PlaySound("quake4/Roller/WalkLoop",5,0.8,1,2.5)
		Goto SeeLoop

	XDeathChecksDone:
	DeathChecksDone:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_PlaySound("quake4/Misc/Explo",6)
		TNT1 AAAAAAAAAA 0 A_TossGib
		TNT1 A 0 A_Fall
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosionBigger",0,0,30,0,0,0,0,SXF_NOCHECKPOSITION)
	Death.Corpse:
		TNT1 A 10
		Stop
	}
}

Actor RollerMicroMissile
{
	Projectile
	Speed 22
	+SEEKERMISSILE
	+FORCERADIUSDMG
	Damage (0)
	Scale 0.55
	Radius 3
	Height 6
	SeeSound "QC/Abilities/Terminator/MissileWhoosh"
	States
	{
	Spawn:
		MISX A 0 Bright A_SeekerMissile(2,2,SMF_LOOK|SMF_PRECISE)
		MISX A 2 Bright A_SpawnItemEx("TriboltTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MISX A 0 Bright A_SeekerMissile(2,2,SMF_LOOK|SMF_PRECISE)
		MISX A 2 Bright
		MISX B 0 Bright A_SeekerMissile(2,2,SMF_LOOK|SMF_PRECISE)
		MISX B 2 Bright A_SpawnItemEx("TriboltTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MISX B 0 Bright A_SeekerMissile(2,2,SMF_LOOK|SMF_PRECISE)
		MISX B 2 Bright
		Loop
	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/MissileExplo",CHAN_AUTO,1,0,0.8)
 		TNT1 A 0 A_Explode(10,64,0,1,64)
		TNT1 A 0 A_SpawnItemEx("RollerMicroMissileExplo",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop

	}
}
Actor RollerMicroMissileExplo
{
	+FORCEXYBILLBOARD
	+NOINTERACTION
	+CLIENTSIDEONLY
	Scale 0.5
	RenderStyle Add
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(0.6,1.0))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		X002 A 0
		Goto PlayOff
	Type2:
		X001 A 0
		Goto PlayOff
	PlayOff:
		"####" ABC 1 Bright Light("YellowSmallFlicker2")
		"####" EFG 1 Bright Light("YellowSmallFlicker1")
		"####" HIJ 1 Bright Light("YellowMediumFlicker3")
		"####" KLM 1 Bright Light("YellowMediumFlicker2")
		"####" NOP 1 Bright Light("YellowMediumFlicker3")
		"####" QRS 1 Bright Light("YellowSmallFlicker1")
		"####" TU 1 Bright Light("YellowSmallFlicker2")
		Stop
	}
}