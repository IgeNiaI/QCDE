

// Running multiple QCDE copies crashes engine during CVARINFO parsing stage.
// Example:  zandronum  -file qcdev3.0.pk3 qcdev3.0.pk3
// This cvar has a very descriptive name for when error would spew it out.
// It's set to 3 just to make a big-eyed cat face =3

server noarchive int _PLEASE_DOUBLE_CHECK_THAT_YOURE_LOADING_QCDE_ONLY_ONCE_  =3 ;

// Server settings

server noarchive int bot_weaponize          =   3; // give weapons on respawn, [0..5]
server noarchive int bot_buff               =   1; // give health randomly, [0..5]
server noarchive int bot_twitch             = 100; // twitchiness percentage, [0..200]
server           int sv_playerSpeed         =   0; // percentage, [70..130] in steps of 5
server           int sv_showDamageNumbers   =   1; // visual representation of damage
server           int sv_QCDEPowerups        =   1; // spawn powerup factory?
server           int sv_QCDEBFG		        =   1; // spawn BFG?
server noarchive int sv_cooldownPercentage  = 100; // multiplies active ability cooldown
server           int sv_minPlayers          =   0; // fills slots with bots if there are fewer players
server           int sv_shuffleBots         =   2; // replace bots on map transition, 0: none, 1: all, 2: one
server           int sv_coopBossScalar      =   1; // scale boss health to coop player count
server           int sv_pistolStart         =   0; // reset inventory on every map
server           int sv_crowntheleader      =   1; // crown that marks best fragger in deathmatch
server           int sv_pvescaledamage      =   1; // reduce damage to squishies, increase to tanks in coop
server           int sv_weaponrespawn       =   0; // weapon respawn time
server           bool sv_showStackLeft      =   false; // show enemy's health and armor on death
server           bool sv_showItemTimers     =   false; // show Heavy, Mega, MegaMega, Light Armor and Powerup respawn timers

// Game modes

server noarchive int rocketarena            = 0; // 1: RL, 2: SSG, 3: Unholy Trinity, other: bitfield (1110000 is UT)
server noarchive int qc_elderssoul          = 0; // QCDE's own "terminator" gameplay mode, allowing team play
server noarchive int qc_freezetag           = 0; // Freeze enemies instead of kill, thaw allies with body heat

// Mutators

server noarchive bool sv_railjump			=  false; // Replaces Railgun zoom with an attack that pushes the player backwards

// QCS

server noarchive string qcs        = "";
server noarchive string qcs_status = "";


// Client settings

user bool cl_showWeaponBar   =  true; // vertical list of items on the right
user bool cl_allyMarkers     =  true; // player-colored triangle shown above players in cooperative
user bool cl_weaponrecoil    =  true; // do weapons have visual recoil when firing?
user bool cl_weaponfireflash =  true; // do weapons create a HUD flash effect when firing
user bool cl_lgtransparency  = false; // false: beam visible, true: beam invisible
user int  cl_hiteffect         =   2; // audial and visual feedback about hitting targets
user int  cl_speedometer       =   0; // small counter showing current speed in mu/sec under crosshair or under champion avatar
user int  cl_lowAmmoWarning    =   2; // 1: sound only, 2: sound and text, 3: sound and text stays
user int  cl_lowHealthWarning  =   1; // 1: sound only, 2: sound and text, 3: sound and text stays
user int  cl_autoTaunt         =   5; // chance to taunt on kill, [0..10]
user int  cl_tauntSubtitles    =   1; // 0: never, 1: solo, 2: PvE, 3: always
user int  cl_autoOpenLootboxes =   0; // open lootboxes immediately
user int  cl_ShowHUDBloodSmears=   1; // Show HUD blood smears
user int  cl_startingWeapon    =   1; // 1 = MG, 2 = SG, 3 = NG
user int  cl_specScores        =   3; // how many scores to show when spectating
user int  cl_autoSpecDelay     =   0; // if non-zero: seconds to spectate each player automatically
user int  cl_radarMode         =   0; // 0 = center, 1 = lower
user int  cl_barStyle          =   0; // 0 = blocks of 25, 1 = continuous
user int  cl_qcmedals          =   1; // 0 = off, 1 = full, 2 = sound only
user int snd_randommus         =   1; // play QCDE OST in random order. Desyncs in MP.
user int _previousSong         =  -1; // used internally for snd_randommus

// Client zoom settings

user bool  cl_holdZoom   	=  true; // hold or toggle zoom
user float cl_railgunZoom	=  2.5; // how much to zoom the railgun
user float cl_hmgZoom		=  1.8; // how much to zoom the heavy machinegun
user float cl_lgZoom		=  1.8; // how much to zoom lightning gun
user float cl_otherZoom		=  1.8; // how much to zoom all other weapons

// Client weapon skins

user int cl_GNTLskin	= 0;
user int cl_MGskin		= 0;
user int cl_HMGskin		= 0;
user int cl_SGskin		= 0;
user int cl_SSGskin		= 0;
user int cl_NGskin		= 0;
user int cl_SNGskin		= 0;
user int cl_TBskin		= 0;
user int cl_RLskin		= 0;
user int cl_LGskin		= 0;
user int cl_RGskin		= 0;
user int cl_BFGskin		= 0;

// Theme settings

server int qc_themedebug = 0;    // show debugging messages when loading
server int qc_shuffleMode = 1;   // 0 = full shuffle, 1 = one theme per map
server noarchive int qc_skirmishRogue = 0; // 1 = also randomize monster classes and item pickups

server int theme0  = 1; // Quake 1
server int theme1  = 1; // Quake 2
server int theme2  = 1; // Quake 4
server int theme3  = 0; // Doom
server int theme4  = 1; // Doom 4 (Death Foretold)

// Menu settings
server noarchive int qcde_selectedoptions  = 0; // which options menu is currently visible

server int skirm_botscount        = 0; // fills slots with bots if there are fewer players
server int skirm_skirmishgamemode = 3; // used in skirmish menu to setup gamemode
server int skirm_skirmishmodifier = 0; // used in skirmish menu to setup modifier
server int skirm_maxlives         = 3; // used in skirmish menu to setup lives limit

server bool skirm_railjump			= false; // enable alt fire rail jump?
server bool skirm_heavymachinegun	=  true; // spawn with Heavy Machinegun?
server bool skirm_supershotgun		=  true; // spawn with Super Shotgun?
server bool skirm_supernailgun		=  true; // spawn with Super Nailgun?
server bool skirm_tribolt			=  true; // spawn with Tribolt?
server bool skirm_rocketlauncher	=  true; // spawn with Rocket Launcher?
server bool skirm_lightninggun		=  true; // spawn with Lightning Gun?
server bool skirm_railgun			=  true; // spawn with Railgun?
server bool skirm_bfg				=  true; // spawn with BFG?

// User-supplied

user noarchive string themename5  =  "  - No custom themes loaded! - ";
