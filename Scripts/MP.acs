//*****************************************************************************
//*****************************************************************************
// This script is called by items to know what kind the game is.
//
//	Game types:
//	 0 	Single player
//	 1 	Cooperative
//	 2 	Deathmatch
//	 3 	Title map
//	 4 	(Skull/dronum) Team game
//*****************************************************************************
//*****************************************************************************


Script "MultiplayerCheck" (void)
{
	if(GameType() == 4)
		SetResultValue(2); // team games have same weapons as DM
	else
		SetResultValue(GameType());
}

int weaponStay;
Script "WeaponStayCheck" (void)
{
	SetResultValue(weaponStay);
}

int instagib=-1, rocketarena=-1;
Script "InstagibCheck" (int withoutrocketarena)
{
	if(withoutrocketarena)
		SetResultValue(instagib && !rocketarena);
	else
		SetResultValue(instagib);
}

Script "QCDE_DespawnIfInstagib" (void)
{
	if(instagib == -1 && rocketarena == -1) // not loaded yet
	{
		instagib    = GetCvar("instagib");
		rocketarena = GetCvar("rocketarena");
	}

	if(instagib || rocketarena) Thing_Remove(0);
}

Script "CvarTrack" OPEN
{
	instagib    = GetCvar("instagib");
	rocketarena = GetCvar("rocketarena");
	while(true)
	{
		delay(35);
		weaponStay = GetCvar("sv_weaponStay");
	}
}

Script "iamamiwhoami" (void)
{
	str iam = strparam(n:0);
	int iam_ = ActivatorTid();

	int owner = GetActorProperty(0, APROP_MasterTID);

	SetActivatorToTarget(0);

	str Amy = strparam(n:0);
	int Amy_ = ActivatorTid();

	str ownerinfo = ".";
	if(owner)
	{
		SetActivator(owner);
		ownerinfo = strparam(s:", owned by ", n:0, s:" tid ", d:owner);
	}

	printbold(s:"I am ", s:iam, s:" tid ", d:iam_,
	   s:", targeting ", s:Amy, s:" tid ", d:Amy_, s:ownerinfo);
}



Script "QCDE_DM_HealthAndWeapons" (void)
{
	if (GameType() < GAME_NET_DEATHMATCH) terminate; // only if game is DM

	str unused = ""; // beats "DMToken" in case of broken string table
	GiveInventory("DMToken", 1);
}


Script "QCDE_StoreTeam" (void)
{
	if(CheckInventory("TeamDeathmatch")) // Team color
	{
		SetInventory("TeamColor", GetPlayerInfo(PlayerNumber(), PLAYERINFO_TEAM) + 1);
	}
	else if(GameType() >= GAME_NET_DEATHMATCH) // Red outlines in non-team PvP
	{
		SetInventory("TeamColor", 2);
	}
}


int lastTime = -999999;
Script "QCDE_FirstInSeconds" (int secs)
{
	SetResultValue(false);
	if (Timer() > lastTime + secs*35)
	{
		SetResultValue(true);
		lastTime = Timer();
	}
}


str keys[NUMBER_OF_KEYS][3] = {
	{"RedCard",     "Red Card",     false},
	{"YellowCard",  "Yellow Card",  false},
	{"BlueCard",    "Blue Card",    false},
	{"RedSkull",    "Red Skull",    false},
	{"YellowSkull", "Yellow Skull", false},
	{"BlueSkull",   "Blue Skull",   false},
};
Script "QCDE_RegiveKeys" (void)
{
	for(int i = 0; i < NUMBER_OF_KEYS; i++)
		if(keys[i][2] == true)
			GiveInventory(keys[i][0], 1);
}
Script "QCDE_GiveKey" (int which)
{
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	if(which < 0 || which --> NUMBER_OF_KEYS)
		log(s:"\c[yellow]QCDE warning: attempt to give key number ", d:-~which);

	GiveInventory(keys[which][0], 1);

	// Give to all players -- shared keys are the norm, not a quirky option
	GiveActorInventory(0, keys[which][0], 1);
	if(keys[which][2] != true)
	{
		ACS("QCDE_PickupMessage", which);
		keys[which][2] = true;
	}
}
Script "QCDE_PickupMessage" (int what) CLIENTSIDE
{
	str pickupmessage = strparam(n:0, s:" picked up a ", s:keys[what][1], s:".");
	Log(s:pickupmessage);
}



// Kill in coop if changed class mid-game, because otherwise on map change
// client and server start disagreeing over class.

Script "QCDE_SendKey" ENTER
{
	while(true)
	{
		if(!secretkey) secretkey = random(1, 12345);

		ACS_NamedExecuteAlways("QCDE_ReceiveKey", 0, secretkey);

		delay(random(35,70));
	}
}

Script "QCDE_ReceiveKey" (int data) CLIENTSIDE
{
	secretkey = data;
}

Script "QCDE_ClassCheck_ENTER" ENTER CLIENTSIDE
{
	// Spectators: Please don't
	if(PlayerIsSpectator(PlayerNumber())) terminate;

	// Only care about yourself
	if(CPN() != PlayerNumber()) terminate;

	int mustbe1 =
		CheckInventory("Class_Ranger"		) +
		CheckInventory("Class_Doomslayer"	) +
		CheckInventory("Class_Corvus"		) +
		CheckInventory("Class_Kane"			) +
		CheckInventory("Class_Caleb"		) +
		CheckInventory("Class_Menelkir"		) +
		CheckInventory("Class_Terminator"	) +
		CheckInventory("Class_Zedek"		) +
		CheckInventory("Class_Inquisitor"	) +
		CheckInventory("Class_Bitterman"	) +
		CheckInventory("Class_Galen"		) +
		CheckInventory("Class_Nyx"			) +
		CheckInventory("Class_Sorgaul"		) +
		CheckInventory("Class_DukeNukem"	) +
		CheckInventory("Class_Durandal"		) +
		CheckInventory("Class_Keel"			) +
		CheckInventory("Class_Sarge"		) +
		CheckInventory("Class_LoWang"		) +
		CheckInventory("Class_Grayson"		) +
		CheckInventory("Class_Eradicator"	) +
		CheckInventory("Class_Blazkowicz"	) +
		CheckInventory("Class_Freeman"		) +
		CheckInventory("Class_VorMatur"		) +
		CheckInventory("Class_Eleena"		) +
		CheckInventory("Class_Lucienne"		) +
		CheckInventory("Class_Major"		) +
		CheckInventory("Class_Hunter"		) +
		CheckInventory("Class_Sam"			) +
		CheckInventory("Class_Postal"		) +
		CheckInventory("Class_Painkiller"	) +
		CheckInventory("Class_Intruder"		) +
		CheckInventory("Class_Orbb"			);
	// ^ insert more classes here

	if(mustbe1 > 1)
		while(!NamedRequestScriptPuke("QCDE_KMP", GetCvar("playerclass"), secretkey));
}

Script "QCDE_KMP" (int to, int security) NET
{
	int plr = PlayerNumber();

	if(security == secretkey)
		if(!SetPlayerLivesLeft(plr, GetPlayerLivesLeft(plr) + 1))
			log(s:"\c[red]QCDE ERROR: Failed to reimburse life to player ", n:0, s:" \c[red]killed by class switch.");

	DamageThing(0,0);
	ACS_NamedExecuteAlways("QCDE_ChangeClass_Hint", 0, to);
}



// Activator: Player
script "QCDE_InitLMS" (void)
{
	if(!(GetCvar("lastmanstanding") || GetCvar("teamlms"))) terminate;

	GiveInventory("QCMegaMega", 1);
	GiveInventory("QCMegaMega", 1);
}



// Activator: Player
script "QCDE_UpdateLives" (void)
{
	if(!(
		getcvar("lastmanstanding") ||
		getcvar("teamlms") ||
		getcvar("survival") ||
		(getcvar("invasion") && getcvar("sv_maxlives") > 0)
	)) terminate;

	SetInventory("LifeToken", GetPlayerLivesLeft(PlayerNumber()) + 1);
}

script "AddLives" (int how_many, int plr)
{
	int a = 0, b = 63;
	if(plr) { a = plr; b = plr; }
	if(!how_many) { how_many = 1; }
	for(int i = a; i <= b; i++)
	{
		SetActivatorToPlayer(i);
		SetPlayerLivesLeft(i, GetPlayerLivesLeft(i) + how_many);
		ACS("QCDE_UpdateLives");
	}
}

// Activator: Player
script "QCDE_ReduceLife" DEATH
{
	if(!(getcvar("lastmanstanding") || getcvar("teamlms") || getcvar("survival"))) terminate;

	TakeInventory("LifeToken", 1);
}



Script "QCDE_UndropDuringInit" (void)
{
	if(Timer()) terminate;

	GiveInventory("UndroppedProc", 1);
}



Script "QCDE_DM_PlayerCollision" (void)
{
	if (GameType() < GAME_NET_DEATHMATCH) terminate; // only if game is DM

	GiveInventory("EnablePlayerCollisionProc", 1);
}



Script "QCDE_DM_ReplaceWeapons" (void)
{
	if (GameType() < GAME_NET_DEATHMATCH) terminate; // only if game is DM

	if(CheckInventory("QCMachinegun"		)) 	{ TakeInventory("QCMachinegun"		,1);	QCDE_Store("QCBulletAmmo");	GiveInventory("QCMachinegunDM"		,1); QCDE_Restore("QCBulletAmmo");	}
	if(CheckInventory("QCShotgun"			)) 	{ TakeInventory("QCShotgun"			,1);	QCDE_Store("QCShellAmmo");	GiveInventory("QCShotgunDM"			,1); QCDE_Restore("QCShellAmmo"	);	}
	if(CheckInventory("QCNailgun"			)) 	{ TakeInventory("QCNailgun"			,1);	QCDE_Store("QCNailAmmo"	);	GiveInventory("QCNailgunDM"			,1); QCDE_Restore("QCNailAmmo"	);	}
	if(CheckInventory("QCHeavyMachinegun"	)) 	{ TakeInventory("QCHeavyMachinegun"	,1);	QCDE_Store("QCBulletAmmo");	GiveInventory("QCHeavyMachinegunDM"	,1); QCDE_Restore("QCBulletAmmo");	}
	if(CheckInventory("QCSuperShotgun"		)) 	{ TakeInventory("QCSuperShotgun"	,1);	QCDE_Store("QCShellAmmo");	GiveInventory("QCSuperShotgunDM"	,1); QCDE_Restore("QCShellAmmo"	);	}
	if(CheckInventory("QCSuperNailgun"		)) 	{ TakeInventory("QCSuperNailgun"	,1);	QCDE_Store("QCNailAmmo"	);	GiveInventory("QCSuperNailgunDM"	,1); QCDE_Restore("QCNailAmmo"	);	}
	if(CheckInventory("QCTribolt"			))	{ TakeInventory("QCTribolt"			,1);	QCDE_Store("QCBoltAmmo"	);	GiveInventory("QCTriboltDM"			,1); QCDE_Restore("QCBoltAmmo"	);	}
	if(CheckInventory("QCRocketLauncher"	))	{ TakeInventory("QCRocketLauncher"	,1);	QCDE_Store("QCRocketAmmo");	GiveInventory("QCRocketLauncherDM"	,1); QCDE_Restore("QCRocketAmmo");	}
	if(CheckInventory("QCLightningGun"		)) 	{ TakeInventory("QCLightningGun"	,1);	QCDE_Store("QCCoilAmmo"	);	GiveInventory("QCLightningGunDM"	,1); QCDE_Restore("QCCoilAmmo"	);	}
	if(CheckInventory("QCRailgun"			)) 	{ TakeInventory("QCRailgun"			,1);	QCDE_Store("QCSlugAmmo"	);	GiveInventory("QCRailgunDM"			,1); QCDE_Restore("QCSlugAmmo"	);	}
	if(CheckInventory("QCBFG"				)) 	{ TakeInventory("QCBFG"				,1);	QCDE_Store("QCBFGAmmo"	);	GiveInventory("QCBFGDM"				,1); QCDE_Restore("QCBFGAmmo"	);	}
}
int store;
function void QCDE_Store(str what)
{
	store = CheckInventory(what);
}
function void QCDE_Restore(str what)
{
	SetInventory(what,store);
}


