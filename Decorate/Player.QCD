Actor TerminatorArm
{
	+CLIENTSIDEONLY
	+SERVERNETID
	-NOLIFTDROP
	-SOLID
	+DROPOFF
	+NOTELEPORT
	+CORPSE
	Scale 1.025
	Radius 6
	Height 5
	States
	{
	Spawn:
		QP07 WXY 6
		Wait
	Crash:
		WP07 Z 3
		"####" "#" 175 //5sec
		"####" "#" 1 A_FadeOut
		Wait
	}
}


