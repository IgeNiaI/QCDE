	ReadyZoomedCont:
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"ReadyZoomedDM")
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"Ready")
		TNT1 A 0 A_JumpIfInventory("RailgunCharges",52,"ReadyZoomedCharged")
		TNT1 A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
		TNT1 A 0 A_GiveInventory("RailgunCharges",1)
		Loop

	ReadyZoomedCharged:
		"####" "#" 0 A_JumpIfInventory("QCRailgunSkin", 20, "ChargeSound.Modded")
		TNT1 A 0 A_PlaySound("QC/Weapons/Railgun/ChargeFull", CHAN_5, 1.0, 0, 15) //only you hear it
		Goto ChargeSoundCont
	ChargeSound.Modded:
		TNT1 A 0 A_PlaySound("QC/Weapons/Railgun/ChargeFull_Modded", CHAN_5, 1.0, 0, 15) //only you hear it
	ChargeSoundCont:
	ReadyZoomedChargedLoop:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"Ready")
		TNT1 A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
		Loop

	ReadyZoomedDM:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"Ready")
		TNT1 A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
		Loop


		ReadyCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
			"####" A 0 A_TakeInventory("RailgunCharges",32767)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FireZoomed")

		TNT1 A 0 A_JumpIfInventory("RG_UG_Explosive",1,"Fire.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "Fire.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "Fire.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "Fire.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "Fire.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "Fire.Quake1")
	Fire.Default:
		QCE7 A 0
		Goto RegularFireSequence
	Fire.Quake1:
		Q1E7 A 0
		Goto RegularFireSequence
	Fire.Quake2:
		Q2E7 A 0
		Goto RegularFireSequence
	Fire.Quake3:
		Q3E7 A 0
		Goto RegularFireSequence
	Fire.Quake4:
		Q4E7 A 0
		Goto RegularFireSequence
	Fire.ETQW:
		QWE7 A 0
		Goto RegularFireSequence
	Fire.QCDE1:
		Q0E7 A 0
		Goto RegularFireSequence
	Fire.HalfLife:
		HLE7 A 0
		Goto RegularFireSequence
	Fire.SeriousSam:
		SSE7 A 0
		Goto RegularFireSequence
	Fire.Modded:
		MDE7 A 0
		Goto RegularFireSequence

	Fire.Upgraded:
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "Fire.Upgraded.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "Fire.Upgraded.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "Fire.Upgraded.HalfLife")
