//======================================================================================
//
//		18. Lo Wang, he whom you no mess with
//
//======================================================================================
Actor QCLoWang : QCPlayerLight
{
	Player.DisplayName "Lo Wang"
	Player.SoundClass "LoWang"
	Player.Palette "PL18"

	Scale 0.53

	Player.FootstepInterval 10
	Player.FootstepVolume 0.546875

	Player.MaxHealth 100
	Health 100
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 100
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_LoWang"
	Player.StartItem "Body_Small"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"


	States
	{
	Spawn:
		QP18 C 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP18 C 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP18 C 0 A_JumpIf(true,                   "DefSpawn")
		QP18 C 100
		Loop

		ColoredSpawn:
			RP18 C 0 A_JumpIf(momx||momy,"ColoredSee")
			RP18 C 4 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			Loop
		DefSpawn:
			QP18 C 0 A_JumpIf(momx||momy,"DefSee")
			QP18 C 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP18 ABCD 4 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP18 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP18 ABCD 4 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP18 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP18 EEEE 3 A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo")
			RP18 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP18 EEEE 3 A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP18 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP18 FF 3 BRIGHT Light("PlayerFiringLight") //A_JumpIfInventory("ThirdPersonPunch",1,"ColoredPuncheroo") //had to remove or it gets weird with quick fire weapons
			RP18 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP18 FF 3 BRIGHT Light("PlayerFiringLight") //A_JumpIfInventory("ThirdPersonPunch",1,"DefPuncheroo")
			QP18 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

		ColoredPuncheroo:
			RP18 GHIGHI 3
			RP18 K 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPuncheroo:
			QP18 GHIGHI 3
			QP18 K 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" B 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP18 B 4
			RP18 B 4 A_Pain
			RP18 B 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP18 B 4
			QP18 B 4 A_Pain
			QP18 B 4 A_JumpIf(true, "SpawnLoop")
			Loop
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP18 J 5 A_PlayerScream
		QP18 K 5 A_NoBlocking
		QP18 LMNOPQ 5
		QP18 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		TNT1 A 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP18 J 4 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP18 K 5 A_NoBlocking
		QP18 LMNOPQ 5
		QP18 R -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}




