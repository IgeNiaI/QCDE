	FirePostSoundCheck:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMCheckTransparency")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("QCDE_LgShouldGoPurple",0,0,0,0) == 1,"CheckIfUpgrade")
		Goto CheckCoopHold

		CheckIfUpgrade:		//sets regular lg, visible
			TNT1 A 0 A_JumpIfInventory("LG_UG_Static",1,"LGSet100Purp")
			Goto CheckCoopHold

	CheckCoopHold:
		TNT1 A 0 A_JumpIfInventory("LG_UG_Static",1,"Fire.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCLightningGunSkin", 5, "Fire.ETQW")
