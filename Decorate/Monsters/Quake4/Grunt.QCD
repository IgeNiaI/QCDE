//=====================================================================================
//=====================================================================================

//=====================================================================================
//=====================================================================================

Actor Q4Grunt : QCDE_MonsterSmall	15304	//Demon
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 20
	Height 56
	Health 120	//slightly lowered since it can heal 45hp
	Mass 200
	PainChance 64
	Speed 11
	Scale 0.42
	MeleeRange 60
	MinMissileChance 255
	MeleeThreshold 500		//he'd rather whack you to a pulp
	+FLOORCLIP
	SeeSound "quake4/Grunt/Sight"
	PainSound "quake4/Grunt/Pain"
	DeathSound "quake4/Grunt/Death"
	ActiveSound "quake4/Grunt/Idle"
	Obituary "$OB_Q4Grunt" // "%o got lots of holes thanks to a grunt's hidden machine gun."
	HitObituary "$OBH_Q4Grunt" // "%o was whacked right in the face by a Strogg grunt."
	Tag "$TAG_Q4Grunt" // "Grunt"
	States
	{
	Idle:
		Q06I A 0 A_TakeInventory("BerserkToken",1) //will calm down after target's dead
		Q06I A 4 A_Look
		Wait
	See:
		TNT1 A 0 A_JumpIfInventory("TimesBerserk",2,"SeeNormal") //if it has healed 3 times already, no more
		TNT1 A 0 A_JumpIfInventory("BerserkToken",1,"SeeBerserk")
		TNT1 A 0 A_JumpIfHealthLower(50,"Berserk")
	SeeNormal:
		Q06W AABBCCDDEEFF 2 A_Chase
		Loop
	SeeBerserk:		//very fast, and no range attack at all
		TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION)
		Q06W A 2 A_Chase("MeleeBerserk","")	Q06W A 1 A_Chase("MeleeBerserk","")	TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
		Q06W B 2 A_Chase("MeleeBerserk","")	Q06W B 1 A_Chase("MeleeBerserk","")	TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
		Q06W C 2 A_Chase("MeleeBerserk","")	Q06W C 1 A_Chase("MeleeBerserk","")	TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
		Q06W D 2 A_Chase("MeleeBerserk","")	Q06W D 1 A_Chase("MeleeBerserk","")	TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
		Q06W E 2 A_Chase("MeleeBerserk","")	Q06W E 1 A_Chase("MeleeBerserk","")	TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
		Q06W F 2 A_Chase("MeleeBerserk","")	Q06W F 1 A_Chase("MeleeBerserk","")
		Loop

	Melee:
		Q06M ABC 4 A_FaceTarget
		Q06M D 4 A_CustomMeleeAttack(random(13,23),"quake4/Misc/MeleeHit","quake4/Misc/Swing","Normal",1)
		Q06M EF 4
		Goto See

		MeleeBerserk:	//damages more when in berserk mode
			Q06M A 3 A_FaceTarget TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
			Q06M B 3 A_FaceTarget TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
			Q06M C 3 A_FaceTarget TNT1 AA 0 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION,180)
			Q06M D 4 A_CustomMeleeAttack(random(25,35),"quake4/Misc/MeleeHit","quake4/Misc/Swing","Normal",1) //no spawn needed here since it's covered by next two frames
			Q06M EF 4 A_SpawnItemEx("StroyentGas",random(15,-15),random(15,-15),random(20,45),0,0,frandom(0.3,0.5),0,SXF_NOCHECKPOSITION)
			Goto SeeBerserk

	Missile:
	MGunAtt:
		Q06I AAA 3 A_FaceTarget(0,0)
		TNT1 A 0 A_PlaySound("quake4/Grunt/MachineGunShot")
		TNT1 A 0 A_SpawnItemEx("MonMuzzleFlashSmall",10,-9,46,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_CustomMissile("MonsterTracerMidVol",32,random(3,-3),frandom(10,-10))
		Q06A A 5 A_CustomBulletAttack(25,25,1,1)	//pretty weak, since it's not supposed to be it's main attack
		TNT1 A 0 A_CPosRefire
		TNT1 A 0 A_Jump(20,"See")
		Goto MGunAtt+3

	Berserk:
		TNT1 A 0 A_JumpIfInventory("TimesBerserk",2,"BerserkNoEffect")
		TNT1 A 0 A_ChangeFlag("NOPAIN",1)
		Q06I AA 2
		TNT1 A 0 A_GiveInventory("TimesBerserk",1)
		TNT1 A 0 A_GiveInventory("BerserkToken",1)
		TNT1 A 0 A_PlaySound("quake4/Grunt/Anger",5)
		Q06B ABCD 4
		TNT1 A 0 HealThing(45)	//heals
		TNT1 A 0 A_PlaySound("quake4/Grunt/GroundHit",6)
		Q06B EF 4
		Q06I A 3
		TNT1 A 0 A_ChangeFlag("NOPAIN",0)
		Goto SeeBerserk

		BerserkNoEffect:		//he'll still play the animation, but no special effect (no heal)
			Q06I AA 2
			TNT1 A 0 A_PlaySound("quake4/Grunt/Anger",5)
			Q06B ABCD 4
			TNT1 A 0 A_PlaySound("quake4/Grunt/GroundHit",6)
			Q06B EF 4
			Q06I A 3
			Goto See

	Pain:
		Q06P A 7 A_Pain
		Goto See
	DeathChecksDone:
		Q06D A 0 A_Scream
		Q06D A 0 A_Fall
		Q06D ABCDEFGHIJK 2
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
	Death.Corpse:
		Q06D L -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q06D KJIHGFEDCBA 2
		Goto See
	}
}
Actor BerserkToken : Inventory
{	Inventory.MaxAmount 1		}
Actor TimesBerserk : Inventory
{	Inventory.MaxAmount 3		}

Actor StroyentGas
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[0,0.6,0]"
	RenderStyle Add
	Scale 0.35
	Alpha 0.7
	States
	{
	Spawn:
		FX54 ABCDEFGHIJKLMNOPQ 1
		Stop
	}
}



