// --------------------------------------------------------------------------
//
// Eleena's abilities
//
// Active:  Doppelganger
//          Spawns a hologram.
//          Activate again to swap places with it while it's alive.
//
// Passive: Training Weights
//          Runs faster without armor.
//
// --------------------------------------------------------------------------

Actor CompatVer30_Eleena {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor Doppelganger
{
	+BRIGHT
	+FRIENDLY
	+SHOOTABLE
	+BLOODLESSIMPACT +NOBLOOD
	+SERVERNETID
	Health 10000
	Radius 13
	Height 52
	DamageType "NoDamageToPlayers"
	Alpha 0.95
	Scale 0.59
	Obituary "$OB_Doppelganger" // "%o was barking at the wrong tree all along."
	HitObituary "$OBH_Doppelganger" // "%o was delivered the sweet release of death by snusnu." // Thanks Abysswalker!
	States
	{
	Spawn:
		QP24 A 0 NodeLay ACS_NamedExecuteWithResult("QCDE_DoppelgangerSpawned")
		QP24 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck") >= 2,"DM")
		Goto Idle
	DM:
		QP24 A 0 A_ChangeFlag("FRIENDLY", false)
		QP24 A 0 A_ChangeFlag("SHOOTABLE", false)
		QP24 A 0 A_ChangeFlag("CANBLAST", true) //in DM freeman can blast it away
		Goto Idle
	Idle:
		QP24 A 0 A_Explode(1,512,XF_NOTMISSILE,0,512)
		QP24 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP24 A 0 A_JumpIf(true,                   "DefSpawn")
		QP24 G 100
		Loop

		ColoredSpawn:
			RP24 A 0 A_Jump(240,"ColoredSee")
			RP24 G 4
			Loop
		DefSpawn:
			QP24 A 0 A_Jump(240,"DefSee")
			QP24 G 4
			Loop

		ColoredSee:
			RP24 ABCDEF 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 A_Turn(random(-45,45))
			"####" "#" 0 A_Jump(192, "ColoredSee", "ColoredMissile")
			"####" "#" 0 A_PlaySound("EleenaJump", CHAN_VOICE)
			"####" "#" 0 ThrustThingZ(0,40,0,1)
			"####" "#" 0 A_Jump(192, "ColoredMissile")
			Loop
		DefSee:
			QP24 ABCDEF 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 A_Turn(random(-45,45))
			"####" "#" 0 A_Jump(192, "DefSee", "DefMissile")
			"####" "#" 0 A_PlaySound("EleenaJump", CHAN_VOICE)
			"####" "#" 0 ThrustThingZ(0,40,0,1)
			"####" "#" 0 A_Jump(192, "DefMissile")
			Loop

		ColoredMissile:  RP24 G 0 A_LookEx(LOF_NOSEESOUND|LOF_NOJUMP, 0,0,0, 360, "See")  Goto See
		DefMissile:  QP24 G 0 A_LookEx(LOF_NOSEESOUND|LOF_NOJUMP, 0,0,0, 360, "See")  Goto See

		See:
			"####" "#" 0 A_Explode(1,512,XF_NOTMISSILE,0,512)
			"####" "#" 0 A_JumpIfInventory("QCRocketLauncherDM",1,"Rocket")
			"####" "#" 0 A_JumpIfInventory("QCRailgunDM",1,"Rail")
			"####" "#" 100 A_Jump(256,"HMG","SSG","Nail","Rocket","Rail")

		HMG:
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 8, "HMG.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 7, "HMG.HalfLife")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 6, "HMG.Default")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 5, "HMG.ETQW")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 4, "HMG.Quake4")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 3, "HMG.Quake3")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 2, "HMG.Quake2")
		HMG.Default:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_Quake2",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_Quake3",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_Quake4",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_ETQW",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_HalfLife",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMG.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireStartLoop_SeriousSam",CHAN_WEAPON,1,1)
			Goto HMGAgain
		HMGAgain:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(-2.1,2.1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(-2.1,2.1))
			"####" H 0 A_CustomMissile("MachinegunSmokeSpawner", 40, 0, 0, CMF_AIMDIRECTION|CMF_NOUNLAGGED)
			"####" H 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndHMG")
			Goto HMGAgain
		EndHMG:
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 8, "EndHMG.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 7, "EndHMG.HalfLife")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 6, "EndHMG.Default")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 5, "EndHMG.ETQW")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 4, "EndHMG.Default")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 3, "EndHMG.Quake3")
			"####" H 0 A_JumpIfInventory("QCHMachinegunSkin", 2, "EndHMG.Quake2")
		EndHMG.Default:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_Default",CHAN_WEAPON,1,0)
			Goto Idle
		EndHMG.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_Quake2",CHAN_WEAPON,1,0)
			Goto Idle
		EndHMG.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_Quake3",CHAN_WEAPON,1,0)
			Goto Idle
		EndHMG.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_ETQW",CHAN_WEAPON,1,0)
			Goto Idle
		EndHMG.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_HalfLife",CHAN_WEAPON,1,0)
			Goto Idle
		EndHMG.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/HeavyMachinegun/FireEnd_SeriousSam",CHAN_WEAPON,1,0)
			Goto Idle

		SSG:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 8, "SSG.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 7, "SSG.HalfLife")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 6, "SSG.Default")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 5, "SSG.ETQW")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 4, "SSG.Quake4")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 3, "SSG.Quake3")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 2, "SSG.Quake2")
			"####" H 0 A_JumpIfInventory("QCSShotgunSkin", 1, "SSG.Quake1")
		SSG.Default:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Default",CHAN_WEAPON)
			Goto SSGCont
		SSG.Quake1:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake1",CHAN_WEAPON)
			Goto SSGCont
		SSG.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake2",CHAN_WEAPON)
			Goto SSGCont
		SSG.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake3",CHAN_WEAPON)
			Goto SSGCont
		SSG.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_Quake4",CHAN_WEAPON)
			Goto SSGCont
		SSG.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_ETQW",CHAN_WEAPON)
			Goto SSGCont
		SSG.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_HalfLife",CHAN_WEAPON)
			Goto SSGCont
		SSG.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/SuperShotgun/Fire_SeriousSam",CHAN_WEAPON)
			Goto SSGCont
		SSGCont:
			"####" SHOTGUN 0 A_CustomMissile("BulletSmallTracer",40,0,frandom(9.2,-9.2),CMF_AIMDIRECTION|CMF_NOUNLAGGED,frandom(7.2,-7.2))
			"####" HHHHH 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 ThrustThingZ(0,40 * random(0,1),0,1)
			"####" GGGGGG 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(64,"Idle")
			Goto SSG

		Nail:
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 8, "Nail.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 7, "Nail.HalfLife")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 6, "Nail.Default")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 5, "Nail.ETQW")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 4, "Nail.Quake4")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 3, "Nail.Quake3")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 2, "Nail.Quake2")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 1, "Nail.Quake1")
		Nail.Default:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_Default",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.Quake1:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_Quake1",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_Quake2",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_Quake3",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_Quake4",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_ETQW",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_HalfLife",CHAN_WEAPON,1,1)
			Goto NailAgain
		Nail.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireStartLoop_SeriousSam",CHAN_WEAPON,1,1)
			Goto NailAgain
		NailAgain:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
		NailFire:
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 8, "NailFire.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 7, "NailFire.HalfLife")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 6, "NailFire.Default")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 5, "NailFire.ETQW")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 4, "NailFire.Quake4")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 3, "NailFire.Quake3")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 2, "NailFire.Quake2")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 1, "NailFire.Quake1")
		NailFire.Default:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.Quake1:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_Quake1", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.Quake2:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_Quake2", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.Quake3:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_Quake3", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.Quake4:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_Quake4", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.ETQW:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_ETQW", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.HalfLife:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailFire.SeriousSam:
			"####" H 0 A_CustomMissile ("QCNailStrongIllusion_SeriousSam", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			Goto NailPost
		NailPost:
			"####" H 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndNails")
			Goto NailAgain
		EndNails:
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 8, "EndNails.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 7, "EndNails.HalfLife")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 6, "EndNails.Default")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 5, "EndNails.ETQW")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 4, "EndNails.Quake4")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 3, "EndNails.Quake3")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 2, "EndNails.Quake2")
			"####" H 0 A_JumpIfInventory("QCSNailgunSkin", 1, "EndNails.Quake1")
		EndNails.Default:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_Default",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.Quake1:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_Quake1",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_Quake2",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_Quake3",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_Quake4",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_ETQW",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_HalfLife",CHAN_WEAPON,1,0)
			Goto Idle
		EndNails.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/SuperNailgun/FireEnd_SeriousSam",CHAN_WEAPON,1,0)
			Goto Idle

		Rocket:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 8, "Rocket.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 7, "Rocket.HalfLife")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 6, "Rocket.Default")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 5, "Rocket.ETQW")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 4, "Rocket.Quake4")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 3, "Rocket.Quake3")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 2, "Rocket.Quake2")
			"####" H 0 A_JumpIfInventory("QCRocketLauncherSkin", 1, "Rocket.Quake1")
		Rocket.Default:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Default", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.Quake1:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		Rocket.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/RocketLauncher/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
			Goto RocketCont
		RocketCont:
			"####" H 0 A_CustomMissile("QCRocketPlayerIllusion", 40, 0, random(-1,1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, random(-1,1))
			"####" HHHH 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 ThrustThingZ(0,40 * random(0,1),0,1)
			"####" GGGGG 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(64,"Idle")
			Goto Rocket

		Rail:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 8, "Rail.SeriousSam")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 7, "Rail.HalfLife")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 6, "Rail.Default")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 5, "Rail.ETQW")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 4, "Rail.Quake4")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 3, "Rail.Quake3")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 2, "Rail.Quake2")
			"####" H 0 A_JumpIfInventory("QCRailgunSkin", 1, "Rail.Quake1")
		Rail.Default:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_Default", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff",8,5,0,0,6.0,1.0,"RailgunTrail")
			Goto RailCont
		Rail.Quake1:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_Quake1",8,5,0,0,6.0,1.0,"RailgunTrail_Quake1")
			Goto RailCont
		Rail.Quake2:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,"#4793a3","#cecfd1",RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_Quake2",8,5,0,0,1.0,1.0)
			Goto RailCont
		Rail.Quake3:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff",8,5,0,0,6.0,1.0,"RailgunTrail_Quake3")
			Goto RailCont
		Rail.Quake4:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_Quake4",8,5,0,0,6.0,1.0,"RailgunTrail_Quake4")
			Goto RailCont
		Rail.ETQW:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_ETQW",8,5,0,0,6.0,1.0,"RailgunTrail_ETQW")
			Goto RailCont
		Rail.HalfLife:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_HalfLife",8,5,0,0,6.0,1.0,"RailgunTrail_HalfLife")
			Goto RailCont
		Rail.SeriousSam:
			"####" H 0 A_PlaySound("QC/Weapons/Railgun/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0,0,0,0,RGF_SILENT|RGF_FULLBRIGHT,0,0,"RailgunPuff_SeriousSam",8,5,0,0,6.0,1.0,"RailgunTrail_SeriousSam")
			Goto RailCont
		RailCont:
			"####" HHHH 3 ThrustThing(angle + 64, random(-4,4), 0, 0)
			"####" "#" 0 ThrustThingZ(0,50 * random(0,1),0,1)
			"####" GGGGGGGGGG 4 ThrustThing(angle + 64, random(-5,5), 0, 0)
			"####" H 0 A_Jump(96,"Idle")
			Goto Rail

	Vanish:
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(5) //stops looping sounds
		TNT1 A 10 A_SpawnItemEx("EleenaDisappearFX", 0,0,30, 0,0,0, 0,SXF_CLIENTSIDE)
		Stop
	}
}

