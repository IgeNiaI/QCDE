// -10% cooldown
script "鳞~Loot🅱ox1_4" (void)
{
	SetResultValue("");
	if(CheckInventory("Class_Sarge")) terminate;
	int given = GiveAndCheck("CooldownRewardToken", 10);
	if(given == 10)
	{
		if(CheckInventory("Class_Sam"))
		{
			SetAmmoCapacity("SeriousBullets", BASE_SamBullets + LEVEL_SamBullets * (CheckInventory("CooldownRewardToken") / 5));
			SetResultValue("CDLOOT05:More Ability Ammo Capacity");
		}
		else if(CheckInventory("Class_DukeNukem"))
		{
			SetAmmoCapacity("DukeAmmo", BASE_DukeAmmo + LEVEL_DukeAmmo * (CheckInventory("CooldownRewardToken") / 5));
			SetResultValue("CDLOOT05:More Ability Ammo Capacity");
		}
		else
		{
			SetResultValue("CDLOOT10:-10% Cooldown");
		}
	}
	else if(given == 5)
	{
		if(CheckInventory("Class_Sam"))
		{
			SetAmmoCapacity("SeriousBullets", BASE_SamBullets + LEVEL_SamBullets * (CheckInventory("CooldownRewardToken") / 5));
			SetResultValue("CDLOOT05:More Ability Ammo Capacity");
		}
		else if(CheckInventory("Class_DukeNukem"))
		{
			SetAmmoCapacity("DukeAmmo", BASE_DukeAmmo + LEVEL_DukeAmmo * (CheckInventory("CooldownRewardToken") / 5));
			SetResultValue("CDLOOT05:More Ability Ammo Capacity");
		}
		else
		{
			SetResultValue("CDLOOT05:-5% Cooldown");
		}
	}
}

