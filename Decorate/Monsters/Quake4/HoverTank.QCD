//=====================================================================================
//=====================================================================================
//
//=====================================================================================
//=====================================================================================
Actor Q4HoverTank : QCDE_MonsterBig 15307 //fatso
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 48
	Height 64
	Mass 1200
	Health 600
	PainChance 40
	Speed 11
	+FLOORCLIP
	Scale 0.49
	SeeSound "quake4/HoverTank/Sight"
	PainSound "quake4/HoverTank/Pain"
	DeathSound "quake4/HoverTank/Death"
	ActiveSound "quake4/HoverTank/Idle"
	Obituary "$OB_Q4HoverTank" // "%o learned not to play with hover tanks."
	Tag "$TAG_Q4HoverTank" // "Hover Tank"
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q09W ABCDE 5 A_Look
		Loop
	See:
		Q09W ABCDE 5 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_Stop
		TNT1 a 0 A_Jump(192,"Blaster")	//75% of the time
		Goto Rocket

	Rocket:
		Q09A AB 5 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/HoverTank/RocketReady")
		Q09A CDDDDDDDDDD 5 A_FaceTarget
		TNT1 A 0 A_CustomMissile("HHTankRocket",40,7,0)
		Q09A EFG 7
		Goto See

	Blaster:
		Q09B AB 5 A_FaceTarget
		TNT1 A 0 A_FaceTarget
		TNT1 A 0 A_PlaySound("quake4/Gladiator/BlasterShot")
		Q09B C 0 A_CustomMissile("HoverTankBlaster",33,-13,random(5,-5))
		Q09B C 3 A_CustomMissile("HoverTankBlaster",33,-13,random(5,-5))
		Q09B B 3
		TNT1 A 0 A_Jump(20,"See")
		TNT1 a 0 A_CPosRefire
		Goto Blaster+2

	Pain:
		Q09P A 7 A_Pain
		Goto See

	DeathChecksDone:
		TNT1 A 0 A_Scream
		Q09D ABC 4
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Metal",5)
		Q09D DEF 3
		Q09D F 0 A_Fall
	Death.Corpse:
		Q09D G -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMediumBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q09D FEDCBA 3
		Goto See
	}
}


//****************************************
Actor HoverTankBlaster
{
	Projectile
	Radius 4
	Height 6
	Damage (random(2,4)*4)
	Speed 17
	Scale 0.3
	RenderStyle Add
	SeeSound ""
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	Decal "Q4PlasmaMonster"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		ACID A 7 Light(OrangeMediumPoint3) Bright
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("HoverTankBlasterExplo1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 4 A_SpawnItemEx("HoverTankBlasterExplo2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}


Actor HoverTankBlasterTrail
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	RenderStyle Add
	Alpha 0.6
	Scale 0.1
	States
	{
	Spawn:
		ACID BCDE 1 A_FadeOut(0.05)
	Ending:
		TNT1 A 0 A_SetScale(scaleX+0.025)
		ACID F 1 A_FadeOut(0.05)
		Loop
	}
}

Actor HoverTankBlasterExplo1
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	Renderstyle Add
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	Scale 0.35
	States
	{
	Spawn:
		DB60 ABCDEFGHIJKLMNOPQ 1 Bright A_FadeOut(0.03)
		Stop
	}
}
Actor HoverTankBlasterExplo2
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 0.3
	Translation "0:255=%[0,0,0]:[2,1,0.4]"
	States
	{
	Spawn:
		STAR F 2 Light("OrangeMediumFlicker3") Bright A_FadeOut(0.04)
		STAR GHIJ 2 Light("OrangeMediumFlicker2") Bright A_FadeOut(0.04)
		STAR K 2 Light("OrangeMediumFlicker3") Bright A_FadeOut(0.04)
		STAR L 2 Light("OrangeSmallFlicker1") Bright A_FadeOut(0.04)
		STAR M 2 Light("OrangeSmallFlicker1") Bright A_FadeOut(0.04)
		STAR N 2 Light("OrangeSmallFlicker2") Bright A_FadeOut(0.04)
		STAR O 2 Light("OrangeSmallFlicker3") Bright A_FadeOut(0.04)
		Stop
	}
}


//******************************
Actor HHTankRocket
{
	Projectile
	+RANDOMIZE
	+ROCKETTRAIL
	+FORCERADIUSDMG
	+EXTREMEDEATH
	Radius 12
	Height 12
	Speed 16
	+SEEKERMISSILE
	Damage 12
	SeeSound "quake4/Weapons/RocketLauncher/Fire"
	DeathSound "quake4/Misc/Explo"
	Scale 0.85
	Decal "Q4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Weapons/RocketLauncher/Fly",7,1,1,3)
		TNT1 A 0 A_SpawnItemEx("Q4BigRocketTrail",-4,0,3,0,0,0,0,SXF_NOCHECKPOSITION)
		MICR A 1 Light("WhiteMediumFlicker2") Bright A_SeekerMissile(3,3)
		MICR A 1 Light("WhiteMediumFlicker2") Bright
		Loop
	Death:
		TNT1 A 0 A_Explode(72,128,1)
		TNT1 A 3 A_SpawnItemEx("QCRocketExplosionBigger",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}
Actor Q4BigRocketTrail
{
	+CLIENTSIDEONLY
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1.5,1.5,1.5]"
	Alpha 0.7
	Scale 0.35
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(255,"One","Two")
	One:
		X007 ABCDE 1 Bright
		X007 FGHIJ 2 Bright A_FadeOut
		Stop
	Two:
		X007 KLMNO 1 Bright
		X007 PQRST 2 Bright A_FadeOut
		Stop
	}
}


