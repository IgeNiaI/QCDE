			Goto PerformDMCont
		PerformDM.ETQW:
			TNT1 A 0 A_RailAttack(80,1,1,"None","None",RGF_SILENT|RGF_FULLBRIGHT|RGF_NORANDOMPUFFZ|RGF_EXTRATRAIL,0,"RailgunPuff_DM_ETQW",0,0,0,0,6,1,"RailgunTrail_ETQW", 1)
			Goto PerformDMCont
		PerformDM.HalfLife:
			TNT1 A 0 A_RailAttack(80,1,1,"None","None",RGF_SILENT|RGF_FULLBRIGHT|RGF_NORANDOMPUFFZ|RGF_EXTRATRAIL,0,"RailgunPuff_DM_HalfLife",0,0,0,0,6,1,"RailgunTrail_HalfLife", 1)
			Goto PerformDMCont
		PerformDM.SeriousSam:
			TNT1 A 0 A_RailAttack(80,1,1,"None","None",RGF_SILENT|RGF_FULLBRIGHT|RGF_NORANDOMPUFFZ|RGF_EXTRATRAIL,0,"RailgunPuff_DM_SeriousSam",0,0,0,0,6,1,"RailgunTrail_SeriousSam", 1)
			Goto PerformDMCont
		PerformDM.Modded:
			TNT1 A 0 A_RailAttack(80,1,1,"None","None",RGF_SILENT|RGF_FULLBRIGHT|RGF_NORANDOMPUFFZ|RGF_EXTRATRAIL,0,"RailgunPuff_DM_Modded",0,0,0,0,6,1,"RailgunTrail_Modded", 1)
			Goto PerformDMCont

		PerformDMCont:
			//Medals start
			TNT1 A 1
			TNT1 A 0 A_GiveInventory("AimWellToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
			//Medals end
			Goto FlashCheckSound

		FlashCheckSound:
			TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
			TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
			Goto NormalSound

			NormalSound:
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 20, "NormalSound.Modded")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 8, "NormalSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 7, "NormalSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 6, "NormalSound.Default")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 5, "NormalSound.ETQW")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 4, "NormalSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 3, "NormalSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 2, "NormalSound.Quake2")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 1, "NormalSound.Quake1")
			NormalSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Default", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake1:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.ETQW:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			NormalSound.Modded:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Fire_Modded", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder

			QuadSound:
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 20, "QuadSound.Modded")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 8, "QuadSound.SeriousSam")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 7, "QuadSound.HalfLife")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 6, "QuadSound.Default")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 5, "QuadSound.ETQW")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 4, "QuadSound.Quake4")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 3, "QuadSound.Quake3")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 2, "QuadSound.Quake2")
				"####" A 0 A_JumpIfInventory("QCRailgunSkin", 1, "QuadSound.Quake1")
			QuadSound.Default:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Default", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake1:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Quake1", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake2:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Quake2", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake3:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Quake3", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Quake4:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Quake4", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.ETQW:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_ETQW", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.HalfLife:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_HalfLife", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.SeriousSam:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_SeriousSam", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder
			QuadSound.Modded:
				"####" A 0 A_PlaySound("QC/Weapons/Railgun/Quad/Fire_Modded", CHAN_WEAPON, 1.0, 0)
				Goto FlashEnder

	FlashEnder:
		//Medals start
		TNT1 A 0 A_GiveInventory("RGFiredGiver",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 0 ACS_NamedExecuteAlways("ComboKillTokenGiver",0)
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_Impressive",0)
		//Medals end

		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnderCont")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 20, "FlashEnder.Modded")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 8, "FlashEnder.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 7, "FlashEnder.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 6, "FlashEnder.Default")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 5, "FlashEnder.ETQW")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 4, "FlashEnder.Quake4")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 3, "FlashEnder.Quake3")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 2, "FlashEnder.Quake2")
		TNT1 A 0 A_JumpIfInventory("QCRailgunSkin", 1, "FlashEnder.Quake1")
	FlashEnder.Default:
		TNT1 A 0 A_SetBlend("Green",0.14,15)
		Goto FlashEnderCont
	FlashEnder.Quake1:
		TNT1 A 0 A_SetBlend("Red",0.14,15)
		Goto FlashEnderCont
	FlashEnder.Quake2:
		TNT1 A 0 A_SetBlend("White",0.14,15)
		Goto FlashEnderCont
	FlashEnder.Quake3:
		TNT1 A 0 A_SetBlend("Green",0.14,15)
		Goto FlashEnderCont
	FlashEnder.Quake4:
		TNT1 A 0 A_SetBlend("Cyan",0.14,15)
		Goto FlashEnderCont
	FlashEnder.ETQW:
	FlashEnder.HalfLife:
	FlashEnder.SeriousSam:
		TNT1 A 0 A_SetBlend("Orange",0.14,15)
		Goto FlashEnderCont
	FlashEnder.Modded:
		TNT1 A 0 A_SetBlend("Green",0.14,15)
		Goto FlashEnderCont

	FlashEnderCont:
		TNT1 A 0 A_AlertMonsters
		"####" "#" 0 A_JumpIfInventory("QCRailgunSkin", 20, "FlashEnderCont.Effects.Modded")
		TNT1 A 0 A_RailAttack(0,2,0,"None","None",RGF_SILENT|RGF_FULLBRIGHT,0,"DummyPuff",0,0,1,0,70.0,1.0,"RailgunSmoke")
		TNT1 A 0 A_FireCustomMissile("RailgunWhoosher",0,false,1,5,FPF_NOUNLAGGED|FPF_SKIPOWNER,0)				//to play "whoosh" sound when passes by
		Goto FlashEnderCont.EffectsCont
	FlashEnderCont.Effects.Modded:
		TNT1 A 0 A_FireCustomMissile("RailgunWhoosher_Modded",0,false,1,5,FPF_NOUNLAGGED|FPF_SKIPOWNER,0)				//to play "whoosh" sound when passes by
	FlashEnderCont.EffectsCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-5.0)
		TNT1 AAAAA 1 A_SetPitch(pitch+1)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop



