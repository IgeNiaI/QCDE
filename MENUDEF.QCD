OptionValue "LowWarning"
{
	0, "Off"
	1, "Sound"
	2, "Sound & Text"
	3, "Sound & Text stays"
}

OptionValue "BarStyle"
{
	0, "Blocks of 25 points"
	1, "Continuous"
}

OptionValue "OI"
{
	0, "\c[red]Off"
	1, "\c[green]On"
	0, "\c[red]Off"
	1, "\c[green]On"
	-1, " " // !!==true, default, for unloaded themes
	0, "\c[red]Off"
	1, "\c[green]On"
}

OptionValue "LGTransp"
{
	0, "Invisible"
	1, "Fully visible"
}

OptionValue "StartingWeapon"
{
	1, "Machinegun"
	2, "Shotgun (DM-only)"
	3, "Nailgun"
}

OptionValue "ShuffleMode"
{
	0, "Per monster \c[black](AEoD-like)"
	1, "One theme per map"
}

OptionValue "RadarMode"
{
	0, "Big centered"
	1, "Small below crosshair"
}

OptionValue "OstOrder"
{
	0, "Strict"
	1, "Shuffled"
	2, "Randomized"
}

OptionValue "TauntSubtitles"
{
	0, "Off"
	1, "Only in campaign"
	2, "In all PvE modes"
	3, "Always on"
}


