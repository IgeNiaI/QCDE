//*****************************************************************************
//*****************************************************************************
// This script is called by items to know what kind the game is.
//
//	Game types:
//	 0 	Single player
//	 1 	Cooperative
//	 2 	Deathmatch
//	 3 	Title map
//	 4 	(Skull/dronum) Team game
//*****************************************************************************
//*****************************************************************************


Script "MultiplayerCheck" (void)
{
	if(GameType() == 4 || InCampaign() || GetCVar("qc_defrag"))
		SetResultValue(2); // team games have same weapons as DM
	else
		SetResultValue(GameType());
}

int weaponStay;
Script "WeaponStayCheck" (void)
{
	SetResultValue(weaponStay);
}

int instagib=-1, rocketarena=-1;
Script "InstagibCheck" (int withoutrocketarena)
{
	if(withoutrocketarena)
		SetResultValue(instagib && !rocketarena);
	else
		SetResultValue(instagib);
}

Script "QCDE_DespawnIfInstagib" (void)
{
	if(instagib == -1 && rocketarena == -1) // not loaded yet
	{
		instagib    = GetCvar("instagib");
		rocketarena = GetCvar("rocketarena");
	}

	if(instagib || rocketarena) Thing_Remove(0);
}

Script "CvarTrack" OPEN
{
	instagib    = GetCvar("instagib");
	rocketarena = GetCvar("rocketarena");
	while(true)
	{
		delay(35);
		weaponStay = GetCvar("sv_weaponStay");
	}
}

Script "iamamiwhoami" (void)
{
	str iam = strparam(n:0);
	int iam_ = ActivatorTid();

	int owner = GetActorProperty(0, APROP_MasterTID);

	SetActivatorToTarget(0);

	str Amy = strparam(n:0);
	int Amy_ = ActivatorTid();

	str ownerinfo = ".";
	if(owner)
	{
		SetActivator(owner);
		ownerinfo = strparam(s:", owned by ", n:0, s:" tid ", d:owner);
	}

	printbold(s:"I am ", s:iam, s:" tid ", d:iam_,
	   s:", targeting ", s:Amy, s:" tid ", d:Amy_, s:ownerinfo);
}



Script "QCDE_DM_HealthAndWeapons" (void)
{
	if (GameType() < GAME_NET_DEATHMATCH && !InCampaign()) terminate; // only if game is DM or DM Campaign

	str unused = ""; // beats "DMToken" in case of broken string table
	GiveInventory("DMToken", 1);

	if (GetCVar("sv_healonkill")) {
		ACS("HealthGiver",ACS("MaxHealth"),ACS("MaxHealth"),false);
		ACS("ArmorGiver", ACS("MaxArmor"), ACS("MaxArmor"), false);
	}
}

//Handles various events to trigger after frag
script "QCDE_FragEventTracker" (int evtTyp, int victimNo, int arg2) EVENT
{
	if(GameType() < GAME_NET_DEATHMATCH)
		terminate;

	if(evtTyp != GAMEEVENT_PLAYERFRAGS)
		terminate;

	if (GetCVar("sv_healonkill")) {
		ACS("HealthGiver",ACS("MaxHealth"),ACS("MaxHealth"),false);
		ACS("ArmorGiver", ACS("MaxArmor"), ACS("MaxArmor"), false);
	}
}


int lastTime = -999999;
Script "QCDE_FirstInSeconds" (int secs)
{
	SetResultValue(false);
	if (Timer() > lastTime + secs*35)
	{
		SetResultValue(true);
		lastTime = Timer();
	}
}


str keys[NUMBER_OF_KEYS][3] = {
	{"RedCard",     "Red Card",     false},
	{"YellowCard",  "Yellow Card",  false},
	{"BlueCard",    "Blue Card",    false},
	{"RedSkull",    "Red Skull",    false},
	{"YellowSkull", "Yellow Skull", false},
	{"BlueSkull",   "Blue Skull",   false},
};
Script "QCDE_RegiveKeys" (void)
{
	for(int i = 0; i < NUMBER_OF_KEYS; i++)
		if(keys[i][2] == true)
			GiveInventory(keys[i][0], 1);
}
Script "QCDE_GiveKey" (int which)
{
	if (GetNetworkState() == NETSTATE_CLIENT || InDemoMode())
		terminate;

	if(which < 0 || which --> NUMBER_OF_KEYS)
		log(s:"\c[yellow]QCDE warning: attempt to give key number ", d:-~which);

	GiveInventory(keys[which][0], 1);

	// Give to all players -- shared keys are the norm, not a quirky option
	GiveActorInventory(0, keys[which][0], 1);
	if(keys[which][2] != true)
	{
		ACS("QCDE_PickupMessage", which);
		keys[which][2] = true;
	}
}
Script "QCDE_PickupMessage" (int what) CLIENTSIDE
{
	str pickupmessage = strparam(n:0, s:" picked up a ", s:keys[what][1], s:".");
	Log(s:pickupmessage);
}



// Kill in coop if changed class mid-game, because otherwise on map change
// client and server start disagreeing over class.

Script "QCDE_SendKey" ENTER
{
	while(true)
	{
		if(!secretkey) secretkey = random(1, 12345);

		ACS_NamedExecuteAlways("QCDE_ReceiveKey", 0, secretkey);

		delay(random(35,70));
	}
}

Script "QCDE_ReceiveKey" (int data) CLIENTSIDE
{
	secretkey = data;
}

Script "QCDE_ClassCheck_ENTER" ENTER CLIENTSIDE
{
	// Spectators: Please don't
	if(PlayerIsSpectator(PlayerNumber())) terminate;

	// Only care about yourself
	if(CPN() != PlayerNumber()) terminate;

	int mustbe1 =
		CheckInventory("Class_Ranger"		) +
		CheckInventory("Class_Doomslayer"	) +
		CheckInventory("Class_Corvus"		) +
		CheckInventory("Class_Kane"			) +
		CheckInventory("Class_Caleb"		) +
		CheckInventory("Class_Menelkir"		) +
		CheckInventory("Class_Terminator"	) +
		CheckInventory("Class_Zedek"		) +
		CheckInventory("Class_Inquisitor"	) +
		CheckInventory("Class_Bitterman"	) +
		CheckInventory("Class_Galen"		) +
		CheckInventory("Class_Nyx"			) +
		CheckInventory("Class_Sorgaul"		) +
		CheckInventory("Class_DukeNukem"	) +
		CheckInventory("Class_Durandal"		) +
		CheckInventory("Class_Keel"			) +
		CheckInventory("Class_Sarge"		) +
		CheckInventory("Class_LoWang"		) +
		CheckInventory("Class_Grayson"		) +
		CheckInventory("Class_Eradicator"	) +
		CheckInventory("Class_Blazkowicz"	) +
		CheckInventory("Class_Freeman"		) +
		CheckInventory("Class_VorMatur"		) +
		CheckInventory("Class_Eleena"		) +
		CheckInventory("Class_Lucienne"		) +
		CheckInventory("Class_Major"		) +
		CheckInventory("Class_Hunter"		) +
		CheckInventory("Class_Sam"			) +
		CheckInventory("Class_Postal"		) +
		CheckInventory("Class_Painkiller"	) +
		CheckInventory("Class_Intruder"		) +
