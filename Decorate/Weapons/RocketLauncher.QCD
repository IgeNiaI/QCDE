Actor RocketControlled_Modded : RocketControlled
{
	Decal "MDRLScorch"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/Fly_Modded",CHAN_5|CHAN_NOPAUSE,1.0,true)
		MDY5 A 1 bright ACS_NamedExecuteWithResult("QCDE_RocketControl")	//Projectile control and whatnot
		TNT1 A 0 bright ACS_NamedExecuteWithResult("QCDE_TunnelVision")	//Black Screen effect
		TNT1 A 0 A_SetUserVar(user_counter,1)

	Looper:
		MDY5 A 0 A_JumpIfInventory("ImDead",1,"DieTime")
		MDY5 A 0 A_SpawnItemEx("PlayerRocketTrailFire_Modded", -15)
		MDY5 A 0
		MDY5 A 0 A_SpawnItemEx("ControlledRocketTrail_Modded", -15,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION, 128)
		MDY5 A 1 Bright Light("YellowMediumPoint2") A_CountDown
		Loop

	PerformCluster:
		TNT1 A 0 A_CheckFloor("PerformPlane")
		TNT1 A 0 A_CheckCeiling("PerformPlane")
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, 150,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, 210,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, 110,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, 250,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Goto AfterClusterCheck

	PerformPlane:
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, -45,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0,  45,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0, 135,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		TNT1 A 0 A_SpawnItemEx("RLClusterRocket_Modded", 0,0,0, 10,0,0,-135,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Goto AfterClusterCheck

	AfterClusterCheck.Skin:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/RocketExplo_Modded",CHAN_5|CHAN_NOPAUSE)
		Goto Super::AfterClusterCheck.Skin+2

	DeathFX.Skin:
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris_Modded",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle_Modded",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion_Modded",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Goto Super::DeathFX.Skin+7
	}
}

Actor RLClusterRocket_Modded : RLClusterRocket
{
	Decal "MDRLClusterScorch"
	States
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("ClusterRocketTrailFire_Modded",-4,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MDX5 A 1 A_SeekerMissile(15,16,SMF_LOOK|SMF_PRECISE ,0,0)
		MDX5 A 1
		MDX5 A 0 A_CountDown
		Loop

	DeathFX.Skin:
		TNT1 A 0 A_PlaySound("QC/Weapons/RocketLauncher/ClusterExplo_Modded",CHAN_5,0.4,0,1.5)
		TNT1 A 3 A_SpawnItemEx("GBSwarmExplo_Modded",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

