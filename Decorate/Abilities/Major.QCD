// --------------------------------------------------------------------------
//
// Major's abilities
//
// Active:	Air strike
//			Places deacons on the floor that are air striken shortly
//
// Passive:	Wall Climb
//			Holding jump allows major to climb some walls for a short
//			period of time
//
// Passive:	Tall, Lean and Mean
//			Major has a narrower hitbox for a "heavy" class and she's
//			able to climb slighly higher stair steps / Obstacles
//
// --------------------------------------------------------------------------

Actor CompatVer30_Major {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor MajorAirStrikeProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_FireCustomMissile("StrikeSetter",0,0,0)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_PlaySound("QC/Abilities/Major/Confirm",CHAN_WEAPON)	//confirmation sound
		Stop
	}
}
Actor MajorAirStrikeShortProc : CustomInventory //for when she ded
{
	States
	{
	Pickup:
		TNT1 A 0 A_FireCustomMissile("StrikeSetterShort",random(0,359),0,0)
		Stop
	}
}

//main actor
Actor StrikeSetter : FastProjectile
{
	Radius 3
	Height 3
	Speed 768
	+THRUACTORS
	Damage 0
	+BLOODLESSIMPACT
	+Bright
	+SKYEXPLODE
	ReactionTime 2	//2*768= Max range of 1536
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_StrikeSetter")
	Flight:
		PLAY A 1 ACS_NamedExecuteWithResult("QCDE_StrikeSetter")
		PLAY A 0 A_CountDown
		Loop
	Death:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_StrikeSetter")
		TNT1 A 0 A_SpawnItemEx("AirStrikeTargetCircle",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS,0,tid)
		TNT1 A 20 A_SpawnItemEx("AirStrikeTargetRocket",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS,0,tid)
		TNT1 A 10
		Stop
	}
}

Actor StrikeSetterShort : StrikeSetter
{
	Speed 500
	ReactionTime 1	//500 units
}

//circles on the floor, FX only
Actor AirStrikeTargetCircle
{
	Radius 2
	Height 2
	Gravity 300.0 //in net games this thing just floats in the middle despite being a floorhugger
	+THRUACTORS
	+BRIGHT
	+FORCEXYBILLBOARD
	+FLOORHUGGER
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[2.0,0.0,0.2]"
	XScale 1.6
	YScale 0.4
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_BombIncoming")
		X060 A 42 Bright
		X060 A 2 Bright A_FadeOut(0.05)
		Wait

	}
}
//Rocket icon on the floor, it actually does the special behaviour
Actor AirStrikeTargetRocket : AirStrikeTargetCircle
{
	var int user_counter;
	RenderStyle Add
	+FORCERADIUSDMG
	-FORCEXYBILLBOARD
	+FORCEYBILLBOARD
	Scale 0.5
	+SEEKERMISSILE
	+EXTREMEDEATH
	Projectile
	-NOGRAVITY
	+DONTBLAST
	Obituary "$OB_AirStrikeTargetRocket" // "%o was starstruck by %k."
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_BombIncoming")
		TNT1 A 0 A_PlaySound("QC/Abilities/Major/Whistle",CHAN_6,0.8,0,1.3)
		QP26 X 52 Bright A_Gravity
		TNT1 A 0 A_SetUserVar(user_counter,8)
		Goto Looper
	Looper:
		//	"Michaelis, you sly fox, I understand your unquenchable desire for sqrts, but two sqrts!?
		//	You have really outdone yourself this time."
		// OK, actually, user_counter is raised to the power of 5/4, to honor an eponymous Rammstein instrumental of same measure.
		// Counter is also passed down as angle measure to make upper smokes disappear faster.
		PLAY A 0 A_SpawnItemEx("StrikeTrail",  0,0,user_counter*sqrt(sqrt(user_counter))*50, 0,0,0, user_counter*1.1,SXF_NOCHECKPOSITION|SXF_ABSOLUTEANGLE|SXF_NOUNLAGGED)
		QP26 X 0 A_SetUserVar(user_counter,user_counter-1)
		TNT1 A 0 A_JumpIf(user_counter>0,"Looper")
		Goto Continuer

	Continuer:
		TNT1 A 0 A_ChangeFlag("NOGRAVITY",1)
		TNT1 A 0 A_Quake(5,17,0,512,"")
		TNT1 A 0 A_SpawnItemEx("AirStrikeExplosionSpawner", 0,0,20, 0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)	//hack to make it spawn in net games
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_JumpIfInTargetInventory("DMToken",1,"DM")
	PvE:
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,537)
		TNT1 A 0 A_Warp(AAPTR_DEFAULT, 0,0,40)	//rises up a bit to avoid being blocked by a single "stair step" or w/e
		TNT1 A 0 A_Jump(256,"ContinuePvE") //for virtual jump to inherited versions
		Goto ContinuePvE

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"ContinuePvE") //for virtual jump to inherited versions
			Goto ContinuePvE
	ContinuePvE:
		TNT1 A 0 A_Explode(65,256,1)	//self damage
		TNT1 A 0 A_RadiusThrust(31,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//extra thrust because damage thrust alone is not enough
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(500,32,0)	//Center of the explosion, "direct hit" of the rocket
		TNT1 A 0 A_Explode(random(50,70)*10,384,0)	//big explosion
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto CommonEnd


	DM:
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHitDM",360,JLOSF_PROJECTILE,716)
		TNT1 A 0 A_Jump(256,"ContinuePvE") //for virtual jump to inherited versions
		Goto ContinuePvE

		RadiusHitDM:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"ContinueDM") //for virtual jump to inherited versions
			Goto ContinueDM
	ContinueDM:
		TNT1 A 10 A_Explode(30,384,1,0,128)	//self damage and to others
		TNT1 A 0 A_RadiusThrust(66,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//extra thrust because damage thrust alone is not enough
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0  A_Explode(40,384,0,0,128)	//damage to others
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)

	CommonEnd:
		TNT1 A 3 Light(YellowBigFlicker1)
		TNT1 A 3 Light(YellowBigFlicker2)
		TNT1 A 3 Light(YellowBigFlicker3)
		TNT1 A 3 Light(YellowMediumFlicker1)
		TNT1 A 3 Light(YellowMediumFlicker2)
		TNT1 A 3 Light(YellowMediumFlicker3)
		TNT1 A 3 Light(YellowSmallFlicker1)
		TNT1 A 3 Light(YellowSmallFlicker2)
		TNT1 A 3 Light(YellowSmallFlicker3)
		TNT1 A 70
		Stop
	}
}

//crappy hack for net games, does the explosion FX and the sounds
Actor AirStrikeExplosionSpawner
{
	+NOINTERACTION
	+SERVERNETID
	Radius 1
	Height 1
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_SpawnItemEx("AirStrikeExplosion",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("quake4/Misc/Explo",CHAN_5,1.0,0,0.5)
		TNT1 A 10 A_PlaySound("quake4/Misc/GrenadeExplo",CHAN_6,0.8,0,0.5)
		Stop
	}
}

Actor AirStrikeExplosion
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	Scale 0.3
	States
	{
	Spawn:
		X125 AA 1 NODELAY Bright A_SetScale(scalex+0.2)
		X125 BB 1 Bright A_SetScale(scalex+0.15)
		X125 CC 1 Bright A_SetScale(scalex+0.1)
		X125 DEFGHIJKLMNOPQR 2 Bright A_SetScale(scalex*1.07)
		Stop
	}
}

Actor StrikesCounter : Inventory
{
	Inventory.InterHubAmount 0
	Inventory.MaxAmount 4
}



Actor StrikeTrail	//that spawns fire and smoke for trail
{
	Radius 2
	Height 2
	RenderStyle None
	+NOINTERACTION
	+NONETID
	States
	{
	Spawn:
		PLAY A 0 NODELAY A_SpawnItemEx("AirStrikeFireTrail",  0,0,0, 0,0,0, angle,SXF_NOCHECKPOSITION|SXF_ABSOLUTEANGLE|SXF_NOUNLAGGED)
		PLAY A 0 A_SpawnItemEx("AirStrikeSmokeTrail", 0,0,0, 0,0,0, angle,SXF_NOCHECKPOSITION|SXF_ABSOLUTEANGLE|SXF_NOUNLAGGED)
		PLAY A 3
		Stop
	}
}

Actor AirStrikeFireTrail : PlayerRocketTrailFire
{
	Scale 0.8
}
Actor AirStrikeSmokeTrail	//centered smoke
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Translucent
	Alpha 0.23
	Scale 0.0
	States
	{
	Spawn:
		TNT1 A 0 NoDelay
		TNT1 A 0 A_FadeOut(angle * 0.02)
		TNT1 A 0 A_Jump(256,1,2,3,4)
		X037 A 0 A_SetScale(frandom(0.3,0.5)) Goto Missile
		X037 B 0 A_SetScale(frandom(0.3,0.5)) Goto Missile
		X037 C 0 A_SetScale(frandom(0.3,0.5)) Goto Missile
		X037 D 0 A_SetScale(frandom(0.3,0.5)) Goto Missile
	Missile:
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.1)	"####" "#" 0 A_FadeIn(0.02)
	Continue:
		"####" "#" 1 A_FadeOut(0.025)
		"####" "#" 1 A_SetScale(ScaleX+0.1)
		Loop
	}
}

//--------------------------------------------------------
// Passive 1
// Wall Climber
//--------------------------------------------------------
Actor MajorClimbing : Token {}

Actor MajorClimbProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("MajorClimbing")
		TNT1 A 0 A_GiveInventory("PowerMajorFlight")
		Stop
	}
}

Actor PowerMajorFlight : PowerFlight {}

Actor MajorDropProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("MajorClimbing")
		TNT1 A 0 A_TakeInventory("PowerMajorFlight")
		Stop
	}
}
