// Freeman
ABILT122 = "Antigravity Discharge";
ABILT222 = "Pushes nearby monsters and projectiles\n"
           "away from you.";
ABILT322 = "Extraction";
ABILT422 = "When near death, Freeman is forcibly\n"
           "extracted and placed into a random location\n"
           "by his overseer. This is active once per life,\n"
           "and only after 120 seconds after spawning.\n"
           "Inventory is lost in PVP.";
ABILT522 = "Crouch Slide";
ABILT622 = "Hold \c[gold]crouch\c[green] when landing on the floor to gain\n"
           "a moderate bug long speed boost.";


// VorMatur
ABILT123 = "Horror";
ABILT223 = "Casts a projectile that blinds champions and\n"
           "causes fear on monsters.";
