Actor RGPierceBeamProjectile
{
	Projectile
	Radius 1
	Height 1
	ReactionTime 6
	+NOINTERACTION
	+EXTREMEDEATH
	+NODAMAGETHRUST
	Speed 50
	Scale 1.0
	RenderStyle None
	DamageType "NoDamageToPlayers"
	ProjectileKickBack 0
	+DONTBLAST
	States
	{
	Spawn:
		PLAY A 0 NODELAY
		Goto DoExplode

	DoExplode:
		PLAY A 0 A_Explode(random(50,100),64,0,0,64)
		PLAY A 0 A_Jump(256, "DoFX")
		Goto DoFXInvis

    DoFXInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DoFX:
		PLAY A 1 A_SpawnItemEx("RailgunPierceTrail",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		PLAY A 0
		Goto DoCountdown

	DoCountdown:
		PLAY A 0 A_Countdown
		PLAY A 0
		Goto DoExplode
	}
}

