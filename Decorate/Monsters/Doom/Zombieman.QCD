Actor QCZombieman : QCDE_MonsterSmall 15417
{
	//$Angled
	//$Category "QCDE Monsters: Doom"
	//$Color 12
	//$Title "Zombieman"
	Tag "$TAG_QCZombieman" // "Zombieman"

	Health 20
	Radius 20
	Height 56
	Speed 8
	PainChance 200
	Monster
	+FLOORCLIP
	SeeSound "grunt/sight"
	AttackSound "grunt/attack"
	PainSound "grunt/pain"
	DeathSound "grunt/death"
	ActiveSound "grunt/active"
	Obituary "$OB_ZOMBIE"
	States
	{
	Idle:
		POSS AB 10 A_Look
		Loop
	See:
		POSS AABBCCDD 4 A_Chase
		Loop
	Missile:
		POSS E 10 A_FaceTarget
		POSS F 8 A_PosAttack
		POSS E 8
		Goto See
	Pain:
		POSS G 3
		POSS G 3 A_Pain
		Goto See
	DeathChecksDone:
		POSS H 5 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		POSS I 5 A_Scream
		POSS J 5 A_NoBlocking
		POSS K 5
		POSS L -1
		Stop
	XDeathChecksDone:
		POSS M 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		POSS M 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		POSS N 5 A_XScream
		POSS O 5 A_NoBlocking
		POSS PQRST 5
	Death.Corpse:
		POSS U -1
		Stop
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		POSS K 5
		POSS JIH 5
		Goto See

    Ice:	//needs this state to drop the "zombieammodropper"
		"####" "#" 0 A_GiveInventory("ImDead",1)
		"####" "#" 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait
	}
}