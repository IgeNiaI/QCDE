Actor QCBaronOfHell : QCDE_MonsterBig 15403
{
	//$Angled
	//$Category "QCDE Monsters: Doom"
	//$Color 12
	//$Title "Baron of Hell"
	Tag "$TAG_QCBaronOfHell" // "Baron of Hell"
	DropItem "Hourglass", 48

	Health 1000
	Radius 24
	Height 64
	Mass 1000
	Speed 8
	PainChance 50
	Monster
	+FLOORCLIP
	+BOSSDEATH
	SeeSound "baron/sight"
	PainSound "baron/pain"
	DeathSound "baron/death"
	ActiveSound "baron/active"
	Obituary "$OB_BARON"
	HitObituary "$OB_BARONHIT"
	Bloodcolor "2fce44"
	States
	{
	Idle:
		BOSS AB 10 A_Look
		Loop
	See:
		BOSS AABBCCDD 3 A_Chase
		Loop
	Melee:
	Missile:
		BOSS EF 8 A_FaceTarget
		BOSS G 8 A_BruisAttack
		Goto See
	Pain:
		BOSS H 2
		BOSS H 2 A_Pain
		Goto See
	DeathChecksDone:
		BOSS I 8
		BOSS J 8 A_Scream
		BOSS K 8
		BOSS L 8 A_NoBlocking
		BOSS MN 8
		BOSS O -1 A_BossDeath
		Stop
	Death.Corpse:
		BOSS O -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_SpawnItemEx("GibDropperMediumBig",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		BOSS O 8
		BOSS NMLKJI 8
		Goto See

	}
}

Actor QCBaronBall : BaronBall replaces BaronBall
{
	Damage (random(2,9)*8)
}