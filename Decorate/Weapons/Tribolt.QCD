		Goto IdleCont
	Idle.Upgraded.Modded:
		MDIE A 0 A_PlaySound("QC/Weapons/Tribolt/Idle_Modded",CHAN_WEAPON,1,1)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" A 3 A_WeaponReady
		"####" B 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" B 3 A_WeaponReady
		"####" C 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" C 3 A_WeaponReady
		"####" D 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" D 3 A_WeaponReady
		"####" E 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" E 3 A_WeaponReady
		"####" F 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" F 3 A_WeaponReady
		Goto Idle

		IdleCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
		ICFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ICFLooper")
			Goto Idle

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"Fire.Upgraded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 8, "Fire.SeriousSam")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 7, "Fire.HalfLife")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 6, "Fire.QCDE1")
		TNT1 A 0 A_JumpIfInventory("QCTriboltSkin", 5, "Fire.Quake4") // Fallback to another skin
