		Padding	0, 2					SelectedFontColor	Tan					Param	8
	}

	SubMenu {
		Pos		0, 60					Text				"Normal"			Background			BT28060
		Size	140, 30					Font				QCBGFONT			SelectedBackground	BT28060S
		Anchor	center, center			FontColor			Tan					Menu	Startgame
		Padding	0, 2					SelectedFontColor	Tan					Param	2
	}

	SubMenu {
		Pos		0, 95					Text				"Hard"				Background			BT28060
		Size	140, 30					Font				QCBGFONT			SelectedBackground	BT28060S
		Anchor	center, center			FontColor			Tan					Menu	Startgame
		Padding	0, 2					SelectedFontColor	Tan					Param	5
	}

	SubMenu {
