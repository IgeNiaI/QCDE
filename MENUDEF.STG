FreeformMenu "QCDE_OptionsGeneral"
{
	NoBackButton
	TopPadding 40
	DefaultSelection -2
	OverrideHeight 230

	Label {
		Static
		Background	"BackMenw"
		Pos		0, 20
		Size	450, 500
	}

	Label {
		Pos		-105, 20			Font		SmallFont
		Anchor	right, center		FontColor	DarkGray
		Text	"Player Name"
	}
	TextField {
		Pos		-99, 20			CVar				name		Background			TX27028
		Size	135, 14			Font				SmallFont	SelectedBackground	TX27028S
		Padding 3, 0			SelectedFontColor	Gray
		Anchor	left, center
	}

	Label {
		Pos		-105, 50			Font		SmallFont
		Anchor	right, center		FontColor	DarkGray
		Text	"Player Color"
	}
	Label {
		Pos		-83, 50				Background	COLRFRME
		Size	32, 32
		Anchor	center, center
	}
	ColorPicker {
		Pos		-83, 50				CVar				color
		Size	30, 30				SelectedForeground	COLRSELC, 32, 32
		Anchor	center, center
	}
	Label {
		Pos		-64, 50				Font		SmallFont
		Anchor	left, center		FontColor	DarkGray
		Text	"- how others see you"
	}

	Label {
		Pos		-105, 81			Font		SmallFont
		Anchor	right, center		FontColor	DarkGray
		Text	"Auto Taunt chance"
	}
	TextField {
		Pos		-87, 80			CVar				cl_autoTaunt	Background			TX05028
		Size	25, 14			Font				SmallFont		SelectedBackground	TX05028S
		Anchor	center, center	SelectedFontColor	Gray
		Padding	0, 1
	}
	Slider {
		Pos		-70, 80			CVar	cl_autoTaunt
		Size	105, 6			Range	0.0, 50.0, 1.0
		Anchor	left, center	MouseArea	105, 14
		Textures	SLIDER, SLIDERS, SLIDERSS, 8, 14
	}


	Label {
		Pos		80, 15				Font		SmallFont
		Anchor	left, center		FontColor	DarkGray
		Text	"Switch weapon"
	}
	Label {
		Pos		80, 25				Font		SmallFont
		Anchor	left, center		FontColor	DarkGray
		Text	"on pickup"
	}
	Option {
		Pos		185, 20				CVar				switchonpickup
		Size	14, 14				Values				QCDE_CheckText
		Anchor	right, center		BackgroundValues	QCDE_CheckBG
		MouseArea	105, 14			UnknownBackground	CHKBOX
									SelectedForeground	CHKBOXS, 14, 14
	}

	Label {
		Pos		80, 50				Font		SmallFont
		Anchor	left, center		FontColor	DarkGray
		Text	"Auto-open lootboxes"
	}
	Option {
		Pos		185, 50				CVar				cl_autoOpenLootboxes
		Size	14, 14				Values				QCDE_CheckText
		Anchor	right, center		BackgroundValues	QCDE_CheckBG
		MouseArea	105, 14			UnknownBackground	CHKBOX
									SelectedForeground	CHKBOXS, 14, 14
	}


	Label {
		Pos		-190, 110			Font		QCSMFONT
		Anchor	left, top			FontColor	Red
		Text	"--- WARNING ---"
	}
	Label {
		Pos		-190, 125			Font		SmallFont
		Anchor	left, top			FontColor	DarkRed
		Text	"Sending duplicate commands helps mitigate packet loss"
	}
	Label {
		Pos		-190, 135			Font		SmallFont
		Anchor	left, top			FontColor	DarkRed
		Text	"but increases outbound net traffic!"
	}
	Label {
		Pos		-190, 155			Font		SmallFont
		Anchor	left, top			FontColor	DarkRed
		Text	"You should only enable them if you're actually"
	}
	Label {
		Pos		-190, 165			Font		SmallFont
		Anchor	left, top			FontColor	DarkRed
		Text	"suffering from severe packet loss!"
	}

	Label {
		Pos		-190, 183			Font		SmallFont
		Anchor	left, top			FontColor	DarkGray
		Text	"Send duplicate commands"
	}
	Option {
		Pos		-190, 200			CVar				cl_packetdup		UnknownBackground	OP21028
		Size	105, 14				Values				ZA_PacketDupRate	SelectedBackground	OP21028S
		Anchor	left, center		Font				SmallFont			SelectedForeground	OP21028A, 119, 14
		Padding	3, 1				SelectedFontColor	Gray
	}


	Label {
		Pos		185, 105		Font		SmallFont
		Anchor	right, top		FontColor	Gray
		Text	"QC:DE Discord"
	}
	Label {
		Pos		185, 115		Font		SmallFont
		Anchor	right, top		FontColor	Cyan
		Text	"discord.gg/u4ptaMk"
	}


	Command {
		Pos		185, 140			Text				"Credits"
		Size	130, 14				Font				SmallFont
		Anchor	right, center		FontColor			Gray
		Padding	0, 0				SelectedFontColor	Brick
		Command	menu_help
	}

	Command {
		SafeCommand
		Pos		185, 160			Text				"Reset everything to defaults"
		Size	130, 14				Font				SmallFont
		Anchor	right, center		FontColor			Gray
		Padding	0, 0				SelectedFontColor	Brick
		Command	reset2defaults
	}

	Command {
		SafeCommand
		Pos		185, 180			Text				"Reset everything to last saved"
		Size	130, 14				Font				SmallFont
		Anchor	right, center		FontColor			Gray
		Padding	0, 0				SelectedFontColor	Brick
		Command	reset2saved
	}

	SubMenu {
		Pos		185, 200			Text				"All Engine options (old menu)"
		Size	130, 14				Font				SmallFont
		Anchor	right, center		FontColor			Gray
		Padding	0, 0				SelectedFontColor	Brick
		Menu	OptionsMenu
	}


	InsertFreeformMenu MainMenuTopBar
	InsertFreeformMenu QCDE_OptionsTabs
}

