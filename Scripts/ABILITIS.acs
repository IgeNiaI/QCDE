	if (GetNetworkState() == NETSTATE_CLIENT && PlayerNumber() != ConsolePlayerNumber())
		terminate;

	if (GetNetworkState() != NETSTATE_SERVER)
		extraAbilityData[PlayerNumber()] = true;
	int tid = 1000+64 + PlayerNumber();

	int posX = GetActorX(tid);
	int posY = GetActorY(tid);
	int posZ = GetActorZ(tid);

	SetPredictableValue(0, 0, 1);
	SetPredictableValue(0, 1, posX);
	SetPredictableValue(0, 2, posY);
	SetPredictableValue(0, 3, posZ);
	Teleport_NoFog(tid, 0, 0, FALSE);

	Thing_Remove(tid);
	SetNetworkReplicationFlags( NETREP_NOUNLAGGED );
	SpawnProjectile(0, "DireOrbExploder", 0, 0, 0, 0, 0);
	SetNetworkReplicationFlags( 0 );

	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	delay(1); //waits a bit
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("DireOrbTeleFogOutProc",1); //then spawns dire orb fog, which also plays sound
	SetNetworkReplicationFlags( 0 );
}

