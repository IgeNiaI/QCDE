#define HUNTER_TRACING_PERIOD 4
// Activator: hunter
Script "QCDE_Passive_Hunter" (void)
{
	int plrtid = ActivatorTid();
	if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
	{
		// Reset previous life's lessons
		if(GameType() <= GAME_NET_COOPERATIVE)
		{
			SetInventory("HunterQCBulletAmmo" ,0);
			SetInventory("HunterQCShellAmmo"  ,0);
			SetInventory("HunterQCNailAmmo"   ,0);
			SetInventory("HunterQCBoltAmmo"   ,0);
			SetInventory("HunterQCRocketAmmo" ,0);
			SetInventory("HunterQCCoilAmmo"   ,0);
			SetInventory("HunterQCSlugAmmo"   ,0);
			SetInventory("HunterQCBFGAmmo"    ,0);
			ACS("QCDE_UpdateBackpackStack");
		}

		while(GetActorProperty(0,APROP_HEALTH) > 0)
		{
			if(GameType() >= GAME_NET_DEATHMATCH) // PVP-only
			{
				SetActivator(plrtid, AAPTR_PLAYER_GETTARGET);
				if(ActivatorTid() && ActivatorTid() != plrtid)
				{
					// Activator: victim
					GiveInventory("HunterProjectionProc",1);
				}
				SetActivator(plrtid);
				// Activator: hunter
			}
			delay(1);
		}
	}
}

// Activator: dying enemy
#define HUNTER_LESSONS 10
str HunterLessons[HUNTER_LESSONS] = {
	"MaxHealthToken","MaxArmorToken",
	"HunterQCBulletAmmo" ,
	"HunterQCShellAmmo"  ,
	"HunterQCNailAmmo"   ,
	"HunterQCBoltAmmo"   ,
	"HunterQCRocketAmmo" ,
	"HunterQCCoilAmmo"   ,
	"HunterQCSlugAmmo"   ,
	"HunterQCBFGAmmo"    ,
};
int HunterLessonsAmount[HUNTER_LESSONS] = { 2,2, 1,1,1,1,1,1,1,1, };
str HunterLessonGFX[HUNTER_LESSONS] = {
	"HEALINCR","ARMOINCR",
	"AmmBullt",
	"AmmShell",
	"AmmNails",
	"AmmBolts",
	"AmmRockt",
	"AmmCoils",
	"AmmSlugs",
	"AmmBfugs",
};

#define MAX_LESSONS_PER_TIC 10
int lastlesson, lessonrn;
Script "QCDE_MonsterKill_QCHunter" (void)
{
	SetActivatorToTarget(0);
	// Activator: Player

	if(!CheckInventory("Class_Hunter")) terminate;

	if(lastlesson != Timer())
	{
		lastlesson = Timer();
		lessonrn = 0;
	}
	else if(lessonrn < MAX_LESSONS_PER_TIC)
		lessonrn++;

	if(!lessonrn) PlaySound(0, "QC/Abilities/Hunter/Learn", CHAN_7|CHAN_UI, 0.86, false, ATTN_NONE, true);

	int type = random(1, HUNTER_LESSONS) - 1;
	//log(n:0, s:" taking the ", s:HunterLessons[type], s:" lesson.");
	GiveInventory(HunterLessons[type],HunterLessonsAmount[type]);
	ACS("QCDE_UpdateBackpackStack");

	SetHudSize(2800,2100,true);
	SetFont(HunterLessonGFX[type]);
	HudMessage(s:"A"; HUDMSG_FADEOUT, HMID_HUNTER_LESSON + lessonrn, -1, 174.0, 1590.0 - lessonrn * 80.0, 0.1, 0.3);
}

Script "QCDE_PlayerKill_QCHunter" (void)
{
	SetActivatorToTarget(0);
	// Activator: Player

	if(!CheckInventory("Class_Hunter")) terminate;

	if(lastlesson != Timer())
	{
		lastlesson = Timer();
		lessonrn = 0;
	}
	else if(lessonrn < MAX_LESSONS_PER_TIC)
		lessonrn++;

	if(!lessonrn) PlaySound(0, "QC/Abilities/Hunter/Learn", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);

	int type = (random(1, HUNTER_LESSONS) - 1) % 2;
	//log(n:0, s:" taking the ", s:HunterLessons[type], s:" lesson.");
	GiveInventory(HunterLessons[type],HunterLessonsAmount[type]);

	SetHudSize(2800,2100,true);
	SetFont(HunterLessonGFX[type]);
	HudMessage(s:"A"; HUDMSG_FADEOUT, HMID_HUNTER_LESSON + lessonrn, -1, 174.0, 1590.0 - lessonrn * 80.0, 0.1, 0.3);
}

Script "QCDE_Traced" (void)
{
	if(GetActorPowerupTics(0, "PowerTraced")) terminate;
	if(CheckInventory("PowerGhostTint")) terminate;

	//Log(n:0, s:" starting getting traced");
	GiveInventory("GetTraced",1);
	int plr = PlayerNumber();
	ACS("QCDE_Traced_CLIENTSIDE");
	while(GetActorProperty(0,APROP_HEALTH) > 0 && GetActorPowerupTics(0, "PowerTraced")) delay(1);
}

Script "QCDE_Traced_CLIENTSIDE" (void) clientside
{
	int spectator = PlayerIsSpectator(CPN()); // Spectators can see
	int iam = CheckActorInventory(CPN()+1000, "Class_Hunter"); // Hunters can see

	if(!(spectator || iam)) terminate;

	int plr = PlayerNumber();
	int mine = CPN() == plr; // You can't see your own
	int spectatee = CheckPlayerCamera(CPN()) == 1000 + plr; // Nor your spectatee
	int team = !areEnemies(CPN(), plr); // Nor do you care about your team's

	if(mine || spectatee || team) terminate;

	while(GetActorProperty(0,APROP_HEALTH) > 0 && GetActorPowerupTics(0, "PowerTraced"))
	{
		int x = GetActorX(0);
		int y = GetActorY(0);
		int z = GetActorZ(0);
		int tid = UniqueTid();
		int a = GetActorAngle(0) >> 8;
		SpawnForced("HunterTrace", x,y,z, tid, a);

		SetStateByClass(tid);
		int translation = GetActorProperty(0, APROP_Translation);
		SetActorProperty(tid, APROP_Translation, translation);

		Thing_ChangeTID(tid,0); // free tid just in case
		//Log(n:0, s:" trace remaining tics: ", d:GetActorPowerupTics(0, "PowerTraced"));
		int t = 0;
		while(t ++< 1 + HUNTER_TRACING_PERIOD * 20 /-~ dist(GetActorVelX(0)>>16, GetActorVelY(0)>>16)) delay(1);
	}
}

function void SetStateByClass(int tid)
{
	SetActorProperty(tid, APROP_ScaleX, GetActorProperty(0, APROP_ScaleX));
	SetActorProperty(tid, APROP_ScaleY, GetActorProperty(0, APROP_ScaleY));

	if(CheckActorClass(0,"QCRanger"    )) { SetActorState(tid, "Ranger"    ); return; }
	if(CheckActorClass(0,"QCDoomslayer")) { SetActorState(tid, "Doomslayer"); return; }
	if(CheckActorClass(0,"QCCorvus"    )) { SetActorState(tid, "Corvus"    ); return; }
	if(CheckActorClass(0,"QCKane"      )) { SetActorState(tid, "Kane"      ); return; }
