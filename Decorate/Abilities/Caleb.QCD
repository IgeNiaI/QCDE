// ----------------------------------------------------------------------------
//
// Caleb's abilities
//
// Active:	Voodoo Doll
//			If it hits an enemy, deals damage and you gain health
//			If it doesnt hit, will hurt you
//			Alt fire creates a projectil that goes through walls to deal damage
//
// Passive: Soul eater
//			Gains health when killing another player
//			By Michaelis
//			Also heal a bit when killing any monster
//			By DBT
//
// ----------------------------------------------------------------------------


//--------------------------------------------------------
// Active
//--------------------------------------------------------
Actor DollProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("CalebDoll", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_GiveInventory("ActiveInProgress", 1, 0, GIF_SKIPOWNER)
		TNT1 A 0 A_SelectWeapon("CalebDoll")
		TNT1 A 0 A_FireCustomMissile("DollSounder",0, false, 0, 0, FPF_NOUNLAGGED)
		Stop
	}
}

Actor DollCleanerProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_TakeInventory("CalebDoll", 0, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("CalebDollBot", 0, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("ActiveInProgress", 0, TIF_SKIPOWNER)
		TNT1 A 0 A_TakeInventory("VoodooedToken", 1, TIF_SKIPOWNER)
		TNT1 A 0 SetPlayerProperty(0,0,PROP_INSTANTWEAPONSWITCH)
		Stop
	}
}


Actor DollSounder	//literally just to play the ability sound
{
	Radius 1
	Height 1
	+NOINTERACTION
	+BRIGHT
	Projectile
	RenderStyle None
	Scale 0.5
	Alpha 0.99
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("QC/Abilities/Caleb/ActivateDrain",5,1.0,0,0.5)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Warp(AAPTR_TARGET, 0,-7, 45, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Warp(AAPTR_TARGET, 0,-7, 45, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION|WARPF_SKIPOWNER)
		Stop
	}
}



Actor CalebDoll : QCWeapon
{
	Weapon.Kickback 0
	Weapon.SelectionOrder 2000
	Obituary "%o was cursed by %k's voodoo magic."
	Tag "Voodoo Doll"
	+INVENTORY.UNDROPPABLE
	+WEAPON.MELEEWEAPON
	+WEAPON.CHEATNOTWEAPON
	States
	{
	Spawn:
		TNT1 A 0
		Stop
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 ACS_NamedExecuteAlways("CheckIfCorrectPlayer",0,7) // 7 = Caleb
	Readier:
		QW5I AAAA 4 A_WeaponReady(WRF_DISABLESWITCH)
		QW5I A 0 A_Jump(32,"Twitch")
		Loop
	Twitch:	//.tv/dbthanatos for fantastic QCDE streams!
		QW5I BCDEEEDCB 1 A_WeaponReady(WRF_DISABLESWITCH)
		Goto Readier
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		QW5I A 1 A_Raise
		"####" "########" 0 A_Raise
		Loop

	Deselect:
		TNT1 A 0 A_ZoomFactor(1.0)
		QW5I A 1 A_Lower
		Loop

	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	// Fire Seq, PvE animations and damage
	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	Fire:
		//QW5I A 0 A_Jump(255,"Crotch")
		QW5I A 3 A_Jump(255,"Chest","Chest","Chest","Chest","Eye","Eye","Crotch")
		Goto Chest

	// Animations
	Chest:	//17 tics
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMChest")
		TNT1 A 0 A_GunFlash("ChestFlash")
		QW5C ABB 1
		TNT1 A 0 A_GunFlash("PvEVoodooDMGcheck")
		QW5C C 2
		QW5C DE 1
		QW5C FGHI 2
		QW5I A 2
		Goto Readier

	Eye:	//21 tics
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMEye")
		TNT1 A 0 A_GunFlash("EyeFlash")
		QW5Y ABB 1
		TNT1 A 0 A_GunFlash("PvEVoodooDMGcheck")
		QW5Y C 2
		QW5Y DEFG 2
		QW5Y HIJ 2
		QW5I A 2
		Goto Readier

	Crotch:	//37 tics
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMCrotch")
		TNT1 A 0 A_GunFlash("CrotchFlash")
		QW5R ABB 1
		TNT1 A 0 A_GunFlash("PvEVoodooDMGcheck")
		QW5R C 2
		QW5R DEDEDE 4
		QW5R FGHI 2
		QW5I A 2
		Goto Readier

		//Damage
		ChestFlash:	//100dmg
			TNT1 A 0 A_FireBullets(sin(  0)*2.1  ,cos(  0)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 36)*2.1  ,cos( 36)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 72)*2.1  ,cos( 72)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(108)*2.1  ,cos(108)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(144)*2.1  ,cos(144)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*2.1  ,cos(180)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*2.1  ,cos(216)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*2.1  ,cos(252)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(288)*2.1  ,cos(288)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*2.1  ,cos(324)*2.1   ,-1,5 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 2 A_FireBullets(0             ,0              ,-1,50,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/DollFire",CHAN_WEAPON,0.9)
			Stop

		EyeFlash:	//120dmg
			TNT1 A 0 A_FireBullets(sin(  0)*2.1  ,cos(  0)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 36)*2.1  ,cos( 36)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 72)*2.1  ,cos( 72)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(108)*2.1  ,cos(108)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(144)*2.1  ,cos(144)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*2.1  ,cos(180)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*2.1  ,cos(216)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*2.1  ,cos(252)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(288)*2.1  ,cos(288)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*2.1  ,cos(324)*2.1   ,-1,6 ,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 2 A_FireBullets(0             ,0              ,-1,60,"QCVoodooPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/DollFire",CHAN_WEAPON,0.9)
			Stop

		CrotchFlash:	//240dmg
			TNT1 A 0 A_FireBullets(sin(  0)*2.1  ,cos(  0)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 36)*2.1  ,cos( 36)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 72)*2.1  ,cos( 72)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(108)*2.1  ,cos(108)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(144)*2.1  ,cos(144)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*2.1  ,cos(180)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*2.1  ,cos(216)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*2.1  ,cos(252)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(288)*2.1  ,cos(288)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*2.1  ,cos(324)*2.1   ,-1,12 ,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 2 A_FireBullets(0             ,0              ,-1,120,"QCVoodooPuffStun",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/DollFire",CHAN_WEAPON,0.9)
			Stop

	//PvE flash state to check if heal or damage
	PvEVoodooDMGcheck:
		TNT1 A 0 A_JumpIfInventory("VoodooedToken",1,"HealMePvE")
		DamageMePvE:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
			TNT1 A 0 A_SetBlend("880000",0.15,8)
			TNT1 A 0 DamageThing(5,0)
			Goto CommonEndFlash
		HealMePvE:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
			TNT1 A 0 A_SetBlend("00AA00",0.15,8)
			TNT1 A 0 ACS_NamedExecuteAlways("VoodooHealer",0,0,0,0)
			Goto CommonEndFlash

		CommonEndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_ZoomFactor(0.980)
			TNT1 A 1 A_ZoomFactor(0.984)
			TNT1 A 1 A_ZoomFactor(0.988)
			TNT1 A 1 A_ZoomFactor(0.992)
			TNT1 A 1 A_ZoomFactor(0.996)
			TNT1 A 1 A_ZoomFactor(1.00)
		EndFlashNoRecoil:
			TNT1 A 2 A_TakeInventory("VoodooedToken",1)
			Stop

	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	// Deathmatch version: All animations last 17tics and same damage on all of them.
	// This was done so that the PvP side of things does not rely on RNG
	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	DMChest:
		TNT1 A 0 A_GunFlash("PvPFlash")
		QW5C ABB 1
		TNT1 A 0 A_GunFlash("PvPVoodooDMGcheck")
		QW5C C 2
		QW5C DE 1
		QW5C FGHI 2
		QW5I A 2
		Goto Readier

	DMEye:
		TNT1 A 0 A_GunFlash("PvPFlash")
		QW5Y ABB 1
		TNT1 A 0 A_GunFlash("PvPVoodooDMGcheck")
		QW5Y C 2
		QW5Y DEFG 1
		QW5Y HIJ 2
		QW5I A 2
		Goto Readier

	DMCrotch:
		TNT1 A 0 A_GunFlash("PvPFlash")
		QW5R ABB 1
		TNT1 A 0 A_GunFlash("PvPVoodooDMGcheck")
		QW5R C 2
		QW5R D 2
		QW5R FGHI 2
		QW5I A 2
		Goto Readier

		PvPFlash:	//PvP 60dmg
			TNT1 A 0 A_FireBullets(sin(  0)*2.1  ,cos(  0)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_USEAMMO|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 36)*2.1  ,cos( 36)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin( 72)*2.1  ,cos( 72)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(108)*2.1  ,cos(108)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(144)*2.1  ,cos(144)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(180)*2.1  ,cos(180)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(216)*2.1  ,cos(216)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(252)*2.1  ,cos(252)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(288)*2.1  ,cos(288)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_FireBullets(sin(324)*2.1  ,cos(324)*2.1   ,-1,2 ,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 2 A_FireBullets(0             ,0              ,-1,20,"QCVoodooPuff_DM",FBF_NOFLASH|FBF_NORANDOM|FBF_EXPLICITANGLE)
			TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/DollFire",CHAN_WEAPON,0.9)
			Stop

	//PvP flash state to check if heal or damage
	PvPVoodooDMGcheck:
		TNT1 A 0 A_JumpIfInventory("VoodooedToken",1,"HealMePvP")
		DamageMePvP:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
			TNT1 A 0 A_SetBlend("880000",0.3,7)
			TNT1 A 0 DamageThing(10,0)
			Goto CommonEndFlash
		HealMePvP:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,2)
			TNT1 A 0 A_SetBlend("00AA00",0.15,8)
			TNT1 A 0 ACS_NamedExecuteAlways("VoodooHealer",0,1,0,0)
			Goto CommonEndFlash


	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	// Alt Fire
	//------------------------------------------------------------------------------------
	//------------------------------------------------------------------------------------
	AltFire:
		//TNT1 A 0 A_PlaySound("QC/Abilities/Caleb/DollAltFire",CHAN_WEAPON)
		QW5I A 2
		QW5E ABCDEF 3
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PvP")

		PvE:
			QW5E G 3 A_FireCustomMissile("VoodooAltFireBall")
			Goto Resume
		PvP:
			TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_VoodooOwner")
			QW5E G 3 A_FireCustomMissile("VoodooAltFireBall_DM")
			Goto Resume
	Resume:
		QW5E HIJ 3
		QW5E J 2 Offset(0,42)
		QW5E J 2 Offset(0,52)
		Goto ReadyNot
	ReadyNot:
		TNT1 A 0 A_GiveInventory("DollSpent",1)
		TNT1 A 5 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
		Wait
	}
}


Actor VoodooedToken   : Token { Inventory.MaxAmount 1 Inventory.InterhubAmount 0 }
Actor DollSpent       : Token { Inventory.MaxAmount 1 Inventory.InterhubAmount 0 }

//-------------------------------------------------
// Primary fire stuff

Actor QCVoodooPuff
{
	+NOINTERACTION +NOTONAUTOMAP
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	+SERVERNETID
	Renderstyle Add
	Scale 0.35
	States
	{
	Spawn: //hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_GiveToTarget("VoodooedToken",1)
		Goto Crash
	XDeath: //hit bleeding actor
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_GiveToTarget("VoodooedToken",1)
		TNT1 A 10
		Stop
	Crash: //hit everything else
		TNT1 A 5
		//FX57 ABCD 1 Bright
		//FX57 EFGHIJ 2 Bright
		Stop
	}
}

Actor QCVoodooPuffStun : QCVoodooPuff
{
	DamageType "DollStun"
}

Actor QCVoodooPuff_DM : QCVoodooPuff
{
	-MTHRUSPECIES
}



//-------------------------------------------------
// Alt fire stuff

Actor VoodooAltFireBall
{
	Projectile
	+NOINTERACTION
	+MTHRUSPECIES
	Radius 1
	Height 2
	Speed 20
	Scale 3.0
	ReactionTime 12
	RenderStyle NONE
	States
	{
	Spawn:
		ACID F 0 NODELAY A_PlaySound("QC/Abilities/Caleb/DollAltFire",CHAN_AUTO,1.0,false,0.6)
	Looper:
		ACID F 3 Light("BlackBigPoint2") A_Explode(50,192,0,0,128)
		TNT1 A 0 A_CountDown
		Loop
	Death:
		TNT1 A 1 Light("BlackBigPoint3")
		TNT1 A 1 Light("BlackMediumPoint1")
		TNT1 A 1 Light("BlackMediumPoint2")
		TNT1 A 1 Light("BlackMediumPoint3")
		TNT1 A 1 Light("BlackSmallPoint1")
		TNT1 A 1 Light("BlackSmallPoint2")
		TNT1 A 1 Light("BlackSmallPoint3")
		Stop
	}
}


Actor VoodooAltFireBall_DM
{
	Projectile
	+NOINTERACTION
	Radius 1
	Height 2
	Speed 20
	Scale 3.0
	ReactionTime 30
	RenderStyle None
	DamageType "Voodoo"
	States
	{
	Spawn:
		ACID F 0 NODELAY A_PlaySound("QC/Abilities/Caleb/DollAltFire",CHAN_AUTO,1.0,false,0.6)
	Looper:
		TNT1 A 0 A_RadiusGive("VoodooVictimProc",128,RGF_PLAYERS|RGF_FORCESERVERSIDE)
		ACID F 1 Light("BlackBigPoint2") A_CountDown
		Loop
	Death:
		TNT1 A 1 Light("BlackBigPoint3")
		TNT1 A 1 Light("BlackMediumPoint1")
		TNT1 A 1 Light("BlackMediumPoint2")
		TNT1 A 1 Light("BlackMediumPoint3")
		TNT1 A 1 Light("BlackSmallPoint1")
		TNT1 A 1 Light("BlackSmallPoint2")
		TNT1 A 1 Light("BlackSmallPoint3")
		Stop
	}
}

Actor VoodooVictimProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_VoodooVictim")
		Stop
	}
}



//--------------------------------------------------------
// Passive
//--------------------------------------------------------




Actor CalebHeartDM : CustomInventory
{
	+SERVERNETID
	// var int user_counter; // GZDoom find this ambiguous
	Height 40
	Radius 20
	Scale 0.8
	Inventory.PickupSound "QC/Abilities/Caleb/Ability"
	Inventory.PickupMessage "$GOT_CalebHeartDM" // "Picked up a life essence!"
	VisibleToPlayerClass QCCaleb
	+DROPPED
	States
	{
	Spawn:
		//13*40tics = 520, ~15sec
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		HART ABCDABCD 5 BRIGHT
		Goto FadeOut
	FadeOut:
		HART AAAAABBBBBCCCCCDDDDD 1 BRIGHT A_FadeOut
		Stop
	Pickup:
		TNT1 A 0 A_JumpIfInventory("Class_Caleb",1,"Success")
		Fail
	Success:
		TNT1 A 0 A_SetBlend("FF 88 88", .15, 5)
		TNT1 A 0 ACS_NamedExecuteWithResult("HealthGiver",CallACS("MaxHealth"),20, 75)
		Stop
	}
}
Actor CalebHeartSP : CalebHeartDM
{
	Inventory.PickupMessage "$GOT_CalebHeartSP" // "Picked up a small life essence!"
	Scale 0.4
	States
	{
	Success:
		TNT1 A 0 A_SetBlend("FF 88 88", .15, 5)
		TNT1 A 0 ACS_NamedExecuteWithResult("HealthGiver",CallACS("MaxHealth"),random(3,8), 100)
		Stop
	}
}









Actor DollBotProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_GiveInventory("CalebDollBot")
		TNT1 A 0 A_GiveInventory("ActiveInProgress")
		TNT1 A 0 A_SelectWeapon("CalebDollBot")
		TNT1 A 0 A_FireCustomMissile("DollSounder",0, false)
		Stop
	}
}



