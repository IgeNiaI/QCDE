//===========================================================================
//===========================================================================

Actor Q2Hover : QCDE_MonsterMedium	15207	// cacodemon
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 350
	Speed 8
	Radius 20
	Height 56
	PainChance 128
	Mass 400
	Scale 0.55
	REACTIONTIME 8
	MONSTER
	+NOGRAVITY
	+FLOAT
	+NOBLOOD
	Tag "$TAG_Q2Hover" // "Icarus"
	SeeSound "q2hover/sight"
	PainSound "q2hover/pain"
	DeathSound "q2hover/death"
	ActiveSound "q2hover/search"
	Obituary "$OB_Q2Hover" // "%o was blasted by a hover."
	States
	{
	Idle:
		HVRW A 0 A_PlaySound("q2hover/flying",6,0.4,0,4)
		HVRW ABCDEFGHIJK 7 A_Look
		Loop
	See:
		HVRW ABCDEFGHIJK 7 A_Chase
		Loop
	Missile:
		HVRA ABCD 4 A_FaceTarget
		HVRA EE 4 bright A_CustomMissile("HoverBeam", 24, 0, 0, 1)	HVRA E 0 A_FaceTarget
		HVRA EE 4 bright A_CustomMissile("HoverBeam", 24, 0, 0, 1)	HVRA E 0 A_FaceTarget
		HVRA EE 4 bright A_CustomMissile("HoverBeam", 24, 0, 0, 1)	HVRA E 0 A_FaceTarget
		HVRA EE 4 bright A_CustomMissile("HoverBeam", 24, 0, 0, 1)	HVRA E 0 A_FaceTarget
		HVRA FGH 4 A_FaceTarget
		Goto See
	Pain:
		HVRP A 4 A_Pain
		Goto See
	DeathChecksDone:
		HVRD A 0 A_Scream
		HVRD A 0 A_StopSound(6)
		HVRD A 6 A_ChangeFlag("THRUACTORS",1)
		HVRD B 6 A_Fall

		FallingLoop:
			HVRD B 1 A_CheckFloor("Crashing")
			Loop

	Crashing:
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
		HVRD DEFGHIJ 3
		TNT1 A 0 A_PlaySound("q2weapon/rocketexplo",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 AAAAAA 0 A_TossGib
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",0,0,20,0,0,0,0,SXF_NOCHECKPOSITION)
	Death.Corpse:
		TNT1 A 10
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_PlaySound("q2weapon/rocketexplo",7)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",0,0,20,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAAA 0 A_TossGib
		TNT1 A 10 A_Fall
		Stop
	}
}

Actor HoverBeam
{
	+FORCEXYBILLBOARD
	Mass 1
	Radius 8
	Height 6
	Speed 25
	Damage (random(2,8)*2)
	Scale 0.2
	SeeSound "q2hover/blasterattack"
	DeathSound "q2weapon/laserhit"
	Translation "0:255=%[0,0,0]:[1.0,0.5,0.08]"
	PROJECTILE
	RenderStyle Add
	States
	{
	Spawn:
		SPIR P 1 Light("OrangeSmallPoint1") Bright
		Loop
	Death:
		TNT1 AA 0 A_SpawnItemEx("EnforcerBeamExtra",0,0,0,frandom(0.2,1.5),0,frandom(1.5,-1.5),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SetScale(0.65)
		R058 F 3 Bright Light("OrangeMediumPoint2")
		R058 G 3 Bright Light("OrangeMediumPoint3")
		R058 H 3 Bright Light("OrangeSmallPoint1")
		R058 I 3 Bright Light("OrangeSmallPoint2")
		R058 J 3 Bright Light("OrangeSmallPoint2")
		R058 K 3 Bright Light("OrangeSmallPoint3")
		Stop
	}
}


