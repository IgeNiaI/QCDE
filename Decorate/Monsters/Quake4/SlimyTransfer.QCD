//=====================================================================================
//=====================================================================================
//
//=====================================================================================
//=====================================================================================
Actor Q4SlimyTransfer : QCDE_MonsterSmall	15321	//Imp
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 56
	Mass 100
	Health 60
	PainChance 128
	Speed 11
	Scale 0.402
	MeleeDamage 1
	+FLOORCLIP
	SeeSound "quake4/SlimyTrans/See"
	PainSound "quake4/SlimyTrans/Pain"
	DeathSound "quake4/SlimyTrans/Death"
	ActiveSound "quake4/SlimyTrans/Idle"
	Obituary "$OB_Q4SlimyTransfer" // "%o was melted by a Slimy Transfer with his acidic vomit."
	HitObituary "$OBH_Q4SlimyTransfer" // "A slimy transfer somehow killed %o with a headbutt."
	Tag "$TAG_Q4SlimyTransfer" // "Slimy Transfer"
	States
	{
	Idle:
		Q18I A 5 A_Look
		Loop
	See:
		Q18W ABCDEFGH 4 A_Chase
		Loop
	Melee:
		Q18M AABBC 3 A_FaceTarget
		TNT1 A 0 A_CustomMeleeAttack(random(10,30),"quake4/Misc/MeleeHit","quake4/Misc/Swing","Normal",1)
		Q18M D 7
		Q18M EF 5
		Goto See

	Missile:
		TNT1 A 0 A_PlaySound("quake4/SlimyTrans/Vomiting",6)
		TNT1 A 0 A_JumpIfCloser(190,"StreamofVomit")
		Q18A ABBB 4 A_FaceTarget
		TNT1 A 0 A_CustomMissile("SlimyTransfPuke1",34,3,0)
		Q18A CCDD 4
		Goto See

	StreamofVomit:		//attractive names :D
		Q18A ABBB 4 A_FaceTarget
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		TNT1 A 0 A_FaceTarget
		Q18A CC 2 A_CustomMissile("SlimyTransfPuke2",34,3,random(5,-5))
		Q18A DD 4
		Goto See

	Pain:
		Q18P A 8 A_Pain
		Goto See
	DeathChecksDone:
		Q18D A 0 A_Scream
		TNT1 A 0 A_UnsetSolid
		Q18D A 0 A_Fall
		Q18D AC 4
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Small",5)
		Q18D EG 4
	Death.Corpse:
		Q18D I -1
		Stop
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q18D IHGFEDCBA 4
		Goto See
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	}
}

//*********************************
Actor SlimyTransfPuke1
{
	Mass 1
	Radius 8
	Height 6
	Speed 16
	Damage (random(2,9)*3)
	Scale 0.7
	PROJECTILE
	PoisonDamage 10
	RenderStyle Add
	DeathSound "quake4/SlimyTrans/VomitSplash"
	Translation "0:255=%[0,0,0]:[0.7,1,0.1]"
	+FORCEXYBILLBOARD
	States
	{
		Spawn:
			X027 ABCDEFGHIJK 2 Bright A_SpawnItemEx("BSSpitExtra",0,0,0, 0,0,frandom(0,-1),0,SXF_NOCHECKPOSITION,180)
			Loop
		Death:
			TNT1 AAA 0 A_SpawnItemEx("BSSpitExtra",0,0,0,frandom(1,-1),frandom(1,-1),frandom(0,2),0,0)
			VOM2 A 1 Bright A_FadeOut
			Wait
	}
}

//*********************************
Actor SlimyTransfPuke2
{
	Mass 1
	Radius 8
	Height 6
	Speed 15
	Damage 1
	+STRIFEDAMAGE
	Scale 0.15
	PROJECTILE
	-NOGRAVITY
	PoisonDamage 5
	RenderStyle Add
	DeathSound "quake4/SlimyTrans/VomitSplash"
	Translation "0:255=%[0,0,0]:[0.7,1,0.1]"
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		VOM2 ABCDEF 4 Bright
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("STroopGrenTrailGas",0,0,5,0,0,frandom(0,0.5),0,0)
		VOM2 A 1 A_FadeOut
		Wait
	}
}




