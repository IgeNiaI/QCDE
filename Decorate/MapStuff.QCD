//--------------------------------------------------------------
//	These actors are invisible without the voxel addon pack.
//  However, with the voxels, it will show a physical base
//  for the weapons, by Ivory Duke
Actor SpawnVoxBase_Base
{
	+BRIGHT
	+CLIENTSIDEONLY
	States
	{
	Spawn:
		VXZZ A -1 A_Gravity	//this isnt really needed, but is to allow "two line actors" below
		Stop
	}
}

Actor SpawnVoxBase_HMG : SpawnVoxBase_Base { States { Spawn: VXMG A -1 A_Gravity Stop } }
Actor SpawnVoxBase_SSG : SpawnVoxBase_Base { States { Spawn: VXSG A -1 A_Gravity Stop } }
Actor SpawnVoxBase_SNG : SpawnVoxBase_Base { States { Spawn: VXNG A -1 A_Gravity Stop } }
Actor SpawnVoxBase_TB  : SpawnVoxBase_Base { States { Spawn: VXTB A -1 A_Gravity Stop } }
Actor SpawnVoxBase_RL  : SpawnVoxBase_Base { States { Spawn: VXRL A -1 A_Gravity Stop } }
Actor SpawnVoxBase_LG  : SpawnVoxBase_Base { States { Spawn: VXLG A -1 A_Gravity Stop } }
Actor SpawnVoxBase_RG  : SpawnVoxBase_Base { States { Spawn: VXRG A -1 A_Gravity Stop } }
Actor SpawnVoxBase_BFG : SpawnVoxBase_Base { States { Spawn: VXBF A -1 A_Gravity Stop } }


