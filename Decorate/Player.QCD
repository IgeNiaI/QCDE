	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP06 A 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP06 A 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP06 A 0 A_JumpIf(true,                   "DefSpawn")
		QP06 A 100
		Loop

		ColoredSpawn:
			RP06 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP06 A 4
			Loop
		DefSpawn:
			QP06 A 0 A_JumpIf(momx||momy,"DefSee")
			QP06 A 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP06 ABCD 4
			RP06 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP06 ABCD 4
			QP06 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP06 E 12
			RP06 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP06 E 12
			QP06 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP06 F 6 BRIGHT Light("PlayerFiringLight")
			RP06 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP06 F 6 BRIGHT Light("PlayerFiringLight")
			QP06 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP06 G 4
			RP06 G 4 A_Pain
			RP06 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP06 G 4
			QP06 G 4 A_Pain
			QP06 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP06 H 5
		QP06 I 5 A_PlayerScream
		QP06 J 5 A_NoBlocking
		QP06 KLM 5
		QP06 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP06 O 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP06 P 5 //A_XScream
		QP06 Q 5 A_NoBlocking
		QP06 RSTUVW 5
		QP06 X -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
