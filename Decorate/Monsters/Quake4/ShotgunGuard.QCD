//=====================================================================================
//=====================================================================================
//
//=====================================================================================
//=====================================================================================
Actor Q4ShotgunGuard : QCDE_MonsterSmall	15320	//shotguy
{
	//$Angled
	//$Category "QCDE Monsters: Quake 4"
	//$Color 12
	Monster
	Radius 16
	Height 56
	Mass 100
	Health 40
	PainChance 200
	Speed 11
	Scale 0.47
	+FLOORCLIP
	SeeSound "quake4/StroggMarine/Sight"
	PainSound "quake4/StroggMarine/Pain"
	DeathSound "quake4/StroggMarine/Death"
	ActiveSound "quake4/StroggMarine/Idle"
	AttackSound "quake4/Weapons/Shotgun/Fire"
	Obituary "$OB_Q4ShotgunGuard" // "%o was shotgunned by a Strogg guard."
	DropItem "Shotgun"
	Tag "$TAG_Q4ShotgunGuard" // "Shotgun Guard"
	States
	{
	Idle:
		Q23I A 4 A_Look
		Loop
	See:
		Q23W AABBCCDD 3 A_Chase
		Loop
	Missile:
		Q21A A 0 A_PlaySound("quake4/StroggMarine/ReadyShotgun",6)
		Q23A ABBBBBB 4 A_FaceTarget(0,0)
		TNT1 A 0 A_SpawnItemEx("MonMuzzleFlashSmall",24,2,42,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAA 0 A_CustomMissile("MonsterTracerLowVol",32,random(3,-3),frandom(5,-5))
		TNT1 A 0 A_CustomBulletAttack(20,1,3,3)
		Q23A CCD 4 A_FaceTarget
		TNT1 A 0 A_Jump(170,"MissileEnd")
		TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
		Goto Missile+3
	MissileEnd:
		Q23A A 5
		Goto See
	Pain:
		Q23P A 8 A_Pain
		Goto See

	DeathChecksDone:
		Q23D A 0 A_Scream
		Q23D ACD 3
		Q23D A 0 A_Fall
		Q23D F 0 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q23D F -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake4/Misc/GibExplosion",7)
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q23D FEDCBA 3
		Goto See
	}
}
