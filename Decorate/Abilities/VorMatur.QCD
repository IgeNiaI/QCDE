}

Actor CorrosiveBloodProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"DMBlood")
		TNT1 A 0 A_ThrowGrenade("CorrosiveBlood", -15, random(-accuracy*3,accuracy*3),frandom(0,accuracy),0,TGR_NOUNLAGGED)	//in coop sprays farther
		Stop
	DMBlood:
		TNT1 A 0 A_Jump(128,"Nope")
		TNT1 A 0 A_ThrowGrenade("CorrosiveBloodDM", -15, random(-accuracy*2,accuracy*2),frandom(0,accuracy),0,TGR_NOUNLAGGED)
		Stop
	Nope:
		TNT1 A 0
		Stop
	}
}
