Actor Q2Makron : QCDE_MonsterBoss
{
	Health 2500
	Radius 25
	Height 65
	Scale 0.45
	Speed 6
	PainChance 25
	Mass 4000
	MONSTER
	+FLOORCLIP
	+MISSILEMORE
	+BOSSDEATH
	+BOSS
	+NORADIUSDMG
	+NOBLOOD
	+LOOKALLAROUND
	BloodColor "68 89 44"	//used for the gibblets
	Tag "$TAG_Q2Makron" // "Makron"
	SeeSound "q2makron2/voice"
	PainSound "q2makron1/pain"
	DeathSound "q2makron2/death"
	ActiveSound "q2makron2/seeking"
	Obituary "$OB_Q2Makron" // "%o met the leader of Stroggos."
	DropItem "BigHourglass"
	States
	{
	Idle:
		BS5I A 5 A_Look
		Loop
	See:
		BS5W AABBCCDDEE 3 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_Jump(64,"BFG")
		TNT1 A 0 A_Jump(256,"Railgun","Blaster")
	BFG:
		BS5B ABC 7 A_FaceTarget
		BS5B D 3 A_FaceTarget
		BS5B D 0 A_PlaySound("q2weapon/bfgball",7,1,0,0.7)
		BS5B D 0 A_CustomMissile("BFG10KShot",45,-7,0)
		BS5B EFG 7
		Goto See
	Railgun:
		BS5R E 0 A_PlaySound("q2weapon/railgunreload",4,1,0,0.5)
		BS5R A 0 A_TakeInventory("RailgunInterrupted",32767)
		TNT1 A 0 A_CustomMissile("RailgunChargeIndicatorQ2Makron")
		BS5R ABBBCD 6 A_FaceTarget
		TNT1 A 0 A_FaceTarget
		BS5R E 0 A_PlaySound("q2weapon/railgunfire",4,1,0,0.5)
		BS5R E 0 A_CustomRailgun(0,0,"None","None",RGF_SILENT|RGF_FULLBRIGHT,1,0,"None",0,0,2048,0,70.0,0,"Q2RailgunSmoke",10)
		BS5R E 7 A_CustomRailgun(90,0,"#4793a3","#cecfd1",RGF_SILENT|RGF_FULLBRIGHT,1,0,"RailgunPuff_Makron",0,0,2048,0,1.0,1.0,"None",10)
		BS5R FG 7 A_FaceTarget
		Goto See
	Blaster:
		BS5A AB 7 A_FaceTarget
		BS5A CC 0 A_CustomMissile("MakronBeam",40,10, 80+random(4,-4))	BS5A C 4 A_FaceTarget
		BS5A DD 0 A_CustomMissile("MakronBeam",40,10, 77+random(4,-4))	BS5A D 4 A_FaceTarget
		BS5A EE 0 A_CustomMissile("MakronBeam",40,10, 65+random(4,-4))	BS5A E 4 A_FaceTarget
		BS5A FF 0 A_CustomMissile("MakronBeam",40,10, 55+random(4,-4))	BS5A F 4 A_FaceTarget
		BS5A GG 0 A_CustomMissile("MakronBeam",40,10, 45+random(4,-4))	BS5A G 4 A_FaceTarget
		BS5A HH 0 A_CustomMissile("MakronBeam",40,10, 22+random(4,-4))	BS5A H 4 A_FaceTarget
		BS5A II 0 A_CustomMissile("MakronBeam",40,10,  0+random(4,-4))	BS5A I 4 A_FaceTarget
		BS5A JJ 0 A_CustomMissile("MakronBeam",40,10,-22+random(4,-4))	BS5A J 4 A_FaceTarget
		BS5A KK 0 A_CustomMissile("MakronBeam",40,10,-45+random(4,-4))	BS5A K 4 A_FaceTarget
		BS5A LL 0 A_CustomMissile("MakronBeam",40,10,-67+random(4,-4))	BS5A L 4 A_FaceTarget
		BS5A KK 0 A_CustomMissile("MakronBeam",40,10,-45+random(4,-4))	BS5A K 4 A_FaceTarget
		BS5A JJ 0 A_CustomMissile("MakronBeam",40,10,-22+random(4,-4))	BS5A J 4 A_FaceTarget
		BS5A II 0 A_CustomMissile("MakronBeam",40,10,  0+random(4,-4))	BS5A I 4 A_FaceTarget
		BS5A HH 0 A_CustomMissile("MakronBeam",40,10, 22+random(4,-4))	BS5A H 4 A_FaceTarget
		BS5A GG 0 A_CustomMissile("MakronBeam",40,10, 45+random(4,-4))	BS5A G 4 A_FaceTarget
		BS5A FF 0 A_CustomMissile("MakronBeam",40,10, 55+random(4,-4))	BS5A F 4 A_FaceTarget
		BS5A EE 0 A_CustomMissile("MakronBeam",40,10, 65+random(4,-4))	BS5A E 4 A_FaceTarget
		BS5A DD 0 A_CustomMissile("MakronBeam",40,10, 77+random(4,-4))	BS5A D 4 A_FaceTarget
		BS5A CC 0 A_CustomMissile("MakronBeam",40,10, 80+random(4,-4))	BS5A C 4 A_FaceTarget
		BS5A BA 8
		Goto See
	Pain:
		BS5P A 0 A_GiveInventory("RailgunInterrupted",1)
		BS5P A 0 A_StopSound(4) //stops railgun charge sound
		BS5P A 2
		BS5P A 5 A_Pain
		Goto See
	XDeathChecksDone:
	DeathChecksDone:
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		TNT1 A 0 A_SpawnItemEx("PContTorso",0,0,50, random(3,-3),random(3,-3),5,random(0,359),SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
		TNT1 A 0 A_GiveInventory("RailgunInterrupted",1)
		TNT1 A 0 A_StopSound(4) //stops railgun charge sound
		BS5D B 25 A_Scream
		BS5D C 20 A_Fall
		BS5D D 6
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
		BS5D EFGH 6
	Death.Corpse:
		BS5D H -1
		Stop
	}
}

Actor Q2RailgunSmoke : RailgunSmoke
{
	Translation "0:255=%[0,0,0]:[0.8,0.8,2]"
}

Actor RailgunPuffFxSmoke_Makron : RailgunPuffFxSmoke
{
	Translation "0:255=%[0,0,0]:[0.80,0.81,0.82]"
}

Actor RailgunPuff_Makron : RailgunPuff
{
	States
	{
	Crash:
		TNT1 A 0 A_SpawnItemEx("RailgunPuffFx_Makron", 5,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Goto Super::Crash+1
	}
}

Actor RailgunPuffFx_Makron : RailgunPuffFx
{
	Translation "0:255=%[0,0,0]:[0.27,0.57,0.63]"

	States
	{
	EndAnimation:
		"####" A 0 A_SpawnItemEx("RailgunPuffFxSmoke_Makron",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Goto Super::EndAnimation+1
	}
}

Actor RailgunChargeIndicatorQ2Makron : RailgunChargeIndicatorQ2Gladiator
{
	States
	{
	Spawn:
		X060 A 0 Bright NODELAY A_Warp(AAPTR_TARGET,20,2,55)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (1)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,20,2,55)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//Repeat of three prev frames (2)
		X060 A 0 Bright A_Warp(AAPTR_TARGET,20,2,55)
		X060 A 1 Bright A_SetScale(scalex-0.0194)
		X060 A 0 A_Countdown
		//so that it would check for this token ever 3 tics rather than every single tic
		X060 A 0 A_JumpIfInTargetInventory("RailgunInterrupted",1,"Death")
		Loop
	}
}

Actor MakronBeam
{
	Projectile
	Speed 30
	Damage 5
	Radius 5
	Height 10
	RenderStyle Add
	Scale 0.65
	Translation "0:255=%[0,0,0]:[2.0,1.0,0.2]"
	SeeSound "q2makron2/blasterattack"
	DeathSound "Quake2/Extra/TeslaImpact"
	States
	{
	Spawn:
		X020 ABCDEFGHIJKLMNOPQRST 2 Bright Light("OrangeMediumPoint3")
		Loop
	Death:
		X019 AB 2 Bright Light("OrangeMediumPoint3")
		X019 CDEF 2 Bright Light("OrangeMediumPoint2")
		X019 GH 2 Bright Light("OrangeMediumPoint3")
		X019 IJ 2 Bright Light("OrangeSmallPoint1")
		X019 KL 2 Bright Light("OrangeSmallPoint2")
		X019 MN 2 Bright Light("OrangeSmallPoint3")
		X019 OPQRS 2 Bright
		Stop
	}
}
