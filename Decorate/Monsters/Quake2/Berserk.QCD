
//===========================================================================
//===========================================================================

Actor Q2Berserker : QCDE_MonsterSmall	15201	// demon
{
	//$Angled
	//$Category "QCDE Monsters: Quake 2"
	//$Color 12
	Health 150
	Radius 20
	Height 56
	Scale 0.42
	Speed 12
	PainChance 150
	Mass 200
	MONSTER
	+FLOORCLIP
	Tag "$TAG_Q2Berserker" // "Berserker"
	SeeSound "q2berserker/sight"
	PainSound "q2berserker/pain"
	DeathSound "q2berserker/death"
	ActiveSound "q2berserker/idle"
	Obituary "$OB_Q2Berserker" // "%o was smashed by a berserker."
	MeleeDamage 8
	States
	{
	Idle:
		BERI A 10 A_Look
		Loop
	See:
        BERW AABBCCDDEEFF 2 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_Jump(128,"Melee2")
		TNT1 A 0 A_PlaySound("q2berserker/attack")
		BERA AB 5 A_FaceTarget
		BERA C 13 A_CustomMeleeAttack(random(10,32))
		BERA D 4
		Goto See
	Melee2:
		TNT1 A 0 A_PlaySound("q2berserker/attack")
		BERA EFG 4 A_FaceTarget
		BERA H 8 A_CustomMeleeAttack(random(10,32))
		BERA I 5
		Goto See
	Pain:
		BERP A 2
		BERP A 5 A_Pain
		Goto See
	DeathChecksDone:
		BERD A 0 A_Scream
		BERD A 4
		BERD B 4
		BERD C 4
		BERD D 4 A_Fall
		TNT1 A 0 A_PlaySound("quake4/Misc/Body/Beefy")
		BERD EFG 4
	Death.Corpse:
		BERD H -1
		Stop
	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("quake2/Misc/GibExplosion")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		BERD HGFEDCBA 6
		Goto See
	}
}