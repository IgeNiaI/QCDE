Script "QCDE_AwardArmorOverTime" (int amount)
{
	while(amount --> 0)
	{
		if(CheckInventory("BasicArmor") > CheckInventory("MaxArmorToken") + 50) terminate;
		GiveInventory("QCArmorPoint",1);
		if(amount < 25) delay(1);
	}
}



