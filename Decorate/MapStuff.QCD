Actor NyancodemonActivator 16561
{
	//$NotAngled
	//$Category "QCDE Map Decoration"
	//$Color 16
	//$Title "Nyancodemon Activator"
	+NOGRAVITY
	+THRUACTORS
	+NOTARGET
	+SHOOTABLE
	-COUNTKILL
	-SOLID
	-CANPUSHWALLS
	-CANUSEWALLS
	-ACTIVATEMCROSS
	Height 32
	Radius 16
	Health 1
	states
	{
	Spawn:
		TNT1 A 1
		Wait
	Death:
		TNT1 A 0 Thing_Activate(666)
		Stop
	}
}

Actor NyancodemonActivatorFlat : NyancodemonActivator 16562
{
	//$Title "Nyancodemon Activator Flat"
	Height 1
}

Actor Nyancodemon : SwitchableDecoration 16571
{
	//$NotAngled
	//$Category "QCDE Map Decoration"
	//$Color 16
	//$Title "Nyancodemon (switchable)"
	Speed 0
	+NOGRAVITY
	+THRUACTORS
	+NOINTERACTION
	+NOTARGET
	+FLOATBOB
	Monster
	-IsMonster
	-COUNTKILL
	-SOLID
	-CANPUSHWALLS
	-CANUSEWALLS
	-ACTIVATEMCROSS
	Height 56
	Radius 31
	Scale 0.55
	states
	{
	Spawn:
	Inactive:
		TNT1 A 5
		loop
	Active:
		HEAD A 0 A_Turn(1)
		HEAD A 1 BRIGHT A_ChangeVelocity(3,0,0,CVF_RELATIVE|CVF_REPLACE)
		TNT1 A 0 A_SpawnItemEx("RainbowTrail",-10,0,20,0,0,0,0,32)
		HEAD A 0 A_Turn(1)
		HEAD A 1 BRIGHT A_ChangeVelocity(3,0,0,CVF_RELATIVE|CVF_REPLACE)
		loop
	}
}


