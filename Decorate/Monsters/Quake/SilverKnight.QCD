//================================================================
//================================================================

Actor QSilverKnight : QCDE_MonsterMedium	15115	// revenant
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Translation "0:255=%[0.0,0.0,0.0]:[1.48,1.48,1.48]", "32:47=32:47", "176:191=176:191"
	Health 350
	Radius 20
	Height 56
	Speed 13
	PainChance 30
	Mass 300
	Scale 0.37
	MeleeDamage 5
	Monster
	MinMissileChance 255
	+FLOORCLIP
	SeeSound "Quake1/Knight/Idle"
	PainSound "Quake1/Knight/Pain"
	DeathSound "Quake1/Knight/Death"
	ActiveSound "Quake1/Knight/Idle"
	Tag "$TAG_QSilverKnight" // "Silver Knight"
	Obituary "$OB_QSilverKnight" // "%o was cleansed by a silver knight."
	HitObituary "$OBH_QSilverKnight" // "%o was sliced by a silver knight."
	States
	{
	Idle:
		Q33I A 0 A_Stop
		Q33I A 10 A_Look
		Wait
	See:
		TNT1 A 0 A_ChangeFlag("NODROPOFF",0)
		Q33W AB 3 A_Chase
		Q33W CDEF 3 A_Chase
		Loop
	Missile:
		TNT1 A 0 A_Jump(128,"Seekers")
		Q33A ABC 4 A_FaceTarget
		Q33A A 0 A_PlaySound("Quake1/SilverKnight/Cast2",6)
		Q33A C 6 A_Custommissile ("SilverKnightBall", 36, 0, 0)
		Q33A DE 4
		Goto See
	Seekers:
		Q33A ABC 4 A_FaceTarget
		Q33A A 0 A_PlaySound("Quake1/SilverKnight/Cast",6)
		Q33A C 4 A_Custommissile ("SilverKnightBallSeeker", 36, 0, 0)
		Q33A C 0 A_Custommissile ("SilverKnightBallSeeker", 36, 0, 15)
		Q33A C 4 A_Custommissile ("SilverKnightBallSeeker", 36, 0, -15)
		Q33A C 0 A_Custommissile ("SilverKnightBallSeeker", 36, 0, 30)
		Q33A C 4 A_Custommissile ("SilverKnightBallSeeker", 36, 0, -30)
		Q33A DE 4
		Goto See

	Melee:
		TNT1 A 0 A_ChangeFlag("NODROPOFF",1)
		Q33C A 0 A_Jump(256,"Melee1","Melee2")

		Melee1:
			Q33C A 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
			Q33C B 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_PlaySound("Quake1/Knight/Swing")
			Q33C C 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_FaceTarget
			Q33C D 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_FaceTarget
			Q33C E 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
			TNT1 A 0 A_FaceTarget	TNT1 A 0 A_PlaySound("Quake1/Knight/Swing")
			Q33C F 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
			Q33C G 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
			Q33C H 5 A_Recoil(-1.8)
			Goto See
		Melee2:
			Q33B A 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
			Q33B B 5 A_FaceTarget	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_FaceTarget	TNT1 A 0 A_PlaySound("Quake1/Knight/Swing")
			Q33B C 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_FaceTarget
			Q33B D 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-2)
			TNT1 A 0 A_FaceTarget
			Q33B E 5 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
			Q33B F 6 A_FaceTarget
			Goto See

	Pain:
		Q33P A 4
		Q33P A 4 A_Pain
		Goto See

	DeathChecksDone:
		Q33D A 0 A_Scream
		Q33D A 4
		Q33D B 4 A_Fall
		Q33D CDEFGH 4
		Q33D I 0 A_PlaySound("quake4/Misc/Body/Small")
	Death.Corpse:
		Q33D I -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q33D IHGFEDCBA 5
		Goto See
	}
}

Actor SilverKnightBall
{
	Projectile
	Speed 18
	Damage 13
	Radius 8
	Height 12
	RenderStyle Add
	Scale 0.47
	+SeekerMissile
	+FORCEXYBILLBOARD
	DeathSound "Quake1/SilverKnight/ProjectileImpact"
	Translation "0:255=%[0.0,0.0,0.0]:[1.0,1.0,1.5]"
	States
	{
	Spawn:
		DB50 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2 Bright Light("WhiteMediumPoint3")
		Loop
	Death:
		DB59 A 0 A_SetScale(0.62)
		DB59 A 2 Bright Light("WhiteMediumPoint3")
		DB59 B 2 Bright Light("WhiteMediumPoint2")
		DB59 C 2 Bright Light("WhiteMediumPoint3")
		DB59 D 2 Bright Light("WhiteSmallPoint1")
		DB59 E 2 Bright Light("WhiteSmallPoint2")
		DB59 F 2 Bright Light("WhiteSmallPoint3")
		DB59 GHIJKLMNOPQRS 2 Bright
		stop
	}
}

Actor SilverKnightBallSeeker
{
	Projectile
	Speed 14
	Damage 2
	Radius 8
	Height 12
	RenderStyle Add
	Scale 0.17
	+SeekerMissile
	+FORCEXYBILLBOARD
	DeathSound "Quake1/SilverKnight/ProjectileImpact"
	Translation "0:255=%[0.0,0.0,0.0]:[1.0,1.0,1.0]"
	States
	{
	Spawn:
		DB58 ABCDE 1 Bright Light("WhiteMediumPoint3")
		DB58 A 0 A_SeekerMissile(10,10,SMF_PRECISE|SMF_CURSPEED)
		DB58 A 0 A_SpawnItemEx("SilverKnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,128)
		DB58 FGHIJ 1 Bright Light("WhiteMediumPoint3")
		DB58 A 0 A_SeekerMissile(10,10,SMF_PRECISE|SMF_CURSPEED)
		DB58 A 0 A_SpawnItemEx("SilverKnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,128)
		DB58 KLMNO 1 Bright Light("WhiteMediumPoint3")
		DB58 A 0 A_SeekerMissile(10,10,SMF_PRECISE|SMF_CURSPEED)
		DB58 A 0 A_SpawnItemEx("SilverKnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,128)
		DB58 PQRST 1 Bright Light("WhiteMediumPoint3")
		DB58 A 0 A_SeekerMissile(10,10,SMF_PRECISE|SMF_CURSPEED)
		DB58 A 0 A_SpawnItemEx("SilverKnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,128)
		DB58 UVWXYZ 1 Bright Light("WhiteMediumPoint3")
		DB58 A 0 A_SeekerMissile(10,10,SMF_PRECISE|SMF_CURSPEED)
		DB58 A 0 A_SpawnItemEx("SilverKnightBallTrail",-3,0,0,frandom(0.5,-0.5),0,frandom(0.5,-0.5),0,33,128)
		Loop
	Death:
		DB59 A 0 A_SetScale(0.35)
		DB59 A 2 Bright Light("WhiteMediumPoint3")
		DB59 B 2 Bright Light("WhiteMediumPoint2")
		DB59 C 2 Bright Light("WhiteMediumPoint3")
		DB59 D 2 Bright Light("WhiteSmallPoint1")
		DB59 E 2 Bright Light("WhiteSmallPoint2")
		DB59 F 2 Bright Light("WhiteSmallPoint3")
		DB59 GHIJKLMNOPQRS 2 Bright
		stop
	}
}


Actor SilverKnightBallTrail : KnightBallTrail
{
	Scale 0.22
}

