		Goto PlayOff
	T2:
		DB14 A 0
		Goto PlayOff
	T3:
		DB15 A 0
		Goto PlayOff
	T4:
		DB16 A 0
		Goto PlayOff
	PlayOff:
		"####" A 0 A_Jump(230,2,4,6,8,10)
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 2 Bright
		Stop
	}
}



