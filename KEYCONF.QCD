
// =========================================================
// Customize Controls
// =========================================================

// this should be called before other commands, or else the game will first default bind actions, and only then create a section for them
addkeysection "$KEY_QcdeSection" "QCDE"                 // "QCDE bindings"
addmenukey "$KEY_ActiveAbility"  "+user1"  				// "Use Active Ability"
addmenukey "$KEY_ClassInfo"      "champdetails"         // "Show Class Information"
addmenukey "$KEY_Voice"          "voice"                // "Voice Line"
addmenukey "$KEY_MPClassMenu"    "mpclassmenu"          // "Change Class Menu"
// These are commented because it's a lot of spam
//addmenukey "Voice Line #1"        "voice  1"
//addmenukey "Voice Line #2"        "voice  2"
//addmenukey "Voice Line #3"        "voice  3"
//addmenukey "Voice Line #4"        "voice  4"
//addmenukey "Voice Line #5"        "voice  5"
//addmenukey "Voice Line #6"        "voice  6"
//addmenukey "Voice Line #7"        "voice  7"
//addmenukey "Voice Line #8"        "voice  8"
//addmenukey "Voice Line #9"        "voice  9"
//addmenukey "Voice Line #10"       "voice 10"
//addmenukey "Voice Line #11"       "voice 11"
//addmenukey "Voice Line #12"       "voice 12"
//addmenukey "Voice Line #13"       "voice 13"
//addmenukey "Voice Line #14"       "voice 14"
//addmenukey "Voice Line #15"       "voice 15"
//addmenukey "Voice Line #16"       "voice 16"
//addmenukey "Voice Line #17"       "voice 17"
//addmenukey "Voice Line #18"       "voice 18"
//addmenukey "Voice Line #19"       "voice 19"
//addmenukey "Voice Line #20"       "voice 20"
//addmenukey "Voice Line #21"       "voice 21"
//addmenukey "Voice Line #22"       "voice 22"

// =========================================================
// Extra binds
// =========================================================

defaultbind f "+user1" // Active ability

alias champdetails  "openmenu QCDE_ChampionDetails"

defaultbind f1 "champdetails"

alias voice        "pukename qcde_taunt %1"

defaultbind v "voice"

alias mpclassmenu  "openmenu ZA_JoinMenu"

defaultbind h "mpclassmenu"

alias joingame0  "closemenu; join;		+use; wait; -use"
alias joingame1  "closemenu; team 0;	+use; wait; -use"
alias joingame2  "closemenu; team 1;	+use; wait; -use"

// =========================================================
// Special commands
// =========================================================

alias drop_upgrade "pukename drop_upgrade %1 %2"
alias drop-upgrade "pukename drop_upgrade %1 %2"
alias dropupgrade  "pukename drop_upgrade %1 %2"

defaultbind del "drop_upgrade"

alias themes       "pukename themes"
alias themelist    "pukename themes"

alias addlives     "pukename addlives %1"



// =========================================================
// Menu stuff
// =========================================================

alias qcde_openmainmenu		"closemenu; openmenu MainMenu"
alias qcde_opencallvote		"closemenu; openmenu QCDE_CallVote"
alias qcde_opencampaign		"closemenu; sv_railjump false; openmenu PlayerclassMenu"
alias qcde_openskirmish		"closemenu; qcde_selectedoptions 0; openmenu QCDE_SkirmishMenu"

alias qcde_optionsgeneral	"closemenu; qcde_selectedoptions 0; openmenu QCDE_OptionsGeneral"
alias qcde_optionsgame		"closemenu; qcde_selectedoptions 1; openmenu QCDE_OptionsGame"
alias qcde_optionscontrols	"closemenu; qcde_selectedoptions 2; openmenu QCDE_OptionsControls"
alias qcde_optionsbinds		"closemenu; qcde_selectedoptions 3; openmenu QCDE_OptionsBinds"
alias qcde_optionsvideo		"closemenu; qcde_selectedoptions 4; openmenu QCDE_OptionsVideo"
alias qcde_optionssound		"closemenu; qcde_selectedoptions 5; openmenu QCDE_OptionsSound"
alias qcde_optionsskins		"closemenu; qcde_selectedoptions 6; openmenu QCDE_OptionsSkins"
alias qcde_optionspve		"closemenu; qcde_selectedoptions 7; openmenu QCDE_OptionsPvE"

alias qcde_randommapmp		"setcallvotemap random"
alias qcde_randommap		"setskirmishlevel random;"
alias qcde_randommap1		"setskirmishlevel random 1;"
alias qcde_randommap2		"setskirmishlevel random 2;"
alias qcde_randommap3		"setskirmishlevel random 3;"
alias qcde_randommap4		"setskirmishlevel random 4;"
alias qcde_startskirmish	"closemenu; pukename QCDE_StartSkirmish"

alias qcde_callmapvote		"menu_callvotereason \"\";	menu_callmapvote"
alias qcde_callnextmapvote	"menu_callvotereason \"\";	menu_callnextmapvote"
alias qcde_callspecvote		"menu_callvoteban false;	menu_callkickvote"
alias qcde_callkickvote		"menu_callvoteban true;		menu_callkickvote"
alias qcde_calllimitvote	"menu_callvotereason \"\";	menu_calllimitvote"


