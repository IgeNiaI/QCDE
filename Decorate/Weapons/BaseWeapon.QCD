//==========================================================
//	Generic player bullet puffs
//==========================================================

Actor QCBulletPuff
{
	+NOINTERACTION +NOTONAUTOMAP
	+NONETID
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	Renderstyle Add
	Decal "BulletChip"
	Scale 0.35
	States
	{
	Spawn: //hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	XDeath: //hit bleeding actor
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		Stop
	Crash: //hit everything else
		TNT1 A 0 A_PlaySound("BulletHitConcreteRandom",CHAN_7,0.6,0,9)
	Choose:
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		FX57 ABCD 1 Bright
		FX57 EFGHIJ 2 Bright
		Stop
	Type2:
		FX57 KLMN 1 Bright
		FX57 OPQRST 2 Bright
		Stop
	}
}

Actor QCBulletPuff_Quake4 : QCBulletPuff
{
	States
	{
	Type1:
		FX59 ABCD 1 Bright
		FX59 EFGHIJ 2 Bright
		Stop
	Type2:
		FX59 KLMN 1 Bright
		FX59 OPQRST 2 Bright
		Stop
	}
}


//How is this different than the regular puff? Different hit beep sound
Actor QCShotgunPuff : QCBulletPuff
{
	States
	{
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		Stop
	}
}

//HMG and MG
Actor QCBulletPuff_DM : QCBulletPuff
{
	-MTHRUSPECIES
	States
	{
	XDeath: //hit bleeding actor
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_GiveToTarget("MGDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		Stop
	}
}

Actor QCBulletPuff_DM_Quake4 : QCBulletPuff_DM
{
	States
	{
	Type1:
		FX59 ABCD 1 Bright
		FX59 EFGHIJ 2 Bright
		Stop
	Type2:
		FX59 KLMN 1 Bright
		FX59 OPQRST 2 Bright
		Stop
	}
}

//SG and SSG
Actor QCShotgunPuff_DM : QCShotgunPuff
{
	-MTHRUSPECIES
	States
	{
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_GiveToTarget("SGDamageToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		//TNT1 A 0 A_GiveToTarget("PelletHitToken",1)  //unused
		TNT1 A 0 A_JumpIfCloser(96, "XDeath_PBlank")
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		Stop

	XDeath_PBlank:
		TNT1 A 0 A_GiveToTarget("PointBlankToken",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE|GIF_SKIPOWNER)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		TNT1 A 0 A_TakeFromTarget("PointBlankToken",1)
		Stop
	}
}


//Bullet puff for monsters, same as player's, except no hit beep sound
// and doesn't go through players
Actor QCBulletPuffMonster : QCBulletPuff replaces BulletPuff
{
	-MTHRUSPECIES
	States
	{
	XDeath:
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",CHAN_7,0.6,0,9)
		Stop
	}
}

