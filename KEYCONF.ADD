alias qcde_common_sense "sv_spawnfarthest true;sv_weaponstay false;sv_weapondrop true;sv_itemrespawn true;sv_nocrouch false;sv_allowjump true;sv_allowcrouch true;sv_awarddamageinsteadkills true;sv_forcerespawn true;sv_forcerespawntime 10;sv_unblockallies true;sv_sharekeys true;compat_instantrespawn false;"

//Aliases
alias GTLBind 	"use QCGauntletDM; wait; use QCGauntlet"
alias HMGBind 	"use QCMachineGunDM; wait; use QCHeavyMachineGunDM; wait; use QCMachineGun; wait; use QCHeavyMachineGun"
alias SGBind 	"use QCShotgunDM; wait; use QCShotgun;"
alias SSGBind 	"use QCSuperShotgunDM; wait; use QCSuperShotgun"
alias SNGBind 	"use QCNailgunDM; wait; use QCSuperNailgunDM; wait; use QCNailgun; wait; use QCSuperNailgun"
alias RLBind 	"use QCRocketLauncherDM; wait; use QCRocketLauncher"
alias TBBind 	"use QCTriboltDM; wait; use QCTribolt"
alias LGBind 	"use QCLightningGunDM; wait; use QCLightningGun"
alias RGBind 	"use QCRailgunDM; wait; use QCRailgun"
alias BFGBind 	"use QCBFGDM; wait; use QCBFG"

//Menu binds
addkeysection 	"QZandro Binds" 	"QZandroBinds"
addmenukey 		"Gauntlet"			"GTLBind"
addmenukey 		"Heavy Machinegun"	"HMGBind"
addmenukey 		"Shotgun"			"SGBind"
addmenukey 		"Super Shotgun"		"SSGBind"
addmenukey 		"Super Nailgun"		"SNGBind"
addmenukey 		"Rocket Launcher"	"RLBind"
addmenukey 		"Tribolt"			"TBBind"
addmenukey 		"Lightning Gun"		"LGBind"
addmenukey 		"Railgun"			"RGBind"
addmenukey 		"BFG"				"BFGBind"
