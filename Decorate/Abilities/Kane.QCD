Actor CrouchSlideProc : CustomInventory //reduces speed by 25% when slide starts
{
	States
	{
	Pickup:
		TNT1 A 0 A_ChangeVelocity(velx/1.33, vely/1.33, velz, CVF_REPLACE)
		Stop
	}
}



