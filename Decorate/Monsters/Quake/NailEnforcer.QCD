//================================================================
//================================================================
Actor QNailEnforcer : QEnforcer	15109	//chaingunguy
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Translation "0:255=%[0,0,0]:[0.85,0.85,0.85]"
	Health 90
	Tag "$TAG_QNailEnforcer" // "Nailgun Enforcer"
	Obituary "$OB_QNailEnforcer" // "%o got nailed to a wall by an Enforcer."
	DropItem "Chaingun"
	States
	{
	Missile:
		Q30A ABB 5 A_FaceTarget
		Q30A A 0 A_Jump(256,"NailLooper")
	NailLooper:
		Q30A B 2 A_FaceTarget
		Q30A A 0 A_PlaySound("Quake1/Weapons/NailFire",7)
		Q30A C 2 Bright A_CustomMissile("EnforcerNail",32,7,random(3,-3))
		Q30A D 2
		Q30A B 0 A_CPosRefire
		Loop
	}
}


Actor EnforcerNail : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	Speed 40
	Radius 4
	Height 8
	Damage 2
	Scale 0.40
	States
	{
	Spawn:
		NAIL A 1 Bright
		Loop
	Xdeath:	//hit flesh
		TNT1 A 5 A_PlaySound("QCDE/Other/BulletHitFlesh",CHAN_AUTO,0.75,0,4)
		Stop
	Death:
		TNT1 A 0 A_Jump(256,"Crash")
	Crash:
		DB09 A 0 A_PlaySound("Doom4/Monsters/Generic/Nailgun/Impact",CHAN_AUTO,0.6,0,1.7)
		DB09 A 0 A_SetScale(0.45)
		DB09 A 0 A_Jump(256,"T1","T2","T3","T4")

		T1:		DB09 A 0
			Goto EndDeath
		T2:		DB10 A 0
			Goto EndDeath
		T3:		DB11 A 0
			Goto EndDeath
		T4:		DB12 A 0
			Goto EndDeath

	EndDeath:
		"####" ABCDEF 1 Light("YellowSmallFlicker3") Bright
		"####" GH 1 Bright
		"####" IJKLMNOPQRST 2 Bright
		Stop
	}
}



