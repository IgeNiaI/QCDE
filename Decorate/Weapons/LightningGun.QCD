	Idle.DM.Modded:
		MDC6 A 0 A_PlaySound("QC/Weapons/LightningGun/Idle_Modded", CHAN_WEAPON, 0.65, 1, 1.25)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
		"####" AABB 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"IdleCantFire")
