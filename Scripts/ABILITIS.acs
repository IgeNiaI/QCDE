Script "QCDE_HasLivingTarget" (void)
{
	int tid1 = ActivatorTid();
	SetActivatorToTarget(0);
	int tid2 = ActivatorTid();
	int hp = GetActorProperty(0, APROP_HEALTH);

	bool enemies = GameType() <= GAME_NET_COOPERATIVE  ||  areEnemies((tid1 - 1000) % 64, (tid2 - 1000) % 64);

	SetResultValue(
			tid2  &&
			tid1 != tid2  &&
			(tid1 - SKULL_TIDBASE) != (tid2 - 1000)  &&
			hp > 0  &&
			enemies);
}


//---------------------------------
//		Serious Sam's Active

Script "QCDE_Ability_Sam" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0,"QC/Abilities/Sam/Activate",CHAN_7,0.85,false,0.5);
	GiveInventory("SamMinigunProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS("QCDE_SetWeapon", "SamMinigun", GetDuration());

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	// Rocket arena special case: disable infinite ammo for duration
	if(CheckInventory("RocketArena")) TakeInventory("PowerInfiniteAmmo",1);

	// Store previously used weapon
	int w;
	for(w = 0; w < NUMBER_OF_WEAPONS; w++)
		if(!stricmp(getWeapon(), weaponList[w]))
			break;


	// Main loop
	int t = GetDuration();
	while(t --> 0)
	{
		if(CheckInventory("SeriousBullets") <= 0) t = 0;
		if(GetActorProperty(0,APROP_HEALTH) <= 0) break;
		delay(1);
	}

	// Break progress meter: 1 total duration, 1 remaining tic
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", 1, 1);

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	//Unzoom if using toggle zoom
	if (!GetCVar("cl_holdZoom")) SetInventory("WeaponZoomedToken", 0);
	//Give and select fake weapon
	SetWeapon(weaponList[w]);
	//Remove ability weapon
	GiveInventory("SamMinigunCleanerProc",1);
	TakeInventory("SamMinigun",1);
	If(CheckInventory("DMToken"))	//this if is no longer needed, kept "just in case" in the future
		GiveInventory("SeriousBullets",80);
	else
		GiveInventory("SeriousBullets",GetAmmoCapacity("SeriousBullets"));
	SetNetworkReplicationFlags( 0 );

	// Rocket arena special case: reenable infinite ammo for duration
	if(CheckInventory("RocketArena"))
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("EndlessInfiniteAmmo",1);
		SetNetworkReplicationFlags( 0 );
	}
}


//---------------------------------
//		Postal Dude's Active

Script "QCDE_Ability_Postal" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("PostalCowProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS("QCDE_SetWeapon", "PostalCowHead", GetDuration());

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	int w;
	for(w = 0; w < NUMBER_OF_WEAPONS; w++)
		if(!stricmp(getWeapon(), weaponList[w]))
			break;


	int t = GetDuration();
	while(t --> 0 )
	{
		if(checkinventory("CowHeadToken")<= 0) t=0;
		if(GetActorProperty(0,APROP_HEALTH) <= 0) break;
		delay(1);
	}

	// Break progress meter: 1 total duration, 1 remaining tic
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", 1, 1);

	if(checkinventory("CowHeadToken"))
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("PostalCowDropProc",1);
		TakeInventory("CowHeadToken",1);
		SetNetworkReplicationFlags( 0 );
	}

	//Give and select fake weapon
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetWeapon(weaponList[w]);
	//Remove ability weapon
	GiveInventory("PostalCowCleanerProc",1);
	TakeInventory("PostalCowHead",1);
	SetNetworkReplicationFlags( 0 );
}




int last_cowgasser;
Script "QCDE_CowGasHit" (void)
{
	last_cowgasser = GetActorProperty(0, APROP_TargetTID);
	//log(s:"Last cowgasser is set to ", d:last_cowgasser, s:" -- ", n:last_cowgasser -999);
}

int cowgassing_for[64], cowgasser_of[64];
#define COWGASSING_AMOUNT     9
#define COWGASSING_INCREMENT  1
#define COWGASSING_DAMAGE     9
#define COWGASSING_PERIOD    35
Script "QCDE_CowGasVictim" (void)
{
	int plr = PlayerNumber(), victid = plr + 1000;
	if(!isEnemy(last_cowgasser - 1000)) terminate; // No self nor team damage
	cowgasser_of[plr] = last_cowgasser;

	// Already gassed by somebody? Update the other script
	if(cowgassing_for[plr])
	{
		cowgassing_for[plr] += COWGASSING_INCREMENT;
		//log(n:plr+1, s:" updates gasser ", d:cowgasser_of[plr], s:" -- ", n:cowgasser_of[plr] -999, s:" and duration to ", d:cowgassing_for[plr]);
		terminate;
	}

	// New gassing
	//log(n:plr+1, s:" gets gassed by cow of ", d:cowgasser_of[plr], s:" -- ", n:cowgasser_of[plr] -999, s:" for ", d:cowgassing_for[plr]);
	cowgassing_for[plr] = COWGASSING_AMOUNT;
	ACS("QCDE_CowGasLevel", cowgassing_for[plr], victid);
	while(cowgassing_for[plr] --> 0)
	{
		if(CheckActorInventory(victid, "PowerGhostTint")) break;

		SetActivator(cowgasser_of[plr]);

		if(PlayerNumber() == -1) break; // if player disconnected

		if(!CheckActorInventory(victid, "Class_Freeman"))
			Thing_Damage(victid, COWGASSING_DAMAGE, MOD_WATER); // MOD_WATER ignores armor
		else // Freeman ignores water though :shrug:
			Thing_Damage(victid, COWGASSING_DAMAGE, MOD_POISON);

		if(!CheckActorInventory(victid, "Freezetagged"))
		{
			GiveActorInventory(victid, "VomitBloodProc",1);
			GiveInventory("HitBeepLow",1);
		}

		ACS("QCDE_CowGasLevel", cowgassing_for[plr], victid);
		if(GetActorProperty(victid,APROP_HEALTH) <= 0) break;
		//log(n:plr+1, s:" gets gassed by cow of ", d:cowgasser_of[plr], s:" -- ", n:cowgasser_of[plr] -999, s:" for ", d:cowgassing_for[plr]);

		int t = COWGASSING_PERIOD;
		while(t --> 0)
			if(GetActorProperty(victid,APROP_HEALTH) > 0)
				delay(1);
	}
	cowgassing_for[plr] = 0;
}



//---------------------------------
//		Painkiller's Active

#define CARD_BUTTONS (BT_MOVELEFT|BT_FORWARD|BT_MOVERIGHT)
#define CARD_SELECT_TIME 150
#define CARD_CD_PENALTY_DIVISOR 3
#define CARDS_TO_PICK 3

Script "QCDE_Ability_Painkiller" (void)
{
	int buttons, oldbuttons, triggers;
	int lastTapValue, ws_axis, ad_axis;
	int card1, card2, card3, cards, time;
	int plr = PlayerNumber();

	// Prefill buttons
	buttons = 0;
	ws_axis = GetPlayerInput(plr, INPUT_FORWARDMOVE);
	ad_axis = GetPlayerInput(plr, INPUT_SIDEMOVE);
	if(ws_axis > 0) buttons |= BT_FORWARD;
	if(ad_axis < 0) buttons |= BT_MOVELEFT;
	if(ad_axis > 0) buttons |= BT_MOVERIGHT;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	// Sound cue
	PlaySound(0,"QC/Abilities/Painkiller/Choose",CHAN_7,1.0,false,0.9);

	// Input stage
	GiveInventory("ActiveInProgress",1);
	SetNetworkReplicationFlags( 0 );
	if(!PlayerIsBot(PlayerNumber()))
	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		// "Make your selection" visuals
		if(time % 35 == 0)
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			ACS("QCDE_Tarot_Hint");
			SetNetworkReplicationFlags( 0 );
		}

		oldbuttons = buttons;
		buttons = 0;
		ws_axis = GetPlayerInput(plr, INPUT_FORWARDMOVE);
		ad_axis = GetPlayerInput(plr, INPUT_SIDEMOVE);
		if(ws_axis > 0) buttons |= BT_FORWARD;
		if(ad_axis < 0) buttons |= BT_MOVELEFT;
		if(ad_axis > 0) buttons |= BT_MOVERIGHT;
		triggers = buttons & ~oldbuttons;

		if (triggers & CARD_BUTTONS && !oldbuttons)
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			if(triggers & BT_MOVELEFT)  { ACS("QCDE_Tarot_Hint_Success", 1, ++card1, ++cards); lastTapValue = 1; }
			if(triggers & BT_FORWARD)   { ACS("QCDE_Tarot_Hint_Success", 2, ++card2, ++cards); lastTapValue = 2; }
			if(triggers & BT_MOVERIGHT) { ACS("QCDE_Tarot_Hint_Success", 3, ++card3, ++cards); lastTapValue = 3; }
			SetNetworkReplicationFlags( 0 );
		}

		if(cards >= CARDS_TO_PICK) break;
		if(time++ > CARD_SELECT_TIME) break;
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("ActiveProgressToken",256 * time / CARD_SELECT_TIME);
		SetNetworkReplicationFlags( 0 );

		// Oops! Turned into a demon
		if(CheckInventory("PowerDemonMorph"))
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			SetInventory("ActiveProgressToken",no);
			SetInventory("ActiveInProgress",no);
			ACS("QCDE_Tarot_Hint_End");
			SetNetworkReplicationFlags( 0 );
			terminate;
		}

		delay(1);
	}
	else switch(random(1,3))
	{
	case 1: card1 = 3; cards = 3; break;
	case 2: card2 = 3; cards = 3; break;
	case 3: card3 = 3; cards = 3; break;
	}
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	TakeInventory("ActiveInProgress",1);
	SetNetworkReplicationFlags( 0 );

	// Selection not started, punish
	if(cards == 0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("ActiveProgressToken",no);
		ACS("QCDE_Tarot_Hint_Failure");
		SetNetworkReplicationFlags( 0 );
		ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown() / CARD_CD_PENALTY_DIVISOR);
		terminate;
	}

	// Selection unfinished, auto complete
	while(cards < CARDS_TO_PICK && lastTapValue)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetInventory("ActiveProgressToken",no);
		SetNetworkReplicationFlags( 0 );
		//log(n:0, s:" hasn't selected all cards. Autofill: ", d:card1, s:", ", d:card2, s:", ", d:card3);
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		switch(lastTapValue)
		{
		case 1: ACS("QCDE_Tarot_Hint_Success", 1, ++card1, ++cards); break;
		case 2: ACS("QCDE_Tarot_Hint_Success", 2, ++card2, ++cards); break;
		case 3: ACS("QCDE_Tarot_Hint_Success", 3, ++card3, ++cards); break;
		}
		SetNetworkReplicationFlags( 0 );
	}

	// Sanity checks
	if(card1 > CARDS_TO_PICK || card2 > CARDS_TO_PICK || card3 > CARDS_TO_PICK)
	{
		PrintBold(n:0, s:" got bad card selection: ", d:card1, s:", ", d:card2, s:", ", d:card3);
	}

	// Selection complete, apply effects
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	PlaySound(0,"QC/Abilities/Painkiller/Apply",CHAN_7,1.0,false,0.9);
	ACS("QCDE_Tarot_Hint_Apply");
	GiveInventory("ActiveInProgress",1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());
	if(IsPvP())
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory(strparam(s:"PainkillerCard1Level", d:card1), 1);
		GiveInventory(strparam(s:"PainkillerCard2Level", d:card2), 1);
		GiveInventory(strparam(s:"PainkillerCard3Level", d:card3), 1);
		SetNetworkReplicationFlags( 0 );
	}
	else
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory(strparam(s:"PvEPainkillerCard1Level", d:card1), 1);
		GiveInventory(strparam(s:"PvEPainkillerCard2Level", d:card2), 1);
		GiveInventory(strparam(s:"PvEPainkillerCard3Level", d:card3), 1);
		SetNetworkReplicationFlags( 0 );
	}
	if (GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())
	{
		str class = strparam(s:"TarotOverhead", d:(!!card1 << 0) | (!!card2 << 1) | (!!card3 << 2));
		SetNetworkReplicationFlags( NETREP_SKIPOWNER|NETREP_NOUNLAGGED );
		SpawnProjectile(0,class,0,0,0,0,0);
		SetNetworkReplicationFlags( 0 );
	}

	if(CheckInventory("PainkillerCard3Level1") || CheckInventory("PvEPainkillerCard3Level1"))
	{
		ACS_NamedExecuteWithResult("QCDE_PainkillerAbilityMovement", 1);
	}

	else if(CheckInventory("PainkillerCard3Level2") || CheckInventory("PvEPainkillerCard3Level2"))
	{
		ACS_NamedExecuteWithResult("QCDE_PainkillerAbilityMovement", 2);
	}

	else if(CheckInventory("PainkillerCard3Level3") || CheckInventory("PvEPainkillerCard3Level3"))
	{
		ACS_NamedExecuteWithResult("QCDE_PainkillerAbilityMovement", 3);
	}

	// Wait for duration
	int t = GetDuration();

	// if boots level 3, you get double duration CPM
	if(checkinventory("PainkillerCard3Level3"))		//pvp
		t = GetActorPowerupTics(0,"PainkillerCard3Level3");
	else if(checkinventory("PvEPainkillerCard3Level3"))	//or pve
		t = GetActorPowerupTics(0,"PvEPainkillerCard3Level3");

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", t);

	while(t --> 0) if(GetActorProperty(0, APROP_Health) > 0  &&  !CheckInventory("NoAbilitiesToken")) delay(1);

	// End of effects
	ACS_NamedExecuteWithResult("QCDE_PainkillerAbilityMovement", 0);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	ACS("QCDE_Tarot_Hint_End");
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );
}

//---------------------------------
//		Intruder's Active

Script "QCDE_Ability_Intruder" (void)
{
	int counter;
	// Begin
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("WendigoInProc",1);
	TakeInventory("PowerIntruderSpeed",1);	//cancels passive buffs
	TakeInventory("PowerIntruderProtect",1); //cancels passive buffs

	ACS_NamedExecuteWithResult("QCDE_IntruderAbilityMovement", 1);
	SetNetworkReplicationFlags( 0 );

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
	ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	// Disable remaining damage over time from possible Quietus hit or Postal's cow head
	quieting_for[PlayerNumber()] = 0;
	cowgassing_for[PlayerNumber()] = 0;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	ACS("QCDE_IntruderLoop");
	SetNetworkReplicationFlags( 0 );

	// Main loop: Battles between visible and fadeout
	counter=0;
	while(counter <= GetDuration() && GetActorProperty(0,APROP_HEALTH) > 0)
	{
		if(CheckInventory("IntruderFadeBreakToken"))	//if token (given by fire and pain states in player def)
		{
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			ACS_NamedExecuteAlways("IntruderRestoreVisibility",0);  //makes visible
			SetNetworkReplicationFlags( 0 );
			delay(10);                                              //and waits a bit before trying to fadeout again
			counter += 10;
		}
		else
		{
			if(GetActorProperty(0,APROP_Alpha)>0)
			{
				SetNetworkReplicationFlags( NETREP_SKIPOWNER );
				ACS_NamedExecuteAlways("IntruderFadeOut",0);
				SetNetworkReplicationFlags( 0 );
			}

			If(random(1,10)==1 && GetNetworkState() != NETSTATE_CLIENT && !InDemoMode())	//small % of the time it will deal damage to enemies
				GiveInventory("WendigoAuraDmgProc",1);

			delay(1);
			counter += 1;
		}
	}

	// Exit at destination
	ACS_NamedExecuteWithResult("QCDE_IntruderAbilityMovement", 0);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	ACS_NamedExecuteAlways("IntruderRestoreVisibility",0);  //makes visible again
	GiveInventory("WendigoOutProc",1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteAlways("QCDE_RestoreIndicator",0);
}


Script "IntruderFadeOut" (void)
{
	int counter=10;

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetActorProperty(0,APROP_RenderStyle,STYLE_Translucent);
	SetNetworkReplicationFlags( 0 );
	while(counter>0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetActorProperty(0,APROP_Alpha,counter*0.1);
		SetNetworkReplicationFlags( 0 );
		//printbold(f:counter*0.1);
		counter--;
		delay(1);
		if(CheckInventory("IntruderFadeBreakToken"))
			Break;
	}

	if(!GetActorPowerupTics(0,"PowerWendigoTint"))
		terminate; // The ability is over, everything was already taken care of

	if(!CheckInventory("IntruderFadeBreakToken"))	//if the loop wasnt interrupted, then fully invis
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetActorProperty(0,APROP_Alpha,0);
		GiveInventory("WendiInvisPowerUpProc",1);
		SetNetworkReplicationFlags( 0 );
	}
	else	//if it was interrupted, then go full visible
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		SetActorProperty(0,APROP_RenderStyle,STYLE_Normal);
		SetActorProperty(0,APROP_Alpha,1.0);
		GiveInventory("WendiInvisPowerDownProc",1);
		SetNetworkReplicationFlags( 0 );
	}
}

Script "IntruderRestoreVisibility" (void)
{
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetActorProperty(0,APROP_RenderStyle,STYLE_Normal);
	SetActorProperty(0,APROP_Alpha,1.0);
	GiveInventory("WendiInvisPowerDownProc",1);
	SetNetworkReplicationFlags( 0 );
	delay(2);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	TakeInventory("IntruderFadeBreakToken",1);
	SetNetworkReplicationFlags( 0 );
}

#define WENDIGO_ALERT_COOLDOWN   60
#define WENDIGO_FOOTPRINT_PERIOD 10
#define WENDIGO_FOOTPRINT_RADIUS  8.0

Script "QCDE_IntruderLoop" (void) CLIENTSIDE
{
	int revealed = 0, last_revealed = 0;
	while(GetActorProperty(0,APROP_HEALTH) > 0)
	{
		if(!GetActorPowerupTics(0, "PowerWendigoTint")) break;

		// Reveal sound
		if(!revealed  &&  CheckInventory("IntruderFadeBreakToken")) // just revealing now
			if(last_revealed + WENDIGO_ALERT_COOLDOWN < Timer())
			{
				//PlaySound(0, "QC/Abilities/Intruder/WendigoReveal", 7, 1.0, false, 0.75);
				GiveInventory("PowerWendigoReveal",1);
				last_revealed = 0x7FFFFFFF;
			}
		if(revealed  &&  !CheckInventory("IntruderFadeBreakToken")) last_revealed = Timer();
		revealed = CheckInventory("IntruderFadeBreakToken");

		// Footprint FX
		if(Timer() % WENDIGO_FOOTPRINT_PERIOD == 0)
		{
			//GiveInventory("IntruderBodyTrailProc",1);
			int x = GetActorX(0) + random(-WENDIGO_FOOTPRINT_RADIUS, WENDIGO_FOOTPRINT_RADIUS);
			int y = GetActorY(0) + random(-WENDIGO_FOOTPRINT_RADIUS, WENDIGO_FOOTPRINT_RADIUS);
			int z0 = GetActorFloorZ(0);
			int z1 = GetActorZ(0);
			if(CheckInventory("Instagib")) SpawnForced("IntruderBodyTrailInstagib",x,y,z1, 0, random(0, 255));
			SpawnForced("D4TBlood",         x,y,z0, 0, random(0, 255));
			SpawnForced("WendigoFootprint", x,y,z0, 0, random(0, 255));
		}

		delay(1);
	}
}

//---------------------------------
//		Orbb's Active

#define DRON_SPEED 4.0
#define DRON_FRICTION 0.8 // lower is more friction
#define DRON_DURATION 25

Script "QCDE_Ability_Orbb" (void)
{
	int plr = PlayerNumber();
	int plrtid = plr + 1000;
	int tid = ORBBDRON_TIDBASE + plr;

	if (IsTidUsed(tid))
	{
		if (GetNetworkState() != NETSTATE_SERVER && !PlayerIsBot(PlayerNumber()))
		{
			SetActivator(tid);
			if (Timer() - extraAbilityData[plr] > 2 && !CheckInventory("ImDead"))
			{
				SetActivator(plrtid);
				extraAbilityData[plr] = Timer();
				ACS_NamedExecuteWithResult("ORBB_DroneViewEnter", 0);
				if (GetNetworkState() == NETSTATE_CLIENT)
				{
					NamedRequestScriptPuke("ORBB_DroneViewEnterServer", 0);
				}
			}
			SetActivator(plrtid);
		}
		terminate;
	}
	else
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		GiveInventory("OrbbDroneProc",1);
		SetNetworkReplicationFlags( 0 );
	}

	if(CheckInventory("ActiveProgressToken")) terminate;

	int cooldown = DRON_DURATION * 35;
	bool droneSpawned = false;
	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", cooldown);
	while (cooldown --> 0)
	{
		SetActivator(plrtid);
		if (GetActorProperty(0, APROP_HEALTH) <= 0)
			break;
		if (droneSpawned)
		{
			SetActivator(tid);
			if (GetActorProperty(0, APROP_HEALTH) <= 0)
				break;
		}
		else
		{
			droneSpawned = IsTidUsed(tid);
		}
		SetActivator(-1);
		Delay(1);
	}

	SetActivator(plrtid);
	TakeInventory("UsingDrone", 1);

	ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", DRON_DURATION * 35, 1);
    ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown());

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("GenericActiveCleanerProc",1);
	SetNetworkReplicationFlags( 0 );

	SetActivator(tid);
	GiveInventory("ImDead",1);
}

// Activator: controlled drone
Script "ORBB_DroneSpawned" (void)
{
	int plr = GetActorProperty(0, APROP_MasterTID) - 1000;
	int tid = ORBBDRON_TIDBASE + plr;
	Thing_ChangeTID(0, tid);
	SetPointer(AAPTR_TARGET, GetActorProperty(0, APROP_MasterTID));
	if(PlayerIsBot(plr) && GetNetworkState() != NETSTATE_CLIENT)
		ACS_NamedExecuteWithResult("ORBB_NotifyDroneChargeUp", tid);
}

// Activator: player
Script "ORBB_DroneViewEnter" (void)
{
	int plr = PlayerNumber();
	int plrtid = plr + 1000;
	int tid = ORBBDRON_TIDBASE + plr;

	GiveInventory("OrbbDroneEnter", 1);

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetPlayerProperty(0, 1, PROP_TOTALLYFROZEN);
	ChangeCamera(tid, false, false);
	GiveInventory("UsingDrone", 1); // giving the item to player, used for tunnel vision
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteWithResult("ORBB_TunnelVision", tid);

	SetActivator(tid);
	GiveInventory("OrbbDroneEnterDrone", 1);
	GiveInventory("UsingDrone", 1); // giving the item to drone, used to switch drone sprites
	// Activator: controlled drone

	int origa = GetActorAngle(plrtid), a = GetActorAngle(tid);
	int origp = GetActorPitch(plrtid), p = GetActorPitch(tid);
	int oldbuttons = GetPlayerInput(plr, INPUT_BUTTONS);
	int buttons = oldbuttons;
	int velx = 0, spd_for = 0, spd_tmp = 0;
	int vely = 0, spd_sid = 0;
	int velz = 0, spd_ver = 0;

	while(true)
	{
		if (CheckInventory("ImDead") || !IsTidUsed(tid))
			break;

		oldbuttons = buttons;
		buttons = GetPlayerInput(plr, INPUT_BUTTONS);

		if ((buttons & BT_USER1) && !(oldbuttons & BT_USER1))
		{
			extraAbilityData[plr] = Timer();
			break;
		}

		if ((GetNetworkState() != NETSTATE_SERVER) && (buttons & BT_ATTACK) && !(oldbuttons & BT_ATTACK))
		{
			NamedRequestScriptPuke("ORBB_NotifyDroneChargeUp", tid);
		}

		if (GetNetworkState() != NETSTATE_SERVER)
		{
			a += GetPlayerInput(plr, INPUT_YAW);
			p -= GetPlayerInput(plr, INPUT_PITCH);
			if(p >  0.25) p =  0.25;
			if(p < -0.25) p = -0.25;

			velx = FixedMul(GetActorVelX(tid), DRON_FRICTION);
			vely = FixedMul(GetActorVelY(tid), DRON_FRICTION);
			velz = FixedMul(GetActorVelZ(tid), DRON_FRICTION);

			spd_for = 0;
			spd_sid = 0;
			spd_ver = 0;

			// Turn pressed buttons into speed
			if (buttons & BT_FORWARD)
				spd_for += DRON_SPEED;
			if (buttons & BT_BACK)
				spd_for -= DRON_SPEED;
			if (buttons & BT_MOVERIGHT)
				spd_sid += DRON_SPEED;
			if (buttons & BT_MOVELEFT)
				spd_sid -= DRON_SPEED;
			if (buttons & BT_MOVEUP)
				spd_ver += DRON_SPEED;
			if (buttons & BT_MOVEDOWN)
				spd_ver -= DRON_SPEED;

			// Calculate proper vector when multiple buttons are pressed
			if (spd_for != 0 && spd_sid != 0 && spd_ver != 0)
			{
				spd_for = FixedMul(spd_for, 0.5);
				spd_sid = FixedMul(spd_sid, 0.5);
				spd_ver = FixedMul(spd_ver, 0.5);
			}
			else if (spd_for != 0 && spd_sid != 0)
			{
				spd_for = FixedMul(spd_for, 0.71);
				spd_sid = FixedMul(spd_sid, 0.71);
			}
			else if (spd_for != 0 && spd_ver != 0)
			{
				spd_for = FixedMul(spd_for, 0.71);
				spd_ver = FixedMul(spd_ver, 0.71);
			}
			else if (spd_sid != 0 && spd_ver != 0)
			{
				spd_sid = FixedMul(spd_sid, 0.71);
				spd_ver = FixedMul(spd_ver, 0.71);
			}

			// Calculate forward and vertical movement based on pitch
			spd_tmp = spd_for;
			spd_for = FixedMul(spd_for, cos(p)) + FixedMul(spd_ver, sin(p));
			spd_ver = FixedMul(spd_tmp, -sin(p)) + FixedMul(spd_ver, cos(p));

			// Calculate forward and side movement based on angle
			spd_tmp = spd_for;
			spd_for = FixedMul(spd_for, cos(a)) + FixedMul(spd_sid, sin(a));
			spd_sid = FixedMul(spd_tmp, sin(a)) + FixedMul(spd_sid, -cos(a));

			SetActorVelocity(tid, velx + spd_for, vely + spd_sid, velz + spd_ver, 0, 0);
			SetActorAngle(tid, a);
			SetActorPitch(tid, p);

			if (GetNetworkState() == NETSTATE_CLIENT)
			{
				NamedRequestScriptPuke("ORBB_ReplicateDronePos", GetActorX(tid), GetActorY(tid), GetActorZ(tid));
				NamedRequestScriptPuke("ORBB_ReplicateDroneAngle", a, p);
			}
		}

		delay(1);
	}

	SetActorVelocity(tid, 0, 0, 0, 0, 0);

	if (GetNetworkState() == NETSTATE_CLIENT)
	{
		NamedRequestScriptPuke("ORBB_ReplicateDronePos", GetActorX(tid), GetActorY(tid), GetActorZ(tid));
	}

	SetActivator(plrtid);

	SetActorAngle(plrtid, origa);
	SetActorPitch(plrtid, origP);

	ACS_NamedExecuteWithResult("ORBB_DroneViewExit", 0);
	if (GetNetworkState() == NETSTATE_CLIENT)
	{
		NamedRequestScriptPuke("ORBB_DroneViewExitServer");
	}
}

Script "ORBB_DroneViewExit" (void)
{
	int plr = PlayerNumber();
	int plrtid = plr + 1000;
	int tid = ORBBDRON_TIDBASE + plr;

	SetActivator(tid);

	GiveInventory("OrbbDroneExitDrone", 1);
	TakeInventory("UsingDrone", 1); // Take the item from drone

	SetActivator(plrtid);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	GiveInventory("OrbbDroneExit", 1);
	ChangeCamera(plrtid, false, false);
	SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
	SetNetworkReplicationFlags( 0 );

	TakeInventory("UsingDrone", 1); // Take the item from player
}

Script "ORBB_DroneViewEnterServer" (void) NET
{
	ACS_NamedExecuteWithResult("ORBB_DroneViewEnter", 0);
}

Script "ORBB_DroneViewExitServer" (void) NET
{
	ACS_NamedExecuteWithResult("ORBB_DroneViewExit", 0);
}

Script "ORBB_ReplicateDronePos" (int x, int y, int z) NET
{
	if (PlayerNumber() != ConsolePlayerNumber())
	{
		int tid = ORBBDRON_TIDBASE + PlayerNumber();
		SetActivator(tid);
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		Warp(0, x, y, z, 0, WARPF_ABSOLUTEPOSITION|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE);
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	}
}

Script "ORBB_ReplicateDroneAngle" (int angle, int pitch) NET
{
	int tid = ORBBDRON_TIDBASE + PlayerNumber();
	SetActorAngle(tid, angle);
	SetActorPitch(tid, pitch);
}

// Activator: player
bool tunnelVisionAlreadyOn = false;
Script "ORBB_TunnelVision" (int tid) clientside
{
	if (GetNetworkState() == NETSTATE_SERVER || tunnelVisionAlreadyOn)
		terminate;

	tunnelVisionAlreadyOn = true;

	int plr = PlayerNumber();
	bool isMe = plr == ConsolePlayerNumber();

	SetHudSize(320,240,1);
	int hmid = HMID_TUNNEL_VISION;
	SetFont("GREYMASK");
	while(CheckInventory("UsingDrone"))
	{
		if (!isMe)
		{
			if (CheckPlayerCamera(CPN()) == 1000 + plr)
			{
				SetActivator(0);
			}
			else
			{
				Delay(1);
				continue;
			}
		}

		HudMessage(s:"A";HUDMSG_FADEINOUT,hmid++,-1, 160.0,120.0, 0.4,0.2,0.4);
		if(hmid >= HMID_TUNNEL_VISION + 64) hmid = HMID_TUNNEL_VISION;
		Delay(random(20,25));

		if (!isMe)
			SetActivator(plr + 1000);
	}

	tunnelVisionAlreadyOn = false;
}

Script "ORBB_NotifyDroneChargeUp" (int tid) NET
{
	SetActivator(tid);
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	if(GameType() < GAME_NET_DEATHMATCH)
		GiveInventory("DroneExplodeCoop", 1);
	else
		GiveInventory("DroneExplodeDM", 1);
	SetNetworkReplicationFlags( 0 );
	ACS_NamedExecuteAlways("ORBB_DroneChargeUp", 0, tid);
}

Script "ORBB_DroneChargeUp" (int tid) CLIENTSIDE
{
	SetActivator(tid);
	if(GameType() < GAME_NET_DEATHMATCH)
		GiveInventory("DroneExplodeCoop", 1);
	else
		GiveInventory("DroneExplodeDM", 1);
	int time = 5;
	while (GetActorProperty(tid, APROP_HEALTH) > 0)
	{
		SetActorProperty(tid, APROP_RenderStyle, Style_Stencil);
		delay(time);
		SetActorProperty(tid, APROP_RenderStyle, Style_Translucent);
		delay(time);
		SetActorProperty(tid, APROP_RenderStyle, Style_Stencil);
		delay(time);
		SetActorProperty(tid, APROP_RenderStyle, Style_Translucent);
		delay(time);
		SetActorProperty(tid, APROP_RenderStyle, Style_Stencil);
		delay(time);
		SetActorProperty(tid, APROP_RenderStyle, Style_Translucent);
		delay(time);
		if (time > 1)
			time--;
	}
}

