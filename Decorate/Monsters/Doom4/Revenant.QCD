//================================================================================================================
Actor D4Revenant : QCDE_MonsterMedium 15460
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	var int user_counter;
	Health 400
	Radius 20
	Height 56
	Mass 3500 //sorry, had to, to avoid pushing it easily when jetpacking
	Speed 14
	PainChance 70
	Monster
	+MISSILEMORE
	+FLOORCLIP
	+DONTCORPSE
	+BLOODLESSIMPACT
	Species "Revenant"
	SeeSound	"Doom4/Monsters/Revenant/Sight"
	PainSound	"Doom4/Monsters/Revenant/Pain"
	DeathSound	"Doom4/Monsters/Revenant/Death"
	ActiveSound	"Doom4/Monsters/Revenant/Idle"
	MeleeSound "skeleton/melee"
	HitObituary "$OB_UNDEADHIT"
	Obituary "$OB_UNDEAD"
	Scale 0.9
	var int user_staggertimer;
	Tag "$TAG_D4Revenant" // "Revenant"
	States
	{
	Idle:
		SKEM A 0 A_ChangeFlag("Nogravity",false)
		SKEM A 0 A_ChangeFlag("FLOATBOB", false)
		SKEM A 0 A_ChangeFlag("THRUSPECIES",false)
		SKEM A 0 A_RemoveChildren(true)
		SKEM AB 10 A_Look
		Goto Idle+3
	See:
		SKEM AABBCCDDEEFF 2 A_Chase
		Loop
	Melee:
		SKEM G 0 A_PlaySound("Doom4/Other/MeleeSwing",CHAN_BODY,0.7,false,1.2)
		SKEM G 6 A_FaceTarget
		SKEM H 6 A_FaceTarget
		SKEM I 6 A_CustomMeleeAttack(6*random(1,10),"Doom4/Other/MeleeHit")
		Goto See
	Missile:
		TNT1 A 0 A_Jump(180,"Barrage")
		Goto TargettedRockets

	TargettedRockets:
		TNT1 A 0 A_Jump(128,"JetPack")
		SKEM K 0 A_FaceTarget
		SKEM K 10 Light("OrangeMediumFlicker1") A_PlaySound("Doom4/Monsters/Revenant/Attack",CHAN_AUTO,1.0,false,1.1)
		SKEM KKKKKK 10 Light("OrangeMediumFlicker1") A_FaceTarget
		SKEM J 10 Bright Light("OrangeMediumFlicker1DLS") A_CustomMissile("RevenantRocketFast",50,-14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 10 Bright Light("OrangeMediumFlicker1DLS") A_CustomMissile("RevenantRocketFast",50,14,0)
		SKEM K 10
		Goto See

	JetPack:
		SKEM J 0 A_SetUserVar(user_counter,0)
		SKEM J 0 A_FaceTarget
		SKEM J 0 A_PlaySound("Doom4/Monsters/Revenant/Attack",CHAN_AUTO,1.0,false,1.1)
		SKEM J 0 A_PlaySound("Player/Demon/Revenant/JetPackStartLoop",6,1.0,false,1.2)
		SKEM J 0 A_SpawnItemEx("RevenantPlaceHolder", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION|SXF_SETMASTER)
		SKEM J 0 A_ChangeFlag("FLOATBOB", true)
		SKEM J 0 A_ChangeFlag("Nogravity",true)
		SKEM J 0 A_ChangeFlag("THRUSPECIES",true)

	JetPackFlyLoop:
		SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
		SKEM JJJ 1 Light("OrangeMediumFlicker1") A_Warp(AAPTR_DEFAULT, 0,0,5)
		SKEM J 0 A_Jump(200, "JetPackFlyLoop")
		Goto JetPackAimLoop

		JetPackAimLoop:
			SKEM J 0 A_JumpIf(user_counter>=13,"FireRocketsFromJetpack")
			SKEM J 0 A_SetUserVar(user_counter,user_counter+1)
			SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
			SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
			Loop

			FireRocketsFromJetpack:
				SKEM J 0 A_CustomMissile("RevenantRocketFast",50,-14,0)
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget

				SKEM J 0 A_CustomMissile("RevenantRocketFast",50,-4,0)
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
				SKEM J 0 A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
				SKEM J 3 Light("OrangeMediumFlicker1") A_FaceTarget
				SKEM J 0 A_PlaySound("Player/Demon/Revenant/JetPackEndThrust",6,1.0,false,1.2)

				SKEM J 0 A_ChangeFlag("Nogravity",false)
				SKEM J 0 A_ChangeFlag("FLOATBOB", false)
				SKEM K 10
				SKEM J 0 A_ChangeFlag("THRUSPECIES", false)
				SKEM J 0 A_RemoveChildren(true)
				SKEM K 10
				Goto See


	Barrage:
		SKEM KK 5 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,-14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,-14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,-14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,14,0)
		SKEM J 0 A_FaceTarget
		SKEM J 7 Bright A_CustomMissile("RevenantRocketSpinning",50,-14,0)
		SKEM K 10 A_FaceTarget
		Goto See

	Pain:
		SKEM L 0 A_ChangeFlag("Nogravity",false)
		SKEM J 0 A_ChangeFlag("FLOATBOB", false)
		SKEM J 0 A_ChangeFlag("THRUSPECIES",false)
		SKEM J 0 A_RemoveChildren(true)
		SKEM L 5
		SKEM L 5 A_Pain
		Goto See

	DeathChecksDone:
		"####" "#" 0 A_Scream
		"####" "#" 0 A_ChangeFlag("FLOATBOB", false)
		"####" "#" 0 A_ChangeFlag("THRUSPECIES", false)
		"####" "#" 0 A_ChangeFlag("Nogravity",false)
		"####" "#" 0 A_RemoveChildren(true)
		SKEM LM 5
		SKEM N 5
		SKEM O 5 A_NoBlocking
		SKEM P 5 A_ChangeFlag(CORPSE,true)
	Death.Corpse:
		SKEM Q -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		SKEM Q 5
		SKEM PONML 5
		Goto See

	//------------------------------------------------------------------------
	}
}

Actor RevenantPlaceHolder : D4Revenant
{
	RenderStyle None
	-SHOOTABLE
	-COUNTKILL
	+THRUSPECIES
	States
	{
	Spawn:
		TNT1 A 175
		TNT1 A 35 A_Die
		Stop
	Death:
		TNT1 A 1
		Stop
	}
}

Actor RevenantJetpackTrailSpawner
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 1 NoDelay A_SpawnItemEx("RevenantJetPackTrail", -15,0,32,  0,0,-2, 0, SXF_NOCHECKPOSITION,64)
		Stop
	}
}
Actor RevenantJetPackTrail //centered flare behind the rocket
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.7
	Scale 0.3
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(255,"One","Two")
	One:
		X007 ABCDE 1 Bright
		X007 FGHIJ 1 Bright
		Stop
	Two:
		X007 KLMNO 1 Bright
		X007 PQRST 1 Bright
		Stop
	}
}

//-----------------------
Actor RevenantRocketFast : FastProjectile
{
	Projectile
	Speed 45
	FastSpeed 60
	Damage (random(30,60))
	Radius 3
	Height 6
	Scale 0.5
	SeeSound "Doom4/Monsters/RevenantRocketLaunch"
	Decal "D4ExploScorchSmall"
	+FORCEXYBILLBOARD
	DamageType "RocketDamage"
	States
	{
	Spawn:
		Q4NL A 1 Bright Light("WhiteMediumPoint1") A_SpawnItemEx("RocketGasTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop
	Death:
		TMT1 A 0 A_PlaySound("Doom4/Monsters/RevenantRocketExplo",CHAN_AUTO,1.0,false,1.05)
		TNT1 A 0 A_SpawnItemEx("RevenantRocketBiggerExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 2 Light("OrangeMediumPoint2")
		TNT1 A 2 Light("OrangeMediumPoint3")
		TNT1 A 2 Light("OrangeSmallPoint1")
		TNT1 A 2 Light("OrangeSmallPoint2")
		TNT1 A 2 Light("OrangeSmallPoint3")
		Stop
	}
}

Actor RevenantRocketBiggerExplo : MGMiniMissileExplo
{
	States
	{
	Spawn:
		X002 A 0 NODELAY A_SetScale(frandom(0.7,0.9))
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	}
}


//-----------------------
Actor RevenantRocketSpinning
{
	Projectile
	Speed 24
	FastSpeed 30
	Damage (15)
	Radius 3
	Height 6
	Scale 0.37
	SeeSound "Doom4/Weapon/Machinegun/MiniMissileFireLegacy"
	Decal "D4ExploScorchSmallest"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(220,4,8,12,16,20,22,26)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Weave(2,2,1.0,1.0)	//so that it starts at a random offset of the weave
		Goto Idle
	Idle:
		Q4NL AAAA 1 Bright Light("OrangeSmallPoint1") A_Weave(2,2,1.0,1.0)
		Loop
	Death:
		TNT1 A 0 A_PlaySound("QC/Abilities/Terminator/MissileExplo",CHAN_AUTO,1.0,false,1.05)
		TNT1 A 0 A_SpawnItemEx("MGMiniMissileExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 2 Light("OrangeMediumPoint2")
		TNT1 A 2 Light("OrangeMediumPoint3")
		TNT1 A 2 Light("OrangeSmallPoint1")
		TNT1 A 2 Light("OrangeSmallPoint2")
		TNT1 A 2 Light("OrangeSmallPoint3")
		Stop
	}
}


