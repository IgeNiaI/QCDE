function int CheckDaveRoom(void)
{
	int a = GetActorAngle(0);
	int x = GetActorX(0) + cos(a) * 60;
	int y = GetActorY(0) + sin(a) * 60;
	int z = GetActorZ(0);

	int tid = UniqueTid();
	bool succ = Spawn("DaveRoomTest", x,y,z, tid);
	Thing_Remove(tid);

	return succ;
}

