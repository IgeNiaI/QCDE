Actor D4Zombieman : QCDE_MonsterSmall 15462
{
	//$Angled
	//$Category "QCDE Monsters: Doom 4"
	//$Color 12
	Health 50
	Radius 20
	Height 56
	Speed 8
	PainChance 128
	Monster
	+FLOORCLIP
	SeeSound 	"Doom4/Monsters/Grunt/Sight"
	PainSound 	"Doom4/Monsters/Grunt/Pain"
	DeathSound 	"Doom4/Monsters/Grunt/Death"
	ActiveSound "Doom4/Monsters/Grunt/Idle"
	Obituary "$OB_ZOMBIE"
	DamageFactor "PlasmaExploder", 0.3	//because otherwise, zombiemen would be killing everyone else easily
	Tag "$TAG_D4Zombieman" // "Possessed Soldier"
	States
	{
	Idle:
		RFTR A 10 A_Look
		Loop
	See:
		RFTR AABBCCDD 3 A_Chase
		Loop

	//------------------------
	Missile:
		TNT1 A 0 A_PlaySound("Doom4/Monsters/Grunt/AttackOneInEight",CHAN_AUTO,1.0,false,1.2)
		TNT1 A 0 A_Jump(200,"PlasmaBurst") // most of the time will do the plasma 4shot

	//------------------------
	PlasmaBomb:
		TNT1 A 0 A_JumpIfCloser(64,"PlasmaBurst")	//if too close, goes to plasmaburst anyway
		RFTR E 0 A_PlaySound("Doom4/Other/ZombieChargeAtt",CHAN_AUTO,1.0,false,1.0)
		RFTR EEEEEEE 5 A_FaceTarget
		TNT1 A 0 A_JumpIfCloser(128,"PlasmaExplo128")
		TNT1 A 0 A_JumpIfCloser(192,"PlasmaExplo192")
		TNT1 A 0 A_JumpIfCloser(256,"PlasmaExplo256")
		TNT1 A 0 A_JumpIfCloser(320,"PlasmaExplo320")
		TNT1 A 0 A_JumpIfCloser(384,"PlasmaExplo384")
		TNT1 A 0 A_JumpIfCloser(448,"PlasmaExplo448")
		TNT1 A 0 A_JumpIfCloser(512,"PlasmaExplo512")
		TNT1 A 0 A_JumpIfCloser(576,"PlasmaExplo576")
		TNT1 A 0 A_JumpIfCloser(640,"PlasmaExplo640")
		TNT1 A 0 A_JumpIfCloser(704,"PlasmaExplo704")
		TNT1 A 0 A_JumpIfCloser(768,"PlasmaExplo768")
		TNT1 A 0 A_JumpIfCloser(832,"PlasmaExplo832")

		PlasmaExplo128:
			TNT1 A 0 A_CustomMissile("PlasmaExploder128",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo192:
			TNT1 A 0 A_CustomMissile("PlasmaExploder192",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo256:
			TNT1 A 0 A_CustomMissile("PlasmaExploder256",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo320:
			TNT1 A 0 A_CustomMissile("PlasmaExploder320",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo384:
			TNT1 A 0 A_CustomMissile("PlasmaExploder384",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo448:
			TNT1 A 0 A_CustomMissile("PlasmaExploder448",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo512:
			TNT1 A 0 A_CustomMissile("PlasmaExploder512",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo576:
			TNT1 A 0 A_CustomMissile("PlasmaExploder576",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo640:
			TNT1 A 0 A_CustomMissile("PlasmaExploder640",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo704:
			TNT1 A 0 A_CustomMissile("PlasmaExploder704",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo768:
			TNT1 A 0 A_CustomMissile("PlasmaExploder768",35,0,0)
			Goto FinishPlasmaExplo
		PlasmaExplo832:
			TNT1 A 0 A_CustomMissile("PlasmaExploder832",35,0,0)
			Goto FinishPlasmaExplo

	FinishPlasmaExplo:
		TNT1 A 0 A_PlaySound("Doom4/Monsters/ZombieBigPlasmaShoot",CHAN_AUTO,1.0,false,0.9)
		RFTR F 5 Bright
		RFTR E 15
		Goto See

	//------------------------
	PlasmaBurst:
		RFTR E 10 A_FaceTarget
		RFTR F 5 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
		RFTR E 5 A_FaceTarget
		RFTR F 5 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
		RFTR E 5 A_FaceTarget
		RFTR F 5 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
		RFTR E 5 A_FaceTarget
		RFTR F 5 Bright A_CustomMissile("ZombiemanPlasmaBall",31,7,0)
		RFTR E 5 A_FaceTarget
		Goto See

	Pain:
		RFTR G 3
		RFTR G 3 A_Pain
		Goto See

	DeathChecksDone:
		RFTR H 4
		RFTR I 4 A_Scream
		TNT1 A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		RFTR J 4 A_NoBlocking
		RFTR K 4
	Death.Corpse:
		RFTR L -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Doom4/Gore/Medium")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		RFTR M 4
		RFTR N 4
		TNT1 A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		RFTR O 4 A_NoBlocking
		RFTR PQRST 4
		RFTR U -1
		Stop
    Ice:
		"####" "#" 0 A_GiveInventory("ImDead",1)
		"####" "#" 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		RFTR LK 3
		RFTR JIH 3
		Goto See
	}
}


//----------------------------------------
Actor PlasmaExploder128
{
	var int user_angle;
	Projectile
	Speed 16
	Scale 0.5
	Alpha 0.99
	Damage 3
	Radius 6
	Height 12
	RenderStyle Add
	Alpha 0.99
	DamageType "PlasmaExploder"
	Translation "0:255=%[0,0,0]:[1.5,0.3,0.08]"
	+FORCEXYBILLBOARD
	+THRUGHOST
	States
	{
	Spawn:
		DB19 AABBCCDD 1 Bright Light("OrangeMediumFlicker1")
		Goto StopTravel

	StopTravel:
		TNT1 A 0 A_Stop
		DB19 ABCDEFGH 2 Bright Light("OrangeMediumFlicker1")
		Goto ExplodeTimer
	ExplodeTimer:
		TNT1 A 0 A_SetScale(0.8)
		TNT1 A 0 A_Explode(32,96)
	ExplosionEnd:
		TNT1 A 0 A_PlaySound("Doom4/Monsters/BigPlasmaExplo",CHAN_AUTO,1.0,false,0.9)
		TNT1 A 2 Light("OrangeBigFlicker3") A_SpawnItemEx("PlasmaBombExplo",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATIoN)
		TNT1 A 2 Light("OrangeMediumFlicker2")
		TNT1 A 2 Light("OrangeMediumFlicker3")
		TNT1 A 2 Light("OrangeSmallFlicker1")
		TNT1 A 2 Light("OrangeSmallFlicker2")
		TNT1 A 2 Light("OrangeSmallFlicker3")
		Stop

	Death:	//if hits wall, it will wait, and then do AOE damage
		Goto StopTravel
	XDeath:	//if hit bleeder, will not do AOE
		TNT1 A 0
		Goto ExplosionEnd
	Crash:	//if hit nonbleeder, will not do AOE
		TNT1 A 0
		Goto ExplosionEnd
	}
}

Actor PlasmaBombExplo
{
	+NOINTERACTION
	RenderStyle Add
	Scale 0.3
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		X072 L 1 Bright NODELAY A_SetScale(scalex+0.12)
		TNT1 A 0 A_FadeOut(0.07)
		Loop
	}
}



