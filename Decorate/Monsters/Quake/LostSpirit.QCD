//================================================================
//================================================================

Actor QLostSpirit : QCDE_MonsterSmall 	15108	// lost soul
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 80
	Speed 15
	Radius 20
	Height 40
	PainChance 180
	Mass 100
	Scale 0.2
	Meleedamage 3
	Monster
	+NOGRAVITY
	+FLOAT
	+DONTFALL
	Tag "$TAG_QLostSpirit" // "Lost Spirit"
	SeeSound "Quake1/LostSpirit/Sight"
	PainSound "Quake1/LostSpirit/Pain"
	DeathSound "Quake1/LostSpirit/Death"
	ActiveSound "Quake1/LostSpirit/Idle"
	Obituary "$OB_QLostSpirit" // "%o joins the lost spirits."
	Translation "0:255=%[0,0,0]:[1.9,1.9,1.9]", "176:191=176:191"
	States
	{
	Idle:
		DSHR A 3 A_Look
		Loop
	See:
		DSHR AABBCC 3 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_PlaySound("Quake1/LostSpirit/Attack")
		DSHR CDEFG 3 A_FaceTarget
		DSHR H 6 A_CustomMeleeAttack(random(7,24))
		Goto See
	Pain:
		DSHR S 8 A_Pain
		Goto See

	DeathChecksDone:
		TNT1 A 0 A_Fall
		TNT1 A 0 A_Scream
		DSH2 ABCDEFGHIJ 3 A_FadeOut(0.02)
	Death.Corpse:
		DSH2 K 1 A_FadeOut(0.2)
		Wait

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1
	}
}


