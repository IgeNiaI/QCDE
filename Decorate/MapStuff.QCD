//Mini Scrags for blood covenant, non monster, unshootable, unkillable
Actor BCScrag : QScrag 16520
{
	//$NotAngled
	//$Category "QCDE Map Decoration"
	//$Color 16
	//$Title "Covenant Scrag Decorative"
	-COUNTKILL
	+NOTARGET
	-SHOOTABLE
	-IsMonster
	+SLIDESONWALLS
	+CLIENTSIDEONLY
	Radius 10
	Height 15
	Scale 0.13
	Speed 2
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,"Fast", "Medium", "Slow")
		Goto Fast
	Fast:
		Q36W AAAAABBBBBCCCCCDDDDDEEEEEFFFFF 1 A_GiveInventory("BCScragProc")
		TNT1 A 0 A_Jump(256,"Fast", "Medium", "Slow")
		Loop
	Medium:
		Q36W AAAAAABBBBBBCCCCCCDDDDDDEEEEEEFFFFFF 1 A_GiveInventory("BCScragProc")
		TNT1 A 0 A_Jump(256,"Fast", "Medium", "Slow")
		Loop
	Slow:
		Q36W AAAAAAABBBBBBBCCCCCCCDDDDDDDEEEEEEEFFFFFFF 1 A_GiveInventory("BCScragProc")
		TNT1 A 0 A_Jump(256,"Fast", "Medium", "Slow")
		Loop
	}
}

Actor BCScragProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_Turn(random(0,2))
		TNT1 A 0 A_ChangeVelocity(1,0,0,CVF_RELATIVE|CVF_REPLACE)
		Stop
	}
}


