//================================================================
//================================================================
Actor QDog : QCDE_MonsterSmall	15102	//zombieman
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	Health 40
	Radius 12
	Height 48
	Speed 14
	PainChance 250
	Mass 50
	Monster
	+FLOORCLIP
	Tag "$TAG_QDog" // "Rottweiler"
	Scale 0.37
	SeeSound "Quake1/Dog/Sight"
	PainSound "Quake1/Dog/Pain"
	DeathSound "Quake1/Dog/Death"
	ActiveSound "Quake1/Dog/Idle"
	Obituary "$OB_QDog" // "%o was mauled by a rottweiler."
	States
	{
	Idle:
		Q29I A 10 A_Look
		Loop
	See:
		Q29W AABBCCDDEEFFGGHH 2 A_Chase
		Loop
	Melee:
		TNT1 A 0 A_PlaySound("Quake1/Dog/Attack",6)
		Q29A AB 3 A_FaceTarget
		Q29A C 3 A_CustomMeleeAttack(random(6,24))
		Q29A DE 4
		Goto See
	Pain:
		Q29P A 8 A_Pain
		Goto See

	DeathChecksDone:
		Q29D A 0 A_Scream
		Q29D A 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		Q29D A 0 A_Fall
		Q29D ABCE 4
		Q29D F 4 A_PlaySound("quake4/Misc/Body/Small")
		Q29D G 4
	Death.Corpse:
		Q29D H -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

    Ice:
		"####" "#" 0 A_GiveInventory("ImDead",1)
		"####" "#" 0 A_SpawnItemEx("ZombieAmmoDropper",0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
		"####" "#" 5 A_GenericFreezeDeath
		"####" "#" 1 A_FreezeDeathChunks
		Wait

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q29D HGFEDCBA 4
		Goto See
	}
}

