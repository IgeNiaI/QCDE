//		Eradicator's Passive

int level_up_at[100] =
{
	    3,     5,    15,    20,    25,    30,    40,    55,    70,    85, //  1--10
	  100,   120,   140,   160,   180,   200,   220,   240,   265,   280, // 11--20
	  300,   330,   360,   390,   404,   420,   451,   512,   555,   570, // 21--30
	  600,   640,   666,   700,   740,   777,   800,   840,   888,   900, // 31--40
	  950,  1024,  1111,  1234,  1337,  1496,  1515,  1666,  1789,  1827, // 41--50
	 1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827, // 51--60
	 1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827, // 61--70
	 1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827, // 71--80
	 1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827, // 81--90
	 1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  1827,  6969, // 91--99
};

Script "QCDE_Passive_Eradicator" (void)
{
	// Is it even Eradicator?
	if(!CheckInventory("Class_Eradicator")) terminate;

	// Is it even alive?
	if(GetActorProperty(0,APROP_Health) < 0) terminate;

	int kills_had  = CheckInventory("MurderToken");
	TakeInventory("MurderToken", 1);
	int kills_left = CheckInventory("MurderToken");
	int murder     = CheckInventory("MurderLevel");

	// Does map have enough monsters in cooperative to provide another level?
	if(GameType() < GAME_NET_DEATHMATCH)
	{
		int toofew = GetLevelInfo(LEVELINFO_TOTAL_MONSTERS) - GetLevelInfo(LEVELINFO_KILLED_MONSTERS) < kills_left;
		SetInventory("TooFewMonst", toofew);
	}

	// Initial setup
	if(!murder && !kills_had && !kills_left)
	{
		GiveInventory("MurderToken", level_up_at[murder]);
	}

	// Upgrade time
	else if(!kills_left)
	{
		str take = strparam(s:"PowerMurder", d:murder);
		murder++;
		str give = strparam(s:"PowerMurder", d:murder);
		TakeInventory(take, 1);
		GiveInventory(give, 1);

		GiveInventory("MurderLevel", 1);
		GiveInventory("MurderToken", level_up_at[murder]);
		PlaySound(0,"QC/Abilities/Eradicator/DamageUp", CHAN_VOICE, 1.0, false, 0.6); // couldn't use chans 5 to 7
	}
}

// Activator: dying monster
Script "QCDE_MonsterKill_QCEradicator" (void)
{
	// Due to how this ability was originally coded, it's easier to just
	// change activator pointer and let main passive script do the rest.
	SetActivatorToTarget(0);
	ACS("QCDE_Passive_Eradicator");
}

// Activator: dying victim
Script "QCDE_PlayerKill_QCEradicator" (void)
{
	SetActivatorToTarget(0);
	ACS("QCDE_Passive_Eradicator");
}


//---------------------------------
//		Blazko's Passive

#define TICS_BEFORE_HEAL  70
#define TICS_HEALING_RATE  3
Script "QCDE_Passive_Blazkowicz" (void)
{
	int hp = GetActorProperty(0,APROP_HEALTH);
	int wasntDamagedFor, maxHp;
	while(hp > 0)
	{
		int hpWas = hp;
		hp = GetActorProperty(0,APROP_HEALTH);
		maxHp = CheckInventory("MaxHealthToken");

		if(hp != hpWas) wasntDamagedFor = 0;

		wasntDamagedFor++;

		// heal time! also has room to heal
		if(wasntDamagedFor >= TICS_BEFORE_HEAL  &&  hp % 25  &&  hp < maxHp)
		{
			// play notif
			if(wasntDamagedFor == TICS_BEFORE_HEAL)
				if(hp % 25 < 17)
					PlaySound(0, "QC/Abilities/Blazkowicz/Regen", CHAN_7|CHAN_UI, 0.56, false, ATTN_NONE, true);
				else
					PlaySound(0, "QC/Abilities/Blazkowicz/RegenShort", CHAN_7|CHAN_UI, 0.56, false, ATTN_NONE, true);

			// heal
			if(!(Timer() % TICS_HEALING_RATE))
			{
				hp++;
				HealThingEx(1);
			}
		}

		delay(1);
	}
}



//---------------------------------
//		Freeman's Passive

#define COILS_TO_1_ARMOR    3
#define PERCENT_PER_BFGCELL 2
#define REZ_COOLDOWN_SECS  120
#define FREEMAN_SPOTS       8
int rezCharge[64];
int freem[FREEMAN_SPOTS][3];
Script "QCDE_Passive_Freeman" (void)
{
	int lg0, lg1 = CheckInventory("QCCoilAmmo"), lgdiff;
	int bfg0, bfg1 = CheckInventory("QCBFGAmmo"), bfgdiff;
	int plr = PlayerNumber();
	rezCharge[plr] = 0; // reset extra-half-life
	InitFreemanSpots();
	InitGman();

	while(GetActorProperty(0,APROP_Health) > 0)
	{
		// Puppet / Extraction / Extra-half-life
		// Prevent death.
		rezCharge[plr]++;
		bool ready   = rezCharge[plr] >= REZ_COOLDOWN_SECS * 35;
		bool readyRN = rezCharge[plr] == REZ_COOLDOWN_SECS * 35;
		bool needRez = GetActorProperty(0,APROP_Health) == 1;

		if(hasFlags()) ready = false; // CTF fix
		if(CheckInventory("PowerTerminatorArtifact")) ready = false; // ES fix
		if(GetCvar("qc_freezetag")) // FT fix
		{
			delay(1);
			continue;
		}

		SetInventory("HalfLifeToken", ready);
		SetPlayerProperty(0, ready, PROP_BUDDHA);

		if(ready)
		{
			if(readyRN) PlaySound(0, "QC/Abilities/Freeman/HalfLife", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
			if(needRez)
			{
				rezCharge[plr] = -99999999; // don't restore in this level
				SpawnForced("GmanRezSound", GetActorX(0),GetActorY(0),GetActorZ(0));
				GiveInventory("GmanRezProc", 1);
				if(checkinventory("DMToken"))
				{
					SetInventory("QCHeavyMachinegunDM",0);	//take all the DM weapons except the machinegun
					SetInventory("QCShotgunDM",0);
					SetInventory("QCSuperShotgunDM",0);
					SetInventory("QCNailgunDM",0);
					SetInventory("QCSuperNailgunDM",0);
					SetInventory("QCTriboltDM",0);
					SetInventory("QCRocketLauncherDM",0);
					SetInventory("QCLightningGunDM",0);
					SetInventory("QCRailgunDM",0);
					SetInventory("QCBFGDM",0);
					SetInventory("QCHeavyMachinegun",0);	//also removes the non DM version
					SetInventory("QCShotgun",0);			//just in case there's some oddities with pickups
					SetInventory("QCSuperShotgun",0);
					SetInventory("QCNailgun",0);
					SetInventory("QCSuperNailgun",0);
					SetInventory("QCTribolt",0);
					SetInventory("QCRocketLauncher",0);
					SetInventory("QCLightningGun",0);
					SetInventory("QCRailgun",0);
					SetInventory("QCBFG",0);
					SetInventory("QCShellAmmo",0);		//set all ammo to zero except bullets
					SetInventory("QCNailAmmo",0);
					SetInventory("QCRocketAmmo",0);
					SetInventory("QCCoilAmmo",0);
					SetInventory("QCSlugAmmo",0);
					SetInventory("QCBoltAmmo",0);
					SetInventory("QCBFGAmmo",0);

					SetInventory("BasicArmor",0); //remove armor too

					int startingWeapon = GetCvar("cl_startingWeapon");
					if (startingWeapon == 1) {
						SetInventory("Starter_Machinegun"   ,1);
					} else if (startingWeapon == 2) {
						SetInventory("Starter_Shotgun"   ,1);
					} else if (startingWeapon == 3) {
						SetInventory("Starter_Nailgun"   ,1);
                    }
					ACS_NamedExecuteAlways("QCDE_StartingWeapon_Apply",0);
				}

				// Disable remaining damage over time from possible Quietus hit or Postal's cow head
				quieting_for[PlayerNumber()] = 0;
				cowgassing_for[PlayerNumber()] = 0;

				int spot = PickFreemanSpot();
				//log(s:"Used spot ", d:spot);
				SetActorPosition(0, freem[spot][0],freem[spot][1],freem[spot][2], true);
				SetActorProperty(0, APROP_Health, 25);
				StopSound(0, CHAN_WEAPON);
				PlaySound(0, "QC/Abilities/Freeman/Extract", CHAN_7|CHAN_UI, 0.7, false, ATTN_NONE, true);
				if(random(1,10)==1)	PlaySound(0, "GmanInvestments", CHAN_7|CHAN_UI, 1.0, false, ATTN_NONE, true);
			}
		}

		delay(1);
	}
}

function void InitFreemanSpots(void)
{
	int x = GetActorX(0);
	int y = GetActorY(0);
	int z = GetActorZ(0) + 0.1337;

	int i;
	for(i = 0; i < FREEMAN_SPOTS; i++)
	{
		if(!freem[FREEMAN_SPOTS-1][2]) // z-coord is chosen because it's ensured to be non-zero
		{
			//log(s:" Initialized spot ", d:i);
			freem[i][0] = x;
			freem[i][1] = y;
			freem[i][2] = z;
		}
		else
			UpdateFreemanSpot();
	}
}

function int PickFreemanSpot(void)
{
	int i, maxdist, maxdistspot;

	for(i = 0; i < FREEMAN_SPOTS; i++)
	{
		int plr = 64;
		int mindist = 0x7FFFFFFF;
		while(plr --> 0)
		{
			if (!PlayerInGame(plr) ||
				PlayerIsSpectator(plr) || // sugondeesedronum
				PlayerNumber() == plr) continue;

			int dx = (GetActorX(1000 + plr) >> 16) - (freem[i][0] >> 16);
			int dy = (GetActorY(1000 + plr) >> 16) - (freem[i][1] >> 16);
			int dz = (GetActorZ(1000 + plr) >> 16) - (freem[i][2] >> 16);

			int dista = Dist(Dist(dx, dy), dz);

			if(dista < mindist) mindist = dista;
		}

		// new best candidate
		if(mindist > maxdist)
		{
			maxdist = mindist;
			maxdistspot = i;
		}
	}

	return maxdistspot;

	//
	// Unused implementation of "farthest to death" below
	//

	int x,y,z;
	for(i = 0; i < FREEMAN_SPOTS; i++)
	{
		int x2 = (freem[i][0]  >> 16) - x;
		int y2 = (freem[i][1]  >> 16) - y;
		int z2 = (freem[i][2]  >> 16) - z;

		int d = Dist(Dist(x2, y2), z2);

		// new best candidate
		if(d > maxdist)
		{
			maxdist = d;
			maxdistspot = i;
		}
	}

	return maxdistspot;
}

function void UpdateFreemanSpot(void)
{
	int x = GetActorX(0);
	int y = GetActorY(0);
	int z = GetActorZ(0) + 1.0;

	int i = random(0,random(0,random(1,FREEMAN_SPOTS-1)));
	//log(s:"Updated spot ", d:i);

	freem[i][0] = x;
	freem[i][1] = y;
	freem[i][2] = z;
}

function void InitGman(void)
{
	if(IsTidUsed(GMAN_TID)) return;

	SpawnForced("Gman",-666.666,-1337.101,-420.69,GMAN_TID);
}

Script "QCDE_GmanShouldLeave" (void)
