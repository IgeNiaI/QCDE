	// Leaderboard and clock
	inInventory not TeamDeathmatch || Duel
	{
		gameMode deathmatch
		{
			inInventory CurrentLeader {
				drawImage "TEAM0FR1", 600,50;
			} else {
				drawImage "TEAM0FR2", 600,50;
			}
			drawBar "TEAM0BA1", "TEAM0BA0", Team1Score, horizontal, 644,50;

			drawString QCFNT080, white, GlobalVar   1, 585,54, 0, alignment(right);  // timer
			drawString QCFNT030, white, GlobalArray 4, 620,55, 0, alignment(center); // position 1st
			drawString QCFNT030, white, GlobalArray 5, 620,82, 0, alignment(center); // position 2nd
			drawString BIGFONT , white, GlobalArray 6, 648,53, 0, alignment(left);   // name 1st
			drawString BIGFONT , white, GlobalArray 7, 648,80, 0, alignment(left);   // name 2nd
			drawString QCFNT030, white, GlobalArray 8, 892,55, 0, alignment(center); // frags 1st
			drawString QCFNT030, white, GlobalArray 9, 892,82, 0, alignment(center); // frags 2nd
			drawString QCFNT080, white, "/",		   925,54, 0, alignment(left);
			drawNumber 3, QCFNT080, white, GlobalVar  11, alignment(left), 945,54, 0;
		}
	}
