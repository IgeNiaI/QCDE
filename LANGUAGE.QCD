QUITMSG1  = "Press Y to quit like a big loser in life,\npress N to stay proud and successful";           // Quake 1
QUITMSG2  = "Man, I oughta smack you for trying to quit!\nPress Y to get smacked out.";                  // Quake 1
QUITMSG3  = "Um, Asmodeus dislikes his children trying to quit.\nPress Y to return to your tinkertoys."; // Quake 1
QUITMSG4  = "If you press Y to quit, I will summon Satan all over your hard drive!";                     // Quake 1
QUITMSG5  = "Milord, methinks that thou art a lowly quitter.\nIs this true?";                            // Quake 1
QUITMSG6  = "Do I need to bust your face open for trying to quit?";                                      // Quake 1
QUITMSG7  = "If you quit now, I'll throw a blanket-party for you next time!";                            // Quake 1
QUITMSG8  = "Are you gonna quit this game just like everything else?";                                   // Quake 1
QUITMSG9  = "In Soviet Russia, game quits you!";
QUITMSG10 = "The monsters so wished they could quit like you.";
QUITMSG11 = "Are you cheating on me with another game?";
QUITMSG12 = "Just blame it on lag next time.";
QUITMSG13 = "It was probably past your bedtime anyway.";
QUITMSG14 = "Exit command acknowledged.\nIncreasing chipset voltage by 300%. Shutting down...";
QUITMSG15 = "Yeah, I agree, you haven't played D4T for too long.";                                                          // Michaelis
QUITMSG16 = "Press 'n' if you still need help getting away from yourself.";                                                 // Michaelis
QUITMSG17 = "All that remains is a binary choice to be made.\nAre you sure?";                                               // Michaelis
QUITMSG18 = "You are escaping the escapist realm.\nDo you see the irony?";                                                  // Michaelis
QUITMSG19 = "Protip: opening console and typing 'quit' can be faster than using menus.";                                    // Michaelis
QUITMSG20 = "Hint: using console command 'exit' can be faster than clicking through menus.";                                // Michaelis
QUITMSG21 = "Do you really want to play the original Quake Champions?";                                                     // Michaelis
QUITMSG22 = "Are you sure you want to play actual Quake Champions?";                                                        // Michaelis
QUITMSG23 = "This game dispenses the lootboxes.\nCompared to it, you are nothing.";                                         // Michaelis
QUITMSG24 = "Have you already tried all the classes and found them all broken and overpowered?";                            // Michaelis
QUITMSG25 = "Don't you just love it when a game tries to hold you on your way out?";                                        // Michaelis
QUITMSG26 = "OK, go have a meal, do homework and pay for Internet, but then, come back!";                                   // Michaelis
QUITMSG27 = "Do you agree that this game is metal as hell?";                                                                // Michaelis
QUITMSG28 = "Did you have a great time?";                                                                                   // Michaelis
QUITMSG29 = "We have updated our Privacy Policy.\nAccept to proceed with exiting.";                                         // Michaelis
QUITMSG30 = "At some point during production of v3.0, \n QCDE class hierarchy contained 2500 actors.\nNow there are more."; // Michaelis
QUITMSG31 = "Come on, just ask me about Bones one more time.";                                                              // Michaelis
QUITMSG32 = "Buying a Golden Lootbox with a guaranteed Legendary item for $24.99. Are you sure?";                           // Michaelis
QUITMSG33 = "DON'T HIT YES -- we have a bug where it closes the game.";                                                          // Jckfrbn
QUITMSG34 = "No more pew pew pew?";                                                                                              // Jckfrbn
QUITMSG35 = "Look... I know we have had our difficulties, \n but one more level wouldn't hurt.";                                 // Jckfrbn
QUITMSG36 = "I'm proud of you, getting off your ass and doing something with your life.... oh wait--";                           // Jckfrbn
QUITMSG37 = "Survey Question:\nDo you hate this mod?";                                                                           // Jckfrbn
QUITMSG38 = "Oh, don't think this isn't in your statistics.";                                                                    // Jckfrbn
QUITMSG39 = "Wait, give us a minute to load a meme quote...\nhuh. Seems broken. Go play a little more while we work on this..."; // Jckfrbn
QUITMSG40 = "I've heard if you collect everything...\nwell, I won't spoil it.";                                                  // Jckfrbn
QUITMSG41 = "Awww, bored of playing all alone? \n Go download Doomseeker and join the rest of us!";                              // Jckfrbn
QUITMSG42 = "I just wanna thank you for playing, \n because without you this wouldn't be so much fun.";                          // Jckfrbn
QUITMSG43 = "Don't quit yet.\nWe promise netcode will be fixed asap!";                                                                // Alphaent (Blorc)
QUITMSG44 = "Press Y to feel shame and disgrace.\nPress N to feel a strong sense of pride and accomplishment.";                       // Powershifter
QUITMSG45 = "This is my Railgun.\nThere are many like it, but this one is mine.";                                                     // Ivory Duke
QUITMSG46 = "Can you feel the scent of death tonight?";                                                                               // Ivory Duke
QUITMSG47 = "They said you couldn't be struck by lightning twice. They lied.";                                                        // Ivory Duke
QUITMSG48 = "DBT...\nWe need to talk about Dave.";                                                                                    // Jehar + Ivory Duke
QUITMSG49 = "Mama... I just killed a man...\nput the gun against his head,\npulled my trigger, now he's dead\nand I won the match!";  // Ivory Duke
QUITMSG50 = " Barons bleed green. \n Cacos bleed blue. \n Dear shotgun. \n I choose you.";                                            // DBThanatos
QUITMSG51 = "Press Y to postpone addition of Bones champion.";                                                                        // revenatn + Michaelis
QUITMSG52 = "A Bethesda.net account is required to exit this title. \n Please press ''no'' and connect to the Internet to continue."; // revenatn + Michaelis
QUITMSG53 = "You did not--";                                                                                                          // scaryred24
QUITMSG54 = "Cacodemons are red,\nNailguns are Blue,\nYou are Yellow if you press Y.";                                                // Captain J
QUITMSG55 = "Sure thing. Let's see how your browser entertains you better.";                                                          // Captain J
QUITMSG56 = "I guess this is how H. P. Lovecraft quit his job, huh?";                                                                 // Captain J
QUITMSG57 = "What, leaving already?\nBut I haven't filled my kill quota yet!";                                                        // Cryomundus
QUITMSG58 = "Hey Michaelis!\nCan we say 'fuck' in the game?";                                                                         // Nems
QUITMSG59 = "So you think you can escape the arena?";                                                                                 // Redead-ITA
QUITMSG60 = "Escaping from \n your game \n is \n impossible.";                                                                        // revenatn + Michaelis

