
Actor CompatVer30_Player {} // for compatibility checks

//==================================================================================
//==================================================================================
//			Constants
//==================================================================================
//==================================================================================

// Maximum stacks are now defined with tokens -- see SETCLASS
// Maximum health is also defined in player pawns, no way around that


//======================================================================================
//======================================================================================
//
//		Base class they all inherit from. Defines weapon slots and some other stuff
//
//======================================================================================
//======================================================================================

Actor QCPlayer : PlayerPawn
{
	// Speed 1.0 // all movement properties are set in MOVEMENT.acs now
	Health 100
	Mass 58
	PainChance 255
	Gravity 0.75
	+BRIGHT

	Player.ColorRange 250, 255

	Player.ActionScript "altattack" "QCDE_ZoomControl"
	Player.ActionScript "user1" "QCDE_ActiveAbility"
	Player.EffectActor "grunt" "GenericLandFX"

	Player.AttackZOffset -2
	Player.CrouchScale 0.75
	Player.CrouchChangeSpeed 0.08

	Player.WeaponSlot 1, QCGauntlet
	Player.WeaponSlot 2, QCMachinegun, QCHeavyMachinegun,		QCMachinegunDM, QCHeavyMachinegunDM
	Player.WeaponSlot 3, QCShotgun, QCSuperShotgun,				QCShotgunDM, QCSuperShotgunDM
	Player.WeaponSlot 4, QCNailgun, QCSuperNailgun,				QCNailgunDM, QCSuperNailgunDM
	Player.WeaponSlot 5, QCTribolt,								QCTriboltDM
	Player.WeaponSlot 6, QCRocketLauncher,						QCRocketLauncherDM
	Player.WeaponSlot 7, QCLightningGun,						QCLightningGunDM
	Player.WeaponSlot 8, QCRailgun,								QCRailgunDM
	Player.WeaponSlot 9, QCBFG,									QCBFGDM
	Player.WeaponSlot 0, DukeFreezeThrower, SamMinigun, BrockTranslocator

	Player.ForwardMove 0.75,1,0.5,0.5
	Player.SideMove 0.78,1.25,0.54,0.52
	Player.FootstepsEnabled 0,1,0,0

	DamageFactor "NoDamageToPlayers", 0.0
	DamageFactor "NailgunWeak", 0.43 //hack for weak nailgun-jump, explained in nailgun.qcd
	DamageFactor "BobExploSP", 0.0

	Species "Players" +THRUSPECIES
	+DONTBLAST

	States
	{
	Death.Disable:
		TNT1 A  0 A_StopSound(1)
		TNT1 A  0 A_StopSound(2)
		TNT1 A  0 A_StopSound(3)
		TNT1 A  0 A_StopSound(4)
		TNT1 A  0 A_StopSound(5)
		TNT1 A  0 A_StopSound(6)
		TNT1 A  0 A_StopSound(7)
		TNT1 A  0 A_StopSound(8)
		TNT1 A  0 A_ChangeFlag("NOGRAVITY",true)
		TNT1 A  0 A_SetGravity(0)
		TNT1 A  0 A_ChangeVelocity(0,0,1, CVF_REPLACE)
		TNT1 A 35 A_GiveInventory("DisableColor")
		TNT1 A  0 A_Stop
		TNT1 A -1
		Stop
	}
}



//======================================================================================
//
//		Subclasses, determines hitbox and viewhight properties
//
//======================================================================================

Actor QCPlayerLight : QCPlayer
{
	Radius 13
	Height 52
	Player.ViewHeight 48
}

Actor QCPlayerMedium : QCPlayer
{
	Radius 16
	Height 56
	Player.ViewHeight 50
}


Actor QCPlayerHeavy : QCPlayer
{
	Radius 18
	Height 60
	Player.ViewHeight 55
}



//======================================================================================
//
//		1. Ranger. AKA Quakeguy
//
//======================================================================================
Actor QCRanger : QCPlayerMedium
{
	Player.DisplayName "Ranger"
	Player.SoundClass "Ranger"
	Player.Palette "PL01"

	Scale 0.88

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 125
	Health 125
	Player.StartItem "QCStartingArmor25"

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 125
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 100

	Player.StartItem "Class_Ranger"
	Player.StartItem "Body_Medium"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	States
	{
	Spawn:
		QP01 E 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP01 E 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP01 E 0 A_JumpIf(true,                   "DefSpawn")
		QP01 E 100
		Loop

		ColoredSpawn:
			RP01 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP01 E 4
			Loop
		DefSpawn:
			QP01 A 0 A_JumpIf(momx||momy,"DefSee")
			QP01 E 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP01 ABCD 4
			RP01 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP01 ABCD 4
			QP01 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP01 E 12
			RP01 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP01 E 12
			QP01 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP01 F 6 BRIGHT Light("PlayerFiringLight")
			RP01 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP01 F 6 BRIGHT Light("PlayerFiringLight")
			QP01 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP01 G 4
			RP01 G 4 A_Pain
			RP01 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP01 G 4
			QP01 G 4 A_Pain
			QP01 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		QP01 H 0 A_ChangeFlag("BRIGHT",0)
		QP01 H 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP01 H 0 A_StopSound(CHAN_6)
		QP01 H 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP01 H 6
		QP01 I 6 A_PlayerScream
		QP01 J 6 A_NoBlocking
		QP01 KLM 6
		QP01 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		QP01 O 0 A_ChangeFlag("BRIGHT",0)
		QP01 O 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		QP01 O 0 A_StopSound(CHAN_6)
		QP01 O 0 A_SetScale(1.0)
		QP01 O 0 A_XScream
		QP01 O 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.5,false,1.2)
		QP01 H 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP01 O 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP01 P 5
		QP01 Q 5 A_NoBlocking
		QP01 RSTUV 5
		QP01 W -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}



//======================================================================================
//
//		2. Doomslayer. AKA Dewmguy
//
//======================================================================================
Actor QCDoomSlayer : QCPlayerMedium
{
	Player.DisplayName "DoomSlayer"
	Player.SoundClass "DoomSlayer"
	Player.Palette "PL02"

	XScale 0.98
	YScale 1.02

	Player.FootstepInterval 10
	Player.FootstepVolume 0.5625

	Player.MaxHealth 150
	Health 150

	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxHealthToken", 150
	// goto SETCLASS::QCDE_ResetClass // Player.StartItem "MaxArmorToken", 75

	Player.StartItem "Class_Doomslayer"
	Player.StartItem "Body_Medium"
	Player.StartItem "ActiveOffensive"
	Player.StartItem "NotSpectator"

	Damagefactor "Falling", 0.1 // game w/o falling damage, so he's resistant

	States
	{
	Spawn:
		QP02 E 0 NoDelay ACS_NamedExecuteWithResult("QCDE_DMCMPGN_PlayBotJoinSound", 0, 0, 0)
	SpawnLoop:
		QP02 E 0 A_JumpIfInventory("TeamColor",1, "ColoredSpawn")
		QP02 E 0 A_JumpIf(true,                   "DefSpawn")
		QP02 E 100
		Loop

		ColoredSpawn:
			RP02 A 0 A_JumpIf(momx||momy,"ColoredSee")
			RP02 E 4
			Loop
		DefSpawn:
			QP02 A 0 A_JumpIf(momx||momy,"DefSee")
			QP02 E 4
			Goto SpawnLoop // to catch color

	See:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredSee")
		"####" A 1 A_JumpIf(true,                   "DefSee")
		Goto DefSee // for preview screen and prediction

		ColoredSee:
			RP02 ABCD 4
			RP02 A 0 A_JumpIf(true,"ColoredSpawn")
			Loop
		DefSee:
			QP02 ABCD 4
			QP02 A 0 A_JumpIf(true,"SpawnLoop") // to catch color
			Loop

	Missile:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMissile")
		"####" E 1 A_JumpIf(true,                   "DefMissile")
		Loop

		ColoredMissile:
			RP02 E 12
			RP02 E 12 A_JumpIf(true, "SpawnLoop")
			Loop
		DefMissile:
			QP02 E 12
			QP02 E 12 A_JumpIf(true, "SpawnLoop")
			Loop

	Melee:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredMelee")
		"####" F 1 A_JumpIf(true,                   "DefMelee")
		Loop

		ColoredMelee:
			RP02 F 6 BRIGHT Light("PlayerFiringLight")
			RP02 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop
		DefMelee:
			QP02 F 6 BRIGHT Light("PlayerFiringLight")
			QP02 F 6 BRIGHT Light("PlayerFiringLight") A_JumpIf(true, "SpawnLoop")
			Loop

	Pain:
		"####" A 0 A_JumpIfInventory("TeamColor",1, "ColoredPain")
		"####" G 1 A_JumpIf(true,                   "DefPain")
		Loop

		ColoredPain:
			RP02 G 4
			RP02 G 4 A_Pain
			RP02 G 4 A_JumpIf(true, "SpawnLoop")
			Loop
		DefPain:
			QP02 G 4
			QP02 G 4 A_Pain
			QP02 G 4 A_JumpIf(true, "SpawnLoop")
			Loop

	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP02 H 7
		QP02 I 7 A_PlayerScream
		QP02 J 7 A_NoBlocking
		QP02 KLM 7
		QP02 N -1 A_StopSound(CHAN_WEAPON)
		Stop
	XDeath:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops looping sounds
		TNT1 A 0 A_StopSound(CHAN_6)
		QP02 O 0 A_XScream
		TNT1 A 0 A_PlaySound("QC/Weapons/Gore",CHAN_BODY,0.4,false,1.2)
		TNT1 A 0 A_SpawnItemEx("QCPlayerArmorDrop", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_FORCESERVERSIDE)
		QP02 O 5 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		QP02 P 5
		QP02 Q 5 A_NoBlocking
		QP02 RSTUV 5
		QP02 W -1 A_StopSound(CHAN_WEAPON)
		Stop
	}
}

