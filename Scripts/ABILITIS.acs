//---------------------------------
//		Freeman's Active

Script "QCDE_Ability_Freeman" (void)
{
	if(ACS_NamedExecuteWithResult("QCDE_AbilityCooldown", GetCooldown()))
	{
		extraAbilityData[PlayerNumber()]++;
		SetLastUse(Timer());
		if(checkInventory("DMToken"))	//DM version does 3 blasts to deflect projectiles
		{
			ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("PvPBlastInitialProc",1); //spawns FX, deals 10dmg of explosion, and A_Blast
			SetNetworkReplicationFlags( 0 );
			Delay(6);
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("PvPBlastExtraProc",1); //does only A_Blast
			SetNetworkReplicationFlags( 0 );
			Delay(6);
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("PvPBlastExtraProc",1); //does only A_Blast
			SetNetworkReplicationFlags( 0 );
			delay(GetDuration()-12); //duration of ability, minus x tics due to those 2 "delay(y)"
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("GenericActiveCleanerProc",1);
			SetNetworkReplicationFlags( 0 );
		}
		else		//PvE version does a single a_blast that pushes enemies and deals damage to them
		{
			ACS_NamedExecuteWithResult("QCDE_ShowActiveInProgress", GetDuration());
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("PvEBlastProc",1); //spawns FX and A_Blast
			SetNetworkReplicationFlags( 0 );
			delay(GetDuration()); //duration of active ability
			SetNetworkReplicationFlags( NETREP_SKIPOWNER );
			GiveInventory("GenericActiveCleanerProc",1);
			SetNetworkReplicationFlags( 0 );
		}
	}
}


