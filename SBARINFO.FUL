		} else {
		inInventory QCNailgun		|| QCNailgunDM {
			inInventory QCNailAmmo	 { inInventory QCNailAmmo	, 51 { isSelected QCNailgun			, QCNailgunDM			{ drawNumber 3, QCFNT040, brite, QCNailAmmo		, alignment(right), 1589,470; } else { drawNumber 3, QCFNT030, darkgrey, QCNailAmmo		, alignment(right), 1589,470; } } else { isSelected QCNailgun			, QCNailgunDM				{ drawNumber 3, QCFNT040, red, QCNailAmmo	, alignment(right), 1589,470; } else { drawNumber 3, QCFNT030, darkred, QCNailAmmo	, alignment(right), 1589,470; } } }
		}}
		inInventory QCTribolt	 		|| QCTriboltDM			{ inInventory QCBoltAmmo 	,  6 { isSelected QCTribolt	 		, QCTriboltDM				{ drawNumber 3, QCFNT040, brite, QCBoltAmmo 	, alignment(right), 1589,540; } else { drawNumber 3, QCFNT030, darkgrey, QCBoltAmmo 	, alignment(right), 1589,540; } } else { isSelected QCTribolt	 		, QCTriboltDM				{ drawNumber 3, QCFNT040, red, QCBoltAmmo 	, alignment(right), 1589,540; } else { drawNumber 3, QCFNT030, darkred, QCBoltAmmo 	 , alignment(right), 1589,540; } } }
		inInventory QCRocketLauncher	|| QCRocketLauncherDM	{ inInventory QCRocketAmmo	,  6 { isSelected QCRocketLauncher	, QCRocketLauncherDM		{ drawNumber 3, QCFNT040, brite, QCRocketAmmo	, alignment(right), 1589,610; } else { drawNumber 3, QCFNT030, darkgrey, QCRocketAmmo	, alignment(right), 1589,610; } } else { isSelected QCRocketLauncher	, QCRocketLauncherDM		{ drawNumber 3, QCFNT040, red, QCRocketAmmo	, alignment(right), 1589,610; } else { drawNumber 3, QCFNT030, darkred, QCRocketAmmo , alignment(right), 1589,610; } } }
		inInventory QCLightningGun		|| QCLightningGunDM		{ inInventory QCCoilAmmo 	, 51 { isSelected QCLightningGun	, QCLightningGunDM			{ drawNumber 3, QCFNT040, brite, QCCoilAmmo 	, alignment(right), 1589,680; } else { drawNumber 3, QCFNT030, darkgrey, QCCoilAmmo 	, alignment(right), 1589,680; } } else { isSelected QCLightningGun		, QCLightningGunDM			{ drawNumber 3, QCFNT040, red, QCCoilAmmo 	, alignment(right), 1589,680; } else { drawNumber 3, QCFNT030, darkred, QCCoilAmmo 	 , alignment(right), 1589,680; } } }
		inInventory QCRailgun 			|| QCRailgunDM			{ inInventory QCSlugAmmo 	,  6 { isSelected QCRailgun 		, QCRailgunDM				{ drawNumber 3, QCFNT040, brite, QCSlugAmmo 	, alignment(right), 1589,750; } else { drawNumber 3, QCFNT030, darkgrey, QCSlugAmmo 	, alignment(right), 1589,750; } } else { isSelected QCRailgun 			, QCRailgunDM				{ drawNumber 3, QCFNT040, red, QCSlugAmmo 	, alignment(right), 1589,750; } else { drawNumber 3, QCFNT030, darkred, QCSlugAmmo 	 , alignment(right), 1589,750; } } }
		inInventory QCBFG 				|| QCBFGDM				{ inInventory QCBFGAmmo 	,  9 { isSelected QCBFG 			, QCBFGDM					{ drawNumber 3, QCFNT040, brite, QCBFGAmmo		, alignment(right), 1589,820; } else { drawNumber 3, QCFNT030, darkgrey, QCBFGAmmo		, alignment(right), 1589,820; } } else { isSelected QCBFG 				, QCBFGDM					{ drawNumber 3, QCFNT040, red, QCBFGAmmo	, alignment(right), 1589,820; } else { drawNumber 3, QCFNT030, darkred, QCBFGAmmo	 , alignment(right), 1589,820; } } }
		inInventory DukeFreezeThrower							{ inInventory DukeAmmo	 	, 16 { isSelected DukeFreezeThrower								{ drawNumber 3, QCFNT040, brite, DukeAmmo		, alignment(right), 1589,890; } else { drawNumber 3, QCFNT030, darkgrey, DukeAmmo		, alignment(right), 1589,890; } } else { isSelected DukeFreezeThrower								{ drawNumber 3, QCFNT040, red, DukeAmmo		, alignment(right), 1589,890; } else { drawNumber 3, QCFNT030, darkred, DukeAmmo	 , alignment(right), 1589,890; } } }
		inInventory SamMinigun									{ inInventory SeriousBullets, 51 { isSelected SamMinigun									{ drawNumber 3, QCFNT040, brite, SeriousBullets	, alignment(right), 1589,890; } else { drawNumber 3, QCFNT030, darkgrey, SeriousBullets	, alignment(right), 1589,890; } } else { isSelected SamMinigun										{ drawNumber 3, QCFNT040, red,SeriousBullets, alignment(right), 1589,890; } else { drawNumber 3, QCFNT030, darkred,SeriousBullets, alignment(right), 1589,890; } } }

		// This is special due to how it's basic in DM but not in solo
		isSelected QCSuperShotgun	, QCSuperShotgunDM		{ inInventory QCShellAmmo	,  6 { drawNumber 3, QCFNT040, brite, QCShellAmmo	, alignment(right), 1589,400; } else { drawNumber 3, QCFNT040, red, QCShellAmmo	, alignment(right), 1589,400; }
		} else {
