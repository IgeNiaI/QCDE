alias qcde_WeapSkins_Quake4		"cl_GNTLskin  4;	cl_MGskin  4;	cl_HMGskin  4;					cl_SSGskin  4;	cl_NGskin  4;	cl_SNGskin  4;	cl_TBskin  4;	cl_RLskin  4;	cl_LGskin  4;	cl_RGskin  4;	cl_BFGskin  4;	"
alias qcde_WeapSkins_ETQW		"					cl_MGskin  5;	cl_HMGskin  5;					cl_SSGskin  5;					cl_SNGskin  5;					cl_RLskin  5;	cl_LGskin  5;	cl_RGskin  5;					"
alias qcde_WeapSkins_QCDE10		"cl_GNTLskin  6;	cl_MGskin  6;	cl_HMGskin  6;	cl_SGskin  6;	cl_SSGskin  6;	cl_NGskin  6;	cl_SNGskin  6;	cl_TBskin  6;	cl_RLskin  6;	cl_LGskin  6;	cl_RGskin  6;	cl_BFGskin  6;	"
alias qcde_WeapSkins_HalfLife	"					cl_MGskin  7;	cl_HMGskin  7;	cl_SGskin  7;	cl_SSGskin  7;	cl_NGskin  7;	cl_SNGskin  7;					cl_RLskin  7;													"
alias qcde_WeapSkins_Class		"cl_GNTLskin -1;	cl_MGskin -1;	cl_HMGskin -1;	cl_SGskin -1;	cl_SSGskin -1;	cl_NGskin -1;	cl_SNGskin -1;	cl_TBskin -1;	cl_RLskin -1;	cl_LGskin -1;	cl_RGskin -1;	cl_BFGskin -1;	"
