//================================================================
//================================================================
Actor QFiend : QCDE_MonsterMedium 	15104	// hell knight
{
	//$Angled
	//$Category "QCDE Monsters: Quake"
	//$Color 12
	var int user_leapstrength;
	Health 400
	Radius 24
	Height 52
	Mass 400
	Speed 12
	MeleeDamage 6
	MeleeRange 70
	MinMissileChance 255
	Damage 9
	PainChance 32
	Monster
	Scale 0.49
	Tag "$TAG_QFiend" // "Fiend"
	SeeSound "Quake1/Fiend/Sight"
	PainSound "Quake1/Fiend/Pain"
	DeathSound "Quake1/Fiend/Death"
	ActiveSound "Quake1/Fiend/Idle"
	MeleeSound "Quake1/Fiend/Slash"
	Obituary "$OB_QFiend" // "%o was eviscerated by a fiend."
	DropItem "Hourglass", 48
	States
	{
	Idle:
		Q31I A 10 A_Look
		Wait
	See:
		Q31R A 2 A_Chase("Melee","")	Q31R A 2 A_Chase("Melee","")
		Q31R B 2 A_Chase("Melee","")	Q31R B 2 A_Chase("Melee","")
		Q31R C 2 A_Chase("Melee","")	Q31R C 2 A_Chase("Melee","")
		Q31R D 2 A_Chase				Q31R D 2 A_Chase("Melee","")
		Q31R E 2 A_Chase				Q31R E 2 A_Chase("Melee","")
		Q31R F 2 A_Chase				Q31R F 2 A_Chase("Melee","")
		Loop
	SeeNoMissile:
		Q31R AABBCCDDEEFF 2 A_Chase("Melee","")
		Goto See
	Melee:
		TNT1 A 0 A_ChangeFlag("NODROPOFF",1)
		Q31M A 4 A_FaceTarget 	TNT1 A 0 A_Recoil(-1.8)
		Q31M B 4 A_FaceTarget 	TNT1 A 0 A_Recoil(-1.8)
		Q31M C 4 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
		Q31M D 5 A_FaceTarget	TNT1 A 0 A_Recoil(-1.8)
		Q31M E 4 A_MeleeAttack	TNT1 A 0 A_Recoil(-1.8)
		Q31M F 5  A_ChangeFlag("NODROPOFF",0)
		Goto See


	//--------------------------------------
	// Leap attack
	Missile:
		TNT1 A 0 A_JumpIfCloser(320,"Prep320")
		TNT1 A 0 A_JumpIfCloser(384,"Prep384")
		TNT1 A 0 A_JumpIfCloser(448,"Prep448")
		TNT1 A 0 A_JumpIfCloser(512,"Prep512")
		TNT1 A 0 A_JumpIfCloser(576,"Prep576")
		TNT1 A 0 A_JumpIfCloser(640,"Prep640")
		TNT1 A 0 A_JumpIfCloser(704,"Prep704")
		TNT1 A 0 A_JumpIfCloser(768,"Prep768")
		Goto See //if farther than 768, also just drops the whole thing

		Prep320:	TNT1 A 0 A_SetUserVar(user_leapstrength,32)	goto ContinueLeap
		Prep384:	TNT1 A 0 A_SetUserVar(user_leapstrength,34)	goto ContinueLeap
		Prep448:	TNT1 A 0 A_SetUserVar(user_leapstrength,37)	goto ContinueLeap
		Prep512:	TNT1 A 0 A_SetUserVar(user_leapstrength,39)	goto ContinueLeap
		Prep576:	TNT1 A 0 A_SetUserVar(user_leapstrength,41)	goto ContinueLeap
		Prep640:	TNT1 A 0 A_SetUserVar(user_leapstrength,43)	goto ContinueLeap
		Prep704:	TNT1 A 0 A_SetUserVar(user_leapstrength,45)	goto ContinueLeap
		Prep768:	TNT1 A 0 A_SetUserVar(user_leapstrength,47)	goto ContinueLeap

		ContinueLeap:
			Q31L A 0 A_PlaySound("Quake1/Fiend/Jump")
			Q31L A 4 A_FaceTarget
			Q31L B 0 A_Recoil(-(user_leapstrength/1.5))
			Q31L B 2 ThrustThingZ(0,user_leapstrength,0,0)

		LeapLoop:
			Q31L B 0 A_CheckFloor("LeapEnd")
			Q31L B 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			Q31L B 0 A_CheckFloor("LeapEnd")
			Q31L B 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			Q31L B 0 A_CheckFloor("LeapEnd")
			Q31L B 1 A_JumpIf(velx==0&&vely==0,"DropFast")
			Loop

		DropFast:
			TNT1 A 0 A_ChangeVelocity(0,0,-12,CVF_REPLACE)
			TNT1 A 0 A_CheckFloor("LeapEnd")
			Q31L C 1 A_JumpIf(velx==0&&velZ==0,"LeapEnd")
			Goto DropFast+1

			LeapEnd:
				TNT1 A 0 A_PlaySound("Quake1/Fiend/Land")
				TNT1 A 0 A_JumpIfCloser(140,"DoDamage")
				Goto ResumeLeapEnd
			DoDamage:
				TNT1 A 0 A_MeleeAttack
				Goto ResumeLeapEnd
			ResumeLeapEnd:
				Q31L D 1 A_Stop
				Q31L D 2
				Goto SeeNoMissile
	Pain:
		Q31P A 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF",0)
		Q31P A 7 A_Pain
		Goto See

	DeathChecksDone:
		Q31D A 0 A_Scream
		Q31D A 4
		Q31D B 4 A_Fall
		Q31D CD 4
		Q31D E 4 A_PlaySound("quake4/Misc/Body/Small")
		Q31D FG 4
	Death.Corpse:
		Q31D H -1
		Stop

	XDeathChecksDone:
		TNT1 A 0 A_PlaySound("Quake1/Xdeath")
		TNT1 A 0 A_SpawnItemEx("GibDropperMedium",0,0,28,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Goto DeathChecksDone+1

	Raise:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_DamageTracker",0,1)
		Q31D GFEDCBA 4
		Goto See
	}
}


Actor JumpCheck : Inventory
{
    Inventory.MaxAmount 1
    Inventory.Amount 1
}
