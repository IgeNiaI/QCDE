// ----------------------------------------------------------------------------
//
// Lucienne's abilities
//
// Active:	Cleansing Fire
//			Heal or heal 10% of max health.
//
// Passive: Immolation
//			Death of Lucienne releases huge heat.
//
// ----------------------------------------------------------------------------

Actor CompatVer30_Lucienne {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------
Actor LucienneFireBallProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_AlertMonsters(512)
		TNT1 A 0 A_PlaySound("QC/Abilities/Lucienne/Fire",6,0.8) //chan6, will be interrupted, but chan_weap is used by the weapons themselves

		TNT1 A 0 A_JumpIfInventory("DMToken",1,"FireDM")
		TNT1 A 0 A_FireCustomMissile ("LucienneBall",0,false,-6,3,0,0)
		Stop
	FireDM:
		TNT1 A 0 A_FireCustomMissile ("LucienneBallDM",0,false,-6,3,0,0)
		Stop
	}
}


Actor LucienneBall : FastProjectile
{
	Radius 4
	Height 7
	Speed 80
	Scale 0.2
	DamageType "FireDamage"
	Damage (0)
	PROJECTILE
	+EXTREMEDEATH
	+FORCERADIUSDMG
	+FORCEXYBILLBOARD
	+BRIGHT
	+SEEKERMISSILE
	+DONTBLAST
	RenderStyle Add
	DeathSound "quake4/Misc/BallExplo"
	Obituary "$OB_LucienneBall" // "%o was cleansed by %k."
	Translation "0:255=%[0,0,0]:[2,1,0]"
	States
	{
	Spawn:
		TNT1 A 0 NODELAY
	Idle:
		DB50 AB 1 Light("YellowSmallPoint1")
		DB50 CDEFGHIJKLMNOPQRSTUVWXYZAB 1 Light("YellowSmallPoint1") A_SpawnItemEx("LucienneBallTrail1",  random(4,-4),random(4,-4),random(4,-4), 0,0,0,0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Goto Idle+2

	Xdeath:	//Direct hit -- warp a bit further to penetrate deep target like Spider Mastermind
		TNT1 A 0 A_Warp(AAPTR_DEFAULT, 15,0,0,0, WARPF_NOCHECKPOSITION)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathCont

	DeathCont:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_LucienneBallHits")
		TNT1 A 0 A_RadiusGive("CleansedProc",180,RGF_PLAYERS|RGF_MONSTERS|RGF_FORCESERVERSIDE) // radius should cross over from center of projectile to center of victim that can be thicc
	FinishExplosion:
		TNT1 A 15 A_SpawnItemEx("LucienneBallExplosion", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION|SXF_NOUNLAGGED|SXF_SKIPOWNER)
		Stop
	}
}

Actor LucienneBallDM : LucienneBall
{
	-DONTBLAST
	States
	{
	DeathCont:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_LucienneBallHits")
		TNT1 A 0 A_RadiusGive("CleansedProc",96,RGF_PLAYERS|RGF_MONSTERS|RGF_FORCESERVERSIDE)
		Goto FinishExplosion
	}
}

Actor CleansedProc : CustomInventory
{
	+SERVERNETID
	States
	{
	Pickup:
		TNT1 A 0 ACS_NamedExecuteWithResult("QCDE_Cleansed")
		Stop
	}
}

Actor LucienneBallTrail1
{
	+CLIENTSIDEONLY
	+NONETID
	+NOINTERACTION
	+FORCEXYBILLBOARD
