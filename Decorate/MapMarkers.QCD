Actor CompatVer31_MapMarkers {} // for compatibility checks

Actor QCMapMarker : MapMarker
{
    +CLIENTSIDEONLY
    
    Scale 0.2
}

Actor MapMarker_HMG : QCMapMarker
{
    States
    {
    Spawn:
        QCMb Z -1
		Stop
    }
}

Actor MapMarker_SSG : QCMapMarker
{
    States
    {
    Spawn:
        QCMC Z -1
		Stop
    }
}

