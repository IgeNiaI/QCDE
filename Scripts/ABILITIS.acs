int currentCleanser;
Script "QCDE_LucienneBallHits" (void)
{
	currentCleanser = GetActorProperty(0, APROP_TargetTID) - 1000;
}

#define LUCIENNE_CURSE_DURATION  100
#define LUCIENNE_TINT_DURATION 99999
Script "QCDE_Cleansed" (void)
{
	//log(n:0, s:" cleansed by ", n:currentCleanser + 1);

	if(isEnemy(currentCleanser))
		CleanseHurt();
	else
		CleanseHeal();

	while(GetActorPowerupTics(0,"PowerCleanVulnerable") > LUCIENNE_TINT_DURATION - LUCIENNE_CURSE_DURATION) delay(1);
	TakeInventory("PowerCleanVulnerable", 1);
	TakeInventory("CleansingWeakener", 1);
}

function void CleanseHeal(void)
{
	int maxhp = CheckInventory("MaxHealthToken");
	if(!maxhp) maxhp = GetActorProperty(0, APROP_SPAWNHEALTH);
	int heal = maxhp * LUCIENNE_HEAL_PERCENT / 100;
	HealThingEx(heal);

	// Reduce damages over time
	int plr = PlayerNumber();
	if(cowgassing_for[plr]) cowgassing_for[plr]--;
	if(  quieting_for[plr])   quieting_for[plr]--;

	GiveInventory("CleansingHealProc", 1);
}

function void CleanseHurt(void)
{
	int maxhp = CheckInventory("MaxHealthToken");
	if(!maxhp) maxhp = GetActorProperty(0, APROP_SPAWNHEALTH);

	int hurt = maxhp * LUCIENNE_HURT_PERCENT / 100;
	if(GameType() <= GAME_NET_COOPERATIVE && hurt < LUCIENNE_MIN_DAMAGE)
		hurt = LUCIENNE_MIN_DAMAGE; // ensure minimum damage in PvE
	// cap max damage
	if(hurt > LUCIENNE_MAX_DAMAGE) hurt = LUCIENNE_MAX_DAMAGE;

	GiveInventory("CleansingHurtProc", 1);

	int victim = ActivatorTid(), temptid;
	if(!victim) // special case to prevent Lucienne from hurting herself when enemy had no tids
	{
		temptid = true;
		victim = UniqueTid();
		Thing_ChangeTID(0,victim);
	}
	SetActivator(currentCleanser + 1000);
	Thing_Damage2(victim, hurt, "Cleanse");
	SetActivator(victim);
	if(temptid)
	{
		Thing_ChangeTID(0,0);
	}
}

